{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp46-usp-bg: {{ section.settings.bg_color | default: '#0B0F19' }};
    
    background-color: var(--hp46-usp-bg);
    padding-top: {{ section.settings.padding_top | default: 70 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 70 }}px;
  }

  .hp46-usp__grid {
    max-width: {{ section.settings.container_width | default: 1280 }}px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: 4 }}, 1fr);
    gap: 24px;
  }

  .hp46-usp__card {
    background: rgba(15, 23, 42, 0.6);
    backdrop-filter: blur(14px);
    border: 1px solid rgba(56, 189, 248, 0.2);
    border-radius: 24px;
    padding: 36px 24px;
    text-align: center;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
    transition: all 0.3s ease;
  }

  .hp46-usp__card:hover {
    border-color: #F472B6;
    transform: translateY(-4px);
    box-shadow: 0 15px 40px rgba(244, 114, 182, 0.15);
  }

  .hp46-usp__icon {
    font-size: 32px;
    margin-bottom: 16px;
    display: inline-block;
    filter: drop-shadow(0 0 10px rgba(56, 189, 248, 0.5));
  }

  .hp46-usp__title {
    font-family: 'Syne', sans-serif;
    font-size: 18px;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0 0 10px;
  }

  .hp46-usp__desc {
    font-size: 14px;
    line-height: 1.65;
    color: #94A3B8;
    margin: 0;
  }

  @media screen and (max-width: 992px) {
    .hp46-usp__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media screen and (max-width: 576px) {
    .hp46-usp__grid { grid-template-columns: 1fr; }
  }
{%- endstyle -%}

<div class="hp46-usp__grid">
  {%- if section.blocks.size > 0 -%}
    {%- for block in section.blocks -%}
      <div class="hp46-usp__card" {{ block.shopify_attributes }}>
        <div class="hp46-usp__icon">{{ block.settings.icon | default: '⚡' }}</div>
        <h3 class="hp46-usp__title">{{ block.settings.title }}</h3>
        <p class="hp46-usp__desc">{{ block.settings.description }}</p>
      </div>
    {%- endfor -%}
  {%- else -%}
    <div class="hp46-usp__card">
      <div class="hp46-usp__icon">⚡</div>
      <h3 class="hp46-usp__title">LUMINESCENT ENZYMES</h3>
      <p class="hp46-usp__desc">Phytoplankton bio-active triggers instant optical cellular radiance.</p>
    </div>
    <div class="hp46-usp__card">
      <div class="hp46-usp__icon">🛡️</div>
      <h3 class="hp46-usp__title">BLUE LIGHT BARRIER</h3>
      <p class="hp46-usp__desc">Neutralizes 98% of high-energy visible screen radiation damage.</p>
    </div>
    <div class="hp46-usp__card">
      <div class="hp46-usp__icon">✈️</div>
      <h3 class="hp46-usp__title">AIR PRIORITY DDP</h3>
      <p class="hp46-usp__desc">Fully insured door courier with all customs pre-cleared globally.</p>
    </div>
    <div class="hp46-usp__card">
      <div class="hp46-usp__icon">🧪</div>
      <h3 class="hp46-usp__title">HOLOGRAPHIC PURITY</h3>
      <p class="hp46-usp__desc">100% vegan, clean bio-synthesis in pharmaceutical sterile suites.</p>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "HP46 - Cyber Pillars",
  "class": "section-hp46-usp",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#0B0F19" },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "label": "Desktop Columns", "default": 4 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 70 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 70 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar Card",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon", "default": "⚡" },
        { "type": "text", "id": "title", "label": "Title", "default": "LUMINESCENT ENZYMES" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Phytoplankton bio-active triggers instant optical cellular radiance." }
      ]
    }
  ],
  "presets": [
    { "name": "HP46 - Cyber Pillars" }
  ]
}
{% endschema %}
