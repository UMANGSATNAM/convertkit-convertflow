{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#ffffff'
  assign text_color = section.settings.text_color | default: '#000000'
  assign title = section.settings.title | default: 'PRIVATE SALE'
  assign subtitle = section.settings.subtitle | default: 'UP TO 40% OFF SELECTED STYLES'
  assign button_text = section.settings.button_text | default: 'SHOP THE SALE'
  assign button_link = section.settings.button_link | default: '#'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    color: {{ text_color }};
    padding: 150px 20px;
    display: flex;
    justify-content: center;
    align-items: center;
    border-top: 1px solid rgba(0,0,0,0.05);
    border-bottom: 1px solid rgba(0,0,0,0.05);
  }
  
  .hp8-offer-container-{{ section_id }} {
    text-align: center;
    max-width: 800px;
  }
  
  .hp8-offer-title-{{ section_id }} {
    font-family: 'Bodoni MT', 'Didot', 'Playfair Display', serif;
    font-size: clamp(3.5rem, 8vw, 6rem);
    font-weight: 400;
    line-height: 1;
    margin: 0 0 20px 0;
    text-transform: uppercase;
    letter-spacing: 2px;
  }
  
  .hp8-offer-subtitle-{{ section_id }} {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 1.1rem;
    font-weight: 500;
    letter-spacing: 4px;
    text-transform: uppercase;
    margin: 0 0 50px 0;
  }
  
  .hp8-offer-btn-{{ section_id }} {
    display: inline-block;
    padding: 18px 50px;
    background-color: {{ text_color }};
    color: {{ bg_color }};
    text-decoration: none;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 2px;
    text-transform: uppercase;
    transition: all 0.3s ease;
  }
  
  .hp8-offer-btn-{{ section_id }}:hover {
    background-color: transparent;
    color: {{ text_color }};
    box-shadow: inset 0 0 0 1px {{ text_color }};
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 100px 20px;
    }
  }
</style>

<div class="hp8-offer-container-{{ section_id }}">
  <h2 class="hp8-offer-title-{{ section_id }}">{{ title }}</h2>
  <p class="hp8-offer-subtitle-{{ section_id }}">{{ subtitle }}</p>
  {% if button_text != blank %}
    <a href="{{ button_link }}" class="hp8-offer-btn-{{ section_id }}">{{ button_text }}</a>
  {% endif %}
</div>

{% schema %}
{
  "name": "HP8 Offer Banner",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "PRIVATE SALE"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "UP TO 40% OFF SELECTED STYLES"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "SHOP THE SALE"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "HP8 Offer Banner"
    }
  ]
}
{% endschema %}
