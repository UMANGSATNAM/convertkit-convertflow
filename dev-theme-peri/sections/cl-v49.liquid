{% comment %} CL V49 — Bridal / Wedding {% endcomment %}
{{ 'component-facets.css' | asset_url | stylesheet_tag }}
<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
<style>
  .clv49 { background: {{ section.settings.bg_color | default: '#FFFFFF' }}; color: {{ section.settings.text_color | default: '#8C7A6B' }}; padding: 60px 20px; font-family: 'Cormorant Garamond', serif; }
  .clv49-hero { text-align: center; margin-bottom: 60px; padding: 40px 0; border-top: 1px solid #EBE5E0; border-bottom: 1px solid #EBE5E0; }
  .clv49-hero h1 { font-size: 52px; font-weight: 300; color: #4A4036; margin-bottom: 15px; font-style: italic; }
  .clv49-hero p { font-size: 16px; font-family: 'Montserrat', sans-serif; color: #A69B91; max-width: 600px; margin: 0 auto; line-height: 1.8; font-weight: 300; letter-spacing: 1px; }
  .clv49-chips { display: flex; gap: 30px; justify-content: center; margin-bottom: 60px; flex-wrap: wrap; }
  .clv49-chips a { padding: 5px 0; color: #8C7A6B; text-decoration: none; font-size: 12px; font-family: 'Montserrat', sans-serif; text-transform: uppercase; letter-spacing: 2px; transition: 0.3s; position: relative; }
  .clv49-chips a::after { content: ''; position: absolute; bottom: 0; left: 50%; width: 0%; height: 1px; background: #8C7A6B; transition: 0.3s; transform: translateX(-50%); }
  .clv49-chips a:hover::after, .clv49-chips a.active::after { width: 100%; }
  .clv49-toolbar { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #F5F2F0; padding-bottom: 15px; margin-bottom: 50px; font-family: 'Montserrat', sans-serif; }
  .clv49-grid { display: grid; grid-template-columns: repeat({{ section.settings.cols_desktop | default: 3 }}, 1fr); gap: 50px 30px; }
  .clv49-promo { grid-column: span 1; background: #FAF8F6; border: 1px solid #EBE5E0; padding: 50px; text-align: center; display: flex; flex-direction: column; justify-content: center; align-items: center; }
  .clv49-promo h3 { font-size: 32px; font-weight: 300; font-style: italic; margin-bottom: 20px; color: #4A4036; }
  .clv49-promo a { display: inline-block; padding: 12px 30px; background: transparent; color: #8C7A6B; border: 1px solid #8C7A6B; text-decoration: none; font-size: 11px; font-family: 'Montserrat', sans-serif; text-transform: uppercase; letter-spacing: 2px; transition: 0.3s; }
  .clv49-promo a:hover { background: #8C7A6B; color: #FFF; }
  .clv49-seo { margin-top: 80px; text-align: center; max-width: 800px; margin-left: auto; margin-right: auto; padding: 40px; background: #FAF8F6; }
  @media (max-width: 768px) { .clv49-grid { grid-template-columns: repeat({{ section.settings.cols_mobile | default: 1 }}, 1fr); gap: 30px; } .clv49-hero h1 { font-size: 38px; } }
</style>
<div class="clv49" style="max-width: 1200px; margin: 0 auto;">
  <div class="clv49-hero">
    <h1>{% if collection.title != blank %}{{ collection.title | escape }}{% else %}The Bridal Edit{% endif %}</h1>
    <p>{% if collection.description != blank %}{{ collection.description }}{% else %}Breathtaking silhouettes and delicate lace for your perfect day.{% endif %}</p>
  </div>
  {% if section.settings.sub_collections != blank %}
    <div class="clv49-chips">
      {% for link in section.settings.sub_collections.links %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% endfor %}
    </div>
  {% endif %}
  <div class="clv49-toolbar">
    <facet-filters-form style="width: 100%;">
      <form id="FacetFiltersForm" style="display: flex; justify-content: space-between; align-items: center; width: 100%; flex-wrap: wrap; gap: 20px;">
        <div style="display: flex; gap: 40px;">
          {%- for filter in collection.filters -%}
            <details style="position: relative;">
              <summary style="cursor: pointer; font-size: 11px; font-weight: 400; letter-spacing: 2px; text-transform: uppercase; color: #8C7A6B;">{{ filter.label }} ⏷</summary>
              <div style="position: absolute; background: #FFF; border: 1px solid #EBE5E0; padding: 25px; z-index: 10; margin-top: 15px; min-width: 250px; box-shadow: 0 10px 30px rgba(0,0,0,0.03);">
                {%- for value in filter.values -%}
                  <label style="display: block; margin-bottom: 15px; cursor: pointer; font-size: 12px; color: #4A4036;">
                    <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} style="margin-right: 10px;">
                    {{ value.label }} <span style="color: #A69B91;">({{ value.count }})</span>
                  </label>
                {%- endfor -%}
              </div>
            </details>
          {%- endfor -%}
        </div>
        <select name="sort_by" onchange="this.form.submit()" style="background: transparent; border: none; font-family: inherit; font-size: 11px; color: #8C7A6B; letter-spacing: 2px; text-transform: uppercase; cursor: pointer; outline: none;">
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>Sort By: {{ option.name }}</option>
          {%- endfor -%}
        </select>
      </form>
    </facet-filters-form>
  </div>
  {% assign limit_num = section.settings.products_per_page | default: 12 %}
  {% paginate collection.products by limit_num %}
    <div class="clv49-grid">
      {% for product in collection.products %}
        {% render 'card-v49', product: product %}
        {% if forloop.index == 5 and section.settings.show_promo_tile %}
          <div class="clv49-promo">
            <h3>Book a<br>Fitting</h3>
            <a href="/pages/appointments">Reserve</a>
          </div>
        {% endif %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v49', product: nil %}
        {% endfor %}
      {% endfor %}
    </div>
    <div style="margin-top: 60px; text-align: center; font-family: 'Montserrat', sans-serif; font-size: 12px; letter-spacing: 2px;">{{ paginate | default_pagination }}</div>
  {% endpaginate %}
  {% if section.settings.show_seo_block %}
    <div class="clv49-seo">
      <h2 style="font-size: 28px; font-weight: 300; font-style: italic; color: #4A4036; margin-bottom: 15px;">{{ section.settings.seo_title | default: 'Forever Begins Here' }}</h2>
      <p style="font-size: 13px; font-family: 'Montserrat', sans-serif; color: #8C7A6B; line-height: 2; letter-spacing: 0.5px;">{{ section.settings.seo_text | default: 'Explore our curated collection of bridal gowns, featuring intricate beadwork, luxurious silks, and timeless designs tailored for the modern bride.' }}</p>
    </div>
  {% endif %}
</div>
{% schema %}
{
  "name": "CL V49 — Bridal", "settings": [
    {"type": "range", "id": "products_per_page", "label": "Products per page", "min": 6, "max": 36, "step": 3, "default": 12},
    {"type": "range", "id": "cols_desktop", "label": "Desktop Columns", "min": 2, "max": 4, "default": 3},
    {"type": "select", "id": "cols_mobile", "label": "Mobile Columns", "options": [{"value": "1", "label": "1"}, {"value": "2", "label": "2"}], "default": "1"},
    {"type": "link_list", "id": "sub_collections", "label": "Sub-Collection Menu"},
    {"type": "checkbox", "id": "show_promo_tile", "label": "Show Promo Card", "default": true},
    {"type": "checkbox", "id": "show_seo_block", "label": "Show SEO Block", "default": true},
    {"type": "color", "id": "bg_color", "label": "Background Color", "default": "#FFFFFF"},
    {"type": "color", "id": "text_color", "label": "Text Color", "default": "#8C7A6B"}
  ], "presets": [{"name": "CL V49 — Bridal"}]
}
{% endschema %}
