{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#000000'
  assign text_color = section.settings.text_color | default: '#ffffff'
  assign heading = section.settings.heading | default: 'AS SEEN IN'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 120px 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }
  
  .hp8-press-container-{{ section_id }} {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  
  .hp8-press-heading-{{ section_id }} {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.85rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 4px;
    color: rgba({{ text_color | color_to_rgb | remove: 'rgb(' | remove: ')' }}, {{ 0.5 }});
    margin: 0 0 80px 0;
  }
  
  .hp8-press-grid-{{ section_id }} {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 60px 100px;
    width: 100%;
  }
  
  .hp8-press-logo-{{ section_id }} {
    transition: opacity 0.4s ease;
    opacity: 0.5;
    filter: invert(1); /* Assuming white logos on black background, invert if needed based on settings */
  }
  
  .hp8-press-logo-{{ section_id }}:hover {
    opacity: 1;
  }
  
  .hp8-press-logo-{{ section_id }} img {
    max-height: 35px;
    width: auto;
    object-fit: contain;
  }

  @media (max-width: 768px) {
    .hp8-press-grid-{{ section_id }} {
      gap: 40px 50px;
    }
    .hp8-press-logo-{{ section_id }} img {
      max-height: 25px;
    }
    .hp8-press-heading-{{ section_id }} {
      margin: 0 0 50px 0;
    }
  }
</style>

<div class="hp8-press-container-{{ section_id }}">
  {% if heading != blank %}
    <h3 class="hp8-press-heading-{{ section_id }}">{{ heading }}</h3>
  {% endif %}
  
  <div class="hp8-press-grid-{{ section_id }}">
    {% for block in section.blocks %}
      <div class="hp8-press-logo-{{ section_id }}" {{ block.shopify_attributes }}>
        {% if block.settings.image != blank %}
          <img src="{{ block.settings.image | image_url: width: 400 }}" alt="Press Logo" loading="lazy" width="150" height="40">
        {% else %}
          <div style="font-family: 'Bodoni MT', 'Didot', 'Playfair Display', serif; font-size: 1.8rem; font-weight: 400; color: {{ text_color }};">
            VOGUE
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "HP8 Press Logos",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "AS SEEN IN"
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo Image (White PNG recommended)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP8 Press Logos",
      "blocks": [
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" }
      ]
    }
  ]
}
{% endschema %}
