{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp64-marq-bg: {{ section.settings.bg_color | default: '#030712' }};
    --hp64-marq-text: {{ section.settings.text_color | default: '#06B6D4' }};
    background: var(--hp64-marq-bg);
    overflow: hidden;
    padding: {{ section.settings.padding_vertical | default: 10 }}px 0;
    border-top: 1px solid rgba(6, 182, 212, 0.25);
    border-bottom: 1px solid rgba(16, 185, 129, 0.25);
  }
  .hp64-marquee__track {
    display: flex; gap: 50px;
    animation: hp64MarqueeScroll {{ section.settings.speed | default: 25 }}s linear infinite;
    width: max-content;
  }
  .hp64-marquee__item {
    display: flex; align-items: center; gap: 50px; white-space: nowrap;
    font-family: 'Space Grotesk', sans-serif;
    font-size: {{ section.settings.font_size | default: 13 }}px;
    font-weight: 700; letter-spacing: 2.5px; text-transform: uppercase;
    color: var(--hp64-marq-text);
  }
  .hp64-marquee__dot {
    width: 6px; height: 6px;
    background: {{ section.settings.dot_color | default: '#10B981' }};
    border-radius: 50%; flex-shrink: 0;
    box-shadow: 0 0 10px #10B981;
  }
  @keyframes hp64MarqueeScroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
{%- endstyle -%}
<div class="hp64-marquee__track">
  {%- for i in (1..12) -%}
    <div class="hp64-marquee__item">
      <span>{{ section.settings.marquee_text | default: '🧬 DEEP SEA BIOLUMINESCENCE 🌊 HYDROTHERMAL PEPTIDES 💎 MICRO-ALGAE REPAIR ⚡ MITOCHONDRIAL GLOW' }}</span>
      <span class="hp64-marquee__dot"></span>
    </div>
  {%- endfor -%}
</div>
{% schema %}
{
  "name": "HP64 Marquee",
  "class": "section-hp64-marquee",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#030712" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#06B6D4" },
    { "type": "color", "id": "dot_color", "label": "Dot Color", "default": "#10B981" },
    { "type": "text", "id": "marquee_text", "label": "Marquee Text", "default": "🧬 DEEP SEA BIOLUMINESCENCE 🌊 HYDROTHERMAL PEPTIDES 💎 MICRO-ALGAE REPAIR ⚡ MITOCHONDRIAL GLOW" },
    { "type": "range", "id": "speed", "min": 10, "max": 50, "step": 5, "unit": "s", "label": "Speed", "default": 25 },
    { "type": "range", "id": "font_size", "min": 10, "max": 22, "step": 1, "unit": "px", "label": "Font Size", "default": 13 },
    { "type": "range", "id": "padding_vertical", "min": 4, "max": 24, "step": 2, "unit": "px", "label": "Padding", "default": 10 }
  ],
  "presets": [{ "name": "HP64 Marquee" }]
}
{% endschema %}
