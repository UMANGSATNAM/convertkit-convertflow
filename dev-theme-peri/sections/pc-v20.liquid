{%- comment -%}
  PC V20 — CLAYMORPHIC 3D SOFT UI PRODUCT GRID
  Design: Soft Lilac (#F5F3FF), Electric Violet (#7C3AED) accents, Outfit typography
  Card Shape: 24px Clay corners, soft inset & outset 3D clay shadows
{%- endcomment -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&display=swap');

  .pcv20 {
    --bg: {{ section.settings.bg_color | default: '#F5F3FF' }};
    --card-bg: {{ section.settings.card_bg | default: '#FFFFFF' }};
    --text: {{ section.settings.text_color | default: '#2E1065' }};
    --muted: {{ section.settings.muted_color | default: '#6D28D9' }};
    --accent: {{ section.settings.accent_color | default: '#7C3AED' }};
    --accent-hover: {{ section.settings.accent_hover | default: '#6D28D9' }};
    --border: {{ section.settings.border_color | default: '#DDD6FE' }};
    --badge-sale-bg: #7C3AED;
    --badge-sale-text: #FFFFFF;
    --f-main: 'Outfit', sans-serif;
    --r-card: 24px;
    --ease: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    background-color: var(--bg);
    color: var(--text);
    font-family: var(--f-main);
    padding: {{ section.settings.padding_top | default: 56 }}px 0 {{ section.settings.padding_bottom | default: 56 }}px 0;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }

  .pcv20 *, .pcv20 *::before, .pcv20 *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .pcv20 a { color: inherit; text-decoration: none; }
  .pcv20 button { font-family: inherit; cursor: pointer; border: none; background: none; }
  .pcv20 img { max-width: 100%; display: block; }

  .pcv20__wrap { max-width: 1280px; margin: 0 auto; padding: 0 20px; }

  /* HEADER */
  .pcv20__head { display: flex; flex-direction: column; gap: 8px; margin-bottom: 36px; text-align: {{ section.settings.header_align | default: 'center' }}; }
  @media (min-width: 768px) {
    .pcv20__head { display: flex; flex-direction: row; justify-content: space-between; align-items: flex-end; }
  }
  .pcv20__title { font-size: 28px; font-weight: 800; color: var(--text); letter-spacing: -0.02em; }
  @media (min-width: 768px) { .pcv20__title { font-size: 36px; } }
  .pcv20__sub { font-size: 15px; color: var(--muted); }
  .pcv20__viewall { display: inline-flex; align-items: center; gap: 8px; font-weight: 700; font-size: 13px; color: var(--accent); background: #FFFFFF; padding: 10px 20px; border-radius: 30px; box-shadow: 6px 6px 14px rgba(124, 58, 237, 0.12), -6px -6px 14px #FFFFFF; transition: var(--ease); }
  .pcv20__viewall:hover { background: var(--accent); color: #FFFFFF; }

  /* GRID */
  .pcv20__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr);
    gap: 20px;
  }
  @media (min-width: 640px) {
    .pcv20__grid { grid-template-columns: repeat({{ section.settings.cols_tablet | default: 3 }}, 1fr); gap: 24px; }
  }
  @media (min-width: 1024px) {
    .pcv20__grid { grid-template-columns: repeat({{ section.settings.cols_desktop | default: 4 }}, 1fr); gap: 28px; }
  }

  /* CARD */
  .pcv20__card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--r-card);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    position: relative;
    box-shadow: 10px 10px 24px rgba(124, 58, 237, 0.08), -10px -10px 24px #FFFFFF;
    transition: var(--ease);
  }
  .pcv20__card:hover {
    transform: translateY(-6px);
    box-shadow: 14px 14px 30px rgba(124, 58, 237, 0.14), -14px -14px 30px #FFFFFF;
    border-color: #C4B5FD;
  }

  /* IMAGE BOX */
  .pcv20__img-box {
    position: relative;
    width: 100%;
    aspect-ratio: {{ section.settings.img_ratio | default: '1/1' }};
    background: #EDE9FE;
    overflow: hidden;
    border-radius: var(--r-card) var(--r-card) 0 0;
  }
  .pcv20__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .pcv20__img--sec {
    position: absolute;
    top: 0; left: 0;
    opacity: 0;
  }
  .pcv20__card:hover .pcv20__img--pri {
    {% if section.settings.enable_sec_img %}
      opacity: 0;
    {% else %}
      transform: scale(1.05);
    {% endif %}
  }
  .pcv20__card:hover .pcv20__img--sec { opacity: 1; transform: scale(1.05); }

  /* BADGES */
  .pcv20__badges { position: absolute; top: 12px; left: 12px; display: flex; flex-direction: column; gap: 6px; z-index: 2; pointer-events: none; }
  .pcv20__badge { font-size: 10px; font-weight: 700; text-transform: uppercase; padding: 4px 10px; border-radius: 20px; letter-spacing: 0.04em; }
  .pcv20__badge--sale { background: var(--badge-sale-bg); color: var(--badge-sale-text); }
  .pcv20__badge--tag { background: #4C1D95; color: #FFFFFF; }
  .pcv20__badge--sold { background: #6B7280; color: #FFFFFF; }

  /* WISHLIST BUTTON */
  .pcv20__wish {
    position: absolute;
    top: 12px; right: 12px;
    width: 36px; height: 36px;
    border-radius: 50%;
    background: #FFFFFF;
    box-shadow: 4px 4px 10px rgba(124, 58, 237, 0.12);
    display: flex; align-items: center; justify-content: center;
    color: var(--muted);
    z-index: 3;
    transition: var(--ease);
  }
  .pcv20__wish:hover { background: var(--accent); color: #FFFFFF; transform: scale(1.1); }
  .pcv20__wish.active { color: #FFFFFF; background: var(--accent); }

  /* QUICK ADD HOVER */
  .pcv20__quick-box {
    position: absolute;
    bottom: 12px; left: 12px; right: 12px;
    z-index: 3;
    transform: translateY(12px);
    opacity: 0;
    transition: var(--ease);
  }
  .pcv20__card:hover .pcv20__quick-box { transform: translateY(0); opacity: 1; }
  @media (max-width: 767px) {
    .pcv20__quick-box { transform: translateY(0); opacity: 1; position: relative; bottom: auto; left: auto; right: auto; padding: 0 14px 14px; }
  }

  .pcv20__quick-btn {
    width: 100%;
    padding: 11px 16px;
    background: var(--accent);
    color: #FFFFFF;
    font-size: 12px; font-weight: 700;
    border-radius: 20px;
    display: flex; align-items: center; justify-content: center; gap: 8px;
    transition: var(--ease);
    box-shadow: 4px 4px 14px rgba(124, 58, 237, 0.25);
  }
  .pcv20__quick-btn:hover { background: var(--accent-hover); transform: scale(1.02); }
  .pcv20__quick-btn:disabled { background: #DDD6FE; color: #6D28D9; cursor: not-allowed; box-shadow: none; }

  /* CARD CONTENT */
  .pcv20__content { padding: 16px; display: flex; flex-direction: column; gap: 6px; flex-grow: 1; text-align: center; }

  .pcv20__vendor { font-size: 10px; text-transform: uppercase; color: var(--accent); font-weight: 700; letter-spacing: 0.08em; }
  .pcv20__item-title { font-size: 15px; font-weight: 700; color: var(--text); line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  /* RATING */
  .pcv20__rating { display: flex; align-items: center; justify-content: center; gap: 4px; font-size: 12px; color: var(--accent); font-weight: 700; }
  .pcv20__stars { letter-spacing: 1px; }
  .pcv20__rev-cnt { color: var(--muted); font-size: 11px; font-weight: 400; }

  /* PRICE */
  .pcv20__price-row { display: flex; align-items: baseline; justify-content: center; gap: 8px; margin-top: auto; padding-top: 4px; }
  .pcv20__price { font-size: 16px; font-weight: 700; color: var(--text); }
  .pcv20__cmp-price { font-size: 13px; color: var(--muted); text-decoration: line-through; }

  /* SWATCHES */
  .pcv20__swatches { display: flex; gap: 6px; align-items: center; justify-content: center; margin-top: 4px; }
  .pcv20__swatch { width: 14px; height: 14px; border-radius: 50%; border: 1px solid var(--border); cursor: pointer; transition: var(--ease); box-shadow: 2px 2px 4px rgba(124, 58, 237, 0.1); }
  .pcv20__swatch:hover, .pcv20__swatch.active { transform: scale(1.25); border-color: var(--accent); }

  /* URGENCY MICRO */
  .pcv20__urgency { font-size: 11px; color: var(--accent); font-weight: 700; display: flex; align-items: center; justify-content: center; gap: 4px; margin-top: 2px; }

  /* TOAST */
  .pcv20__toast {
    position: fixed; bottom: 20px; right: 20px;
    background: var(--accent); color: #FFFFFF;
    padding: 12px 22px; border-radius: 25px;
    font-size: 13px; font-weight: 700;
    z-index: 9999;
    transform: translateY(100px); opacity: 0;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 10px 25px rgba(124, 58, 237, 0.3);
  }
  .pcv20__toast.show { transform: translateY(0); opacity: 1; }
</style>

<div class="pcv20">
  <div class="pcv20__wrap">
    
    {% if section.settings.title != blank or section.settings.subheading != blank %}
      <div class="pcv20__head">
        <div>
          {% if section.settings.title != blank %}
            <h2 class="pcv20__title">{{ section.settings.title | escape }}</h2>
          {% endif %}
          {% if section.settings.subheading != blank %}
            <p class="pcv20__sub">{{ section.settings.subheading | escape }}</p>
          {% endif %}
        </div>
        {% if section.settings.show_view_all and section.settings.collection != blank %}
          <a href="{{ collections[section.settings.collection].url }}" class="pcv20__viewall">
            {{ section.settings.view_all_label | default: 'Explore 3D Clay' }} &rarr;
          </a>
        {% endif %}
      </div>
    {% endif %}

    <div class="pcv20__grid">
      {% assign target_coll = collections[section.settings.collection] %}
      {% assign limit_num = section.settings.products_per_page | default: 8 %}

      {% if target_coll != blank and target_coll.products.size > 0 %}
        {% for product in target_coll.products limit: limit_num %}
          {% assign current_variant = product.selected_or_first_available_variant %}
          
          {% render 'card-v20', product: product, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v20', product: nil, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% endif %}
    </div>

  </div>
</div>

<div class="pcv20__toast" id="pcv20-toast">Added to cart!</div>

<script>
(function(){
  // Wishlist is handled globally by assets/wishlist.js (shared store: cf_wishlist_items).
  // Buttons are rendered by snippets/wishlist-button.liquid — no per-section storage.


  document.querySelectorAll('[data-pcv20-add]').forEach(function(btn){
    btn.addEventListener('click', function(e){
      e.preventDefault(); e.stopPropagation();
      var id = btn.dataset.pcv20Add, orig = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = 'Adding...';

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: id, quantity: 1 })
      })
      .then(function(r){ return r.json(); })
      .then(function(){
        btn.innerHTML = '✓ Added';
        showT('Product added to cart!');
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      })
      .catch(function(){
        btn.innerHTML = 'Error';
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      });
    });
  });

  function showT(msg){
    var t = document.getElementById('pcv20-toast');
    if(!t) return;
    t.textContent = msg;
    t.classList.add('show');
    setTimeout(function(){ t.classList.remove('show'); }, 3000);
  }
})();
</script>

