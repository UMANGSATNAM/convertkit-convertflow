{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --font-heading: 'Cormorant Garamond', serif;
    --font-body: 'Inter', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    position: relative;
    overflow: hidden;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.8 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.8 | round }}px;
    }
  }

  /* Soft organic shape in background */
  .hp26-story__bg-shape {
    position: absolute;
    top: -10%;
    right: -5%;
    width: 50vw;
    height: 70vh;
    background-color: var(--accent-color);
    opacity: 0.15;
    border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%;
    z-index: 0;
    pointer-events: none;
    transform: rotate(-15deg);
  }

  .hp26-story-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    align-items: center;
    gap: 80px;
    position: relative;
    z-index: 1;
  }

  @media screen and (max-width: 1024px) {
    .hp26-story-wrapper {
      gap: 50px;
    }
  }

  @media screen and (max-width: 768px) {
    .hp26-story-wrapper {
      flex-direction: column;
      padding: 0 20px;
      gap: 40px;
    }
  }

  /* Left: Image */
  .hp26-story__image-col {
    flex: 1;
    position: relative;
  }

  .hp26-story__image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 4/5;
    /* Soft Pebble Shape */
    border-radius: 40% 60% 50% 50% / 50% 50% 60% 40%;
    overflow: hidden;
    box-shadow: 0 30px 60px rgba(0,0,0,0.05);
  }

  .hp26-story__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.5s ease;
  }

  .hp26-story__image-wrapper:hover .hp26-story__image {
    transform: scale(1.05);
  }

  /* Right: Content */
  .hp26-story__content-col {
    flex: 1;
    max-width: 550px;
  }

  @media screen and (max-width: 768px) {
    .hp26-story__content-col {
      text-align: center;
      max-width: 100%;
    }
  }

  .hp26-story__subtitle {
    font-family: var(--font-body);
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-color);
    margin-bottom: 20px;
    opacity: 0.6;
    display: flex;
    align-items: center;
    gap: 15px;
  }

  .hp26-story__subtitle::before {
    content: '';
    display: block;
    width: 25px;
    height: 1px;
    background-color: var(--text-color);
    opacity: 0.4;
  }

  @media screen and (max-width: 768px) {
    .hp26-story__subtitle {
      justify-content: center;
    }
    .hp26-story__subtitle::before {
      display: none;
    }
  }

  .hp26-story__title {
    font-family: var(--font-heading);
    font-size: clamp(36px, 5vw, {{ section.settings.title_size }}px);
    font-weight: 400;
    line-height: 1.1;
    color: var(--text-color);
    margin: 0 0 30px;
  }

  .hp26-story__title em {
    font-style: italic;
    color: var(--accent-color);
  }

  .hp26-story__text {
    font-family: var(--font-body);
    font-size: clamp(14px, 1.5vw, {{ section.settings.text_size }}px);
    line-height: 1.8;
    color: var(--text-color);
    opacity: 0.75;
    margin: 0 0 40px;
  }

  .hp26-story__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 35px;
    background-color: transparent;
    color: var(--text-color);
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    border: 1px solid rgba(44, 42, 40, 0.2);
    border-radius: 4px;
    transition: all 0.4s ease;
  }

  .hp26-story__btn:hover {
    border-color: var(--text-color);
    background-color: var(--text-color);
    color: var(--bg-color);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp26-story-wrapper" id="HP26Story-{{ section.id }}">
  <div class="hp26-story__bg-shape"></div>
  
  <div class="hp26-story__image-col">
    <div class="hp26-story__image-wrapper">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.title | escape }}" class="hp26-story__image" loading="lazy">
      {%- else -%}
        <div style="width:100%;height:100%;background:#EAE6DF;display:flex;align-items:center;justify-content:center;color:#2C2A28;font-family:var(--font-heading);font-style:italic;">BRAND IMAGE</div>
      {%- endif -%}
    </div>
  </div>

  <div class="hp26-story__content-col">
    {%- if section.settings.subtitle != blank -%}
      <div class="hp26-story__subtitle">{{ section.settings.subtitle }}</div>
    {%- endif -%}

    {%- if section.settings.title != blank -%}
      <h2 class="hp26-story__title">{{ section.settings.title }}</h2>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="hp26-story__text">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- if section.settings.btn_text != blank -%}
      <a href="{{ section.settings.btn_link | default: '#' }}" class="hp26-story__btn">
        {{ section.settings.btn_text }}
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP26 - Japandi Story",
  "class": "section-hp26-brand-story",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "OUR PHILOSOPHY"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Embracing the beauty of <em>imperfection</em>."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>We believe in the slow, the quiet, and the carefully considered. Our pieces are designed to age gracefully, bringing a sense of calm and intention to your daily rituals.</p>"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "READ OUR STORY"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Story Image"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1200
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 32,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 56
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Text Size",
      "default": 16
    },
    {
      "type": "header",
      "content": "Japandi Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#F5F2EB"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2C2A28"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#8B9582"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 100
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP26 - Japandi Story"
    }
  ]
}
{% endschema %}
