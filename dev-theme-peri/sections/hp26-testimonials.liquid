{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --font-heading: 'Cormorant Garamond', serif;
    --font-body: 'Inter', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.8 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.8 | round }}px;
    }
  }

  .hp26-test-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
    position: relative;
  }

  @media screen and (max-width: 768px) {
    .hp26-test-wrapper {
      padding: 0 20px;
    }
  }

  .hp26-test__slider {
    position: relative;
    overflow: hidden;
  }

  .hp26-test__track {
    display: flex;
    transition: transform 0.8s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .hp26-test__slide {
    flex: 0 0 100%;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 0 40px;
    opacity: 0;
    transition: opacity 0.8s ease;
  }

  .hp26-test__slide.is-active {
    opacity: 1;
  }

  @media screen and (max-width: 768px) {
    .hp26-test__slide {
      padding: 0 10px;
    }
  }

  .hp26-test__stars {
    display: flex;
    gap: 4px;
    margin-bottom: 30px;
  }

  .hp26-test__stars svg {
    width: 16px;
    height: 16px;
    fill: var(--text-color);
  }

  .hp26-test__quote {
    font-family: var(--font-heading);
    font-size: clamp(24px, 4vw, {{ section.settings.quote_size }}px);
    font-weight: 300;
    font-style: italic;
    color: var(--text-color);
    line-height: 1.4;
    margin: 0 0 40px;
    max-width: 800px;
  }

  .hp26-test__author {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-color);
    margin-bottom: 5px;
  }

  .hp26-test__verified {
    font-family: var(--font-body);
    font-size: 11px;
    color: var(--text-color);
    opacity: 0.5;
    margin-bottom: 20px;
  }

  /* Optional Product info */
  .hp26-test__product {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 8px 16px;
    background: rgba(44,42,40,0.03);
    border-radius: 4px;
    text-decoration: none;
    transition: background 0.3s ease;
  }

  .hp26-test__product:hover {
    background: rgba(44,42,40,0.06);
  }

  .hp26-test__product-img {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    object-fit: cover;
  }

  .hp26-test__product-title {
    font-family: var(--font-body);
    font-size: 12px;
    color: var(--text-color);
    font-weight: 500;
  }

  /* Navigation */
  .hp26-test__nav {
    display: flex;
    justify-content: center;
    gap: 15px;
    margin-top: 50px;
  }

  .hp26-test__nav-btn {
    width: 40px;
    height: 40px;
    border: 1px solid rgba(44, 42, 40, 0.2);
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }

  .hp26-test__nav-btn:hover {
    border-color: var(--text-color);
    background: var(--text-color);
  }

  .hp26-test__nav-btn svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: var(--text-color);
    stroke-width: 1.5;
    transition: stroke 0.3s ease;
  }

  .hp26-test__nav-btn:hover svg {
    stroke: var(--bg-color);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp26-test-wrapper" id="HP26Test-{{ section.id }}">
  <div class="hp26-test__slider">
    <div class="hp26-test__track">
      {%- for block in section.blocks -%}
        <div class="hp26-test__slide {% if forloop.first %}is-active{% endif %}" {{ block.shopify_attributes }}>
          
          <div class="hp26-test__stars">
            {%- for i in (1..5) -%}
              <svg viewBox="0 0 24 24"><path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/></svg>
            {%- endfor -%}
          </div>

          <blockquote class="hp26-test__quote">
            "{{ block.settings.quote }}"
          </blockquote>

          <div class="hp26-test__author">{{ block.settings.author }}</div>
          <div class="hp26-test__verified">Verified Buyer</div>

          {%- if block.settings.product != blank -%}
            {%- assign prod = block.settings.product -%}
            <a href="{{ prod.url }}" class="hp26-test__product">
              {%- if prod.featured_image != blank -%}
                <img src="{{ prod.featured_image | image_url: width: 100 }}" alt="{{ prod.title | escape }}" class="hp26-test__product-img" loading="lazy">
              {%- endif -%}
              <span class="hp26-test__product-title">{{ prod.title }}</span>
            </a>
          {%- endif -%}

        </div>
      {%- endfor -%}
    </div>
  </div>

  {%- if section.blocks.size > 1 -%}
    <div class="hp26-test__nav">
      <button class="hp26-test__nav-btn hp26-test__prev" aria-label="Previous">
        <svg viewBox="0 0 24 24"><path d="M15 18l-6-6 6-6"/></svg>
      </button>
      <button class="hp26-test__nav-btn hp26-test__next" aria-label="Next">
        <svg viewBox="0 0 24 24"><path d="M9 18l6-6-6-6"/></svg>
      </button>
    </div>
  {%- endif -%}
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const section = document.querySelector('#HP26Test-{{ section.id }}');
    if(!section) return;

    const track = section.querySelector('.hp26-test__track');
    const slides = section.querySelectorAll('.hp26-test__slide');
    const prev = section.querySelector('.hp26-test__prev');
    const next = section.querySelector('.hp26-test__next');
    
    if(!track || slides.length <= 1) return;

    let currentIndex = 0;

    function updateSlider() {
      track.style.transform = `translateX(-${currentIndex * 100}%)`;
      slides.forEach((slide, index) => {
        if(index === currentIndex) {
          slide.classList.add('is-active');
        } else {
          slide.classList.remove('is-active');
        }
      });
    }

    if(prev) {
      prev.addEventListener('click', () => {
        currentIndex = (currentIndex > 0) ? currentIndex - 1 : slides.length - 1;
        updateSlider();
      });
    }

    if(next) {
      next.addEventListener('click', () => {
        currentIndex = (currentIndex < slides.length - 1) ? currentIndex + 1 : 0;
        updateSlider();
      });
    }
  });
</script>

{% schema %}
{
  "name": "HP26 - Japandi Reviews",
  "class": "section-hp26-testimonials",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 800,
      "max": 1400,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1000
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "quote_size",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Quote Size",
      "default": 40
    },
    {
      "type": "header",
      "content": "Japandi Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#EAE6DF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2C2A28"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 100
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "The aesthetic is undeniably calming. These pieces have completely transformed the energy of my home."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "ELENA M."
        },
        {
          "type": "product",
          "id": "product",
          "label": "Referenced Product (Optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP26 - Japandi Reviews",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" }
      ]
    }
  ]
}
{% endschema %}
