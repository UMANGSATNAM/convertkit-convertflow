{%- liquid
  assign bg_color = section.settings.bg_color | default: '#f4ede6'
  assign text_color = section.settings.text_color | default: '#5c5044'
-%}

<section class="hp1-beauty-usp" style="background-color: {{ bg_color }}; color: {{ text_color }};" id="hp1-usp-{{ section.id }}">
  <div class="hp1-usp-inner">
    <div class="hp1-usp-grid">
      {%- for block in section.blocks -%}
        <div class="hp1-usp-item" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != 'none' -%}
            <div class="hp1-usp-icon">
              {% render 'icon', icon: block.settings.icon %}
            </div>
          {%- elsif block.settings.custom_icon != blank -%}
            <div class="hp1-usp-icon">
              <img src="{{ block.settings.custom_icon | image_url: width: 60 }}" alt="" width="30" height="30" loading="lazy">
            </div>
          {%- endif -%}
          <div class="hp1-usp-text">
            {%- if block.settings.heading != blank -%}
              <h4 class="hp1-usp-heading">{{ block.settings.heading }}</h4>
            {%- endif -%}
            {%- if block.settings.subheading != blank -%}
              <p class="hp1-usp-subheading">{{ block.settings.subheading }}</p>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .hp1-beauty-usp {
    padding: 30px 0;
    border-bottom: 1px solid rgba(0,0,0,0.05);
  }
  .hp1-usp-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }
  .hp1-usp-grid {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 20px;
  }
  .hp1-usp-item {
    flex: 1;
    min-width: 200px;
    display: flex;
    align-items: center;
    gap: 15px;
    justify-content: center;
    transition: transform 0.3s ease;
  }
  .hp1-usp-item:hover {
    transform: translateY(-2px);
  }
  .hp1-usp-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.4);
    color: currentColor;
  }
  .hp1-usp-icon svg {
    width: 24px;
    height: 24px;
    stroke-width: 1.5;
  }
  .hp1-usp-icon img {
    width: 24px;
    height: 24px;
    object-fit: contain;
  }
  .hp1-usp-text {
    display: flex;
    flex-direction: column;
  }
  .hp1-usp-heading {
    margin: 0 0 4px;
    font-family: 'Playfair Display', serif;
    font-size: 16px;
    font-weight: 500;
  }
  .hp1-usp-subheading {
    margin: 0;
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    opacity: 0.8;
  }

  @media (max-width: 768px) {
    .hp1-usp-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      row-gap: 30px;
    }
    .hp1-usp-item {
      flex-direction: column;
      text-align: center;
      gap: 10px;
    }
  }
  @media (max-width: 480px) {
    .hp1-usp-grid {
      grid-template-columns: 1fr;
    }
    .hp1-usp-item {
      flex-direction: row;
      text-align: left;
    }
  }
</style>

{% schema %}
{
  "name": "HP1 USP Bar",
  "tag": "section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f4ede6"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#5c5044"
    }
  ],
  "blocks": [
    {
      "type": "usp",
      "name": "USP Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "truck", "label": "Truck (Shipping)" },
            { "value": "shield", "label": "Shield (Secure)" },
            { "value": "return", "label": "Return Arrow" },
            { "value": "support", "label": "Support/Chat" },
            { "value": "leaf", "label": "Leaf (Organic)" },
            { "value": "star", "label": "Star (Premium)" }
          ],
          "default": "truck"
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Custom Icon Image (Overrides Select)"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Free Shipping"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading",
          "default": "On orders over $50"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP1 USP Bar",
      "blocks": [
        { "type": "usp", "settings": { "icon": "truck", "heading": "Free Shipping", "subheading": "On all orders" } },
        { "type": "usp", "settings": { "icon": "shield", "heading": "Secure Payment", "subheading": "100% safe checkout" } },
        { "type": "usp", "settings": { "icon": "return", "heading": "Easy Returns", "subheading": "30-day return policy" } },
        { "type": "usp", "settings": { "icon": "leaf", "heading": "100% Organic", "subheading": "Natural ingredients" } }
      ]
    }
  ]
}
{% endschema %}
