{%- comment -%}
  PDP V4: Supplement / FMCG (Vibrant & Block-based)
  FULL PAGE ARCHITECTURE
{%- endcomment -%}

{%- assign current_variant = product.selected_or_first_available_variant -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,600;1,400&family=Raleway:wght@400;600;700;800&display=swap');

  :root {
    --v4-primary: #15803D; /* Deep Green */
    --v4-accent: #EAB308; /* Bright Gold */
    --v4-bg: #F0FDF4; /* Mint background */
    --v4-surface: #FFFFFF;
    --v4-border: #BBF7D0;
    --v4-text: #166534;
    --v4-text-muted: #14532D;
    
    --v4-font-heading: 'Raleway', sans-serif;
    --v4-font-body: 'Lora', serif;
    
    --v4-radius: 12px;
  }

  .pdp-v4 {
    background-color: var(--v4-bg);
    color: var(--v4-text);
    font-family: var(--v4-font-body);
    overflow-x: hidden;
  }

  /* --- HERO SECTION --- */
  .pdp-v4__hero {
    padding: 40px 16px;
  }
  .pdp-v4__hero-container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    gap: 40px;
  }
  @media (min-width: 992px) {
    .pdp-v4__hero-container { grid-template-columns: 1fr 1fr; }
  }

  .pdp-v4__gallery img {
    width: 100%;
    border-radius: var(--v4-radius);
    border: 2px solid var(--v4-border);
    box-shadow: 0 10px 30px rgba(21, 128, 61, 0.1);
  }

  .pdp-v4__badge {
    background: var(--v4-accent);
    color: #422006;
    font-family: var(--v4-font-heading);
    font-weight: 800;
    font-size: 12px;
    text-transform: uppercase;
    padding: 6px 12px;
    border-radius: 99px;
    display: inline-block;
    margin-bottom: 16px;
    letter-spacing: 0.05em;
  }

  .pdp-v4__title {
    font-family: var(--v4-font-heading);
    font-size: 42px;
    font-weight: 800;
    line-height: 1.1;
    margin: 0 0 16px 0;
    color: #14532D;
  }

  .pdp-v4__price {
    font-family: var(--v4-font-heading);
    font-size: 32px;
    font-weight: 700;
    margin-bottom: 24px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .pdp-v4__price s { color: #86EFAC; font-size: 20px; }

  /* Subscription Box */
  .pdp-v4__sub-box {
    background: var(--v4-surface);
    border: 2px solid var(--v4-primary);
    border-radius: var(--v4-radius);
    padding: 24px;
    margin-bottom: 32px;
    box-shadow: 0 4px 20px rgba(21, 128, 61, 0.05);
  }

  .pdp-v4__sub-option {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 16px;
    cursor: pointer;
  }
  .pdp-v4__sub-option:last-child { margin-bottom: 0; }

  .pdp-v4__radio {
    width: 24px;
    height: 24px;
    border: 2px solid var(--v4-primary);
    border-radius: 50%;
    margin-top: 2px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .pdp-v4__sub-option.active .pdp-v4__radio::after {
    content: '';
    width: 12px;
    height: 12px;
    background: var(--v4-primary);
    border-radius: 50%;
  }

  .pdp-v4__sub-text { font-family: var(--v4-font-heading); font-weight: 600; font-size: 16px; }
  .pdp-v4__sub-desc { font-size: 14px; color: var(--v4-text-muted); font-family: var(--v4-font-body); }

  .pdp-v4__atc {
    width: 100%;
    background: var(--v4-primary);
    color: #FFF;
    border: none;
    padding: 20px;
    font-family: var(--v4-font-heading);
    font-size: 18px;
    font-weight: 800;
    border-radius: var(--v4-radius);
    cursor: pointer;
    box-shadow: 0 4px 12px rgba(21, 128, 61, 0.3);
    transition: transform 200ms, box-shadow 200ms;
  }
  .pdp-v4__atc:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(21, 128, 61, 0.4);
  }

  /* --- BENEFITS SECTION --- */
  .pdp-v4__benefits {
    background: var(--v4-surface);
    padding: 80px 16px;
    border-top: 1px solid var(--v4-border);
    border-bottom: 1px solid var(--v4-border);
  }
  .pdp-v4__benefits-container { max-width: 1200px; margin: 0 auto; }
  .pdp-v4__benefits-title { text-align: center; font-family: var(--v4-font-heading); font-size: 32px; font-weight: 800; margin-bottom: 40px; }
  .pdp-v4__benefits-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 32px; }
  .pdp-v4__benefit-card { background: var(--v4-bg); padding: 32px; border-radius: var(--v4-radius); text-align: center; }
  .pdp-v4__benefit-icon { width: 64px; height: 64px; background: var(--v4-primary); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px auto; color: white; }
  .pdp-v4__benefit-title { font-family: var(--v4-font-heading); font-size: 20px; font-weight: 700; margin-bottom: 12px; }

  /* --- CROSS-SELL SECTION --- */
  .pdp-v4__cross {
    padding: 80px 16px;
    background: var(--v4-bg);
  }
  .pdp-v4__cross-container { max-width: 900px; margin: 0 auto; background: var(--v4-surface); padding: 40px; border-radius: var(--v4-radius); border: 2px dashed var(--v4-primary); }
  .pdp-v4__cross-title { font-family: var(--v4-font-heading); font-size: 24px; font-weight: 800; margin-bottom: 24px; text-align: center; }
  .pdp-v4__cross-item { display: flex; align-items: center; gap: 20px; padding-bottom: 20px; border-bottom: 1px solid var(--v4-border); margin-bottom: 20px; }
  .pdp-v4__cross-item:last-child { border: none; margin: 0; padding: 0; }
  .pdp-v4__cross-img { width: 80px; height: 80px; border-radius: 8px; object-fit: cover; background: #eee; }
  .pdp-v4__cross-info { flex: 1; }
  .pdp-v4__cross-name { font-family: var(--v4-font-heading); font-size: 18px; font-weight: 700; }
  .pdp-v4__cross-price { font-weight: 600; color: var(--v4-primary); }
  .pdp-v4__cross-add { background: var(--v4-primary); color: white; border: none; padding: 8px 16px; border-radius: 6px; font-weight: 700; cursor: pointer; }

  /* --- FEATURED GRID --- */
  .pdp-v4__grid-sec { padding: 80px 16px; background: var(--v4-surface); }
  .pdp-v4__grid-container { max-width: 1200px; margin: 0 auto; }
  .pdp-v4__grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 24px; margin-top: 40px; }
  .pdp-v4__product-card { border: 1px solid var(--v4-border); border-radius: var(--v4-radius); overflow: hidden; padding: 16px; text-align: center; transition: all 300ms; }
  .pdp-v4__product-card:hover { transform: translateY(-5px); box-shadow: 0 10px 20px rgba(0,0,0,0.05); }
  .pdp-v4__product-img { width: 100%; height: 200px; object-fit: cover; border-radius: 8px; margin-bottom: 16px; }

</style>

<div class="pdp-v4" data-section="{{ section.id }}">
  
  <!-- HERO -->
  <div class="pdp-v4__hero">
    <div class="pdp-v4__hero-container">
      <div class="pdp-v4__gallery">
        {% if product.featured_media %}
          <img src="{{ product.featured_media | image_url: width: 800 }}" alt="{{ product.title }}">
        {% else %}
          {{ 'product-1' | placeholder_svg_tag }}
        {% endif %}
      </div>

      <div class="pdp-v4__info">
        <div class="pdp-v4__badge">Bestseller</div>
        <h1 class="pdp-v4__title">{{ product.title }}</h1>
        <div style="font-size:14px; margin-bottom:20px;">â­â­â­â­â­ 4.9/5 (2,304 Reviews)</div>
        
        <div class="pdp-v4__price">
          {{ current_variant.price | money }}
          {% if current_variant.compare_at_price > current_variant.price %}
            <s>{{ current_variant.compare_at_price | money }}</s>
          {% endif %}
        </div>

        <div class="pdp-v4__sub-box">
          <div class="pdp-v4__sub-option active">
            <div class="pdp-v4__radio"></div>
            <div>
              <div class="pdp-v4__sub-text">Subscribe & Save 20%</div>
              <div class="pdp-v4__sub-desc">Delivery every 30 days. Cancel anytime.</div>
            </div>
          </div>
          <div class="pdp-v4__sub-option">
            <div class="pdp-v4__radio"></div>
            <div>
              <div class="pdp-v4__sub-text">One-time Purchase</div>
              <div class="pdp-v4__sub-desc">{{ current_variant.price | money }}</div>
            </div>
          </div>
        </div>

        <button class="pdp-v4__atc">ADD TO CART</button>
        <div style="text-align: center; margin-top:16px; font-size:14px; color:var(--v4-text-muted);">
          <svg style="width:16px;height:16px;vertical-align:middle;margin-right:4px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          30-Day Money-Back Guarantee
        </div>
      </div>
    </div>
  </div>

  <!-- BENEFITS -->
  <div class="pdp-v4__benefits">
    <div class="pdp-v4__benefits-container">
      <h2 class="pdp-v4__benefits-title">Why Choose {{ product.title }}?</h2>
      <div class="pdp-v4__benefits-grid">
        <div class="pdp-v4__benefit-card">
          <div class="pdp-v4__benefit-icon">
            <svg style="width:32px;height:32px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
          </div>
          <div class="pdp-v4__benefit-title">All-Day Energy</div>
          <div class="pdp-v4__sub-desc">Sustained energy without the crash. Formulated with adaptogens to keep you focused.</div>
        </div>
        <div class="pdp-v4__benefit-card">
          <div class="pdp-v4__benefit-icon">
            <svg style="width:32px;height:32px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
          </div>
          <div class="pdp-v4__benefit-title">Clean Ingredients</div>
          <div class="pdp-v4__sub-desc">100% vegan, non-GMO, and free from artificial sweeteners and fillers.</div>
        </div>
        <div class="pdp-v4__benefit-card">
          <div class="pdp-v4__benefit-icon">
            <svg style="width:32px;height:32px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
          </div>
          <div class="pdp-v4__benefit-title">Doctor Formulated</div>
          <div class="pdp-v4__sub-desc">Developed by leading nutritionists for maximum bioavailability and absorption.</div>
        </div>
      </div>
    </div>
  </div>

  <!-- CROSS-SELL / FREQUENTLY BOUGHT TOGETHER -->
  <div class="pdp-v4__cross">
    <div class="pdp-v4__cross-container">
      <h3 class="pdp-v4__cross-title">Frequently Bought Together</h3>
      
      <div class="pdp-v4__cross-item">
        <div class="pdp-v4__cross-img">{{ 'product-2' | placeholder_svg_tag }}</div>
        <div class="pdp-v4__cross-info">
          <div class="pdp-v4__cross-name">Daily Multivitamin</div>
          <div class="pdp-v4__cross-price">$29.99</div>
        </div>
        <button class="pdp-v4__cross-add">+ Add</button>
      </div>

      <div class="pdp-v4__cross-item">
        <div class="pdp-v4__cross-img">{{ 'product-3' | placeholder_svg_tag }}</div>
        <div class="pdp-v4__cross-info">
          <div class="pdp-v4__cross-name">Premium Shaker Bottle</div>
          <div class="pdp-v4__cross-price">$14.99</div>
        </div>
        <button class="pdp-v4__cross-add">+ Add</button>
      </div>
    </div>
  </div>

  <!-- FEATURED GRID -->
  <div class="pdp-v4__grid-sec">
    <div class="pdp-v4__grid-container">
      <h2 class="pdp-v4__benefits-title">Customers Also Loved</h2>
      <div class="pdp-v4__grid">
        {% for i in (1..4) %}
        <div class="pdp-v4__product-card">
          <div class="pdp-v4__product-img">{{ 'product-' | append: i | placeholder_svg_tag }}</div>
          <h4 class="pdp-v4__cross-name">Wellness Product {{ i }}</h4>
          <p class="pdp-v4__cross-price">$39.99</p>
        </div>
        {% endfor %}
      </div>
    </div>
  </div>

</div>


<!-- STICKY ATC -->
<style>
  .sticky-atc-{{ section.id }} {
    position: fixed;
    bottom: -100px;
    left: 0;
    width: 100%;
    background: #FFF;
    box-shadow: 0 -4px 10px rgba(0,0,0,0.1);
    z-index: 999;
    padding: 10px 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: bottom 0.3s ease-in-out;
    border-top: 1px solid #eee;
  }
  .sticky-atc-{{ section.id }}.visible {
    bottom: 0;
  }
  .sticky-atc-{{ section.id }}__info { display: flex; align-items: center; gap: 10px; }
  .sticky-atc-{{ section.id }}__img { width: 40px; height: 40px; object-fit: cover; border-radius: 4px; }
  .sticky-atc-{{ section.id }}__title { font-weight: 600; font-size: 14px; color: #000; }
  .sticky-atc-{{ section.id }}__price { font-weight: 700; color: #D32F2F; font-size: 14px; }
  .sticky-atc-{{ section.id }}__btn { background: #000; color: #FFF; border: none; padding: 12px 24px; font-weight: 700; cursor: pointer; border-radius: 4px; text-transform: uppercase; }
  .sticky-atc-{{ section.id }}__btn:hover { opacity: 0.8; }
  @media (max-width: 768px) {
    .sticky-atc-{{ section.id }}__info { display: none; }
    .sticky-atc-{{ section.id }}__btn { width: 100%; padding: 14px; font-size: 16px; }
  }
</style>

<div class="sticky-atc-{{ section.id }}" id="sticky-atc-{{ section.id }}">
  <div class="sticky-atc-{{ section.id }}__info">
    {% if product.featured_media %}
      <img src="{{ product.featured_media | image_url: width: 100 }}" class="sticky-atc-{{ section.id }}__img">
    {% endif %}
    <div>
      <div class="sticky-atc-{{ section.id }}__title">{{ product.title }}</div>
      <div class="sticky-atc-{{ section.id }}__price">{{ product.selected_or_first_available_variant.price | money }}</div>
    </div>
  </div>
  <button class="sticky-atc-{{ section.id }}__btn" onclick="window.scrollTo({top: 0, behavior: 'smooth'})">ADD TO CART</button>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const stickyBar = document.getElementById('sticky-atc-{{ section.id }}');
    if(stickyBar) {
      window.addEventListener('scroll', function() {
        if (window.scrollY > 600) {
          stickyBar.classList.add('visible');
        } else {
          stickyBar.classList.remove('visible');
        }
      });
    }
  });
</script>

