{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#ffe8d6'
  assign text_color = section.settings.text_color | default: '#6b705c'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 0;
  }
  
  .hp14-lookbook-container-{{ section_id }} {
    position: relative;
    width: 100%;
    height: 100vh;
    min-height: 700px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  
  .hp14-lookbook-bg-{{ section_id }} {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover;
  }
  
  .hp14-lookbook-overlay-{{ section_id }} {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(107, 112, 92, 0.1);
  }
  
  .hp14-lookbook-hotspot-{{ section_id }} {
    position: absolute;
    width: 30px;
    height: 30px;
    background: rgba(255, 255, 255, 0.8);
    border-radius: 50%;
    cursor: pointer;
    transition: transform 0.3s ease;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 0 10px rgba(255,255,255,0.2);
  }
  
  .hp14-lookbook-hotspot-{{ section_id }}::before {
    content: '';
    width: 10px; height: 10px;
    background: #cb997e;
    border-radius: 50%;
  }
  
  .hp14-lookbook-hotspot-{{ section_id }}:hover {
    transform: scale(1.1);
    background: #fff;
  }
  
  .hp14-lookbook-tooltip-{{ section_id }} {
    position: absolute;
    top: 45px;
    left: 50%;
    transform: translateX(-50%);
    background: #fff;
    padding: 15px;
    border-radius: 10px;
    min-width: 200px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease, transform 0.3s ease;
    box-shadow: 0 10px 25px rgba(0,0,0,0.1);
    text-align: center;
  }
  
  .hp14-lookbook-hotspot-{{ section_id }}:hover .hp14-lookbook-tooltip-{{ section_id }} {
    opacity: 1;
    pointer-events: auto;
    transform: translateX(-50%) translateY(5px);
  }
  
  .hp14-lookbook-product-title-{{ section_id }} {
    font-family: 'Georgia', serif;
    font-size: 1rem;
    color: {{ text_color }};
    margin: 0 0 5px 0;
  }
  
  .hp14-lookbook-product-price-{{ section_id }} {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.9rem;
    color: #cb997e;
    margin-bottom: 10px;
  }
  
  .hp14-lookbook-btn-{{ section_id }} {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #fff;
    background: #cb997e;
    text-decoration: none;
    padding: 8px 15px;
    border-radius: 20px;
    display: inline-block;
  }

  @media (max-width: 768px) {
    .hp14-lookbook-container-{{ section_id }} {
      height: 70vh;
      min-height: 500px;
    }
  }
</style>

<div class="hp14-lookbook-container-{{ section_id }}">
  {% if section.settings.image != blank %}
    <img height="{{ section.settings.image.height }}" width="{{ section.settings.image.width }}" src="{{ section.settings.image | image_url: width: 2000 }}" class="hp14-lookbook-bg-{{ section_id }}" alt="Lookbook">
  {% else %}
    <div class="hp14-lookbook-bg-{{ section_id }}" style="background: repeating-linear-gradient(45deg, #EFEFEF, #EFEFEF 12px, #E6E6E6 12px, #E6E6E6 24px);"></div>
  {% endif %}
  <div class="hp14-lookbook-overlay-{{ section_id }}"></div>
  
  {% for block in section.blocks %}
    <div class="hp14-lookbook-hotspot-{{ section_id }}" style="top: {{ block.settings.top }}%; left: {{ block.settings.left }}%;" {{ block.shopify_attributes }}>
      <div class="hp14-lookbook-tooltip-{{ section_id }}">
        {% assign product = all_products[block.settings.product] %}
        {% if product != blank %}
          <h4 class="hp14-lookbook-product-title-{{ section_id }}">{{ product.title }}</h4>
          <div class="hp14-lookbook-product-price-{{ section_id }}">{{ product.price | money }}</div>
          <a href="{{ product.url }}" class="hp14-lookbook-btn-{{ section_id }}">View Details</a>
        {% else %}
          <h4 class="hp14-lookbook-product-title-{{ section_id }}">Botanical Oil</h4>
          <div class="hp14-lookbook-product-price-{{ section_id }}">$38.00</div>
          <a href="#" class="hp14-lookbook-btn-{{ section_id }}">View Details</a>
        {% endif %}
      </div>
    </div>
  {% endfor %}
</div>

{% schema %}
{
  "name": "HP14 Lookbook",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffe8d6"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#6b705c"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Lookbook Image"
    }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "Hotspot",
      "settings": [
        {
          "type": "range",
          "id": "top",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Top Position",
          "default": 50
        },
        {
          "type": "range",
          "id": "left",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Left Position",
          "default": 50
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP14 Lookbook",
      "blocks": [
        { "type": "hotspot", "settings": { "top": 40, "left": 30 } },
        { "type": "hotspot", "settings": { "top": 60, "left": 70 } }
      ]
    }
  ]
}
{% endschema %}
