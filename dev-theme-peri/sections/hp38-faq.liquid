{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Space+Mono:ital,wght@0,400;0,700;1,400;1,700&family=Inter:wght@400;600;800&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    
    --font-heading: 'Space Mono', monospace;
    --font-body: 'Inter', sans-serif;
    
    background-color: var(--bg-color);
    border-bottom: 2px solid var(--text-color);
  }

  .hp38-faq-wrapper {
    display: grid;
    grid-template-columns: 350px 1fr;
    gap: 2px;
    background: var(--text-color);
  }

  @media screen and (max-width: 992px) {
    .hp38-faq-wrapper {
      grid-template-columns: 1fr;
    }
  }

  .hp38-faq__sidebar {
    background: var(--bg-color);
    padding: 60px 40px;
    display: flex;
    flex-direction: column;
  }

  @media screen and (max-width: 768px) {
    .hp38-faq__sidebar {
      padding: 40px 20px;
    }
  }

  .hp38-faq__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    line-height: 1.1;
    color: var(--text-color);
    text-transform: uppercase;
    margin: 0 0 20px;
  }

  .hp38-faq__meta {
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 700;
    color: var(--accent-color);
    margin-bottom: 40px;
  }

  .hp38-faq__content {
    background: var(--bg-color);
    display: flex;
    flex-direction: column;
  }

  .hp38-faq__item {
    border-bottom: 2px solid var(--text-color);
  }

  .hp38-faq__item:last-child {
    border-bottom: none;
  }

  .hp38-faq__question {
    width: 100%;
    text-align: left;
    background: none;
    border: none;
    padding: 30px 40px;
    font-family: var(--font-heading);
    font-size: 18px;
    color: var(--text-color);
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: background 0.2s ease, color 0.2s ease;
  }

  @media screen and (max-width: 768px) {
    .hp38-faq__question {
      padding: 20px;
      font-size: 16px;
    }
  }

  .hp38-faq__question:hover {
    background: var(--text-color);
    color: var(--bg-color);
  }

  .hp38-faq__icon {
    font-family: var(--font-heading);
    font-size: 16px;
    font-weight: 700;
  }

  .hp38-faq__answer {
    display: none;
    padding: 0 40px 40px;
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.6;
    color: var(--text-color);
  }

  @media screen and (max-width: 768px) {
    .hp38-faq__answer {
      padding: 0 20px 20px;
    }
  }

  .hp38-faq__item.is-active .hp38-faq__answer {
    display: block;
    padding-top: 20px;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp38-faq-wrapper" id="HP38Faq-{{ section.id }}">
  <div class="hp38-faq__sidebar">
    <h2 class="hp38-faq__title">{{ section.settings.title }}</h2>
    <div class="hp38-faq__meta">INDEX // KNOWLEDGE_BASE</div>
  </div>
  
  <div class="hp38-faq__content">
    {%- for block in section.blocks -%}
      <div class="hp38-faq__item {% if forloop.first %}is-active{% endif %}" {{ block.shopify_attributes }}>
        <button class="hp38-faq__question">
          <span>Q{{ forloop.index }}: {{ block.settings.question }}</span>
          <span class="hp38-faq__icon" data-state="{% if forloop.first %}[-]{% else %}[+]{% endif %}">{% if forloop.first %}[-]{% else %}[+]{% endif %}</span>
        </button>
        <div class="hp38-faq__answer">
          {{ block.settings.answer }}
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const wrapper = document.getElementById('HP38Faq-{{ section.id }}');
    const items = wrapper.querySelectorAll('.hp38-faq__item');
    
    items.forEach(item => {
      const btn = item.querySelector('.hp38-faq__question');
      const icon = item.querySelector('.hp38-faq__icon');
      
      btn.addEventListener('click', () => {
        const isActive = item.classList.contains('is-active');
        
        // Close all
        items.forEach(i => {
          i.classList.remove('is-active');
          const iIcon = i.querySelector('.hp38-faq__icon');
          if(iIcon) iIcon.textContent = '[+]';
        });
        
        // Open clicked if it wasn't already open
        if (!isActive) {
          item.classList.add('is-active');
          icon.textContent = '[-]';
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "HP38 - Brutalist FAQ",
  "class": "section-hp38-faq",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "SYSTEM PROTOCOLS"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 48
    },
    {
      "type": "header",
      "content": "Brutalist Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text & Grid Lines",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#0000FF"
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "GLOBAL SHIPPING PARAMETERS?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Logistics network activated globally. Standard deployment 5-7 operational days.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP38 - Brutalist FAQ",
      "blocks": [
        { "type": "faq" },
        { "type": "faq", "settings": { "question": "RETURN PROTOCOL?", "answer": "<p>Initiate return sequence within 30 days of receipt. Equipment must be unused.</p>" } },
        { "type": "faq", "settings": { "question": "SIZING METRICS?", "answer": "<p>All garments engineered to strict standard specifications. Consult data tables on product modules.</p>" } }
      ]
    }
  ]
}
{% endschema %}
