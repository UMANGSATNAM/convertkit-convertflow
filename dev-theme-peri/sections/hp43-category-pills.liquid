<style>
@media screen and (max-width: 768px) {
  .hp43-category-pills {
    padding-left: 16px !important;
    padding-right: 16px !important;
    box-sizing: border-box !important;
  }
  img {
    max-width: 100% !important;
    height: auto !important;
  }
}
</style>
{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: "#080B10" }};
    padding: 40px 20px;
    border-top: 1px solid #1E293B;
    border-bottom: 1px solid #1E293B;
  }

  .hp43-pills__container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .hp43-pill-item {
    padding: 12px 26px;
    background: #101622;
    border: 1px solid #1E293B;
    border-radius: 4px;
    font-family: 'Rajdhani', sans-serif;
    font-size: 16px;
    font-weight: 700;
    color: #F1F5F9;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: all 0.25s ease;
  }

  .hp43-pill-item:hover, .hp43-pill-item--active {
    background: #00F0FF;
    color: #080B10;
    border-color: #00F0FF;
    box-shadow: 0 0 20px rgba(0, 240, 255, 0.4);
  }
{%- endstyle -%}

<div class="hp43-pills__container">
  <a href="/collections/all" class="hp43-pill-item hp43-pill-item--active">⚡ ALL GEAR</a>
  <a href="/collections/keyboards" class="hp43-pill-item">⌨️ KEYBOARDS</a>
  <a href="/collections/audio" class="hp43-pill-item">🎧 AUDIO SYSTEM</a>
  <a href="/collections/timepieces" class="hp43-pill-item">⌚ CHRONO HEADS</a>
  <a href="/collections/tactical" class="hp43-pill-item">🎒 TACTICAL PACKS</a>
</div>

{% schema %}
{
  "name": "HP43 - Cyber Categories",
  "class": "section-hp43-categories",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#080B10"
    }
  ],
  "presets": [
    {
      "name": "HP43 - Cyber Categories"
    }
  ]
}
{% endschema %}
