{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Shrikhand&family=DM+Sans:wght@400;500;700&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --box-bg: {{ section.settings.box_bg }};
    
    --font-heading: 'Shrikhand', cursive;
    --font-body: 'DM Sans', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .hp37-story-wrapper {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    align-items: center;
    gap: 80px;
  }

  @media screen and (max-width: 992px) {
    .hp37-story-wrapper {
      flex-direction: column;
      gap: 50px;
    }
  }

  @media screen and (max-width: 768px) {
    .hp37-story-wrapper {
      padding: 0 20px;
    }
  }

  .hp37-story__image-col {
    flex: 1;
    position: relative;
  }

  /* Funky wavy image mask container */
  .hp37-story__image-container {
    background: var(--box-bg);
    border: 3px solid var(--text-color);
    border-radius: 40px 100px 40px 100px; /* Quirky asymmetrical radius */
    padding: 20px;
    box-shadow: 8px 8px 0px var(--text-color);
    transform: rotate(-2deg);
  }

  .hp37-story__image-inner {
    border-radius: 20px 80px 20px 80px;
    overflow: hidden;
    border: 2px solid var(--text-color);
    aspect-ratio: 4/5;
  }

  .hp37-story__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    mix-blend-mode: multiply;
  }

  /* Decorative sticker */
  .hp37-story__sticker {
    position: absolute;
    bottom: -20px;
    right: -20px;
    width: 120px;
    height: 120px;
    background: var(--accent-color);
    border: 3px solid var(--text-color);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transform: rotate(15deg);
    font-family: var(--font-heading);
    color: var(--bg-color);
    font-size: 20px;
    text-align: center;
    line-height: 1;
    box-shadow: 4px 4px 0px var(--text-color);
    z-index: 2;
  }

  .hp37-story__content-col {
    flex: 1;
  }

  .hp37-story__title {
    font-family: var(--font-heading);
    font-size: clamp(40px, 6vw, {{ section.settings.title_size }}px);
    line-height: 1.1;
    color: var(--text-color);
    margin: 0 0 30px;
    text-shadow: 2px 2px 0px var(--accent-color);
  }

  .hp37-story__text {
    font-family: var(--font-body);
    font-size: 18px;
    line-height: 1.6;
    color: var(--text-color);
    margin: 0 0 40px;
    font-weight: 500;
  }

  .hp37-story__text p {
    margin: 0 0 20px;
  }

  .hp37-story__btn {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 700;
    text-decoration: none;
    padding: 16px 35px;
    background-color: var(--text-color);
    color: var(--bg-color);
    border-radius: 50px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    box-shadow: 4px 4px 0px var(--box-bg);
  }

  .hp37-story__btn:hover {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0px var(--box-bg);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp37-story-wrapper" id="HP37Story-{{ section.id }}">
  <div class="hp37-story__image-col">
    <div class="hp37-story__image-container">
      <div class="hp37-story__image-inner">
        {%- if section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.title | escape }}" class="hp37-story__image" loading="lazy">
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'hp37-story__image' }}
        {%- endif -%}
      </div>
    </div>
    {%- if section.settings.sticker_text != blank -%}
      <div class="hp37-story__sticker">
        {{ section.settings.sticker_text }}
      </div>
    {%- endif -%}
  </div>

  <div class="hp37-story__content-col">
    <h2 class="hp37-story__title">{{ section.settings.title }}</h2>
    
    <div class="hp37-story__text">
      {{ section.settings.text }}
    </div>

    {%- if section.settings.btn_label != blank -%}
      <a href="{{ section.settings.btn_link | default: '#' }}" class="hp37-story__btn">
        {{ section.settings.btn_label }}
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP37 - Retro Story",
  "class": "section-hp37-brand-story",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "sticker_text",
      "label": "Sticker Text",
      "default": "SINCE\n1974"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Heading",
      "default": "Born on the Beach."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>We started in a garage with nothing but a sewing machine and a dream of catching the perfect wave. Today, we're still chasing that feeling, crafting goods that are made to last, look good, and not take themselves too seriously.</p><p>Grab a board, soak up the sun, and join the ride.</p>"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "Our Story"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 30,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 80
    },
    {
      "type": "header",
      "content": "Retro Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#F4E3C5"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#4A3219"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color (Sticker/Shadow)",
      "default": "#D96C4A"
    },
    {
      "type": "color",
      "id": "box_bg",
      "label": "Image Box BG",
      "default": "#798A58"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 100
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP37 - Retro Story"
    }
  ]
}
{% endschema %}
