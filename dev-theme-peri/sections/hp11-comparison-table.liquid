{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#FFFFFF'
  assign text_color = section.settings.text_color | default: '#000000'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 100px 20px;
    border-bottom: 3px solid #000;
  }
  
  .hp11-comparison-container-{{ section_id }} {
    max-width: 1000px;
    margin: 0 auto;
  }
  
  .hp11-comparison-heading-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: clamp(3rem, 6vw, 4rem);
    font-weight: 900;
    text-transform: uppercase;
    text-align: center;
    margin: 0 0 60px 0;
    color: {{ text_color }};
    letter-spacing: -2px;
  }
  
  .hp11-comparison-table-wrap-{{ section_id }} {
    border: 4px solid #000;
    background: #000;
    box-shadow: 12px 12px 0 #FF00FF;
  }
  
  .hp11-comparison-table-{{ section_id }} {
    width: 100%;
    border-collapse: collapse;
    background: #FFF;
  }
  
  .hp11-comparison-table-{{ section_id }} th,
  .hp11-comparison-table-{{ section_id }} td {
    padding: 20px;
    border: 2px solid #000;
    text-align: center;
    font-family: 'Inter', sans-serif;
  }
  
  .hp11-comparison-table-{{ section_id }} th {
    font-size: 1.5rem;
    font-weight: 900;
    text-transform: uppercase;
  }
  
  .hp11-comparison-table-{{ section_id }} th:first-child {
    background: #0000FF;
    color: #FFF;
  }
  
  .hp11-comparison-table-{{ section_id }} th:last-child {
    background: #CCFF00;
    color: #000;
  }
  
  .hp11-comparison-table-{{ section_id }} td.hp11-us-{{ section_id }} {
    font-weight: 800;
    font-size: 1.1rem;
    background: #F4F4F4;
  }
  
  .hp11-comparison-table-{{ section_id }} td.hp11-icon-{{ section_id }} svg {
    width: 30px;
    height: 30px;
    stroke-width: 3;
  }
  
  .hp11-icon-check-{{ section_id }} {
    stroke: #FF00FF;
    fill: none;
  }
  
  .hp11-icon-cross-{{ section_id }} {
    stroke: #000;
    opacity: 0.3;
    fill: none;
  }

  @media (max-width: 768px) {
    .hp11-comparison-table-{{ section_id }} th,
    .hp11-comparison-table-{{ section_id }} td {
      padding: 15px 10px;
    }
    .hp11-comparison-table-{{ section_id }} th {
      font-size: 1.2rem;
    }
    .hp11-comparison-table-wrap-{{ section_id }} {
      box-shadow: 6px 6px 0 #FF00FF;
    }
  }
</style>

<div class="hp11-comparison-container-{{ section_id }}">
  <h2 class="hp11-comparison-heading-{{ section_id }}">{{ section.settings.heading | default: 'THE DIFFERENCE' }}</h2>
  
  <div class="hp11-comparison-table-wrap-{{ section_id }}">
    <table class="hp11-comparison-table-{{ section_id }}">
      <thead>
        <tr>
          <th>THEM</th>
          <th>US</th>
        </tr>
      </thead>
      <tbody>
        {% for block in section.blocks %}
          <tr>
            <td class="hp11-icon-{{ section_id }}">
              {% if block.settings.them_check %}
                <svg class="hp11-icon-check-{{ section_id }}" viewBox="0 0 24 24"><path d="M5 12l5 5L20 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
              {% else %}
                <svg class="hp11-icon-cross-{{ section_id }}" viewBox="0 0 24 24"><path d="M18 6L6 18M6 6l12 12" stroke-linecap="round" stroke-linejoin="round"/></svg>
              {% endif %}
              <div style="font-size: 0.8rem; font-weight: bold; margin-top: 5px;">{{ block.settings.feature }}</div>
            </td>
            <td class="hp11-us-{{ section_id }} hp11-icon-{{ section_id }}">
              <svg class="hp11-icon-check-{{ section_id }}" viewBox="0 0 24 24"><path d="M5 12l5 5L20 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <div style="font-size: 0.8rem; font-weight: bold; margin-top: 5px;">{{ block.settings.feature }}</div>
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>

{% schema %}
{
  "name": "HP11 Comparison Table",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "THE DIFFERENCE"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "feature",
          "label": "Feature Name",
          "default": "Heavyweight Cotton"
        },
        {
          "type": "checkbox",
          "id": "them_check",
          "label": "Competitor Has This?",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP11 Comparison Table",
      "blocks": [
        { "type": "feature", "settings": { "feature": "Heavyweight Cotton", "them_check": false } },
        { "type": "feature", "settings": { "feature": "True Oversized Fit", "them_check": false } },
        { "type": "feature", "settings": { "feature": "Next Day Shipping", "them_check": true } },
        { "type": "feature", "settings": { "feature": "Limited Drops", "them_check": false } }
      ]
    }
  ]
}
{% endschema %}
