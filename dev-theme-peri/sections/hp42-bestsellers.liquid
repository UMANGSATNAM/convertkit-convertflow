{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;1,700&family=Inter:wght@300;400&display=swap');

  #shopify-section-{{ section.id }} {
    --bg: {{ section.settings.bg_color }};
    --text: {{ section.settings.text_color }};
    --gold: {{ section.settings.accent_color }};
    --serif: 'Playfair Display', serif;
    --sans: 'Inter', sans-serif;
    background: var(--bg);
    padding: 100px 0;
    overflow: hidden;
  }

  .hp42-bs__header {
    max-width: 1400px;
    margin: 0 auto 60px;
    padding: 0 20px;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
  }

  @media (max-width: 768px) {
    .hp42-bs__header { flex-direction: column; align-items: flex-start; gap: 20px; }
  }

  .hp42-bs__title {
    font-family: var(--serif);
    font-size: clamp(36px, 6vw, {{ section.settings.title_size }}px);
    font-weight: 700;
    font-style: italic;
    color: var(--text);
    margin: 0;
  }

  .hp42-bs__track {
    display: flex;
    gap: 25px;
    padding: 0 40px 40px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .hp42-bs__track::-webkit-scrollbar { display: none; }

  .hp42-bs-card {
    flex: 0 0 340px;
    scroll-snap-align: start;
    text-decoration: none;
    display: flex;
    flex-direction: column;
  }

  @media (max-width: 768px) { .hp42-bs-card { flex: 0 0 280px; } }

  .hp42-bs-card__img {
    width: 100%;
    aspect-ratio: 3/4;
    overflow: hidden;
    background: #111;
  }

  .hp42-bs-card__img img, .hp42-bs-card__img svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.7);
    transition: transform 0.6s ease, filter 0.6s ease;
  }

  .hp42-bs-card:hover .hp42-bs-card__img img,
  .hp42-bs-card:hover .hp42-bs-card__img svg {
    transform: scale(1.05);
    filter: brightness(0.9);
  }

  .hp42-bs-card__info {
    padding: 20px 0;
    display: flex;
    justify-content: space-between;
    border-bottom: 1px solid rgba(201,169,110,0.15);
  }

  .hp42-bs-card__name {
    font-family: var(--sans);
    font-size: 15px;
    font-weight: 400;
    color: var(--text);
    margin: 0;
  }

  .hp42-bs-card__price {
    font-family: var(--sans);
    font-size: 15px;
    font-weight: 300;
    color: var(--gold);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div id="HP42BS-{{ section.id }}">
  <div class="hp42-bs__header">
    <h2 class="hp42-bs__title">{{ section.settings.title }}</h2>
  </div>

  <div class="hp42-bs__track">
    {%- assign collection = collections[section.settings.collection] -%}
    {%- if collection != blank and collection.products_count > 0 -%}
      {%- for product in collection.products limit: section.settings.limit -%}
        <a href="{{ product.url }}" class="hp42-bs-card">
          <div class="hp42-bs-card__img"><img height="{{ product.featured_image.height }}" width="{{ product.featured_image.width }}" src="{{ product.featured_image | image_url: width: 700 }}" alt="{{ product.title | escape }}" loading="lazy"></div>
          <div class="hp42-bs-card__info">
            <h3 class="hp42-bs-card__name">{{ product.title }}</h3>
            <span class="hp42-bs-card__price">{{ product.price | money }}</span>
          </div>
        </a>
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..section.settings.limit) -%}
        <a href="#" class="hp42-bs-card">
          <div class="hp42-bs-card__img">{{ 'product-' | append: i | placeholder_svg_tag }}</div>
          <div class="hp42-bs-card__info">
            <h3 class="hp42-bs-card__name">Curated Item {{ i }}</h3>
            <span class="hp42-bs-card__price">$350.00</span>
          </div>
        </a>
      {%- endfor -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP42 - Noir Bestsellers",
  "class": "section-hp42-bestsellers",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Most Coveted" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "min": 4, "max": 12, "step": 1, "label": "Limit", "default": 6 },
    { "type": "range", "id": "title_size", "min": 36, "max": 100, "step": 4, "unit": "px", "label": "Title Size", "default": 64 },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#0A0A0A" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#F5F0EB" },
    { "type": "color", "id": "accent_color", "label": "Gold", "default": "#C9A96E" },
    { "type": "html", "id": "custom_css", "label": "Custom CSS" }
  ],
  "presets": [{ "name": "HP42 - Noir Bestsellers" }]
}
{% endschema %}
