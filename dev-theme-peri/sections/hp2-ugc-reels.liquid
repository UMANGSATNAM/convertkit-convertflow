{%- liquid
  assign bg_color = section.settings.bg_color | default: '#111111'
  assign text_color = section.settings.text_color | default: '#ffffff'
  
  assign padding_top_desktop = section.settings.padding_top_desktop
  assign padding_bottom_desktop = section.settings.padding_bottom_desktop
  assign padding_top_mobile = section.settings.padding_top_mobile
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile
-%}

<style>
  #shopify-section-{{ section.id }} {
    --hp2-ugc-bg: {{ bg_color }};
    --hp2-ugc-text: {{ text_color }};
    
    --hp2-ugc-pt-desk: {{ padding_top_desktop }}px;
    --hp2-ugc-pb-desk: {{ padding_bottom_desktop }}px;
    --hp2-ugc-pt-mob: {{ padding_top_mobile }}px;
    --hp2-ugc-pb-mob: {{ padding_bottom_mobile }}px;
  }

  .hp2-fashion-ugc-{{ section.id }} {
    padding-top: var(--hp2-ugc-pt-desk);
    padding-bottom: var(--hp2-ugc-pb-desk);
    background-color: var(--hp2-ugc-bg);
    color: var(--hp2-ugc-text);
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
  }

  .hp2-ugc-inner {
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .hp2-ugc-header {
    text-align: center;
    margin-bottom: 50px;
  }

  .hp2-ugc-title {
    font-size: clamp(32px, 4vw, 56px);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -1px;
    margin: 0 0 10px 0;
  }
  
  .hp2-ugc-subtitle {
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 2px;
    opacity: 0.7;
    margin: 0;
  }

  .hp2-ugc-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .hp2-ugc-item {
    position: relative;
    aspect-ratio: 9/16;
    background: #000;
    border-radius: {{ section.settings.border_radius }}px;
    overflow: hidden;
    cursor: pointer;
    group;
  }

  .hp2-ugc-media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .hp2-ugc-item:hover .hp2-ugc-media {
    transform: scale(1.05);
  }

  /* Play button icon overlay for videos */
  .hp2-ugc-play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 50px;
    height: 50px;
    background: rgba(0,0,0,0.5);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    transition: background 0.3s ease;
  }
  .hp2-ugc-item:hover .hp2-ugc-play {
    background: rgba(0,0,0,0.8);
  }
  .hp2-ugc-play svg {
    width: 20px;
    height: 20px;
    fill: #fff;
    margin-left: 3px;
  }

  /* Product Tag Overlay */
  .hp2-ugc-product {
    position: absolute;
    bottom: 20px;
    left: 20px;
    right: 20px;
    background: rgba(255,255,255,0.9);
    color: #000;
    padding: 12px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    gap: 10px;
    transform: translateY(20px);
    opacity: 0;
    transition: all 0.3s ease;
    z-index: 3;
  }
  .hp2-ugc-item:hover .hp2-ugc-product {
    transform: translateY(0);
    opacity: 1;
  }
  
  .hp2-ugc-prod-img {
    width: 40px;
    height: 40px;
    object-fit: cover;
    border-radius: 4px;
  }
  
  .hp2-ugc-prod-info {
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .hp2-ugc-prod-title {
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .hp2-ugc-prod-price {
    font-size: 12px;
    font-weight: 500;
  }

  @media screen and (max-width: 1200px) {
    .hp2-ugc-grid { grid-template-columns: repeat(3, 1fr); }
  }

  @media screen and (max-width: 991px) {
    .hp2-ugc-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media screen and (max-width: 768px) {
    .hp2-fashion-ugc-{{ section.id }} {
      padding-top: var(--hp2-ugc-pt-mob);
      padding-bottom: var(--hp2-ugc-pb-mob);
    }
    .hp2-ugc-inner { padding: 0 20px; }
    
    /* Make it a scrollable row on mobile for TikTok feel */
    .hp2-ugc-grid {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      -ms-overflow-style: none;
      margin: 0 -20px;
      padding: 0 20px 20px;
    }
    .hp2-ugc-grid::-webkit-scrollbar { display: none; }
    
    .hp2-ugc-item {
      flex: 0 0 calc(80vw - 40px);
      scroll-snap-align: center;
    }
    
    /* Always show product tag on mobile since no hover */
    .hp2-ugc-product {
      transform: translateY(0);
      opacity: 1;
    }
  }
</style>

<section class="hp2-fashion-ugc-{{ section.id }}" aria-label="Community Reels">
  <div class="hp2-ugc-inner">
    
    <div class="hp2-ugc-header">
      {%- if section.settings.heading != blank -%}
        <h2 class="hp2-ugc-title">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subtitle != blank -%}
        <p class="hp2-ugc-subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>

    <div class="hp2-ugc-grid">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.video_link | default: '#' }}" class="hp2-ugc-item" {{ block.shopify_attributes }}>
          
          {%- if block.settings.image != blank -%}
            <img height="{{ block.settings.image.height }}" width="{{ block.settings.image.width }}" src="{{ block.settings.image | image_url: width: 600 }}" 
                 srcset="{{ block.settings.image | image_url: width: 400 }} 400w, 
                         {{ block.settings.image | image_url: width: 600 }} 600w"
                 sizes="(max-width: 768px) 80vw, 25vw"
                 class="hp2-ugc-media" 
                 loading="lazy" 
                 alt="UGC Video Cover">
          {%- else -%}
            {%- capture current -%}{% cycle 1, 2, 3, 4 %}{%- endcapture -%}
            {{ 'collection-' | append: current | placeholder_svg_tag: 'hp2-ugc-media placeholder-svg' }}
          {%- endif -%}

          <div class="hp2-ugc-play">
            <svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
          </div>

          {%- assign prod = all_products[block.settings.product] -%}
          {%- if prod != blank -%}
            <div class="hp2-ugc-product" onclick="window.location.href='{{ prod.url }}'; return false;">
              <img height="{{ prod.featured_image.height }}" width="{{ prod.featured_image.width }}" src="{{ prod.featured_image | image_url: width: 100 }}" class="hp2-ugc-prod-img" alt="{{ prod.title }}">
              <div class="hp2-ugc-prod-info">
                <span class="hp2-ugc-prod-title">{{ prod.title }}</span>
                <span class="hp2-ugc-prod-price">{{ prod.price | money }}</span>
              </div>
            </div>
          {%- endif -%}
          
        </a>
      {%- endfor -%}
      
      {%- if section.blocks.size == 0 -%}
        {%- for i in (1..4) -%}
          <div class="hp2-ugc-item">
            {{ 'collection-' | append: i | placeholder_svg_tag: 'hp2-ugc-media placeholder-svg' }}
            <div class="hp2-ugc-play"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "HP2 UGC Reels",
  "tag": "section",
  "class": "section-hp2-ugc",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "AS SEEN ON YOU"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "TAG @BRANDNAME TO BE FEATURED"
    },
    {
      "type": "header",
      "content": "Styling"
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0, "max": 40, "step": 2, "unit": "px",
      "label": "Video Corner Radius",
      "default": 16
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Top (Desktop)", "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Bottom (Desktop)", "default": 100
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Top (Mobile)", "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Bottom (Mobile)", "default": 60
    }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Reel / TikTok",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Video Cover Image"
        },
        {
          "type": "url",
          "id": "video_link",
          "label": "Link to Social Post"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Featured Product",
          "info": "Shows a small product card over the video on hover."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP2 UGC Reels (Advanced)",
      "category": "Social",
      "blocks": [
        { "type": "video" },
        { "type": "video" },
        { "type": "video" },
        { "type": "video" }
      ]
    }
  ]
}
{% endschema %}
