{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Oswald:wght@700&family=Space+Grotesk:wght@400;700&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --border-color: {{ section.settings.border_color }};
    --accent-color: {{ section.settings.accent_color }};
    
    --font-heading: 'Oswald', sans-serif;
    --font-body: 'Space Grotesk', sans-serif;
    
    background-color: var(--bg-color);
    border-bottom: 4px solid var(--border-color);
  }

  .hp30-bundle-wrapper {
    display: grid;
    grid-template-columns: 1fr 1fr;
    max-width: 1800px;
    margin: 0 auto;
    border-left: 4px solid var(--border-color);
    border-right: 4px solid var(--border-color);
  }

  @media screen and (max-width: 992px) {
    .hp30-bundle-wrapper {
      grid-template-columns: 1fr;
    }
  }

  .hp30-bundle__image-col {
    border-right: 4px solid var(--border-color);
    position: relative;
    background: #111;
  }

  @media screen and (max-width: 992px) {
    .hp30-bundle__image-col {
      border-right: none;
      border-bottom: 4px solid var(--border-color);
    }
  }

  .hp30-bundle__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    min-height: 500px;
    filter: contrast(130%) grayscale(100%);
    display: block;
  }

  .hp30-bundle__badge {
    position: absolute;
    top: 20px;
    left: 20px;
    background: var(--accent-color);
    color: #fff;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 700;
    padding: 10px 20px;
    text-transform: uppercase;
    letter-spacing: 2px;
    border: 4px solid var(--border-color);
  }

  .hp30-bundle__content-col {
    padding: 80px 60px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  @media screen and (max-width: 992px) {
    .hp30-bundle__content-col {
      padding: 60px 30px;
    }
  }

  .hp30-bundle__title {
    font-family: var(--font-heading);
    font-size: clamp(48px, 6vw, {{ section.settings.title_size }}px);
    line-height: 1;
    text-transform: uppercase;
    color: var(--text-color);
    margin: 0 0 20px;
    word-break: break-word;
    letter-spacing: -0.02em;
  }

  .hp30-bundle__price-wrap {
    display: flex;
    align-items: baseline;
    gap: 15px;
    margin-bottom: 30px;
  }

  .hp30-bundle__price {
    font-family: var(--font-heading);
    font-size: clamp(40px, 5vw, 60px);
    color: var(--accent-color);
  }

  .hp30-bundle__price-old {
    font-family: var(--font-heading);
    font-size: clamp(24px, 3vw, 36px);
    color: var(--text-color);
    text-decoration: line-through;
    opacity: 0.5;
  }

  .hp30-bundle__text {
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.5;
    color: var(--text-color);
    margin: 0 0 40px;
    max-width: 500px;
  }

  .hp30-bundle__list {
    list-style: none;
    padding: 0;
    margin: 0 0 40px;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--text-color);
  }

  .hp30-bundle__list li {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 15px;
  }

  .hp30-bundle__list li::before {
    content: '+';
    color: var(--accent-color);
    font-weight: 700;
    font-size: 20px;
  }

  .hp30-bundle__btn {
    display: inline-block;
    align-self: flex-start;
    padding: 20px 40px;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 16px;
    text-transform: uppercase;
    letter-spacing: 2px;
    text-decoration: none;
    background: var(--accent-color);
    color: #fff;
    border: 4px solid var(--border-color);
    transition: background-color 0s, color 0s;
  }

  .hp30-bundle__btn:hover {
    background: var(--text-color);
    color: var(--bg-color);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp30-bundle-wrapper" id="HP30Bundle-{{ section.id }}">
  <div class="hp30-bundle__image-col">
    {%- if section.settings.image != blank -%}
      <img height="{{ section.settings.image.height }}" width="{{ section.settings.image.width }}" src="{{ section.settings.image | image_url: width: 1000 }}" alt="{{ section.settings.title | escape }}" class="hp30-bundle__image" loading="lazy">
    {%- else -%}
      {{ 'product-3' | placeholder_svg_tag: 'hp30-bundle__image' }}
    {%- endif -%}
    <div class="hp30-bundle__badge">{{ section.settings.badge }}</div>
  </div>

  <div class="hp30-bundle__content-col">
    <h2 class="hp30-bundle__title">{{ section.settings.title }}</h2>
    
    <div class="hp30-bundle__price-wrap">
      <span class="hp30-bundle__price">{{ section.settings.price }}</span>
      {%- if section.settings.compare_price != blank -%}
        <span class="hp30-bundle__price-old">{{ section.settings.compare_price }}</span>
      {%- endif -%}
    </div>

    {%- if section.settings.text != blank -%}
      <div class="hp30-bundle__text">{{ section.settings.text }}</div>
    {%- endif -%}

    <ul class="hp30-bundle__list">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}>{{ block.settings.item }}</li>
      {%- endfor -%}
    </ul>

    {%- if section.settings.btn_label != blank -%}
      <a href="{{ section.settings.btn_link | default: '#' }}" class="hp30-bundle__btn">
        {{ section.settings.btn_label }}
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP30 - Brutalist Bundle",
  "class": "section-hp30-bundle-offer",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Bundle Image"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge Text",
      "default": "SYSTEM KIT"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Heading",
      "default": "ESSENTIALS PACK"
    },
    {
      "type": "text",
      "id": "price",
      "label": "Price",
      "default": "$150"
    },
    {
      "type": "text",
      "id": "compare_price",
      "label": "Compare at Price",
      "default": "$220"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Build your uniform. 3 staple pieces engineered for everyday utility.</p>"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "ADD TO LOADOUT"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 40,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "Heading Size",
      "default": 80
    },
    {
      "type": "header",
      "content": "Brutalist Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (White)",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text (Black)",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Borders",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent (Red)",
      "default": "#FF0000"
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Bundle Item",
      "settings": [
        {
          "type": "text",
          "id": "item",
          "label": "Item Name",
          "default": "1x Core T-Shirt"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP30 - Brutalist Bundle",
      "blocks": [
        { "type": "item", "settings": { "item": "1x HEAVYWEIGHT HOODIE" } },
        { "type": "item", "settings": { "item": "1x CORE T-SHIRT" } },
        { "type": "item", "settings": { "item": "1x TACTICAL CAP" } }
      ]
    }
  ]
}
{% endschema %}
