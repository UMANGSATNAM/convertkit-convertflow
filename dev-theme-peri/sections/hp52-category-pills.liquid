{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp52-pills-bg: {{ section.settings.bg_color | default: '#F7EFE6' }};
    
    background-color: var(--hp52-pills-bg);
    padding: {{ section.settings.padding_vertical | default: 35 }}px 0;
  }

  .hp52-pills__wrap {
    max-width: {{ section.settings.container_width | default: 1100 }}px;
    margin: 0 auto;
    padding: 0 20px;
    display: flex;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .hp52-pill {
    padding: 10px 24px;
    background: #FFFDF9;
    border: 1px solid rgba(194, 89, 63, 0.2);
    border-radius: 8px;
    color: #2D3B2D;
    font-family: 'Jost', sans-serif;
    font-weight: 600;
    font-size: 13px;
    text-decoration: none;
    transition: all 0.25s ease;
    box-shadow: 0 4px 12px rgba(45, 59, 45, 0.03);
  }

  .hp52-pill:hover, .hp52-pill--active {
    background: #C2593F;
    color: #FFFDF9;
    border-color: #C2593F;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(194, 89, 63, 0.2);
  }

  @media screen and (max-width: 576px) {
    .hp52-pills__wrap { justify-content: flex-start; overflow-x: auto; flex-wrap: nowrap; }
    .hp52-pill { flex-shrink: 0; }
  }
{%- endstyle -%}

<div class="hp52-pills__wrap">
  {%- if section.blocks.size > 0 -%}
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.url | default: '/collections/all' }}" class="hp52-pill {% if forloop.first %}hp52-pill--active{% endif %}" {{ block.shopify_attributes }}>
        {{ block.settings.title }}
      </a>
    {%- endfor -%}
  {%- else -%}
    <a href="/collections/all" class="hp52-pill hp52-pill--active">☀️ All Mediterranean Care</a>
    <a href="/collections/olive" class="hp52-pill">🫒 Tuscan Olive Squalane</a>
    <a href="/collections/clay" class="hp52-pill">🏺 Sicilian Terracotta Clay</a>
    <a href="/collections/bergamot" class="hp52-pill">🍊 Calabrian Citrus Balms</a>
    <a href="/collections/honey" class="hp52-pill">🍯 Amalfi Honey Crèmes</a>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "HP52 - Terra Pills",
  "class": "section-hp52-pills",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#F7EFE6" },
    { "type": "range", "id": "padding_vertical", "min": 10, "max": 70, "step": 5, "unit": "px", "label": "Vertical Padding", "default": 35 },
    { "type": "range", "id": "container_width", "min": 800, "max": 1400, "step": 20, "unit": "px", "label": "Container Width", "default": 1100 }
  ],
  "blocks": [
    {
      "type": "pill",
      "name": "Pill",
      "settings": [
        { "type": "text", "id": "title", "label": "Label", "default": "☀️ All Mediterranean Care" },
        { "type": "url", "id": "url", "label": "Link URL" }
      ]
    }
  ],
  "presets": [
    { "name": "HP52 - Terra Pills" }
  ]
}
{% endschema %}
