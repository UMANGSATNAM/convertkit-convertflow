{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#5C3D2E' }};
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }

  .hp53-news__container {
    max-width: {{ section.settings.container_width | default: 700 }}px;
    margin: 0 auto;
    padding: 0 24px;
    text-align: center;
  }

  .hp53-news__eyebrow {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: {{ section.settings.accent_color | default: '#E8D5C0' }};
    margin: 0 0 16px;
  }

  .hp53-news__heading {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(28px, 4vw, 44px);
    font-weight: 700;
    color: {{ section.settings.heading_color | default: '#FFFFFF' }};
    margin: 0 0 16px;
  }

  .hp53-news__desc {
    font-size: 15px;
    line-height: 1.7;
    color: {{ section.settings.accent_color | default: '#E8D5C0' }};
    margin: 0 0 32px;
  }

  .hp53-news__form {
    display: flex;
    gap: 12px;
    max-width: 480px;
    margin: 0 auto;
  }

  .hp53-news__input {
    flex: 1;
    padding: 14px 20px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid {{ section.settings.accent_color | default: '#E8D5C0' }};
    border-radius: 4px;
    color: #FFFFFF;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 14px;
  }

  .hp53-news__input::placeholder {
    color: rgba(232, 213, 192, 0.6);
  }

  .hp53-news__btn {
    padding: 14px 28px;
    background: {{ section.settings.btn_bg | default: '#C2703E' }};
    color: {{ section.settings.btn_text | default: '#FFFFFF' }};
    border: none;
    border-radius: 4px;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    cursor: pointer;
    transition: opacity 0.3s ease;
  }

  .hp53-news__btn:hover {
    opacity: 0.85;
  }

  @media screen and (max-width: 480px) {
    .hp53-news__form { flex-direction: column; }
  }
{%- endstyle -%}

<div class="hp53-news__container">
  {%- if section.settings.eyebrow != blank -%}
    <p class="hp53-news__eyebrow">{{ section.settings.eyebrow }}</p>
  {%- endif -%}
  <h2 class="hp53-news__heading">{{ section.settings.heading | default: 'Join the Desert Circle' }}</h2>
  <p class="hp53-news__desc">{{ section.settings.description | default: 'Be the first to discover new rituals, exclusive offers, and desert-inspired beauty secrets.' }}</p>

  {%- form 'customer', id: 'hp53-newsletter' -%}
    <input type="hidden" name="contact[tags]" value="newsletter">
    <div class="hp53-news__form">
      <input type="email" name="contact[email]" class="hp53-news__input" placeholder="{{ section.settings.placeholder | default: 'Your email address' }}" required>
      <button type="submit" class="hp53-news__btn">{{ section.settings.btn_label | default: 'Subscribe' }}</button>
    </div>
  {%- endform -%}
</div>

{% schema %}
{
  "name": "HP53 - Dune Newsletter",
  "class": "section-hp53-news",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#5C3D2E" },
    { "type": "color", "id": "heading_color", "label": "Heading Color", "default": "#FFFFFF" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#E8D5C0" },
    { "type": "color", "id": "btn_bg", "label": "Button BG", "default": "#C2703E" },
    { "type": "color", "id": "btn_text", "label": "Button Text", "default": "#FFFFFF" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "◈ STAY CONNECTED" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join the Desert Circle" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Be the first to discover new rituals and exclusive offers." },
    { "type": "text", "id": "placeholder", "label": "Placeholder", "default": "Your email address" },
    { "type": "text", "id": "btn_label", "label": "Button Label", "default": "Subscribe" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 500, "max": 900, "step": 20, "unit": "px", "label": "Container Width", "default": 700 }
  ],
  "presets": [{ "name": "HP53 - Dune Newsletter" }]
}
{% endschema %}
