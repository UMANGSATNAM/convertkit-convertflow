{%- style -%}
  #shopify-section-{{ section.id }} {
    background: radial-gradient(circle at 20% 50%, #4A153D 0%, #1F0B18 100%);
    color: #FFFFFF;
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
  }
  .hp55-offer__container { max-width: {{ section.settings.container_width | default: 1280 }}px; margin: 0 auto; padding: 0 24px; display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; }
  .hp55-offer__eyebrow { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: #C084FC; margin: 0 0 16px; }
  .hp55-offer__heading { font-family: 'Playfair Display', serif; font-size: clamp(28px, 4vw, 48px); color: #FFFFFF; margin: 0 0 18px; line-height: 1.1; }
  .hp55-offer__desc { font-size: 15px; line-height: 1.7; color: #E9D5FF; margin: 0 0 30px; opacity: 0.9; }
  .hp55-offer__btn {
    display: inline-flex; align-items: center; gap: 10px; padding: 16px 36px;
    background: #C084FC; color: #1F0B18; font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 13px; font-weight: 700; text-decoration: none; border-radius: 50px;
    box-shadow: 0 8px 30px rgba(192, 132, 252, 0.35); transition: all 0.3s ease;
  }
  .hp55-offer__btn:hover { box-shadow: 0 12px 40px rgba(192, 132, 252, 0.55); transform: translateY(-2px); }
  .hp55-offer__img-wrap { border-radius: 200px 200px 20px 20px; overflow: hidden; height: 400px; border: 1px solid rgba(233, 213, 255, 0.25); }
  .hp55-offer__img { width: 100%; height: 100%; object-fit: cover; }
  @media screen and (max-width: 992px) { .hp55-offer__container { grid-template-columns: 1fr; text-align: center; } .hp55-offer__img-wrap { height: 300px; } }
{%- endstyle -%}
<div class="hp55-offer__container">
  <div>
    <p class="hp55-offer__eyebrow">{{ section.settings.eyebrow | default: '✦ IMPERIAL OFFER' }}</p>
    <h2 class="hp55-offer__heading">{{ section.settings.heading | default: 'The Royal Sovereign Set' }}</h2>
    <p class="hp55-offer__desc">{{ section.settings.description | default: 'Includes our South Sea Pearl Serum, Black Orchid Cream, and Royal Bio-Lipid Elixir with complimentary velvet travel chest.' }}</p>
    <a href="{{ section.settings.btn_url | default: '/collections/all' }}" class="hp55-offer__btn">{{ section.settings.btn_label | default: 'Acquire Set' }} &rarr;</a>
  </div>
  <div class="hp55-offer__img-wrap">
    {%- if section.settings.image != blank -%}<img src="{{ section.settings.image | image_url: width: 800 }}" class="hp55-offer__img" alt="{{ section.settings.heading }}" loading="lazy">
    {%- else -%}{{ 'product-1' | placeholder_svg_tag: 'hp55-offer__img' }}{%- endif -%}
  </div>
</div>
{% schema %}
{
  "name": "HP55 Offer",
  "class": "section-hp55-offer",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "✦ IMPERIAL OFFER" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Royal Sovereign Set" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Includes our South Sea Pearl Serum." },
    { "type": "text", "id": "btn_label", "label": "Button Label", "default": "Acquire Set" },
    { "type": "url", "id": "btn_url", "label": "Button URL" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 80 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "presets": [{ "name": "HP55 Offer" }]
}
{% endschema %}
