{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;700&family=JetBrains+Mono:wght@400;700&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --grid-color: rgba(255, 255, 255, 0.1);
    
    --font-heading: 'Inter', sans-serif;
    --font-body: 'JetBrains Mono', monospace;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    border-bottom: 1px solid var(--grid-color);
  }

  .hp34-news-wrapper {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 40px;
    text-align: center;
  }

  @media screen and (max-width: 768px) {
    .hp34-news-wrapper {
      padding: 0 20px;
    }
  }

  .hp34-news__subtitle {
    font-family: var(--font-body);
    font-size: 11px;
    color: var(--accent-color);
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 20px;
  }

  .hp34-news__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    line-height: 1;
    color: var(--text-color);
    margin: 0 0 20px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }

  .hp34-news__text {
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--text-color);
    opacity: 0.7;
    margin-bottom: 40px;
  }

  .hp34-news__form {
    display: flex;
    max-width: 600px;
    margin: 0 auto;
    border: 1px solid var(--grid-color);
    background: #050505;
    position: relative;
  }

  .hp34-news__form::before {
    content: '>';
    position: absolute;
    left: 20px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--accent-color);
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 700;
  }

  .hp34-news__input {
    flex: 1;
    background: transparent;
    border: none;
    padding: 20px 20px 20px 45px;
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--text-color);
    outline: none;
  }

  .hp34-news__input::placeholder {
    color: rgba(255,255,255,0.3);
  }

  .hp34-news__btn {
    background: var(--text-color);
    color: var(--bg-color);
    border: none;
    padding: 0 30px;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .hp34-news__btn:hover {
    background: var(--accent-color);
    color: #fff;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp34-news-wrapper" id="HP34News-{{ section.id }}">
  {%- if section.settings.subtitle != blank -%}
    <div class="hp34-news__subtitle">{{ section.settings.subtitle }}</div>
  {%- endif -%}
  
  <h2 class="hp34-news__title">{{ section.settings.title }}</h2>
  
  {%- if section.settings.text != blank -%}
    <div class="hp34-news__text">{{ section.settings.text }}</div>
  {%- endif -%}

  {%- form 'customer', class: 'hp34-news__form' -%}
    <input type="hidden" name="contact[tags]" value="newsletter">
    <input type="email"
      name="contact[email]"
      class="hp34-news__input"
      value="{{ form.email }}"
      placeholder="{{ section.settings.placeholder }}"
      required>
    <button type="submit" class="hp34-news__btn">
      {{ section.settings.btn_label }}
    </button>
  {%- endform -%}
</div>

{% schema %}
{
  "name": "HP34 - Tech Newsletter",
  "class": "section-hp34-newsletter",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "SYSTEM.COMMUNICATIONS"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Establish Link"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Receive classified drops, system updates, and early access protocols."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input Placeholder",
      "default": "ENTER_EMAIL_ADDRESS"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "CONNECT"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 48
    },
    {
      "type": "header",
      "content": "Tech Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (e.g. Black)",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#FF4500"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 100
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP34 - Tech Newsletter"
    }
  ]
}
{% endschema %}
