{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp47-press-bg: {{ section.settings.bg_color | default: '#F5F0EB' }};
    
    background-color: var(--hp47-press-bg);
    padding: {{ section.settings.padding_vertical | default: 30 }}px 0;
    border-top: 1px solid #EAE3DA;
    border-bottom: 1px solid #EAE3DA;
  }

  .hp47-press__wrap {
    max-width: {{ section.settings.container_width | default: 1100 }}px;
    margin: 0 auto;
    padding: 0 20px;
    display: flex;
    justify-content: space-around;
    align-items: center;
    flex-wrap: wrap;
    gap: 30px;
    font-family: 'Cormorant Garamond', serif;
    font-size: 22px;
    font-weight: 700;
    letter-spacing: 1px;
    color: #382E2B;
    opacity: 0.85;
  }
{%- endstyle -%}

<div class="hp47-press__wrap">
  {%- if section.blocks.size > 0 -%}
    {%- for block in section.blocks -%}
      <span {{ block.shopify_attributes }}>{{ block.settings.title }}</span>
    {%- endfor -%}
  {%- else -%}
    <span>KINFORK NORDIC</span>
    <span>VOGUE SCANDINAVIA</span>
    <span>CEREAL ATELIER</span>
    <span>ELLE DENMARK</span>
    <span>WALLPAPER* LIVING</span>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "HP47 - Taupe Press",
  "class": "section-hp47-press",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#F5F0EB" },
    { "type": "range", "id": "padding_vertical", "min": 15, "max": 60, "step": 5, "unit": "px", "label": "Vertical Padding", "default": 30 },
    { "type": "range", "id": "container_width", "min": 800, "max": 1400, "step": 20, "unit": "px", "label": "Container Width", "default": 1100 }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Press Item",
      "settings": [
        { "type": "text", "id": "title", "label": "Publication Name", "default": "KINFORK NORDIC" }
      ]
    }
  ],
  "presets": [
    { "name": "HP47 - Taupe Press" }
  ]
}
{% endschema %}
