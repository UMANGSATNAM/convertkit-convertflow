{%- liquid
  assign section_id = section.id
  assign product = section.settings.product
  assign bg_color = section.settings.bg_color | default: '#050505'
  assign text_color = section.settings.text_color | default: '#F4F4F0'
  assign padding_top = section.settings.padding_top | default: 120
  assign padding_bottom = section.settings.padding_bottom | default: 120
-%}

<style>
  #shopify-section-{{ section_id }} {
    --bg-color: {{ bg_color }};
    --text-color: {{ text_color }};
    --padding-top: {{ padding_top }}px;
    --padding-bottom: {{ padding_bottom }}px;
    
    background-color: var(--bg-color);
    color: var(--text-color);
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .hp7-spotlight-{{ section_id }} {
    max-width: 1800px;
    margin: 0 auto;
    padding: 0 4vw;
    display: flex;
    align-items: flex-start;
    gap: 6vw;
  }

  .hp7-spotlight__media-col {
    width: 55%;
    position: sticky;
    top: 4vw;
  }

  .hp7-spotlight__image-wrap {
    width: 100%;
    aspect-ratio: 3/4;
    position: relative;
    overflow: hidden;
    background: #111;
  }

  .hp7-spotlight__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hp7-spotlight__content-col {
    width: 45%;
    padding: 10vh 0;
  }

  .hp7-spotlight__label {
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 2rem;
    display: block;
    border-bottom: 1px solid var(--text-color);
    padding-bottom: 1rem;
    display: inline-block;
  }

  .hp7-spotlight__title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(3rem, 5vw, 5rem);
    font-weight: 400;
    line-height: 0.9;
    margin: 0 0 2rem 0;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }
  
  .hp7-spotlight__title a {
    color: inherit;
    text-decoration: none;
  }

  .hp7-spotlight__price {
    font-family: 'Inter', sans-serif;
    font-size: 24px;
    font-weight: 400;
    margin-bottom: 3rem;
  }

  .hp7-spotlight__description {
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    line-height: 1.6;
    opacity: 0.8;
    margin-bottom: 3rem;
  }

  .hp7-spotlight__features {
    list-style: none;
    padding: 0;
    margin: 0 0 4rem 0;
  }

  .hp7-spotlight__feature {
    padding: 1.5rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    display: flex;
    justify-content: space-between;
  }

  .hp7-spotlight__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 24px 48px;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 600;
    text-decoration: none;
    background-color: var(--text-color);
    color: var(--bg-color);
    border: none;
    cursor: pointer;
    transition: background-color 0.3s;
  }

  .hp7-spotlight__btn:hover {
    opacity: 0.9;
  }

  @media screen and (max-width: 990px) {
    #shopify-section-{{ section_id }} {
      --padding-top: {{ padding_top | times: 0.6 }}px;
      --padding-bottom: {{ padding_bottom | times: 0.6 }}px;
    }
    
    .hp7-spotlight-{{ section_id }} {
      flex-direction: column;
      gap: 2rem;
    }
    
    .hp7-spotlight__media-col {
      width: 100%;
      position: relative;
      top: 0;
    }
    
    .hp7-spotlight__content-col {
      width: 100%;
      padding: 2rem 0 0 0;
    }
  }
</style>

<section class="hp7-spotlight-{{ section_id }}">
  
  <div class="hp7-spotlight__media-col">
    <div class="hp7-spotlight__image-wrap">
      {%- if product != blank and product.featured_image != blank -%}
        {{ product.featured_image | image_url: width: 1200 | image_tag: 
           loading: 'lazy',
           class: 'hp7-spotlight__image',
           alt: product.title | escape
        }}
      {%- elsif section.settings.image != blank -%}
         {{ section.settings.image | image_url: width: 1200 | image_tag: 
           loading: 'lazy',
           class: 'hp7-spotlight__image',
           alt: section.settings.image.alt | escape
        }}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'hp7-spotlight__image placeholder-svg' }}
      {%- endif -%}
    </div>
  </div>

  <div class="hp7-spotlight__content-col">
    <span class="hp7-spotlight__label">OBJECT OF DESIRE</span>
    
    <h2 class="hp7-spotlight__title">
      {%- if product != blank -%}
        <a href="{{ product.url }}">{{ product.title }}</a>
      {%- else -%}
        THE SCULPTURAL<br>TRENCH COAT
      {%- endif -%}
    </h2>
    
    <div class="hp7-spotlight__price">
      {%- if product != blank -%}
        {{ product.price | money }}
      {%- else -%}
        $2,450.00
      {%- endif -%}
    </div>
    
    <div class="hp7-spotlight__description">
      {%- if product != blank and product.description != blank -%}
        {{ product.description | strip_html | truncatewords: 40 }}
      {%- else -%}
        Constructed from bonded heavy-weight cotton gabardine. Features exaggerated drop shoulders, severe lapel proportions, and absolute minimal hardware for a monolithic silhouette.
      {%- endif -%}
    </div>
    
    {%- if section.blocks.size > 0 -%}
      <ul class="hp7-spotlight__features">
        {%- for block in section.blocks -%}
          <li class="hp7-spotlight__feature" {{ block.shopify_attributes }}>
            <span>{{ block.settings.label | escape }}</span>
            <span style="opacity:0.5">{{ block.settings.value | escape }}</span>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
    
    {%- if product != blank -%}
      <form method="post" action="/cart/add" class="hp7-spotlight__form">
        <input type="hidden" name="id" value="{{ product.variants.first.id }}">
        <button type="submit" class="hp7-spotlight__btn">
          Acquire Object
        </button>
      </form>
    {%- else -%}
      <button class="hp7-spotlight__btn">
        Acquire Object
      </button>
    {%- endif -%}
  </div>

</section>

{% schema %}
{
  "name": "HP7 Product Spotlight",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Aesthetic: Editorial Brutalism"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Featured Product"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Custom Image",
      "info": "Overrides product image if set."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#050505"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#F4F4F0"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Padding Top",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 120
    }
  ],
  "blocks": [
    {
      "type": "spec",
      "name": "Specification",
      "limit": 5,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Spec Label",
          "default": "MATERIAL"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Spec Value",
          "default": "100% GABARDINE"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP7 Product Spotlight",
      "blocks": [
        { "type": "spec", "settings": { "label": "COMPOSITION", "value": "100% BONDED COTTON" } },
        { "type": "spec", "settings": { "label": "ORIGIN", "value": "CRAFTED IN ITALY" } },
        { "type": "spec", "settings": { "label": "CARE", "value": "DRY CLEAN ONLY" } }
      ]
    }
  ]
}
{% endschema %}
