{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@300;400;500&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --pill-bg: {{ section.settings.pill_bg }};
    --pill-text: {{ section.settings.pill_text }};
    --pill-hover-bg: {{ section.settings.pill_hover_bg }};
    --pill-hover-text: {{ section.settings.pill_hover_text }};
    
    --font-heading: 'Lora', serif;
    --font-body: 'Inter', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    position: relative;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.8 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.8 | round }}px;
    }
  }

  .hp29-pills-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  @media screen and (max-width: 768px) {
    .hp29-pills-wrapper {
      padding: 0 20px;
    }
  }

  .hp29-pills__scroll {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    gap: 15px;
    padding: 10px 0 20px;
    width: 100%;
    justify-content: center;
  }

  @media screen and (max-width: 768px) {
    .hp29-pills__scroll {
      justify-content: flex-start;
    }
  }

  .hp29-pills__scroll::-webkit-scrollbar {
    display: none;
  }

  .hp29-pills__item {
    scroll-snap-align: start;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 32px;
    background-color: var(--pill-bg);
    color: var(--pill-text);
    border-radius: 50px;
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 400;
    text-decoration: none;
    letter-spacing: 0.02em;
    border: 1px solid rgba(0,0,0,0.05);
    transition: all 0.4s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .hp29-pills__item:hover {
    background-color: var(--pill-hover-bg);
    color: var(--pill-hover-text);
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgba(0,0,0,0.05);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp29-pills-wrapper" id="HP29Pills-{{ section.id }}">
  <div class="hp29-pills__scroll">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.link_url | default: '#' }}" class="hp29-pills__item" {{ block.shopify_attributes }}>
        {{ block.settings.title }}
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "HP29 Boho Cat Pills",
  "class": "section-hp29-category-pills",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1200
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#F4F1DE"
    },
    {
      "type": "color",
      "id": "pill_bg",
      "label": "Pill Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "pill_text",
      "label": "Pill Text",
      "default": "#3D405B"
    },
    {
      "type": "color",
      "id": "pill_hover_bg",
      "label": "Pill Hover Background (Sage/Terracotta)",
      "default": "#81B29A"
    },
    {
      "type": "color",
      "id": "pill_hover_text",
      "label": "Pill Hover Text",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 40
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "pill",
      "name": "Pill",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Category Name",
          "default": "Category"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP29 Boho Cat Pills",
      "blocks": [
        { "type": "pill", "settings": { "title": "New Arrivals" } },
        { "type": "pill", "settings": { "title": "Dresses" } },
        { "type": "pill", "settings": { "title": "Knitwear" } },
        { "type": "pill", "settings": { "title": "Accessories" } },
        { "type": "pill", "settings": { "title": "Gifts" } }
      ]
    }
  ]
}
{% endschema %}
