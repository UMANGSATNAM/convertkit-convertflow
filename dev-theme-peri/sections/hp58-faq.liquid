{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#0B0F19' }};
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }
  .hp58-faq__container { max-width: {{ section.settings.container_width | default: 800 }}px; margin: 0 auto; padding: 0 24px; }
  .hp58-faq__header { text-align: center; margin-bottom: 50px; }
  .hp58-faq__eyebrow { font-family: 'Space Grotesk', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: {{ section.settings.accent_color | default: '#06B6D4' }}; margin: 0 0 12px; }
  .hp58-faq__heading { font-family: 'Syne', sans-serif; font-size: clamp(28px, 3.5vw, 42px); font-weight: 800; color: #FFFFFF; margin: 0; }
  .hp58-faq__item {
    background: {{ section.settings.card_bg | default: '#111827' }};
    border: 1px solid rgba(6, 182, 212, 0.2);
    border-radius: 8px; margin-bottom: 14px; overflow: hidden;
    transition: border-color 0.3s ease;
  }
  .hp58-faq__item.active { border-color: #06B6D4; box-shadow: 0 0 15px rgba(6, 182, 212, 0.25); }
  .hp58-faq__question {
    width: 100%; background: none; border: none; padding: 20px 24px;
    display: flex; justify-content: space-between; align-items: center; cursor: pointer;
    font-family: 'Syne', sans-serif; font-size: 16px; font-weight: 700; color: #FFFFFF; text-align: left;
  }
  .hp58-faq__icon { font-size: 20px; color: {{ section.settings.accent_color | default: '#06B6D4' }}; transition: transform 0.3s ease; flex-shrink: 0; margin-left: 16px; }
  .hp58-faq__item.active .hp58-faq__icon { transform: rotate(45deg); }
  .hp58-faq__answer { max-height: 0; overflow: hidden; transition: max-height 0.35s ease; }
  .hp58-faq__item.active .hp58-faq__answer { max-height: 300px; }
  .hp58-faq__answer-inner { padding: 0 24px 20px; font-size: 14px; line-height: 1.7; color: #94A3B8; font-family: 'Space Grotesk', sans-serif; }
{%- endstyle -%}
<div class="hp58-faq__container">
  <div class="hp58-faq__header">
    {%- if section.settings.eyebrow != blank -%}<p class="hp58-faq__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="hp58-faq__heading">{{ section.settings.heading | default: 'System Inquiries' }}</h2>
  </div>
  {%- for block in section.blocks -%}
    <div class="hp58-faq__item" {{ block.shopify_attributes }}>
      <button class="hp58-faq__question" onclick="this.parentElement.classList.toggle('active')">
        <span>{{ block.settings.question | default: 'What are quantum synthesized peptides?' }}</span>
        <span class="hp58-faq__icon">+</span>
      </button>
      <div class="hp58-faq__answer">
        <div class="hp58-faq__answer-inner">{{ block.settings.answer | default: 'Quantum synthesized peptides are precise nano-sequences developed via computer modeling to stimulate exact fibroblasts with 99.8% biological accuracy.' }}</div>
      </div>
    </div>
  {%- endfor -%}
</div>
{% schema %}
{
  "name": "HP58 FAQ",
  "class": "section-hp58-faq",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#0B0F19" },
    { "type": "color", "id": "card_bg", "label": "Card Background", "default": "#111827" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#06B6D4" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "⚡ FAQ" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "System Inquiries" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 600, "max": 1000, "step": 20, "unit": "px", "label": "Container Width", "default": 800 }
  ],
  "blocks": [{
    "type": "faq", "name": "Question",
    "settings": [
      { "type": "text", "id": "question", "label": "Question", "default": "What are quantum synthesized peptides?" },
      { "type": "textarea", "id": "answer", "label": "Answer", "default": "Quantum synthesized peptides are precise nano-sequences developed via computer modeling." }
    ]
  }],
  "presets": [{
    "name": "HP58 FAQ",
    "blocks": [
      { "type": "faq" },
      { "type": "faq", "settings": { "question": "Does this formula protect against computer monitor blue light?", "answer": "Yes, our fermented algae photoshield absorbs up to 98% of high-energy visible (HEV) screen blue light." } },
      { "type": "faq", "settings": { "question": "Can this be used morning and evening?", "answer": "Apply Quantum Serum in the AM for photoshield protection, and Cyber Elixir at night for cellular reset." } }
    ]
  }]
}
{% endschema %}
