{% comment %} CL V50 — Tech Hardware / PC Parts {% endcomment %}
{{ 'component-facets.css' | asset_url | stylesheet_tag }}
<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
<style>
  .clv50 { background: {{ section.settings.bg_color | default: '#0F1115' }}; color: {{ section.settings.text_color | default: '#E2E8F0' }}; padding: 40px 20px; font-family: 'Roboto', 'Segoe UI', sans-serif; }
  .clv50-hero { display: flex; flex-direction: column; justify-content: center; margin-bottom: 30px; padding: 40px; background: linear-gradient(135deg, #1A1D24 0%, #0F1115 100%); border-radius: 8px; border-left: 4px solid #3B82F6; box-shadow: 0 4px 20px rgba(0,0,0,0.5); }
  .clv50-hero h1 { font-size: 36px; font-weight: 700; color: #FFF; margin-bottom: 10px; }
  .clv50-hero p { font-size: 15px; color: #94A3B8; max-width: 600px; margin: 0; line-height: 1.5; }
  .clv50-chips { display: flex; gap: 10px; justify-content: flex-start; margin-bottom: 30px; flex-wrap: wrap; }
  .clv50-chips a { padding: 8px 16px; background: #1E222B; color: #94A3B8; text-decoration: none; font-size: 13px; font-weight: 500; border-radius: 4px; border: 1px solid #334155; transition: 0.2s; }
  .clv50-chips a:hover, .clv50-chips a.active { background: #2563EB; color: #FFF; border-color: #3B82F6; }
  .clv50-toolbar { background: #1A1D24; border-radius: 8px; padding: 15px 20px; margin-bottom: 30px; display: flex; justify-content: space-between; align-items: center; border: 1px solid #334155; }
  .clv50-grid { display: grid; grid-template-columns: repeat({{ section.settings.cols_desktop | default: 5 }}, 1fr); gap: 15px; }
  .clv50-promo { grid-column: span 1; background: #1E293B; border: 1px solid #3B82F6; border-radius: 8px; padding: 30px; text-align: center; display: flex; flex-direction: column; justify-content: center; position: relative; overflow: hidden; }
  .clv50-promo::before { content: ''; position: absolute; top: -50%; left: -50%; width: 200%; height: 200%; background: radial-gradient(circle, rgba(59,130,246,0.1) 0%, transparent 70%); }
  .clv50-promo h3 { font-size: 20px; font-weight: 700; color: #FFF; margin-bottom: 15px; position: relative; z-index: 1; }
  .clv50-promo a { display: inline-block; padding: 10px 20px; background: #2563EB; color: #FFF; text-decoration: none; font-size: 13px; font-weight: 600; border-radius: 4px; position: relative; z-index: 1; transition: 0.2s; }
  .clv50-promo a:hover { background: #3B82F6; }
  .clv50-seo { margin-top: 40px; background: #1A1D24; padding: 30px; border-radius: 8px; border: 1px solid #334155; }
  @media (max-width: 768px) { .clv50-grid { grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr); gap: 10px; } .clv50-hero h1 { font-size: 28px; } }
</style>
<div class="clv50" style="max-width: 1500px; margin: 0 auto;">
  <div class="clv50-hero">
    <h1>{% if collection.title != blank %}{{ collection.title | escape }}{% else %}Components{% endif %}</h1>
    <p>{% if collection.description != blank %}{{ collection.description }}{% else %}High-performance parts for enthusiasts and professionals.{% endif %}</p>
  </div>
  {% if section.settings.sub_collections != blank %}
    <div class="clv50-chips">
      {% for link in section.settings.sub_collections.links %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% endfor %}
    </div>
  {% endif %}
  <div class="clv50-toolbar">
    <facet-filters-form style="width: 100%;">
      <form id="FacetFiltersForm" style="display: flex; justify-content: space-between; align-items: center; width: 100%; flex-wrap: wrap; gap: 15px;">
        <div style="display: flex; gap: 15px;">
          {%- for filter in collection.filters -%}
            <details style="position: relative;">
              <summary style="cursor: pointer; font-size: 13px; font-weight: 600; color: #E2E8F0; padding: 6px 12px; background: #1E222B; border-radius: 4px; border: 1px solid #334155;">{{ filter.label }} ⌄</summary>
              <div style="position: absolute; background: #1E222B; border: 1px solid #334155; padding: 15px; border-radius: 4px; z-index: 10; margin-top: 10px; min-width: 220px; box-shadow: 0 10px 25px rgba(0,0,0,0.5);">
                {%- for value in filter.values -%}
                  <label style="display: block; margin-bottom: 10px; cursor: pointer; font-size: 13px; color: #CBD5E1;">
                    <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %}>
                    {{ value.label }} ({{ value.count }})
                  </label>
                {%- endfor -%}
              </div>
            </details>
          {%- endfor -%}
        </div>
        <select name="sort_by" onchange="this.form.submit()" style="background: #1E222B; border: 1px solid #334155; color: #E2E8F0; padding: 8px 12px; border-radius: 4px; font-size: 13px; font-weight: 500; cursor: pointer; outline: none;">
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>Sort: {{ option.name }}</option>
          {%- endfor -%}
        </select>
      </form>
    </facet-filters-form>
  </div>
  {% assign limit_num = section.settings.products_per_page | default: 20 %}
  {% paginate collection.products by limit_num %}
    <div class="clv50-grid">
      {% for product in collection.products %}
        {% render 'card-v50', product: product %}
        {% if forloop.index == 10 and section.settings.show_promo_tile %}
          <div class="clv50-promo">
            <h3>Pre-Built<br>Systems</h3>
            <a href="/collections/prebuilt">Configure</a>
          </div>
        {% endif %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v50', product: nil %}
        {% endfor %}
      {% endfor %}
    </div>
    <div style="margin-top: 40px; text-align: center; font-size: 14px; font-weight: 500; color: #94A3B8;">{{ paginate | default_pagination }}</div>
  {% endpaginate %}
  {% if section.settings.show_seo_block %}
    <div class="clv50-seo">
      <h2 style="font-size: 18px; color: #F8FAFC; margin-bottom: 10px;">{{ section.settings.seo_title | default: 'Build Your Dream Rig' }}</h2>
      <p style="font-size: 13px; color: #94A3B8; max-width: 900px; line-height: 1.6;">{{ section.settings.seo_text | default: 'We stock the latest GPUs, processors, and motherboards. Whether you are building a workstation or a gaming powerhouse, find the components you need.' }}</p>
    </div>
  {% endif %}
</div>
{% schema %}
{
  "name": "CL V50 — PC Hardware", "settings": [
    {"type": "range", "id": "products_per_page", "label": "Products per page", "min": 10, "max": 50, "step": 5, "default": 20},
    {"type": "range", "id": "cols_desktop", "label": "Desktop Columns", "min": 3, "max": 6, "default": 5},
    {"type": "select", "id": "cols_mobile", "label": "Mobile Columns", "options": [{"value": "1", "label": "1"}, {"value": "2", "label": "2"}], "default": "2"},
    {"type": "link_list", "id": "sub_collections", "label": "Sub-Collection Menu"},
    {"type": "checkbox", "id": "show_promo_tile", "label": "Show Promo Card", "default": true},
    {"type": "checkbox", "id": "show_seo_block", "label": "Show SEO Block", "default": true},
    {"type": "color", "id": "bg_color", "label": "Background Color", "default": "#0F1115"},
    {"type": "color", "id": "text_color", "label": "Text Color", "default": "#E2E8F0"}
  ], "presets": [{"name": "CL V50 — PC Hardware"}]
}
{% endschema %}
