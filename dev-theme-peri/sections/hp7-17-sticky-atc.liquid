{%- liquid
  assign section_id = section.id
  assign product = section.settings.product
  assign bg_color = section.settings.bg_color | default: '#F4F4F0'
  assign text_color = section.settings.text_color | default: '#050505'
-%}

<style>
  #shopify-section-{{ section_id }} {
    --bg-color: {{ bg_color }};
    --text-color: {{ text_color }};
    
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    z-index: 999;
    background-color: var(--bg-color);
    color: var(--text-color);
    border-top: 2px solid var(--text-color);
    transform: translateY(100%);
    transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  /* Simple logic to show sticky bar when scrolling down - usually done via JS, 
     but for a CSS only fallback we just show it if not at very top */
  @media (min-height: 400px) {
    #shopify-section-{{ section_id }} {
      animation: hp7-slide-up 0.5s ease forwards;
      animation-delay: 2s; /* Show after initial load */
    }
  }

  @keyframes hp7-slide-up {
    to { transform: translateY(0); }
  }

  .hp7-sticky-{{ section_id }} {
    max-width: 100%;
    padding: 0 4vw;
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 80px;
  }

  .hp7-sticky__info {
    display: flex;
    align-items: center;
    gap: 2rem;
  }
  
  .hp7-sticky__image {
    height: 80px;
    width: 80px;
    object-fit: cover;
    border-right: 2px solid var(--text-color);
    border-left: 2px solid var(--text-color);
  }

  .hp7-sticky__text {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .hp7-sticky__title {
    font-family: 'Playfair Display', serif;
    font-size: 18px;
    font-weight: 600;
    margin: 0;
    text-transform: uppercase;
  }

  .hp7-sticky__price {
    font-family: 'Inter', monospace;
    font-size: 13px;
    font-weight: 400;
  }

  .hp7-sticky__form {
    display: flex;
    align-items: center;
    height: 100%;
  }

  .hp7-sticky__btn {
    height: 100%;
    padding: 0 4vw;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 600;
    background-color: var(--text-color);
    color: var(--bg-color);
    border: none;
    cursor: pointer;
    transition: opacity 0.3s;
    border-left: 2px solid var(--text-color);
  }

  .hp7-sticky__btn:hover {
    opacity: 0.8;
  }

  @media screen and (max-width: 768px) {
    .hp7-sticky-{{ section_id }} {
      height: 60px;
      padding: 0;
    }
    
    .hp7-sticky__image {
      height: 60px;
      width: 60px;
      border-left: none;
    }
    
    .hp7-sticky__text {
      padding-left: 1rem;
    }
    
    .hp7-sticky__title {
      font-size: 14px;
    }
    
    .hp7-sticky__price {
      font-size: 12px;
    }
    
    .hp7-sticky__btn {
      padding: 0 2rem;
      font-size: 12px;
    }
  }
</style>

<section class="hp7-sticky-{{ section_id }}">
  
  <div class="hp7-sticky__info">
    {%- if product != blank and product.featured_image != blank -%}
      {{ product.featured_image | image_url: width: 160 | image_tag: class: 'hp7-sticky__image', loading: 'lazy' }}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'hp7-sticky__image placeholder-svg' }}
    {%- endif -%}
    
    <div class="hp7-sticky__text">
      <h3 class="hp7-sticky__title">
        {%- if product != blank -%}
          {{ product.title }}
        {%- else -%}
          ARCHIVE BLAZER
        {%- endif -%}
      </h3>
      <span class="hp7-sticky__price">
        {%- if product != blank -%}
          {{ product.price | money }}
        {%- else -%}
          $1,850.00
        {%- endif -%}
      </span>
    </div>
  </div>
  
  {%- if product != blank -%}
    <form method="post" action="/cart/add" class="hp7-sticky__form">
      <input type="hidden" name="id" value="{{ product.variants.first.id }}">
      <button type="submit" class="hp7-sticky__btn">
        {{ section.settings.btn_label | escape }}
      </button>
    </form>
  {%- else -%}
    <div class="hp7-sticky__form">
      <button class="hp7-sticky__btn">
        {{ section.settings.btn_label | escape }}
      </button>
    </div>
  {%- endif -%}

</section>

{% schema %}
{
  "name": "HP7 Sticky Add To Cart",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Aesthetic: Editorial Brutalism",
      "info": "A fixed bottom bar that appears after page load. Inverted colors for contrast."
    },
    {
      "type": "product",
      "id": "product",
      "label": "Featured Product"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "ACQUIRE"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F4F4F0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#050505"
    }
  ],
  "presets": [
    {
      "name": "HP7 Sticky Add To Cart"
    }
  ]
}
{% endschema %}
