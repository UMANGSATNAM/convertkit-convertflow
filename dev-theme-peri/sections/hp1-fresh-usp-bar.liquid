{%- liquid
  assign bg_color = section.settings.bg_color | default: '#1C1917'
  assign text_color = section.settings.text_color | default: '#FAF6F0'
-%}

<section class="hp1-fresh-usp" style="--bg: {{ bg_color }}; --text: {{ text_color }};">
  <div class="hp1-fresh-usp__container">
    <div class="hp1-fresh-usp__grid">
      
      <div class="hp1-fresh-usp__item">
        <div class="hp1-fresh-usp__icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
        </div>
        <div class="hp1-fresh-usp__text">
          <strong>Free Express Shipping</strong>
          <span>On all US orders over $45</span>
        </div>
      </div>

      <div class="hp1-fresh-usp__item">
        <div class="hp1-fresh-usp__icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
        </div>
        <div class="hp1-fresh-usp__text">
          <strong>100% Dermatologist Tested</strong>
          <span>Hypoallergenic & Non-Comedogenic</span>
        </div>
      </div>

      <div class="hp1-fresh-usp__item">
        <div class="hp1-fresh-usp__icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
        </div>
        <div class="hp1-fresh-usp__text">
          <strong>30-Day Glow Guarantee</strong>
          <span>Love it or get 100% full refund</span>
        </div>
      </div>

      <div class="hp1-fresh-usp__item">
        <div class="hp1-fresh-usp__icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
        </div>
        <div class="hp1-fresh-usp__text">
          <strong>Carbon Neutral Delivery</strong>
          <span>Sustainably packaged & eco-certified</span>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .hp1-fresh-usp {
    background-color: var(--bg);
    color: var(--text);
    padding: 24px 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }
  .hp1-fresh-usp__container {
    max-width: 1280px;
    margin: 0 auto;
  }
  .hp1-fresh-usp__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
  }
  @media (max-width: 991px) {
    .hp1-fresh-usp__grid { grid-template-columns: repeat(2, 1fr); gap: 24px; }
  }
  @media (max-width: 576px) {
    .hp1-fresh-usp__grid { grid-template-columns: 1fr; gap: 20px; }
  }

  .hp1-fresh-usp__item {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .hp1-fresh-usp__icon {
    width: 44px;
    height: 44px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #F59E0B;
    flex-shrink: 0;
  }
  .hp1-fresh-usp__text strong {
    display: block;
    font-size: 14px;
    font-weight: 600;
    color: #FFFFFF;
    margin-bottom: 2px;
  }
  .hp1-fresh-usp__text span {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.7);
  }
</style>

{% schema %}
{
  "name": "HP1 Fresh - USP Bar",
  "tag": "section",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#1C1917" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#FAF6F0" }
  ],
  "presets": [
    { "name": "HP1 Fresh - USP Bar" }
  ]
}
{% endschema %}
