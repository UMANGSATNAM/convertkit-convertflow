{% comment %} CL V35 — Surf / Skate (Sun-faded) {% endcomment %}
{{ 'component-facets.css' | asset_url | stylesheet_tag }}
<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
<style>
  .clv35 { background: {{ section.settings.bg_color | default: '#FCEFC7' }}; color: {{ section.settings.text_color | default: '#0E7490' }}; padding: 40px 20px; font-family: 'Permanent Marker', cursive; }
  .clv35-hero { text-align: center; margin-bottom: 40px; position: relative; padding: 60px 20px; border: 4px solid #0E7490; background: url('https://cdn.shopify.com/s/files/1/0000/0000/0000/files/halftone.png'); }
  .clv35-hero h1 { font-size: 50px; color: #EF4444; margin-bottom: 10px; transform: rotate(-2deg); text-shadow: 2px 2px 0px #0E7490; }
  .clv35-hero p { font-size: 18px; font-family: 'Open Sans', sans-serif; font-weight: 800; color: #0E7490; background: #FFF; display: inline-block; padding: 5px 15px; border: 2px solid #0E7490; }
  .clv35-chips { display: flex; gap: 15px; justify-content: center; margin-bottom: 40px; flex-wrap: wrap; }
  .clv35-chips a { padding: 10px 20px; background: #0E7490; color: #FFF; text-decoration: none; font-size: 16px; border: 2px solid #000; box-shadow: 4px 4px 0 #000; transition: 0.2s; }
  .clv35-chips a:hover, .clv35-chips a.active { background: #EF4444; transform: translate(2px, 2px); box-shadow: 2px 2px 0 #000; }
  .clv35-toolbar { display: flex; justify-content: space-between; align-items: center; background: #FFF; padding: 15px; border: 3px solid #000; box-shadow: 4px 4px 0 #000; margin-bottom: 30px; font-family: 'Open Sans', sans-serif; font-weight: 800; }
  .clv35-grid { display: grid; grid-template-columns: repeat({{ section.settings.cols_desktop | default: 4 }}, 1fr); gap: 25px; }
  .clv35-promo { grid-column: span 1; background: #EAB308; border: 3px solid #000; box-shadow: 6px 6px 0 #000; padding: 30px; text-align: center; display: flex; flex-direction: column; justify-content: center; color: #000; }
  .clv35-promo h3 { font-size: 28px; margin-bottom: 20px; line-height: 1.2; transform: rotate(1deg); }
  .clv35-promo a { display: inline-block; padding: 10px 20px; background: #000; color: #FFF; text-decoration: none; font-size: 14px; font-family: 'Open Sans', sans-serif; font-weight: 800; text-transform: uppercase; }
  .clv35-seo { margin-top: 50px; background: #FFF; border: 3px solid #000; padding: 40px; text-align: center; box-shadow: 4px 4px 0 #000; font-family: 'Open Sans', sans-serif; }
  @media (max-width: 768px) { .clv35-grid { grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr); gap: 15px; } .clv35-hero h1 { font-size: 38px; } }
</style>
<div class="clv35" style="max-width: 1300px; margin: 0 auto;">
  <div class="clv35-hero">
    <h1>{% if collection.title != blank %}{{ collection.title | escape }}{% else %}BOARD RIDER{% endif %}</h1>
    <p>{% if collection.description != blank %}{{ collection.description }}{% else %}Concrete waves and ocean swells.{% endif %}</p>
  </div>
  {% if section.settings.sub_collections != blank %}
    <div class="clv35-chips">
      {% for link in section.settings.sub_collections.links %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% endfor %}
    </div>
  {% endif %}
  <div class="clv35-toolbar">
    <facet-filters-form style="width: 100%;">
      <form id="FacetFiltersForm" style="display: flex; justify-content: space-between; align-items: center; width: 100%; flex-wrap: wrap; gap: 15px;">
        <div style="display: flex; gap: 20px;">
          {%- for filter in collection.filters -%}
            <details style="position: relative;">
              <summary style="cursor: pointer; font-size: 14px; text-transform: uppercase; color: #000;">{{ filter.label }} ⚡</summary>
              <div style="position: absolute; background: #FFF; border: 3px solid #000; padding: 20px; z-index: 10; margin-top: 15px; min-width: 200px; box-shadow: 4px 4px 0 #000;">
                {%- for value in filter.values -%}
                  <label style="display: block; margin-bottom: 12px; cursor: pointer; font-size: 14px; color: #000;">
                    <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %}>
                    {{ value.label }} ({{ value.count }})
                  </label>
                {%- endfor -%}
              </div>
            </details>
          {%- endfor -%}
        </div>
        <select name="sort_by" onchange="this.form.submit()" style="background: #FFF; border: 2px solid #000; padding: 8px 12px; font-size: 14px; font-weight: 800; font-family: 'Open Sans', sans-serif; cursor: pointer; text-transform: uppercase;">
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>
          {%- endfor -%}
        </select>
      </form>
    </facet-filters-form>
  </div>
  {% assign limit_num = section.settings.products_per_page | default: 16 %}
  {% paginate collection.products by limit_num %}
    <div class="clv35-grid">
      {% for product in collection.products %}
        {% render 'card-v35', product: product %}
        {% if forloop.index == 8 and section.settings.show_promo_tile %}
          <div class="clv35-promo">
            <h3>Custom<br>Decks</h3>
            <a href="/pages/custom">Build Yours</a>
          </div>
        {% endif %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v35', product: nil %}
        {% endfor %}
      {% endfor %}
    </div>
    <div style="margin-top: 40px; text-align: center; font-size: 24px;">{{ paginate | default_pagination }}</div>
  {% endpaginate %}
  {% if section.settings.show_seo_block %}
    <div class="clv35-seo">
      <h2 style="font-family: 'Permanent Marker', cursive; font-size: 32px; color: #0E7490; margin-bottom: 10px;">{{ section.settings.seo_title | default: 'SHRED EVERYTHING' }}</h2>
      <p style="font-size: 14px; color: #000; font-weight: 800; max-width: 600px; margin: 0 auto; line-height: 1.6;">{{ section.settings.seo_text | default: 'Apparel built to withstand road rash and saltwater.' }}</p>
    </div>
  {% endif %}
</div>
{% schema %}
{
  "name": "CL V35 — Surf/Skate", "settings": [
    {"type": "range", "id": "products_per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 16},
    {"type": "range", "id": "cols_desktop", "label": "Desktop Columns", "min": 2, "max": 5, "default": 4},
    {"type": "select", "id": "cols_mobile", "label": "Mobile Columns", "options": [{"value": "1", "label": "1"}, {"value": "2", "label": "2"}], "default": "2"},
    {"type": "link_list", "id": "sub_collections", "label": "Sub-Collection Menu"},
    {"type": "checkbox", "id": "show_promo_tile", "label": "Show Promo Card", "default": true},
    {"type": "checkbox", "id": "show_seo_block", "label": "Show SEO Block", "default": true},
    {"type": "color", "id": "bg_color", "label": "Background Color", "default": "#FCEFC7"},
    {"type": "color", "id": "text_color", "label": "Text Color", "default": "#0E7490"}
  ], "presets": [{"name": "CL V35 — Surf/Skate"}]
}
{% endschema %}
