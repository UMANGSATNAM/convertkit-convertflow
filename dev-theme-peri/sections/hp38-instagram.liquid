{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Space+Mono:ital,wght@0,400;0,700;1,400;1,700&family=Inter:wght@400;600;800&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    
    --font-heading: 'Space Mono', monospace;
    --font-body: 'Inter', sans-serif;
    
    background-color: var(--text-color);
    border-bottom: 2px solid var(--text-color);
  }

  .hp38-insta-wrapper {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2px;
  }

  @media screen and (max-width: 992px) {
    .hp38-insta-wrapper {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .hp38-insta__header {
    background: var(--bg-color);
    padding: 40px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    grid-column: span 1;
  }
  
  @media screen and (max-width: 992px) {
    .hp38-insta__header {
      grid-column: span 2;
    }
  }

  .hp38-insta__meta {
    font-family: var(--font-heading);
    font-size: 12px;
    font-weight: 700;
    color: var(--accent-color);
    margin-bottom: 30px;
  }

  .hp38-insta__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    line-height: 1.1;
    color: var(--text-color);
    margin: 0 0 20px;
    text-transform: uppercase;
  }

  .hp38-insta__handle {
    font-family: var(--font-heading);
    font-size: 16px;
    font-weight: 700;
    color: var(--bg-color);
    background: var(--text-color);
    padding: 10px 20px;
    text-decoration: none;
    display: inline-block;
    align-self: flex-start;
    transition: background 0.3s ease, color 0.3s ease;
  }

  .hp38-insta__handle:hover {
    background: var(--accent-color);
    color: #fff;
  }

  .hp38-insta__item {
    background: var(--bg-color);
    aspect-ratio: 1;
    position: relative;
    overflow: hidden;
    display: block;
  }

  .hp38-insta__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%);
    transition: filter 0.3s ease, transform 0.3s ease;
  }

  .hp38-insta__item:hover .hp38-insta__image {
    filter: grayscale(0%);
    transform: scale(1.05);
  }

  .hp38-insta__overlay-text {
    position: absolute;
    top: 10px;
    left: 10px;
    font-family: var(--font-heading);
    font-size: 10px;
    color: #fff;
    background: rgba(0,0,0,0.5);
    padding: 2px 5px;
    pointer-events: none;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp38-insta-wrapper" id="HP38Insta-{{ section.id }}">
  <div class="hp38-insta__header">
    <div>
      <div class="hp38-insta__meta">NETWORK // FEED</div>
      <h2 class="hp38-insta__title">{{ section.settings.title }}</h2>
    </div>
    <a href="{{ section.settings.link | default: '#' }}" class="hp38-insta__handle">{{ section.settings.handle }}</a>
  </div>

  {%- for block in section.blocks limit: 3 -%}
    <a href="{{ block.settings.link | default: '#' }}" class="hp38-insta__item" {{ block.shopify_attributes }}>
      {%- if block.settings.image != blank -%}
        <img src="{{ block.settings.image | image_url: width: 600 }}" alt="Instagram feed" class="hp38-insta__image" loading="lazy">
      {%- else -%}
        {%- assign placeholder = 'lifestyle-' | append: forloop.index -%}
        {{ placeholder | placeholder_svg_tag: 'hp38-insta__image' }}
      {%- endif -%}
      <div class="hp38-insta__overlay-text">IMG_0{{ forloop.index }}</div>
    </a>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "HP38 - Brutalist Social",
  "class": "section-hp38-instagram",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "FIELD DATA"
    },
    {
      "type": "text",
      "id": "handle",
      "label": "Instagram Handle",
      "default": "@SYSTEM_OPS"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Instagram Link"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 48
    },
    {
      "type": "header",
      "content": "Brutalist Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text & Grid Lines",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#0000FF"
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Social Post",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP38 - Brutalist Social",
      "blocks": [
        { "type": "post" },
        { "type": "post" },
        { "type": "post" }
      ]
    }
  ]
}
{% endschema %}
