{% comment %}
  FB04 Hero Tabs — 5 interactive tab pills + hero image
  Tabbed hero section with content switching animation
{% endcomment %}

<style>
  .fb04-hero {
    padding: 80px 60px 0;
    background: #fff;
  }
  .fb04-hero__inner {
    max-width: 1200px;
    margin: 0 auto;
    text-align: center;
  }
  .fb04-hero__tabs {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-bottom: 48px;
    flex-wrap: wrap;
  }
  .fb04-hero__tab {
    font-family: 'Host Grotesk', sans-serif;
    font-weight: 600;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 10px 20px;
    border-radius: 100px;
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
    background: #E8F1FF;
    color: #282A2F;
  }
  .fb04-hero__tab.active {
    background: #0066FF;
    color: #fff;
  }
  .fb04-hero__tab:hover:not(.active) {
    background: #d4e5ff;
  }
  .fb04-hero__content {
    display: none;
    animation: fb04FadeIn 0.5s ease;
  }
  .fb04-hero__content.active {
    display: block;
  }
  @keyframes fb04FadeIn {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .fb04-hero__heading {
    font-family: 'Big Shoulders Display', sans-serif;
    font-weight: 700;
    font-size: 72px;
    line-height: 1.05;
    color: #282A2F;
    text-transform: uppercase;
    margin-bottom: 20px;
    letter-spacing: -1px;
  }
  .fb04-hero__body {
    font-family: 'Host Grotesk', sans-serif;
    font-weight: 400;
    font-size: 18px;
    line-height: 1.6;
    color: #7B818E;
    max-width: 560px;
    margin: 0 auto 32px;
  }
  .fb04-hero__cta {
    display: inline-block;
    font-family: 'Host Grotesk', sans-serif;
    font-weight: 600;
    font-size: 15px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 14px 36px;
    background: #0066FF;
    color: #fff;
    border-radius: 100px;
    text-decoration: none;
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .fb04-hero__cta:hover {
    background: #2E82FF;
    transform: translateY(-2px);
  }
  .fb04-hero__image-wrapper {
    margin-top: 48px;
    border-radius: 16px;
    overflow: hidden;
    position: relative;
  }
  .fb04-hero__image-wrapper img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    aspect-ratio: 16 / 9;
  }
  .fb04-hero__image-wrapper .placeholder-img {
    width: 100%;
    aspect-ratio: 16 / 9;
    background: linear-gradient(135deg, #282A2F 0%, #3D4047 40%, #282A2F 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Big Shoulders Display', sans-serif;
    font-size: 48px;
    color: rgba(255,255,255,0.15);
    text-transform: uppercase;
    letter-spacing: 8px;
  }

  @media (max-width: 809px) {
    .fb04-hero {
      padding: 40px 24px 0;
    }
    .fb04-hero__heading {
      font-size: 38px;
    }
    .fb04-hero__body {
      font-size: 15px;
    }
    .fb04-hero__tabs {
      gap: 8px;
    }
    .fb04-hero__tab {
      font-size: 11px;
      padding: 8px 14px;
    }
  }
  @media (min-width: 810px) and (max-width: 1199px) {
    .fb04-hero {
      padding: 60px 40px 0;
    }
    .fb04-hero__heading {
      font-size: 56px;
    }
  }
</style>

<section class="fb04-hero" id="fb04-hero">
  <div class="fb04-hero__inner">
    <div class="fb04-hero__tabs">
      {% for block in section.blocks %}
        <button class="fb04-hero__tab{% if forloop.first %} active{% endif %}"
                data-tab="{{ forloop.index0 }}"
                {{ block.shopify_attributes }}>
          {{ block.settings.tab_label }}
        </button>
      {% endfor %}
    </div>

    {% for block in section.blocks %}
      <div class="fb04-hero__content{% if forloop.first %} active{% endif %}"
           data-content="{{ forloop.index0 }}">
        <h1 class="fb04-hero__heading">{{ block.settings.heading }}</h1>
        <p class="fb04-hero__body">{{ block.settings.body }}</p>
        <a href="{{ block.settings.cta_link | default: '#' }}" class="fb04-hero__cta">
          {{ block.settings.cta_text | default: 'Shop now' }}
        </a>
      </div>
    {% endfor %}

    <div class="fb04-hero__image-wrapper">
      {% if section.settings.hero_image != blank %}
        <img src="{{ section.settings.hero_image | image_url: width: 1400 }}"
             alt="{{ section.settings.hero_image_alt | default: 'Hero' }}"
             loading="eager"
             width="1400" height="788">
      {% else %}
        <div class="placeholder-img">RAWBLOX</div>
      {% endif %}
    </div>
  </div>
</section>

<script>
  (function() {
    var tabs = document.querySelectorAll('.fb04-hero__tab');
    var contents = document.querySelectorAll('.fb04-hero__content');
    tabs.forEach(function(tab) {
      tab.addEventListener('click', function() {
        var idx = this.getAttribute('data-tab');
        tabs.forEach(function(t) { t.classList.remove('active'); });
        contents.forEach(function(c) { c.classList.remove('active'); });
        this.classList.add('active');
        var target = document.querySelector('.fb04-hero__content[data-content="' + idx + '"]');
        if (target) target.classList.add('active');
      });
    });
  })();
</script>

{% schema %}
{
  "name": "FB04 Hero Tabs",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image"
    },
    {
      "type": "text",
      "id": "hero_image_alt",
      "label": "Image Alt Text",
      "default": "RAWBLOX Streetwear"
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        {
          "type": "text",
          "id": "tab_label",
          "label": "Tab Label",
          "default": "Limited Drops"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Limited Drops, Maximum Impact"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Body Text",
          "default": "We release exclusive, small-batch collections to keep your style fresh and unique—once it's gone, it's gone."
        },
        {
          "type": "text",
          "id": "cta_text",
          "label": "CTA Text",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "cta_link",
          "label": "CTA Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FB04 Hero Tabs",
      "blocks": [
        { "type": "tab", "settings": { "tab_label": "Limited Drops, Maximum Impact", "heading": "Limited Drops, Maximum Impact", "body": "We release exclusive, small-batch collections to keep your style fresh and unique—once it's gone, it's gone." } },
        { "type": "tab", "settings": { "tab_label": "Built for the Streets", "heading": "Built for the Streets", "body": "Every piece is designed with the raw energy of city life—graffiti, underground music, and late-night skate sessions." } },
        { "type": "tab", "settings": { "tab_label": "Art Meets Attitude", "heading": "Art Meets Attitude", "body": "Bold graphics, oversized silhouettes, and urban edge—our designs are wearable art for the culture." } },
        { "type": "tab", "settings": { "tab_label": "Future-Ready Fashion", "heading": "Future-Ready Fashion", "body": "Premium materials meet cutting-edge design. Streetwear that's built to last and made to turn heads." } },
        { "type": "tab", "settings": { "tab_label": "Community-Driven Culture", "heading": "Community-Driven Culture", "body": "More than clothing—we're a movement. Join the community of rebels and dreamers shaping the culture." } }
      ]
    }
  ]
}
{% endschema %}
