{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp45-feat-bg: {{ section.settings.bg_color | default: '#F5F5F0' }};
    --hp45-border: {{ section.settings.border_color | default: '#0A0A0A' }};
    
    background-color: var(--hp45-feat-bg);
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
  }

  .hp45-feat__wrap {
    max-width: {{ section.settings.container_width | default: 1300 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp45-feat__header {
    text-align: center;
    margin-bottom: 50px;
  }

  .hp45-feat__heading {
    font-size: clamp(28px, 4vw, 42px);
    font-weight: 700;
    text-transform: uppercase;
    color: #0A0A0A;
    margin: 0 0 8px;
  }

  .hp45-feat__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: 3 }}, 1fr);
    gap: 24px;
  }

  .hp45-feat__card {
    background: #FFFFFF;
    border: 2px solid var(--hp45-border);
    box-shadow: 5px 5px 0 var(--hp45-border);
    padding: 32px 28px;
    transition: all 0.2s ease;
  }

  .hp45-feat__card:hover {
    transform: translate(2px, 2px);
    box-shadow: 3px 3px 0 var(--hp45-border);
  }

  .hp45-feat__index {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    font-weight: 700;
    color: #888888;
    margin-bottom: 14px;
  }

  .hp45-feat__title {
    font-size: 18px;
    font-weight: 700;
    text-transform: uppercase;
    color: #0A0A0A;
    margin: 0 0 10px;
  }

  .hp45-feat__desc {
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    line-height: 1.65;
    color: #4A4A4A;
    margin: 0;
  }

  @media screen and (max-width: 992px) {
    .hp45-feat__grid { grid-template-columns: 1fr; }
  }
{%- endstyle -%}

<div class="hp45-feat__wrap">
  <div class="hp45-feat__header">
    <h2 class="hp45-feat__heading">{{ section.settings.heading | default: 'SYSTEM SCIENTIFIC SPECIFICATIONS' }}</h2>
    <p style="font-family:'JetBrains Mono', monospace; font-size:13px; color:#555;">{{ section.settings.subheading | default: 'Verified technological parameters powering the V45 formulation system.' }}</p>
  </div>

  <div class="hp45-feat__grid">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <div class="hp45-feat__card" {{ block.shopify_attributes }}>
          <div class="hp45-feat__index">[INNOVATION // 0{{ forloop.index }}]</div>
          <h3 class="hp45-feat__title">{{ block.settings.title }}</h3>
          <p class="hp45-feat__desc">{{ block.settings.description }}</p>
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="hp45-feat__card">
        <div class="hp45-feat__index">[INNOVATION // 01]</div>
        <h3 class="hp45-feat__title">STRETCH-FREE CELLULAR CROSSLINKING</h3>
        <p class="hp45-feat__desc">High-molecular weight hyaluronic cross-polymers create an elastic micro-grid for all-day tension support.</p>
      </div>
      <div class="hp45-feat__card">
        <div class="hp45-feat__index">[INNOVATION // 02]</div>
        <h3 class="hp45-feat__title">ECTOIN STRESS PROTECTION MOLECULES</h3>
        <p class="hp45-feat__desc">Forms a hydration shell around cellular membranes to prevent thermal and osmotic shock.</p>
      </div>
      <div class="hp45-feat__card">
        <div class="hp45-feat__index">[INNOVATION // 03]</div>
        <h3 class="hp45-feat__title">ZERO-OXYGEN PHARMACEUTICAL AMPOULES</h3>
        <p class="hp45-feat__desc">Nitrogen-purged packaging prevents oxidation, ensuring 100% active potency upon dispensing.</p>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP45 - Brutal Feat",
  "class": "section-hp45-features",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#F5F5F0" },
    { "type": "color", "id": "border_color", "label": "Border Color", "default": "#0A0A0A" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "SYSTEM SCIENTIFIC SPECIFICATIONS" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Verified technological parameters powering the V45 formulation system." },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "label": "Desktop Columns", "default": 3 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 80 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1300 }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Card",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "STRETCH-FREE CELLULAR CROSSLINKING" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "High-molecular weight hyaluronic cross-polymers create an elastic micro-grid." }
      ]
    }
  ],
  "presets": [
    { "name": "HP45 - Brutal Feat" }
  ]
}
{% endschema %}
