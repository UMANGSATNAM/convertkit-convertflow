{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#FFFFFF' }};
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }
  .hp56-feat__container { max-width: {{ section.settings.container_width | default: 1280 }}px; margin: 0 auto; padding: 0 24px; }
  .hp56-feat__header { text-align: center; margin-bottom: 50px; }
  .hp56-feat__eyebrow { font-family: 'Outfit', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: {{ section.settings.accent_color | default: '#0284C7' }}; margin: 0 0 12px; }
  .hp56-feat__heading { font-family: 'Syne', sans-serif; font-size: clamp(28px, 3.5vw, 42px); font-weight: 800; color: #082F49; margin: 0; }
  .hp56-feat__grid { display: grid; grid-template-columns: repeat({{ section.settings.columns | default: 3 }}, 1fr); gap: 24px; }
  .hp56-feat__card {
    background: {{ section.settings.card_bg | default: '#F0F9FF' }};
    border: 1px solid rgba(2, 132, 199, 0.12); border-radius: 14px; padding: 28px 24px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .hp56-feat__card:hover { transform: translateY(-4px); box-shadow: 0 14px 35px rgba(2, 132, 199, 0.1); }
  .hp56-feat__card-icon {
    width: 48px; height: 48px; background: linear-gradient(135deg, #E0F2FE, #BAE6FD);
    border-radius: 10px; display: flex; align-items: center; justify-content: center;
    font-size: 20px; color: #0284C7; margin-bottom: 18px;
  }
  .hp56-feat__card-title { font-family: 'Syne', sans-serif; font-size: 17px; font-weight: 700; color: #082F49; margin: 0 0 8px; }
  .hp56-feat__card-desc { font-size: 13px; line-height: 1.6; color: #475569; margin: 0; }
  @media screen and (max-width: 992px) { .hp56-feat__grid { grid-template-columns: repeat(2, 1fr); } }
  @media screen and (max-width: 480px) { .hp56-feat__grid { grid-template-columns: 1fr; } }
{%- endstyle -%}
<div class="hp56-feat__container">
  <div class="hp56-feat__header">
    {%- if section.settings.eyebrow != blank -%}<p class="hp56-feat__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="hp56-feat__heading">{{ section.settings.heading | default: 'Sub-Zero Bio-Science' }}</h2>
  </div>
  <div class="hp56-feat__grid">
    {%- for block in section.blocks -%}
      <div class="hp56-feat__card" {{ block.shopify_attributes }}>
        <div class="hp56-feat__card-icon">{{ block.settings.icon | default: '❄️' }}</div>
        <h3 class="hp56-feat__card-title">{{ block.settings.title | default: 'Glacial Purity' }}</h3>
        <p class="hp56-feat__card-desc">{{ block.settings.description | default: 'Arctic botanical extractions.' }}</p>
      </div>
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "HP56 Features",
  "class": "section-hp56-feat",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "card_bg", "label": "Card BG", "default": "#F0F9FF" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#0284C7" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "❄️ BIO-SCIENCE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Sub-Zero Bio-Science" },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "label": "Columns", "default": 3 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "blocks": [{
    "type": "feature", "name": "Feature",
    "settings": [
      { "type": "text", "id": "icon", "label": "Icon", "default": "❄️" },
      { "type": "text", "id": "title", "label": "Title", "default": "Glacial Purity" },
      { "type": "textarea", "id": "description", "label": "Description", "default": "Arctic botanical extractions." }
    ]
  }],
  "presets": [{
    "name": "HP56 Features",
    "blocks": [
      { "type": "feature", "settings": { "icon": "🫐", "title": "Wild Cloudberry Bio-Actives", "description": "High-potency polyphenols that brighten skin tone in 14 days." } },
      { "type": "feature", "settings": { "icon": "🌲", "title": "Finnish Birch Xylitol", "description": "Strengthens cellular moisture barriers against extreme weather." } },
      { "type": "feature", "settings": { "icon": "💧", "title": "Glacial Mineral Electrolytes", "description": "Replenishes trace zinc, magnesium, and selenium naturally." } },
      { "type": "feature", "settings": { "icon": "❄️", "title": "Cryo-Sonic Preservation", "description": "Maintains raw antioxidant potency with zero thermal degradation." } },
      { "type": "feature", "settings": { "icon": "🍃", "title": "100% Clean Vegan Formula", "description": "Free from parabens, synthetic fragrances, and silicones." } },
      { "type": "feature", "settings": { "icon": "🌍", "title": "Carbon Negative Certified", "description": "Every purchase plants 3 birch trees in Scandinavian forests." } }
    ]
  }]
}
{% endschema %}
