{%- liquid
  assign sec_id = section.id
  assign bg_color = section.settings.bg_color
  assign text_color = section.settings.text_color
  assign box_bg = section.settings.box_bg
  assign accent_color = section.settings.accent_color
  assign border_color = section.settings.border_color
  assign border_width = section.settings.border_width
  assign shadow_color = section.settings.shadow_color
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
-%}

<style>
  .hp18-faq-{{ sec_id }} {
    background-color: {{ bg_color }};
    padding-top: {{ padding_top }}px;
    padding-bottom: {{ padding_bottom }}px;
    border-bottom: {{ border_width }}px solid {{ border_color }};
  }

  .hp18-faq-{{ sec_id }}__container {
    max-width: var(--page-width, 1000px);
    margin: 0 auto;
    padding: 0 40px;
  }

  .hp18-faq-{{ sec_id }}__header {
    text-align: center;
    margin-bottom: 60px;
  }

  .hp18-faq-{{ sec_id }}__title {
    font-family: 'Arial Black', Impact, sans-serif;
    font-size: clamp(36px, 6vw, 72px);
    color: {{ text_color }};
    text-transform: uppercase;
    margin: 0;
    line-height: 1;
    text-shadow: 4px 4px 0px {{ shadow_color }};
    letter-spacing: -2px;
  }

  .hp18-faq-{{ sec_id }}__list {
    display: flex;
    flex-direction: column;
    gap: 25px;
  }

  .hp18-faq-{{ sec_id }}__item {
    background-color: {{ box_bg }};
    border: {{ border_width }}px solid {{ border_color }};
    box-shadow: 8px 8px 0px {{ shadow_color }};
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }

  .hp18-faq-{{ sec_id }}__item.is-active {
    box-shadow: 12px 12px 0px {{ accent_color }};
    transform: translate(-4px, -4px);
  }

  .hp18-faq-{{ sec_id }}__question {
    padding: 30px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    user-select: none;
  }

  .hp18-faq-{{ sec_id }}__q-text {
    font-family: 'Arial Black', sans-serif;
    font-size: 20px;
    color: {{ text_color }};
    margin: 0;
    text-transform: uppercase;
  }

  .hp18-faq-{{ sec_id }}__icon {
    width: 30px;
    height: 30px;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 24px;
    font-family: monospace;
    font-weight: bold;
    color: {{ text_color }};
    background-color: {{ accent_color }};
    border: {{ border_width }}px solid {{ border_color }};
    transition: transform 0.3s ease;
  }

  .hp18-faq-{{ sec_id }}__item.is-active .hp18-faq-{{ sec_id }}__icon {
    transform: rotate(45deg);
    background-color: {{ bg_color }};
  }

  .hp18-faq-{{ sec_id }}__answer {
    padding: 0 30px;
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s cubic-bezier(0.25, 1, 0.5, 1), padding 0.4s ease;
  }

  .hp18-faq-{{ sec_id }}__item.is-active .hp18-faq-{{ sec_id }}__answer {
    padding: 0 30px 30px 30px;
    max-height: 500px;
  }

  .hp18-faq-{{ sec_id }}__a-text {
    font-family: 'Courier New', monospace;
    font-size: 16px;
    line-height: 1.6;
    font-weight: bold;
    color: {{ text_color }};
    margin: 0;
    border-top: {{ border_width }}px dashed {{ border_color }};
    padding-top: 20px;
  }

  @media screen and (max-width: 768px) {
    .hp18-faq-{{ sec_id }}__container { padding: 0 20px; }
    .hp18-faq-{{ sec_id }}__question { padding: 20px; }
    .hp18-faq-{{ sec_id }}__item.is-active .hp18-faq-{{ sec_id }}__answer { padding: 0 20px 20px 20px; }
    .hp18-faq-{{ sec_id }}__q-text { font-size: 16px; }
  }
</style>

<section class="hp18-faq-{{ sec_id }}">
  <div class="hp18-faq-{{ sec_id }}__container">
    
    <div class="hp18-faq-{{ sec_id }}__header">
      <h2 class="hp18-faq-{{ sec_id }}__title">{{ section.settings.title }}</h2>
    </div>

    <div class="hp18-faq-{{ sec_id }}__list">
      {% for block in section.blocks %}
        <div class="hp18-faq-{{ sec_id }}__item js-faq-item-{{ sec_id }}" {{ block.shopify_attributes }}>
          <div class="hp18-faq-{{ sec_id }}__question js-faq-trigger-{{ sec_id }}">
            <h3 class="hp18-faq-{{ sec_id }}__q-text">{{ block.settings.question }}</h3>
            <div class="hp18-faq-{{ sec_id }}__icon">+</div>
          </div>
          <div class="hp18-faq-{{ sec_id }}__answer">
            <p class="hp18-faq-{{ sec_id }}__a-text">{{ block.settings.answer }}</p>
          </div>
        </div>
      {% else %}
        {% for i in (1..4) %}
          <div class="hp18-faq-{{ sec_id }}__item js-faq-item-{{ sec_id }}">
            <div class="hp18-faq-{{ sec_id }}__question js-faq-trigger-{{ sec_id }}">
              <h3 class="hp18-faq-{{ sec_id }}__q-text">DO YOU SHIP INTERNATIONALLY?</h3>
              <div class="hp18-faq-{{ sec_id }}__icon">+</div>
            </div>
            <div class="hp18-faq-{{ sec_id }}__answer">
              <p class="hp18-faq-{{ sec_id }}__a-text">Yes, we ship worldwide. Shipping costs will apply, and will be added at checkout.</p>
            </div>
          </div>
        {% endfor %}
      {% endfor %}
    </div>

  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const triggers = document.querySelectorAll('.js-faq-trigger-{{ sec_id }}');
    
    triggers.forEach(trigger => {
      trigger.addEventListener('click', function() {
        const item = this.parentElement;
        const isActive = item.classList.contains('is-active');
        
        // Close all other items for a clean accordion effect
        document.querySelectorAll('.js-faq-item-{{ sec_id }}').forEach(el => {
          el.classList.remove('is-active');
        });
        
        // Toggle current item
        if (!isActive) {
          item.classList.add('is-active');
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "HP18 Adv FAQ",
  "settings": [
    {
      "type": "header",
      "content": "Color Settings"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f4f4f0"
    },
    {
      "type": "color",
      "id": "box_bg",
      "label": "Box Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#CCFF00"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "shadow_color",
      "label": "Shadow Color",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "FAQ"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "Border Width",
      "default": 3
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 10,
      "unit": "px",
      "label": "Padding Top",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 10,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 100
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "DO YOU SHIP INTERNATIONALLY?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "Yes, we ship worldwide. Shipping costs will apply, and will be added at checkout."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP18 Advanced FAQ",
      "blocks": [
        { "type": "faq", "settings": { "question": "WHAT IS YOUR RETURN POLICY?" } },
        { "type": "faq", "settings": { "question": "HOW LONG DOES SHIPPING TAKE?" } },
        { "type": "faq", "settings": { "question": "DO YOU RESTOCK DROPS?" } }
      ]
    }
  ]
}
{% endschema %}
