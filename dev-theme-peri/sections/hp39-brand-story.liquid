{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap');

  #shopify-section-{{ section.id }} {
    --text-color: {{ section.settings.text_color }};
    --bg-color: {{ section.settings.bg_color }};
    --accent-color: {{ section.settings.accent_color }};
    
    --font-heading: 'Outfit', sans-serif;
    --font-body: 'Outfit', sans-serif;
    
    padding: 80px 20px;
    background-color: var(--bg-color);
  }

  .hp39-story-wrapper {
    max-width: 1200px;
    margin: 0 auto;
    position: relative;
    border-radius: 50px;
    overflow: hidden;
    padding: 100px 40px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Iridescent / Mesh Gradient Background */
  .hp39-story__bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(120deg, #ff9a9e 0%, #fecfef 99%, #fecfef 100%);
    z-index: 1;
    overflow: hidden;
  }

  /* Animated Mesh Orbs */
  .hp39-story__orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(60px);
    opacity: 0.7;
    animation: drift 15s infinite ease-in-out alternate;
  }

  .hp39-story__orb--1 {
    width: 60vw; height: 60vw;
    background: #a18cd1;
    top: -20%; left: -10%;
    animation-delay: 0s;
  }
  .hp39-story__orb--2 {
    width: 50vw; height: 50vw;
    background: #fbc2eb;
    bottom: -10%; right: -10%;
    animation-delay: -7s;
  }
  .hp39-story__orb--3 {
    width: 40vw; height: 40vw;
    background: #8fd3f4;
    top: 30%; left: 40%;
    animation-delay: -3s;
  }

  @keyframes drift {
    0% { transform: translate(0,0) scale(1); }
    100% { transform: translate(15%, 15%) scale(1.2); }
  }

  /* Glassmorphism Panel */
  .hp39-story__content {
    position: relative;
    z-index: 2;
    background: rgba(255, 255, 255, 0.5);
    backdrop-filter: blur(25px);
    -webkit-backdrop-filter: blur(25px);
    border: 1px solid rgba(255, 255, 255, 0.8);
    border-radius: 40px;
    padding: 60px;
    text-align: center;
    max-width: 800px;
    box-shadow: 0 30px 60px rgba(0,0,0,0.05);
  }

  @media screen and (max-width: 768px) {
    .hp39-story__content {
      padding: 40px 20px;
      border-radius: 30px;
    }
    .hp39-story-wrapper {
      padding: 60px 20px;
      border-radius: 30px;
    }
  }

  .hp39-story__badge {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--accent-color);
    margin-bottom: 20px;
  }

  .hp39-story__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    font-weight: 700;
    line-height: 1.1;
    color: var(--text-color);
    margin: 0 0 30px;
    letter-spacing: -1px;
  }

  .hp39-story__text {
    font-family: var(--font-body);
    font-size: clamp(16px, 2vw, 20px);
    line-height: 1.6;
    color: var(--text-color);
    margin: 0 0 40px;
  }

  .hp39-story__btn {
    display: inline-block;
    padding: 16px 40px;
    background: var(--text-color);
    color: #fff;
    font-family: var(--font-heading);
    font-size: 16px;
    font-weight: 600;
    border-radius: 50px;
    text-decoration: none;
    box-shadow: 0 10px 20px rgba(0,0,0,0.1);
    transition: all 0.3s ease;
  }

  .hp39-story__btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 15px 25px rgba(0,0,0,0.15);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp39-story-wrapper" id="HP39Story-{{ section.id }}">
  <div class="hp39-story__bg">
    <div class="hp39-story__orb hp39-story__orb--1"></div>
    <div class="hp39-story__orb hp39-story__orb--2"></div>
    <div class="hp39-story__orb hp39-story__orb--3"></div>
  </div>

  <div class="hp39-story__content">
    {%- if section.settings.badge != blank -%}
      <div class="hp39-story__badge">{{ section.settings.badge }}</div>
    {%- endif -%}
    
    <h2 class="hp39-story__title">{{ section.settings.title }}</h2>
    
    {%- if section.settings.text != blank -%}
      <div class="hp39-story__text">{{ section.settings.text }}</div>
    {%- endif -%}
    
    {%- if section.settings.btn_label != blank -%}
      <a href="{{ section.settings.btn_link | default: '#' }}" class="hp39-story__btn">
        {{ section.settings.btn_label }}
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP39 - Aura Story",
  "class": "section-hp39-brand-story",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge Text",
      "default": "Our Philosophy"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Designed for Tranquility."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>We believe your environment shapes your mind. Our pieces are crafted to bring a soft, ethereal calm into your daily life, blending seamless design with uncompromising comfort.</p>"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "Read Our Story"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 48
    },
    {
      "type": "header",
      "content": "Aura Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#faf9f8"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2D2D2D"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color (Badge)",
      "default": "#a18cd1"
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP39 - Aura Story"
    }
  ]
}
{% endschema %}
