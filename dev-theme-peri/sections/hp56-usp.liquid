{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#F0F9FF' }};
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
  }
  .hp56-usp__container { max-width: {{ section.settings.container_width | default: 1280 }}px; margin: 0 auto; padding: 0 24px; }
  .hp56-usp__grid { display: grid; grid-template-columns: repeat({{ section.settings.columns | default: 4 }}, 1fr); gap: 20px; }
  .hp56-usp__card {
    background: {{ section.settings.card_bg | default: '#FFFFFF' }};
    border: 1px solid rgba(2, 132, 199, 0.12);
    border-radius: 14px; padding: 32px 22px; text-align: center;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    box-shadow: 0 4px 20px rgba(2, 132, 199, 0.06);
  }
  .hp56-usp__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 40px rgba(2, 132, 199, 0.12);
  }
  .hp56-usp__icon {
    width: 52px; height: 52px;
    background: linear-gradient(135deg, #E0F2FE, #BAE6FD);
    border-radius: 12px; display: flex; align-items: center; justify-content: center;
    margin: 0 auto 16px; font-size: 22px; color: #0284C7;
  }
  .hp56-usp__title {
    font-family: 'Syne', sans-serif; font-size: 16px; font-weight: 700; color: #082F49; margin: 0 0 8px;
  }
  .hp56-usp__desc { font-size: 13px; line-height: 1.6; color: #475569; margin: 0; }
  @media screen and (max-width: 992px) { .hp56-usp__grid { grid-template-columns: repeat(2, 1fr); } }
  @media screen and (max-width: 480px) { .hp56-usp__grid { grid-template-columns: 1fr; } }
{%- endstyle -%}
<div class="hp56-usp__container">
  <div class="hp56-usp__grid">
    {%- for block in section.blocks -%}
      <div class="hp56-usp__card" {{ block.shopify_attributes }}>
        <div class="hp56-usp__icon">{{ block.settings.icon | default: '❄️' }}</div>
        <h3 class="hp56-usp__title">{{ block.settings.title | default: 'Arctic Purity' }}</h3>
        <p class="hp56-usp__desc">{{ block.settings.description | default: '100% pure wild-harvested botanicals.' }}</p>
      </div>
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "HP56 Pillars",
  "class": "section-hp56-usp",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#F0F9FF" },
    { "type": "color", "id": "card_bg", "label": "Card BG", "default": "#FFFFFF" },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "label": "Columns", "default": 4 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 80 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "blocks": [{ "type": "pillar", "name": "Pillar", "settings": [
    { "type": "text", "id": "icon", "label": "Icon", "default": "❄️" },
    { "type": "text", "id": "title", "label": "Title", "default": "Arctic Purity" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "100% pure wild-harvested botanicals." }
  ]}],
  "presets": [{ "name": "HP56 Pillars", "blocks": [
    { "type": "pillar", "settings": { "icon": "🫐", "title": "Arctic Cloudberry", "description": "4x Vitamin C concentration of sweet oranges." } },
    { "type": "pillar", "settings": { "icon": "🌲", "title": "Finnish Birch Sap", "description": "Living tree water enriched with 17 amino acids." } },
    { "type": "pillar", "settings": { "icon": "💧", "title": "Glacial Spring Oxygen", "description": "Super-oxygenated spring moisture infusion." } },
    { "type": "pillar", "settings": { "icon": "🛡️", "title": "Cryo-Shield Tech", "description": "Protects cellular matrix against sub-zero extremes." } }
  ]}]
}
{% endschema %}
