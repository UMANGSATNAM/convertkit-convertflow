{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#FAFAFA'
  assign text_color = section.settings.text_color | default: '#333333'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 100px 40px;
    border-bottom: 1px solid #E5E5E5;
  }
  
  .hp12-guarantee-container-{{ section_id }} {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 40px;
  }
  
  .hp12-guarantee-item-{{ section_id }} {
    text-align: center;
    color: {{ text_color }};
  }
  
  .hp12-guarantee-icon-{{ section_id }} {
    margin-bottom: 25px;
    display: flex;
    justify-content: center;
  }
  
  .hp12-guarantee-icon-{{ section_id }} svg {
    width: 24px;
    height: 24px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }
  
  .hp12-guarantee-title-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin: 0 0 10px 0;
  }
  
  .hp12-guarantee-text-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    font-weight: 300;
    opacity: 0.6;
    line-height: 1.6;
    margin: 0;
  }

  @media (max-width: 992px) {
    .hp12-guarantee-container-{{ section_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: 60px;
    }
  }
  
  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 60px 20px;
    }
    .hp12-guarantee-container-{{ section_id }} {
      grid-template-columns: 1fr;
      gap: 50px;
    }
  }
</style>

<div class="hp12-guarantee-container-{{ section_id }}">
  {% for block in section.blocks limit: 4 %}
    <div class="hp12-guarantee-item-{{ section_id }}" {{ block.shopify_attributes }}>
      <div class="hp12-guarantee-icon-{{ section_id }}">
        {% if block.settings.icon == 'shipping' %}
          <svg viewBox="0 0 24 24"><path d="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"/></svg>
        {% elsif block.settings.icon == 'return' %}
          <svg viewBox="0 0 24 24"><path d="M12 5V1L7 6l5 5V7c3.31 0 6 2.69 6 6s-2.69 6-6 6-6-2.69-6-6H4c0 4.42 3.58 8 8 8s8-3.58 8-8-3.58-8-8-8z"/></svg>
        {% elsif block.settings.icon == 'quality' %}
          <svg viewBox="0 0 24 24"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/></svg>
        {% else %}
          <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/></svg>
        {% endif %}
      </div>
      <h3 class="hp12-guarantee-title-{{ section_id }}">{{ block.settings.title }}</h3>
      <p class="hp12-guarantee-text-{{ section_id }}">{{ block.settings.text }}</p>
    </div>
  {% endfor %}
</div>

{% schema %}
{
  "name": "HP12 Guarantee",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FAFAFA"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#333333"
    }
  ],
  "blocks": [
    {
      "type": "guarantee",
      "name": "Guarantee Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shipping", "label": "Shipping" },
            { "value": "return", "label": "Return" },
            { "value": "quality", "label": "Quality" },
            { "value": "circle", "label": "Circle" }
          ],
          "default": "shipping"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "COMPLIMENTARY SHIPPING"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "White glove delivery on all large furniture orders."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP12 Guarantee",
      "blocks": [
        { "type": "guarantee", "settings": { "icon": "shipping", "title": "GLOBAL SHIPPING", "text": "Carefully packaged and delivered worldwide." } },
        { "type": "guarantee", "settings": { "icon": "quality", "title": "LIFETIME WARRANTY", "text": "Our craftsmanship is guaranteed for a lifetime." } },
        { "type": "guarantee", "settings": { "icon": "return", "title": "30-DAY RETURNS", "text": "Experience the piece in your space, risk-free." } },
        { "type": "guarantee", "settings": { "icon": "circle", "title": "SUSTAINABLE PRACTICE", "text": "Climate neutral operations from start to finish." } }
      ]
    }
  ]
}
{% endschema %}
