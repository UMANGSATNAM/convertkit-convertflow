{%- style -%}
  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --icon-bg: {{ section.settings.icon_bg }};
    --font-heading: 'Lora', serif;
    --font-body: 'Outfit', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    position: relative;
    overflow: hidden;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }

  /* Organic grain texture overlay */
  {% if section.settings.show_grain %}
  #shopify-section-{{ section.id }}::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    opacity: 0.04;
    pointer-events: none;
    z-index: 1;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
  }
  {% endif %}

  .hp22-usp-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
    position: relative;
    z-index: 2;
  }

  @media screen and (max-width: 768px) {
    .hp22-usp-wrapper {
      padding: 0 20px;
    }
  }

  .hp22-usp__header {
    text-align: center;
    margin-bottom: {{ section.settings.header_margin }}px;
  }

  .hp22-usp__subtitle {
    font-family: var(--font-body);
    font-size: {{ section.settings.subtitle_size }}px;
    font-weight: 400;
    letter-spacing: 2px;
    color: var(--accent-color);
    text-transform: uppercase;
    margin: 0 0 16px;
  }

  .hp22-usp__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    font-weight: 400;
    color: var(--text-color);
    margin: 0;
    line-height: 1.2;
  }
  
  .hp22-usp__title em {
    font-style: italic;
    color: var(--accent-color);
  }

  .hp22-usp__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.desktop_columns }}, 1fr);
    gap: {{ section.settings.gap }}px;
  }

  @media screen and (max-width: 992px) {
    .hp22-usp__grid {
      grid-template-columns: repeat({{ section.settings.tablet_columns }}, 1fr);
    }
  }

  @media screen and (max-width: 768px) {
    .hp22-usp__grid {
      grid-template-columns: repeat({{ section.settings.mobile_columns }}, 1fr);
      gap: {{ section.settings.mobile_gap }}px;
    }
  }

  .hp22-usp__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    transition: transform 0.4s ease;
  }

  .hp22-usp__item:hover {
    transform: translateY(-10px);
  }

  .hp22-usp__icon-wrapper {
    width: {{ section.settings.icon_box_size }}px;
    height: {{ section.settings.icon_box_size }}px;
    background-color: var(--icon-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 24px;
    color: var(--accent-color);
    transition: all 0.4s ease;
    
    {% if section.settings.icon_shape == 'circle' %}
      border-radius: 50%;
    {% elsif section.settings.icon_shape == 'leaf' %}
      border-radius: 50% 0 50% 0;
    {% elsif section.settings.icon_shape == 'blob' %}
      border-radius: 40% 60% 70% 30% / 40% 50% 60% 50%;
    {% else %}
      border-radius: 12px;
    {% endif %}
  }

  .hp22-usp__item:hover .hp22-usp__icon-wrapper {
    background-color: var(--accent-color);
    color: var(--bg-color);
    {% if section.settings.icon_shape == 'blob' %}
      border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%;
    {% endif %}
  }

  .hp22-usp__icon-wrapper svg {
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;
    fill: currentColor;
  }

  .hp22-usp__item-title {
    font-family: var(--font-heading);
    font-size: {{ section.settings.item_title_size }}px;
    font-weight: 400;
    color: var(--text-color);
    margin: 0 0 12px;
  }

  .hp22-usp__item-text {
    font-family: var(--font-body);
    font-size: {{ section.settings.item_text_size }}px;
    font-weight: 300;
    color: var(--text-color);
    opacity: 0.8;
    line-height: 1.6;
    margin: 0;
    max-width: 280px;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp22-usp-wrapper" id="HP22Usp-{{ section.id }}">
  
  {%- if section.settings.title != blank or section.settings.subtitle != blank -%}
    <div class="hp22-usp__header">
      {%- if section.settings.subtitle != blank -%}
        <p class="hp22-usp__subtitle">{{ section.settings.subtitle | escape }}</p>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 class="hp22-usp__title">{{ section.settings.title }}</h2>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="hp22-usp__grid">
    {%- for block in section.blocks -%}
      <div class="hp22-usp__item" {{ block.shopify_attributes }}>
        
        <div class="hp22-usp__icon-wrapper">
          {%- if block.settings.custom_svg != blank -%}
            {{ block.settings.custom_svg }}
          {%- else -%}
            {%- case block.settings.icon -%}
              {%- when 'leaf' -%}
                <svg viewBox="0 0 24 24"><path d="M17,8C8,10 5.9,16.17 3.82,21.34L5.71,22L6.66,19.7C7.14,19.87 7.64,20 8,20C19,20 22,3 22,3C21,5 14,5.25 9,6.25C4,7.25 7,14 7,14C18,14 17,8 17,8Z"/></svg>
              {%- when 'flower' -%}
                <svg viewBox="0 0 24 24"><path d="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,19.5C7.86,19.5 4.5,16.14 4.5,12C4.5,7.86 7.86,4.5 12,4.5C16.14,4.5 19.5,7.86 19.5,12C19.5,16.14 16.14,19.5 12,19.5M12,7.5A4.5,4.5 0 0,0 7.5,12A4.5,4.5 0 0,0 12,16.5A4.5,4.5 0 0,0 16.5,12A4.5,4.5 0 0,0 12,7.5Z"/></svg>
              {%- when 'earth' -%}
                <svg viewBox="0 0 24 24"><path d="M12,2C6.48,2 2,6.48 2,12C2,17.52 6.48,22 12,22C17.52,22 22,17.52 22,12C22,6.48 17.52,2 12,2M11,19.93C7.05,19.43 4,16.05 4,12C4,11.58 4.04,11.16 4.11,10.76C4.11,10.76 4.38,10.75 4.67,10.75C6,10.75 7.22,10.15 8,9.15V9C8,7.9 7.1,7 6,7H5V5.55C6.87,3.95 9.32,3 12,3C12.18,3 12.35,3.03 12.53,3.04C12.44,3.33 12.38,3.64 12.33,3.95L12,5C11.83,5.65 11.23,6.15 10.53,6.24L8.76,6.5L8.35,7.88L11,9L13.73,7.66C13.88,7.58 14.05,7.54 14.23,7.56C14.7,7.6 15.09,7.92 15.22,8.37L16.29,12H18.5V14H16.29L14.73,19.22C14.54,19.86 13.94,20.3 13.26,20.3H11V19.93M15.42,17.9L16.2,15.31C16.32,14.89 16.71,14.61 17.15,14.61H20.08C20.03,15.42 19.88,16.19 19.64,16.91L17.55,18.06C16.85,18.45 15.96,18.39 15.31,17.93C15.35,17.92 15.39,17.91 15.42,17.9Z"/></svg>
              {%- when 'heart' -%}
                <svg viewBox="0 0 24 24"><path d="M12,21.35L10.55,20.03C5.4,15.36 2,12.27 2,8.5C2,5.41 4.42,3 7.5,3C9.24,3 10.91,3.81 12,5.08C13.09,3.81 14.76,3 16.5,3C19.58,3 22,5.41 22,8.5C22,12.27 18.6,15.36 13.45,20.03L12,21.35Z"/></svg>
              {%- else -%}
                <svg viewBox="0 0 24 24"><path d="M12,2L14.8,9.2L22,12L14.8,14.8L12,22L9.2,14.8L2,12L9.2,9.2L12,2Z"/></svg>
            {%- endcase -%}
          {%- endif -%}
        </div>

        <h3 class="hp22-usp__item-title">{{ block.settings.title | escape }}</h3>
        <p class="hp22-usp__item-text">{{ block.settings.text | escape }}</p>

      </div>
    {%- endfor -%}
  </div>

</div>

{% schema %}
{
  "name": "HP22 - Organic USP",
  "class": "section-hp22-usp",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "OUR PROMISE"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Heading",
      "default": "<p>Rooted in <em>Nature</em></p>"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1200
    },
    {
      "type": "range",
      "id": "header_margin",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Margin Below Header",
      "default": 60
    },
    {
      "type": "range",
      "id": "desktop_columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Desktop Columns",
      "default": 4
    },
    {
      "type": "range",
      "id": "tablet_columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Tablet Columns",
      "default": 2
    },
    {
      "type": "range",
      "id": "mobile_columns",
      "min": 1,
      "max": 2,
      "step": 1,
      "label": "Mobile Columns",
      "default": 1
    },
    {
      "type": "range",
      "id": "gap",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Gap between items",
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "min": 20,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Mobile Gap",
      "default": 40
    },
    {
      "type": "header",
      "content": "Icon Settings"
    },
    {
      "type": "select",
      "id": "icon_shape",
      "label": "Icon Background Shape",
      "options": [
        { "value": "circle", "label": "Circle" },
        { "value": "leaf", "label": "Leaf (Top-Left & Bottom-Right Rounded)" },
        { "value": "blob", "label": "Organic Blob (Animated)" },
        { "value": "soft", "label": "Soft Square" }
      ],
      "default": "blob"
    },
    {
      "type": "range",
      "id": "icon_box_size",
      "min": 60,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "Icon Box Size",
      "default": 80
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Icon SVG Size",
      "default": 32
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Section Heading Size",
      "default": 42
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Section Subtitle Size",
      "default": 12
    },
    {
      "type": "range",
      "id": "item_title_size",
      "min": 16,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Item Title Size",
      "default": 20
    },
    {
      "type": "range",
      "id": "item_text_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Item Text Size",
      "default": 15
    },
    {
      "type": "header",
      "content": "Organic Styling"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#F9F6F0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#3A3A3A"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#8A9A86"
    },
    {
      "type": "color",
      "id": "icon_bg",
      "label": "Icon Background Color",
      "default": "rgba(138, 154, 134, 0.1)"
    },
    {
      "type": "checkbox",
      "id": "show_grain",
      "label": "Show subtle paper grain texture",
      "default": true
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "usp",
      "name": "USP Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "leaf", "label": "Leaf" },
            { "value": "flower", "label": "Flower" },
            { "value": "earth", "label": "Earth" },
            { "value": "heart", "label": "Heart" },
            { "value": "star", "label": "Star" }
          ],
          "default": "leaf"
        },
        {
          "type": "html",
          "id": "custom_svg",
          "label": "Custom SVG Code",
          "info": "Overrides the icon dropdown if provided."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Pure Botanicals"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Sourced ethically from organic farms around the globe."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP22 - Organic USP",
      "blocks": [
        { "type": "usp", "settings": { "icon": "leaf", "title": "Vegan & Cruelty Free" } },
        { "type": "usp", "settings": { "icon": "flower", "title": "Natural Extracts" } },
        { "type": "usp", "settings": { "icon": "earth", "title": "Sustainable Practices" } },
        { "type": "usp", "settings": { "icon": "heart", "title": "Dermatologist Tested" } }
      ]
    }
  ]
}
{% endschema %}
