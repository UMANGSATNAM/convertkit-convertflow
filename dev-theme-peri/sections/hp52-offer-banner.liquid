{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp52-offer-bg: #2D3B2D;
    
    background: var(--hp52-offer-bg);
    color: #FFFDF9;
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
    text-align: center;
    border-radius: 30px;
    margin: 40px auto;
    max-width: {{ section.settings.container_width | default: 1240 }}px;
  }

  .hp52-offer__box {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp52-offer__pill {
    display: inline-block;
    padding: 6px 20px;
    background: rgba(255, 253, 249, 0.15);
    border-radius: 50px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    color: #FFFDF9;
    margin-bottom: 20px;
    text-transform: uppercase;
  }

  .hp52-offer__title {
    font-family: 'Bodoni Moda', serif;
    font-size: clamp(32px, 5vw, 46px);
    font-weight: 700;
    line-height: 1.15;
    margin: 0 0 16px;
  }

  .hp52-offer__desc {
    font-size: 16px;
    line-height: 1.8;
    color: #C7D4C7;
    margin: 0 auto 30px;
    max-width: 580px;
  }

  .hp52-offer__code-wrap {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background: rgba(0, 0, 0, 0.25);
    border: 1px dashed rgba(255, 253, 249, 0.4);
    border-radius: 8px;
    padding: 10px 24px;
    margin-bottom: 30px;
  }

  .hp52-offer__code {
    font-family: 'Jost', sans-serif;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 2px;
    color: #FFFDF9;
  }

  .hp52-offer__btn {
    display: inline-flex;
    padding: 16px 36px;
    background: #C2593F;
    color: #FFFDF9;
    font-family: 'Jost', sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 8px;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
    transition: all 0.25s ease;
  }

  .hp52-offer__btn:hover {
    background: #A94B34;
    transform: translateY(-2px);
  }
{%- endstyle -%}

<div class="hp52-offer__box">
  <span class="hp52-offer__pill">{{ section.settings.badge | default: 'TUSCAN VILLA PRIVILEGE' }}</span>
  <h2 class="hp52-offer__title">{{ section.settings.heading | default: 'Enjoy 20% Privilege on Your Mediterranean Ritual' }}</h2>
  <p class="hp52-offer__desc">
    {{ section.settings.description | default: 'Experience the restorative power of cold-pressed Tuscan olive squalane and Sicilian clay. Apply code at checkout.' }}
  </p>

  <div class="hp52-offer__code-wrap">
    <span class="hp52-offer__code">CODE: {{ section.settings.promo_code | default: 'TUSCANY20' }}</span>
  </div>

  <div>
    <a href="{{ section.settings.btn_url | default: '/collections/all' }}" class="hp52-offer__btn">
      {{ section.settings.btn_text | default: 'Claim Villa Privilege &rarr;' }}
    </a>
  </div>
</div>

{% schema %}
{
  "name": "HP52 - Terra Offer",
  "class": "section-hp52-offer",
  "settings": [
    { "type": "text", "id": "badge", "label": "Badge", "default": "TUSCAN VILLA PRIVILEGE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Enjoy 20% Privilege on Your Mediterranean Ritual" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Experience the restorative power of cold-pressed Tuscan olive squalane." },
    { "type": "text", "id": "promo_code", "label": "Promo Code", "default": "TUSCANY20" },
    { "type": "text", "id": "btn_text", "label": "Button Text", "default": "Claim Villa Privilege →" },
    { "type": "url", "id": "btn_url", "label": "Button URL" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 5, "unit": "px", "label": "Padding Top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 5, "unit": "px", "label": "Padding Bottom", "default": 80 },
    { "type": "range", "id": "container_width", "min": 800, "max": 1400, "step": 20, "unit": "px", "label": "Container Width", "default": 1240 }
  ],
  "presets": [
    { "name": "HP52 - Terra Offer" }
  ]
}
{% endschema %}
