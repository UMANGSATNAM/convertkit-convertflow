{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#ffffff'
  assign text_color = section.settings.text_color | default: '#000000'
  assign heading = section.settings.heading | default: 'ICONS'
  assign collection = collections[section.settings.collection]
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 120px 0 120px 20px;
    color: {{ text_color }};
    overflow: hidden;
  }
  
  .hp8-best-container-{{ section_id }} {
    max-width: 1600px;
    margin: 0 auto;
    position: relative;
  }
  
  .hp8-best-header-{{ section_id }} {
    margin-bottom: 60px;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    padding-right: 20px;
  }
  
  .hp8-best-header-{{ section_id }} h2 {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 4px;
    text-transform: uppercase;
    margin: 0;
  }
  
  .hp8-best-slider-{{ section_id }} {
    display: flex;
    gap: 30px;
    overflow-x: auto;
    padding-bottom: 40px;
    scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none;  /* IE and Edge */
    scroll-snap-type: x mandatory;
  }
  
  .hp8-best-slider-{{ section_id }}::-webkit-scrollbar {
    display: none;
  }
  
  .hp8-best-card-{{ section_id }} {
    flex: 0 0 calc(25% - 22.5px); /* Show 4 items by default */
    scroll-snap-align: start;
    text-decoration: none;
    color: inherit;
    display: block;
  }
  
  .hp8-best-image-wrapper-{{ section_id }} {
    aspect-ratio: 2/3;
    background-color: #f0f0f0;
    margin-bottom: 20px;
    overflow: hidden;
  }
  
  .hp8-best-image-{{ section_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s ease;
  }
  
  .hp8-best-card-{{ section_id }}:hover .hp8-best-image-{{ section_id }} {
    transform: scale(1.05);
  }
  
  .hp8-best-title-{{ section_id }} {
    font-family: 'Bodoni MT', 'Didot', 'Playfair Display', serif;
    font-size: 1.25rem;
    font-weight: 400;
    margin: 0 0 5px 0;
  }
  
  .hp8-best-price-{{ section_id }} {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.9rem;
    font-weight: 500;
  }
  
  /* Progress Bar for slider */
  .hp8-slider-progress-{{ section_id }} {
    width: calc(100% - 20px);
    height: 1px;
    background-color: rgba({{ text_color | color_to_rgb | remove: 'rgb(' | remove: ')' }}, {{ 0.2 }});
    margin-top: 20px;
    position: relative;
  }
  
  .hp8-slider-progress-bar-{{ section_id }} {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 25%;
    background-color: {{ text_color }};
    transition: left 0.3s ease;
  }

  @media (max-width: 1200px) {
    .hp8-best-card-{{ section_id }} {
      flex: 0 0 calc(33.333% - 20px);
    }
    .hp8-slider-progress-bar-{{ section_id }} {
      width: 33.333%;
    }
  }
  
  @media (max-width: 768px) {
    .hp8-best-card-{{ section_id }} {
      flex: 0 0 calc(60% - 15px);
      gap: 15px;
    }
    .hp8-slider-progress-bar-{{ section_id }} {
      width: 50%;
    }
  }
</style>

<div class="hp8-best-container-{{ section_id }}">
  <div class="hp8-best-header-{{ section_id }}">
    <h2>{{ heading }}</h2>
  </div>
  
  <div class="hp8-best-slider-{{ section_id }}" id="slider-{{ section_id }}">
    {% if collection != blank and collection.products_count > 0 %}
      {% for product in collection.products limit: 8 %}
        <a href="{{ product.url }}" class="hp8-best-card-{{ section_id }}">
          <div class="hp8-best-image-wrapper-{{ section_id }}">
            <img src="{{ product.featured_image | image_url: width: 600, height: 900, crop: 'center' }}" alt="{{ product.title }}" class="hp8-best-image-{{ section_id }}" loading="lazy" width="400" height="600">
          </div>
          <h3 class="hp8-best-title-{{ section_id }}">{{ product.title }}</h3>
          <div class="hp8-best-price-{{ section_id }}">{{ product.price | money }}</div>
        </a>
      {% endfor %}
    {% else %}
      {% for i in (1..6) %}
        <a href="#" class="hp8-best-card-{{ section_id }}">
          <div class="hp8-best-image-wrapper-{{ section_id }}">
            <div style="width:100%; height:100%; background:#e0e0e0; display:flex; align-items:center; justify-content:center; color:#999;">ICON {{ i }}</div>
          </div>
          <h3 class="hp8-best-title-{{ section_id }}">SIGNATURE PIECE</h3>
          <div class="hp8-best-price-{{ section_id }}">$1,200.00</div>
        </a>
      {% endfor %}
    {% endif %}
  </div>
  
  <div class="hp8-slider-progress-{{ section_id }}">
    <div class="hp8-slider-progress-bar-{{ section_id }}" id="progress-{{ section_id }}"></div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const slider = document.getElementById('slider-{{ section_id }}');
    const progressBar = document.getElementById('progress-{{ section_id }}');
    
    if(slider && progressBar) {
      slider.addEventListener('scroll', () => {
        const scrollPercent = (slider.scrollLeft / (slider.scrollWidth - slider.clientWidth)) * 100;
        // Adjust width based on items visible
        const visibleRatio = slider.clientWidth / slider.scrollWidth;
        const barWidth = visibleRatio * 100;
        
        // Calculate max left position
        const maxLeft = 100 - barWidth;
        const leftPos = (scrollPercent * maxLeft) / 100;
        
        progressBar.style.width = `${barWidth}%`;
        progressBar.style.left = `${leftPos}%`;
      });
      
      // Trigger once on load
      slider.dispatchEvent(new Event('scroll'));
    }
  });
</script>

{% schema %}
{
  "name": "HP8 Bestsellers",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "ICONS"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    }
  ],
  "presets": [
    {
      "name": "HP8 Bestsellers"
    }
  ]
}
{% endschema %}
