{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#FFFFFF'
  assign text_color = section.settings.text_color | default: '#000000'
-%}

<style>
  :root { --border-color: {{ s.border_color }}; }

  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 3px solid #000000;
    box-shadow: 0 4px 0 #000000;
  }
  
  .hp11-header-container-{{ section_id }} {
    max-width: 1400px;
    margin: 0 auto;
    padding: 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  .hp11-header-nav-{{ section_id }} {
    display: flex;
    gap: 30px;
  }
  
  .hp11-header-nav-link-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: 1.1rem;
    color: {{ text_color }};
    text-decoration: none;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.5px;
    padding: 5px 10px;
    border: 2px solid transparent;
    transition: all 0.2s;
  }
  
  .hp11-header-nav-link-{{ section_id }}:hover {
    background-color: #FF00FF;
    color: #FFF;
    border-color: #000;
    box-shadow: 2px 2px 0 #000;
  }
  
  .hp11-header-logo-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: 2.5rem;
    font-weight: 900;
    color: {{ text_color }};
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: -2px;
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    text-shadow: 3px 3px 0 #CCFF00, 4px 4px 0 #000;
  }
  
  .hp11-header-icons-{{ section_id }} {
    display: flex;
    gap: 15px;
    align-items: center;
  }
  
  .hp11-header-icon-{{ section_id }} {
    color: {{ text_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 2px solid #000;
    background: #FFF;
    box-shadow: 3px 3px 0 #000;
    transition: all 0.2s;
  }
  
  .hp11-header-icon-{{ section_id }} svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.5;
  }
  
  .hp11-header-icon-{{ section_id }}:hover {
    background: #CCFF00;
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0 #000;
  }
  
  .hp11-header-icon-{{ section_id }}:active {
    transform: translate(2px, 2px);
    box-shadow: 1px 1px 0 #000;
  }
  
  @media (max-width: 768px) {
    .hp11-header-nav-{{ section_id }} {
      display: none;
    }
    .hp11-header-logo-{{ section_id }} {
      position: static;
      transform: none;
      font-size: 2rem;
    }
    .hp11-header-menu-btn-{{ section_id }} {
      display: block;
    }
  }
  
  @media (min-width: 769px) {
    .hp11-header-menu-btn-{{ section_id }} {
      display: none;
    }
  }
</style>

<div class="hp11-header-container-{{ section_id }}">
  <div class="hp11-header-menu-btn-{{ section_id }}">
    <a href="#" class="hp11-header-icon-{{ section_id }}">
      <svg viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round"/></svg>
    </a>
  </div>

  <nav class="hp11-header-nav-{{ section_id }}">
    {% for link in linklists.main-menu.links limit: 3 %}
      <a href="{{ link.url }}" class="hp11-header-nav-link-{{ section_id }}">{{ link.title }}</a>
    {% else %}
      {%- assign cf_menu = section.settings.menu | default: linklists['main-menu'] -%}

      {%- if cf_menu == blank -%}{%- assign cf_menu = linklists['main-menu'] -%}{%- endif -%}

      {%- for link in cf_menu.links -%}

        <a href="{{ link.url }}" class="hp11-header-nav-link-{{ section_id }}">{{ link.title }}</a>

      {%- endfor -%}
    {% endfor %}
  </nav>
  
  <a href="/" class="hp11-header-logo-{{ section_id }}">
    {{ shop.name | default: 'STREET' }}
  </a>
  
  <div class="hp11-header-icons-{{ section_id }}">
    <a href="/search" class="hp11-header-icon-{{ section_id }}">
      <svg viewBox="0 0 24 24"><path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </a>
    <a href="/account" class="hp11-header-icon-{{ section_id }}">
      <svg viewBox="0 0 24 24"><path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </a>
    {% render 'search-bar', compact: true %}
    {% render 'wishlist-icon' %}
    <a href="/cart" data-cart-open class="hp11-header-icon-{{ section_id }}">
      <svg viewBox="0 0 24 24"><path d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </a>
  </div>
</div>

{% schema %}
{
  "name": "HP11 Header",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation menu",
      "info": "Leave empty to use the store's main menu.",
      "default": "main-menu"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_mobile",
      "label": "Mobile padding",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border colour",
      "default": "#E5E7EB"
    },
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Falls back to the store name when empty."
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 60,
      "max": 260,
      "step": 10,
      "unit": "px",
      "default": 120
    },
    {
      "type": "header",
      "content": "Behaviour"
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "Stick to the top on scroll",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show account link",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cart",
      "label": "Show cart",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "HP11 Header"
    }
  ]
}
{% endschema %}
