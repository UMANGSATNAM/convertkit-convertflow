{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp46-ugc-bg: {{ section.settings.bg_color | default: '#0B0F19' }};
    
    background-color: var(--hp46-ugc-bg);
    padding-top: {{ section.settings.padding_top | default: 70 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 70 }}px;
  }

  .hp46-ugc__wrap {
    max-width: {{ section.settings.container_width | default: 1240 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp46-ugc__header {
    text-align: center;
    margin-bottom: 40px;
  }

  .hp46-ugc__heading {
    font-family: 'Syne', sans-serif;
    font-size: clamp(26px, 3.5vw, 36px);
    font-weight: 800;
    color: #FFFFFF;
    margin: 0;
  }

  .hp46-ugc__heading span {
    background: linear-gradient(135deg, #38BDF8, #F472B6);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hp46-ugc__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: 4 }}, 1fr);
    gap: 18px;
  }

  .hp46-ugc__card {
    aspect-ratio: 9/16;
    border-radius: 22px;
    overflow: hidden;
    position: relative;
    border: 1px solid rgba(56, 189, 248, 0.25);
    background: #0F172A;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
  }

  .hp46-ugc__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .hp46-ugc__card:hover .hp46-ugc__img { transform: scale(1.06); }

  .hp46-ugc__overlay {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    padding: 18px;
    background: linear-gradient(to top, rgba(11, 15, 25, 0.9), transparent);
    color: #FFFFFF;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
  }

  .hp46-ugc__handle {
    font-size: 13px;
    font-weight: 700;
    margin: 0 0 2px;
  }

  .hp46-ugc__tag {
    font-size: 11px;
    color: #38BDF8;
    margin: 0;
  }

  @media screen and (max-width: 992px) {
    .hp46-ugc__grid { grid-template-columns: repeat(2, 1fr); }
  }
{%- endstyle -%}

<div class="hp46-ugc__wrap">
  <div class="hp46-ugc__header">
    <h2 class="hp46-ugc__heading">CYBER COMMUNITY <span>FEED</span></h2>
  </div>

  <div class="hp46-ugc__grid">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <div class="hp46-ugc__card" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 600 }}" class="hp46-ugc__img" alt="{{ block.settings.handle }}" loading="lazy">
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'hp46-ugc__img' }}
          {%- endif -%}
          <div class="hp46-ugc__overlay">
            <div>
              <p class="hp46-ugc__handle">{{ block.settings.handle | default: '@CYBER_GLOW' }}</p>
              <p class="hp46-ugc__tag">{{ block.settings.tag | default: '#HolographicGlow' }}</p>
            </div>
            <span>▶</span>
          </div>
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="hp46-ugc__card">
        {{ 'lifestyle-2' | placeholder_svg_tag: 'hp46-ugc__img' }}
        <div class="hp46-ugc__overlay">
          <div><p class="hp46-ugc__handle">@cyber_vibe</p><p class="hp46-ugc__tag">#HolographicGlow</p></div>
          <span>▶</span>
        </div>
      </div>
      <div class="hp46-ugc__card">
        {{ 'lifestyle-2' | placeholder_svg_tag: 'hp46-ugc__img' }}
        <div class="hp46-ugc__overlay">
          <div><p class="hp46-ugc__handle">@neon_skin</p><p class="hp46-ugc__tag">#GlazeBalm</p></div>
          <span>▶</span>
        </div>
      </div>
      <div class="hp46-ugc__card">
        {{ 'lifestyle-2' | placeholder_svg_tag: 'hp46-ugc__img' }}
        <div class="hp46-ugc__overlay">
          <div><p class="hp46-ugc__handle">@y2k_aesthetic</p><p class="hp46-ugc__tag">#CyberRadiance</p></div>
          <span>▶</span>
        </div>
      </div>
      <div class="hp46-ugc__card">
        {{ 'lifestyle-2' | placeholder_svg_tag: 'hp46-ugc__img' }}
        <div class="hp46-ugc__overlay">
          <div><p class="hp46-ugc__handle">@tokyo_glow</p><p class="hp46-ugc__tag">#CryoJelly</p></div>
          <span>▶</span>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP46 - Cyber UGC",
  "class": "section-hp46-ugc",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#0B0F19" },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "label": "Desktop Columns", "default": 4 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 70 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 70 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1240 }
  ],
  "blocks": [
    {
      "type": "reel",
      "name": "Reel Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "handle", "label": "Handle", "default": "@CYBER_GLOW" },
        { "type": "text", "id": "tag", "label": "Tag", "default": "#HolographicGlow" }
      ]
    }
  ],
  "presets": [
    { "name": "HP46 - Cyber UGC" }
  ]
}
{% endschema %}
