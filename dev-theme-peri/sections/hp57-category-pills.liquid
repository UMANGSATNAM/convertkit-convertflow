{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#0F291E' }};
    padding: {{ section.settings.padding_vertical | default: 35 }}px 0;
  }
  .hp57-pills__container { max-width: 1280px; margin: 0 auto; padding: 0 24px; }
  .hp57-pills__scroll { display: flex; gap: 12px; overflow-x: auto; scrollbar-width: none; justify-content: center; flex-wrap: wrap; }
  .hp57-pills__scroll::-webkit-scrollbar { display: none; }
  .hp57-pills__pill {
    display: inline-flex; align-items: center; gap: 8px; padding: 10px 22px;
    background: {{ section.settings.pill_bg | default: '#1B4332' }};
    border: 1px solid rgba(167, 243, 208, 0.2); border-radius: 6px;
    font-family: 'Plus Jakarta Sans', sans-serif; font-size: 13px; font-weight: 600;
    color: {{ section.settings.pill_text | default: '#F4F6F0' }};
    text-decoration: none; white-space: nowrap; transition: all 0.3s ease;
  }
  .hp57-pills__pill:hover { background: #D97706; color: #0F291E; border-color: #D97706; }
  @media screen and (max-width: 768px) { .hp57-pills__scroll { justify-content: flex-start; flex-wrap: nowrap; } }
{%- endstyle -%}
<div class="hp57-pills__container">
  <div class="hp57-pills__scroll">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.url | default: '#' }}" class="hp57-pills__pill" {{ block.shopify_attributes }}>
        {%- if block.settings.icon != blank -%}<span>{{ block.settings.icon }}</span>{%- endif -%}
        <span>{{ block.settings.label | default: 'Category' }}</span>
      </a>
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "HP57 Categories",
  "class": "section-hp57-pills",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#0F291E" },
    { "type": "color", "id": "pill_bg", "label": "Pill BG", "default": "#1B4332" },
    { "type": "color", "id": "pill_text", "label": "Pill Text", "default": "#F4F6F0" },
    { "type": "range", "id": "padding_vertical", "min": 10, "max": 60, "step": 5, "unit": "px", "label": "Padding", "default": 35 }
  ],
  "blocks": [{ "type": "pill", "name": "Category", "settings": [
    { "type": "text", "id": "icon", "label": "Icon", "default": "🌿" },
    { "type": "text", "id": "label", "label": "Label", "default": "Herbal Tinctures" },
    { "type": "url", "id": "url", "label": "URL" }
  ]}],
  "presets": [{ "name": "HP57 Categories", "blocks": [
    { "type": "pill", "settings": { "icon": "🌿", "label": "Fern Lipids" } },
    { "type": "pill", "settings": { "icon": "🌼", "label": "Calendula Balms" } },
    { "type": "pill", "settings": { "icon": "🌱", "label": "Macerated Oils" } },
    { "type": "pill", "settings": { "icon": "🧪", "label": "Apothecary Elixirs" } },
    { "type": "pill", "settings": { "icon": "🍵", "label": "Infused Mists" } }
  ]}]
}
{% endschema %}
