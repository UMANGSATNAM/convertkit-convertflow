{%- style -%}
  #shopify-section-{{ section.id }} {
    background: radial-gradient(circle at 50% 50%, #450A0A 0%, #09090B 100%);
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
    border-top: 1px solid rgba(239, 68, 68, 0.25);
  }
  .hp61-news__container { max-width: {{ section.settings.container_width | default: 700 }}px; margin: 0 auto; padding: 0 24px; text-align: center; }
  .hp61-news__eyebrow { font-family: 'Space Grotesk', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: #EF4444; margin: 0 0 16px; }
  .hp61-news__heading { font-family: 'Syne', sans-serif; font-size: clamp(28px, 4vw, 44px); font-weight: 800; color: #FFFFFF; margin: 0 0 16px; }
  .hp61-news__desc { font-size: 15px; line-height: 1.7; color: #A1A1AA; margin: 0 0 32px; }
  .hp61-news__form { display: flex; gap: 12px; max-width: 480px; margin: 0 auto; }
  .hp61-news__input {
    flex: 1; padding: 15px 22px; background: #18181B; border: 1px solid rgba(239, 68, 68, 0.35);
    border-radius: 4px; color: #FFFFFF; font-family: 'Space Grotesk', sans-serif; font-size: 14px;
  }
  .hp61-news__input::placeholder { color: rgba(161, 161, 170, 0.6); }
  .hp61-news__btn {
    padding: 15px 32px; background: {{ section.settings.btn_bg | default: '#EF4444' }};
    color: #FFFFFF; border: none; border-radius: 4px; font-family: 'Space Grotesk', sans-serif;
    font-size: 13px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase;
    cursor: pointer; transition: all 0.3s ease; box-shadow: 0 4px 20px rgba(239, 68, 68, 0.4);
  }
  .hp61-news__btn:hover { box-shadow: 0 8px 30px rgba(239, 68, 68, 0.7); transform: translateY(-2px); }
  @media screen and (max-width: 480px) { .hp61-news__form { flex-direction: column; } }
{%- endstyle -%}
<div class="hp61-news__container">
  {%- if section.settings.eyebrow != blank -%}<p class="hp61-news__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
  <h2 class="hp61-news__heading">{{ section.settings.heading | default: 'Geothermal Chamber Access' }}</h2>
  <p class="hp61-news__desc">{{ section.settings.description | default: 'Subscribe to receive private harvest releases from Icelandic volcanic vents, mineral analysis updates, and member privileges.' }}</p>
  {%- form 'customer', id: 'hp61-newsletter' -%}
    <input type="hidden" name="contact[tags]" value="newsletter">
    <div class="hp61-news__form">
      <input type="email" name="contact[email]" class="hp61-news__input" placeholder="{{ section.settings.placeholder | default: 'Your email address' }}" required>
      <button type="submit" class="hp61-news__btn">{{ section.settings.btn_label | default: 'Join Chamber' }}</button>
    </div>
  {%- endform -%}
</div>
{% schema %}
{
  "name": "HP61 Newsletter",
  "class": "section-hp61-news",
  "settings": [
    { "type": "color", "id": "btn_bg", "label": "Button BG", "default": "#EF4444" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "🌋 GEOTHERMAL ACCESS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Geothermal Chamber Access" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Subscribe to receive private harvest releases from volcanic vents." },
    { "type": "text", "id": "placeholder", "label": "Placeholder", "default": "Your email address" },
    { "type": "text", "id": "btn_label", "label": "Button Label", "default": "Join Chamber" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 500, "max": 900, "step": 20, "unit": "px", "label": "Container Width", "default": 700 }
  ],
  "presets": [{ "name": "HP61 Newsletter" }]
}
{% endschema %}
