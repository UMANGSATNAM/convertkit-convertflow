{%- style -%}
  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --border-color: #000000;
    --border-width: 3px;
    --shadow-offset: 6px;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    border-bottom: var(--border-width) solid var(--border-color);
    font-family: 'Space Grotesk', 'Outfit', sans-serif;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }

  .hp23-bestsellers-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    gap: 40px;
    align-items: flex-start;
  }

  @media screen and (max-width: 992px) {
    .hp23-bestsellers-wrapper {
      flex-direction: column;
      gap: 30px;
    }
  }

  @media screen and (max-width: 768px) {
    .hp23-bestsellers-wrapper {
      padding: 0 20px;
    }
  }

  .hp23-bestsellers__sidebar {
    flex: 0 0 35%;
    position: sticky;
    top: 40px;
    background: #ffffff;
    border: var(--border-width) solid var(--border-color);
    box-shadow: var(--shadow-offset) var(--shadow-offset) 0 var(--border-color);
    padding: 40px;
    border-radius: {{ section.settings.border_radius }}px;
    display: flex;
    flex-direction: column;
  }

  @media screen and (max-width: 992px) {
    .hp23-bestsellers__sidebar {
      position: relative;
      top: 0;
      flex: 1 1 100%;
      width: 100%;
      padding: 30px;
    }
  }

  .hp23-bestsellers__title {
    font-size: clamp(40px, 6vw, {{ section.settings.title_size }}px);
    font-weight: 900;
    color: var(--text-color);
    margin: 0 0 20px;
    line-height: 1.1;
    text-transform: uppercase;
    letter-spacing: -1px;
  }
  
  .hp23-bestsellers__title em {
    font-style: normal;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--text-color);
  }

  .hp23-bestsellers__text {
    font-family: var(--font-body);
    font-size: {{ section.settings.text_size }}px;
    font-weight: 500;
    line-height: 1.5;
    margin: 0 0 30px;
  }

  .hp23-bestsellers__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 24px;
    background: var(--text-color);
    color: #ffffff;
    font-weight: 800;
    font-size: 14px;
    text-transform: uppercase;
    text-decoration: none;
    border: var(--border-width) solid var(--border-color);
    border-radius: {{ section.settings.border_radius }}px;
    box-shadow: 4px 4px 0 var(--border-color);
    transition: all 0.2s ease;
    align-self: flex-start;
  }

  .hp23-bestsellers__btn:hover {
    background: var(--accent-color);
    color: var(--text-color);
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0 var(--border-color);
  }

  .hp23-bestsellers__grid {
    flex: 1;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 30px;
  }

  @media screen and (max-width: 600px) {
    .hp23-bestsellers__grid {
      grid-template-columns: 1fr;
      width: 100%;
    }
  }

  /* Product Card */
  .hp23-best-card {
    background: #ffffff;
    border: var(--border-width) solid var(--border-color);
    border-radius: {{ section.settings.border_radius }}px;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-offset) var(--shadow-offset) 0 var(--border-color);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    text-decoration: none;
    color: var(--text-color);
    overflow: hidden;
    position: relative;
  }

  .hp23-best-card:hover {
    transform: translate(2px, 2px);
    box-shadow: calc(var(--shadow-offset) - 2px) calc(var(--shadow-offset) - 2px) 0 var(--border-color);
  }

  .hp23-best-card__rank {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 40px;
    height: 40px;
    background: var(--accent-color);
    border: 2px solid var(--border-color);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 900;
    font-size: 18px;
    z-index: 2;
    box-shadow: 2px 2px 0 var(--border-color);
  }

  .hp23-best-card__image-wrapper {
    position: relative;
    aspect-ratio: 1/1;
    background: #f4f4f4;
    border-bottom: var(--border-width) solid var(--border-color);
    overflow: hidden;
  }

  .hp23-best-card__image {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  
  .hp23-best-card:hover .hp23-best-card__image {
    transform: scale(1.05);
  }

  .hp23-best-card__info {
    padding: 20px;
    display: flex;
    flex-direction: column;
    flex: 1;
    background: #ffffff;
  }

  .hp23-best-card__title {
    font-size: 16px;
    font-weight: 800;
    margin: 0 0 8px;
    text-transform: uppercase;
    letter-spacing: -0.5px;
  }

  .hp23-best-card__price-wrapper {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 20px;
    font-weight: 700;
    font-size: 15px;
  }

  .hp23-best-card__price--regular {
    text-decoration: line-through;
    opacity: 0.6;
  }

  .hp23-best-card__btn {
    margin-top: auto;
    width: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px;
    background: transparent;
    color: var(--text-color);
    font-family: inherit;
    font-weight: 800;
    font-size: 12px;
    text-transform: uppercase;
    border: 2px solid var(--border-color);
    box-shadow: 3px 3px 0 var(--border-color);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .hp23-best-card__btn:hover {
    background: var(--accent-color);
    transform: translate(1px, 1px);
    box-shadow: 2px 2px 0 var(--border-color);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp23-bestsellers-wrapper" id="HP23Bestsellers-{{ section.id }}">
  
  <div class="hp23-bestsellers__sidebar">
    {%- if section.settings.title != blank -%}
      <h2 class="hp23-bestsellers__title">{{ section.settings.title }}</h2>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <p class="hp23-bestsellers__text">{{ section.settings.text | escape }}</p>
    {%- endif -%}

    {%- if section.settings.btn_text != blank -%}
      <a href="{{ section.settings.btn_link | default: '#' }}" class="hp23-bestsellers__btn">
        {{ section.settings.btn_text | escape }}
      </a>
    {%- endif -%}
  </div>

  <div class="hp23-bestsellers__grid">
    {%- assign collection = collections[section.settings.collection] -%}
    {%- assign limit = section.settings.products_to_show -%}
    
    {%- if collection != blank and collection.products_count > 0 -%}
      {%- for product in collection.products limit: limit -%}
        <a href="{{ product.url }}" class="hp23-best-card">
          <div class="hp23-best-card__rank">#{{ forloop.index }}</div>
          <div class="hp23-best-card__image-wrapper">
            <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" class="hp23-best-card__image" loading="lazy">
          </div>
          
          <div class="hp23-best-card__info">
            <h3 class="hp23-best-card__title">{{ product.title }}</h3>
            <div class="hp23-best-card__price-wrapper">
              {%- if product.compare_at_price > product.price -%}
                <span class="hp23-best-card__price--regular">{{ product.compare_at_price | money }}</span>
              {%- endif -%}
              <span class="hp23-best-card__price">{{ product.price | money }}</span>
            </div>
            <button class="hp23-best-card__btn" type="button">ADD TO CART</button>
          </div>
        </a>
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..limit) -%}
        <a href="#" class="hp23-best-card">
          <div class="hp23-best-card__rank">#{{ i }}</div>
          <div class="hp23-best-card__image-wrapper">
            <div style="width:100%;height:100%;background:#e0e0e0;display:flex;align-items:center;justify-content:center;font-weight:bold;">IMG</div>
          </div>
          <div class="hp23-best-card__info">
            <h3 class="hp23-best-card__title">Top Seller {{ i }}</h3>
            <div class="hp23-best-card__price-wrapper">
              <span class="hp23-best-card__price">$45.00</span>
            </div>
            <button class="hp23-best-card__btn" type="button">ADD TO CART</button>
          </div>
        </a>
      {%- endfor -%}
    {%- endif -%}
  </div>

</div>

{% schema %}
{
  "name": "HP23 - Brutalist Bestsell",
  "class": "section-hp23-bestsellers",
  "settings": [
    {
      "type": "header",
      "content": "Sidebar Content"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Heading",
      "default": "<p>CROWD<br><em>FAVORITES</em></p>"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Body Text",
      "default": "The formulas everyone is hoarding. Grab them before they sell out again."
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "SHOP ALL TOP RATED"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 8,
      "step": 2,
      "label": "Products to Show",
      "default": 4
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1400
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Card Border Radius",
      "default": 12
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 32,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 64
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Text Size",
      "default": 16
    },
    {
      "type": "header",
      "content": "Brutalist Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#F4F4F0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#FFEB3B",
      "info": "Try bright red, lime green, or bold yellow"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP23 - Brutalist Bestsell"
    }
  ]
}
{% endschema %}
