{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=JetBrains+Mono:wght@400;600;700&display=swap');

  #shopify-section-{{ section.id }} {
    --hp45-bg: {{ section.settings.bg_color | default: '#F5F5F0' }};
    --hp45-text: {{ section.settings.text_color | default: '#0A0A0A' }};
    --hp45-border: {{ section.settings.border_color | default: '#0A0A0A' }};
    --hp45-btn-bg: {{ section.settings.btn_bg | default: '#0A0A0A' }};
    --hp45-btn-text: {{ section.settings.btn_text_color | default: '#FFFFFF' }};
    
    background-color: var(--hp45-bg);
    color: var(--hp45-text);
    font-family: 'Space Grotesk', sans-serif;
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
    border-bottom: 2px solid var(--hp45-border);
  }

  .hp45-hero__container {
    max-width: {{ section.settings.container_width | default: 1300 }}px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: stretch;
  }

  .hp45-hero__card-left {
    background: #FFFFFF;
    border: 2px solid var(--hp45-border);
    box-shadow: 6px 6px 0 var(--hp45-border);
    padding: 50px 40px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .hp45-hero__mono-tag {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    background: #0A0A0A;
    color: #FFFFFF;
    display: inline-block;
    padding: 6px 12px;
    margin-bottom: 24px;
    align-self: flex-start;
  }

  .hp45-hero__title {
    font-size: clamp(38px, 5.5vw, 64px);
    font-weight: 700;
    line-height: 1.05;
    text-transform: uppercase;
    letter-spacing: -1.5px;
    margin: 0 0 20px;
  }

  .hp45-hero__desc {
    font-family: 'JetBrains Mono', monospace;
    font-size: 14px;
    line-height: 1.65;
    color: #4A4A4A;
    margin: 0 0 32px;
  }

  .hp45-hero__actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  .hp45-hero__btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 36px;
    background: var(--hp45-btn-bg);
    color: var(--hp45-btn-text);
    font-family: 'Space Grotesk', sans-serif;
    font-size: 15px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    text-decoration: none;
    border: 2px solid var(--hp45-border);
    box-shadow: 4px 4px 0 var(--hp45-border);
    transition: all 0.2s ease;
  }

  .hp45-hero__btn-primary:hover {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0 var(--hp45-border);
  }

  .hp45-hero__media-box {
    background: #0A0A0A;
    border: 2px solid var(--hp45-border);
    box-shadow: 6px 6px 0 var(--hp45-border);
    position: relative;
    overflow: hidden;
    min-height: 480px;
  }

  .hp45-hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: grayscale(100%) contrast(120%);
    transition: filter 0.4s ease;
  }

  .hp45-hero__media-box:hover .hp45-hero__img {
    filter: grayscale(0%) contrast(105%);
  }

  .hp45-hero__float-spec {
    position: absolute;
    bottom: 20px;
    left: 20px;
    background: #FFFFFF;
    border: 2px solid #0A0A0A;
    box-shadow: 4px 4px 0 #0A0A0A;
    padding: 12px 18px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    font-weight: 700;
  }

  @media screen and (max-width: 992px) {
    .hp44-hero__container { grid-template-columns: 1fr; }
    .hp45-hero__media-box { min-height: 340px; }
  }

  @media screen and (max-width: 576px) {
    .hp45-hero__card-left { padding: 30px 20px; }
    .hp45-hero__actions { flex-direction: column; }
    .hp45-hero__btn-primary { width: 100%; justify-content: center; }
  }
{%- endstyle -%}

<div class="hp45-hero__container">
  <div class="hp45-hero__card-left">
    <div>
      <span class="hp45-hero__mono-tag">{{ section.settings.badge | default: 'SYSTEM V45 // MONOCHROME' }}</span>
      <h1 class="hp45-hero__title">{{ section.settings.heading | default: 'BRUTALIST DERMAL ARCHITECTURE' }}</h1>
      <p class="hp45-hero__desc">
        {{ section.settings.description | default: 'High-potency clinical molecular synthesis. Zero fillers, zero perfumed noise. Uncompromising elemental efficacy for cellular restoration.' }}
      </p>
    </div>

    <div class="hp45-hero__actions">
      <a href="{{ section.settings.btn_url | default: '/collections/all' }}" class="hp45-hero__btn-primary">
        <span>{{ section.settings.btn_text | default: 'EXPLORE DOSAGE MATRIX' }}</span>
        <span>&rarr;</span>
      </a>
    </div>
  </div>

  <div class="hp45-hero__media-box">
    {%- if section.settings.image != blank -%}
      <img height="{{ section.settings.image.height }}" width="{{ section.settings.image.width }}" src="{{ section.settings.image | image_url: width: 1200 }}" class="hp45-hero__img" alt="{{ section.settings.heading }}" loading="eager">
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'hp45-hero__img' }}
    {%- endif -%}

    <div class="hp45-hero__float-spec">
      [REF: SPEC-45] BIO-ACTIVE LEVEL 99.4%
    </div>
  </div>
</div>

{% schema %}
{
  "name": "HP45 - Brutal Hero",
  "class": "section-hp45-hero",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#F5F5F0" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#0A0A0A" },
    { "type": "color", "id": "border_color", "label": "Border Color", "default": "#0A0A0A" },
    { "type": "color", "id": "btn_bg", "label": "Button Background", "default": "#0A0A0A" },
    { "type": "color", "id": "btn_text_color", "label": "Button Text Color", "default": "#FFFFFF" },
    { "type": "text", "id": "badge", "label": "Badge Label", "default": "SYSTEM V45 // MONOCHROME" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "BRUTALIST DERMAL ARCHITECTURE" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "High-potency clinical molecular synthesis. Zero fillers, zero perfumed noise." },
    { "type": "text", "id": "btn_text", "label": "Button Text", "default": "EXPLORE DOSAGE MATRIX" },
    { "type": "url", "id": "btn_url", "label": "Button URL" },
    { "type": "image_picker", "id": "image", "label": "Hero Image" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1300 }
  ],
  "presets": [
    { "name": "HP45 - Brutal Hero" }
  ]
}
{% endschema %}
