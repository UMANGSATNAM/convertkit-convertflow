{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: "#080B10" }};
    padding: 80px 20px;
  }

  .hp43-usp__grid {
    max-width: 1320px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .hp43-usp__card {
    background: #101622;
    border: 1px solid #1E293B;
    border-radius: 6px;
    padding: 32px 24px;
    position: relative;
    overflow: hidden;
    transition: all 0.3s ease;
  }

  .hp43-usp__card:hover {
    border-color: #00F0FF;
    transform: translateY(-4px);
    box-shadow: 0 10px 30px rgba(0, 240, 255, 0.15);
  }

  .hp43-usp__card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 4px;
    height: 100%;
    background: #00F0FF;
  }

  .hp43-usp__icon {
    font-size: 32px;
    margin-bottom: 20px;
  }

  .hp43-usp__title {
    font-family: 'Orbitron', sans-serif;
    font-size: 18px;
    font-weight: 700;
    color: #F1F5F9;
    margin: 0 0 10px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .hp43-usp__text {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    color: #64748B;
    line-height: 1.6;
    margin: 0;
  }

  @media screen and (max-width: 990px) {
    .hp43-usp__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 580px) {
    .hp43-usp__grid {
      grid-template-columns: 1fr;
    }
  }
{%- endstyle -%}

<div id="hp43-specs" class="hp43-usp__grid">
  <div class="hp43-usp__card">
    <div class="hp43-usp__icon">🛰️</div>
    <h3 class="hp43-usp__title">GLOBAL EXPRESS</h3>
    <p class="hp43-usp__text">Direct customs-cleared air courier dispatch to over 180 countries.</p>
  </div>
  <div class="hp43-usp__card">
    <div class="hp43-usp__icon">⚙️</div>
    <h3 class="hp43-usp__title">AEROSPACE GRADE</h3>
    <p class="hp43-usp__text">Built with carbon composite and anodized alloy chassis for intense durability.</p>
  </div>
  <div class="hp43-usp__card">
    <div class="hp43-usp__icon">🛡️</div>
    <h3 class="hp43-usp__title">2-YR PROTECTION</h3>
    <p class="hp43-usp__text">Comprehensive hardware coverage with instant advance replacement.</p>
  </div>
  <div class="hp43-usp__card">
    <div class="hp43-usp__icon">🔒</div>
    <h3 class="hp43-usp__title">SECURE DISPATCH</h3>
    <p class="hp43-usp__text">256-bit encrypted checkout supporting multicurrency localized payments.</p>
  </div>
</div>

{% schema %}
{
  "name": "HP43 - Cyber Specs USP",
  "class": "section-hp43-usp",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#080B10"
    }
  ],
  "presets": [
    {
      "name": "HP43 - Cyber Specs USP"
    }
  ]
}
{% endschema %}
