{%- comment -%}
  Section: Tech Flagship PDP (Handcrafted)
  Niche: Electronics, Audio, Wearables, Gadgets
  Aesthetics: Slate Dark Mode, Cyber Blue Accents, Tech Spec Grid
{%- endcomment -%}

{%- assign current_variant = product.selected_or_first_available_variant -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');

  .pdp-tech-{{ section.id }} {
    --tech-bg: #0F172A;
    --tech-surface: #1E293B;
    --tech-surface-card: #1E293B;
    --tech-border: #334155;
    --tech-text: #F8FAFC;
    --tech-muted: #94A3B8;
    --tech-blue: #38BDF8;
    --tech-blue-glow: rgba(56, 189, 248, 0.15);
    --tech-font: 'Inter', sans-serif;

    background-color: var(--tech-bg);
    color: var(--tech-text);
    font-family: var(--tech-font);
    padding: 48px 20px;
  }

  .pdp-tech-container {
    max-width: 1240px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
  }

  @media (min-width: 992px) {
    .pdp-tech-container {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 60px;
    }
  }

  /* Gallery */
  .pdp-tech-gallery {
    position: relative;
  }

  .pdp-tech-viewport {
    background: var(--tech-surface);
    border: 1px solid var(--tech-border);
    border-radius: 16px;
    overflow: hidden;
    aspect-ratio: 4/3;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
    box-shadow: 0 20px 40px rgba(0,0,0,0.3);
  }

  .pdp-tech-viewport img {
    max-width: 85%;
    max-height: 85%;
    object-fit: contain;
    transition: transform 0.3s ease;
  }

  .pdp-tech-viewport:hover img {
    transform: scale(1.05);
  }

  .pdp-tech-thumbs {
    display: flex;
    gap: 12px;
  }

  .pdp-tech-thumb {
    width: 72px;
    height: 72px;
    background: var(--tech-surface);
    border: 1.5px solid var(--tech-border);
    border-radius: 10px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6px;
    transition: all 0.2s ease;
  }

  .pdp-tech-thumb.is-active,
  .pdp-tech-thumb:hover {
    border-color: var(--tech-blue);
    box-shadow: 0 0 12px var(--tech-blue-glow);
  }

  .pdp-tech-thumb img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  /* Right Info */
  .pdp-tech-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--tech-blue);
    background: rgba(56, 189, 248, 0.1);
    border: 1px solid rgba(56, 189, 248, 0.3);
    padding: 4px 12px;
    border-radius: 99px;
    margin-bottom: 16px;
  }

  .pdp-tech-title {
    font-size: 32px;
    font-weight: 800;
    line-height: 1.2;
    margin: 0 0 16px 0;
    letter-spacing: -0.02em;
  }

  @media (min-width: 768px) {
    .pdp-tech-title {
      font-size: 40px;
    }
  }

  /* Price Card */
  .pdp-tech-price-card {
    background: var(--tech-surface-card);
    border: 1px solid var(--tech-border);
    border-radius: 14px;
    padding: 20px;
    margin-bottom: 28px;
  }

  .pdp-tech-price-row {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 8px;
  }

  .pdp-tech-price {
    font-size: 34px;
    font-weight: 800;
    color: var(--tech-blue);
  }

  .pdp-tech-compare-price {
    font-size: 18px;
    color: var(--tech-muted);
    text-decoration: line-through;
  }

  .pdp-tech-emi-note {
    font-size: 13px;
    color: var(--tech-muted);
    display: flex;
    align-items: center;
    gap: 6px;
  }

  /* Specs Grid */
  .pdp-tech-specs-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    margin-bottom: 28px;
  }

  .pdp-tech-spec-item {
    background: rgba(30, 41, 59, 0.5);
    border: 1px solid var(--tech-border);
    border-radius: 10px;
    padding: 14px;
  }

  .pdp-tech-spec-label {
    font-size: 12px;
    color: var(--tech-muted);
    margin-bottom: 2px;
  }

  .pdp-tech-spec-val {
    font-size: 14px;
    font-weight: 700;
    color: var(--tech-text);
  }

  /* Color Swatches */
  .pdp-tech-swatch-head {
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--tech-muted);
    margin-bottom: 12px;
  }

  .pdp-tech-swatches {
    display: flex;
    gap: 12px;
    margin-bottom: 32px;
  }

  .pdp-tech-color-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--tech-surface);
    border: 1px solid var(--tech-border);
    padding: 10px 16px;
    border-radius: 10px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 600;
    transition: all 0.2s ease;
  }

  .pdp-tech-color-btn.is-selected,
  .pdp-tech-color-btn:hover {
    border-color: var(--tech-blue);
    background: rgba(56, 189, 248, 0.1);
  }

  .pdp-tech-color-dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
  }

  /* Actions */
  .pdp-tech-atc-btn {
    width: 100%;
    background: var(--tech-blue);
    color: #0F172A;
    font-size: 16px;
    font-weight: 700;
    padding: 18px;
    border: none;
    border-radius: 12px;
    cursor: pointer;
    transition: all 0.25s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    box-shadow: 0 4px 20px var(--tech-blue-glow);
  }

  .pdp-tech-atc-btn:hover {
    background: #FFF;
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(255, 255, 255, 0.2);
  }
</style>

<div class="pdp-tech-{{ section.id }}">
  <div class="pdp-tech-container">
    
    <!-- GALLERY -->
    <div class="pdp-tech-gallery">
      <div class="pdp-tech-viewport">
        {% if product.featured_media %}
          <img id="tech-main-img-{{ section.id }}" src="{{ product.featured_media | image_url: width: 1000 }}" alt="{{ product.title | escape }}" width="1000" height="750">
        {% else %}
          {{ 'product-1' | placeholder_svg_tag }}
        {% endif %}
      </div>

      {% if product.media.size > 1 %}
        <div class="pdp-tech-thumbs">
          {% for media in product.media limit: 4 %}
            <div class="pdp-tech-thumb {% if forloop.first %}is-active{% endif %}" onclick="changeTechImg('{{ media | image_url: width: 1000 }}', this)">
              <img src="{{ media | image_url: width: 200 }}" alt="" width="200" height="200" loading="lazy">
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <!-- INFO -->
    <div class="pdp-tech-info">
      <div class="pdp-tech-badge">⚡ FLAGSHIP EDITION • 1-YEAR WARRANTY</div>

      <h1 class="pdp-tech-title">{{ product.title }}</h1>

      <!-- PRICE CARD -->
      <div class="pdp-tech-price-card">
        <div class="pdp-tech-price-row">
          <span class="pdp-tech-price">{{ current_variant.price | money }}</span>
          {% if current_variant.compare_at_price > current_variant.price %}
            <span class="pdp-tech-compare-price">{{ current_variant.compare_at_price | money }}</span>
          {% endif %}
        </div>
        <div class="pdp-tech-emi-note">
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          No cost EMI starts from ₹499/month. Free Shipping Included.
        </div>
      </div>

      <!-- SPECS GRID -->
      <div class="pdp-tech-specs-grid">
        <div class="pdp-tech-spec-item">
          <div class="pdp-tech-spec-label">Battery Life</div>
          <div class="pdp-tech-spec-val">Up to 40 Hours</div>
        </div>
        <div class="pdp-tech-spec-item">
          <div class="pdp-tech-spec-label">Connectivity</div>
          <div class="pdp-tech-spec-val">Bluetooth 5.3 + ANC</div>
        </div>
        <div class="pdp-tech-spec-item">
          <div class="pdp-tech-spec-label">Charging</div>
          <div class="pdp-tech-spec-val">Fast Charge (10m = 5h)</div>
        </div>
        <div class="pdp-tech-spec-item">
          <div class="pdp-tech-spec-label">Water Resistance</div>
          <div class="pdp-tech-spec-val">IPX5 Certified</div>
        </div>
      </div>

      <!-- COLOR SELECTOR -->
      <div class="pdp-tech-swatch-head">Choose Finish</div>
      <div class="pdp-tech-swatches">
        <div class="pdp-tech-color-btn is-selected" onclick="selectTechColor(this)">
          <div class="pdp-tech-color-dot" style="background:#0F172A; border:1px solid #475569;"></div>
          <span>Matte Black</span>
        </div>
        <div class="pdp-tech-color-btn" onclick="selectTechColor(this)">
          <div class="pdp-tech-color-dot" style="background:#E2E8F0;"></div>
          <span>Silver Metallic</span>
        </div>
      </div>

      <!-- ATC -->
      <button type="button" class="pdp-tech-atc-btn">
        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
        ADD TO CART — {{ current_variant.price | money }}
      </button>

    </div>
  </div>
</div>

<script>
  function changeTechImg(src, thumbEl) {
    const img = document.getElementById('tech-main-img-{{ section.id }}');
    if (img) img.src = src;
    document.querySelectorAll('.pdp-tech-thumb').forEach(t => t.classList.remove('is-active'));
    if (thumbEl) thumbEl.classList.add('is-active');
  }

  function selectTechColor(btnEl) {
    document.querySelectorAll('.pdp-tech-color-btn').forEach(b => b.classList.remove('is-selected'));
    if (btnEl) btnEl.classList.add('is-selected');
  }
</script>

{% schema %}
{
  "name": "Tech Flagship PDP",
  "settings": [],
  "presets": [{ "name": "Tech Flagship PDP" }]
}
{% endschema %}
