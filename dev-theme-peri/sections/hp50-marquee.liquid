{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp50-marq-bg: {{ section.settings.bg_color | default: '#000000' }};
    --hp50-marq-text: {{ section.settings.text_color | default: '#E2E8F0' }};
    
    background: var(--hp50-marq-bg);
    color: var(--hp50-marq-text);
    padding: {{ section.settings.padding_vertical | default: 16 }}px 0;
    overflow: hidden;
    white-space: nowrap;
    border-top: 1px solid rgba(226, 232, 240, 0.2);
    border-bottom: 1px solid rgba(226, 232, 240, 0.2);
  }

  .hp50-marquee__track {
    display: inline-flex;
    gap: 40px;
    animation: hp50-scroll {{ section.settings.speed | default: 22 }}s linear infinite;
    font-family: 'Syne', sans-serif;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 2.5px;
    text-transform: uppercase;
  }

  .hp50-marquee__item {
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }

  @keyframes hp50-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
{%- endstyle -%}

<div class="hp50-marquee__track">
  {%- if section.blocks.size > 0 -%}
    {%- for i in (1..2) -%}
      {%- for block in section.blocks -%}
        <div class="hp50-marquee__item" {{ block.shopify_attributes }}>
          <span>✦</span>
          <span>{{ block.settings.text }}</span>
        </div>
      {%- endfor -%}
    {%- endfor -%}
  {%- else -%}
    {%- for i in (1..2) -%}
      <div class="hp50-marquee__item"><span>✦</span><span>PURE PLATINUM PEPTIDE CONTOUR COMPLEX</span></div>
      <div class="hp50-marquee__item"><span>✦</span><span>HIGH-FASHION EDITORIAL RADIANCE MATRIX</span></div>
      <div class="hp50-marquee__item"><span>✈️</span><span>GLOBAL WHITE-GLOVE DDP AIR COURIER</span></div>
      <div class="hp50-marquee__item"><span>🛡️</span><span>CERTIFIED ZERO-TOLERANCE TOXIN SCREENING</span></div>
    {%- endfor -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "HP50 - Runway Marquee",
  "class": "section-hp50-marquee",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#000000" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#E2E8F0" },
    { "type": "range", "id": "speed", "min": 10, "max": 60, "step": 2, "unit": "s", "label": "Scroll Duration", "default": 22 },
    { "type": "range", "id": "padding_vertical", "min": 8, "max": 40, "step": 2, "unit": "px", "label": "Padding Vertical", "default": 16 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Ticker Item",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "PURE PLATINUM PEPTIDE CONTOUR COMPLEX" }
      ]
    }
  ],
  "presets": [
    { "name": "HP50 - Runway Marquee" }
  ]
}
{% endschema %}
