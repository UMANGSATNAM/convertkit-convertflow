{%- style -%}
  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --border-color: {{ section.settings.border_color }};
    --border-thickness: {{ section.settings.border_thickness }}px;
    --shadow-color: {{ section.settings.shadow_color }};
    --shadow-offset: {{ section.settings.shadow_offset }}px;
    --btn-bg: {{ section.settings.btn_bg }};
    --btn-text: {{ section.settings.btn_text_color }};
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    border-top: var(--border-thickness) solid var(--border-color);
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }

  .hp20-news-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp20-news__container {
    background: {{ section.settings.container_bg }};
    border: var(--border-thickness) solid var(--border-color);
    box-shadow: var(--shadow-offset) var(--shadow-offset) 0px var(--shadow-color);
    padding: {{ section.settings.container_padding }}px;
    text-align: center;
  }

  @media screen and (max-width: 768px) {
    .hp20-news__container {
      padding: 40px 24px;
    }
  }

  .hp20-news__title {
    font-family: 'Inter', sans-serif;
    font-weight: 900;
    font-size: clamp(40px, 8vw, {{ section.settings.title_size }}px);
    line-height: 1;
    color: var(--text-color);
    text-transform: uppercase;
    margin: 0 0 16px;
    letter-spacing: -2px;
  }

  .hp20-news__subtitle {
    font-family: 'Inter', sans-serif;
    font-size: {{ section.settings.text_size }}px;
    font-weight: 500;
    color: var(--text-color);
    margin: 0 0 40px;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .hp20-news__form {
    max-width: 600px;
    margin: 0 auto;
    display: flex;
    flex-direction: {% if section.settings.form_layout == 'inline' %}row{% else %}column{% endif %};
    gap: 16px;
  }

  @media screen and (max-width: 768px) {
    .hp20-news__form {
      flex-direction: column;
    }
  }

  .hp20-news__input-wrap {
    flex: 1;
    position: relative;
  }

  .hp20-news__input {
    width: 100%;
    padding: 16px 24px;
    background: #fff;
    border: var(--border-thickness) solid var(--border-color);
    font-family: 'Inter', sans-serif;
    font-weight: 600;
    font-size: 16px;
    color: #000;
    outline: none;
    box-shadow: inset 4px 4px 0px rgba(0,0,0,0.05);
  }
  
  .hp20-news__input::placeholder {
    color: #999;
    font-weight: 500;
  }
  
  .hp20-news__input:focus {
    border-color: var(--btn-bg);
  }

  .hp20-news__btn {
    padding: 16px 40px;
    background: var(--btn-bg);
    color: var(--btn-text);
    border: var(--border-thickness) solid var(--border-color);
    font-family: 'Inter', sans-serif;
    font-weight: 900;
    font-size: 16px;
    text-transform: uppercase;
    letter-spacing: 1px;
    cursor: pointer;
    box-shadow: 4px 4px 0px var(--shadow-color);
    transition: all 0.1s ease;
    white-space: nowrap;
  }

  .hp20-news__btn:hover {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0px var(--shadow-color);
  }

  .hp20-news__disclaimer {
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 500;
    color: var(--text-color);
    opacity: 0.6;
    margin-top: 24px;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp20-news-wrapper" id="HP20Newsletter-{{ section.id }}">
  <div class="hp20-news__container">
    
    {%- if section.settings.title != blank -%}
      <h2 class="hp20-news__title">{{ section.settings.title | escape }}</h2>
    {%- endif -%}
    
    {%- if section.settings.subtitle != blank -%}
      <p class="hp20-news__subtitle">{{ section.settings.subtitle | escape }}</p>
    {%- endif -%}

    {% form 'customer', class: 'hp20-news__form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      
      {%- if form.posted_successfully? -%}
        <div style="background:var(--btn-bg);color:var(--btn-text);padding:16px;border:var(--border-thickness) solid var(--border-color);font-family:'Inter',sans-serif;font-weight:800;text-transform:uppercase;width:100%;">
          YOU'RE ON THE LIST.
        </div>
      {%- else -%}
        <div class="hp20-news__input-wrap">
          <input 
            type="email" 
            name="contact[email]" 
            class="hp20-news__input" 
            value="{{ form.email }}" 
            placeholder="{{ section.settings.placeholder | escape }}" 
            required>
        </div>
        <button type="submit" class="hp20-news__btn">
          {{ section.settings.btn_text | escape }}
        </button>
      {%- endif -%}
      
      {%- if form.errors -%}
        <div style="color:red;font-family:'Inter',sans-serif;font-weight:700;margin-top:16px;">
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}
    {% endform %}

    {%- if section.settings.disclaimer != blank -%}
      <p class="hp20-news__disclaimer">{{ section.settings.disclaimer | escape }}</p>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "HP20 Brutalist Signup",
  "class": "section-hp20-newsletter",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "JOIN THE CULT."
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Sign up for exclusive drops, early access, and unfiltered updates."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input Placeholder",
      "default": "ENTER YOUR EMAIL"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "SUBSCRIBE"
    },
    {
      "type": "text",
      "id": "disclaimer",
      "label": "Disclaimer Text",
      "default": "By subscribing you agree to our Terms & Conditions."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 800,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1200
    },
    {
      "type": "range",
      "id": "container_padding",
      "min": 40,
      "max": 160,
      "step": 5,
      "unit": "px",
      "label": "Container Padding",
      "default": 100
    },
    {
      "type": "select",
      "id": "form_layout",
      "label": "Form Layout (Desktop)",
      "options": [
        { "value": "inline", "label": "Inline" },
        { "value": "stacked", "label": "Stacked" }
      ],
      "default": "inline"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 40,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 80
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 14,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Subtitle Size",
      "default": 20
    },
    {
      "type": "header",
      "content": "Brutalist Styling"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Outer Background",
      "default": "#F4F4F0"
    },
    {
      "type": "color",
      "id": "container_bg",
      "label": "Inner Container Background",
      "default": "#E2FF00"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "btn_bg",
      "label": "Button Background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Button Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "border_thickness",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "Border Thickness",
      "default": 3
    },
    {
      "type": "color",
      "id": "shadow_color",
      "label": "Hard Shadow Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "shadow_offset",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Shadow Offset",
      "default": 12
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP20 Brutalist Signup"
    }
  ]
}
{% endschema %}
