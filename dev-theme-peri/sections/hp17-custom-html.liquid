{%- liquid
  assign section_id = section.id
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: #000;
    padding: 80px 40px;
    border-bottom: 1px solid rgba(0, 255, 65, 0.3);
  }
  
  .hp17-html-container-{{ section_id }} {
    max-width: 1200px;
    margin: 0 auto;
    background: #0A0A0A;
    border: 1px solid #00FF41;
    padding: 40px;
    position: relative;
  }
  
  .hp17-html-container-{{ section_id }}::before {
    content: '[ INJECT_CODE ]';
    position: absolute;
    top: -10px; left: 20px;
    background: #000;
    color: #00FF41;
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.8rem;
    padding: 0 10px;
  }

  .hp17-html-content-{{ section_id }} {
    font-family: 'Courier New', Courier, monospace;
    color: #FFF;
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 40px 20px;
    }
    .hp17-html-container-{{ section_id }} {
      padding: 20px;
    }
  }
</style>

<div class="hp17-html-container-{{ section_id }}">
  <div class="hp17-html-content-{{ section_id }}">
    {% if section.settings.html != blank %}
      {{ section.settings.html }}
    {% else %}
      <div style="text-align: center; padding: 40px; color: rgba(0,255,65,0.5);">
        > NO CUSTOM HTML DETECTED
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "HP17 Custom HTML",
  "settings": [
    {
      "type": "html",
      "id": "html",
      "label": "Custom HTML",
      "default": "<div style='text-align: center; color: #00FF41;'>[ CUSTOM CODE BLOCK ]</div>"
    }
  ],
  "presets": [
    {
      "name": "HP17 Custom HTML"
    }
  ]
}
{% endschema %}
