{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp46-vid-bg: {{ section.settings.bg_color | default: '#0B0F19' }};
    
    background-color: var(--hp46-vid-bg);
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
  }

  .hp46-video__box {
    max-width: {{ section.settings.container_width | default: 1240 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp46-video__media {
    width: 100%;
    height: {{ section.settings.video_height | default: 480 }}px;
    background: #0F172A;
    border: 1px solid rgba(56, 189, 248, 0.3);
    border-radius: 28px;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 40px rgba(56, 189, 248, 0.15);
  }

  .hp46-video__poster {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hp46-video__play-btn {
    position: absolute;
    width: 84px;
    height: 84px;
    background: linear-gradient(135deg, #38BDF8, #F472B6);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #0B0F19;
    font-size: 26px;
    cursor: pointer;
    box-shadow: 0 0 35px rgba(244, 114, 182, 0.5);
    transition: all 0.3s ease;
  }

  .hp46-video__play-btn:hover {
    transform: scale(1.1);
    box-shadow: 0 0 50px rgba(56, 189, 248, 0.7);
  }

  @media screen and (max-width: 768px) {
    .hp46-video__media { height: 320px; }
  }
{%- endstyle -%}

<div class="hp46-video__box">
  <div class="hp46-video__media">
    {%- if section.settings.poster_image != blank -%}
      <img src="{{ section.settings.poster_image | image_url: width: 1400 }}" class="hp46-video__poster" alt="Video Frame" loading="lazy">
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'hp46-video__poster' }}
    {%- endif -%}
    <div class="hp46-video__play-btn" onclick="alert('Streaming Holographic Synthesis Visualizer');">▶</div>
  </div>
</div>

{% schema %}
{
  "name": "HP46 - Cyber Video",
  "class": "section-hp46-video",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#0B0F19" },
    { "type": "image_picker", "id": "poster_image", "label": "Poster Image" },
    { "type": "range", "id": "video_height", "min": 300, "max": 700, "step": 20, "unit": "px", "label": "Video Height", "default": 480 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 80 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1240 }
  ],
  "presets": [
    { "name": "HP46 - Cyber Video" }
  ]
}
{% endschema %}
