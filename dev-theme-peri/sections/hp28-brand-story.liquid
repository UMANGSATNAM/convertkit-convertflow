{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Chakra+Petch:ital,wght@0,300;0,400;0,600;0,700;1,400&family=Press+Start+2P&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --cyan: {{ section.settings.cyan_color }};
    --magenta: {{ section.settings.magenta_color }};
    --font-heading: 'Press Start 2P', cursive;
    --font-body: 'Chakra Petch', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    position: relative;
    overflow: hidden;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.8 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.8 | round }}px;
    }
  }

  /* Distressed/Pixel Grid Background */
  #shopify-section-{{ section.id }}::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-image: 
      linear-gradient(rgba(255, 0, 255, 0.03) 2px, transparent 2px),
      linear-gradient(90deg, rgba(255, 0, 255, 0.03) 2px, transparent 2px);
    background-size: 50px 50px;
    pointer-events: none;
    z-index: 0;
  }

  .hp28-story-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    align-items: center;
    gap: 60px;
    position: relative;
    z-index: 1;
  }

  {% if section.settings.image_position == 'right' %}
    .hp28-story-wrapper {
      flex-direction: row-reverse;
    }
  {% endif %}

  @media screen and (max-width: 992px) {
    .hp28-story-wrapper {
      flex-direction: column;
      gap: 40px;
    }
  }

  @media screen and (max-width: 768px) {
    .hp28-story-wrapper {
      padding: 0 20px;
    }
  }

  .hp28-story__image-col {
    flex: 1;
    position: relative;
  }

  /* Win95/MacOS Retro Window for Image */
  .hp28-story__window {
    background: #c0c0c0;
    border-top: 2px solid #fff;
    border-left: 2px solid #fff;
    border-right: 2px solid #000;
    border-bottom: 2px solid #000;
    padding: 3px;
    box-shadow: 10px 10px 0 var(--cyan);
    position: relative;
    z-index: 2;
  }

  .hp28-story__window-bar {
    background: #000080;
    color: #fff;
    padding: 4px 8px;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 700;
    display: flex;
    justify-content: space-between;
    align-items: center;
    letter-spacing: 0.05em;
  }

  .hp28-story__window-btns {
    display: flex;
    gap: 4px;
  }

  .hp28-story__window-btn {
    width: 14px; height: 14px;
    background: #c0c0c0;
    border-top: 1px solid #fff;
    border-left: 1px solid #fff;
    border-right: 1px solid #000;
    border-bottom: 1px solid #000;
  }

  .hp28-story__image-inner {
    aspect-ratio: 4/3;
    background: #000;
    position: relative;
    overflow: hidden;
    border-top: 2px solid #808080;
    border-left: 2px solid #808080;
    border-right: 2px solid #fff;
    border-bottom: 2px solid #fff;
  }

  .hp28-story__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(150%) hue-rotate(-10deg);
  }

  /* Glitch overlay on image */
  .hp28-story__image-inner::after {
    content: '';
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background: repeating-linear-gradient(
      transparent,
      transparent 3px,
      rgba(0, 255, 255, 0.1) 3px,
      rgba(0, 255, 255, 0.1) 6px
    );
    pointer-events: none;
  }

  /* Floating geometric shapes */
  .hp28-story__shape-1,
  .hp28-story__shape-2 {
    position: absolute;
    z-index: 1;
    pointer-events: none;
  }

  .hp28-story__shape-1 {
    top: -30px; left: -30px;
    width: 80px; height: 80px;
    border: 4px dashed var(--magenta);
    animation: rotateSlow 20s linear infinite;
  }

  .hp28-story__shape-2 {
    bottom: -40px; right: -20px;
    width: 100px; height: 100px;
    background: var(--cyan);
    clip-path: polygon(50% 0%, 100% 50%, 50% 100%, 0% 50%);
    animation: float 6s ease-in-out infinite;
  }

  @keyframes rotateSlow {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-20px); }
  }

  .hp28-story__text-col {
    flex: 1.2;
    position: relative;
    z-index: 2;
  }

  .hp28-story__label {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: 10px;
    color: var(--bg-color);
    background: var(--text-color);
    padding: 8px 12px;
    margin-bottom: 20px;
    text-transform: uppercase;
  }

  .hp28-story__title {
    font-family: var(--font-heading);
    font-size: clamp(24px, 3.5vw, {{ section.settings.title_size }}px);
    color: var(--cyan);
    text-shadow: 3px 3px 0 var(--magenta);
    margin: 0 0 25px;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .hp28-story__text {
    font-family: var(--font-body);
    font-size: clamp(16px, 1.8vw, 18px);
    font-weight: 400;
    color: var(--text-color);
    line-height: 1.6;
    margin: 0 0 35px;
  }

  .hp28-story__text p {
    margin: 0 0 20px;
  }
  .hp28-story__text p:last-child {
    margin: 0;
  }

  .hp28-story__btn {
    display: inline-block;
    background: var(--magenta);
    color: #fff;
    font-family: var(--font-heading);
    font-size: 14px;
    text-decoration: none;
    padding: 20px 40px;
    border: 2px solid #fff;
    box-shadow: 5px 5px 0 var(--cyan);
    transition: all 0.2s ease;
    text-transform: uppercase;
  }

  .hp28-story__btn:hover {
    transform: translate(2px, 2px);
    box-shadow: 3px 3px 0 var(--cyan);
    background: var(--cyan);
    color: #000;
  }

  .hp28-story__btn:active {
    transform: translate(5px, 5px);
    box-shadow: 0 0 0 var(--cyan);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp28-story-wrapper" id="HP28Story-{{ section.id }}">
  <div class="hp28-story__image-col">
    <div class="hp28-story__shape-1"></div>
    <div class="hp28-story__shape-2"></div>

    <div class="hp28-story__window">
      <div class="hp28-story__window-bar">
        <span>C:\IMG\ARCHIVE.GIF</span>
        <div class="hp28-story__window-btns">
          <div class="hp28-story__window-btn"></div>
          <div class="hp28-story__window-btn"></div>
          <div class="hp28-story__window-btn"></div>
        </div>
      </div>
      <div class="hp28-story__image-inner">
        {%- if section.settings.image != blank -%}
          <img height="{{ section.settings.image.height }}" width="{{ section.settings.image.width }}" src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.title | escape }}" class="hp28-story__image" loading="lazy">
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'hp28-story__image' }}
        {%- endif -%}
      </div>
    </div>
  </div>

  <div class="hp28-story__text-col">
    {%- if section.settings.label != blank -%}
      <div class="hp28-story__label">{{ section.settings.label }}</div>
    {%- endif -%}

    {%- if section.settings.title != blank -%}
      <h2 class="hp28-story__title">{{ section.settings.title }}</h2>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="hp28-story__text">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- if section.settings.button_text != blank -%}
      <a href="{{ section.settings.button_link | default: '#' }}" class="hp28-story__btn">
        {{ section.settings.button_text }}
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP28 - Y2K Brand Story",
  "class": "section-hp28-brand-story",
  "settings": [
    {
      "type": "header",
      "content": "Image Area"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Text Area"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Small Label",
      "default": "ORIGIN.EXE"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "SYSTEM REBOOT"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>In a world saturated by standard operating procedures, we executed a hard reset. Our systems are built differently.</p><p>Explore the architecture of the new digital wave. No limits. No boundaries.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "READ_FILE"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1400
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 48
    },
    {
      "type": "header",
      "content": "Y2K Cyber Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (Deep Purple)",
      "default": "#1C0B2B"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Base Text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "cyan_color",
      "label": "Cyan Accent",
      "default": "#00FFFF"
    },
    {
      "type": "color",
      "id": "magenta_color",
      "label": "Magenta Accent",
      "default": "#FF00FF"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 100
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP28 - Y2K Brand Story"
    }
  ]
}
{% endschema %}
