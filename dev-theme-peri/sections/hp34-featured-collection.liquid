{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;700&family=JetBrains+Mono:wght@400;700&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --grid-color: rgba(255, 255, 255, 0.1);
    
    --font-heading: 'Inter', sans-serif;
    --font-body: 'JetBrains Mono', monospace;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    border-bottom: 1px solid var(--grid-color);
  }

  .hp34-feat-wrapper {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp34-feat-wrapper {
      padding: 0 20px;
    }
  }

  .hp34-feat__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 50px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--grid-color);
  }

  @media screen and (max-width: 768px) {
    .hp34-feat__header {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }
  }

  .hp34-feat__title-group {
    display: flex;
    flex-direction: column;
  }

  .hp34-feat__subtitle {
    font-family: var(--font-body);
    font-size: 11px;
    color: var(--accent-color);
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 10px;
  }

  .hp34-feat__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    line-height: 1;
    color: var(--text-color);
    margin: 0;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }

  .hp34-feat__link {
    font-family: var(--font-body);
    font-size: 12px;
    color: var(--text-color);
    text-transform: uppercase;
    text-decoration: none;
    letter-spacing: 1px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    transition: color 0.3s ease;
  }

  .hp34-feat__link:hover {
    color: var(--accent-color);
  }

  .hp34-feat__link::before {
    content: '[';
    color: var(--accent-color);
  }
  .hp34-feat__link::after {
    content: ']';
    color: var(--accent-color);
  }

  .hp34-feat__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: 40px;
  }

  @media screen and (max-width: 992px) {
    .hp34-feat__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 576px) {
    .hp34-feat__grid {
      grid-template-columns: 1fr;
    }
  }

  .hp34-feat__item {
    text-decoration: none;
    display: block;
    position: relative;
    group: card;
  }

  .hp34-feat__image-wrap {
    aspect-ratio: 3/4;
    background: #111;
    border: 1px solid var(--grid-color);
    position: relative;
    overflow: hidden;
    margin-bottom: 20px;
  }

  .hp34-feat__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%);
    transition: filter 0.5s ease;
  }

  .hp34-feat__item:hover .hp34-feat__image {
    filter: grayscale(0%);
  }

  /* Overlay data on hover */
  .hp34-feat__overlay-data {
    position: absolute;
    top: 15px; left: 15px; right: 15px; bottom: 15px;
    border: 1px dashed var(--accent-color);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s ease;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 10px;
  }

  .hp34-feat__item:hover .hp34-feat__overlay-data {
    opacity: 1;
  }

  .hp34-feat__overlay-data::before {
    content: 'STATUS: ACTIVE';
    font-family: var(--font-body);
    font-size: 10px;
    color: var(--accent-color);
  }
  
  .hp34-feat__overlay-data::after {
    content: 'TARGET ACQUIRED';
    font-family: var(--font-body);
    font-size: 10px;
    color: var(--accent-color);
    text-align: right;
  }

  .hp34-feat__info {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .hp34-feat__product-title {
    font-family: var(--font-heading);
    font-size: 16px;
    color: var(--text-color);
    margin: 0 0 5px;
    font-weight: 700;
    text-transform: uppercase;
  }

  .hp34-feat__sku {
    font-family: var(--font-body);
    font-size: 10px;
    color: var(--text-color);
    opacity: 0.5;
  }

  .hp34-feat__product-price {
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--accent-color);
    font-weight: 700;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp34-feat-wrapper" id="HP34Feat-{{ section.id }}">
  <div class="hp34-feat__header">
    <div class="hp34-feat__title-group">
      {%- if section.settings.subtitle != blank -%}
        <div class="hp34-feat__subtitle">{{ section.settings.subtitle }}</div>
      {%- endif -%}
      <h2 class="hp34-feat__title">{{ section.settings.title }}</h2>
    </div>
    
    {%- if section.settings.btn_label != blank -%}
      <a href="{{ section.settings.btn_link | default: '#' }}" class="hp34-feat__link">
        {{ section.settings.btn_label }}
      </a>
    {%- endif -%}
  </div>

  <div class="hp34-feat__grid">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.product_link | default: '#' }}" class="hp34-feat__item" {{ block.shopify_attributes }}>
        <div class="hp34-feat__image-wrap">
          {%- if block.settings.image != blank -%}
            <img height="{{ block.settings.image.height }}" width="{{ block.settings.image.width }}" src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title | escape }}" class="hp34-feat__image" loading="lazy">
          {%- else -%}
            {%- assign placeholder = 'product-' | append: forloop.index -%}
            {%- if forloop.index > 6 -%}{%- assign placeholder = 'product-1' -%}{%- endif -%}
            {{ placeholder | placeholder_svg_tag: 'hp34-feat__image' }}
          {%- endif -%}
          <div class="hp34-feat__overlay-data"></div>
        </div>
        
        <div class="hp34-feat__info">
          <div>
            <h3 class="hp34-feat__product-title">{{ block.settings.title }}</h3>
            <div class="hp34-feat__sku">ID: {{ block.settings.title | slice: 0, 3 | upcase }}-0{{ forloop.index }}</div>
          </div>
          <div class="hp34-feat__product-price">{{ block.settings.price }}</div>
        </div>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "HP34 - Tech Featured",
  "class": "section-hp34-featured-collection",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "MODULE: PRIMARY INVENTORY"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Featured Assets"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "ACCESS ALL"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Columns (Desktop)",
      "default": 4
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 40
    },
    {
      "type": "header",
      "content": "Tech Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (e.g. Black)",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#FF4500"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Product Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Tactical Jacket"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "$145.00"
        },
        {
          "type": "url",
          "id": "product_link",
          "label": "Product Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP34 - Tech Featured",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
