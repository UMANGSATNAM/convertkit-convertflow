{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#0000FF'
  assign text_color = section.settings.text_color | default: '#FFFFFF'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 120px 20px;
    border-bottom: 3px solid #000;
  }
  
  .hp11-nl-container-{{ section_id }} {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
    background: #FF00FF;
    border: 4px solid #000;
    padding: 60px 40px;
    box-shadow: 15px 15px 0 #000;
    position: relative;
  }
  
  .hp11-nl-heading-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 900;
    text-transform: uppercase;
    color: #FFF;
    margin: 0 0 15px 0;
    line-height: 1;
    text-shadow: 3px 3px 0 #000;
  }
  
  .hp11-nl-text-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: 1.2rem;
    font-weight: 700;
    color: #000;
    margin: 0 0 40px 0;
  }
  
  .hp11-nl-form-{{ section_id }} {
    display: flex;
    max-width: 600px;
    margin: 0 auto;
  }
  
  .hp11-nl-input-{{ section_id }} {
    flex: 1;
    padding: 18px 20px;
    border: 3px solid #000;
    font-family: 'Inter', sans-serif;
    font-size: 1.1rem;
    font-weight: 700;
    outline: none;
  }
  
  .hp11-nl-input-{{ section_id }}:focus {
    background: #F4F4F4;
  }
  
  .hp11-nl-btn-{{ section_id }} {
    padding: 0 30px;
    background: #CCFF00;
    color: #000;
    border: 3px solid #000;
    border-left: none;
    font-family: 'Inter', sans-serif;
    font-size: 1.1rem;
    font-weight: 900;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.2s ease;
  }
  
  .hp11-nl-btn-{{ section_id }}:hover {
    background: #FFF;
  }

  @media (max-width: 600px) {
    .hp11-nl-form-{{ section_id }} {
      flex-direction: column;
    }
    .hp11-nl-btn-{{ section_id }} {
      border-left: 3px solid #000;
      border-top: none;
      padding: 18px;
    }
  }
</style>

<div class="hp11-nl-container-{{ section_id }}">
  <h2 class="hp11-nl-heading-{{ section_id }}">{{ section.settings.heading | default: 'EARLY ACCESS' }}</h2>
  <div class="hp11-nl-text-{{ section_id }}">{{ section.settings.text | default: 'Sign up to get notified before the next drop.' }}</div>
  
  {% form 'customer', class: 'hp11-nl-form-' | append: section_id %}
    <input type="hidden" name="contact[tags]" value="newsletter">
    <input type="email" name="contact[email]" class="hp11-nl-input-{{ section_id }}" placeholder="YOUR EMAIL..." required>
    <button type="submit" class="hp11-nl-btn-{{ section_id }}">SUBMIT</button>
  {% endform %}
</div>

{% schema %}
{
  "name": "HP11 Newsletter",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#0000FF"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "EARLY ACCESS"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Sign up to get notified before the next drop."
    }
  ],
  "presets": [
    {
      "name": "HP11 Newsletter"
    }
  ]
}
{% endschema %}
