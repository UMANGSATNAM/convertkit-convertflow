{%- liquid
  assign bg_color = section.settings.bg_color | default: '#0a0a0a'
  assign text_color = section.settings.text_color | default: '#ffffff'
  assign accent_color = section.settings.accent_color | default: '#00ffcc'
  
  assign padding_top_desktop = section.settings.padding_top_desktop
  assign padding_bottom_desktop = section.settings.padding_bottom_desktop
  assign padding_top_mobile = section.settings.padding_top_mobile
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile
-%}

<style>
  #shopify-section-{{ section.id }} {
    --hp3-pills-bg: {{ bg_color }};
    --hp3-pills-text: {{ text_color }};
    --hp3-pills-accent: {{ accent_color }};
    
    --hp3-pills-pt-desk: {{ padding_top_desktop }}px;
    --hp3-pills-pb-desk: {{ padding_bottom_desktop }}px;
    --hp3-pills-pt-mob: {{ padding_top_mobile }}px;
    --hp3-pills-pb-mob: {{ padding_bottom_mobile }}px;
  }

  .hp3-tech-pills-{{ section.id }} {
    padding-top: var(--hp3-pills-pt-desk);
    padding-bottom: var(--hp3-pills-pb-desk);
    background-color: var(--hp3-pills-bg);
    color: var(--hp3-pills-text);
    font-family: 'Inter', sans-serif;
  }

  .hp3-pills-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
  }
  
  .hp3-pills-header {
    text-align: center;
    margin-bottom: 30px;
  }
  
  .hp3-pills-title {
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 3px;
    color: rgba(255,255,255,0.5);
    margin: 0;
  }

  /* Scrollable wrapper */
  .hp3-pills-wrapper {
    display: flex;
    overflow-x: auto;
    gap: 15px;
    padding-bottom: 20px; /* Space for scrollbar */
    scrollbar-width: thin;
    scrollbar-color: rgba(255,255,255,0.2) transparent;
    -webkit-overflow-scrolling: touch;
    justify-content: center;
  }

  /* Custom Scrollbar for Webkit */
  .hp3-pills-wrapper::-webkit-scrollbar {
    height: 4px;
  }
  .hp3-pills-wrapper::-webkit-scrollbar-track {
    background: rgba(255,255,255,0.05);
    border-radius: 4px;
  }
  .hp3-pills-wrapper::-webkit-scrollbar-thumb {
    background: rgba(255,255,255,0.2);
    border-radius: 4px;
  }
  .hp3-pills-wrapper::-webkit-scrollbar-thumb:hover {
    background: var(--hp3-pills-accent);
  }

  /* The Pill */
  .hp3-pill-item {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 24px;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 100px;
    text-decoration: none;
    color: var(--hp3-pills-text);
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    white-space: nowrap;
    transition: all 0.3s ease;
    flex-shrink: 0;
  }

  .hp3-pill-icon {
    width: 20px;
    height: 20px;
    object-fit: contain;
    filter: brightness(0) invert(1); /* Assuming black icons, invert to white */
    opacity: 0.7;
    transition: all 0.3s ease;
  }

  .hp3-pill-item:hover {
    background: rgba(255,255,255,0.1);
    border-color: var(--hp3-pills-accent);
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(0, 255, 204, 0.1);
    color: var(--hp3-pills-accent);
  }
  
  .hp3-pill-item:hover .hp3-pill-icon {
    opacity: 1;
    filter: brightness(1) sepia(1) hue-rotate(120deg) saturate(5); /* Approximate colorization, best to use SVG or transparent png */
  }

  @media screen and (max-width: 768px) {
    .hp3-tech-pills-{{ section.id }} {
      padding-top: var(--hp3-pills-pt-mob);
      padding-bottom: var(--hp3-pills-pb-mob);
    }
    .hp3-pills-inner {
      padding: 0 20px;
    }
    .hp3-pills-wrapper {
      justify-content: flex-start;
      padding-bottom: 15px;
    }
    .hp3-pill-item {
      padding: 10px 20px;
      font-size: 12px;
    }
  }
</style>

<section class="hp3-tech-pills-{{ section.id }}" aria-label="Quick Category Links">
  <div class="hp3-pills-inner">
    
    {%- if section.settings.heading != blank -%}
      <div class="hp3-pills-header">
        <h3 class="hp3-pills-title">{{ section.settings.heading }}</h3>
      </div>
    {%- endif -%}

    <div class="hp3-pills-wrapper">
      {%- for block in section.blocks -%}
        {%- assign collection = collections[block.settings.collection] -%}
        <a href="{{ collection.url | default: '#' }}" class="hp3-pill-item" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != blank -%}
            <img height="{{ block.settings.icon.height }}" width="{{ block.settings.icon.width }}" src="{{ block.settings.icon | image_url: width: 60 }}" class="hp3-pill-icon" loading="lazy" alt="icon">
          {%- endif -%}
          {{ block.settings.title | default: collection.title | default: 'Category' }}
        </a>
      {%- endfor -%}
      
      {%- if section.blocks.size == 0 -%}
        <a href="#" class="hp3-pill-item">LAPTOPS</a>
        <a href="#" class="hp3-pill-item">SMARTPHONES</a>
        <a href="#" class="hp3-pill-item">WEARABLES</a>
        <a href="#" class="hp3-pill-item">AUDIO</a>
        <a href="#" class="hp3-pill-item">ACCESSORIES</a>
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "HP3 Category Pills",
  "tag": "section",
  "class": "section-hp3-pills",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "QUICK SEARCH"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#0a0a0a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Hover Accent Color",
      "default": "#00ffcc"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Top (Desktop)", "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Bottom (Desktop)", "default": 40
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Top (Mobile)", "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Bottom (Mobile)", "default": 30
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Category Pill",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Override Title (Optional)"
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Small Icon (Optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP3 Category Pills (Adv)",
      "category": "Navigation",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
