{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp53-story-bg: {{ section.settings.bg_color | default: '#FAF5EF' }};

    background-color: var(--hp53-story-bg);
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }

  .hp53-story__container {
    max-width: {{ section.settings.container_width | default: 1280 }}px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 70px;
    align-items: center;
  }

  .hp53-story__img-wrap {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    height: 480px;
    border: 2px solid {{ section.settings.border_color | default: '#E8D5C0' }};
  }

  .hp53-story__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: sepia(10%);
  }

  .hp53-story__eyebrow {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: {{ section.settings.accent_color | default: '#C2703E' }};
    margin: 0 0 16px;
  }

  .hp53-story__heading {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(28px, 3.5vw, 42px);
    font-weight: 700;
    color: {{ section.settings.title_color | default: '#5C3D2E' }};
    margin: 0 0 22px;
    line-height: 1.15;
  }

  .hp53-story__text {
    font-size: 15px;
    line-height: 1.8;
    color: {{ section.settings.text_color | default: '#8B6F5E' }};
    margin: 0 0 32px;
  }

  .hp53-story__btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 30px;
    background: {{ section.settings.btn_bg | default: '#5C3D2E' }};
    color: {{ section.settings.btn_text | default: '#FAF5EF' }};
    font-family: 'Space Grotesk', sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 4px;
    border: 2px solid {{ section.settings.btn_bg | default: '#5C3D2E' }};
    transition: all 0.3s ease;
  }

  .hp53-story__btn:hover {
    background: transparent;
    color: {{ section.settings.btn_bg | default: '#5C3D2E' }};
  }

  @media screen and (max-width: 992px) {
    .hp53-story__container { grid-template-columns: 1fr; text-align: center; gap: 40px; }
    .hp53-story__img-wrap { height: 350px; }
    .hp53-story__text { margin-left: auto; margin-right: auto; max-width: 600px; }
  }
{%- endstyle -%}

<div class="hp53-story__container">
  <div class="hp53-story__img-wrap">
    {%- if section.settings.image != blank -%}
      <img src="{{ section.settings.image | image_url: width: 800 }}" class="hp53-story__img" alt="{{ section.settings.heading }}" loading="lazy">
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'hp53-story__img' }}
    {%- endif -%}
  </div>

  <div>
    <p class="hp53-story__eyebrow">{{ section.settings.eyebrow | default: '◈ OUR JOURNEY' }}</p>
    <h2 class="hp53-story__heading">{{ section.settings.heading | default: 'Born from the Saharan Winds' }}</h2>
    <p class="hp53-story__text">{{ section.settings.text | default: 'Every product is a tribute to the ancient beauty rituals of the Saharan desert, where women have used argan oil, red clay, and prickly pear for centuries to maintain radiant, resilient skin under the harshest sun.' }}</p>
    {%- if section.settings.btn_label != blank -%}
      <a href="{{ section.settings.btn_url | default: '/pages/about' }}" class="hp53-story__btn">
        {{ section.settings.btn_label }} &rarr;
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP53 - Dune Story",
  "class": "section-hp53-story",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FAF5EF" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#C2703E" },
    { "type": "color", "id": "title_color", "label": "Title Color", "default": "#5C3D2E" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#8B6F5E" },
    { "type": "color", "id": "border_color", "label": "Image Border", "default": "#E8D5C0" },
    { "type": "color", "id": "btn_bg", "label": "Button BG", "default": "#5C3D2E" },
    { "type": "color", "id": "btn_text", "label": "Button Text", "default": "#FAF5EF" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "◈ OUR JOURNEY" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Born from the Saharan Winds" },
    { "type": "textarea", "id": "text", "label": "Story Text", "default": "Every product is a tribute to the ancient beauty rituals of the Saharan desert." },
    { "type": "text", "id": "btn_label", "label": "Button Label", "default": "Read Our Story" },
    { "type": "url", "id": "btn_url", "label": "Button URL" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "presets": [{ "name": "HP53 - Dune Story" }]
}
{% endschema %}
