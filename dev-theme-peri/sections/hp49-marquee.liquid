<style>
@media screen and (max-width: 768px) {
  .hp49-marquee {
    padding-left: 16px !important;
    padding-right: 16px !important;
    box-sizing: border-box !important;
  }
  img {
    max-width: 100% !important;
    height: auto !important;
  }
}
</style>
{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp49-marq-bg: {{ section.settings.bg_color | default: '#7C3AED' }};
    --hp49-marq-text: {{ section.settings.text_color | default: '#FFFFFF' }};
    
    background: var(--hp49-marq-bg);
    color: var(--hp49-marq-text);
    padding: {{ section.settings.padding_vertical | default: 16 }}px 0;
    overflow: hidden;
    white-space: nowrap;
  }

  .hp49-marquee__track {
    display: inline-flex;
    gap: 40px;
    animation: hp49-scroll {{ section.settings.speed | default: 22 }}s linear infinite;
    font-family: 'Urbanist', sans-serif;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }

  .hp49-marquee__item {
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }

  @keyframes hp49-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
{%- endstyle -%}

<div class="hp49-marquee__track">
  {%- if section.blocks.size > 0 -%}
    {%- for i in (1..2) -%}
      {%- for block in section.blocks -%}
        <div class="hp49-marquee__item" {{ block.shopify_attributes }}>
          <span>🌸</span>
          <span>{{ block.settings.text }}</span>
        </div>
      {%- endfor -%}
    {%- endfor -%}
  {%- else -%}
    {%- for i in (1..2) -%}
      <div class="hp49-marquee__item"><span>🌸</span><span>FRENCH ALPINE LAVENDER HYDROSOL</span></div>
      <div class="hp49-marquee__item"><span>☁️</span><span>CLOUD-SOFT PEPTIDE BARRIER ENRICHMENT</span></div>
      <div class="hp49-marquee__item"><span>✈️</span><span>FREE EXPRESS AIR SHIPPING OVER $65</span></div>
      <div class="hp49-marquee__item"><span>🛡️</span><span>DERMATOLOGIST CERTIFIED CALMING FORMULA</span></div>
    {%- endfor -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "HP49 - Lavender Marquee",
  "class": "section-hp49-marquee",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#7C3AED" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#FFFFFF" },
    { "type": "range", "id": "speed", "min": 10, "max": 60, "step": 2, "unit": "s", "label": "Scroll Duration", "default": 22 },
    { "type": "range", "id": "padding_vertical", "min": 8, "max": 40, "step": 2, "unit": "px", "label": "Padding Vertical", "default": 16 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Ticker Item",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "FRENCH ALPINE LAVENDER HYDROSOL" }
      ]
    }
  ],
  "presets": [
    { "name": "HP49 - Lavender Marquee" }
  ]
}
{% endschema %}
