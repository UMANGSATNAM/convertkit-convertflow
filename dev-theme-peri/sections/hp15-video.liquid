{%- liquid
  assign section_id = section.id
-%}

<style>
  #shopify-section-{{ section_id }} {
    padding: 0;
  }
  
  .hp15-video-container-{{ section_id }} {
    position: relative;
    width: 100%;
    height: 100vh;
    min-height: 600px;
    background: #000;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .hp15-video-element-{{ section_id }} {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover;
    filter: grayscale(100%);
    opacity: 0.7;
  }
  
  .hp15-video-overlay-{{ section_id }} {
    position: relative;
    z-index: 2;
    text-align: center;
    color: #fff;
  }
  
  .hp15-video-play-{{ section_id }} {
    width: 80px;
    height: 80px;
    border: 1px solid #fff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 30px;
    cursor: pointer;
    background: transparent;
    color: #fff;
    transition: all 0.3s ease;
  }
  
  .hp15-video-play-{{ section_id }}:hover {
    background: #fff;
    color: #000;
  }
  
  .hp15-video-play-{{ section_id }} svg {
    width: 30px;
    height: 30px;
    margin-left: 5px;
  }
  
  .hp15-video-title-{{ section_id }} {
    font-family: 'Didot', 'Playfair Display', serif;
    font-size: clamp(2rem, 4vw, 4rem);
    font-weight: normal;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin: 0;
  }

  @media (max-width: 768px) {
    .hp15-video-container-{{ section_id }} {
      height: 60vh;
    }
  }
</style>

<div class="hp15-video-container-{{ section_id }}">
  {% if section.settings.video_url != blank %}
    <video class="hp15-video-element-{{ section_id }}" autoplay loop muted playsinline>
      <source src="{{ section.settings.video_url }}" type="video/mp4">
    </video>
  {% else %}
    <div class="hp15-video-element-{{ section_id }}" style="background: repeating-linear-gradient(45deg, #EFEFEF, #EFEFEF 12px, #E6E6E6 12px, #E6E6E6 24px);"></div>
  {% endif %}
  
  <div class="hp15-video-overlay-{{ section_id }}">
    <button class="hp15-video-play-{{ section_id }}">
      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
    </button>
    <h2 class="hp15-video-title-{{ section_id }}">{{ section.settings.title | default: 'THE CAMPAIGN' }}</h2>
  </div>
</div>

{% schema %}
{
  "name": "HP15 Video",
  "settings": [
    {
      "type": "text",
      "id": "video_url",
      "label": "Video URL (MP4)",
      "info": "Upload video to Settings > Files and paste URL here."
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "THE CAMPAIGN"
    }
  ],
  "presets": [
    {
      "name": "HP15 Video"
    }
  ]
}
{% endschema %}
