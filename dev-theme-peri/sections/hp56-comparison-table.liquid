{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#F0F9FF' }};
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }
  .hp56-comp__container { max-width: {{ section.settings.container_width | default: 1000 }}px; margin: 0 auto; padding: 0 24px; }
  .hp56-comp__header { text-align: center; margin-bottom: 50px; }
  .hp56-comp__eyebrow { font-family: 'Outfit', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: {{ section.settings.accent_color | default: '#0284C7' }}; margin: 0 0 12px; }
  .hp56-comp__heading { font-family: 'Syne', sans-serif; font-size: clamp(28px, 3.5vw, 42px); font-weight: 800; color: #082F49; margin: 0; }
  .hp56-comp__table {
    width: 100%; border-collapse: collapse; background: {{ section.settings.card_bg | default: '#FFFFFF' }};
    border-radius: 14px; overflow: hidden; border: 1px solid rgba(2, 132, 199, 0.15);
    box-shadow: 0 10px 30px rgba(2, 132, 199, 0.08);
  }
  .hp56-comp__table th {
    background: #082F49; color: #E0F2FE; font-family: 'Outfit', sans-serif;
    font-size: 12px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase;
    padding: 18px 20px; text-align: left;
  }
  .hp56-comp__table td {
    padding: 16px 20px; font-size: 14px; color: #334155;
    border-bottom: 1px solid rgba(2, 132, 199, 0.08);
  }
  .hp56-comp__table tr:last-child td { border-bottom: none; }
  .hp56-comp__check { color: #0284C7; font-weight: 700; }
  @media screen and (max-width: 768px) {
    .hp56-comp__table { font-size: 13px; }
    .hp56-comp__table th, .hp56-comp__table td { padding: 12px 14px; }
  }
{%- endstyle -%}
<div class="hp56-comp__container">
  <div class="hp56-comp__header">
    {%- if section.settings.eyebrow != blank -%}<p class="hp56-comp__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="hp56-comp__heading">{{ section.settings.heading | default: 'The Nordic Pure Difference' }}</h2>
  </div>
  <table class="hp56-comp__table">
    <thead>
      <tr>
        <th>{{ section.settings.col1_head | default: 'Efficacy Standard' }}</th>
        <th>{{ section.settings.col2_head | default: 'Nordic Glacial' }}</th>
        <th>{{ section.settings.col3_head | default: 'Standard Formulas' }}</th>
      </tr>
    </thead>
    <tbody>
      {%- for block in section.blocks -%}
        <tr {{ block.shopify_attributes }}>
          <td>{{ block.settings.feature | default: 'Vitamin C Stability' }}</td>
          <td class="hp56-comp__check">{{ block.settings.us | default: '❄️ 100% Bio-Active' }}</td>
          <td style="color:#94A3B8;">{{ block.settings.them | default: 'Degrades in 30 Days' }}</td>
        </tr>
      {%- endfor -%}
    </tbody>
  </table>
</div>
{% schema %}
{
  "name": "HP56 Compare",
  "class": "section-hp56-comp",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#F0F9FF" },
    { "type": "color", "id": "card_bg", "label": "Table BG", "default": "#FFFFFF" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#0284C7" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "❄️ COMPARISON" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Nordic Pure Difference" },
    { "type": "text", "id": "col1_head", "label": "Column 1", "default": "Efficacy Standard" },
    { "type": "text", "id": "col2_head", "label": "Column 2", "default": "Nordic Glacial" },
    { "type": "text", "id": "col3_head", "label": "Column 3", "default": "Standard Formulas" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 700, "max": 1200, "step": 20, "unit": "px", "label": "Container Width", "default": 1000 }
  ],
  "blocks": [{
    "type": "row", "name": "Row",
    "settings": [
      { "type": "text", "id": "feature", "label": "Feature", "default": "Vitamin C Stability" },
      { "type": "text", "id": "us", "label": "Us", "default": "❄️ 100% Bio-Active" },
      { "type": "text", "id": "them", "label": "Others", "default": "Degrades in 30 Days" }
    ]
  }],
  "presets": [{
    "name": "HP56 Compare",
    "blocks": [
      { "type": "row", "settings": { "feature": "Vitamin C Bio-Availability", "us": "❄️ Natural Cloudberry 400%", "them": "Synthetic L-Ascorbic Acid" } },
      { "type": "row", "settings": { "feature": "Water Base Replacement", "us": "❄️ 100% Pure Birch Sap", "them": "Standard Deionized Water" } },
      { "type": "row", "settings": { "feature": "Cold-Extraction Tech", "us": "❄️ -20°C Cryo-Sonic", "them": "Heat Distilled (Damage)" } },
      { "type": "row", "settings": { "feature": "Nordic Swan Certified", "us": "❄️ 100% Eco-Approved", "them": "Uncertified" } }
    ]
  }]
}
{% endschema %}
