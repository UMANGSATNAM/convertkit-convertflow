{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#030712' }};
    padding-top: {{ section.settings.padding_top | default: 50 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 50 }}px;
    border-top: 1px solid rgba(239, 68, 68, 0.25);
  }
  .hp61-trust__container { max-width: {{ section.settings.container_width | default: 1280 }}px; margin: 0 auto; padding: 0 24px; }
  .hp61-trust__grid { display: flex; justify-content: center; gap: 50px; flex-wrap: wrap; }
  .hp61-trust__item { display: flex; align-items: center; gap: 14px; }
  .hp61-trust__icon {
    width: 44px; height: 44px; background: linear-gradient(135deg, #450A0A, #18181B);
    border-radius: 4px; display: flex; align-items: center; justify-content: center;
    font-size: 18px; color: #EF4444; flex-shrink: 0;
    border: 1px solid rgba(239, 68, 68, 0.35); box-shadow: 0 0 12px rgba(239, 68, 68, 0.2);
  }
  .hp61-trust__label { font-family: 'Syne', sans-serif; font-size: 15px; font-weight: 700; color: #FFFFFF; margin: 0; }
  .hp61-trust__sub { font-size: 11px; color: #EF4444; margin: 2px 0 0; font-family: 'Space Grotesk', sans-serif; letter-spacing: 0.5px; }
  @media screen and (max-width: 768px) { .hp61-trust__grid { gap: 24px; } }
  @media screen and (max-width: 480px) {
    .hp61-trust__grid { flex-direction: column; align-items: center; text-align: center; }
    .hp61-trust__item { flex-direction: column; }
  }
{%- endstyle -%}
<div class="hp61-trust__container">
  <div class="hp61-trust__grid">
    {%- for block in section.blocks -%}
      <div class="hp61-trust__item" {{ block.shopify_attributes }}>
        <div class="hp61-trust__icon">{{ block.settings.icon | default: '🌋' }}</div>
        <div>
          <p class="hp61-trust__label">{{ block.settings.title | default: '100% Geothermal Pure' }}</p>
          <p class="hp61-trust__sub">{{ block.settings.subtitle | default: 'Icelandic volcanic origin' }}</p>
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "HP61 Trust",
  "class": "section-hp61-trust",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#030712" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 100, "step": 10, "unit": "px", "label": "Padding Top", "default": 50 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 100, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 50 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "blocks": [{
    "type": "badge", "name": "Badge",
    "settings": [
      { "type": "text", "id": "icon", "label": "Icon", "default": "🌋" },
      { "type": "text", "id": "title", "label": "Title", "default": "100% Geothermal Pure" },
      { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Icelandic volcanic origin" }
    ]
  }],
  "presets": [{
    "name": "HP61 Trust",
    "blocks": [
      { "type": "badge", "settings": { "icon": "🌋", "title": "100% Geothermal Pure", "subtitle": "Icelandic volcanic origin" } },
      { "type": "badge", "settings": { "icon": "🧪", "title": "< 5 Micron Micronized", "subtitle": "Non-abrasive smooth touch" } },
      { "type": "badge", "settings": { "icon": "📦", "title": "Basalt Stone Jar Box", "subtitle": "Thermal ceramic packaging" } },
      { "type": "badge", "settings": { "icon": "🛡️", "title": "Thermal Pore Guarantee", "subtitle": "60-day satisfaction pledge" } }
    ]
  }]
}
{% endschema %}
