{% comment %} CL V17 — Cyber Neon {% endcomment %}
{{ 'component-facets.css' | asset_url | stylesheet_tag }}
<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
<style>
  .clv17 { background: {{ section.settings.bg_color | default: '#020617' }}; color: {{ section.settings.text_color | default: '#F472B6' }}; padding: 60px 20px; font-family: 'Rajdhani', sans-serif; }
  .clv17-hero { text-align: center; margin-bottom: 50px; }
  .clv17-hero h1 { font-size: 48px; font-weight: 700; color: #22D3EE; text-transform: uppercase; margin-bottom: 10px; text-shadow: 0 0 10px rgba(34,211,238,0.5); }
  .clv17-hero p { font-size: 18px; color: #94A3B8; max-width: 600px; margin: 0 auto; letter-spacing: 1px; }
  .clv17-chips { display: flex; gap: 15px; justify-content: center; margin-bottom: 40px; flex-wrap: wrap; }
  .clv17-chips a { padding: 10px 20px; background: transparent; color: #F472B6; border: 1px solid #F472B6; border-radius: 4px; text-decoration: none; font-size: 16px; font-weight: 600; text-transform: uppercase; transition: 0.3s; box-shadow: 0 0 5px rgba(244,114,182,0.2); }
  .clv17-chips a:hover, .clv17-chips a.active { background: #F472B6; color: #020617; box-shadow: 0 0 15px rgba(244,114,182,0.6); }
  .clv17-toolbar { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(34,211,238,0.3); padding-bottom: 20px; margin-bottom: 40px; }
  .clv17-grid { display: grid; grid-template-columns: repeat({{ section.settings.cols_desktop | default: 4 }}, 1fr); gap: 30px; }
  .clv17-promo { grid-column: span 1; background: #0F172A; border: 1px solid #22D3EE; box-shadow: inset 0 0 20px rgba(34,211,238,0.2); padding: 40px; text-align: center; display: flex; flex-direction: column; justify-content: center; }
  .clv17-promo h3 { font-size: 26px; font-weight: 700; color: #22D3EE; margin-bottom: 20px; text-transform: uppercase; }
  .clv17-promo a { display: inline-block; padding: 12px 25px; background: transparent; color: #22D3EE; border: 1px solid #22D3EE; text-decoration: none; font-size: 14px; font-weight: 700; text-transform: uppercase; transition: 0.3s; }
  .clv17-promo a:hover { background: #22D3EE; color: #020617; box-shadow: 0 0 15px rgba(34,211,238,0.5); }
  .clv17-seo { margin-top: 60px; text-align: center; padding: 40px; background: #0F172A; border: 1px solid rgba(244,114,182,0.3); }
  @media (max-width: 768px) { .clv17-grid { grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr); gap: 15px; } }
</style>
<div class="clv17" style="max-width: 1400px; margin: 0 auto;">
  <div class="clv17-hero">
    <h1>{% if collection.title != blank %}{{ collection.title | escape }}{% else %}SYSTEM OVERRIDE{% endif %}</h1>
    <p>{% if collection.description != blank %}{{ collection.description }}{% else %}Upload your style to the mainframes.{% endif %}</p>
  </div>
  {% if section.settings.sub_collections != blank %}
    <div class="clv17-chips">
      {% for link in section.settings.sub_collections.links %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% endfor %}
    </div>
  {% endif %}
  <div class="clv17-toolbar">
    <facet-filters-form style="width: 100%;">
      <form id="FacetFiltersForm" style="display: flex; justify-content: space-between; align-items: center; width: 100%; flex-wrap: wrap; gap: 20px;">
        <div style="display: flex; gap: 20px;">
          {%- for filter in collection.filters -%}
            <details style="position: relative;">
              <summary style="cursor: pointer; font-size: 16px; font-weight: 600; color: #22D3EE; text-transform: uppercase;">[{{ filter.label }}]</summary>
              <div style="position: absolute; background: #020617; border: 1px solid #22D3EE; padding: 20px; z-index: 10; margin-top: 15px; min-width: 220px; box-shadow: 0 0 15px rgba(34,211,238,0.2);">
                {%- for value in filter.values -%}
                  <label style="display: block; margin-bottom: 12px; cursor: pointer; font-size: 15px; color: #F472B6;">
                    <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %}>
                    {{ value.label }} ({{ value.count }})
                  </label>
                {%- endfor -%}
              </div>
            </details>
          {%- endfor -%}
        </div>
        <select name="sort_by" onchange="this.form.submit()" style="background: transparent; border: none; font-size: 16px; font-weight: 600; color: #22D3EE; text-transform: uppercase; cursor: pointer;">
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>Sort: {{ option.name }}</option>
          {%- endfor -%}
        </select>
      </form>
    </facet-filters-form>
  </div>
  {% assign limit_num = section.settings.products_per_page | default: 16 %}
  {% paginate collection.products by limit_num %}
    <div class="clv17-grid">
      {% for product in collection.products %}
        {% render 'card-v17', product: product %}
        {% if forloop.index == 8 and section.settings.show_promo_tile %}
          <div class="clv17-promo">
            <span style="font-size: 12px; color: #94A3B8; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 10px;">Access Granted</span>
            <h3>VIP LOUNGE</h3>
            <a href="/pages/vip">ENTER NOW</a>
          </div>
        {% endif %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v17', product: nil %}
        {% endfor %}
      {% endfor %}
    </div>
    <div style="margin-top: 50px; text-align: center; font-size: 18px; color: #22D3EE;">{{ paginate | default_pagination }}</div>
  {% endpaginate %}
  {% if section.settings.show_seo_block %}
    <div class="clv17-seo">
      <h2 style="font-size: 28px; font-weight: 700; color: #F472B6; margin-bottom: 15px; text-transform: uppercase;">{{ section.settings.seo_title | default: 'THE FUTURE IS NOW' }}</h2>
      <p style="font-size: 16px; color: #94A3B8; max-width: 700px; margin: 0 auto; line-height: 1.7;">{{ section.settings.seo_text | default: 'Embrace the aesthetic of tomorrow with high-contrast neon and synthetic textures.' }}</p>
    </div>
  {% endif %}
</div>
{% schema %}
{
  "name": "CL V17 — Cyber", "settings": [
    {"type": "range", "id": "products_per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 16},
    {"type": "range", "id": "cols_desktop", "label": "Desktop Columns", "min": 2, "max": 5, "default": 4},
    {"type": "select", "id": "cols_mobile", "label": "Mobile Columns", "options": [{"value": "1", "label": "1"}, {"value": "2", "label": "2"}], "default": "2"},
    {"type": "link_list", "id": "sub_collections", "label": "Sub-Collection Menu"},
    {"type": "checkbox", "id": "show_promo_tile", "label": "Show Promo Card", "default": true},
    {"type": "checkbox", "id": "show_seo_block", "label": "Show SEO Block", "default": true},
    {"type": "color", "id": "bg_color", "label": "Background Color", "default": "#020617"},
    {"type": "color", "id": "text_color", "label": "Text Color", "default": "#F472B6"}
  ], "presets": [{"name": "CL V17 — Cyber"}]
}
{% endschema %}
