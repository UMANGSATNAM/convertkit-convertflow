{%- liquid
  assign section_id = section.id
  assign image = section.settings.image
  assign heading = section.settings.heading | default: 'PERFORMANCE UNLEASHED'
  assign subheading = section.settings.subheading | default: 'Experience the next generation of computational power.'
  assign button_text = section.settings.button_text | default: 'INITIALIZE'
  assign button_link = section.settings.button_link | default: '#'
  assign accent_color = section.settings.accent_color | default: '#00ff88'
-%}

<style>
  #shopify-section-{{ section_id }} {
    position: relative;
    width: 100%;
    height: 90vh;
    min-height: 600px;
    background-color: #050505;
    overflow: hidden;
    display: flex;
    align-items: center;
  }
  
  .hp9-hero-bg-{{ section_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }
  
  .hp9-hero-bg-{{ section_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0.5; /* Darken for tech vibe */
  }
  
  /* Cyberpunk grid overlay */
  .hp9-hero-grid-{{ section_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: 
      linear-gradient(rgba(0, 255, 136, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 255, 136, 0.05) 1px, transparent 1px);
    background-size: 50px 50px;
    z-index: 2;
    pointer-events: none;
    transform: perspective(500px) rotateX(60deg) translateY(100px) translateZ(-200px);
    transform-origin: bottom;
    animation: hp9-grid-move-{{ section_id }} 10s linear infinite;
  }
  
  @keyframes hp9-grid-move-{{ section_id }} {
    0% { background-position: 0 0; }
    100% { background-position: 0 50px; }
  }
  
  .hp9-hero-overlay-{{ section_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at center, transparent 0%, #050505 80%);
    z-index: 3;
  }
  
  .hp9-hero-content-{{ section_id }} {
    position: relative;
    z-index: 4;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
    text-align: left;
  }
  
  .hp9-hero-tag-{{ section_id }} {
    display: inline-block;
    padding: 6px 12px;
    background: rgba(0, 255, 136, 0.1);
    border: 1px solid {{ accent_color }};
    color: {{ accent_color }};
    font-family: 'Space Mono', monospace;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 30px;
    border-radius: 2px;
    box-shadow: 0 0 10px rgba(0, 255, 136, 0.2);
    opacity: 0;
    transform: translateX(-20px);
    animation: hp9-fade-in-right-{{ section_id }} 0.8s ease forwards 0.2s;
  }
  
  .hp9-hero-heading-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: clamp(3rem, 6vw, 5.5rem);
    line-height: 1.05;
    font-weight: 900;
    margin: 0 0 25px 0;
    color: #ffffff;
    text-transform: uppercase;
    letter-spacing: -2px;
    opacity: 0;
    transform: translateX(-20px);
    animation: hp9-fade-in-right-{{ section_id }} 0.8s ease forwards 0.4s;
  }
  
  .hp9-hero-heading-{{ section_id }} span {
    color: {{ accent_color }};
    text-shadow: 0 0 15px rgba(0, 255, 136, 0.4);
  }
  
  .hp9-hero-subheading-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: clamp(1.1rem, 2vw, 1.3rem);
    font-weight: 400;
    color: rgba(255, 255, 255, 0.7);
    margin: 0 0 50px 0;
    max-width: 600px;
    line-height: 1.6;
    opacity: 0;
    transform: translateX(-20px);
    animation: hp9-fade-in-right-{{ section_id }} 0.8s ease forwards 0.6s;
  }
  
  .hp9-hero-btn-{{ section_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 18px 40px;
    background-color: {{ accent_color }};
    color: #000000;
    text-decoration: none;
    font-family: 'Space Mono', monospace;
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    position: relative;
    border: none;
    cursor: pointer;
    overflow: hidden;
    box-shadow: 0 0 20px rgba(0, 255, 136, 0.4);
    transition: all 0.3s ease;
    border-radius: 2px;
    opacity: 0;
    transform: translateX(-20px);
    animation: hp9-fade-in-right-{{ section_id }} 0.8s ease forwards 0.8s;
  }
  
  .hp9-hero-btn-{{ section_id }}::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.8), transparent);
    transition: left 0.5s ease;
  }
  
  .hp9-hero-btn-{{ section_id }}:hover {
    box-shadow: 0 0 30px rgba(0, 255, 136, 0.6);
    transform: translateY(-2px);
  }
  
  .hp9-hero-btn-{{ section_id }}:hover::before {
    left: 100%;
  }
  
  @keyframes hp9-fade-in-right-{{ section_id }} {
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  /* Glitch effect on heading */
  .hp9-hero-heading-{{ section_id }}:hover {
    animation: hp9-glitch-{{ section_id }} 0.3s cubic-bezier(.25, .46, .45, .94) both infinite;
  }

  @keyframes hp9-glitch-{{ section_id }} {
    0% { transform: translate(0) }
    20% { transform: translate(-2px, 2px) }
    40% { transform: translate(-2px, -2px) }
    60% { transform: translate(2px, 2px) }
    80% { transform: translate(2px, -2px) }
    100% { transform: translate(0) }
  }

  @media (max-width: 768px) {
    .hp9-hero-content-{{ section_id }} {
      padding: 0 20px;
    }
    .hp9-hero-heading-{{ section_id }} {
      font-size: clamp(2.5rem, 10vw, 3.5rem);
    }
  }
</style>

<div class="hp9-hero-bg-{{ section_id }}">
  {% if image != blank %}
    <img src="{{ image | image_url: width: 2000 }}" alt="{{ heading }}" loading="eager" width="2000" height="1200">
  {% else %}
    <!-- Placeholder Gradient -->
    <div style="width:100%; height:100%; background: radial-gradient(circle, #1a2a22 0%, #050505 100%);"></div>
  {% endif %}
</div>

<div class="hp9-hero-grid-{{ section_id }}"></div>
<div class="hp9-hero-overlay-{{ section_id }}"></div>

<div class="hp9-hero-content-{{ section_id }}">
  <div class="hp9-hero-tag-{{ section_id }}">SYSTEM_READY</div>
  <h1 class="hp9-hero-heading-{{ section_id }}">
    {% assign words = heading | split: ' ' %}
    {% for word in words %}
      {% if forloop.last %}
        <span>{{ word }}</span>
      {% else %}
        {{ word }}
      {% endif %}
    {% endfor %}
  </h1>
  {% if subheading != blank %}
    <p class="hp9-hero-subheading-{{ section_id }}">{{ subheading }}</p>
  {% endif %}
  {% if button_text != blank %}
    <a href="{{ button_link }}" class="hp9-hero-btn-{{ section_id }}">{{ button_text }}</a>
  {% endif %}
</div>

{% schema %}
{
  "name": "HP9 Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color (Neon)",
      "default": "#00ff88"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "PERFORMANCE UNLEASHED"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Experience the next generation of computational power and sleek design."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "INITIALIZE"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "HP9 Hero"
    }
  ]
}
{% endschema %}
