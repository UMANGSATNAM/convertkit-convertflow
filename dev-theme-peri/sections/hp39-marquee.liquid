{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --speed: {{ section.settings.speed }}s;
    
    --font-body: 'Outfit', sans-serif;
    
    padding: 20px 20px;
    background: transparent; /* Assuming section is placed over a gradient background or just white */
  }

  .hp39-marquee-wrapper {
    background: var(--bg-color);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 100px;
    padding: 15px 0;
    overflow: hidden;
    white-space: nowrap;
    display: flex;
    align-items: center;
    position: relative;
    box-shadow: 0 10px 30px rgba(0,0,0,0.03);
    max-width: 1400px;
    margin: 0 auto;
  }

  .hp39-marquee__track {
    display: inline-block;
    animation: hp39-scroll var(--speed) linear infinite;
  }
  
  .hp39-marquee__track:hover {
    animation-play-state: paused;
  }

  @keyframes hp39-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  .hp39-marquee__content {
    display: inline-flex;
    align-items: center;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .hp39-marquee__item {
    display: inline-flex;
    align-items: center;
    padding: 0 40px;
    font-family: var(--font-body);
    font-size: clamp(14px, 2vw, {{ section.settings.text_size }}px);
    font-weight: 500;
    color: var(--text-color);
    letter-spacing: 0.5px;
  }

  .hp39-marquee__separator {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--text-color);
    opacity: 0.3;
    margin: 0 10px;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp39-marquee-wrapper" id="HP39Marquee-{{ section.id }}">
  <div class="hp39-marquee__track">
    <ul class="hp39-marquee__content">
      {%- for block in section.blocks -%}
        <li class="hp39-marquee__item" {{ block.shopify_attributes }}>
          {{ block.settings.text }}
          <span class="hp39-marquee__separator"></span>
        </li>
      {%- endfor -%}
      {%- for block in section.blocks -%}
        <li class="hp39-marquee__item" aria-hidden="true">
          {{ block.settings.text }}
          <span class="hp39-marquee__separator"></span>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "HP39 - Aura Marquee",
  "class": "section-hp39-marquee",
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "s",
      "label": "Scroll Speed",
      "default": 30
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 12,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Text Size",
      "default": 16
    },
    {
      "type": "header",
      "content": "Aura Colors"
    },
    {
      "type": "color_background",
      "id": "bg_color",
      "label": "Glass Background",
      "default": "rgba(255, 255, 255, 0.5)"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2D2D2D"
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "text_block",
      "name": "Marquee Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Breathe Easy."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP39 - Aura Marquee",
      "blocks": [
        { "type": "text_block", "settings": { "text": "Free Shipping on Everything" } },
        { "type": "text_block", "settings": { "text": "Feel the Difference" } },
        { "type": "text_block", "settings": { "text": "Cloud-Like Comfort" } }
      ]
    }
  ]
}
{% endschema %}
