{%- liquid
  assign bg_color = section.settings.bg_color | default: '#0a0a0a'
  assign text_color = section.settings.text_color | default: '#ffffff'
  
  assign padding_top_desktop = section.settings.padding_top_desktop
  assign padding_bottom_desktop = section.settings.padding_bottom_desktop
  assign padding_top_mobile = section.settings.padding_top_mobile
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile
-%}

<style>
  #shopify-section-{{ section.id }} {
    --hp6-ugc-bg: {{ bg_color }};
    --hp6-ugc-text: {{ text_color }};
    
    --hp6-ugc-pt-desk: {{ padding_top_desktop }}px;
    --hp6-ugc-pb-desk: {{ padding_bottom_desktop }}px;
    --hp6-ugc-pt-mob: {{ padding_top_mobile }}px;
    --hp6-ugc-pb-mob: {{ padding_bottom_mobile }}px;
  }

  .hp6-sports-ugc-{{ section.id }} {
    padding-top: var(--hp6-ugc-pt-desk);
    padding-bottom: var(--hp6-ugc-pb-desk);
    background-color: var(--hp6-ugc-bg);
    overflow: hidden;
  }

  .hp6-ugc-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .hp6-ugc-header {
    text-align: center;
    margin-bottom: 50px;
  }
  .hp6-ugc-title {
    font-family: 'Oswald', sans-serif;
    font-size: clamp(32px, 4vw, 56px);
    font-weight: 700;
    text-transform: uppercase;
    color: var(--hp6-ugc-text);
    margin: 0;
  }
  .hp6-ugc-subtitle {
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    color: rgba(255,255,255,0.6);
    margin: 10px 0 0 0;
  }

  /* Reel Carousel */
  .hp6-ugc-carousel {
    position: relative;
    width: 100%;
  }
  .hp6-ugc-track {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none; /* Firefox */
    padding-bottom: 20px;
  }
  .hp6-ugc-track::-webkit-scrollbar { display: none; }

  .hp6-ugc-item {
    flex: 0 0 calc(20% - 16px);
    min-width: 250px;
    aspect-ratio: 9/16;
    background: #111;
    border-radius: 12px;
    overflow: hidden;
    position: relative;
    scroll-snap-align: start;
    cursor: pointer;
    box-shadow: 0 10px 20px rgba(0,0,0,0.5);
  }

  .hp6-ugc-media {
    width: 100%; height: 100%; object-fit: cover;
  }

  .hp6-ugc-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.8) 0%, transparent 50%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 20px;
    pointer-events: none;
  }

  .hp6-ugc-handle {
    font-family: 'Oswald', sans-serif;
    font-size: 16px;
    font-weight: 700;
    color: #fff;
    margin: 0 0 5px 0;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .hp6-ugc-handle svg { width: 14px; height: 14px; fill: #ff4500; }

  .hp6-ugc-caption {
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    color: rgba(255,255,255,0.8);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .hp6-ugc-play {
    position: absolute;
    top: 20px; right: 20px;
    width: 30px; height: 30px;
    background: rgba(255,255,255,0.2);
    backdrop-filter: blur(5px);
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    color: #fff;
  }
  .hp6-ugc-play svg { width: 12px; height: 12px; fill: currentColor; margin-left: 2px;}

  @media screen and (max-width: 1024px) {
    .hp6-ugc-item { flex: 0 0 calc(33.333% - 14px); min-width: 200px; }
  }
  @media screen and (max-width: 768px) {
    .hp6-sports-ugc-{{ section.id }} {
      padding-top: var(--hp6-ugc-pt-mob);
      padding-bottom: var(--hp6-ugc-pb-mob);
    }
    .hp6-ugc-inner { padding: 0 20px; }
    .hp6-ugc-item { flex: 0 0 calc(70% - 10px); min-width: auto; }
    .hp6-ugc-track { gap: 10px; }
  }
</style>

<section class="hp6-sports-ugc-{{ section.id }}" aria-label="Community Reels">
  <div class="hp6-ugc-inner">
    
    <div class="hp6-ugc-header">
      <h2 class="hp6-ugc-title">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="hp6-ugc-subtitle">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="hp6-ugc-carousel">
      <div class="hp6-ugc-track">
        {%- for block in section.blocks -%}
          <div class="hp6-ugc-item" {{ block.shopify_attributes }}>
            {%- if block.settings.video != blank -%}
              {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, class: 'hp6-ugc-media' }}
            {%- elsif block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 600 }}" class="hp6-ugc-media" loading="lazy" alt="UGC">
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'hp6-ugc-media placeholder-svg' }}
            {%- endif -%}

            <div class="hp6-ugc-play">
              <svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
            </div>

            <div class="hp6-ugc-overlay">
              <div class="hp6-ugc-handle">
                <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
                {{ block.settings.handle | default: '@athlete' }}
              </div>
              {%- if block.settings.caption != blank -%}
                <p class="hp6-ugc-caption">{{ block.settings.caption }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}

        {%- if section.blocks.size == 0 -%}
          {%- for i in (1..6) -%}
            <div class="hp6-ugc-item">
              {{ 'collection-' | append: i | placeholder_svg_tag: 'hp6-ugc-media placeholder-svg' }}
              <div class="hp6-ugc-play"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></div>
              <div class="hp6-ugc-overlay">
                <div class="hp6-ugc-handle"><svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg> @pro_athlete</div>
                <p class="hp6-ugc-caption">Best gear for the toughest workouts.</p>
              </div>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "HP6 Sports UGC Reels",
  "tag": "section",
  "class": "section-hp6-ugc",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "IN THE ZONE"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Tag us to be featured on our official channel."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#0a0a0a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Top (Desktop)", "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Bottom (Desktop)", "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Top (Mobile)", "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Bottom (Mobile)", "default": 50
    }
  ],
  "blocks": [
    {
      "type": "reel",
      "name": "UGC Reel",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Video (Vertical recommended)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Fallback Image"
        },
        {
          "type": "text",
          "id": "handle",
          "label": "User Handle",
          "default": "@athlete"
        },
        {
          "type": "textarea",
          "id": "caption",
          "label": "Caption",
          "default": "Crushing PRs today!"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP6 Sports UGC Reels",
      "category": "Social",
      "blocks": [
        { "type": "reel" }, { "type": "reel" }, { "type": "reel" },
        { "type": "reel" }, { "type": "reel" }
      ]
    }
  ]
}
{% endschema %}
