{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,100..900;1,9..144,100..900&family=Outfit:wght@300;400;600;800&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --font-heading: 'Fraunces', serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    position: relative;
    overflow: hidden;
    /* Thick wavy top/bottom borders could be simulated, but we'll use thick solid borders for the 70s look */
    border-top: 4px solid var(--text-color);
    border-bottom: 4px solid var(--text-color);
    box-shadow: 0 8px 0 var(--accent-color);
    margin-bottom: 8px; /* space for the shadow */
  }

  .hp25-marquee-wrapper {
    display: flex;
    overflow: hidden;
    user-select: none;
    position: relative;
    width: 100vw;
    margin-left: calc(-50vw + 50%);
  }

  .hp25-marquee__track {
    display: flex;
    white-space: nowrap;
    animation: scrollMarquee25 {{ section.settings.speed }}s linear infinite;
    {% if section.settings.direction == 'right' %}
      animation-direction: reverse;
    {% endif %}
  }

  .hp25-marquee__track:hover {
    {% if section.settings.pause_on_hover %}
      animation-play-state: paused;
    {% endif %}
  }

  @keyframes scrollMarquee25 {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  .hp25-marquee__content {
    display: flex;
    align-items: center;
    padding: 0 15px;
  }

  .hp25-marquee__text {
    font-family: var(--font-heading);
    font-size: clamp(32px, 5vw, {{ section.settings.text_size }}px);
    font-weight: 900;
    font-style: italic;
    color: var(--text-color);
    padding: 0 20px;
    text-transform: uppercase;
    letter-spacing: -1px;
    /* 3D shadow effect */
    text-shadow: 2px 2px 0 var(--accent-color), 3px 3px 0 var(--accent-color);
  }

  .hp25-marquee__divider {
    color: var(--accent-color);
    font-size: clamp(24px, 4vw, {{ section.settings.text_size | times: 0.8 }}px);
    padding: 0 10px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .hp25-marquee__divider svg {
    width: 1em;
    height: 1em;
    fill: currentColor;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp25-marquee-wrapper" id="HP25Marquee-{{ section.id }}">
  <div class="hp25-marquee__track">
    {%- for i in (1..4) -%}
      <div class="hp25-marquee__content">
        {%- for block in section.blocks -%}
          <div class="hp25-marquee__text" {{ block.shopify_attributes }}>
            {{ block.settings.text }}
          </div>
          <div class="hp25-marquee__divider">
            {%- if section.settings.icon_style == 'flower' -%}
              <svg viewBox="0 0 24 24"><path d="M12,2C14.76,2 17,4.24 17,7C17,8.38 16.44,9.63 15.54,10.54C16.45,11.44 17.71,12 19,12C21.76,12 24,14.24 24,17C24,19.76 21.76,22 19,22C17.62,22 16.37,21.44 15.46,20.54C14.56,21.45 13.3,22 12,22C9.24,22 7,19.76 7,17C7,15.62 7.56,14.37 8.46,13.46C7.55,12.56 6.29,12 5,12C2.24,12 0,9.76 0,7C0,4.24 2.24,2 5,2C6.38,2 7.63,2.56 8.54,3.46C9.44,2.55 10.7,2 12,2M12,10A2,2 0 0,0 10,12A2,2 0 0,0 12,14A2,2 0 0,0 14,12A2,2 0 0,0 12,10Z"/></svg>
            {%- elsif section.settings.icon_style == 'star' -%}
              <svg viewBox="0 0 24 24"><path d="M12,17.27L18.18,21L16.54,13.97L22,9.24L14.81,8.62L12,2L9.19,8.62L2,9.24L7.45,13.97L5.82,21L12,17.27Z"/></svg>
            {%- else -%}
              <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"/></svg>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "HP25 - Retro Marquee",
  "class": "section-hp25-marquee",
  "settings": [
    {
      "type": "header",
      "content": "Marquee Settings"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "s",
      "label": "Animation Speed",
      "default": 30
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Direction",
      "options": [
        { "value": "left", "label": "Right to Left" },
        { "value": "right", "label": "Left to Right" }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on Hover",
      "default": true
    },
    {
      "type": "select",
      "id": "icon_style",
      "label": "Divider Icon",
      "options": [
        { "value": "flower", "label": "Flower Power" },
        { "value": "star", "label": "Retro Star" },
        { "value": "circle", "label": "Dot" }
      ],
      "default": "flower"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 24,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Text Size",
      "default": 64
    },
    {
      "type": "header",
      "content": "Retro 70s Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (Mustard)",
      "default": "#E2B144"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text (Dark Brown)",
      "default": "#3E2723"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Shadow/Icon (Cream)",
      "default": "#F5E6D3"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 20
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text Block",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "STAY GROOVY"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP25 - Retro Marquee",
      "blocks": [
        { "type": "text", "settings": { "text": "GOOD VIBES ONLY" } },
        { "type": "text", "settings": { "text": "RETRO REIMAGINED" } },
        { "type": "text", "settings": { "text": "FREE SHIPPING WORLDWIDE" } }
      ]
    }
  ]
}
{% endschema %}
