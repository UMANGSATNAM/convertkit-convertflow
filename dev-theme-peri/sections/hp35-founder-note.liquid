{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;1,400&family=Nunito:wght@300;400;600&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    
    --font-heading: 'Lora', serif;
    --font-body: 'Nunito', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .hp35-founder-wrapper {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    align-items: center;
    gap: 100px;
  }

  @media screen and (max-width: 992px) {
    .hp35-founder-wrapper {
      flex-direction: column;
      gap: 50px;
      padding: 0 20px;
    }
  }

  .hp35-founder__image-col {
    flex: 1;
    position: relative;
  }

  .hp35-founder__image-wrap {
    aspect-ratio: 3/4;
    position: relative;
    border-radius: 200px 200px 0 0;
    overflow: hidden;
  }

  .hp35-founder__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .hp35-founder__badge {
    position: absolute;
    bottom: -30px; right: -30px;
    width: 120px; height: 120px;
    background: var(--text-color);
    color: var(--bg-color);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-size: 14px;
    font-style: italic;
    text-align: center;
    padding: 20px;
    line-height: 1.2;
    z-index: 2;
  }

  .hp35-founder__content-col {
    flex: 1.2;
  }

  .hp35-founder__subtitle {
    font-family: var(--font-body);
    font-size: 13px;
    color: var(--accent-color);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-bottom: 20px;
    font-weight: 600;
  }

  .hp35-founder__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    line-height: 1.2;
    color: var(--text-color);
    margin: 0 0 30px;
    font-weight: 400;
  }

  .hp35-founder__text {
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.8;
    color: var(--text-color);
    margin: 0 0 40px;
    font-weight: 300;
  }

  .hp35-founder__signature {
    font-family: var(--font-heading);
    font-size: 32px;
    font-style: italic;
    color: var(--accent-color);
    margin-bottom: 10px;
  }

  .hp35-founder__name {
    font-family: var(--font-body);
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-color);
    opacity: 0.6;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp35-founder-wrapper" id="HP35Founder-{{ section.id }}">
  <div class="hp35-founder__image-col">
    <div class="hp35-founder__image-wrap">
      {%- if section.settings.image != blank -%}
        <img height="{{ section.settings.image.height }}" width="{{ section.settings.image.width }}" src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.title | escape }}" class="hp35-founder__image" loading="lazy">
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'hp35-founder__image' }}
      {%- endif -%}
    </div>
    <div class="hp35-founder__badge">Designed<br>with love</div>
  </div>

  <div class="hp35-founder__content-col">
    {%- if section.settings.subtitle != blank -%}
      <div class="hp35-founder__subtitle">{{ section.settings.subtitle }}</div>
    {%- endif -%}
    
    <h2 class="hp35-founder__title">{{ section.settings.title }}</h2>
    
    <div class="hp35-founder__text">
      {{ section.settings.text }}
    </div>
    
    <div class="hp35-founder__signature">{{ section.settings.signature }}</div>
    <div class="hp35-founder__name">{{ section.settings.name }}</div>
  </div>
</div>

{% schema %}
{
  "name": "HP35 - Organic Founder",
  "class": "section-hp35-founder-note",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "A LETTER FROM US"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Creating space for what matters."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>When we started this journey, our goal was simple: to create objects that invite pause. We live in a fast-paced world, and we wanted to craft pieces that encourage you to slow down, breathe, and appreciate the present moment.</p><p>Every curve, every texture is designed to bring a sense of calm and harmony into your daily rituals.</p>"
    },
    {
      "type": "text",
      "id": "signature",
      "label": "Signature",
      "default": "Elena & Markus"
    },
    {
      "type": "text",
      "id": "name",
      "label": "Name & Title",
      "default": "FOUNDERS"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 48
    },
    {
      "type": "header",
      "content": "Organic Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#FDFBF7"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2C422F"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#CC7B5E"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 100
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP35 - Organic Founder"
    }
  ]
}
{% endschema %}
