{%- comment -%}
  PC V21 — BAUHAUS FUNCTIONAL PRODUCT GRID
  Design: Warm Parchment (#F7F4EB), Crimson (#E63946) & Cobalt (#1D3557) accents
  Card Shape: Primary geometric shapes, bold 2px borders, Space Grotesk typography
{%- endcomment -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&display=swap');

  .pcv21 {
    --bg: {{ section.settings.bg_color | default: '#F7F4EB' }};
    --card-bg: {{ section.settings.card_bg | default: '#FFFFFF' }};
    --text: {{ section.settings.text_color | default: '#1D3557' }};
    --muted: {{ section.settings.muted_color | default: '#457B9D' }};
    --accent: {{ section.settings.accent_color | default: '#E63946' }};
    --accent-hover: {{ section.settings.accent_hover | default: '#C1121F' }};
    --border: {{ section.settings.border_color | default: '#1D3557' }};
    --badge-sale-bg: #E63946;
    --badge-sale-text: #FFFFFF;
    --f-main: 'Space Grotesk', sans-serif;
    --ease: all 0.2s ease;
    background-color: var(--bg);
    color: var(--text);
    font-family: var(--f-main);
    padding: {{ section.settings.padding_top | default: 60 }}px 0 {{ section.settings.padding_bottom | default: 60 }}px 0;
    line-height: 1.4;
    -webkit-font-smoothing: antialiased;
  }

  .pcv21 *, .pcv21 *::before, .pcv21 *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .pcv21 a { color: inherit; text-decoration: none; }
  .pcv21 button { font-family: inherit; cursor: pointer; border: none; background: none; }
  .pcv21 img { max-width: 100%; display: block; }

  .pcv21__wrap { max-width: 1280px; margin: 0 auto; padding: 0 20px; }

  /* HEADER */
  .pcv21__head { display: flex; flex-direction: column; gap: 8px; margin-bottom: 36px; border-bottom: 3px solid var(--border); padding-bottom: 20px; text-align: {{ section.settings.header_align | default: 'left' }}; }
  @media (min-width: 768px) {
    .pcv21__head { display: flex; flex-direction: row; justify-content: space-between; align-items: flex-end; }
  }
  .pcv21__title { font-size: 32px; font-weight: 700; color: var(--text); letter-spacing: -0.03em; text-transform: uppercase; }
  @media (min-width: 768px) { .pcv21__title { font-size: 42px; } }
  .pcv21__sub { font-size: 15px; color: var(--muted); font-weight: 500; }
  .pcv21__viewall { display: inline-flex; align-items: center; gap: 6px; font-weight: 700; font-size: 13px; text-transform: uppercase; color: #FFFFFF; background: var(--border); border: 2px solid var(--border); padding: 8px 18px; transition: var(--ease); }
  .pcv21__viewall:hover { background: var(--accent); border-color: var(--accent); }

  /* GRID */
  .pcv21__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr);
    gap: 20px;
  }
  @media (min-width: 640px) {
    .pcv21__grid { grid-template-columns: repeat({{ section.settings.cols_tablet | default: 3 }}, 1fr); gap: 24px; }
  }
  @media (min-width: 1024px) {
    .pcv21__grid { grid-template-columns: repeat({{ section.settings.cols_desktop | default: 4 }}, 1fr); gap: 28px; }
  }

  /* CARD */
  .pcv21__card {
    background: var(--card-bg);
    border: 2px solid var(--border);
    border-radius: 0px;
    display: flex;
    flex-direction: column;
    position: relative;
    box-shadow: 4px 4px 0 var(--border);
    transition: var(--ease);
  }
  .pcv21__card:hover {
    transform: translate(-3px, -3px);
    box-shadow: 7px 7px 0 var(--accent);
    border-color: var(--accent);
  }

  /* IMAGE BOX */
  .pcv21__img-box {
    position: relative;
    width: 100%;
    aspect-ratio: {{ section.settings.img_ratio | default: '1/1' }};
    background: #EAE5D9;
    overflow: hidden;
    border-bottom: 2px solid var(--border);
  }
  .pcv21__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  .pcv21__img--sec {
    position: absolute;
    top: 0; left: 0;
    opacity: 0;
  }
  .pcv21__card:hover .pcv21__img--pri {
    {% if section.settings.enable_sec_img %}
      opacity: 0;
    {% else %}
      transform: scale(1.04);
    {% endif %}
  }
  .pcv21__card:hover .pcv21__img--sec { opacity: 1; transform: scale(1.04); }

  /* BADGES */
  .pcv21__badges { position: absolute; top: 10px; left: 10px; display: flex; flex-direction: column; gap: 6px; z-index: 2; pointer-events: none; }
  .pcv21__badge { font-size: 11px; font-weight: 700; text-transform: uppercase; padding: 4px 8px; border: 1px solid var(--border); letter-spacing: 0.05em; }
  .pcv21__badge--sale { background: var(--badge-sale-bg); color: var(--badge-sale-text); }
  .pcv21__badge--tag { background: #F4A261; color: #1D3557; }
  .pcv21__badge--sold { background: #457B9D; color: #FFFFFF; }

  /* WISHLIST BUTTON */
  .pcv21__wish {
    position: absolute;
    top: 10px; right: 10px;
    width: 36px; height: 36px;
    background: #FFFFFF;
    border: 2px solid var(--border);
    display: flex; align-items: center; justify-content: center;
    color: var(--text);
    z-index: 3;
    transition: var(--ease);
  }
  .pcv21__wish:hover { background: var(--accent); color: #FFFFFF; border-color: var(--accent); }
  .pcv21__wish.active { background: var(--accent); color: #FFFFFF; border-color: var(--accent); }

  /* QUICK ADD BUTTON */
  .pcv21__quick-box { padding: 12px; background: var(--card-bg); border-top: 2px solid var(--border); }
  .pcv21__quick-btn {
    width: 100%;
    padding: 10px 14px;
    background: var(--border);
    color: #FFFFFF;
    font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;
    border: none;
    display: flex; align-items: center; justify-content: center; gap: 8px;
    transition: var(--ease);
  }
  .pcv21__quick-btn:hover { background: var(--accent); }
  .pcv21__quick-btn:disabled { background: #A8DADC; color: #1D3557; cursor: not-allowed; }

  /* CARD CONTENT */
  .pcv21__content { padding: 14px; display: flex; flex-direction: column; gap: 6px; flex-grow: 1; }

  .pcv21__vendor { font-size: 11px; text-transform: uppercase; color: var(--accent); font-weight: 700; letter-spacing: 0.08em; }
  .pcv21__item-title { font-size: 15px; font-weight: 700; color: var(--text); line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  /* RATING */
  .pcv21__rating { display: flex; align-items: center; gap: 6px; font-size: 12px; color: var(--accent); font-weight: 700; }
  .pcv21__stars { letter-spacing: 1px; }
  .pcv21__rev-cnt { color: var(--muted); font-size: 11px; }

  /* PRICE */
  .pcv21__price-row { display: flex; align-items: baseline; gap: 8px; margin-top: auto; padding-top: 4px; }
  .pcv21__price { font-size: 17px; font-weight: 700; color: var(--text); }
  .pcv21__cmp-price { font-size: 13px; color: var(--muted); text-decoration: line-through; }

  /* SWATCHES */
  .pcv21__swatches { display: flex; gap: 6px; align-items: center; margin-top: 4px; }
  .pcv21__swatch { width: 14px; height: 14px; border: 2px solid var(--border); cursor: pointer; transition: var(--ease); }
  .pcv21__swatch:hover, .pcv21__swatch.active { border-color: var(--accent); background: var(--accent); }

  /* URGENCY MICRO */
  .pcv21__urgency { font-size: 11px; color: var(--accent); font-weight: 700; text-transform: uppercase; display: flex; align-items: center; gap: 4px; margin-top: 2px; }

  /* TOAST */
  .pcv21__toast {
    position: fixed; bottom: 20px; right: 20px;
    background: var(--accent); color: #FFFFFF;
    border: 2px solid var(--border); padding: 12px 20px;
    font-size: 12px; font-weight: 700; text-transform: uppercase;
    z-index: 9999;
    transform: translateY(100px); opacity: 0;
    transition: all 0.2s ease;
  }
  .pcv21__toast.show { transform: translateY(0); opacity: 1; }
</style>

<div class="pcv21">
  <div class="pcv21__wrap">
    
    {% if section.settings.title != blank or section.settings.subheading != blank %}
      <div class="pcv21__head">
        <div>
          {% if section.settings.title != blank %}
            <h2 class="pcv21__title">{{ section.settings.title | escape }}</h2>
          {% endif %}
          {% if section.settings.subheading != blank %}
            <p class="pcv21__sub">{{ section.settings.subheading | escape }}</p>
          {% endif %}
        </div>
        {% if section.settings.show_view_all and section.settings.collection != blank %}
          <a href="{{ collections[section.settings.collection].url }}" class="pcv21__viewall">
            {{ section.settings.view_all_label | default: 'View Bauhaus Catalog' }} &rarr;
          </a>
        {% endif %}
      </div>
    {% endif %}

    <div class="pcv21__grid">
      {% assign target_coll = collections[section.settings.collection] %}
      {% assign limit_num = section.settings.products_per_page | default: 8 %}

      {% if target_coll != blank and target_coll.products.size > 0 %}
        {% for product in target_coll.products limit: limit_num %}
          {% assign current_variant = product.selected_or_first_available_variant %}
          
          {% render 'card-v21', product: product, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v21', product: nil, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% endif %}
    </div>

  </div>
</div>

<div class="pcv21__toast" id="pcv21-toast">BAUHAUS ITEM ADDED</div>

<script>
(function(){
  // Wishlist is handled globally by assets/wishlist.js (shared store: cf_wishlist_items).
  // Buttons are rendered by snippets/wishlist-button.liquid — no per-section storage.


  document.querySelectorAll('[data-pcv21-add]').forEach(function(btn){
    btn.addEventListener('click', function(e){
      e.preventDefault(); e.stopPropagation();
      var id = btn.dataset.pcv21Add, orig = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = 'ADDING...';

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: id, quantity: 1 })
      })
      .then(function(r){ return r.json(); })
      .then(function(){
        btn.innerHTML = '✓ ADDED';
        showT('BAUHAUS ITEM ADDED');
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      })
      .catch(function(){
        btn.innerHTML = 'ERROR';
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      });
    });
  });

  function showT(msg){
    var t = document.getElementById('pcv21-toast');
    if(!t) return;
    t.textContent = msg;
    t.classList.add('show');
    setTimeout(function(){ t.classList.remove('show'); }, 3000);
  }
})();
</script>

{% schema %}
