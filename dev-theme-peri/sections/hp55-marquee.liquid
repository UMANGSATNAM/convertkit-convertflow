<style>
@media screen and (max-width: 768px) {
  .hp55-marquee {
    padding-left: 16px !important;
    padding-right: 16px !important;
    box-sizing: border-box !important;
  }
  img {
    max-width: 100% !important;
    height: auto !important;
  }
}
</style>
{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp55-marq-bg: {{ section.settings.bg_color | default: '#2A0E22' }};
    --hp55-marq-text: {{ section.settings.text_color | default: '#F3E8FF' }};
    background: var(--hp55-marq-bg);
    overflow: hidden;
    padding: {{ section.settings.padding_vertical | default: 10 }}px 0;
  }
  .hp55-marquee__track {
    display: flex; gap: 50px;
    animation: hp55MarqueeScroll {{ section.settings.speed | default: 25 }}s linear infinite;
    width: max-content;
  }
  .hp55-marquee__item {
    display: flex; align-items: center; gap: 50px; white-space: nowrap;
    font-family: 'Playfair Display', serif;
    font-size: {{ section.settings.font_size | default: 14 }}px;
    font-weight: 600; letter-spacing: 3px; text-transform: uppercase;
    color: var(--hp55-marq-text);
  }
  .hp55-marquee__dot {
    width: 6px; height: 6px;
    background: {{ section.settings.dot_color | default: '#C084FC' }};
    border-radius: 50%; flex-shrink: 0;
  }
  @keyframes hp55MarqueeScroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
{%- endstyle -%}
<div class="hp55-marquee__track">
  {%- for i in (1..12) -%}
    <div class="hp55-marquee__item">
      <span>{{ section.settings.marquee_text | default: '✦ ROYAL PLUM ✦ SOUTH SEA PEARL ✦ BLACK ORCHID ✦ BIO-LIPIDS' }}</span>
      <span class="hp55-marquee__dot"></span>
    </div>
  {%- endfor -%}
</div>
{% schema %}
{
  "name": "HP55 - Plum Marquee",
  "class": "section-hp55-marquee",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#2A0E22" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#F3E8FF" },
    { "type": "color", "id": "dot_color", "label": "Dot Color", "default": "#C084FC" },
    { "type": "text", "id": "marquee_text", "label": "Marquee Text", "default": "✦ ROYAL PLUM ✦ SOUTH SEA PEARL ✦ BLACK ORCHID ✦ BIO-LIPIDS" },
    { "type": "range", "id": "speed", "min": 10, "max": 50, "step": 5, "unit": "s", "label": "Speed", "default": 25 },
    { "type": "range", "id": "font_size", "min": 10, "max": 22, "step": 1, "unit": "px", "label": "Font Size", "default": 14 },
    { "type": "range", "id": "padding_vertical", "min": 4, "max": 24, "step": 2, "unit": "px", "label": "Padding", "default": 10 }
  ],
  "presets": [{ "name": "HP55 - Plum Marquee" }]
}
{% endschema %}
