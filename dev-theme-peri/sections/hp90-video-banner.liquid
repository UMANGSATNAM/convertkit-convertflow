{%- style -%}#shopify-section-{{ section.id }}{background:#000;color:#fff;padding:60px 24px;text-align:center;position:relative;overflow:hidden}.hp90-vid{max-width:900px;margin:0 auto;position:relative;z-index:1}.hp90-vid__play{width:64px;height:64px;border-radius:50%;background:#fff;color:#000;display:inline-flex;align-items:center;justify-content:center;font-size:22px;margin-bottom:18px;text-decoration:none}{%- endstyle -%}<div class="hp90-vid"><a href="{{ section.settings.url }}" class="hp90-vid__play">▶</a><h2 style="font-family:Syne,sans-serif;font-size:28px;font-weight:800;margin:0">{{ section.settings.heading | default: 'See food in Motion' }}</h2><p style="opacity:.7;margin:10px 0 0">{{ section.settings.sub | default: 'Small-batch, artisan & organic staples curated for honest kitchens.' }}</p></div>{% schema %}{"name":"HP90 Video","settings":[{"type":"text","id":"heading","label":"Heading","default":"See food in Motion"},{"type":"text","id":"sub","label":"Sub","default":"Small-batch, artisan & organic staples curated for honest kitchens."},{"type":"url","id":"url","label":"Video URL"}],"presets":[{"name":"HP90 Video"}]}{% endschema %}