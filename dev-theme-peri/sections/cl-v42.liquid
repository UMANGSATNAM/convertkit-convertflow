{% comment %} CL V42 — Luxury Spa (Minimal Beige) {% endcomment %}
{{ 'component-facets.css' | asset_url | stylesheet_tag }}
<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
<style>
  .clv42 { background: {{ section.settings.bg_color | default: '#FAFAF9' }}; color: {{ section.settings.text_color | default: '#44403C' }}; padding: 60px 20px; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-weight: 300; }
  .clv42-hero { text-align: center; margin-bottom: 60px; padding: 0 20px; }
  .clv42-hero h1 { font-size: 36px; font-weight: 300; color: #292524; margin-bottom: 20px; letter-spacing: 3px; text-transform: uppercase; }
  .clv42-hero p { font-size: 14px; color: #78716C; max-width: 500px; margin: 0 auto; line-height: 1.8; letter-spacing: 0.5px; }
  .clv42-chips { display: flex; gap: 30px; justify-content: center; margin-bottom: 60px; flex-wrap: wrap; }
  .clv42-chips a { padding: 5px 0; color: #78716C; text-decoration: none; font-size: 13px; text-transform: uppercase; letter-spacing: 2px; position: relative; transition: 0.3s; }
  .clv42-chips a::after { content: ''; position: absolute; bottom: 0; left: 0; width: 0%; height: 1px; background: #292524; transition: 0.3s; }
  .clv42-chips a:hover, .clv42-chips a.active { color: #292524; }
  .clv42-chips a:hover::after, .clv42-chips a.active::after { width: 100%; }
  .clv42-toolbar { display: flex; justify-content: space-between; align-items: center; padding: 20px 0; border-top: 1px solid #E7E5E4; border-bottom: 1px solid #E7E5E4; margin-bottom: 50px; }
  .clv42-grid { display: grid; grid-template-columns: repeat({{ section.settings.cols_desktop | default: 4 }}, 1fr); gap: 40px 20px; }
  .clv42-promo { grid-column: span 1; background: #F5F5F4; padding: 40px; text-align: center; display: flex; flex-direction: column; justify-content: center; align-items: center; border: 1px solid #E7E5E4; }
  .clv42-promo h3 { font-size: 20px; font-weight: 300; margin-bottom: 20px; letter-spacing: 1px; color: #292524; }
  .clv42-promo a { display: inline-block; padding: 12px 30px; background: #292524; color: #FFF; text-decoration: none; font-size: 11px; letter-spacing: 2px; text-transform: uppercase; transition: background 0.3s; }
  .clv42-promo a:hover { background: #57534E; }
  .clv42-seo { margin-top: 80px; text-align: center; max-width: 700px; margin-left: auto; margin-right: auto; }
  @media (max-width: 768px) { .clv42-grid { grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr); gap: 20px; } .clv42-hero h1 { font-size: 28px; } }
</style>
<div class="clv42" style="max-width: 1400px; margin: 0 auto;">
  <div class="clv42-hero">
    <h1>{% if collection.title != blank %}{{ collection.title | escape }}{% else %}THE SANCTUARY{% endif %}</h1>
    <p>{% if collection.description != blank %}{{ collection.description }}{% else %}Curated essentials for moments of profound calm and restoration.{% endif %}</p>
  </div>
  {% if section.settings.sub_collections != blank %}
    <div class="clv42-chips">
      {% for link in section.settings.sub_collections.links %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% endfor %}
    </div>
  {% endif %}
  <div class="clv42-toolbar">
    <facet-filters-form style="width: 100%;">
      <form id="FacetFiltersForm" style="display: flex; justify-content: space-between; align-items: center; width: 100%; flex-wrap: wrap; gap: 20px;">
        <div style="display: flex; gap: 30px;">
          {%- for filter in collection.filters -%}
            <details style="position: relative;">
              <summary style="cursor: pointer; font-size: 11px; letter-spacing: 2px; text-transform: uppercase; color: #78716C;">{{ filter.label }}</summary>
              <div style="position: absolute; background: #FFF; border: 1px solid #E7E5E4; padding: 25px; z-index: 10; margin-top: 15px; min-width: 250px; box-shadow: 0 15px 40px rgba(0,0,0,0.03);">
                {%- for value in filter.values -%}
                  <label style="display: block; margin-bottom: 15px; cursor: pointer; font-size: 13px; color: #44403C; font-weight: 300;">
                    <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} style="margin-right: 10px;">
                    {{ value.label }} <span style="color: #A8A29E; font-size: 11px;">({{ value.count }})</span>
                  </label>
                {%- endfor -%}
              </div>
            </details>
          {%- endfor -%}
        </div>
        <select name="sort_by" onchange="this.form.submit()" style="background: transparent; border: none; color: #44403C; font-size: 11px; letter-spacing: 2px; text-transform: uppercase; cursor: pointer; outline: none;">
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>
          {%- endfor -%}
        </select>
      </form>
    </facet-filters-form>
  </div>
  {% assign limit_num = section.settings.products_per_page | default: 12 %}
  {% paginate collection.products by limit_num %}
    <div class="clv42-grid">
      {% for product in collection.products %}
        {% render 'card-v42', product: product %}
        {% if forloop.index == 6 and section.settings.show_promo_tile %}
          <div class="clv42-promo">
            <h3>The Signature<br>Collection</h3>
            <a href="/collections/signature">Discover</a>
          </div>
        {% endif %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v42', product: nil %}
        {% endfor %}
      {% endfor %}
    </div>
    <div style="margin-top: 60px; text-align: center; font-size: 12px; letter-spacing: 2px;">{{ paginate | default_pagination }}</div>
  {% endpaginate %}
  {% if section.settings.show_seo_block %}
    <div class="clv42-seo">
      <h2 style="font-size: 22px; font-weight: 300; margin-bottom: 20px; letter-spacing: 2px; color: #292524;">{{ section.settings.seo_title | default: 'Elevate Your Ritual' }}</h2>
      <p style="font-size: 13px; color: #78716C; line-height: 2; letter-spacing: 0.5px;">{{ section.settings.seo_text | default: 'Our collections are formulated with pure, botanical ingredients to bring the tranquil experience of a luxury spa into the comfort of your home.' }}</p>
    </div>
  {% endif %}
</div>
{% schema %}
{
  "name": "CL V42 — Luxury Spa", "settings": [
    {"type": "range", "id": "products_per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 12},
    {"type": "range", "id": "cols_desktop", "label": "Desktop Columns", "min": 2, "max": 5, "default": 3},
    {"type": "select", "id": "cols_mobile", "label": "Mobile Columns", "options": [{"value": "1", "label": "1"}, {"value": "2", "label": "2"}], "default": "2"},
    {"type": "link_list", "id": "sub_collections", "label": "Sub-Collection Menu"},
    {"type": "checkbox", "id": "show_promo_tile", "label": "Show Promo Card", "default": true},
    {"type": "checkbox", "id": "show_seo_block", "label": "Show SEO Block", "default": true},
    {"type": "color", "id": "bg_color", "label": "Background Color", "default": "#FAFAF9"},
    {"type": "color", "id": "text_color", "label": "Text Color", "default": "#44403C"}
  ], "presets": [{"name": "CL V42 — Luxury Spa"}]
}
{% endschema %}
