{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#ffffff'
  assign text_color = section.settings.text_color | default: '#000000'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 100px 40px;
    border-top: 1px solid rgba(0,0,0,0.1);
  }
  
  .hp15-blog-container-{{ section_id }} {
    max-width: 1600px;
    margin: 0 auto;
  }
  
  .hp15-blog-header-{{ section_id }} {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 60px;
  }
  
  .hp15-blog-heading-{{ section_id }} {
    font-family: 'Didot', 'Playfair Display', serif;
    font-size: clamp(2.5rem, 4vw, 4rem);
    font-weight: normal;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: {{ text_color }};
    margin: 0;
  }
  
  .hp15-blog-link-{{ section_id }} {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: {{ text_color }};
    text-decoration: none;
    border-bottom: 1px solid {{ text_color }};
    padding-bottom: 5px;
  }
  
  .hp15-blog-grid-{{ section_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
  }
  
  .hp15-blog-card-{{ section_id }} {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: {{ text_color }};
  }
  
  .hp15-blog-image-wrap-{{ section_id }} {
    position: relative;
    padding-top: 60%;
    overflow: hidden;
    margin-bottom: 30px;
  }
  
  .hp15-blog-image-{{ section_id }} {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover;
    filter: grayscale(100%);
    transition: transform 0.5s ease, filter 0.5s ease;
  }
  
  .hp15-blog-card-{{ section_id }}:hover .hp15-blog-image-{{ section_id }} {
    transform: scale(1.05);
    filter: grayscale(0%);
  }
  
  .hp15-blog-meta-{{ section_id }} {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 15px;
    opacity: 0.6;
  }
  
  .hp15-blog-title-{{ section_id }} {
    font-family: 'Didot', 'Playfair Display', serif;
    font-size: 1.5rem;
    margin: 0 0 15px 0;
    line-height: 1.3;
    text-transform: uppercase;
  }
  
  .hp15-blog-excerpt-{{ section_id }} {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.9rem;
    line-height: 1.6;
    margin: 0;
    opacity: 0.8;
  }

  @media (max-width: 992px) {
    .hp15-blog-grid-{{ section_id }} {
      grid-template-columns: 1fr;
      gap: 50px;
    }
  }
  
  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 60px 20px;
    }
    .hp15-blog-header-{{ section_id }} {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }
  }
</style>

<div class="hp15-blog-container-{{ section_id }}">
  <div class="hp15-blog-header-{{ section_id }}">
    <h2 class="hp15-blog-heading-{{ section_id }}">EDITORIAL</h2>
    {% if section.settings.blog != blank %}
      <a href="{{ blogs[section.settings.blog].url }}" class="hp15-blog-link-{{ section_id }}">VIEW ALL PUBLICATIONS</a>
    {% endif %}
  </div>
  
  <div class="hp15-blog-grid-{{ section_id }}">
    {% assign blog = blogs[section.settings.blog] %}
    {% if blog != blank and blog.articles_count > 0 %}
      {% for article in blog.articles limit: 3 %}
        <a href="{{ article.url }}" class="hp15-blog-card-{{ section_id }}">
          <div class="hp15-blog-image-wrap-{{ section_id }}">
            {% if article.image %}
              <img height="{{ article.image.height }}" width="{{ article.image.width }}" src="{{ article.image | image_url: width: 600 }}" class="hp15-blog-image-{{ section_id }}" loading="lazy" alt="{{ article.title }}">
            {% else %}
              <div class="hp15-blog-image-{{ section_id }}" style="background: #000;"></div>
            {% endif %}
          </div>
          <div class="hp15-blog-meta-{{ section_id }}">{{ article.published_at | date: "%B %Y" }}</div>
          <h3 class="hp15-blog-title-{{ section_id }}">{{ article.title }}</h3>
          <p class="hp15-blog-excerpt-{{ section_id }}">{{ article.excerpt_or_content | strip_html | truncatewords: 25 }}</p>
        </a>
      {% endfor %}
    {% else %}
      {% for i in (1..3) %}
        <a href="#" class="hp15-blog-card-{{ section_id }}">
          <div class="hp15-blog-image-wrap-{{ section_id }}">
            <div class="hp15-blog-image-{{ section_id }}" style="background: repeating-linear-gradient(45deg, #EFEFEF, #EFEFEF 12px, #E6E6E6 12px, #E6E6E6 24px);"></div>
          </div>
          <div class="hp15-blog-meta-{{ section_id }}">OCTOBER 2025</div>
          <h3 class="hp15-blog-title-{{ section_id }}">THE ARCHITECTURE OF SILHOUETTE</h3>
          <p class="hp15-blog-excerpt-{{ section_id }}">An exploration into how geometric forms influence modern draping techniques in our latest collection.</p>
        </a>
      {% endfor %}
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "HP15 Blog Posts",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    }
  ],
  "presets": [
    {
      "name": "HP15 Blog Posts"
    }
  ]
}
{% endschema %}
