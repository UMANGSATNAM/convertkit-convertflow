{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#0B0F19' }};
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }
  .hp58-test__container { max-width: {{ section.settings.container_width | default: 1280 }}px; margin: 0 auto; padding: 0 24px; }
  .hp58-test__header { text-align: center; margin-bottom: 50px; }
  .hp58-test__eyebrow { font-family: 'Space Grotesk', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: #06B6D4; margin: 0 0 12px; }
  .hp58-test__heading { font-family: 'Syne', sans-serif; font-size: clamp(28px, 3.5vw, 42px); font-weight: 800; color: #FFFFFF; margin: 0; }
  .hp58-test__grid { display: grid; grid-template-columns: repeat({{ section.settings.columns | default: 3 }}, 1fr); gap: 20px; }
  .hp58-test__card { background: #111827; border: 1px solid rgba(6, 182, 212, 0.2); border-radius: 8px; padding: 32px 24px; }
  .hp58-test__stars { color: #06B6D4; font-size: 16px; margin-bottom: 16px; letter-spacing: 2px; }
  .hp58-test__quote { font-size: 15px; line-height: 1.6; color: #E2E8F0; margin: 0 0 20px; }
  .hp58-test__author { font-family: 'Syne', sans-serif; font-size: 14px; font-weight: 700; color: #FFFFFF; margin: 0; }
  .hp58-test__role { font-size: 11px; color: #8B5CF6; margin: 4px 0 0; letter-spacing: 1px; text-transform: uppercase; }
  @media screen and (max-width: 992px) { .hp58-test__grid { grid-template-columns: 1fr; max-width: 600px; margin: 0 auto; } }
{%- endstyle -%}
<div class="hp58-test__container">
  <div class="hp58-test__header">
    {%- if section.settings.eyebrow != blank -%}<p class="hp58-test__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="hp58-test__heading">{{ section.settings.heading | default: 'Bio-Metric Verification' }}</h2>
  </div>
  <div class="hp58-test__grid">
    {%- for block in section.blocks -%}
      <div class="hp58-test__card" {{ block.shopify_attributes }}>
        <div class="hp58-test__stars">{{ block.settings.stars | default: '★★★★★' }}</div>
        <p class="hp58-test__quote">"{{ block.settings.quote | default: 'The quantum peptides reversed my screen fatigue and skin dullness instantly.' }}"</p>
        <p class="hp58-test__author">{{ block.settings.author | default: 'Kenji T.' }}</p>
        <p class="hp58-test__role">{{ block.settings.role | default: 'Tokyo Tech Executive' }}</p>
      </div>
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "HP58 Reviews",
  "class": "section-hp58-test",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#0B0F19" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "⚡ DATA REVIEWS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Bio-Metric Verification" },
    { "type": "range", "id": "columns", "min": 1, "max": 3, "step": 1, "label": "Columns", "default": 3 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "blocks": [{ "type": "testimonial", "name": "Review", "settings": [
    { "type": "text", "id": "stars", "label": "Stars", "default": "★★★★★" },
    { "type": "textarea", "id": "quote", "label": "Quote", "default": "The quantum peptides reversed my screen fatigue instantly." },
    { "type": "text", "id": "author", "label": "Author", "default": "Kenji T." },
    { "type": "text", "id": "role", "label": "Role", "default": "Tokyo Tech Executive" }
  ]}],
  "presets": [{ "name": "HP58 Reviews", "blocks": [
    { "type": "testimonial" },
    { "type": "testimonial", "settings": { "quote": "Skin barrier test confirmed +280% resilience after 2 weeks.", "author": "Aoi S.", "role": "Bio-Chemical Researcher" } },
    { "type": "testimonial", "settings": { "quote": "Living in front of 4 monitors daily, this photoshield is mandatory.", "author": "Marcus V.", "role": "Fullstack Architect" } }
  ]}]
}
{% endschema %}
