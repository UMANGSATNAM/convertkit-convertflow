{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp47-comp-bg: {{ section.settings.bg_color | default: '#F5F0EB' }};
    
    background-color: var(--hp47-comp-bg);
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
  }

  .hp47-comp__wrap {
    max-width: {{ section.settings.container_width | default: 980 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp47-comp__header {
    text-align: center;
    margin-bottom: 45px;
  }

  .hp47-comp__heading {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(32px, 4.5vw, 44px);
    font-weight: 600;
    color: #382E2B;
    margin: 0 0 8px;
  }

  .hp47-comp__card {
    background: #FAF7F2;
    border: 1px solid #EAE3DA;
    border-radius: 28px;
    overflow: hidden;
    box-shadow: 0 15px 40px rgba(56, 46, 43, 0.05);
  }

  .hp47-comp__table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }

  .hp47-comp__table th, .hp47-comp__table td {
    padding: 18px 24px;
    text-align: center;
    border-bottom: 1px solid #EAE3DA;
    color: #382E2B;
  }

  .hp47-comp__table th {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-weight: 700;
    background: #EAE3DA;
  }

  .hp47-comp__highlight {
    background: rgba(140, 109, 88, 0.08);
    font-weight: 700;
    color: #8C6D58 !important;
  }

  @media screen and (max-width: 600px) {
    .hp47-comp__table th, .hp47-comp__table td { padding: 12px 10px; font-size: 12px; }
  }
{%- endstyle -%}

<div class="hp47-comp__wrap">
  <div class="hp47-comp__header">
    <h2 class="hp47-comp__heading">The Scandinavian Lipid Standard</h2>
    <p style="font-size:14px; color:#6E5E58;">{{ section.settings.subheading | default: 'Pure bio-fermented oat lipids vs conventional diluted cosmetics.' }}</p>
  </div>

  <div class="hp47-comp__card">
    <table class="hp47-comp__table">
      <thead>
        <tr>
          <th style="text-align:left;">Lipid Criteria</th>
          <th class="hp47-comp__highlight">Peri Linen &amp; Oat v47</th>
          <th>Conventional Brand</th>
        </tr>
      </thead>
      <tbody>
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <td style="text-align:left; font-weight:600;">{{ block.settings.feature }}</td>
              <td class="hp47-comp__highlight">{{ block.settings.brand_val }}</td>
              <td>{{ block.settings.other_val }}</td>
            </tr>
          {%- endfor -%}
        {%- else -%}
          <tr>
            <td style="text-align:left; font-weight:600;">Primary Active Base</td>
            <td class="hp47-comp__highlight">72-Hr Fermented Nordic Oat Lipids</td>
            <td>Synthetic Emollient &amp; Mineral Oil</td>
          </tr>
          <tr>
            <td style="text-align:left; font-weight:600;">Hydrating Vehicle</td>
            <td class="hp47-comp__highlight">Organic Scandinavian Birch Sap</td>
            <td>Tap Water with Preservatives</td>
          </tr>
          <tr>
            <td style="text-align:left; font-weight:600;">Vessel Materials</td>
            <td class="hp47-comp__highlight">Recyclable Glass &amp; FSC Birch Wood</td>
            <td>Non-Recyclable Plastic Laminate</td>
          </tr>
          <tr>
            <td style="text-align:left; font-weight:600;">Global DDP Air Courier</td>
            <td class="hp47-comp__highlight">100% Pre-Paid Door Delivery</td>
            <td>Postal Duty Clearance Delays</td>
          </tr>
        {%- endif -%}
      </tbody>
    </table>
  </div>
</div>

{% schema %}
{
  "name": "HP47 - Taupe Matrix",
  "class": "section-hp47-matrix",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#F5F0EB" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 80 },
    { "type": "range", "id": "container_width", "min": 700, "max": 1200, "step": 20, "unit": "px", "label": "Container Width", "default": 980 }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Matrix Row",
      "settings": [
        { "type": "text", "id": "feature", "label": "Feature", "default": "Primary Active Base" },
        { "type": "text", "id": "brand_val", "label": "Our Value", "default": "72-Hr Fermented Nordic Oat Lipids" },
        { "type": "text", "id": "other_val", "label": "Conventional Value", "default": "Synthetic Emollient" }
      ]
    }
  ],
  "presets": [
    { "name": "HP47 - Taupe Matrix" }
  ]
}
{% endschema %}
