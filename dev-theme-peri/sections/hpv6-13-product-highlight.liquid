{%- liquid
  assign section_id = section.id
  assign product = section.settings.product
  assign layout = section.settings.layout | default: 'image_left'
  assign image_ratio = section.settings.image_ratio | default: 'portrait'
  
  assign bg_color = section.settings.bg_color | default: '#F7FAFC'
  assign text_color = section.settings.text_color | default: '#2D3748'
  assign accent_color = section.settings.accent_color | default: '#A0AEC0'
  assign btn_bg = section.settings.btn_bg | default: '#2D3748'
  assign btn_text = section.settings.btn_text | default: '#FFFFFF'
  assign btn_border = section.settings.btn_border | default: '#2D3748'
  
  assign padding_top = section.settings.padding_top | default: 120
  assign padding_bottom = section.settings.padding_bottom | default: 120
  assign padding_top_mobile = section.settings.padding_top_mobile | default: 60
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile | default: 60
-%}

<style>
  #shopify-section-{{ section_id }} {
    --bg-color: {{ bg_color }};
    --text-color: {{ text_color }};
    --accent-color: {{ accent_color }};
    --btn-bg: {{ btn_bg }};
    --btn-text: {{ btn_text }};
    --btn-border: {{ btn_border }};
    --padding-top: {{ padding_top }}px;
    --padding-bottom: {{ padding_bottom }}px;
    --padding-top-mobile: {{ padding_top_mobile }}px;
    --padding-bottom-mobile: {{ padding_bottom_mobile }}px;
    
    background-color: var(--bg-color);
    color: var(--text-color);
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
    overflow: hidden;
  }

  .hpv6-highlight-{{ section_id }} {
    max-width: var(--page-width, 1440px);
    margin: 0 auto;
    padding: 0 5vw;
  }

  .hpv6-highlight__wrap {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    margin: 0 -3vw;
    {%- if layout == 'image_right' -%}
      flex-direction: row-reverse;
    {%- endif -%}
  }

  .hpv6-highlight__img-col,
  .hpv6-highlight__text-col {
    flex: 1 1 50%;
    padding: 0 3vw;
    box-sizing: border-box;
  }

  /* Image Column */
  .hpv6-highlight__img-inner {
    position: relative;
    width: 100%;
    background-color: #E2E8F0;
    overflow: hidden;
    border-radius: 4px;
    
    {%- if image_ratio == 'portrait' -%}
      padding-top: 125%; /* 4:5 aspect ratio */
    {%- elsif image_ratio == 'square' -%}
      padding-top: 100%;
    {%- elsif image_ratio == 'landscape' -%}
      padding-top: 75%;
    {%- else -%}
      padding-top: 100%;
    {%- endif -%}
  }

  .hpv6-highlight__img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .hpv6-highlight__img-col:hover .hpv6-highlight__img {
    transform: scale(1.05);
  }

  /* Text Column */
  .hpv6-highlight__subtitle {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--accent-color);
    margin-bottom: 1.5rem;
    font-weight: 600;
  }

  .hpv6-highlight__title {
    font-family: 'Playfair Display', 'Georgia', serif;
    font-size: clamp(2.5rem, 4vw, 4rem);
    line-height: 1.1;
    font-weight: 400;
    margin: 0 0 1.5rem 0;
  }

  .hpv6-highlight__price {
    font-family: 'Inter', sans-serif;
    font-size: 1.25rem;
    font-weight: 500;
    margin-bottom: 2rem;
  }

  .hpv6-highlight__desc {
    font-family: 'Inter', sans-serif;
    font-size: 1rem;
    line-height: 1.6;
    margin-bottom: 2.5rem;
    opacity: 0.85;
  }

  /* Specs List */
  .hpv6-highlight__specs {
    border-top: 1px solid var(--accent-color);
    margin-bottom: 3rem;
  }

  .hpv6-highlight__spec {
    display: flex;
    justify-content: space-between;
    padding: 16px 0;
    border-bottom: 1px solid var(--accent-color);
    font-family: 'Inter', sans-serif;
    font-size: 15px;
  }

  .hpv6-highlight__spec-label {
    opacity: 0.7;
    font-weight: 500;
  }

  .hpv6-highlight__spec-value {
    font-weight: 600;
    text-align: right;
    max-width: 60%;
  }

  /* Buttons */
  .hpv6-highlight__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 18px 40px;
    background-color: var(--btn-bg);
    color: var(--btn-text);
    border: 1px solid var(--btn-border);
    text-decoration: none;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    letter-spacing: 2px;
    text-transform: uppercase;
    font-weight: 500;
    transition: all 0.3s ease;
    min-width: 200px;
  }

  .hpv6-highlight__btn:hover,
  .hpv6-highlight__btn:focus-visible {
    background-color: transparent;
    color: var(--text-color);
    border-color: var(--text-color);
    outline: none;
  }

  /* Mobile Adjustments */
  @media screen and (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding-top: var(--padding-top-mobile);
      padding-bottom: var(--padding-bottom-mobile);
    }

    .hpv6-highlight__wrap {
      flex-direction: column;
      margin: 0;
    }

    .hpv6-highlight__img-col {
      padding: 0;
      margin-bottom: 3rem;
      width: 100%;
    }

    .hpv6-highlight__text-col {
      padding: 0;
      width: 100%;
    }

    .hpv6-highlight__btn {
      width: 100%;
    }
  }
</style>

<article class="hpv6-highlight-{{ section_id }}">
  <div class="hpv6-highlight__wrap">
    
    <!-- Image Column -->
    <div class="hpv6-highlight__img-col">
      <div class="hpv6-highlight__img-inner">
        {%- assign image = section.settings.image | default: product.featured_image -%}
        
        {%- if image != blank -%}
          {{ image | image_url: width: 1400 | image_tag: 
             loading: 'lazy',
             class: 'hpv6-highlight__img',
             alt: image.alt | default: product.title | default: 'Featured Product'
          }}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'hpv6-highlight__img placeholder-svg' }}
        {%- endif -%}
      </div>
    </div>

    <!-- Text Column -->
    <div class="hpv6-highlight__text-col">
      {%- if section.settings.subtitle != blank -%}
        <div class="hpv6-highlight__subtitle">{{ section.settings.subtitle | escape }}</div>
      {%- endif -%}

      <h2 class="hpv6-highlight__title">
        {{ section.settings.title | default: product.title | default: 'The Signature Piece' }}
      </h2>

      {%- if section.settings.show_price -%}
        <div class="hpv6-highlight__price">
          {%- if product != blank -%}
            {{ product.price | money }}
          {%- else -%}
            $195.00
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <div class="hpv6-highlight__desc">
          {{ section.settings.description }}
        </div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="hpv6-highlight__specs">
          {%- for block in section.blocks -%}
            {%- if block.type == 'spec' -%}
              <div class="hpv6-highlight__spec" {{ block.shopify_attributes }}>
                <span class="hpv6-highlight__spec-label">{{ block.settings.label | escape }}</span>
                <span class="hpv6-highlight__spec-value">{{ block.settings.value | escape }}</span>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.btn_label != blank -%}
        {%- assign link = section.settings.btn_link | default: product.url | default: '#' -%}
        <a href="{{ link }}" class="hpv6-highlight__btn" aria-label="{{ section.settings.btn_label | escape }}">
          {{ section.settings.btn_label | escape }}
        </a>
      {%- endif -%}
    </div>
    
  </div>
</article>

{% schema %}
{
  "name": "HPV6 Product Highlight",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Product"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Select Product"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Custom Image",
      "info": "Overrides product featured image if selected"
    },
    {
      "type": "header",
      "content": "Content overrides"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Flagship Product"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Custom Title",
      "info": "Overrides product title if filled"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Discover the meticulous craftsmanship and premium materials that make this piece our most sought-after signature design.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show Price",
      "default": true
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Custom Button Link",
      "info": "Defaults to product URL if left blank"
    },
    {
      "type": "header",
      "content": "Layout Options"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Desktop Image Position",
      "options": [
        { "value": "image_left", "label": "Image Left" },
        { "value": "image_right", "label": "Image Right" }
      ],
      "default": "image_left"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image Aspect Ratio",
      "options": [
        { "value": "portrait", "label": "Portrait (4:5)" },
        { "value": "square", "label": "Square (1:1)" },
        { "value": "landscape", "label": "Landscape (4:3)" },
        { "value": "original", "label": "Adapt to image" }
      ],
      "default": "portrait"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F7FAFC"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2D3748"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color (Borders & Subtitle)",
      "default": "rgba(45, 55, 72, 0.2)"
    },
    {
      "type": "color",
      "id": "btn_bg",
      "label": "Button Background",
      "default": "#2D3748"
    },
    {
      "type": "color",
      "id": "btn_text",
      "label": "Button Text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "btn_border",
      "label": "Button Border",
      "default": "#2D3748"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Desktop Padding Top",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Desktop Padding Bottom",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "spec",
      "name": "Specification",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Material"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "100% Organic Cotton"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HPV6 Product Highlight",
      "blocks": [
        { "type": "spec", "settings": { "label": "Material", "value": "Premium Oak Wood" } },
        { "type": "spec", "settings": { "label": "Dimensions", "value": "W: 42” x D: 22” x H: 18”" } },
        { "type": "spec", "settings": { "label": "Origin", "value": "Handcrafted in Italy" } }
      ]
    }
  ]
}
{% endschema %}
