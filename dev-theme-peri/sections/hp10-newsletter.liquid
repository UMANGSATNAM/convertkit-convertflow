{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#8A9A86'
  assign text_color = section.settings.text_color | default: '#F9F6F0'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 100px 20px;
    color: {{ text_color }};
  }
  
  .hp10-newsletter-container-{{ section_id }} {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
    background: #F9F6F0; /* Reversing colors for inner card */
    color: #2A3B2C;
    padding: 80px 40px;
    border-radius: 40px;
  }
  
  .hp10-newsletter-icon-{{ section_id }} {
    width: 60px;
    height: 60px;
    margin: 0 auto 20px;
    color: #8A9A86;
  }
  
  .hp10-newsletter-icon-{{ section_id }} svg {
    width: 100%;
    height: 100%;
    fill: currentColor;
  }
  
  .hp10-newsletter-heading-{{ section_id }} {
    font-family: 'Lora', serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 400;
    margin: 0 0 15px 0;
  }
  
  .hp10-newsletter-text-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: 1.05rem;
    color: rgba(42, 59, 44, 0.7);
    margin: 0 0 40px 0;
  }
  
  .hp10-newsletter-form-{{ section_id }} {
    display: flex;
    max-width: 500px;
    margin: 0 auto;
    position: relative;
  }
  
  .hp10-newsletter-input-{{ section_id }} {
    flex-grow: 1;
    padding: 16px 20px;
    border: 1px solid rgba(42, 59, 44, 0.2);
    border-radius: 40px;
    font-family: 'Inter', sans-serif;
    font-size: 1rem;
    background: transparent;
    color: #2A3B2C;
    outline: none;
  }
  
  .hp10-newsletter-input-{{ section_id }}::placeholder {
    color: rgba(42, 59, 44, 0.4);
  }
  
  .hp10-newsletter-btn-{{ section_id }} {
    position: absolute;
    right: 5px;
    top: 5px;
    bottom: 5px;
    background: #2A3B2C;
    color: #F9F6F0;
    border: none;
    border-radius: 40px;
    padding: 0 30px;
    font-family: 'Inter', sans-serif;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.3s ease;
  }
  
  .hp10-newsletter-btn-{{ section_id }}:hover {
    background: #8A9A86;
  }

  @media (max-width: 600px) {
    .hp10-newsletter-container-{{ section_id }} {
      padding: 50px 20px;
    }
    .hp10-newsletter-form-{{ section_id }} {
      flex-direction: column;
      gap: 10px;
    }
    .hp10-newsletter-btn-{{ section_id }} {
      position: static;
      padding: 16px;
    }
  }
</style>

<div class="hp10-newsletter-container-{{ section_id }}">
  <div class="hp10-newsletter-icon-{{ section_id }}">
    <svg viewBox="0 0 24 24"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
  </div>
  <h2 class="hp10-newsletter-heading-{{ section_id }}">{{ section.settings.heading | default: 'Join the Ritual' }}</h2>
  <p class="hp10-newsletter-text-{{ section_id }}">{{ section.settings.text | default: 'Subscribe to receive 15% off your first order and exclusive access to new releases.' }}</p>
  
  <form class="hp10-newsletter-form-{{ section_id }}">
    <input type="email" class="hp10-newsletter-input-{{ section_id }}" placeholder="Enter your email address" required>
    <button type="submit" class="hp10-newsletter-btn-{{ section_id }}">Subscribe</button>
  </form>
</div>

{% schema %}
{
  "name": "HP10 Newsletter",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Outer Background",
      "default": "#8A9A86"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join the Ritual"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Subscribe to receive 15% off your first order and exclusive access to new releases."
    }
  ],
  "presets": [
    {
      "name": "HP10 Newsletter"
    }
  ]
}
{% endschema %}
