{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#0f0f13'
  assign accent_color = section.settings.accent_color | default: '#00ff88'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 100px 20px;
    display: flex;
    justify-content: center;
    border-bottom: 1px solid rgba(255,255,255,0.05);
  }
  
  .hp9-terminal-container-{{ section_id }} {
    max-width: 800px;
    width: 100%;
    background: #050505;
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 6px;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0,0,0,0.5);
  }
  
  .hp9-terminal-header-{{ section_id }} {
    background: #1a1a24;
    padding: 10px 15px;
    display: flex;
    align-items: center;
    border-bottom: 1px solid rgba(255,255,255,0.05);
  }
  
  .hp9-terminal-dots-{{ section_id }} {
    display: flex;
    gap: 8px;
  }
  
  .hp9-terminal-dot-{{ section_id }} {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }
  
  .hp9-terminal-dot-{{ section_id }}.red { background: #ff5f56; }
  .hp9-terminal-dot-{{ section_id }}.yellow { background: #ffbd2e; }
  .hp9-terminal-dot-{{ section_id }}.green { background: #27c93f; }
  
  .hp9-terminal-title-{{ section_id }} {
    flex: 1;
    text-align: center;
    color: rgba(255,255,255,0.5);
    font-family: 'Inter', sans-serif;
    font-size: 0.8rem;
    font-weight: 500;
  }
  
  .hp9-terminal-body-{{ section_id }} {
    padding: 40px;
    font-family: 'Space Mono', monospace;
  }
  
  .hp9-terminal-output-{{ section_id }} {
    color: #aaa;
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 30px;
  }
  
  .hp9-terminal-output-{{ section_id }} span {
    color: {{ accent_color }};
  }
  
  .hp9-terminal-input-wrapper-{{ section_id }} {
    display: flex;
    align-items: center;
    gap: 15px;
  }
  
  .hp9-terminal-prompt-{{ section_id }} {
    color: {{ accent_color }};
    font-weight: 700;
  }
  
  .hp9-terminal-form-{{ section_id }} {
    display: flex;
    width: 100%;
    position: relative;
  }
  
  .hp9-terminal-input-{{ section_id }} {
    flex: 1;
    background: transparent;
    border: none;
    color: #fff;
    font-family: 'Space Mono', monospace;
    font-size: 1rem;
    padding: 5px 0;
    outline: none;
  }
  
  .hp9-terminal-input-{{ section_id }}::placeholder {
    color: rgba(255,255,255,0.2);
  }
  
  /* Blinking cursor effect */
  .hp9-terminal-cursor-{{ section_id }} {
    display: inline-block;
    width: 10px;
    height: 18px;
    background-color: {{ accent_color }};
    animation: hp9-blink-cursor-{{ section_id }} 1s step-end infinite;
    position: absolute;
    right: 10px;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
  }
  
  @keyframes hp9-blink-cursor-{{ section_id }} {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }
  
  .hp9-terminal-submit-{{ section_id }} {
    display: none; /* Hide default submit button, rely on enter key or JS if needed */
  }

  @media (max-width: 600px) {
    .hp9-terminal-body-{{ section_id }} {
      padding: 20px;
    }
  }
</style>

<div class="hp9-terminal-container-{{ section_id }}">
  <div class="hp9-terminal-header-{{ section_id }}">
    <div class="hp9-terminal-dots-{{ section_id }}">
      <div class="hp9-terminal-dot-{{ section_id }} red"></div>
      <div class="hp9-terminal-dot-{{ section_id }} yellow"></div>
      <div class="hp9-terminal-dot-{{ section_id }} green"></div>
    </div>
    <div class="hp9-terminal-title-{{ section_id }}">root@system: ~/newsletter</div>
  </div>
  
  <div class="hp9-terminal-body-{{ section_id }}">
    <div class="hp9-terminal-output-{{ section_id }}">
      > Executing protocol: <span>SUBSCRIBE</span><br>
      > Initializing secure connection... OK<br>
      > Enter email address to receive system updates, early access drops, and classified intel.
    </div>
    
    <div class="hp9-terminal-input-wrapper-{{ section_id }}">
      <span class="hp9-terminal-prompt-{{ section_id }}">root@system:~#</span>
      
      {% form 'customer', class: 'hp9-terminal-form-' | append: section_id %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input type="email" 
               name="contact[email]" 
               class="hp9-terminal-input-{{ section_id }}" 
               placeholder="Enter_Email_Here_"
               required>
        <span class="hp9-terminal-cursor-{{ section_id }}"></span>
      {% endform %}
    </div>
  </div>
</div>

<script>
  // Simple script to hide cursor when input has focus/text to make it feel real
  document.addEventListener('DOMContentLoaded', () => {
    const input = document.querySelector('.hp9-terminal-input-{{ section_id }}');
    const cursor = document.querySelector('.hp9-terminal-cursor-{{ section_id }}');
    
    if(input && cursor) {
      input.addEventListener('input', () => {
        if(input.value.length > 0) {
          cursor.style.display = 'none';
        } else {
          cursor.style.display = 'inline-block';
        }
      });
    }
  });
</script>

{% schema %}
{
  "name": "HP9 Terminal Newsletter",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#0f0f13"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#00ff88"
    }
  ],
  "presets": [
    {
      "name": "HP9 Terminal Newsletter"
    }
  ]
}
{% endschema %}
