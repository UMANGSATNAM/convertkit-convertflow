{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#FAFAFA'
  assign text_color = section.settings.text_color | default: '#333333'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 120px 40px;
    border-bottom: 1px solid #E5E5E5;
  }
  
  .hp12-bestsellers-container-{{ section_id }} {
    max-width: 1400px;
    margin: 0 auto;
  }
  
  .hp12-bestsellers-header-{{ section_id }} {
    text-align: center;
    margin-bottom: 80px;
  }
  
  .hp12-bestsellers-heading-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 300;
    margin: 0;
    line-height: 1.2;
    letter-spacing: 2px;
    color: {{ text_color }};
  }
  
  .hp12-bestsellers-grid-{{ section_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 40px;
  }
  
  .hp12-product-card-{{ section_id }} {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: {{ text_color }};
    group: hover;
  }
  
  .hp12-product-image-wrap-{{ section_id }} {
    position: relative;
    overflow: hidden;
    padding-top: 130%; 
    background: #EFEFEF;
    margin-bottom: 25px;
  }
  
  .hp12-product-image-{{ section_id }} {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  
  .hp12-product-card-{{ section_id }}:hover .hp12-product-image-{{ section_id }} {
    transform: scale(1.03);
  }
  
  .hp12-product-info-{{ section_id }} {
    text-align: center;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }
  
  .hp12-product-title-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    margin: 0 0 10px 0;
  }
  
  .hp12-product-price-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    font-weight: 300;
    opacity: 0.7;
    margin-bottom: 20px;
  }
  
  .hp12-view-all-wrap-{{ section_id }} {
    text-align: center;
    margin-top: 80px;
  }
  
  .hp12-view-all-btn-{{ section_id }} {
    display: inline-block;
    padding: 10px 0;
    color: {{ text_color }};
    font-family: 'Inter', sans-serif;
    font-size: 0.85rem;
    font-weight: 400;
    text-transform: uppercase;
    text-decoration: none;
    letter-spacing: 2px;
    border-bottom: 1px solid {{ text_color }};
    transition: opacity 0.3s ease;
  }
  
  .hp12-view-all-btn-{{ section_id }}:hover {
    opacity: 0.5;
  }

  @media (max-width: 1024px) {
    .hp12-bestsellers-grid-{{ section_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 60px 20px;
    }
    .hp12-bestsellers-grid-{{ section_id }} {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
</style>

<div class="hp12-bestsellers-container-{{ section_id }}">
  <div class="hp12-bestsellers-header-{{ section_id }}">
    <h2 class="hp12-bestsellers-heading-{{ section_id }}">{{ section.settings.heading | default: 'Selected works.' }}</h2>
  </div>
  
  <div class="hp12-bestsellers-grid-{{ section_id }}">
    {% assign collection = collections[section.settings.collection] %}
    {% if collection != blank %}
      {% for product in collection.products limit: section.settings.product_limit %}
        <a href="{{ product.url }}" class="hp12-product-card-{{ section_id }}">
          <div class="hp12-product-image-wrap-{{ section_id }}">
            <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title }}" class="hp12-product-image-{{ section_id }}" loading="lazy">
          </div>
          <div class="hp12-product-info-{{ section_id }}">
            <h3 class="hp12-product-title-{{ section_id }}">{{ product.title }}</h3>
            <div class="hp12-product-price-{{ section_id }}">{{ product.price | money }}</div>
          </div>
        </a>
      {% endfor %}
    {% else %}
      {% for i in (1..4) %}
        <a href="#" class="hp12-product-card-{{ section_id }}">
          <div class="hp12-product-image-wrap-{{ section_id }}">
            <div class="hp12-product-image-{{ section_id }}" style="background: #E5E5E5;"></div>
          </div>
          <div class="hp12-product-info-{{ section_id }}">
            <h3 class="hp12-product-title-{{ section_id }}">LOUNGE CHAIR</h3>
            <div class="hp12-product-price-{{ section_id }}">$1,250.00</div>
          </div>
        </a>
      {% endfor %}
    {% endif %}
  </div>
  
  {% if section.settings.show_view_all %}
    <div class="hp12-view-all-wrap-{{ section_id }}">
      <a href="{{ collection.url | default: '#' }}" class="hp12-view-all-btn-{{ section_id }}">View the collection</a>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "HP12 Bestsellers",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FAFAFA"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Selected works."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "product_limit",
      "min": 4,
      "max": 12,
      "step": 4,
      "label": "Product Limit",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show View All Link",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "HP12 Bestsellers"
    }
  ]
}
{% endschema %}
