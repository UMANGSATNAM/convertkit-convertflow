{%- liquid
  assign sec_id = section.id
  assign bg_color = section.settings.bg_color
  assign text_color = section.settings.text_color
  assign card_bg = section.settings.card_bg
  assign accent_color = section.settings.accent_color
  assign border_color = section.settings.border_color
  assign border_width = section.settings.border_width
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
  assign title = section.settings.title
-%}

<style>
  .hp18-featured-{{ sec_id }} {
    background-color: {{ bg_color }};
    padding-top: {{ padding_top }}px;
    padding-bottom: {{ padding_bottom }}px;
    border-bottom: {{ border_width }}px solid {{ border_color }};
  }

  .hp18-featured-{{ sec_id }}__container {
    max-width: var(--page-width, 1600px);
    margin: 0 auto;
    padding: 0 40px;
  }

  .hp18-featured-{{ sec_id }}__header {
    text-align: left;
    margin-bottom: 50px;
    border-bottom: {{ border_width }}px solid {{ border_color }};
    padding-bottom: 20px;
  }

  .hp18-featured-{{ sec_id }}__title {
    font-family: 'Arial Black', Impact, sans-serif;
    font-size: clamp(36px, 5vw, 80px);
    color: {{ text_color }};
    text-transform: uppercase;
    margin: 0;
    line-height: 1;
    letter-spacing: -2px;
  }

  .hp18-featured-{{ sec_id }}__grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    border: {{ border_width }}px solid {{ border_color }};
    background-color: {{ border_color }};
  }

  .hp18-featured-{{ sec_id }}__item {
    flex: 1 1 calc(33.333% - {{ border_width }}px);
    background-color: {{ card_bg }};
    display: flex;
    flex-direction: column;
    position: relative;
    border-right: {{ border_width }}px solid {{ border_color }};
    transition: background-color 0.3s ease;
  }
  
  .hp18-featured-{{ sec_id }}__item:nth-child(3n) {
    border-right: none;
  }
  .hp18-featured-{{ sec_id }}__item:nth-child(n+4) {
    border-top: {{ border_width }}px solid {{ border_color }};
  }

  .hp18-featured-{{ sec_id }}__item:hover {
    background-color: {{ bg_color }};
  }

  .hp18-featured-{{ sec_id }}__img-wrap {
    aspect-ratio: 1;
    padding: 40px;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
  }

  .hp18-featured-{{ sec_id }}__img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    transition: transform 0.4s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .hp18-featured-{{ sec_id }}__item:hover .hp18-featured-{{ sec_id }}__img {
    transform: scale(1.1) rotate(5deg);
  }

  .hp18-featured-{{ sec_id }}__info {
    border-top: {{ border_width }}px solid {{ border_color }};
    padding: 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background-color: {{ card_bg }};
  }

  .hp18-featured-{{ sec_id }}__details {
    display: flex;
    flex-direction: column;
  }

  .hp18-featured-{{ sec_id }}__name {
    font-family: 'Arial Black', sans-serif;
    font-size: 18px;
    color: {{ text_color }};
    margin: 0 0 5px 0;
    text-transform: uppercase;
    text-decoration: none;
  }

  .hp18-featured-{{ sec_id }}__price {
    font-family: 'Courier New', monospace;
    font-weight: bold;
    font-size: 16px;
    color: {{ text_color }};
    margin: 0;
  }

  .hp18-featured-{{ sec_id }}__add-btn {
    width: 50px;
    height: 50px;
    background-color: {{ text_color }};
    border: {{ border_width }}px solid {{ border_color }};
    display: flex;
    justify-content: center;
    align-items: center;
    color: {{ card_bg }};
    font-size: 24px;
    font-weight: bold;
    cursor: pointer;
    transition: all 0.2s;
  }

  .hp18-featured-{{ sec_id }}__add-btn:hover {
    background-color: {{ accent_color }};
    color: {{ border_color }};
    transform: rotate(90deg);
  }

  @media screen and (max-width: 1024px) {
    .hp18-featured-{{ sec_id }}__item {
      flex: 1 1 calc(50% - {{ border_width }}px);
    }
    .hp18-featured-{{ sec_id }}__item:nth-child(2n) {
      border-right: none;
    }
    .hp18-featured-{{ sec_id }}__item:nth-child(3n) {
      border-right: {{ border_width }}px solid {{ border_color }};
    }
    .hp18-featured-{{ sec_id }}__item:nth-child(n+3) {
      border-top: {{ border_width }}px solid {{ border_color }};
    }
  }

  @media screen and (max-width: 600px) {
    .hp18-featured-{{ sec_id }}__container { padding: 0 20px; }
    .hp18-featured-{{ sec_id }}__item {
      flex: 1 1 100%;
      border-right: none !important;
    }
    .hp18-featured-{{ sec_id }}__item:nth-child(n+2) {
      border-top: {{ border_width }}px solid {{ border_color }};
    }
    .hp18-featured-{{ sec_id }}__img-wrap {
      padding: 20px;
    }
  }
</style>

<section class="hp18-featured-{{ sec_id }}">
  <div class="hp18-featured-{{ sec_id }}__container">
    
    {% if title != blank %}
    <div class="hp18-featured-{{ sec_id }}__header">
      <h2 class="hp18-featured-{{ sec_id }}__title">{{ title }}</h2>
    </div>
    {% endif %}

    <div class="hp18-featured-{{ sec_id }}__grid">
      {% for block in section.blocks %}
        {% assign product = all_products[block.settings.product] %}
        
        <div class="hp18-featured-{{ sec_id }}__item" {{ block.shopify_attributes }}>
          {% if product != blank %}
            <a href="{{ product.url }}" class="hp18-featured-{{ sec_id }}__img-wrap">
              <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title }}" class="hp18-featured-{{ sec_id }}__img" loading="lazy">
            </a>
            <div class="hp18-featured-{{ sec_id }}__info">
              <div class="hp18-featured-{{ sec_id }}__details">
                <a href="{{ product.url }}" class="hp18-featured-{{ sec_id }}__name">{{ product.title }}</a>
                <p class="hp18-featured-{{ sec_id }}__price">{{ product.price | money }}</p>
              </div>
              <form method="post" action="/cart/add">
                <input type="hidden" name="id" value="{{ product.variants.first.id }}">
                <button type="submit" class="hp18-featured-{{ sec_id }}__add-btn">+</button>
              </form>
            </div>
          {% else %}
            <!-- Placeholder -->
            <a href="#" class="hp18-featured-{{ sec_id }}__img-wrap">
              {% capture tmp_class %}hp18-featured-{{ sec_id }}__img{% endcapture %}{{ 'product-' | append: forloop.index  | placeholder_svg_tag: tmp_class }}
            </a>
            <div class="hp18-featured-{{ sec_id }}__info">
              <div class="hp18-featured-{{ sec_id }}__details">
                <a href="#" class="hp18-featured-{{ sec_id }}__name">Product Title {{ forloop.index }}</a>
                <p class="hp18-featured-{{ sec_id }}__price">$120.00</p>
              </div>
              <button class="hp18-featured-{{ sec_id }}__add-btn">+</button>
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "HP18 Adv Featured Prods",
  "max_blocks": 6,
  "settings": [
    {
      "type": "header",
      "content": "Color Settings"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f4f4f0"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#CCFF00"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Layout & Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "LATEST DROPS"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "Border Width",
      "default": 3
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 10,
      "unit": "px",
      "label": "Padding Top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 10,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Featured Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP18 Advanced Featured Prods",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
