{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#000000'
  assign text_color = section.settings.text_color | default: '#ffffff'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 0;
  }
  
  .hp15-lookbook-container-{{ section_id }} {
    position: relative;
    width: 100%;
    height: 100vh;
    min-height: 700px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  
  .hp15-lookbook-bg-{{ section_id }} {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover;
    filter: grayscale(100%) contrast(1.1);
  }
  
  .hp15-lookbook-overlay-{{ section_id }} {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(0, 0, 0, 0.3);
  }
  
  .hp15-lookbook-hotspot-{{ section_id }} {
    position: absolute;
    width: 16px;
    height: 16px;
    background: #fff;
    cursor: pointer;
    transition: transform 0.3s ease;
    z-index: 2;
    box-shadow: 0 0 0 1px rgba(0,0,0,0.5);
  }
  
  .hp15-lookbook-hotspot-{{ section_id }}:hover {
    transform: scale(1.2) rotate(45deg);
  }
  
  .hp15-lookbook-tooltip-{{ section_id }} {
    position: absolute;
    top: 30px;
    left: 50%;
    transform: translateX(-50%);
    background: #000;
    color: #fff;
    padding: 20px;
    min-width: 200px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease, transform 0.3s ease;
    text-align: center;
    border: 1px solid rgba(255,255,255,0.2);
  }
  
  .hp15-lookbook-hotspot-{{ section_id }}:hover .hp15-lookbook-tooltip-{{ section_id }} {
    opacity: 1;
    pointer-events: auto;
    transform: translateX(-50%) translateY(5px);
  }
  
  .hp15-lookbook-product-title-{{ section_id }} {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    margin: 0 0 10px 0;
  }
  
  .hp15-lookbook-product-price-{{ section_id }} {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.8rem;
    color: #aaa;
    margin-bottom: 15px;
  }
  
  .hp15-lookbook-btn-{{ section_id }} {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: #000;
    background: #fff;
    text-decoration: none;
    padding: 10px 20px;
    display: inline-block;
  }

  @media (max-width: 768px) {
    .hp15-lookbook-container-{{ section_id }} {
      height: 70vh;
      min-height: 500px;
    }
  }
</style>

<div class="hp15-lookbook-container-{{ section_id }}">
  {% if section.settings.image != blank %}
    <img height="{{ section.settings.image.height }}" width="{{ section.settings.image.width }}" src="{{ section.settings.image | image_url: width: 2000 }}" class="hp15-lookbook-bg-{{ section_id }}" alt="Lookbook">
  {% else %}
    <div class="hp15-lookbook-bg-{{ section_id }}" style="background: repeating-linear-gradient(45deg, #EFEFEF, #EFEFEF 12px, #E6E6E6 12px, #E6E6E6 24px);"></div>
  {% endif %}
  <div class="hp15-lookbook-overlay-{{ section_id }}"></div>
  
  {% for block in section.blocks %}
    <div class="hp15-lookbook-hotspot-{{ section_id }}" style="top: {{ block.settings.top }}%; left: {{ block.settings.left }}%;" {{ block.shopify_attributes }}>
      <div class="hp15-lookbook-tooltip-{{ section_id }}">
        {% assign product = all_products[block.settings.product] %}
        {% if product != blank %}
          <h4 class="hp15-lookbook-product-title-{{ section_id }}">{{ product.title }}</h4>
          <div class="hp15-lookbook-product-price-{{ section_id }}">{{ product.price | money }}</div>
          <a href="{{ product.url }}" class="hp15-lookbook-btn-{{ section_id }}">VIEW DETAILS</a>
        {% else %}
          <h4 class="hp15-lookbook-product-title-{{ section_id }}">TAILORED COAT</h4>
          <div class="hp15-lookbook-product-price-{{ section_id }}">$1,450.00</div>
          <a href="#" class="hp15-lookbook-btn-{{ section_id }}">VIEW DETAILS</a>
        {% endif %}
      </div>
    </div>
  {% endfor %}
</div>

{% schema %}
{
  "name": "HP15 Lookbook",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Lookbook Image"
    }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "Hotspot",
      "settings": [
        {
          "type": "range",
          "id": "top",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Top Position",
          "default": 50
        },
        {
          "type": "range",
          "id": "left",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Left Position",
          "default": 50
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP15 Lookbook",
      "blocks": [
        { "type": "hotspot", "settings": { "top": 30, "left": 40 } },
        { "type": "hotspot", "settings": { "top": 60, "left": 60 } }
      ]
    }
  ]
}
{% endschema %}
