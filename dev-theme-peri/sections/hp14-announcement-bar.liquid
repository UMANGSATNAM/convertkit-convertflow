{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#6b705c'
  assign text_color = section.settings.text_color | default: '#ffe8d6'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    color: {{ text_color }};
    padding: 10px 20px;
    text-align: center;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.85rem;
    letter-spacing: 1px;
    font-weight: 400;
  }
  
  .hp14-announcement-bar-{{ section_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 15px;
  }
  
  .hp14-announcement-text-{{ section_id }} {
    margin: 0;
  }
  
  .hp14-announcement-link-{{ section_id }} {
    color: {{ text_color }};
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }
  
  .hp14-announcement-link-{{ section_id }}:hover {
    opacity: 0.8;
  }
</style>

<div class="hp14-announcement-bar-{{ section_id }}">
  <p class="hp14-announcement-text-{{ section_id }}">
    {{ section.settings.text | default: 'Free shipping on all organic orders over $50' }}
    {% if section.settings.link != blank %}
      <a href="{{ section.settings.link }}" class="hp14-announcement-link-{{ section_id }}">{{ section.settings.link_text | default: 'Shop Now' }}</a>
    {% endif %}
  </p>
</div>

{% schema %}
{
  "name": "HP14 Announcement Bar",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#6b705c"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffe8d6"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Announcement Text",
      "default": "Free shipping on all organic orders over $50"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link Text",
      "default": "Shop Now"
    }
  ],
  "presets": [
    {
      "name": "HP14 Announcement Bar"
    }
  ]
}
{% endschema %}
