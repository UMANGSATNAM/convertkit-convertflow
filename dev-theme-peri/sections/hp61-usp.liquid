{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#09090B' }};
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
  }
  .hp61-usp__container { max-width: {{ section.settings.container_width | default: 1280 }}px; margin: 0 auto; padding: 0 24px; }
  .hp61-usp__grid { display: grid; grid-template-columns: repeat({{ section.settings.columns | default: 4 }}, 1fr); gap: 20px; }
  .hp61-usp__card {
    background: {{ section.settings.card_bg | default: '#18181B' }};
    border: 1px solid rgba(239, 68, 68, 0.2);
    border-radius: 6px; padding: 32px 22px; text-align: center;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .hp61-usp__card:hover {
    transform: translateY(-4px);
    border-color: #EF4444;
    box-shadow: 0 0 25px rgba(239, 68, 68, 0.25);
  }
  .hp61-usp__icon {
    width: 52px; height: 52px;
    background: linear-gradient(135deg, #450A0A, #18181B);
    border-radius: 6px; display: flex; align-items: center; justify-content: center;
    margin: 0 auto 16px; font-size: 22px; color: #EF4444;
    border: 1px solid rgba(239, 68, 68, 0.35);
    box-shadow: 0 0 15px rgba(239, 68, 68, 0.2);
  }
  .hp61-usp__title {
    font-family: 'Syne', sans-serif; font-size: 16px; font-weight: 700; color: #FFFFFF; margin: 0 0 8px;
  }
  .hp61-usp__desc { font-size: 13px; line-height: 1.6; color: #A1A1AA; margin: 0; }
  @media screen and (max-width: 992px) { .hp61-usp__grid { grid-template-columns: repeat(2, 1fr); } }
  @media screen and (max-width: 480px) { .hp61-usp__grid { grid-template-columns: 1fr; } }
{%- endstyle -%}
<div class="hp61-usp__container">
  <div class="hp61-usp__grid">
    {%- for block in section.blocks -%}
      <div class="hp61-usp__card" {{ block.shopify_attributes }}>
        <div class="hp61-usp__icon">{{ block.settings.icon | default: '🌋' }}</div>
        <h3 class="hp61-usp__title">{{ block.settings.title | default: 'Volcanic Ash' }}</h3>
        <p class="hp61-usp__desc">{{ block.settings.description | default: 'Thermal detox minerals.' }}</p>
      </div>
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "HP61 Pillars",
  "class": "section-hp61-usp",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#09090B" },
    { "type": "color", "id": "card_bg", "label": "Card BG", "default": "#18181B" },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "label": "Columns", "default": 4 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 80 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "blocks": [{ "type": "pillar", "name": "Pillar", "settings": [
    { "type": "text", "id": "icon", "label": "Icon", "default": "🌋" },
    { "type": "text", "id": "title", "label": "Title", "default": "Volcanic Ash" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Thermal detox minerals." }
  ]}],
  "presets": [{ "name": "HP61 Pillars", "blocks": [
    { "type": "pillar", "settings": { "icon": "🌋", "title": "Icelandic Basalt Ash", "description": "Micro-porous mineral structure that draws heavy metal impurities from deep pores." } },
    { "type": "pillar", "settings": { "icon": "⚡", "title": "Thermal Silica Peptides", "description": "Colloidal volcanic silica strengthening epidermal cell wall collagen scaffolding." } },
    { "type": "pillar", "settings": { "icon": "🔥", "title": "Geothermal Mineral Salts", "description": "Rich in natural magnesium and elemental sulfur to calm chronic dermal inflammation." } },
    { "type": "pillar", "settings": { "icon": "💎", "title": "Black Obsidian Energy", "description": "Micro-milled obsidian crystal smoothing texture with gentle magnetic ion charge." } }
  ]}]
}
{% endschema %}
