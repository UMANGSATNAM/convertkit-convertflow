{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Inter:wght@300;400&display=swap');

  #shopify-section-{{ section.id }} {
    --bg: {{ section.settings.bg_color }};
    --text: {{ section.settings.text_color }};
    --gold: {{ section.settings.accent_color }};
    --serif: 'Playfair Display', serif;
    --sans: 'Inter', sans-serif;
    background: var(--bg);
    padding: 100px 20px;
  }

  .hp42-usp {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: rgba(201,169,110,0.15);
  }

  @media (max-width: 768px) { .hp42-usp { grid-template-columns: 1fr; } }

  .hp42-usp__card {
    background: var(--bg);
    padding: 60px 40px;
    text-align: center;
  }

  .hp42-usp__line {
    width: 40px;
    height: 1px;
    background: var(--gold);
    margin: 0 auto 30px;
  }

  .hp42-usp__title {
    font-family: var(--serif);
    font-size: clamp(22px, 2.5vw, 28px);
    font-weight: 700;
    color: var(--text);
    margin: 0 0 15px;
  }

  .hp42-usp__text {
    font-family: var(--sans);
    font-size: 15px;
    font-weight: 300;
    line-height: 1.6;
    color: var(--text);
    opacity: 0.6;
    margin: 0;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp42-usp" id="HP42Usp-{{ section.id }}">
  {%- for block in section.blocks limit: 3 -%}
    <div class="hp42-usp__card" {{ block.shopify_attributes }}>
      <div class="hp42-usp__line"></div>
      <h3 class="hp42-usp__title">{{ block.settings.title }}</h3>
      {%- if block.settings.text != blank -%}
        <p class="hp42-usp__text">{{ block.settings.text }}</p>
      {%- endif -%}
    </div>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "HP42 - Noir USP",
  "class": "section-hp42-usp",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#0A0A0A" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#F5F0EB" },
    { "type": "color", "id": "accent_color", "label": "Gold", "default": "#C9A96E" },
    { "type": "html", "id": "custom_css", "label": "Custom CSS" }
  ],
  "blocks": [{ "type": "benefit", "name": "Benefit", "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Artisan Craft" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Each piece handcrafted with obsessive attention to detail." }
  ]}],
  "presets": [{ "name": "HP42 - Noir USP", "blocks": [
    { "type": "benefit", "settings": { "title": "Artisan Craft" } },
    { "type": "benefit", "settings": { "title": "Rare Materials" } },
    { "type": "benefit", "settings": { "title": "Lifetime Warranty" } }
  ]}]
}
{% endschema %}
