{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Syne:wght@700;800&display=swap');

  #shopify-section-{{ section.id }} {
    --hp61-bg: {{ section.settings.bg_color | default: '#09090B' }};
    --hp61-text: {{ section.settings.text_color | default: '#F4F4F5' }};
    --hp61-crimson: {{ section.settings.accent_crimson | default: '#EF4444' }};
    --hp61-lava: {{ section.settings.accent_lava | default: '#F59E0B' }};
    --hp61-btn-bg: {{ section.settings.btn_bg | default: '#EF4444' }};
    --hp61-btn-text: {{ section.settings.btn_text_color | default: '#FFFFFF' }};

    background: radial-gradient(circle at 80% 30%, #450A0A 0%, var(--hp61-bg) 75%);
    color: var(--hp61-text);
    font-family: 'Space Grotesk', sans-serif;
    padding-top: {{ section.settings.padding_top | default: 100 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 100 }}px;
    position: relative;
    overflow: hidden;
  }

  .hp61-hero__lava-glow {
    position: absolute;
    bottom: -150px;
    right: 10%;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(239, 68, 68, 0.2) 0%, rgba(245, 158, 11, 0.1) 40%, transparent 70%);
    pointer-events: none;
  }

  .hp61-hero__container {
    max-width: {{ section.settings.container_width | default: 1280 }}px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 70px;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  .hp61-hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 18px;
    background: rgba(239, 68, 68, 0.12);
    border: 1px solid rgba(239, 68, 68, 0.35);
    border-radius: 4px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--hp61-crimson);
    margin-bottom: 24px;
  }

  .hp61-hero__title {
    font-family: 'Syne', sans-serif;
    font-size: clamp(38px, 5.2vw, 64px);
    font-weight: 800;
    line-height: 1.08;
    color: #FFFFFF;
    margin: 0 0 24px;
    letter-spacing: -1px;
  }

  .hp61-hero__title span {
    background: linear-gradient(135deg, #EF4444 0%, #F59E0B 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hp61-hero__desc {
    font-size: 16px;
    line-height: 1.75;
    color: #A1A1AA;
    margin: 0 0 36px;
    max-width: 520px;
  }

  .hp61-hero__actions {
    display: flex;
    gap: 16px;
    align-items: center;
    flex-wrap: wrap;
  }

  .hp61-hero__btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 36px;
    background: var(--hp61-btn-bg);
    color: var(--hp61-btn-text);
    font-family: 'Space Grotesk', sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 4px;
    transition: all 0.35s ease;
    box-shadow: 0 4px 25px rgba(239, 68, 68, 0.4);
  }

  .hp61-hero__btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 35px rgba(239, 68, 68, 0.65);
  }

  .hp61-hero__media {
    position: relative;
  }

  .hp61-hero__img-wrap {
    position: relative;
    border-radius: 8px;
    overflow: hidden;
    height: 520px;
    border: 1px solid rgba(239, 68, 68, 0.3);
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.85), 0 0 30px rgba(239, 68, 68, 0.15);
  }

  .hp61-hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: brightness(0.9) contrast(1.15);
    transition: transform 0.6s ease;
  }

  .hp61-hero__img-wrap:hover .hp61-hero__img {
    transform: scale(1.04);
  }

  .hp61-hero__float-card {
    position: absolute;
    bottom: -16px;
    left: -16px;
    background: rgba(18, 18, 20, 0.95);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(239, 68, 68, 0.35);
    border-radius: 6px;
    padding: 16px 22px;
    display: flex;
    align-items: center;
    gap: 14px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
  }

  .hp61-hero__float-icon {
    width: 42px;
    height: 42px;
    background: linear-gradient(135deg, #EF4444, #7F1D1D);
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #FFFFFF;
    font-size: 18px;
  }

  .hp61-hero__float-label {
    font-family: 'Syne', sans-serif;
    font-size: 15px;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0;
  }

  .hp61-hero__float-sub {
    font-size: 11px;
    color: #EF4444;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin: 2px 0 0;
  }

  @media screen and (max-width: 992px) {
    .hp61-hero__container { grid-template-columns: 1fr; text-align: center; gap: 40px; }
    .hp61-hero__desc { margin-left: auto; margin-right: auto; }
    .hp61-hero__actions { justify-content: center; }
    .hp61-hero__img-wrap { height: 380px; }
    .hp61-hero__float-card { left: 50%; transform: translateX(-50%); bottom: -16px; }
  }

  @media screen and (max-width: 480px) {
    .hp61-hero__img-wrap { height: 300px; }
  }
{%- endstyle -%}

<div class="hp61-hero__lava-glow"></div>

<div class="hp61-hero__container">
  <div>
    <div class="hp61-hero__badge">
      <span>🌋</span>
      <span>{{ section.settings.badge | default: 'ICELANDIC OBSIDIAN v61' }}</span>
    </div>

    <h1 class="hp61-hero__title">
      {{ section.settings.heading | default: 'Obsidian Lava & <span>Volcanic Thermal</span> Mineral' }}
    </h1>

    <p class="hp61-hero__desc">
      {{ section.settings.description | default: 'Forged in geothermal volcanic vents in Iceland, harnessing micronized basalt lava ash, elemental sulfur, and bioactive silica peptides to detoxify and resurface pores.' }}
    </p>

    <div class="hp61-hero__actions">
      <a href="{{ section.settings.btn_url | default: '/collections/all' }}" class="hp61-hero__btn">
        <span>{{ section.settings.btn_text | default: 'Enter Geothermal Ritual' }}</span>
        <span>&rarr;</span>
      </a>
    </div>
  </div>

  <div class="hp61-hero__media">
    <div class="hp61-hero__img-wrap">
      {%- if section.settings.image != blank -%}
        <img height="{{ section.settings.image.height }}" width="{{ section.settings.image.width }}" src="{{ section.settings.image | image_url: width: 1000 }}" class="hp61-hero__img" alt="{{ section.settings.heading }}" loading="eager">
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'hp61-hero__img' }}
      {%- endif -%}

      <div class="hp61-hero__float-card">
        <div class="hp61-hero__float-icon">🌋</div>
        <div>
          <p class="hp61-hero__float-label">Micronized Basalt 3X</p>
          <p class="hp61-hero__float-sub">Geothermal Detox Chamber</p>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "HP61 Hero",
  "class": "section-hp61-hero",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#09090B" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#F4F4F5" },
    { "type": "color", "id": "accent_crimson", "label": "Crimson Accent", "default": "#EF4444" },
    { "type": "color", "id": "accent_lava", "label": "Lava Gold Accent", "default": "#F59E0B" },
    { "type": "color", "id": "btn_bg", "label": "Button Background", "default": "#EF4444" },
    { "type": "color", "id": "btn_text_color", "label": "Button Text Color", "default": "#FFFFFF" },
    { "type": "text", "id": "badge", "label": "Badge", "default": "ICELANDIC OBSIDIAN v61" },
    { "type": "textarea", "id": "heading", "label": "Heading (HTML allowed)", "default": "Obsidian Lava & <span>Volcanic Thermal</span> Mineral" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Forged in geothermal volcanic vents in Iceland." },
    { "type": "text", "id": "btn_text", "label": "Button Text", "default": "Enter Geothermal Ritual" },
    { "type": "url", "id": "btn_url", "label": "Button URL" },
    { "type": "image_picker", "id": "image", "label": "Hero Image" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 100 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 100 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "presets": [{ "name": "HP61 Hero" }]
}
{% endschema %}
