{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#ECFDF5' }};
    padding-top: {{ section.settings.padding_top | default: 50 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 50 }}px;
    border-top: 1px solid rgba(6, 78, 59, 0.12);
  }
  .hp62-trust__container { max-width: {{ section.settings.container_width | default: 1280 }}px; margin: 0 auto; padding: 0 24px; }
  .hp62-trust__grid { display: flex; justify-content: center; gap: 50px; flex-wrap: wrap; }
  .hp62-trust__item { display: flex; align-items: center; gap: 14px; }
  .hp62-trust__icon {
    width: 44px; height: 44px; background: #FFFFFF;
    border-radius: 50%; display: flex; align-items: center; justify-content: center;
    font-size: 18px; color: #064E3B; flex-shrink: 0;
    border: 1px solid rgba(6, 78, 59, 0.2); box-shadow: 0 4px 15px rgba(6, 78, 59, 0.05);
  }
  .hp62-trust__label { font-family: 'Italiana', serif; font-size: 18px; font-weight: 700; color: #064E3B; margin: 0; }
  .hp62-trust__sub { font-size: 11px; color: #059669; margin: 2px 0 0; font-family: 'Outfit', sans-serif; letter-spacing: 0.5px; }
  @media screen and (max-width: 768px) { .hp62-trust__grid { gap: 24px; } }
  @media screen and (max-width: 480px) {
    .hp62-trust__grid { flex-direction: column; align-items: center; text-align: center; }
    .hp62-trust__item { flex-direction: column; }
  }
{%- endstyle -%}
<div class="hp62-trust__container">
  <div class="hp62-trust__grid">
    {%- for block in section.blocks -%}
      <div class="hp62-trust__item" {{ block.shopify_attributes }}>
        <div class="hp62-trust__icon">{{ block.settings.icon | default: '🏔️' }}</div>
        <div>
          <p class="hp62-trust__label">{{ block.settings.title | default: 'Bio-Suisse Certified' }}</p>
          <p class="hp62-trust__sub">{{ block.settings.subtitle | default: 'Pure alpine organic harvest' }}</p>
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "HP62 Trust",
  "class": "section-hp62-trust",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ECFDF5" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 100, "step": 10, "unit": "px", "label": "Padding Top", "default": 50 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 100, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 50 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "blocks": [{
    "type": "badge", "name": "Badge",
    "settings": [
      { "type": "text", "id": "icon", "label": "Icon", "default": "🏔️" },
      { "type": "text", "id": "title", "label": "Title", "default": "Bio-Suisse Certified" },
      { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Pure alpine organic harvest" }
    ]
  }],
  "presets": [{
    "name": "HP62 Trust",
    "blocks": [
      { "type": "badge", "settings": { "icon": "🏔️", "title": "Bio-Suisse Certified", "subtitle": "Pure alpine organic harvest" } },
      { "type": "badge", "settings": { "icon": "❄️", "title": "Zermatt Glacial Tested", "subtitle": "Trace mineral purity verified" } },
      { "type": "badge", "settings": { "icon": "📦", "title": "Alpine Cryo-Protected", "subtitle": "Thermal insulated packaging" } },
      { "type": "badge", "settings": { "icon": "🛡️", "title": "Swiss Quality Guarantee", "subtitle": "60-day satisfaction pledge" } }
    ]
  }]
}
{% endschema %}
