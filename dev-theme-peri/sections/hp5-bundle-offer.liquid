{%- liquid
  assign bg_color = section.settings.bg_color | default: '#ffffff'
  assign text_color = section.settings.text_color | default: '#1a2a3a'
  assign accent_color = section.settings.accent_color | default: '#0066cc'
  
  assign padding_top_desktop = section.settings.padding_top_desktop
  assign padding_bottom_desktop = section.settings.padding_bottom_desktop
  assign padding_top_mobile = section.settings.padding_top_mobile
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile
-%}

<style>
  #shopify-section-{{ section.id }} {
    --hp5-bo-bg: {{ bg_color }};
    --hp5-bo-text: {{ text_color }};
    --hp5-bo-accent: {{ accent_color }};
    
    --hp5-bo-pt-desk: {{ padding_top_desktop }}px;
    --hp5-bo-pb-desk: {{ padding_bottom_desktop }}px;
    --hp5-bo-pt-mob: {{ padding_top_mobile }}px;
    --hp5-bo-pb-mob: {{ padding_bottom_mobile }}px;
  }

  .hp5-health-bo-{{ section.id }} {
    padding-top: var(--hp5-bo-pt-desk);
    padding-bottom: var(--hp5-bo-pb-desk);
    background-color: var(--hp5-bo-bg);
    color: var(--hp5-bo-text);
    font-family: 'Inter', sans-serif;
  }

  .hp5-bo-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
    text-align: center;
  }

  .hp5-bo-header {
    max-width: 700px;
    margin: 0 auto 50px auto;
  }

  .hp5-bo-title {
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 700;
    line-height: 1.1;
    margin: 0 0 15px 0;
    letter-spacing: -1px;
  }

  .hp5-bo-desc {
    font-size: 16px;
    line-height: 1.6;
    color: rgba(26,42,58,0.7);
    margin: 0;
  }

  .hp5-bo-container {
    background: #f8fafc;
    border-radius: 20px;
    padding: 40px;
    border: 1px solid rgba(26,42,58,0.05);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hp5-bo-products {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 20px;
    margin-bottom: 40px;
    width: 100%;
  }

  .hp5-bo-product {
    width: 220px;
    background: #ffffff;
    border-radius: 12px;
    padding: 20px;
    text-align: center;
    box-shadow: 0 10px 20px rgba(0,0,0,0.02);
    position: relative;
  }
  .hp5-bo-product img {
    width: 120px;
    height: 120px;
    object-fit: contain;
    margin: 0 auto 15px auto;
    display: block;
  }
  .hp5-bo-product-title {
    font-size: 14px;
    font-weight: 700;
    margin: 0 0 5px 0;
    line-height: 1.3;
  }
  .hp5-bo-product-price {
    font-size: 14px;
    color: rgba(26,42,58,0.6);
  }

  .hp5-bo-plus {
    width: 40px; height: 40px;
    background: #e6eff6;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    color: var(--hp5-bo-accent);
    flex-shrink: 0;
    font-size: 20px;
    font-weight: 700;
  }

  /* Summary Box */
  .hp5-bo-summary {
    background: #ffffff;
    padding: 30px 40px;
    border-radius: 12px;
    box-shadow: 0 15px 35px rgba(0,0,0,0.05);
    border: 2px solid var(--hp5-bo-accent);
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    max-width: 800px;
    gap: 30px;
  }

  .hp5-bo-summary-text {
    text-align: left;
  }
  .hp5-bo-summary-title {
    font-size: 24px;
    font-weight: 700;
    margin: 0 0 5px 0;
  }
  .hp5-bo-summary-price {
    font-size: 20px;
    font-weight: 700;
    color: var(--hp5-bo-accent);
  }
  .hp5-bo-summary-compare {
    text-decoration: line-through;
    color: rgba(26,42,58,0.4);
    font-size: 16px;
    margin-left: 10px;
  }

  .hp5-bo-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--hp5-bo-accent);
    color: #ffffff;
    padding: 16px 40px;
    border-radius: 8px;
    font-size: 16px;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.3s ease;
    white-space: nowrap;
  }
  .hp5-bo-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgba(0,102,204,0.2);
  }

  @media screen and (max-width: 900px) {
    .hp5-bo-summary {
      flex-direction: column;
      text-align: center;
    }
    .hp5-bo-summary-text {
      text-align: center;
    }
  }

  @media screen and (max-width: 768px) {
    .hp5-health-bo-{{ section.id }} {
      padding-top: var(--hp5-bo-pt-mob);
      padding-bottom: var(--hp5-bo-pb-mob);
    }
    .hp5-bo-inner {
      padding: 0 20px;
    }
    .hp5-bo-container {
      padding: 20px;
    }
    .hp5-bo-product {
      width: 140px;
      padding: 15px;
    }
    .hp5-bo-product img {
      width: 80px; height: 80px;
    }
    .hp5-bo-plus {
      width: 30px; height: 30px; font-size: 16px;
    }
    .hp5-bo-summary {
      padding: 20px;
    }
  }
</style>

<section class="hp5-health-bo-{{ section.id }}" aria-label="Routine Builder">
  <div class="hp5-bo-inner">
    
    <div class="hp5-bo-header">
      <h2 class="hp5-bo-title">{{ section.settings.title }}</h2>
      {%- if section.settings.description != blank -%}
        <p class="hp5-bo-desc">{{ section.settings.description }}</p>
      {%- endif -%}
    </div>

    <div class="hp5-bo-container">
      
      <div class="hp5-bo-products">
        {%- assign total_price = 0 -%}
        {%- assign compare_price = 0 -%}
        
        {%- for block in section.blocks -%}
          {%- if forloop.index0 > 0 -%}
            <div class="hp5-bo-plus">+</div>
          {%- endif -%}
          
          <div class="hp5-bo-product" {{ block.shopify_attributes }}>
            {%- assign prod = all_products[block.settings.product] -%}
            {%- if prod != blank -%}
              <img src="{{ prod.featured_image | image_url: width: 300 }}" loading="lazy" alt="{{ prod.title }}">
              <h4 class="hp5-bo-product-title">{{ prod.title }}</h4>
              <div class="hp5-bo-product-price">{{ prod.price | money }}</div>
              {%- assign total_price = total_price | plus: prod.price -%}
              {%- assign comp = prod.compare_at_price | default: prod.price -%}
              {%- assign compare_price = compare_price | plus: comp -%}
            {%- else -%}
              {{ 'product-' | append: forloop.index | placeholder_svg_tag: 'hp5-bo-img placeholder-svg' }}
              <h4 class="hp5-bo-product-title">Supplement {{ forloop.index }}</h4>
              <div class="hp5-bo-product-price">$39.00</div>
              {%- assign total_price = total_price | plus: 3900 -%}
              {%- assign compare_price = compare_price | plus: 4900 -%}
            {%- endif -%}
          </div>
        {%- endfor -%}

        {%- if section.blocks.size == 0 -%}
          <div class="hp5-bo-product">
            {{ 'product-1' | placeholder_svg_tag }}
            <h4 class="hp5-bo-product-title">Morning Multi</h4><div class="hp5-bo-product-price">$39.00</div>
          </div>
          <div class="hp5-bo-plus">+</div>
          <div class="hp5-bo-product">
            {{ 'product-2' | placeholder_svg_tag }}
            <h4 class="hp5-bo-product-title">Probiotic Gut</h4><div class="hp5-bo-product-price">$45.00</div>
          </div>
          <div class="hp5-bo-plus">+</div>
          <div class="hp5-bo-product">
            {{ 'product-3' | placeholder_svg_tag }}
            <h4 class="hp5-bo-product-title">Sleep Matrix</h4><div class="hp5-bo-product-price">$42.00</div>
          </div>
          {%- assign total_price = 12600 -%}
          {%- assign compare_price = 15000 -%}
        {%- endif -%}
      </div>

      <div class="hp5-bo-summary">
        <div class="hp5-bo-summary-text">
          <h3 class="hp5-bo-summary-title">{{ section.settings.bundle_name }}</h3>
          <div class="hp5-bo-summary-price">
            {%- if section.settings.discount_amount != blank -%}
              {%- assign discount = section.settings.discount_amount | times: 100 -%}
              {{ total_price | minus: discount | money }}
              <span class="hp5-bo-summary-compare">{{ total_price | money }}</span>
            {%- else -%}
              {{ total_price | money }}
            {%- endif -%}
          </div>
        </div>
        <a href="{{ section.settings.btn_link }}" class="hp5-bo-btn">{{ section.settings.btn_label }}</a>
      </div>

    </div>

  </div>
</section>

{% schema %}
{
  "name": "HP5 Health Bundle",
  "tag": "section",
  "class": "section-hp5-bundle",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "The Ultimate Wellness Routine"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Synergistic formulas designed to work together for comprehensive whole-body support."
    },
    {
      "type": "text",
      "id": "bundle_name",
      "label": "Bundle Name",
      "default": "The Core Foundation Kit"
    },
    {
      "type": "number",
      "id": "discount_amount",
      "label": "Discount Amount ($ off total)",
      "default": 20
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "Add Kit to Cart"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1a2a3a"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#0066cc"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Top (Desktop)", "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Bottom (Desktop)", "default": 100
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Top (Mobile)", "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Bottom (Mobile)", "default": 60
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP5 Health Bundle",
      "category": "Products",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
