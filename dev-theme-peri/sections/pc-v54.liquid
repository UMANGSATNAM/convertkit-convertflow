{%- comment -%}
  PC V54 — URBAN OUTDOOR & ALPINE CAMPING PRODUCT GRID
  Design: Dark Forest Slate (#1C2526), Terracotta Orange (#E06D53) & Sage (#88A096) accents, Archivo & Space Grotesk typography
  Card Shape: 6px chamfered corners, rugged outdoors alpine gear aesthetic
{%- endcomment -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Archivo:wght@600;700&family=Space+Grotesk:wght@600;700&display=swap');

  .pcv54 {
    --bg: {{ section.settings.bg_color | default: '#1C2526' }};
    --card-bg: {{ section.settings.card_bg | default: '#273335' }};
    --text: {{ section.settings.text_color | default: '#F1F5F9' }};
    --muted: {{ section.settings.muted_color | default: '#88A096' }};
    --accent: {{ section.settings.accent_color | default: '#E06D53' }};
    --accent-hover: {{ section.settings.accent_hover | default: '#C8573D' }};
    --border: {{ section.settings.border_color | default: '#374648' }};
    --badge-sale-bg: #E06D53;
    --badge-sale-text: #FFFFFF;
    --f-heading: 'Space Grotesk', sans-serif;
    --f-body: 'Archivo', sans-serif;
    --r-card: 6px;
    --ease: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    background-color: var(--bg);
    color: var(--text);
    font-family: var(--f-body);
    padding: {{ section.settings.padding_top | default: 56 }}px 0 {{ section.settings.padding_bottom | default: 56 }}px 0;
    line-height: 1.4;
    -webkit-font-smoothing: antialiased;
  }

  .pcv54 *, .pcv54 *::before, .pcv54 *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .pcv54 a { color: inherit; text-decoration: none; }
  .pcv54 button { font-family: inherit; cursor: pointer; border: none; background: none; }
  .pcv54 img { max-width: 100%; display: block; }

  .pcv54__wrap { max-width: 1280px; margin: 0 auto; padding: 0 20px; }

  /* HEADER */
  .pcv54__head { display: flex; flex-direction: column; gap: 8px; margin-bottom: 36px; text-align: {{ section.settings.header_align | default: 'left' }}; }
  @media (min-width: 768px) {
    .pcv54__head { display: flex; flex-direction: row; justify-content: space-between; align-items: flex-end; }
  }
  .pcv54__title { font-family: var(--f-heading); font-size: 30px; font-weight: 700; color: #FFFFFF; text-transform: uppercase; letter-spacing: -0.01em; }
  @media (min-width: 768px) { .pcv54__title { font-size: 40px; } }
  .pcv54__sub { font-size: 15px; color: var(--muted); }
  .pcv54__viewall { display: inline-flex; align-items: center; gap: 8px; font-weight: 700; font-size: 12px; font-family: var(--f-heading); text-transform: uppercase; letter-spacing: 0.1em; color: #FFFFFF; background: var(--accent); padding: 9px 22px; border-radius: 4px; transition: var(--ease); box-shadow: 0 0 15px rgba(224, 109, 83, 0.3); }
  .pcv54__viewall:hover { background: var(--accent-hover); transform: scale(1.04); }

  /* GRID */
  .pcv54__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr);
    gap: 18px;
  }
  @media (min-width: 640px) {
    .pcv54__grid { grid-template-columns: repeat({{ section.settings.cols_tablet | default: 3 }}, 1fr); gap: 24px; }
  }
  @media (min-width: 1024px) {
    .pcv54__grid { grid-template-columns: repeat({{ section.settings.cols_desktop | default: 4 }}, 1fr); gap: 28px; }
  }

  /* CARD */
  .pcv54__card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--r-card);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    position: relative;
    box-shadow: 0 8px 24px -6px rgba(0, 0, 0, 0.3);
    transition: var(--ease);
  }
  .pcv54__card:hover {
    transform: translateY(-4px);
    border-color: var(--accent);
    box-shadow: 0 0 20px rgba(224, 109, 83, 0.3);
  }

  /* IMAGE CONTAINER */
  .pcv54__img-box {
    position: relative;
    width: 100%;
    aspect-ratio: {{ section.settings.img_ratio | default: '1/1' }};
    background: #141B1C;
    overflow: hidden;
  }
  .pcv54__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .pcv54__img--sec {
    position: absolute;
    top: 0; left: 0;
    opacity: 0;
  }
  .pcv54__card:hover .pcv54__img--pri {
    {% if section.settings.enable_sec_img %}
      opacity: 0;
    {% else %}
      transform: scale(1.06);
    {% endif %}
  }
  .pcv54__card:hover .pcv54__img--sec { opacity: 1; transform: scale(1.06); }

  /* BADGES */
  .pcv54__badges { position: absolute; top: 12px; left: 12px; display: flex; flex-direction: column; gap: 6px; z-index: 2; pointer-events: none; }
  .pcv54__badge { font-size: 10px; font-weight: 700; text-transform: uppercase; padding: 4px 10px; border-radius: 2px; letter-spacing: 0.05em; font-family: var(--f-heading); }
  .pcv54__badge--sale { background: var(--badge-sale-bg); color: var(--badge-sale-text); }
  .pcv54__badge--tag { background: #88A096; color: #1C2526; }
  .pcv54__badge--sold { background: #374648; color: #88A096; }

  /* WISHLIST BUTTON */
  .pcv54__wish {
    position: absolute;
    top: 12px; right: 12px;
    width: 36px; height: 36px;
    border-radius: 50%;
    background: rgba(28, 37, 38, 0.85);
    border: 1px solid var(--border);
    backdrop-filter: blur(4px);
    display: flex; align-items: center; justify-content: center;
    color: var(--accent);
    z-index: 3;
    transition: var(--ease);
  }
  .pcv54__wish:hover { background: var(--accent); color: #FFFFFF; border-color: var(--accent); transform: scale(1.1); }
  .pcv54__wish.active { color: #FFFFFF; background: var(--accent); border-color: var(--accent); }

  /* QUICK ADD HOVER */
  .pcv54__quick-box { padding: 12px; background: var(--card-bg); border-top: 1px solid var(--border); }
  .pcv54__quick-btn {
    width: 100%;
    padding: 10px 14px;
    background: var(--accent);
    color: #FFFFFF;
    font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em;
    font-family: var(--f-heading);
    border-radius: 4px;
    border: none;
    display: flex; align-items: center; justify-content: center; gap: 8px;
    transition: var(--ease);
    box-shadow: 0 0 12px rgba(224, 109, 83, 0.3);
  }
  .pcv54__quick-btn:hover { background: var(--accent-hover); box-shadow: 0 0 20px rgba(224, 109, 83, 0.5); }
  .pcv54__quick-btn:disabled { background: #374648; color: #88A096; cursor: not-allowed; box-shadow: none; }

  /* CARD CONTENT */
  .pcv54__content { padding: 14px; display: flex; flex-direction: column; gap: 6px; flex-grow: 1; text-align: center; }

  .pcv54__vendor { font-size: 10px; text-transform: uppercase; color: var(--accent); font-weight: 700; font-family: var(--f-heading); letter-spacing: 0.1em; }
  .pcv54__item-title { font-family: var(--f-heading); font-size: 16px; font-weight: 600; color: var(--text); line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; text-transform: uppercase; }

  /* RATING */
  .pcv54__rating { display: flex; align-items: center; justify-content: center; gap: 4px; font-size: 12px; color: var(--accent); font-weight: 700; }
  .pcv54__stars { letter-spacing: 1px; }
  .pcv54__rev-cnt { color: var(--muted); font-size: 11px; font-weight: 400; }

  /* PRICE */
  .pcv54__price-row { display: flex; align-items: baseline; justify-content: center; gap: 8px; margin-top: auto; padding-top: 4px; }
  .pcv54__price { font-size: 17px; font-weight: 700; color: #FFFFFF; font-family: var(--f-heading); }
  .pcv54__cmp-price { font-size: 13px; color: var(--muted); text-decoration: line-through; }

  /* SWATCHES */
  .pcv54__swatches { display: flex; gap: 6px; align-items: center; justify-content: center; margin-top: 4px; }
  .pcv54__swatch { width: 14px; height: 14px; border-radius: 50%; border: 1px solid var(--border); cursor: pointer; transition: var(--ease); }
  .pcv54__swatch:hover, .pcv54__swatch.active { transform: scale(1.25); border-color: var(--accent); }

  /* URGENCY MICRO */
  .pcv54__urgency { font-size: 11px; color: var(--accent); font-weight: 700; font-family: var(--f-heading); text-transform: uppercase; display: flex; align-items: center; justify-content: center; gap: 4px; margin-top: 2px; }

  /* TOAST */
  .pcv54__toast {
    position: fixed; bottom: 20px; right: 20px;
    background: var(--accent); color: #FFFFFF;
    padding: 12px 22px; border-radius: 4px;
    font-size: 12px; font-weight: 700; font-family: var(--f-heading); text-transform: uppercase;
    z-index: 9999;
    transform: translateY(100px); opacity: 0;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 0 20px rgba(224, 109, 83, 0.5);
  }
  .pcv54__toast.show { transform: translateY(0); opacity: 1; }
</style>

<div class="pcv54">
  <div class="pcv54__wrap">
    
    {% if section.settings.title != blank or section.settings.subheading != blank %}
      <div class="pcv54__head">
        <div>
          {% if section.settings.title != blank %}
            <h2 class="pcv54__title">{{ section.settings.title | escape }}</h2>
          {% endif %}
          {% if section.settings.subheading != blank %}
            <p class="pcv54__sub">{{ section.settings.subheading | escape }}</p>
          {% endif %}
        </div>
        {% if section.settings.show_view_all and section.settings.collection != blank %}
          <a href="{{ collections[section.settings.collection].url }}" class="pcv54__viewall">
            {{ section.settings.view_all_label | default: 'Explore Alpine Gear' }} 🏔️ &rarr;
          </a>
        {% endif %}
      </div>
    {% endif %}

    <div class="pcv54__grid">
      {% assign target_coll = collections[section.settings.collection] %}
      {% assign limit_num = section.settings.products_per_page | default: 8 %}

      {% if target_coll != blank and target_coll.products.size > 0 %}
        {% for product in target_coll.products limit: limit_num %}
          {% assign current_variant = product.selected_or_first_available_variant %}
          
          {% render 'card-v54', product: product, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v54', product: nil, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% endif %}
    </div>

  </div>
</div>

<div class="pcv54__toast" id="pcv54-toast">ALPINE GEAR ADDED!</div>

<script>
(function(){
  // Wishlist is handled globally by assets/wishlist.js (shared store: cf_wishlist_items).
  // Buttons are rendered by snippets/wishlist-button.liquid — no per-section storage.


  document.querySelectorAll('[data-pcv54-add]').forEach(function(btn){
    btn.addEventListener('click', function(e){
      e.preventDefault(); e.stopPropagation();
      var id = btn.dataset.pcv54Add, orig = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = 'PACKING...';

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: id, quantity: 1 })
      })
      .then(function(r){ return r.json(); })
      .then(function(){
        btn.innerHTML = '✓ ADDED';
        showT('ALPINE GEAR ADDED!');
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      })
      .catch(function(){
        btn.innerHTML = 'ERROR';
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      });
    });
  });

  function showT(msg){
    var t = document.getElementById('pcv54-toast');
    if(!t) return;
    t.textContent = msg;
    t.classList.add('show');
    setTimeout(function(){ t.classList.remove('show'); }, 3000);
  }
})();
</script>

