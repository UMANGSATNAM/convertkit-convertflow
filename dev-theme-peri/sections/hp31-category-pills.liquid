{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Lato:wght@300;400;700&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    
    --font-body: 'Lato', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .hp31-pills-wrapper {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 20px;
  }

  @media screen and (max-width: 768px) {
    .hp31-pills-wrapper {
      padding: 0 20px;
      flex-wrap: nowrap;
      justify-content: flex-start;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      padding-bottom: 20px;
    }
    .hp31-pills-wrapper::-webkit-scrollbar {
      display: none;
    }
  }

  .hp31-pill {
    display: flex;
    align-items: center;
    gap: 12px;
    background: transparent;
    border: 1px solid rgba(0,0,0,0.1);
    border-radius: 50px;
    padding: 8px 24px 8px 8px;
    text-decoration: none;
    color: var(--text-color);
    transition: all 0.4s ease;
    scroll-snap-align: center;
  }

  .hp31-pill:hover {
    background: var(--text-color);
    color: var(--bg-color);
    border-color: var(--text-color);
    transform: translateY(-3px);
    box-shadow: 0 10px 20px rgba(0,0,0,0.05);
  }

  .hp31-pill__image-wrap {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    overflow: hidden;
    background: #E8E2D6;
    flex-shrink: 0;
  }

  .hp31-pill__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hp31-pill__title {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 400;
    letter-spacing: 0.05em;
    white-space: nowrap;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp31-pills-wrapper" id="HP31Pills-{{ section.id }}">
  {%- for block in section.blocks -%}
    <a href="{{ block.settings.link | default: '#' }}" class="hp31-pill" {{ block.shopify_attributes }}>
      <div class="hp31-pill__image-wrap">
        {%- if block.settings.image != blank -%}
          <img height="{{ block.settings.image.height }}" width="{{ block.settings.image.width }}" src="{{ block.settings.image | image_url: width: 100 }}" alt="{{ block.settings.title | escape }}" class="hp31-pill__image" loading="lazy">
        {%- endif -%}
      </div>
      <span class="hp31-pill__title">{{ block.settings.title }}</span>
    </a>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "HP31 - Zen Category Pills",
  "class": "section-hp31-category-pills",
  "settings": [
    {
      "type": "header",
      "content": "Zen Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (Beige)",
      "default": "#F9F6F0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text (Charcoal)",
      "default": "#2C2C2C"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Pill",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Small Image/Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Category Title",
          "default": "Ceramics"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP31 - Zen Category Pills",
      "blocks": [
        { "type": "category", "settings": { "title": "Living" } },
        { "type": "category", "settings": { "title": "Dining" } },
        { "type": "category", "settings": { "title": "Wellness" } },
        { "type": "category", "settings": { "title": "Lighting" } },
        { "type": "category", "settings": { "title": "Textiles" } }
      ]
    }
  ]
}
{% endschema %}
