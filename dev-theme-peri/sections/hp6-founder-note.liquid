{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#111111'
  assign text_color = section.settings.text_color | default: '#ffffff'
  assign accent_color = section.settings.accent_color | default: '#00ffcc'
  assign quote = section.settings.quote | default: "WE DIDN'T BUILD THIS GEAR FOR THE AVERAGE. WE BUILT IT FOR THE OBSESSED."
  assign author = section.settings.author | default: 'JOHN DOE, FOUNDER'
  assign image = section.settings.image
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    color: {{ text_color }};
    padding: 120px 0;
    position: relative;
  }
  
  .hp6-founder-container-{{ section_id }} {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }
  
  .hp6-founder-image-col-{{ section_id }} {
    position: relative;
    padding-right: 20px;
  }
  
  /* Edgy image wrapper */
  .hp6-founder-image-wrapper-{{ section_id }} {
    position: relative;
    z-index: 2;
    aspect-ratio: 4/5;
    background: #222;
    clip-path: polygon(10% 0, 100% 0, 100% 90%, 90% 100%, 0 100%, 0 10%);
  }
  
  .hp6-founder-image-wrapper-{{ section_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%) contrast(1.2);
    transition: filter 0.5s ease;
  }
  
  .hp6-founder-image-wrapper-{{ section_id }}:hover img {
    filter: grayscale(0%) contrast(1.1);
  }
  
  /* Decorative backdrop for image */
  .hp6-founder-image-backdrop-{{ section_id }} {
    position: absolute;
    top: 20px;
    left: -20px;
    width: 100%;
    height: 100%;
    background: transparent;
    border: 3px solid {{ accent_color }};
    z-index: 1;
    clip-path: polygon(10% 0, 100% 0, 100% 90%, 90% 100%, 0 100%, 0 10%);
  }
  
  .hp6-founder-content-col-{{ section_id }} {
    position: relative;
  }
  
  .hp6-founder-quote-mark-{{ section_id }} {
    font-family: 'Impact', sans-serif;
    font-size: 15rem;
    line-height: 0;
    position: absolute;
    top: 50px;
    left: -40px;
    color: {{ accent_color }};
    opacity: 0.15;
    z-index: 0;
  }
  
  .hp6-founder-quote-{{ section_id }} {
    font-family: 'Impact', 'Arial Black', sans-serif;
    font-size: clamp(2rem, 4vw, 3.5rem);
    line-height: 1.1;
    text-transform: uppercase;
    font-weight: 900;
    margin: 0 0 30px 0;
    position: relative;
    z-index: 1;
    letter-spacing: -0.02em;
  }
  
  .hp6-founder-author-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: 1.1rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: {{ accent_color }};
    position: relative;
    display: inline-block;
    padding-left: 60px;
  }
  
  .hp6-founder-author-{{ section_id }}::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 40px;
    height: 3px;
    background: {{ accent_color }};
    transform: translateY(-50%);
  }
  
  /* "X" decorative mark */
  .hp6-founder-decoration-{{ section_id }} {
    position: absolute;
    bottom: -20px;
    right: 0;
    width: 100px;
    height: 100px;
    opacity: 0.1;
    background: 
      linear-gradient(45deg, transparent 48%, {{ text_color }} 48%, {{ text_color }} 52%, transparent 52%),
      linear-gradient(-45deg, transparent 48%, {{ text_color }} 48%, {{ text_color }} 52%, transparent 52%);
  }

  @media (max-width: 992px) {
    .hp6-founder-container-{{ section_id }} {
      grid-template-columns: 1fr;
      gap: 50px;
    }
    .hp6-founder-image-col-{{ section_id }} {
      max-width: 600px;
      margin: 0 auto;
    }
    .hp6-founder-quote-mark-{{ section_id }} {
      top: 40px;
      left: 0px;
      font-size: 10rem;
    }
  }
  
  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 80px 0;
    }
    .hp6-founder-quote-{{ section_id }} {
      font-size: 2rem;
    }
  }
</style>

<div class="hp6-founder-container-{{ section_id }}">
  <div class="hp6-founder-image-col-{{ section_id }}">
    <div class="hp6-founder-image-backdrop-{{ section_id }}"></div>
    <div class="hp6-founder-image-wrapper-{{ section_id }}">
      {% if image != blank %}
        <img src="{{ image | image_url: width: 1000 }}" alt="{{ author }}" loading="lazy" width="800" height="1000">
      {% else %}
        <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: #333; color: #666; font-family: monospace;">
          FOUNDER IMAGE 800x1000
        </div>
      {% endif %}
    </div>
  </div>
  
  <div class="hp6-founder-content-col-{{ section_id }}">
    <span class="hp6-founder-quote-mark-{{ section_id }}">"</span>
    <h2 class="hp6-founder-quote-{{ section_id }}">{{ quote }}</h2>
    <div class="hp6-founder-author-{{ section_id }}">{{ author }}</div>
    <div class="hp6-founder-decoration-{{ section_id }}"></div>
  </div>
</div>

{% schema %}
{
  "name": "HP6 Founder Note",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#00ffcc"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Founder Image"
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Quote",
      "default": "WE DIDN'T BUILD THIS GEAR FOR THE AVERAGE. WE BUILT IT FOR THE OBSESSED."
    },
    {
      "type": "text",
      "id": "author",
      "label": "Author/Title",
      "default": "JOHN DOE, FOUNDER"
    }
  ],
  "presets": [
    {
      "name": "HP6 Founder Note"
    }
  ]
}
{% endschema %}
