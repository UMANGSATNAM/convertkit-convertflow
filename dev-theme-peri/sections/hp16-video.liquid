{%- liquid
  assign section_id = section.id
-%}

<style>
  #shopify-section-{{ section_id }} {
    padding: 0;
    border-bottom: 4px solid #000;
  }
  
  .hp16-video-container-{{ section_id }} {
    position: relative;
    width: 100%;
    height: 90vh;
    min-height: 600px;
    background: #000;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .hp16-video-element-{{ section_id }} {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover;
    opacity: 0.8;
  }
  
  .hp16-video-overlay-{{ section_id }} {
    position: relative;
    z-index: 2;
    text-align: center;
    color: #fff;
    background: rgba(0,255,255,0.3);
    border: 4px solid #000;
    border-radius: 30px;
    padding: 60px;
    backdrop-filter: blur(5px);
    box-shadow: 15px 15px 0 #FF00FF;
    transform: rotate(2deg);
  }
  
  .hp16-video-play-{{ section_id }} {
    width: 100px;
    height: 100px;
    background: #FFFF00;
    border: 4px solid #000;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 30px;
    cursor: pointer;
    color: #000;
    box-shadow: 5px 5px 0 #000;
    transition: all 0.2s ease;
  }
  
  .hp16-video-play-{{ section_id }}:hover {
    transform: scale(1.1) rotate(10deg);
  }
  
  .hp16-video-play-{{ section_id }} svg {
    width: 50px;
    height: 50px;
    margin-left: 8px;
  }
  
  .hp16-video-title-{{ section_id }} {
    font-family: 'Arial Black', Impact, sans-serif;
    font-size: clamp(3rem, 5vw, 5rem);
    text-transform: uppercase;
    color: #FFF;
    -webkit-text-stroke: 2px #000;
    text-shadow: 4px 4px 0 #FF00FF;
    margin: 0;
    line-height: 1;
  }

  @media (max-width: 768px) {
    .hp16-video-container-{{ section_id }} {
      height: 60vh;
      padding: 20px;
    }
    .hp16-video-overlay-{{ section_id }} {
      padding: 30px;
      box-shadow: 8px 8px 0 #FF00FF;
    }
    .hp16-video-play-{{ section_id }} {
      width: 70px; height: 70px;
    }
    .hp16-video-play-{{ section_id }} svg {
      width: 30px; height: 30px;
    }
  }
</style>

<div class="hp16-video-container-{{ section_id }}">
  {% if section.settings.video_url != blank %}
    <video class="hp16-video-element-{{ section_id }}" autoplay loop muted playsinline>
      <source src="{{ section.settings.video_url }}" type="video/mp4">
    </video>
  {% else %}
    <div class="hp16-video-element-{{ section_id }}" style="background: repeating-linear-gradient(45deg, #EFEFEF, #EFEFEF 12px, #E6E6E6 12px, #E6E6E6 24px);"></div>
  {% endif %}
  
  <div class="hp16-video-overlay-{{ section_id }}">
    <button class="hp16-video-play-{{ section_id }}">
      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
    </button>
    <h2 class="hp16-video-title-{{ section_id }}">{{ section.settings.title | default: 'WATCH THIS' }}</h2>
  </div>
</div>

{% schema %}
{
  "name": "HP16 Video",
  "settings": [
    {
      "type": "text",
      "id": "video_url",
      "label": "Video URL (MP4)",
      "info": "Upload video to Settings > Files and paste URL here."
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "WATCH THIS"
    }
  ],
  "presets": [
    {
      "name": "HP16 Video"
    }
  ]
}
{% endschema %}
