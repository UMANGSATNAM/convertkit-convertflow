{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --font-heading: 'Cormorant Garamond', serif;
    --font-body: 'Inter', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    overflow: hidden;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.8 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.8 | round }}px;
    }
  }

  .hp26-bundle-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    align-items: center;
    gap: 80px;
  }

  @media screen and (max-width: 1024px) {
    .hp26-bundle-wrapper {
      gap: 50px;
    }
  }

  @media screen and (max-width: 768px) {
    .hp26-bundle-wrapper {
      flex-direction: column;
      padding: 0 20px;
      gap: 40px;
    }
  }

  /* Left: Content */
  .hp26-bundle__content {
    flex: 1;
    max-width: 500px;
  }

  @media screen and (max-width: 768px) {
    .hp26-bundle__content {
      text-align: center;
      max-width: 100%;
      order: 2;
    }
  }

  .hp26-bundle__subtitle {
    font-family: var(--font-body);
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-color);
    margin-bottom: 20px;
    opacity: 0.6;
    display: flex;
    align-items: center;
    gap: 15px;
  }

  .hp26-bundle__subtitle::before {
    content: '';
    display: block;
    width: 25px;
    height: 1px;
    background-color: var(--text-color);
    opacity: 0.4;
  }

  @media screen and (max-width: 768px) {
    .hp26-bundle__subtitle {
      justify-content: center;
    }
    .hp26-bundle__subtitle::before {
      display: none;
    }
  }

  .hp26-bundle__title {
    font-family: var(--font-heading);
    font-size: clamp(36px, 5vw, {{ section.settings.title_size }}px);
    font-weight: 400;
    line-height: 1.1;
    color: var(--text-color);
    margin: 0 0 20px;
  }

  .hp26-bundle__title em {
    font-style: italic;
    font-weight: 300;
    color: var(--accent-color);
  }

  .hp26-bundle__text {
    font-family: var(--font-body);
    font-size: clamp(14px, 1.5vw, {{ section.settings.text_size }}px);
    line-height: 1.7;
    color: var(--text-color);
    opacity: 0.8;
    margin: 0 0 40px;
  }

  .hp26-bundle__list {
    list-style: none;
    padding: 0;
    margin: 0 0 40px 0;
  }

  .hp26-bundle__list li {
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--text-color);
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    gap: 12px;
    opacity: 0.85;
  }

  .hp26-bundle__list li::before {
    content: '';
    display: block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--accent-color);
  }

  @media screen and (max-width: 768px) {
    .hp26-bundle__list li {
      justify-content: center;
    }
  }

  .hp26-bundle__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 15px 45px;
    background-color: var(--text-color);
    color: var(--bg-color);
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 4px;
    transition: all 0.4s ease;
  }

  .hp26-bundle__btn:hover {
    background-color: var(--accent-color);
    color: #fff;
  }

  /* Right: Overlapping Images */
  .hp26-bundle__images {
    flex: 1;
    position: relative;
    height: 600px;
  }

  @media screen and (max-width: 992px) {
    .hp26-bundle__images {
      height: 450px;
    }
  }

  @media screen and (max-width: 768px) {
    .hp26-bundle__images {
      width: 100%;
      height: 400px;
      order: 1;
    }
  }

  .hp26-bundle__img-main {
    position: absolute;
    top: 0;
    right: 0;
    width: 75%;
    height: 85%;
    object-fit: cover;
    border-radius: 4px;
    z-index: 1;
    box-shadow: -10px 20px 40px rgba(0,0,0,0.05);
  }

  .hp26-bundle__img-secondary {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 50%;
    height: 60%;
    object-fit: cover;
    border-radius: 4px;
    z-index: 2;
    border: 10px solid var(--bg-color);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp26-bundle-wrapper" id="HP26Bundle-{{ section.id }}">
  
  <div class="hp26-bundle__content">
    {%- if section.settings.subtitle != blank -%}
      <div class="hp26-bundle__subtitle">{{ section.settings.subtitle }}</div>
    {%- endif -%}

    {%- if section.settings.title != blank -%}
      <h2 class="hp26-bundle__title">{{ section.settings.title }}</h2>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="hp26-bundle__text">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="hp26-bundle__list">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.btn_text != blank -%}
      <a href="{{ section.settings.btn_link | default: '#' }}" class="hp26-bundle__btn">
        {{ section.settings.btn_text }}
      </a>
    {%- endif -%}
  </div>

  <div class="hp26-bundle__images">
    {%- if section.settings.image_1 != blank -%}
      <img src="{{ section.settings.image_1 | image_url: width: 800 }}" alt="Bundle Main" class="hp26-bundle__img-main" loading="lazy">
    {%- else -%}
      <div class="hp26-bundle__img-main" style="background:#EAE6DF;display:flex;align-items:center;justify-content:center;color:#2C2A28;">MAIN IMAGE</div>
    {%- endif -%}

    {%- if section.settings.image_2 != blank -%}
      <img src="{{ section.settings.image_2 | image_url: width: 600 }}" alt="Bundle Detail" class="hp26-bundle__img-secondary" loading="lazy">
    {%- else -%}
      <div class="hp26-bundle__img-secondary" style="background:var(--accent-color);display:flex;align-items:center;justify-content:center;color:#fff;">DETAIL IMAGE</div>
    {%- endif -%}
  </div>

</div>

{% schema %}
{
  "name": "HP26 - Japandi Bundle",
  "class": "section-hp26-bundle",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "CURATED SETS"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "The <em>Sanctuary</em> Bundle."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Create a space of tranquility with our carefully paired essentials. Designed to complement each other and your lifestyle.</p>"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "SHOP THE BUNDLE"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Main Image"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Overlapping Secondary Image"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1400
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 32,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 56
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Text Size",
      "default": 16
    },
    {
      "type": "header",
      "content": "Japandi Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#F5F2EB"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2C2A28"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#8B9582"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 100
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Bundle Item",
      "limit": 5,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Item Name",
          "default": "Minimalist Ceramic Vase"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP26 - Japandi Bundle",
      "blocks": [
        { "type": "item", "settings": { "text": "Hand-poured Botanical Candle" } },
        { "type": "item", "settings": { "text": "Wabi-sabi Ceramic Vase" } },
        { "type": "item", "settings": { "text": "Organic Cotton Throw" } }
      ]
    }
  ]
}
{% endschema %}
