{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#FAF5EF' }};
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
  }

  .hp53-video__container {
    max-width: {{ section.settings.container_width | default: 1280 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp53-video__header {
    text-align: center;
    margin-bottom: 40px;
  }

  .hp53-video__eyebrow {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: {{ section.settings.accent_color | default: '#C2703E' }};
    margin: 0 0 12px;
  }

  .hp53-video__heading {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(28px, 3.5vw, 42px);
    font-weight: 700;
    color: {{ section.settings.title_color | default: '#5C3D2E' }};
    margin: 0;
  }

  .hp53-video__frame {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    aspect-ratio: 16/9;
    background: #E8D5C0;
    border: 2px solid {{ section.settings.border_color | default: '#E8D5C0' }};
  }

  .hp53-video__frame video,
  .hp53-video__frame iframe {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hp53-video__play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 72px;
    height: 72px;
    background: rgba(92, 61, 46, 0.85);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #FAF5EF;
    font-size: 24px;
    cursor: pointer;
    transition: transform 0.3s ease;
    border: 2px solid #E8D5C0;
  }

  .hp53-video__play:hover {
    transform: translate(-50%, -50%) scale(1.1);
  }
{%- endstyle -%}

<div class="hp53-video__container">
  <div class="hp53-video__header">
    {%- if section.settings.eyebrow != blank -%}
      <p class="hp53-video__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h2 class="hp53-video__heading">{{ section.settings.heading | default: 'The Desert Ritual' }}</h2>
  </div>

  <div class="hp53-video__frame">
    {%- if section.settings.video_url != blank -%}
      <iframe src="{{ section.settings.video_url }}" frameborder="0" allow="autoplay; encrypted-media" allowfullscreen loading="lazy"></iframe>
    {%- elsif section.settings.cover_image != blank -%}
      <img height="{{ section.settings.cover_image.height }}" width="{{ section.settings.cover_image.width }}" src="{{ section.settings.cover_image | image_url: width: 1280 }}" alt="{{ section.settings.heading }}" style="width:100%;height:100%;object-fit:cover;">
      <div class="hp53-video__play">▶</div>
    {%- else -%}
      <span style="width:100%;height:100%;object-fit:cover;">{{ 'lifestyle-2' | placeholder_svg_tag }}</span>
      <div class="hp53-video__play">▶</div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP53 - Dune Video",
  "class": "section-hp53-video",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FAF5EF" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#C2703E" },
    { "type": "color", "id": "title_color", "label": "Title Color", "default": "#5C3D2E" },
    { "type": "color", "id": "border_color", "label": "Border", "default": "#E8D5C0" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "◈ WATCH" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Desert Ritual" },
    { "type": "text", "id": "video_url", "label": "Video URL (YouTube/Vimeo embed)" },
    { "type": "image_picker", "id": "cover_image", "label": "Cover Image" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 80 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "presets": [{ "name": "HP53 - Dune Video" }]
}
{% endschema %}
