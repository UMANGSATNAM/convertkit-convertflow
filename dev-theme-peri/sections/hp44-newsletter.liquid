{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp44-news-bg: {{ section.settings.bg_color | default: '#EDF4EE' }};
    --hp44-news-card: {{ section.settings.card_bg | default: '#FFFFFF' }};
    --hp44-news-border: {{ section.settings.card_border | default: '#D8E8DC' }};
    --hp44-news-title: {{ section.settings.title_color | default: '#143D2B' }};
    --hp44-news-desc: {{ section.settings.desc_color | default: '#406352' }};
    --hp44-news-btn: {{ section.settings.btn_bg | default: '#143D2B' }};
    
    background-color: var(--hp44-news-bg);
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
  }

  .hp44-news__box {
    max-width: {{ section.settings.container_width | default: 720 }}px;
    margin: 0 auto;
    padding: 50px 36px;
    background: var(--hp44-news-card);
    border: 1px solid var(--hp44-news-border);
    border-radius: 28px;
    text-align: center;
    box-shadow: 0 15px 40px rgba(20, 61, 43, 0.06);
  }

  .hp44-news__title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(28px, 4vw, 38px);
    font-weight: 700;
    color: var(--hp44-news-title);
    margin: 0 0 12px;
  }

  .hp44-news__desc {
    font-size: 15px;
    line-height: 1.7;
    color: var(--hp44-news-desc);
    margin: 0 0 32px;
  }

  .hp44-news__form {
    display: flex;
    gap: 12px;
    max-width: 500px;
    margin: 0 auto;
  }

  .hp44-news__input {
    flex: 1;
    padding: 15px 22px;
    border: 1.5px solid var(--hp44-news-border);
    border-radius: 50px;
    font-size: 14px;
    outline: none;
    font-family: 'Outfit', sans-serif;
  }

  .hp44-news__input:focus {
    border-color: #2D6A4F;
  }

  .hp44-news__btn {
    padding: 15px 32px;
    background: var(--hp44-news-btn);
    color: #FFFFFF;
    border: none;
    border-radius: 50px;
    font-family: 'Outfit', sans-serif;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .hp44-news__btn:hover {
    background: #2D6A4F;
  }

  @media screen and (max-width: 600px) {
    .hp44-news__box { padding: 36px 20px; }
    .hp44-news__form { flex-direction: column; }
  }
{%- endstyle -%}

<div class="hp44-news__box">
  <h2 class="hp44-news__title">{{ section.settings.heading | default: 'Join The Herbarium Circle' }}</h2>
  <p class="hp44-news__desc">{{ section.settings.description | default: 'Subscribe to receive seasonal Nordic harvest release dates and an instant 15% privilege voucher for your first order.' }}</p>
  <form class="hp44-news__form" onsubmit="event.preventDefault(); alert('Subscribed to Herbarium Circle!');">
    <input type="email" class="hp44-news__input" placeholder="{{ section.settings.placeholder | default: 'Enter your email address' }}" required>
    <button type="submit" class="hp44-news__btn">{{ section.settings.btn_text | default: 'Subscribe' }}</button>
  </form>
</div>

{% schema %}
{
  "name": "HP44 - Sage News",
  "class": "section-hp44-news",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#EDF4EE" },
    { "type": "color", "id": "card_bg", "label": "Card Background", "default": "#FFFFFF" },
    { "type": "color", "id": "card_border", "label": "Card Border", "default": "#D8E8DC" },
    { "type": "color", "id": "title_color", "label": "Title Color", "default": "#143D2B" },
    { "type": "color", "id": "desc_color", "label": "Description Color", "default": "#406352" },
    { "type": "color", "id": "btn_bg", "label": "Button Background", "default": "#143D2B" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join The Herbarium Circle" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Subscribe to receive seasonal Nordic harvest release dates and an instant 15% privilege voucher." },
    { "type": "text", "id": "placeholder", "label": "Input Placeholder", "default": "Enter your email address" },
    { "type": "text", "id": "btn_text", "label": "Button Text", "default": "Subscribe" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 80 },
    { "type": "range", "id": "container_width", "min": 500, "max": 1000, "step": 20, "unit": "px", "label": "Container Width", "default": 720 }
  ],
  "presets": [
    { "name": "HP44 - Sage News" }
  ]
}
{% endschema %}
