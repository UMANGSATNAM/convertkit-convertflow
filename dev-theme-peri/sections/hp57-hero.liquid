{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,600;0,700;1,400;1,600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');

  #shopify-section-{{ section.id }} {
    --hp57-bg: {{ section.settings.bg_color | default: '#0F291E' }};
    --hp57-text: {{ section.settings.text_color | default: '#F4F6F0' }};
    --hp57-sage: {{ section.settings.accent_sage | default: '#A7F3D0' }};
    --hp57-gold: {{ section.settings.accent_gold | default: '#D97706' }};
    --hp57-btn-bg: {{ section.settings.btn_bg | default: '#D97706' }};
    --hp57-btn-text: {{ section.settings.btn_text_color | default: '#0F291E' }};

    background: radial-gradient(circle at 75% 25%, #1B4332 0%, var(--hp57-bg) 75%);
    color: var(--hp57-text);
    font-family: 'Plus Jakarta Sans', sans-serif;
    padding-top: {{ section.settings.padding_top | default: 100 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 100 }}px;
    position: relative;
    overflow: hidden;
  }

  .hp57-hero__botanical-glow {
    position: absolute;
    top: -100px;
    left: -100px;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(167, 243, 208, 0.12) 0%, transparent 70%);
    pointer-events: none;
  }

  .hp57-hero__container {
    max-width: {{ section.settings.container_width | default: 1280 }}px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 70px;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  .hp57-hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 18px;
    background: rgba(167, 243, 208, 0.1);
    border: 1px solid rgba(167, 243, 208, 0.3);
    border-radius: 6px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--hp57-sage);
    margin-bottom: 26px;
  }

  .hp57-hero__title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(40px, 5.5vw, 68px);
    font-weight: 700;
    line-height: 1.08;
    color: #FFFFFF;
    margin: 0 0 24px;
  }

  .hp57-hero__title em {
    font-style: italic;
    font-weight: 400;
    color: #A7F3D0;
  }

  .hp57-hero__desc {
    font-size: 16px;
    line-height: 1.75;
    color: #CBD5E1;
    margin: 0 0 36px;
    max-width: 520px;
  }

  .hp57-hero__actions {
    display: flex;
    gap: 16px;
    align-items: center;
    flex-wrap: wrap;
  }

  .hp57-hero__btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 36px;
    background: var(--hp57-btn-bg);
    color: var(--hp57-btn-text);
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 6px;
    transition: all 0.35s ease;
    box-shadow: 0 8px 30px rgba(217, 119, 6, 0.3);
  }

  .hp57-hero__btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 40px rgba(217, 119, 6, 0.5);
  }

  .hp57-hero__media {
    position: relative;
  }

  .hp57-hero__img-wrap {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    height: 520px;
    border: 1px solid rgba(167, 243, 208, 0.25);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.6);
  }

  .hp57-hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: contrast(1.05);
    transition: transform 0.6s ease;
  }

  .hp57-hero__img-wrap:hover .hp57-hero__img {
    transform: scale(1.04);
  }

  .hp57-hero__float-card {
    position: absolute;
    bottom: -16px;
    left: -16px;
    background: rgba(15, 41, 30, 0.92);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(167, 243, 208, 0.3);
    border-radius: 10px;
    padding: 16px 22px;
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .hp57-hero__float-icon {
    width: 42px;
    height: 42px;
    background: linear-gradient(135deg, #1B4332, #2D5A43);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #A7F3D0;
    font-size: 18px;
    border: 1px solid rgba(167, 243, 208, 0.3);
  }

  .hp57-hero__float-label {
    font-family: 'Cormorant Garamond', serif;
    font-size: 17px;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0;
  }

  .hp57-hero__float-sub {
    font-size: 11px;
    color: #A7F3D0;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin: 2px 0 0;
  }

  @media screen and (max-width: 992px) {
    .hp57-hero__container { grid-template-columns: 1fr; text-align: center; gap: 40px; }
    .hp57-hero__desc { margin-left: auto; margin-right: auto; }
    .hp57-hero__actions { justify-content: center; }
    .hp57-hero__img-wrap { height: 380px; }
    .hp57-hero__float-card { left: 50%; transform: translateX(-50%); bottom: -16px; }
  }

  @media screen and (max-width: 480px) {
    .hp57-hero__img-wrap { height: 300px; }
  }
{%- endstyle -%}

<div class="hp57-hero__botanical-glow"></div>

<div class="hp57-hero__container">
  <div>
    <div class="hp57-hero__badge">
      <span>🌿</span>
      <span>{{ section.settings.badge | default: 'BOTANICAL APOTHECARY v57' }}</span>
    </div>

    <h1 class="hp57-hero__title">
      {{ section.settings.heading | default: 'Forest Fern & <em>Ochre Herbal</em> Alchemy' }}
    </h1>

    <p class="hp57-hero__desc">
      {{ section.settings.description | default: 'Ancient greenhouse botanical extracts, cold-macerated forest fern lipids, and wild golden calendula for pure therapeutic barrier restoration.' }}
    </p>

    <div class="hp57-hero__actions">
      <a href="{{ section.settings.btn_url | default: '/collections/all' }}" class="hp57-hero__btn">
        <span>{{ section.settings.btn_text | default: 'Explore Herbarium' }}</span>
        <span>&rarr;</span>
      </a>
    </div>
  </div>

  <div class="hp57-hero__media">
    <div class="hp57-hero__img-wrap">
      {%- if section.settings.image != blank -%}
        <img height="{{ section.settings.image.height }}" width="{{ section.settings.image.width }}" src="{{ section.settings.image | image_url: width: 1000 }}" class="hp57-hero__img" alt="{{ section.settings.heading }}" loading="eager">
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'hp57-hero__img' }}
      {%- endif -%}

      <div class="hp57-hero__float-card">
        <div class="hp57-hero__float-icon">🌿</div>
        <div>
          <p class="hp57-hero__float-label">Wild Fern Bio-Lipid</p>
          <p class="hp57-hero__float-sub">Cold-Macerated Extract</p>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "HP57 Hero",
  "class": "section-hp57-hero",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#0F291E" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#F4F6F0" },
    { "type": "color", "id": "accent_sage", "label": "Sage Accent", "default": "#A7F3D0" },
    { "type": "color", "id": "accent_gold", "label": "Gold Accent", "default": "#D97706" },
    { "type": "color", "id": "btn_bg", "label": "Button Background", "default": "#D97706" },
    { "type": "color", "id": "btn_text_color", "label": "Button Text Color", "default": "#0F291E" },
    { "type": "text", "id": "badge", "label": "Badge", "default": "BOTANICAL APOTHECARY v57" },
    { "type": "textarea", "id": "heading", "label": "Heading (HTML allowed)", "default": "Forest Fern & <em>Ochre Herbal</em> Alchemy" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Ancient greenhouse botanical extracts and cold-macerated forest fern lipids." },
    { "type": "text", "id": "btn_text", "label": "Button Text", "default": "Explore Herbarium" },
    { "type": "url", "id": "btn_url", "label": "Button URL" },
    { "type": "image_picker", "id": "image", "label": "Hero Image" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 100 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 100 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "presets": [{ "name": "HP57 Hero" }]
}
{% endschema %}
