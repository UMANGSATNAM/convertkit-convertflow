{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp51-comp-bg: {{ section.settings.bg_color | default: '#F2EFE9' }};
    --hp51-matcha: {{ section.settings.accent_matcha | default: '#2D5A3D' }};
    
    background-color: var(--hp51-comp-bg);
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }

  .hp51-comp__wrap {
    max-width: {{ section.settings.container_width | default: 980 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp51-comp__header {
    text-align: center;
    margin-bottom: 45px;
  }

  .hp51-comp__heading {
    font-family: 'Noto Serif JP', serif;
    font-size: clamp(32px, 4.5vw, 44px);
    font-weight: 700;
    color: #1E3A2B;
    margin: 0 0 8px;
  }

  .hp51-comp__card {
    background: #FAF8F5;
    border: 1px solid rgba(30, 58, 43, 0.12);
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 15px 40px rgba(30, 58, 43, 0.05);
  }

  .hp51-comp__table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }

  .hp51-comp__table th, .hp51-comp__table td {
    padding: 18px 24px;
    text-align: center;
    border-bottom: 1px solid rgba(30, 58, 43, 0.08);
  }

  .hp51-comp__table th {
    font-family: 'DM Sans', sans-serif;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    background: #E3DDD3;
    color: #1E3A2B;
  }

  .hp51-comp__highlight {
    background: rgba(45, 90, 61, 0.08);
    font-weight: 700;
    color: #1E3A2B !important;
  }

  @media screen and (max-width: 600px) {
    .hp51-comp__table th, .hp51-comp__table td { padding: 12px 10px; font-size: 12px; }
  }
{%- endstyle -%}

<div class="hp51-comp__wrap">
  <div class="hp51-comp__header">
    <h2 class="hp51-comp__heading">The Purity Matrix</h2>
    <p style="font-size:14px; color:#4A5B50;">{{ section.settings.subheading | default: 'Our shade-grown Uji ceremonial matcha vs standard commercial tea extracts.' }}</p>
  </div>

  <div class="hp51-comp__card">
    <table class="hp51-comp__table">
      <thead>
        <tr>
          <th style="text-align:left;">Botanical Quality</th>
          <th class="hp51-comp__highlight">Peri Kyoto v51</th>
          <th>Standard Green Tea</th>
        </tr>
      </thead>
      <tbody>
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <td style="text-align:left; font-weight:700;">{{ block.settings.feature }}</td>
              <td class="hp51-comp__highlight">{{ block.settings.brand_val }}</td>
              <td>{{ block.settings.other_val }}</td>
            </tr>
          {%- endfor -%}
        {%- else -%}
          <tr>
            <td style="text-align:left; font-weight:700;">Harvest Region</td>
            <td class="hp51-comp__highlight">Uji, Kyoto (First Spring Flush)</td>
            <td>Industrial Mass Plantations</td>
          </tr>
          <tr>
            <td style="text-align:left; font-weight:700;">Antioxidant EGCG Level</td>
            <td class="hp51-comp__highlight">137x Higher Bio-Availability</td>
            <td>Heated &amp; Degraded Polyphenols</td>
          </tr>
          <tr>
            <td style="text-align:left; font-weight:700;">Base Hydration</td>
            <td class="hp51-comp__highlight">100% Organic Bamboo Sap Water</td>
            <td>Plain Purified Tap Water Base</td>
          </tr>
          <tr>
            <td style="text-align:left; font-weight:700;">Preservation Method</td>
            <td class="hp51-comp__highlight">Cold Vacuum Stone-Milling</td>
            <td>Chemical Solvents &amp; Alcohols</td>
          </tr>
        {%- endif -%}
      </tbody>
    </table>
  </div>
</div>

{% schema %}
{
  "name": "HP51 - Zen Matrix",
  "class": "section-hp51-matrix",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#F2EFE9" },
    { "type": "color", "id": "accent_matcha", "label": "Matcha Accent", "default": "#2D5A3D" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 700, "max": 1200, "step": 20, "unit": "px", "label": "Container Width", "default": 980 }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Matrix Row",
      "settings": [
        { "type": "text", "id": "feature", "label": "Feature", "default": "Harvest Region" },
        { "type": "text", "id": "brand_val", "label": "Our Value", "default": "Uji, Kyoto" },
        { "type": "text", "id": "other_val", "label": "Commercial Value", "default": "Industrial Plantations" }
      ]
    }
  ],
  "presets": [
    { "name": "HP51 - Zen Matrix" }
  ]
}
{% endschema %}
