{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp52-ugc-bg: {{ section.settings.bg_color | default: '#F7EFE6' }};
    --hp52-terra: {{ section.settings.accent_terra | default: '#C2593F' }};
    
    background-color: var(--hp52-ugc-bg);
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
  }

  .hp52-ugc__wrap {
    max-width: {{ section.settings.container_width | default: 1240 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp52-ugc__header {
    text-align: center;
    margin-bottom: 40px;
  }

  .hp52-ugc__heading {
    font-family: 'Bodoni Moda', serif;
    font-size: clamp(30px, 4vw, 42px);
    font-weight: 700;
    color: #2D3B2D;
    margin: 0;
  }

  .hp52-ugc__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: 4 }}, 1fr);
    gap: 18px;
  }

  .hp52-ugc__card {
    aspect-ratio: 9/16;
    border-radius: 40px 40px 12px 12px;
    overflow: hidden;
    position: relative;
    box-shadow: 0 10px 30px rgba(45, 59, 45, 0.08);
  }

  .hp52-ugc__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .hp52-ugc__card:hover .hp52-ugc__img { transform: scale(1.05); }

  .hp52-ugc__overlay {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    padding: 18px;
    background: linear-gradient(to top, rgba(45, 59, 45, 0.9), transparent);
    color: #FFFDF9;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
  }

  .hp52-ugc__handle {
    font-family: 'Jost', sans-serif;
    font-weight: 700;
    font-size: 12px;
    margin: 0 0 2px;
  }

  .hp52-ugc__tag {
    font-size: 11px;
    opacity: 0.85;
    margin: 0;
  }

  @media screen and (max-width: 992px) {
    .hp52-ugc__grid { grid-template-columns: repeat(2, 1fr); }
  }
{%- endstyle -%}

<div class="hp52-ugc__wrap">
  <div class="hp52-ugc__header">
    <h2 class="hp52-ugc__heading">{{ section.settings.heading | default: 'Sun-Drenched Moments #TuscanGlow' }}</h2>
  </div>

  <div class="hp52-ugc__grid">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <div class="hp52-ugc__card" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 600 }}" class="hp52-ugc__img" alt="{{ block.settings.handle }}" loading="lazy">
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'hp52-ugc__img' }}
          {%- endif -%}
          <div class="hp52-ugc__overlay">
            <div>
              <p class="hp52-ugc__handle">{{ block.settings.handle | default: '@tuscany_glow' }}</p>
              <p class="hp52-ugc__tag">{{ block.settings.tag | default: '#OliveNectar' }}</p>
            </div>
            <span>▶</span>
          </div>
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="hp52-ugc__card">
        {{ 'lifestyle-2' | placeholder_svg_tag: 'hp52-ugc__img' }}
        <div class="hp52-ugc__overlay">
          <div><p class="hp52-ugc__handle">@florence_sun</p><p class="hp52-ugc__tag">#OliveNectar</p></div>
          <span>▶</span>
        </div>
      </div>
      <div class="hp52-ugc__card">
        {{ 'lifestyle-2' | placeholder_svg_tag: 'hp52-ugc__img' }}
        <div class="hp52-ugc__overlay">
          <div><p class="hp52-ugc__handle">@sicily_terracotta</p><p class="hp52-ugc__tag">#ClayMask</p></div>
          <span>▶</span>
        </div>
      </div>
      <div class="hp52-ugc__card">
        {{ 'lifestyle-2' | placeholder_svg_tag: 'hp52-ugc__img' }}
        <div class="hp52-ugc__overlay">
          <div><p class="hp52-ugc__handle">@amalfi_coast_skin</p><p class="hp52-ugc__tag">#HoneyCreme</p></div>
          <span>▶</span>
        </div>
      </div>
      <div class="hp52-ugc__card">
        {{ 'lifestyle-2' | placeholder_svg_tag: 'hp52-ugc__img' }}
        <div class="hp52-ugc__overlay">
          <div><p class="hp52-ugc__handle">@mediterranean_rituals</p><p class="hp52-ugc__tag">#SunBalm</p></div>
          <span>▶</span>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP52 - Terra UGC",
  "class": "section-hp52-ugc",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#F7EFE6" },
    { "type": "color", "id": "accent_terra", "label": "Terracotta Accent", "default": "#C2593F" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Sun-Drenched Moments #TuscanGlow" },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "label": "Desktop Columns", "default": 4 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 80 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1240 }
  ],
  "blocks": [
    {
      "type": "reel",
      "name": "Reel Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "handle", "label": "Handle", "default": "@tuscany_glow" },
        { "type": "text", "id": "tag", "label": "Tag", "default": "#OliveNectar" }
      ]
    }
  ],
  "presets": [
    { "name": "HP52 - Terra UGC" }
  ]
}
{% endschema %}
