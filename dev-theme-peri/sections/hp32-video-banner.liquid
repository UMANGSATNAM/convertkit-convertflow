{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=Syne:wght@700;800&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --border-color: #000000;
    --accent-color: {{ section.settings.accent_color }};
    
    --font-heading: 'Syne', sans-serif;
    --font-body: 'Space Mono', monospace;
    
    background-color: var(--bg-color);
    border-bottom: 4px solid var(--border-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .hp32-video-wrapper {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp32-video-wrapper {
      padding: 0 20px;
    }
  }

  .hp32-video__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 40px;
  }

  @media screen and (max-width: 768px) {
    .hp32-video__header {
      flex-direction: column;
      align-items: flex-start;
      gap: 15px;
    }
  }

  .hp32-video__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    line-height: 1;
    color: #000;
    text-transform: uppercase;
    margin: 0;
    letter-spacing: -1px;
  }

  .hp32-video__container {
    position: relative;
    width: 100%;
    aspect-ratio: 16/9;
    border: 4px solid var(--border-color);
    background: #fff;
    box-shadow: 16px 16px 0 var(--border-color);
    overflow: hidden;
  }

  @media screen and (max-width: 768px) {
    .hp32-video__container {
      aspect-ratio: 4/3;
      box-shadow: 8px 8px 0 var(--border-color);
    }
  }

  .hp32-video__media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%) contrast(150%);
  }

  .hp32-video__overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(204, 255, 0, 0.2); /* Accent tint */
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.3s ease;
  }

  .hp32-video__container:hover .hp32-video__overlay {
    background: rgba(0, 0, 0, 0.4);
  }

  .hp32-video__play-btn {
    background: var(--accent-color);
    color: #000;
    border: 4px solid var(--border-color);
    padding: 20px 40px;
    font-family: var(--font-body);
    font-size: 24px;
    font-weight: 700;
    text-transform: uppercase;
    box-shadow: 8px 8px 0 var(--border-color);
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 15px;
    transition: transform 0.1s ease, box-shadow 0.1s ease;
  }

  .hp32-video__play-btn:hover {
    transform: translate(4px, 4px);
    box-shadow: 4px 4px 0 var(--border-color);
  }

  .hp32-video__play-icon {
    width: 0;
    height: 0;
    border-top: 10px solid transparent;
    border-bottom: 10px solid transparent;
    border-left: 16px solid #000;
  }

  /* Glitch effect on hover */
  .hp32-video__container:hover .hp32-video__play-btn {
    animation: hp32-glitch 0.2s linear infinite;
  }

  @keyframes hp32-glitch {
    0% { transform: translate(4px, 4px) skew(0deg); }
    20% { transform: translate(6px, 2px) skew(-10deg); }
    40% { transform: translate(2px, 6px) skew(10deg); }
    60% { transform: translate(6px, 6px) skew(-5deg); }
    80% { transform: translate(4px, 2px) skew(5deg); }
    100% { transform: translate(4px, 4px) skew(0deg); }
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp32-video-wrapper" id="HP32Video-{{ section.id }}">
  <div class="hp32-video__header">
    <h2 class="hp32-video__title">{{ section.settings.title }}</h2>
  </div>

  <div class="hp32-video__container">
    {%- if section.settings.video_url != blank -%}
      {%- if section.settings.video_url.type == 'youtube' -%}
        <iframe class="hp32-video__media" src="https://www.youtube.com/embed/{{ section.settings.video_url.id }}?autoplay=0&controls=0&mute=1&loop=1&playlist={{ section.settings.video_url.id }}" frameborder="0" allow="autoplay; encrypted-media" allowfullscreen></iframe>
      {%- elsif section.settings.video_url.type == 'vimeo' -%}
        <iframe class="hp32-video__media" src="https://player.vimeo.com/video/{{ section.settings.video_url.id }}?background=1" frameborder="0" allow="autoplay; fullscreen" allowfullscreen></iframe>
      {%- endif -%}
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'hp32-video__media' }}
    {%- endif -%}

    <div class="hp32-video__overlay">
      <button class="hp32-video__play-btn" aria-label="Play Video">
        <div class="hp32-video__play-icon"></div>
        <span>PLAY_FEED</span>
      </button>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "HP32 - Brutalist Video",
  "class": "section-hp32-video-banner",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "SYSTEM_FEED_v01"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "accept": ["youtube", "vimeo"],
      "label": "Video URL"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 48
    },
    {
      "type": "header",
      "content": "Brutalist Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#f4f4f4"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color (e.g. Lime)",
      "default": "#ccff00"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP32 - Brutalist Video"
    }
  ]
}
{% endschema %}
