{% comment %} CL V2 — Bold Streetwear {% endcomment %}
{{ 'component-facets.css' | asset_url | stylesheet_tag }}
<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
<style>
  .clv2 { background: {{ section.settings.bg_color | default: '#000000' }}; color: {{ section.settings.text_color | default: '#FFFFFF' }}; padding: 60px 20px; font-family: 'Helvetica Neue', sans-serif; }
  .clv2-hero { text-align: left; margin-bottom: 50px; }
  .clv2-hero h1 { font-size: 48px; font-weight: 900; text-transform: uppercase; margin-bottom: 10px; letter-spacing: -1px; }
  .clv2-hero p { font-size: 16px; color: #AAA; max-width: 500px; line-height: 1.5; }
  .clv2-chips { display: flex; gap: 12px; margin-bottom: 40px; overflow-x: auto; }
  .clv2-chips a { padding: 10px 20px; background: #222; text-decoration: none; color: #FFF; font-size: 14px; font-weight: bold; text-transform: uppercase; transition: 0.3s; }
  .clv2-chips a:hover { background: #FFF; color: #000; }
  .clv2-toolbar { background: #111; padding: 20px; margin-bottom: 40px; }
  .clv2-grid { display: grid; grid-template-columns: repeat({{ section.settings.cols_desktop | default: 3 }}, 1fr); gap: 30px; }
  .clv2-promo { grid-column: span 1; background: #FF3366; color: #FFF; padding: 40px; display: flex; flex-direction: column; justify-content: center; }
  .clv2-promo h3 { font-size: 32px; font-weight: 900; text-transform: uppercase; margin-bottom: 15px; line-height: 1.1; }
  .clv2-promo a { display: inline-block; padding: 12px 24px; background: #000; color: #FFF; text-decoration: none; font-weight: bold; text-transform: uppercase; align-self: flex-start; }
  .clv2-seo { margin-top: 60px; padding: 40px; border-top: 2px solid #222; }
  @media (max-width: 768px) { .clv2-grid { grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr); gap: 15px; } .clv2-hero h1 { font-size: 32px; } }
</style>
<div class="clv2" style="max-width: 1400px; margin: 0 auto;">
  <div class="clv2-hero">
    <h1>{% if collection.title != blank %}{{ collection.title | escape }}{% else %}Urban Drops{% endif %}</h1>
    <p>{% if collection.description != blank %}{{ collection.description }}{% else %}Latest streetwear essentials. Authentic and raw.{% endif %}</p>
  </div>
  {% if section.settings.sub_collections != blank %}
    <div class="clv2-chips">
      {% for link in section.settings.sub_collections.links %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% endfor %}
    </div>
  {% endif %}
  <div class="clv2-toolbar">
    <facet-filters-form>
      <form id="FacetFiltersForm" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 20px;">
        <div style="display: flex; gap: 20px;">
          {%- for filter in collection.filters -%}
            <details style="position: relative;">
              <summary style="cursor: pointer; font-size: 14px; font-weight: bold; text-transform: uppercase;">{{ filter.label }} [ + ]</summary>
              <div style="position: absolute; background: #111; border: 1px solid #333; padding: 20px; z-index: 10; margin-top: 15px; min-width: 220px;">
                {%- for value in filter.values -%}
                  <label style="display: block; margin-bottom: 10px; cursor: pointer; font-size: 14px; color: #CCC;">
                    <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %}>
                    {{ value.label }} ({{ value.count }})
                  </label>
                {%- endfor -%}
              </div>
            </details>
          {%- endfor -%}
        </div>
        <select name="sort_by" onchange="this.form.submit()" style="background: transparent; color: #FFF; border: 1px solid #333; padding: 10px; font-weight: bold; text-transform: uppercase; cursor: pointer;">
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>
          {%- endfor -%}
        </select>
      </form>
    </facet-filters-form>
  </div>
  {% assign limit_num = section.settings.products_per_page | default: 12 %}
  {% paginate collection.products by limit_num %}
    <div class="clv2-grid">
      {% for product in collection.products %}
        {% render 'card-v2', product: product %}
        {% if forloop.index == 8 and section.settings.show_promo_tile %}
          <div class="clv2-promo">
            <h3>Exclusive<br>Access</h3>
            <a href="/pages/vip">Join Now</a>
          </div>
        {% endif %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v2', product: nil %}
        {% endfor %}
      {% endfor %}
    </div>
    <div style="margin-top: 50px; text-align: center;">{{ paginate | default_pagination }}</div>
  {% endpaginate %}
  {% if section.settings.show_seo_block %}
    <div class="clv2-seo">
      <h2 style="font-size: 24px; font-weight: 900; text-transform: uppercase; margin-bottom: 15px;">{{ section.settings.seo_title | default: 'The Movement' }}</h2>
      <p style="color: #888; line-height: 1.6; font-size: 14px;">{{ section.settings.seo_text | default: 'Redefining street culture with bold designs and premium fits.' }}</p>
    </div>
  {% endif %}
</div>
{% schema %}
{
  "name": "CL V2 — Streetwear", "settings": [
    {"type": "range", "id": "products_per_page", "label": "Products per page", "min": 6, "max": 48, "step": 3, "default": 12},
    {"type": "range", "id": "cols_desktop", "label": "Desktop Columns", "min": 2, "max": 4, "default": 3},
    {"type": "select", "id": "cols_mobile", "label": "Mobile Columns", "options": [{"value": "1", "label": "1"}, {"value": "2", "label": "2"}], "default": "2"},
    {"type": "link_list", "id": "sub_collections", "label": "Sub-Collection Menu"},
    {"type": "checkbox", "id": "show_promo_tile", "label": "Show Promo Card", "default": true},
    {"type": "checkbox", "id": "show_seo_block", "label": "Show SEO Block", "default": true},
    {"type": "color", "id": "bg_color", "label": "Background Color", "default": "#000000"},
    {"type": "color", "id": "text_color", "label": "Text Color", "default": "#FFFFFF"}
  ], "presets": [{"name": "CL V2 — Streetwear"}]
}
{% endschema %}
