{%- liquid
  assign section_id = section.id
-%}

<style>
  #shopify-section-{{ section_id }} {
    padding: 20px;
    background-color: #FFFFFF;
  }
  
  .hp10-ib-container-{{ section_id }} {
    max-width: 1400px;
    margin: 0 auto;
    position: relative;
    border-radius: 40px;
    overflow: hidden;
    height: 60vh;
    min-height: 400px;
  }
  
  .hp10-ib-bg-{{ section_id }} {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover;
  }
  
  .hp10-ib-overlay-{{ section_id }} {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(42, 59, 44, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }
  
  .hp10-ib-heading-{{ section_id }} {
    color: #F9F6F0;
    font-family: 'Lora', serif;
    font-size: clamp(3rem, 6vw, 5rem);
    font-weight: 400;
    margin: 0;
  }
</style>

<div class="hp10-ib-container-{{ section_id }}">
  {% if section.settings.image != blank %}
    <img height="{{ section.settings.image.height }}" width="{{ section.settings.image.width }}" src="{{ section.settings.image | image_url: width: 2000 }}" class="hp10-ib-bg-{{ section_id }}" alt="Banner Image">
  {% else %}
    <div class="hp10-ib-bg-{{ section_id }}" style="background: #8A9A86;"></div>
  {% endif %}
  
  <div class="hp10-ib-overlay-{{ section_id }}">
    <h2 class="hp10-ib-heading-{{ section_id }}">{{ section.settings.heading | default: 'Pure & Simple' }}</h2>
  </div>
</div>

{% schema %}
{
  "name": "HP10 Image Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pure & Simple"
    }
  ],
  "presets": [
    {
      "name": "HP10 Image Banner"
    }
  ]
}
{% endschema %}
