{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#f4f1de'
  assign text_color = section.settings.text_color | default: '#6b705c'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 100px 40px;
  }
  
  .hp14-fp-container-{{ section_id }} {
    max-width: 1400px;
    margin: 0 auto;
  }
  
  .hp14-fp-header-{{ section_id }} {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 50px;
  }
  
  .hp14-fp-heading-{{ section_id }} {
    font-family: 'Georgia', serif;
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: normal;
    color: {{ text_color }};
    margin: 0;
  }
  
  .hp14-fp-heading-{{ section_id }} span {
    font-style: italic;
    color: #cb997e;
  }
  
  .hp14-fp-link-{{ section_id }} {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #cb997e;
    text-decoration: none;
    border-bottom: 1px solid #cb997e;
    padding-bottom: 2px;
  }
  
  .hp14-fp-scroll-{{ section_id }} {
    display: flex;
    overflow-x: auto;
    gap: 30px;
    padding-bottom: 40px;
    -ms-overflow-style: none;
    scrollbar-width: none;
    scroll-snap-type: x mandatory;
  }
  
  .hp14-fp-scroll-{{ section_id }}::-webkit-scrollbar {
    display: none;
  }
  
  .hp14-fp-card-{{ section_id }} {
    flex: 0 0 350px;
    scroll-snap-align: start;
    text-decoration: none;
    text-align: center;
  }
  
  .hp14-fp-image-wrap-{{ section_id }} {
    position: relative;
    padding-top: 120%;
    border-radius: 100px 100px 20px 20px;
    overflow: hidden;
    margin-bottom: 20px;
    background: #ffe8d6;
  }
  
  .hp14-fp-image-{{ section_id }} {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  
  .hp14-fp-card-{{ section_id }}:hover .hp14-fp-image-{{ section_id }} {
    transform: scale(1.05);
  }
  
  .hp14-fp-title-{{ section_id }} {
    font-family: 'Georgia', serif;
    font-size: 1.2rem;
    color: {{ text_color }};
    margin: 0 0 10px 0;
  }
  
  .hp14-fp-price-{{ section_id }} {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 1rem;
    color: #a5a58d;
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 60px 20px;
    }
    .hp14-fp-header-{{ section_id }} {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }
    .hp14-fp-card-{{ section_id }} {
      flex: 0 0 280px;
    }
  }
</style>

<div class="hp14-fp-container-{{ section_id }}">
  <div class="hp14-fp-header-{{ section_id }}">
    <h2 class="hp14-fp-heading-{{ section_id }}">New <span>Arrivals</span></h2>
    {% if section.settings.show_view_all %}
      <a href="{{ collections[section.settings.collection].url | default: '#' }}" class="hp14-fp-link-{{ section_id }}">Shop All</a>
    {% endif %}
  </div>
  
  <div class="hp14-fp-scroll-{{ section_id }}">
    {% assign collection = collections[section.settings.collection] %}
    {% if collection != blank %}
      {% for product in collection.products limit: 6 %}
        <a href="{{ product.url }}" class="hp14-fp-card-{{ section_id }}">
          <div class="hp14-fp-image-wrap-{{ section_id }}">
            <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" width="600" height="600" class="hp14-fp-image-{{ section_id }}" loading="lazy">
          </div>
          <h3 class="hp14-fp-title-{{ section_id }}">{{ product.title }}</h3>
          <div class="hp14-fp-price-{{ section_id }}">{{ product.price | money }}</div>
        </a>
      {% endfor %}
    {% else %}
      {% for i in (1..6) %}
        <a href="#" class="hp14-fp-card-{{ section_id }}">
          <div class="hp14-fp-image-wrap-{{ section_id }}">
            <div class="hp14-fp-image-{{ section_id }}" style="background: #e2e2e2;"></div>
          </div>
          <h3 class="hp14-fp-title-{{ section_id }}">Botanical Item {{ i }}</h3>
          <div class="hp14-fp-price-{{ section_id }}">$32.00</div>
        </a>
      {% endfor %}
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "HP14 Featured Products",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f4f1de"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#6b705c"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show View All Link",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "HP14 Featured Products"
    }
  ]
}
{% endschema %}
