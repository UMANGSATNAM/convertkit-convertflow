{%- style -%}#shopify-section-{{ section.id }}{background:#000;color:#fff;padding:60px 24px;text-align:center;position:relative;overflow:hidden}.hp98-vid{max-width:900px;margin:0 auto;position:relative;z-index:1}.hp98-vid__play{width:64px;height:64px;border-radius:50%;background:#fff;color:#000;display:inline-flex;align-items:center;justify-content:center;font-size:22px;margin-bottom:18px;text-decoration:none}{%- endstyle -%}<div class="hp98-vid"><a href="{{ section.settings.url }}" class="hp98-vid__play">▶</a><h2 style="font-family:Syne,sans-serif;font-size:28px;font-weight:800;margin:0">{{ section.settings.heading | default: 'See electronics in Motion' }}</h2><p style="opacity:.7;margin:10px 0 0">{{ section.settings.sub | default: 'Flagship specs, honest reviews & fast delivery on gadgets that matter.' }}</p></div>{% schema %}{"name":"HP98 Video","settings":[{"type":"text","id":"heading","label":"Heading","default":"See electronics in Motion"},{"type":"text","id":"sub","label":"Sub","default":"Flagship specs, honest reviews & fast delivery on gadgets that matter."},{"type":"url","id":"url","label":"Video URL"}],"presets":[{"name":"HP98 Video"}]}{% endschema %}