{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Shrikhand&family=DM+Sans:wght@400;500;700&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    
    --font-heading: 'Shrikhand', cursive;
    --font-body: 'DM Sans', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .hp37-insta-wrapper {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
    overflow: hidden;
  }

  @media screen and (max-width: 768px) {
    .hp37-insta-wrapper {
      padding: 0 20px;
    }
  }

  .hp37-insta__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 50px;
    border-bottom: 4px solid var(--text-color);
    padding-bottom: 20px;
  }

  @media screen and (max-width: 768px) {
    .hp37-insta__header {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }
  }

  .hp37-insta__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    line-height: 1.1;
    color: var(--text-color);
    margin: 0;
  }

  .hp37-insta__handle {
    font-family: var(--font-body);
    font-size: 20px;
    font-weight: 700;
    color: var(--accent-color);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .hp37-insta__handle:hover {
    color: var(--text-color);
  }

  .hp37-insta__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 30px;
  }

  @media screen and (max-width: 992px) {
    .hp37-insta__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .hp37-insta__item {
    display: block;
    aspect-ratio: 1;
    background: #e9e9e9;
    border: 15px solid #fff; /* Polaroid white border */
    box-shadow: 6px 6px 0px var(--text-color);
    text-decoration: none;
    transition: transform 0.3s ease;
    overflow: hidden;
    position: relative;
    group: card;
  }

  .hp37-insta__item:nth-child(even) {
    transform: rotate(2deg);
  }
  .hp37-insta__item:nth-child(odd) {
    transform: rotate(-2deg);
  }

  .hp37-insta__item:hover {
    transform: scale(1.05) rotate(0deg);
    z-index: 2;
  }

  .hp37-insta__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    mix-blend-mode: multiply;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp37-insta-wrapper" id="HP37Insta-{{ section.id }}">
  <div class="hp37-insta__header">
    <h2 class="hp37-insta__title">{{ section.settings.title }}</h2>
    <a href="{{ section.settings.link | default: '#' }}" class="hp37-insta__handle">{{ section.settings.handle }}</a>
  </div>

  <div class="hp37-insta__grid">
    {%- for block in section.blocks limit: 4 -%}
      <a href="{{ block.settings.link | default: '#' }}" class="hp37-insta__item" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          <img height="{{ block.settings.image.height }}" width="{{ block.settings.image.width }}" src="{{ block.settings.image | image_url: width: 600 }}" alt="Instagram image" class="hp37-insta__image" loading="lazy">
        {%- else -%}
          {%- assign placeholder = 'product-' | append: forloop.index -%}
          {{ placeholder | placeholder_svg_tag: 'hp37-insta__image' }}
        {%- endif -%}
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "HP37 - Retro Instagram",
  "class": "section-hp37-instagram",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Join the Club"
    },
    {
      "type": "text",
      "id": "handle",
      "label": "Instagram Handle",
      "default": "@retroclub"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Instagram Link"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 40,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 64
    },
    {
      "type": "header",
      "content": "Retro Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#F4E3C5"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#4A3219"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#D96C4A"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Instagram Post",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP37 - Retro Instagram",
      "blocks": [
        { "type": "post" },
        { "type": "post" },
        { "type": "post" },
        { "type": "post" }
      ]
    }
  ]
}
{% endschema %}
