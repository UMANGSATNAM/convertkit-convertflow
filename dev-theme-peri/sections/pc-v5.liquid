{%- comment -%}
  PC V5 — SOFT PASTEL BEAUTY & WELLNESS PRODUCT GRID
  Design: Soft Cream/Blush (#FFF9F5), Terracotta/Rose Gold (#E07A5F) accents, DM Sans typography
  Card Shape: 20px Pill corners, soft peach borders, floating quick add bubble
{%- endcomment -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,400;0,500;0,700;1,400&display=swap');

  .pcv5 {
    --bg: {{ section.settings.bg_color | default: '#FFF9F5' }};
    --card-bg: {{ section.settings.card_bg | default: '#FFFFFF' }};
    --text: {{ section.settings.text_color | default: '#4A3E3D' }};
    --muted: {{ section.settings.muted_color | default: '#8C7A78' }};
    --accent: {{ section.settings.accent_color | default: '#E07A5F' }};
    --accent-hover: {{ section.settings.accent_hover | default: '#C86348' }};
    --border: {{ section.settings.border_color | default: '#F4E3D7' }};
    --badge-sale-bg: #E07A5F;
    --badge-sale-text: #FFFFFF;
    --f-main: 'DM Sans', sans-serif;
    --r-card: 20px;
    --ease: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    background-color: var(--bg);
    color: var(--text);
    font-family: var(--f-main);
    padding: {{ section.settings.padding_top | default: 56 }}px 0 {{ section.settings.padding_bottom | default: 56 }}px 0;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }

  .pcv5 *, .pcv5 *::before, .pcv5 *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .pcv5 a { color: inherit; text-decoration: none; }
  .pcv5 button { font-family: inherit; cursor: pointer; border: none; background: none; }
  .pcv5 img { max-width: 100%; display: block; }

  .pcv5__wrap { max-width: 1280px; margin: 0 auto; padding: 0 20px; }

  /* HEADER */
  .pcv5__head { display: flex; flex-direction: column; gap: 8px; margin-bottom: 36px; text-align: {{ section.settings.header_align | default: 'center' }}; }
  @media (min-width: 768px) {
    .pcv5__head { display: flex; flex-direction: row; justify-content: space-between; align-items: flex-end; }
  }
  .pcv5__title { font-size: 28px; font-weight: 700; color: var(--text); letter-spacing: -0.02em; }
  @media (min-width: 768px) { .pcv5__title { font-size: 36px; } }
  .pcv5__sub { font-size: 15px; color: var(--muted); }
  .pcv5__viewall { display: inline-flex; align-items: center; gap: 8px; font-weight: 700; font-size: 13px; color: var(--accent); background: #FCECE4; padding: 8px 18px; border-radius: 30px; transition: var(--ease); }
  .pcv5__viewall:hover { background: var(--accent); color: #FFFFFF; }

  /* GRID */
  .pcv5__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr);
    gap: 18px;
  }
  @media (min-width: 640px) {
    .pcv5__grid { grid-template-columns: repeat({{ section.settings.cols_tablet | default: 3 }}, 1fr); gap: 24px; }
  }
  @media (min-width: 1024px) {
    .pcv5__grid { grid-template-columns: repeat({{ section.settings.cols_desktop | default: 4 }}, 1fr); gap: 28px; }
  }

  /* CARD */
  .pcv5__card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--r-card);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    position: relative;
    transition: var(--ease);
  }
  .pcv5__card:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 32px -10px rgba(224, 122, 95, 0.18);
    border-color: #E6CBB8;
  }

  /* IMAGE BOX */
  .pcv5__img-box {
    position: relative;
    width: 100%;
    aspect-ratio: {{ section.settings.img_ratio | default: '1/1' }};
    background: #FAF0E8;
    overflow: hidden;
    border-radius: var(--r-card) var(--r-card) 0 0;
  }
  .pcv5__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .pcv5__img--sec {
    position: absolute;
    top: 0; left: 0;
    opacity: 0;
  }
  .pcv5__card:hover .pcv5__img--pri {
    {% if section.settings.enable_sec_img %}
      opacity: 0;
    {% else %}
      transform: scale(1.05);
    {% endif %}
  }
  .pcv5__card:hover .pcv5__img--sec { opacity: 1; transform: scale(1.05); }

  /* BADGES */
  .pcv5__badges { position: absolute; top: 12px; left: 12px; display: flex; flex-direction: column; gap: 6px; z-index: 2; pointer-events: none; }
  .pcv5__badge { font-size: 10px; font-weight: 700; text-transform: uppercase; padding: 4px 10px; border-radius: 20px; letter-spacing: 0.04em; }
  .pcv5__badge--sale { background: var(--badge-sale-bg); color: var(--badge-sale-text); }
  .pcv5__badge--tag { background: #3D5A80; color: #FFFFFF; }
  .pcv5__badge--sold { background: #8C7A78; color: #FFFFFF; }

  /* WISHLIST BUTTON */
  .pcv5__wish {
    position: absolute;
    top: 12px; right: 12px;
    width: 36px; height: 36px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(4px);
    display: flex; align-items: center; justify-content: center;
    color: var(--muted);
    z-index: 3;
    transition: var(--ease);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.06);
  }
  .pcv5__wish:hover { background: #FFFFFF; color: var(--accent); transform: scale(1.1); }
  .pcv5__wish.active { color: var(--accent); background: #FFFFFF; }

  /* QUICK ADD HOVER */
  .pcv5__quick-box {
    position: absolute;
    bottom: 12px; left: 12px; right: 12px;
    z-index: 3;
    transform: translateY(12px);
    opacity: 0;
    transition: var(--ease);
  }
  .pcv5__card:hover .pcv5__quick-box { transform: translateY(0); opacity: 1; }
  @media (max-width: 767px) {
    .pcv5__quick-box { transform: translateY(0); opacity: 1; position: relative; bottom: auto; left: auto; right: auto; padding: 0 14px 14px; }
  }

  .pcv5__quick-btn {
    width: 100%;
    padding: 11px 16px;
    background: var(--accent);
    color: #FFFFFF;
    font-size: 12px; font-weight: 700;
    border-radius: 25px;
    display: flex; align-items: center; justify-content: center; gap: 8px;
    transition: var(--ease);
    box-shadow: 0 6px 16px rgba(224, 122, 95, 0.3);
  }
  .pcv5__quick-btn:hover { background: var(--accent-hover); transform: scale(1.02); }
  .pcv5__quick-btn:disabled { background: #D6C5BC; cursor: not-allowed; box-shadow: none; }

  /* CARD CONTENT */
  .pcv5__content { padding: 16px; display: flex; flex-direction: column; gap: 6px; flex-grow: 1; text-align: center; }

  .pcv5__vendor { font-size: 10px; text-transform: uppercase; color: var(--accent); font-weight: 700; letter-spacing: 0.08em; }
  .pcv5__item-title { font-size: 15px; font-weight: 600; color: var(--text); line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .pcv5__item-title:hover { color: var(--accent); }

  /* RATING */
  .pcv5__rating { display: flex; align-items: center; justify-content: center; gap: 4px; font-size: 12px; color: var(--accent); font-weight: 600; }
  .pcv5__stars { letter-spacing: 1px; }
  .pcv5__rev-cnt { color: var(--muted); font-size: 11px; font-weight: 400; }

  /* PRICE */
  .pcv5__price-row { display: flex; align-items: baseline; justify-content: center; gap: 8px; margin-top: auto; padding-top: 4px; }
  .pcv5__price { font-size: 16px; font-weight: 700; color: var(--text); }
  .pcv5__cmp-price { font-size: 13px; color: var(--muted); text-decoration: line-through; }

  /* SWATCHES */
  .pcv5__swatches { display: flex; gap: 6px; align-items: center; justify-content: center; margin-top: 4px; }
  .pcv5__swatch { width: 14px; height: 14px; border-radius: 50%; border: 1px solid #F4E3D7; cursor: pointer; transition: var(--ease); }
  .pcv5__swatch:hover, .pcv5__swatch.active { transform: scale(1.25); border-color: var(--accent); }

  /* URGENCY MICRO */
  .pcv5__urgency { font-size: 11px; color: var(--accent); font-weight: 600; display: flex; align-items: center; justify-content: center; gap: 4px; margin-top: 2px; }

  /* TOAST */
  .pcv5__toast {
    position: fixed; bottom: 20px; right: 20px;
    background: var(--accent); color: #FFFFFF;
    padding: 12px 22px; border-radius: 25px;
    font-size: 13px; font-weight: 700;
    z-index: 9999;
    transform: translateY(100px); opacity: 0;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 10px 25px rgba(224, 122, 95, 0.35);
  }
  .pcv5__toast.show { transform: translateY(0); opacity: 1; }
</style>

<div class="pcv5">
  <div class="pcv5__wrap">
    
    {% if section.settings.title != blank or section.settings.subheading != blank %}
      <div class="pcv5__head">
        <div>
          {% if section.settings.title != blank %}
            <h2 class="pcv5__title">{{ section.settings.title | escape }}</h2>
          {% endif %}
          {% if section.settings.subheading != blank %}
            <p class="pcv5__sub">{{ section.settings.subheading | escape }}</p>
          {% endif %}
        </div>
        {% if section.settings.show_view_all and section.settings.collection != blank %}
          <a href="{{ collections[section.settings.collection].url }}" class="pcv5__viewall">
            {{ section.settings.view_all_label | default: 'Explore All Essentials' }} &rarr;
          </a>
        {% endif %}
      </div>
    {% endif %}

    <div class="pcv5__grid">
      {% assign target_coll = collections[section.settings.collection] %}
      {% assign limit_num = section.settings.products_per_page | default: 8 %}

      {% if target_coll != blank and target_coll.products.size > 0 %}
        {% for product in target_coll.products limit: limit_num %}
          {% assign current_variant = product.selected_or_first_available_variant %}
          
          {% render 'card-v5', product: product, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v5', product: nil, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% endif %}
    </div>

  </div>
</div>

<div class="pcv5__toast" id="pcv5-toast">Added to your bag!</div>

<script>
(function(){
  // Wishlist is handled globally by assets/wishlist.js (shared store: cf_wishlist_items).
  // Buttons are rendered by snippets/wishlist-button.liquid — no per-section storage.


  document.querySelectorAll('[data-pcv5-add]').forEach(function(btn){
    btn.addEventListener('click', function(e){
      e.preventDefault(); e.stopPropagation();
      var id = btn.dataset.pcv5Add, orig = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = 'Adding...';

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: id, quantity: 1 })
      })
      .then(function(r){ return r.json(); })
      .then(function(){
        btn.innerHTML = '✓ Added';
        showT('Product added to bag!');
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      })
      .catch(function(){
        btn.innerHTML = 'Error';
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      });
    });
  });

  function showT(msg){
    var t = document.getElementById('pcv5-toast');
    if(!t) return;
    t.textContent = msg;
    t.classList.add('show');
    setTimeout(function(){ t.classList.remove('show'); }, 3000);
  }
})();
</script>

