{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#ffffff'
  assign text_color = section.settings.text_color | default: '#2b302a'
  assign accent_color = section.settings.accent_color | default: '#4a6741'
  assign heading = section.settings.heading | default: 'Shop by Category'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 80px 20px;
    color: {{ text_color }};
  }
  
  .hp7-cat-container-{{ section_id }} {
    max-width: 1400px;
    margin: 0 auto;
  }
  
  .hp7-cat-header-{{ section_id }} {
    text-align: center;
    margin-bottom: 50px;
  }
  
  .hp7-cat-header-{{ section_id }} h2 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 500;
    color: {{ text_color }};
    margin: 0;
  }
  
  .hp7-cat-grid-{{ section_id }} {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 30px;
  }
  
  .hp7-cat-item-{{ section_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    color: {{ text_color }};
    width: calc(20% - 24px); /* 5 items per row */
    min-width: 160px;
    group: cat;
  }
  
  .hp7-cat-image-wrapper-{{ section_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: 1/1;
    border-radius: 50%; /* Perfect circle */
    background-color: #f5f5f5;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
    transition: all 0.5s cubic-bezier(0.25, 1, 0.5, 1);
    border: 1px solid rgba(43, 48, 42, 0.05);
  }
  
  /* Soft organic shape on hover */
  .hp7-cat-item-{{ section_id }}:hover .hp7-cat-image-wrapper-{{ section_id }} {
    border-radius: 40% 60% 70% 30% / 40% 50% 60% 50%;
    transform: translateY(-10px);
    box-shadow: 0 15px 30px rgba(74, 103, 65, 0.1);
  }
  
  .hp7-cat-image-wrapper-{{ section_id }} img {
    width: 80%;
    height: 80%;
    object-fit: cover;
    border-radius: 50%;
    transition: transform 0.5s ease;
  }
  
  .hp7-cat-item-{{ section_id }}:hover .hp7-cat-image-wrapper-{{ section_id }} img {
    transform: scale(1.05);
  }
  
  .hp7-cat-title-{{ section_id }} {
    font-family: 'DM Sans', sans-serif;
    font-size: 1.1rem;
    font-weight: 600;
    text-align: center;
    transition: color 0.3s ease;
  }
  
  .hp7-cat-item-{{ section_id }}:hover .hp7-cat-title-{{ section_id }} {
    color: {{ accent_color }};
  }

  @media (max-width: 992px) {
    .hp7-cat-item-{{ section_id }} {
      width: calc(33.333% - 20px);
    }
  }
  
  @media (max-width: 576px) {
    .hp7-cat-grid-{{ section_id }} {
      gap: 15px;
    }
    .hp7-cat-item-{{ section_id }} {
      width: calc(50% - 10px);
      min-width: 130px;
    }
    .hp7-cat-image-wrapper-{{ section_id }} {
      margin-bottom: 10px;
    }
    .hp7-cat-title-{{ section_id }} {
      font-size: 1rem;
    }
  }
</style>

<div class="hp7-cat-container-{{ section_id }}">
  {% if heading != blank %}
    <div class="hp7-cat-header-{{ section_id }}">
      <h2>{{ heading }}</h2>
    </div>
  {% endif %}
  
  <div class="hp7-cat-grid-{{ section_id }}">
    {% for block in section.blocks %}
      {% if block.type == 'category' %}
        <a href="{{ block.settings.link | default: '#' }}" class="hp7-cat-item-{{ section_id }}" {{ block.shopify_attributes }}>
          <div class="hp7-cat-image-wrapper-{{ section_id }}">
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | image_url: width: 400, height: 400, crop: 'center' }}" alt="{{ block.settings.title }}" loading="lazy" width="200" height="200">
            {% else %}
              <div style="color: #999; font-size: 0.8rem;">Image</div>
            {% endif %}
          </div>
          <span class="hp7-cat-title-{{ section_id }}">{{ block.settings.title }}</span>
        </a>
      {% endif %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "HP7 Category Circles",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2b302a"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#4a6741"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Category"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Category Name"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP7 Category Circles",
      "blocks": [
        { "type": "category", "settings": { "title": "Women" } },
        { "type": "category", "settings": { "title": "Men" } },
        { "type": "category", "settings": { "title": "Accessories" } },
        { "type": "category", "settings": { "title": "Home" } },
        { "type": "category", "settings": { "title": "Gifts" } }
      ]
    }
  ]
}
{% endschema %}
