{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;700;900&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    
    --font-heading: 'Inter', sans-serif;
    --font-body: 'Inter', sans-serif;
    
    background-color: var(--bg-color);
    border-bottom: 2px solid var(--text-color);
  }

  .hp40-testi-wrapper {
    display: grid;
    grid-template-columns: 1fr;
  }

  .hp40-testi__block {
    display: grid;
    grid-template-columns: 2fr 1fr;
    border-bottom: 2px solid var(--text-color);
  }

  .hp40-testi__block:last-child {
    border-bottom: none;
  }

  @media screen and (max-width: 992px) {
    .hp40-testi__block {
      grid-template-columns: 1fr;
    }
  }

  .hp40-testi__quote-col {
    padding: 60px 40px;
    border-right: 2px solid var(--text-color);
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
  }
  
  @media screen and (max-width: 992px) {
    .hp40-testi__quote-col {
      border-right: none;
      border-bottom: 2px solid var(--text-color);
    }
  }

  .hp40-testi__marks {
    font-family: var(--font-heading);
    font-size: 120px;
    line-height: 0;
    color: var(--text-color);
    position: absolute;
    top: 60px;
    left: 20px;
    opacity: 0.1;
  }

  .hp40-testi__quote {
    font-family: var(--font-heading);
    font-size: clamp(24px, 4vw, {{ section.settings.quote_size }}px);
    font-weight: 700;
    line-height: 1.2;
    color: var(--text-color);
    margin: 0;
    text-transform: uppercase;
    letter-spacing: -1px;
    position: relative;
    z-index: 2;
  }

  .hp40-testi__author-col {
    padding: 60px 40px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
  }

  .hp40-testi__author-name {
    font-family: var(--font-heading);
    font-size: 32px;
    font-weight: 900;
    color: var(--text-color);
    margin: 0;
    text-transform: uppercase;
    letter-spacing: -1px;
  }

  .hp40-testi__author-role {
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 700;
    color: var(--text-color);
    text-transform: uppercase;
    margin-top: 10px;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp40-testi-wrapper" id="HP40Testi-{{ section.id }}">
  {%- for block in section.blocks limit: 3 -%}
    <div class="hp40-testi__block" {{ block.shopify_attributes }}>
      <div class="hp40-testi__quote-col">
        <span class="hp40-testi__marks">"</span>
        <blockquote class="hp40-testi__quote">{{ block.settings.quote }}</blockquote>
      </div>
      <div class="hp40-testi__author-col">
        <div class="hp40-testi__author-name">{{ block.settings.author }}</div>
        {%- if block.settings.role != blank -%}
          <div class="hp40-testi__author-role">{{ block.settings.role }}</div>
        {%- endif -%}
      </div>
    </div>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "HP40 - Swiss Testimonial",
  "class": "section-hp40-testimonials",
  "settings": [
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "quote_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Quote Size",
      "default": 40
    },
    {
      "type": "header",
      "content": "Swiss Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#F4F4F4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text & Lines",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "An absolute masterclass in reduction and utility."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "DIETER R."
        },
        {
          "type": "text",
          "id": "role",
          "label": "Role",
          "default": "INDUSTRIAL DESIGNER"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP40 - Swiss Testimonial",
      "blocks": [
        { "type": "review" },
        { "type": "review", "settings": { "quote": "Finally, a product that understands the necessity of silence.", "author": "MASSIMO V.", "role": "ART DIRECTOR" } }
      ]
    }
  ]
}
{% endschema %}
