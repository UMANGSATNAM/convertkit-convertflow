{%- style -%}
  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --border-color: #000000;
    --border-width: 3px;
    --shadow-offset: 8px;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    border-bottom: var(--border-width) solid var(--border-color);
    font-family: 'Space Grotesk', 'Outfit', sans-serif;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }

  .hp23-bundle-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp23-bundle-wrapper {
      padding: 0 20px;
    }
  }

  .hp23-bundle__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    background: #ffffff;
    border: var(--border-width) solid var(--border-color);
    box-shadow: var(--shadow-offset) var(--shadow-offset) 0 var(--border-color);
    border-radius: {{ section.settings.border_radius }}px;
    overflow: hidden;
  }

  @media screen and (max-width: 992px) {
    .hp23-bundle__grid {
      grid-template-columns: 1fr;
    }
  }

  .hp23-bundle__image-col {
    position: relative;
    border-right: var(--border-width) solid var(--border-color);
    background: var(--accent-color);
    min-height: 500px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media screen and (max-width: 992px) {
    .hp23-bundle__image-col {
      border-right: none;
      border-bottom: var(--border-width) solid var(--border-color);
      min-height: 400px;
    }
  }

  .hp23-bundle__image {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Decorative Brutalist Cross in center of image */
  .hp23-bundle__cross {
    position: absolute;
    width: 60px;
    height: 60px;
    z-index: 2;
  }
  
  .hp23-bundle__cross::before, .hp23-bundle__cross::after {
    content: '';
    position: absolute;
    background: var(--text-color);
  }
  
  .hp23-bundle__cross::before {
    top: 25px; left: 0; width: 60px; height: 10px;
  }
  
  .hp23-bundle__cross::after {
    top: 0; left: 25px; width: 10px; height: 60px;
  }

  .hp23-bundle__badge {
    position: absolute;
    top: 20px;
    left: 20px;
    background: #FF3B30;
    color: #ffffff;
    padding: 10px 20px;
    font-size: 20px;
    font-weight: 900;
    text-transform: uppercase;
    border: 2px solid var(--border-color);
    box-shadow: 4px 4px 0 var(--border-color);
    transform: rotate(-5deg);
    z-index: 2;
  }

  .hp23-bundle__content-col {
    padding: 60px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: #ffffff;
  }

  @media screen and (max-width: 768px) {
    .hp23-bundle__content-col {
      padding: 40px 30px;
    }
  }

  .hp23-bundle__title {
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    font-weight: 900;
    color: var(--text-color);
    line-height: 1.1;
    margin: 0 0 24px;
    text-transform: uppercase;
    letter-spacing: -1px;
  }
  
  .hp23-bundle__title em {
    font-style: normal;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--text-color);
  }

  .hp23-bundle__text {
    font-family: var(--font-body);
    font-size: {{ section.settings.text_size }}px;
    font-weight: 500;
    color: var(--text-color);
    line-height: 1.5;
    margin: 0 0 30px;
  }

  .hp23-bundle__includes {
    border-top: var(--border-width) solid var(--border-color);
    border-bottom: var(--border-width) solid var(--border-color);
    padding: 20px 0;
    margin-bottom: 30px;
  }

  .hp23-bundle__includes-title {
    font-weight: 800;
    font-size: 14px;
    text-transform: uppercase;
    margin-bottom: 12px;
  }

  .hp23-bundle__list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .hp23-bundle__list li {
    position: relative;
    padding-left: 24px;
    margin-bottom: 8px;
    font-weight: 700;
    font-size: 16px;
  }
  
  .hp23-bundle__list li:last-child {
    margin-bottom: 0;
  }

  .hp23-bundle__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 6px;
    width: 10px;
    height: 10px;
    background: var(--text-color);
    border-radius: 50%; /* Make it a square in brutalist maybe? Let's use a square */
    border-radius: 0;
  }

  .hp23-bundle__price-block {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 30px;
  }

  .hp23-bundle__price {
    font-size: 32px;
    font-weight: 900;
  }

  .hp23-bundle__price-compare {
    font-size: 20px;
    font-weight: 700;
    text-decoration: line-through;
    opacity: 0.5;
  }

  .hp23-bundle__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 32px;
    background: var(--text-color);
    color: #ffffff;
    font-weight: 800;
    font-size: 16px;
    text-transform: uppercase;
    letter-spacing: 1px;
    text-decoration: none;
    border: var(--border-width) solid var(--border-color);
    border-radius: {{ section.settings.border_radius }}px;
    box-shadow: 4px 4px 0 var(--border-color);
    transition: all 0.2s ease;
    align-self: flex-start;
  }

  .hp23-bundle__btn:hover {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0 var(--border-color);
    background: var(--accent-color);
    color: var(--text-color);
  }
  
  .hp23-bundle__btn:active {
    transform: translate(4px, 4px);
    box-shadow: 0 0 0 var(--border-color);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp23-bundle-wrapper" id="HP23Bundle-{{ section.id }}">
  <div class="hp23-bundle__grid">
    
    <div class="hp23-bundle__image-col">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 1000 }}" alt="{{ section.settings.title | strip_html | escape }}" class="hp23-bundle__image" loading="lazy">
      {%- else -%}
        <div style="font-size:24px;font-weight:900;">BUNDLE IMAGE</div>
      {%- endif -%}
      
      {%- if section.settings.badge != blank -%}
        <div class="hp23-bundle__badge">{{ section.settings.badge | escape }}</div>
      {%- endif -%}

      <div class="hp23-bundle__cross"></div>
    </div>

    <div class="hp23-bundle__content-col">
      {%- if section.settings.title != blank -%}
        <h2 class="hp23-bundle__title">{{ section.settings.title }}</h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <p class="hp23-bundle__text">{{ section.settings.text | escape }}</p>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="hp23-bundle__includes">
          <div class="hp23-bundle__includes-title">WHAT'S INCLUDED:</div>
          <ul class="hp23-bundle__list">
            {%- for block in section.blocks -%}
              <li {{ block.shopify_attributes }}>{{ block.settings.title | escape }}</li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      <div class="hp23-bundle__price-block">
        {%- if section.settings.price != blank -%}
          <span class="hp23-bundle__price">{{ section.settings.price }}</span>
        {%- endif -%}
        
        {%- if section.settings.compare_price != blank -%}
          <span class="hp23-bundle__price-compare">{{ section.settings.compare_price }}</span>
        {%- endif -%}
      </div>

      {%- if section.settings.btn_text != blank -%}
        <a href="{{ section.settings.btn_link | default: '#' }}" class="hp23-bundle__btn">
          {{ section.settings.btn_text | escape }}
        </a>
      {%- endif -%}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "HP23 - Brutalist Bundle",
  "class": "section-hp23-bundle-offer",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1200
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Box Border Radius",
      "default": 12
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge Text",
      "default": "SAVE 30%"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Heading",
      "default": "<p>THE <em>ULTIMATE</em> ROUTINE</p>"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Body Text",
      "default": "Stop messing around with single products. Get the entire system for maximum results."
    },
    {
      "type": "text",
      "id": "price",
      "label": "Price",
      "default": "$115.00"
    },
    {
      "type": "text",
      "id": "compare_price",
      "label": "Compare at Price",
      "default": "$165.00"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "ADD BUNDLE TO CART"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Bundle Image"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 32,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 56
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Text Size",
      "default": 18
    },
    {
      "type": "header",
      "content": "Brutalist Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#F4F4F0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#39FF14",
      "info": "Try bright red, lime green, or bold yellow"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Bundle Item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Item Name",
          "default": "Item Name"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP23 - Brutalist Bundle",
      "blocks": [
        { "type": "item", "settings": { "title": "The Daily Cleanser (150ml)" } },
        { "type": "item", "settings": { "title": "Vitamin C Serum (30ml)" } },
        { "type": "item", "settings": { "title": "Heavy Duty Moisturizer (50ml)" } }
      ]
    }
  ]
}
{% endschema %}
