{%- style -%}
  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --border-color: #000000;
    --border-width: 3px;
    --shadow-offset: 8px;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    border-bottom: var(--border-width) solid var(--border-color);
    font-family: 'Space Grotesk', 'Outfit', sans-serif;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }

  .hp23-offer-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp23-offer-wrapper {
      padding: 0 20px;
    }
  }

  .hp23-offer__box {
    background: var(--bg-color);
    border: var(--border-width) solid var(--border-color);
    border-radius: {{ section.settings.border_radius }}px;
    box-shadow: var(--shadow-offset) var(--shadow-offset) 0 var(--border-color);
    padding: 60px 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  @media screen and (max-width: 768px) {
    .hp23-offer__box {
      padding: 40px 20px;
    }
  }

  /* Decorative background pattern */
  .hp23-offer__pattern {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-image: radial-gradient(var(--text-color) 2px, transparent 2px);
    background-size: 30px 30px;
    opacity: 0.1;
    z-index: 0;
    pointer-events: none;
  }

  .hp23-offer__content {
    position: relative;
    z-index: 1;
    max-width: 800px;
  }

  .hp23-offer__badge {
    display: inline-block;
    padding: 8px 16px;
    background: #ffffff;
    color: var(--text-color);
    font-weight: 800;
    font-size: 14px;
    text-transform: uppercase;
    border: 2px solid var(--border-color);
    box-shadow: 2px 2px 0 var(--border-color);
    margin-bottom: 24px;
    transform: rotate(3deg);
  }

  .hp23-offer__title {
    font-size: clamp(32px, 6vw, {{ section.settings.title_size }}px);
    font-weight: 900;
    color: var(--text-color);
    line-height: 1.1;
    margin: 0 0 20px;
    text-transform: uppercase;
    letter-spacing: -1px;
  }

  .hp23-offer__text {
    font-size: {{ section.settings.text_size }}px;
    font-weight: 500;
    color: var(--text-color);
    margin: 0 0 30px;
    line-height: 1.5;
  }

  .hp23-offer__code-box {
    display: inline-flex;
    align-items: stretch;
    border: var(--border-width) solid var(--border-color);
    box-shadow: 4px 4px 0 var(--border-color);
    background: #ffffff;
    margin-bottom: 30px;
  }

  .hp23-offer__code-label {
    background: var(--text-color);
    color: var(--bg-color);
    padding: 12px 20px;
    font-weight: 800;
    text-transform: uppercase;
    display: flex;
    align-items: center;
  }

  .hp23-offer__code-value {
    padding: 12px 30px;
    font-family: monospace;
    font-weight: 900;
    font-size: 24px;
    color: var(--text-color);
    letter-spacing: 2px;
    display: flex;
    align-items: center;
  }

  .hp23-offer__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 32px;
    background: var(--text-color);
    color: var(--bg-color);
    font-weight: 800;
    font-size: 16px;
    text-transform: uppercase;
    text-decoration: none;
    border: var(--border-width) solid var(--border-color);
    border-radius: {{ section.settings.border_radius }}px;
    transition: all 0.2s ease;
  }

  .hp23-offer__btn:hover {
    transform: translate(2px, 2px);
    background: #ffffff;
    color: var(--text-color);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp23-offer-wrapper" id="HP23Offer-{{ section.id }}">
  <div class="hp23-offer__box">
    {%- if section.settings.show_pattern -%}
      <div class="hp23-offer__pattern"></div>
    {%- endif -%}

    <div class="hp23-offer__content">
      {%- if section.settings.badge != blank -%}
        <div class="hp23-offer__badge">{{ section.settings.badge | escape }}</div>
      {%- endif -%}

      {%- if section.settings.title != blank -%}
        <h2 class="hp23-offer__title">{{ section.settings.title }}</h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <p class="hp23-offer__text">{{ section.settings.text | escape }}</p>
      {%- endif -%}

      {%- if section.settings.code != blank -%}
        <div class="hp23-offer__code-box">
          <div class="hp23-offer__code-label">USE CODE</div>
          <div class="hp23-offer__code-value">{{ section.settings.code | escape }}</div>
        </div>
        <br>
      {%- endif -%}

      {%- if section.settings.btn_text != blank -%}
        <a href="{{ section.settings.btn_link | default: '#' }}" class="hp23-offer__btn">
          {{ section.settings.btn_text | escape }}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "HP23 - Brutalist Offer",
  "class": "section-hp23-offer-banner",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge Text",
      "default": "LIMITED TIME"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Heading",
      "default": "<p>TAKE 20% OFF YOUR <em>ENTIRE ORDER</em></p>"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Body Text",
      "default": "No exclusions. No BS. Just a straight discount for our real ones."
    },
    {
      "type": "text",
      "id": "code",
      "label": "Discount Code",
      "default": "RAW20"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "SHOP THE SALE"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 800,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1200
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Box Border Radius",
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "show_pattern",
      "label": "Show Dot Pattern Background",
      "default": true
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 30,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 64
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 14,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Text Size",
      "default": 20
    },
    {
      "type": "header",
      "content": "Brutalist Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#39FF14",
      "info": "Loud background color"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP23 - Brutalist Offer"
    }
  ]
}
{% endschema %}
