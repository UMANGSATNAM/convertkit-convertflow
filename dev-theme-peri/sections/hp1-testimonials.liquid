{%- liquid
  assign bg_color = section.settings.bg_color | default: '#fcfaf8'
  assign text_color = section.settings.text_color | default: '#2c2c2c'
-%}

<section class="hp1-beauty-testimonials" style="background-color: {{ bg_color }}; color: {{ text_color }};" id="hp1-testimonials-{{ section.id }}">
  <div class="hp1-testimonials-inner">
    
    <div class="hp1-section-header">
      {%- if section.settings.subheading != blank -%}
        <span class="hp1-section-subheading">{{ section.settings.subheading }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="hp1-section-heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>

    <div class="hp1-testi-grid">
      {%- for block in section.blocks -%}
        <div class="hp1-testi-item" {{ block.shopify_attributes }}>
          <div class="hp1-testi-card">
            
            <div class="hp1-testi-stars">
              {%- for i in (1..5) -%}
                <svg width="16" height="16" viewBox="0 0 24 24" fill="#8a7a6c" xmlns="http://www.w3.org/2000/svg">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
              {%- endfor -%}
            </div>
            
            <h3 class="hp1-testi-title">"{{ block.settings.title }}"</h3>
            <p class="hp1-testi-text">{{ block.settings.text }}</p>
            
            <div class="hp1-testi-author">
              {%- if block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 100 }}" alt="" class="hp1-testi-author-img" loading="lazy">
              {%- else -%}
                <div class="hp1-testi-author-img hp1-author-placeholder">
                  {{ block.settings.author | slice: 0 | upcase }}
                </div>
              {%- endif -%}
              <div class="hp1-testi-author-info">
                <strong>{{ block.settings.author }}</strong>
                {%- if block.settings.verified -%}
                  <span>Verified Buyer</span>
                {%- endif -%}
              </div>
            </div>

          </div>
        </div>
      {%- endfor -%}
    </div>

  </div>
</section>

<style>
  .hp1-beauty-testimonials {
    padding: 80px 0;
    font-family: 'Inter', sans-serif;
  }
  .hp1-testimonials-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }
  .hp1-section-header {
    text-align: center;
    margin-bottom: 50px;
  }
  .hp1-section-subheading {
    display: block;
    font-size: 13px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #8a7a6c;
    margin-bottom: 10px;
  }
  .hp1-section-heading {
    font-family: 'Playfair Display', serif;
    font-size: clamp(28px, 4vw, 40px);
    font-weight: 400;
    margin: 0;
  }

  .hp1-testi-grid {
    display: flex;
    gap: 30px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding-bottom: 20px;
  }
  .hp1-testi-grid::-webkit-scrollbar {
    display: none;
  }
  .hp1-testi-item {
    flex: 0 0 calc(33.333% - 20px);
    scroll-snap-align: center;
  }
  
  .hp1-testi-card {
    background: #fff;
    padding: 40px;
    border-radius: 16px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.03);
    height: 100%;
    display: flex;
    flex-direction: column;
  }
  .hp1-testi-stars {
    margin-bottom: 20px;
    display: flex;
    gap: 4px;
  }
  .hp1-testi-title {
    font-family: 'Playfair Display', serif;
    font-size: 20px;
    font-weight: 500;
    margin: 0 0 15px;
    line-height: 1.3;
  }
  .hp1-testi-text {
    font-size: 15px;
    line-height: 1.6;
    color: #666;
    flex-grow: 1;
    margin: 0 0 30px;
  }
  
  .hp1-testi-author {
    display: flex;
    align-items: center;
    gap: 15px;
  }
  .hp1-testi-author-img {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    object-fit: cover;
  }
  .hp1-author-placeholder {
    background: #e8e0d5;
    color: #8a7a6c;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    font-size: 18px;
  }
  .hp1-testi-author-info {
    display: flex;
    flex-direction: column;
  }
  .hp1-testi-author-info strong {
    font-size: 14px;
    font-weight: 600;
  }
  .hp1-testi-author-info span {
    font-size: 12px;
    color: #999;
  }

  @media (max-width: 991px) {
    .hp1-testi-item { flex: 0 0 calc(50% - 15px); }
  }
  @media (max-width: 767px) {
    .hp1-beauty-testimonials { padding: 50px 0; }
    .hp1-testi-item { flex: 0 0 calc(85% - 15px); }
    .hp1-testi-card { padding: 30px 20px; }
  }
</style>

{% schema %}
{
  "name": "HP1 Testimonials",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Happy Customers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Real Reviews"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#fcfaf8"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2c2c2c"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "text", "id": "title", "label": "Review Title", "default": "Life Changing!" },
        { "type": "textarea", "id": "text", "label": "Review Text", "default": "I've been using this for 2 weeks and my skin has never looked better. Highly recommend!" },
        { "type": "image_picker", "id": "image", "label": "Author Image" },
        { "type": "text", "id": "author", "label": "Author Name", "default": "Sarah M." },
        { "type": "checkbox", "id": "verified", "label": "Verified Buyer", "default": true }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP1 Testimonials",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
