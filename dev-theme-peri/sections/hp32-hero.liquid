{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Space+Mono:ital,wght@0,400;0,700;1,400;1,700&family=Syne:wght@700;800&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --border-color: #000000;
    --accent-color: {{ section.settings.accent_color }};
    
    --font-heading: 'Syne', sans-serif;
    --font-body: 'Space Mono', monospace;
    
    background-color: var(--bg-color);
    /* Neo-brutalist grid background */
    background-image: linear-gradient(var(--border-color) 1px, transparent 1px),
      linear-gradient(90deg, var(--border-color) 1px, transparent 1px);
    background-size: 40px 40px;
    background-position: center center;
    border-bottom: 4px solid var(--border-color);
    
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    overflow: hidden;
  }

  .hp32-hero-wrapper {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    gap: 40px;
    align-items: center;
  }

  @media screen and (max-width: 992px) {
    .hp32-hero-wrapper {
      flex-direction: column;
      padding: 0 20px;
    }
  }

  .hp32-hero__content {
    flex: 1;
    background: #ffffff;
    border: 4px solid var(--border-color);
    padding: 60px 40px;
    box-shadow: 12px 12px 0 var(--border-color);
    position: relative;
    z-index: 2;
  }

  @media screen and (max-width: 768px) {
    .hp32-hero__content {
      padding: 40px 20px;
      box-shadow: 8px 8px 0 var(--border-color);
    }
  }

  .hp32-hero__badge {
    display: inline-block;
    background: var(--accent-color);
    color: #000;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    padding: 8px 16px;
    border: 2px solid var(--border-color);
    margin-bottom: 24px;
    box-shadow: 4px 4px 0 var(--border-color);
  }

  .hp32-hero__title {
    font-family: var(--font-heading);
    font-size: clamp(40px, 6vw, {{ section.settings.title_size }}px);
    line-height: 1;
    color: #000;
    text-transform: uppercase;
    margin: 0 0 24px;
    letter-spacing: -0.02em;
  }

  .hp32-hero__text {
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.5;
    color: #000;
    margin: 0 0 40px;
    font-weight: 700;
    max-width: 500px;
  }

  .hp32-hero__btn-group {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
  }

  .hp32-hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 32px;
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 700;
    text-transform: uppercase;
    text-decoration: none;
    color: #000;
    background: var(--accent-color);
    border: 3px solid var(--border-color);
    box-shadow: 6px 6px 0 var(--border-color);
    transition: all 0.1s ease;
    cursor: pointer;
  }

  .hp32-hero__btn:hover,
  .hp32-hero__btn:active {
    transform: translate(4px, 4px);
    box-shadow: 2px 2px 0 var(--border-color);
  }

  .hp32-hero__btn--secondary {
    background: #ffffff;
  }

  .hp32-hero__image-col {
    flex: 1.2;
    position: relative;
  }

  @media screen and (max-width: 992px) {
    .hp32-hero__image-col {
      width: 100%;
    }
  }

  .hp32-hero__image-wrap {
    border: 4px solid var(--border-color);
    box-shadow: 12px 12px 0 var(--border-color);
    background: #fff;
    aspect-ratio: 4/3;
    overflow: hidden;
    position: relative;
  }

  .hp32-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%) contrast(120%);
    transition: filter 0.3s ease;
  }

  .hp32-hero__image-wrap:hover .hp32-hero__image {
    filter: grayscale(0%) contrast(100%);
  }

  .hp32-hero__overlay-sticker {
    position: absolute;
    bottom: -20px;
    right: -20px;
    background: #ff00ff; /* Hot pink accent */
    color: #000;
    font-family: var(--font-heading);
    font-size: 24px;
    font-weight: 800;
    padding: 20px;
    border: 4px solid var(--border-color);
    border-radius: 50%;
    width: 120px;
    height: 120px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    line-height: 1;
    transform: rotate(-15deg);
    box-shadow: 8px 8px 0 var(--border-color);
    z-index: 10;
    animation: hp32-pulse 2s infinite;
  }

  @keyframes hp32-pulse {
    0% { transform: rotate(-15deg) scale(1); }
    50% { transform: rotate(-15deg) scale(1.1); }
    100% { transform: rotate(-15deg) scale(1); }
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp32-hero-wrapper" id="HP32Hero-{{ section.id }}">
  <div class="hp32-hero__content">
    {%- if section.settings.badge != blank -%}
      <div class="hp32-hero__badge">{{ section.settings.badge }}</div>
    {%- endif -%}
    
    <h1 class="hp32-hero__title">{{ section.settings.title }}</h1>
    
    {%- if section.settings.text != blank -%}
      <p class="hp32-hero__text">{{ section.settings.text }}</p>
    {%- endif -%}

    <div class="hp32-hero__btn-group">
      {%- if section.settings.btn_label != blank -%}
        <a href="{{ section.settings.btn_link | default: '#' }}" class="hp32-hero__btn">
          {{ section.settings.btn_label }}
        </a>
      {%- endif -%}
      {%- if section.settings.btn_label_2 != blank -%}
        <a href="{{ section.settings.btn_link_2 | default: '#' }}" class="hp32-hero__btn hp32-hero__btn--secondary">
          {{ section.settings.btn_label_2 }}
        </a>
      {%- endif -%}
    </div>
  </div>

  <div class="hp32-hero__image-col">
    <div class="hp32-hero__image-wrap">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.title | escape }}" class="hp32-hero__image" loading="lazy">
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'hp32-hero__image' }}
      {%- endif -%}
      
      {%- if section.settings.sticker_text != blank -%}
        <div class="hp32-hero__overlay-sticker">
          {{ section.settings.sticker_text }}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "HP32 - Brutalist Hero",
  "class": "section-hp32-hero",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "default": "SYSTEM V.1"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Heading",
      "default": "RADICAL. RAW. READY."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "NO COMPROMISES. JUST PURE UNFILTERED PERFORMANCE AND DESIGN."
    },
    {
      "type": "text",
      "id": "sticker_text",
      "label": "Sticker Text",
      "default": "NEW SHIT"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Primary Button",
      "default": "ENGAGE NOW"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Primary Link"
    },
    {
      "type": "text",
      "id": "btn_label_2",
      "label": "Secondary Button",
      "default": "VIEW DOCS"
    },
    {
      "type": "url",
      "id": "btn_link_2",
      "label": "Secondary Link"
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Image"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 40,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 80
    },
    {
      "type": "header",
      "content": "Brutalist Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#f4f4f4"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color (e.g., Lime)",
      "default": "#ccff00"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP32 - Brutalist Hero"
    }
  ]
}
{% endschema %}
