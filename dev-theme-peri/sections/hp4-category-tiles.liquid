{%- liquid
  assign bg_color = section.settings.bg_color | default: '#ffffff'
  assign text_color = section.settings.text_color | default: '#2c2c2c'
  
  assign padding_top_desktop = section.settings.padding_top_desktop
  assign padding_bottom_desktop = section.settings.padding_bottom_desktop
  assign padding_top_mobile = section.settings.padding_top_mobile
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile
-%}

<style>
  #shopify-section-{{ section.id }} {
    --hp4-ctiles-bg: {{ bg_color }};
    --hp4-ctiles-text: {{ text_color }};
    
    --hp4-ctiles-pt-desk: {{ padding_top_desktop }}px;
    --hp4-ctiles-pb-desk: {{ padding_bottom_desktop }}px;
    --hp4-ctiles-pt-mob: {{ padding_top_mobile }}px;
    --hp4-ctiles-pb-mob: {{ padding_bottom_mobile }}px;
  }

  .hp4-decor-ctiles-{{ section.id }} {
    padding-top: var(--hp4-ctiles-pt-desk);
    padding-bottom: var(--hp4-ctiles-pb-desk);
    background-color: var(--hp4-ctiles-bg);
    color: var(--hp4-ctiles-text);
    font-family: 'Inter', sans-serif;
  }

  .hp4-ctiles-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
  }
  
  .hp4-ctiles-header {
    text-align: center;
    margin-bottom: 60px;
  }
  
  .hp4-ctiles-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 400;
    margin: 0;
  }

  /* Grid Layout - Asymmetric/Editorial */
  .hp4-ctiles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(2, 400px);
    gap: 20px;
  }

  .hp4-ctiles-item {
    position: relative;
    overflow: hidden;
    display: block;
    text-decoration: none;
    border-radius: 4px;
  }
  
  /* Make first item large */
  .hp4-ctiles-item:nth-child(1) {
    grid-column: span 2;
    grid-row: span 2;
  }

  .hp4-ctiles-img-wrapper {
    position: absolute;
    inset: 0;
    background: #f4f1eb;
  }

  .hp4-ctiles-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s cubic-bezier(0.25, 1, 0.5, 1);
  }
  .hp4-ctiles-item:hover .hp4-ctiles-img {
    transform: scale(1.05);
  }
  
  /* Overlay Gradient */
  .hp4-ctiles-item::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.6) 0%, transparent 40%);
    pointer-events: none;
  }

  .hp4-ctiles-content {
    position: absolute;
    bottom: 30px;
    left: 30px;
    right: 30px;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
  }

  .hp4-ctiles-name {
    font-family: 'Playfair Display', serif;
    font-size: 24px;
    font-weight: 400;
    color: #fff;
    margin: 0;
  }
  
  .hp4-ctiles-item:nth-child(1) .hp4-ctiles-name {
    font-size: 36px;
  }

  .hp4-ctiles-link {
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: #fff;
    border-bottom: 1px solid #fff;
    padding-bottom: 4px;
    opacity: 0;
    transform: translateY(10px);
    transition: all 0.4s ease;
  }
  .hp4-ctiles-item:hover .hp4-ctiles-link {
    opacity: 1;
    transform: translateY(0);
  }

  @media screen and (max-width: 1024px) {
    .hp4-ctiles-grid {
      grid-template-columns: repeat(2, 1fr);
      grid-template-rows: auto;
      grid-auto-rows: 300px;
    }
    .hp4-ctiles-item:nth-child(1) {
      grid-column: span 2;
      grid-row: span 1;
    }
  }

  @media screen and (max-width: 768px) {
    .hp4-decor-ctiles-{{ section.id }} {
      padding-top: var(--hp4-ctiles-pt-mob);
      padding-bottom: var(--hp4-ctiles-pb-mob);
    }
    .hp4-ctiles-inner {
      padding: 0 20px;
    }
    .hp4-ctiles-header {
      margin-bottom: 30px;
    }
    .hp4-ctiles-grid {
      grid-template-columns: 1fr;
      grid-auto-rows: 350px;
      gap: 15px;
    }
    .hp4-ctiles-item:nth-child(1) {
      grid-column: span 1;
    }
    .hp4-ctiles-content {
      bottom: 20px; left: 20px; right: 20px;
    }
    .hp4-ctiles-link {
      opacity: 1;
      transform: none;
    }
  }
</style>

<section class="hp4-decor-ctiles-{{ section.id }}" aria-label="Collections">
  <div class="hp4-ctiles-inner">
    
    {%- if section.settings.heading != blank -%}
      <div class="hp4-ctiles-header">
        <h2 class="hp4-ctiles-title">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    <div class="hp4-ctiles-grid">
      {%- for block in section.blocks limit: 3 -%}
        {%- assign coll = collections[block.settings.collection] -%}
        {%- assign title = block.settings.title | default: coll.title | default: 'Collection' -%}
        {%- assign link = block.settings.link | default: coll.url | default: '#' -%}
        {%- assign image = block.settings.image | default: coll.image | default: coll.products.first.featured_image -%}
        
        <a href="{{ link }}" class="hp4-ctiles-item" {{ block.shopify_attributes }}>
          <div class="hp4-ctiles-img-wrapper">
            {%- if image != blank -%}
              <img height="{{ image.height }}" width="{{ image.width }}" src="{{ image | image_url: width: 1200 }}" class="hp4-ctiles-img" loading="lazy" alt="{{ title }}">
            {%- else -%}
              {%- capture current -%}{% cycle 1, 2, 3 %}{%- endcapture -%}
              {{ 'collection-' | append: current | placeholder_svg_tag: 'hp4-ctiles-img placeholder-svg' }}
            {%- endif -%}
          </div>
          <div class="hp4-ctiles-content">
            <h3 class="hp4-ctiles-name">{{ title }}</h3>
            <span class="hp4-ctiles-link">Explore</span>
          </div>
        </a>
      {%- endfor -%}

      {%- if section.blocks.size == 0 -%}
        <a href="#" class="hp4-ctiles-item">
          <div class="hp4-ctiles-img-wrapper">{{ 'collection-1' | placeholder_svg_tag: 'hp4-ctiles-img placeholder-svg' }}</div>
          <div class="hp4-ctiles-content"><h3 class="hp4-ctiles-name">Living Room</h3><span class="hp4-ctiles-link">Explore</span></div>
        </a>
        <a href="#" class="hp4-ctiles-item">
          <div class="hp4-ctiles-img-wrapper">{{ 'collection-2' | placeholder_svg_tag: 'hp4-ctiles-img placeholder-svg' }}</div>
          <div class="hp4-ctiles-content"><h3 class="hp4-ctiles-name">Bedroom</h3><span class="hp4-ctiles-link">Explore</span></div>
        </a>
        <a href="#" class="hp4-ctiles-item">
          <div class="hp4-ctiles-img-wrapper">{{ 'collection-3' | placeholder_svg_tag: 'hp4-ctiles-img placeholder-svg' }}</div>
          <div class="hp4-ctiles-content"><h3 class="hp4-ctiles-name">Kitchen</h3><span class="hp4-ctiles-link">Explore</span></div>
        </a>
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "HP4 Decor Category Tiles",
  "tag": "section",
  "class": "section-hp4-ctiles",
  "max_blocks": 3,
  "settings": [
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Curated Spaces"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2c2c2c"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Top (Desktop)", "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Bottom (Desktop)", "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Top (Mobile)", "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Bottom (Mobile)", "default": 40
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Tile",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Image (Overrides Collection Image)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom Title"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP4 Decor Category Tiles",
      "category": "Collection",
      "blocks": [
        { "type": "category", "settings": { "title": "Living Spaces" } },
        { "type": "category", "settings": { "title": "Sanctuaries" } },
        { "type": "category", "settings": { "title": "Dining" } }
      ]
    }
  ]
}
{% endschema %}
