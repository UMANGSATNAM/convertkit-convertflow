{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#000000'
  assign text_color = section.settings.text_color | default: '#FFFFFF'
  assign image_position = section.settings.image_position | default: 'left'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 120px 20px;
    color: {{ text_color }};
    border-bottom: 3px solid #000;
  }
  
  .hp11-iwt-container-{{ section_id }} {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    align-items: stretch;
    gap: 0;
    flex-direction: {% if image_position == 'right' %}row-reverse{% else %}row{% endif %};
    border: 4px solid #FFF;
    background: #000;
  }
  
  .hp11-iwt-image-wrap-{{ section_id }} {
    flex: 1;
    position: relative;
    border-right: {% if image_position == 'left' %}4px solid #FFF{% else %}none{% endif %};
    border-left: {% if image_position == 'right' %}4px solid #FFF{% else %}none{% endif %};
    min-height: 500px;
  }
  
  .hp11-iwt-image-{{ section_id }} {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover;
    filter: contrast(110%);
  }
  
  .hp11-iwt-content-{{ section_id }} {
    flex: 1;
    padding: 60px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: #CCFF00;
    color: #000;
  }
  
  .hp11-iwt-heading-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: clamp(3rem, 5vw, 4.5rem);
    font-weight: 900;
    margin: 0 0 20px 0;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: -2px;
  }
  
  .hp11-iwt-text-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: 1.2rem;
    font-weight: 600;
    line-height: 1.5;
    margin: 0 0 40px 0;
  }
  
  .hp11-iwt-btn-{{ section_id }} {
    display: inline-block;
    padding: 16px 40px;
    background: #000;
    color: #FFF;
    border: 3px solid #000;
    font-family: 'Inter', sans-serif;
    font-size: 1.2rem;
    font-weight: 900;
    text-transform: uppercase;
    text-decoration: none;
    letter-spacing: 1px;
    transition: all 0.2s ease;
    align-self: flex-start;
  }
  
  .hp11-iwt-btn-{{ section_id }}:hover {
    background: #FF00FF;
    color: #FFF;
    transform: translate(-4px, -4px);
    box-shadow: 4px 4px 0 #000;
  }

  @media (max-width: 992px) {
    .hp11-iwt-container-{{ section_id }} {
      flex-direction: column;
    }
    .hp11-iwt-image-wrap-{{ section_id }} {
      border: none;
      border-bottom: 4px solid #FFF;
      min-height: 400px;
    }
    .hp11-iwt-content-{{ section_id }} {
      padding: 40px 20px;
    }
  }
</style>

<div class="hp11-iwt-container-{{ section_id }}">
  <div class="hp11-iwt-image-wrap-{{ section_id }}">
    {% if section.settings.image != blank %}
      <img height="{{ section.settings.image.height }}" width="{{ section.settings.image.width }}" src="{{ section.settings.image | image_url: width: 1000 }}" alt="{{ section.settings.heading | escape }}" class="hp11-iwt-image-{{ section_id }}" loading="lazy">
    {% else %}
      <div class="hp11-iwt-image-{{ section_id }}" style="background: repeating-linear-gradient(45deg, #EFEFEF, #EFEFEF 12px, #E6E6E6 12px, #E6E6E6 24px);"></div>
    {% endif %}
  </div>
  
  <div class="hp11-iwt-content-{{ section_id }}">
    <h2 class="hp11-iwt-heading-{{ section_id }}">{{ section.settings.heading | default: 'STREET CULTURE' }}</h2>
    <div class="hp11-iwt-text-{{ section_id }}">
      {% if section.settings.text != blank %}
        {{ section.settings.text }}
      {% else %}
        <p>Born from the concrete. Designed for the bold. We don't follow trends, we set them. Get the latest fits now.</p>
      {% endif %}
    </div>
    {% if section.settings.button_label != blank %}
      <a href="{{ section.settings.button_link | default: '#' }}" class="hp11-iwt-btn-{{ section_id }}">
        {{ section.settings.button_label }}
      </a>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "HP11 Image with Text",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "STREET CULTURE"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Born from the concrete. Designed for the bold. We don't follow trends, we set them.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "READ MORE"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "HP11 Image with Text"
    }
  ]
}
{% endschema %}
