<style>
@media screen and (max-width: 768px) {
  .hp43-trust-badges {
    padding-left: 16px !important;
    padding-right: 16px !important;
    box-sizing: border-box !important;
  }
  img {
    max-width: 100% !important;
    height: auto !important;
  }
}
</style>
{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: "#080B10" }};
    padding: 45px 20px;
    border-top: 1px solid #1E293B;
  }

  .hp43-trust__wrap {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    justify-content: space-around;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
    color: #64748B;
    font-family: 'Rajdhani', sans-serif;
    font-size: 15px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .hp43-trust__item {
    display: flex;
    align-items: center;
    gap: 10px;
  }
{%- endstyle -%}

<div class="hp43-trust__wrap">
  <div class="hp43-trust__item">🔒 SSL 256-BIT ENCRYPTED CHECKOUT</div>
  <div class="hp43-trust__item">✈️ DHL EXPRESS GLOBAL AIR DISPATCH</div>
  <div class="hp43-trust__item">🛡️ 2-YEAR ADVANCE REPLACEMENT WARRANTY</div>
  <div class="hp43-trust__item">💬 24/7 TECHNICAL COMMAND SUPPORT</div>
</div>

{% schema %}
{
  "name": "HP43 - Cyber Trust",
  "class": "section-hp43-trust",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#080B10"
    }
  ],
  "presets": [
    {
      "name": "HP43 - Cyber Trust"
    }
  ]
}
{% endschema %}
