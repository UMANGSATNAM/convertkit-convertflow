{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600&family=Syncopate:wght@400;700&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --font-heading: 'Syncopate', sans-serif;
    --font-body: 'Space Grotesk', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.8 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.8 | round }}px;
    }
  }

  .hp27-ct-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp27-ct-wrapper {
      padding: 0 20px;
    }
  }

  .hp27-ct__header {
    text-align: center;
    margin-bottom: 50px;
  }

  .hp27-ct__subtitle {
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent-color);
    margin-bottom: 15px;
  }

  .hp27-ct__title {
    font-family: var(--font-heading);
    font-size: clamp(24px, 3vw, {{ section.settings.title_size }}px);
    font-weight: 700;
    color: var(--text-color);
    margin: 0;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }

  .hp27-ct__grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 20px;
  }

  @media screen and (max-width: 768px) {
    .hp27-ct__grid {
      display: flex;
      flex-direction: column;
      gap: 15px;
    }
  }

  .hp27-ct__item {
    position: relative;
    display: block;
    text-decoration: none;
    overflow: hidden;
    background: #111;
    border: 1px solid rgba(226, 226, 226, 0.1);
    min-height: 350px;
  }

  /* Specific tile sizing for desktop */
  .hp27-ct__item:nth-child(1) { grid-column: span 7; }
  .hp27-ct__item:nth-child(2) { grid-column: span 5; }
  .hp27-ct__item:nth-child(3) { grid-column: span 4; }
  .hp27-ct__item:nth-child(4) { grid-column: span 8; }

  @media screen and (max-width: 992px) and (min-width: 769px) {
    .hp27-ct__item:nth-child(1),
    .hp27-ct__item:nth-child(2),
    .hp27-ct__item:nth-child(3),
    .hp27-ct__item:nth-child(4) {
      grid-column: span 6;
    }
  }

  .hp27-ct__item-inner {
    position: absolute;
    top: 2px; left: 2px; right: 2px; bottom: 2px;
    overflow: hidden;
  }

  /* Hover Crosshair brackets */
  .hp27-ct__item::before,
  .hp27-ct__item::after {
    content: '';
    position: absolute;
    width: 20px; height: 20px;
    border: 2px solid var(--accent-color);
    opacity: 0;
    transition: all 0.4s ease;
    z-index: 3;
    pointer-events: none;
  }

  .hp27-ct__item::before {
    top: 10px; left: 10px;
    border-right: none; border-bottom: none;
    transform: translate(-10px, -10px);
  }

  .hp27-ct__item::after {
    bottom: 10px; right: 10px;
    border-left: none; border-top: none;
    transform: translate(10px, 10px);
  }

  .hp27-ct__item:hover::before,
  .hp27-ct__item:hover::after {
    opacity: 1;
    transform: translate(0, 0);
  }

  .hp27-ct__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%) contrast(1.1) brightness(0.6);
    transition: filter 0.5s ease, transform 1s ease;
  }

  .hp27-ct__item:hover .hp27-ct__image {
    filter: grayscale(0%) contrast(1) brightness(0.9);
    transform: scale(1.05);
  }

  .hp27-ct__content {
    position: absolute;
    bottom: 20px;
    left: 20px;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .hp27-ct__label {
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.2em;
    color: var(--text-color);
    background: rgba(10, 10, 10, 0.8);
    padding: 4px 8px;
    margin-bottom: 10px;
    border: 1px solid rgba(226, 226, 226, 0.2);
    text-transform: uppercase;
  }

  .hp27-ct__title-text {
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--text-color);
    text-transform: uppercase;
    margin: 0;
    text-shadow: 0 2px 4px rgba(0,0,0,0.5);
  }

  .hp27-ct__arrow {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 32px;
    height: 32px;
    background: var(--text-color);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    transform: scale(0) rotate(-45deg);
    transition: all 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .hp27-ct__item:hover .hp27-ct__arrow {
    transform: scale(1) rotate(0deg);
  }

  .hp27-ct__arrow svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: var(--bg-color);
    stroke-width: 2;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp27-ct-wrapper" id="HP27CT-{{ section.id }}">
  <div class="hp27-ct__header">
    {%- if section.settings.subtitle != blank -%}
      <div class="hp27-ct__subtitle">{{ section.settings.subtitle }}</div>
    {%- endif -%}
    {%- if section.settings.title != blank -%}
      <h2 class="hp27-ct__title">{{ section.settings.title }}</h2>
    {%- endif -%}
  </div>

  <div class="hp27-ct__grid">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.link | default: '#' }}" class="hp27-ct__item" {{ block.shopify_attributes }}>
        <div class="hp27-ct__item-inner">
          {%- if block.settings.image != blank -%}
            <img height="{{ block.settings.image.height }}" width="{{ block.settings.image.width }}" src="{{ block.settings.image | image_url: width: 1000 }}" alt="{{ block.settings.title | escape }}" class="hp27-ct__image" loading="lazy">
          {%- else -%}
            {{ 'collection-' | append: forloop.index | placeholder_svg_tag: 'hp27-ct__image' }}
          {%- endif -%}
        </div>

        <div class="hp27-ct__arrow">
          <svg viewBox="0 0 24 24"><path d="M5 12H19M19 12L12 5M19 12L12 19"/></svg>
        </div>

        <div class="hp27-ct__content">
          {%- if block.settings.label != blank -%}
            <div class="hp27-ct__label">{{ block.settings.label }}</div>
          {%- endif -%}
          <h3 class="hp27-ct__title-text">{{ block.settings.title }}</h3>
        </div>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "HP27 - Eng Cat Tiles",
  "class": "section-hp27-category-tiles",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "SYSTEM ARCHITECTURE"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "EXPLORE MODULES"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1400
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 40
    },
    {
      "type": "header",
      "content": "Dark Engineered Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#0A0A0A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#E2E2E2"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#FF2A2A"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 100
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Tile",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Small Label",
          "default": "MOD_01"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "APPAREL"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP27 - Eng Cat Tiles",
      "blocks": [
        { "type": "category", "settings": { "label": "MOD_01", "title": "OUTERWEAR" } },
        { "type": "category", "settings": { "label": "MOD_02", "title": "FOOTWEAR" } },
        { "type": "category", "settings": { "label": "MOD_03", "title": "ACCESSORIES" } },
        { "type": "category", "settings": { "label": "MOD_04", "title": "HARDWARE" } }
      ]
    }
  ]
}
{% endschema %}
