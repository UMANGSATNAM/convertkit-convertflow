{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp51-vid-bg: {{ section.settings.bg_color | default: '#F2EFE9' }};
    
    background-color: var(--hp51-vid-bg);
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
  }

  .hp51-video__box {
    max-width: {{ section.settings.container_width | default: 1240 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp51-video__media {
    width: 100%;
    height: {{ section.settings.video_height | default: 480 }}px;
    background: #E3DDD3;
    border-radius: 24px;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 20px 50px rgba(30, 58, 43, 0.08);
  }

  .hp51-video__poster {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hp51-video__play-btn {
    position: absolute;
    width: 80px;
    height: 80px;
    background: rgba(250, 248, 245, 0.95);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #1E3A2B;
    font-size: 24px;
    cursor: pointer;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
    transition: all 0.3s ease;
  }

  .hp51-video__play-btn:hover {
    transform: scale(1.1);
    background: #1E3A2B;
    color: #FAF8F5;
  }

  @media screen and (max-width: 768px) {
    .hp51-video__media { height: 320px; }
  }
{%- endstyle -%}

<div class="hp51-video__box">
  <div class="hp51-video__media">
    {%- if section.settings.poster_image != blank -%}
      <img src="{{ section.settings.poster_image | image_url: width: 1400 }}" class="hp51-video__poster" alt="Zen Cinema" loading="lazy">
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'hp51-video__poster' }}
    {%- endif -%}
    <div class="hp51-video__play-btn" onclick="alert('Streaming Kyoto Uji Tea Harvest Film');">▶</div>
  </div>
</div>

{% schema %}
{
  "name": "HP51 - Zen Video",
  "class": "section-hp51-video",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#F2EFE9" },
    { "type": "image_picker", "id": "poster_image", "label": "Poster Image" },
    { "type": "range", "id": "video_height", "min": 300, "max": 700, "step": 20, "unit": "px", "label": "Video Height", "default": 480 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 80 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1240 }
  ],
  "presets": [
    { "name": "HP51 - Zen Video" }
  ]
}
{% endschema %}
