{%- comment -%}
  sections/fb04-announcement_streetwear.liquid

  CONVERSION PSYCHOLOGY (Frameblox Landing 04 Replica):
  1. URGENCY & SCARCITY BAR -- Dark banner with electric blue glow text.
  2. COUPON ANCHORING -- Direct discount code "WELCOME10" reduces first-time checkout friction.
{%- endcomment -%}

{%- liquid
  assign section_id = 'fb04-ann-' | append: section.id
-%}

<style>
  #shopify-section-{{ section.id }} {
    --ann-bg: {{ section.settings.bg_color | default: '#0066FF' }};
    --ann-text: {{ section.settings.text_color | default: '#FFFFFF' }};
  }

  .fb04-announcement {
    background: var(--ann-bg);
    color: var(--ann-text);
    text-align: center;
    padding: 10px 16px;
    font-family: var(--font-body, -apple-system, sans-serif);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.8px;
    text-transform: uppercase;
  }

  .fb04-announcement a {
    color: inherit;
    text-decoration: underline;
    margin-left: 8px;
  }
</style>

<div class="fb04-announcement" id="{{ section_id }}">
  <span>{{ section.settings.text | default: '⚡ FREE WORLDWIDE EXPRESS SHIPPING ON ORDERS OVER $99 • USE CODE WELCOME10' }}</span>
  {%- if section.settings.link != blank -%}
    <a href="{{ section.settings.link }}">Shop Now &rarr;</a>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "FB04 Announcement Bar",
  "tag": "section",
  "class": "section-fb04-announcement",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Announcement Text",
      "default": "⚡ FREE WORLDWIDE EXPRESS SHIPPING ON ORDERS OVER $99 • USE CODE WELCOME10"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#0066FF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "FB04 Announcement Bar"
    }
  ]
}
{% endschema %}
