{%- liquid
  assign bg_color = section.settings.bg_color | default: '#111111'
  assign text_color = section.settings.text_color | default: '#ffffff'
  assign accent_color = section.settings.accent_color | default: '#ff4500'
  
  assign padding_top_desktop = section.settings.padding_top_desktop
  assign padding_bottom_desktop = section.settings.padding_bottom_desktop
  assign padding_top_mobile = section.settings.padding_top_mobile
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile
  
  assign collection = collections[section.settings.collection]
-%}

<style>
  #shopify-section-{{ section.id }} {
    --hp6-bs-bg: {{ bg_color }};
    --hp6-bs-text: {{ text_color }};
    --hp6-bs-accent: {{ accent_color }};
    
    --hp6-bs-pt-desk: {{ padding_top_desktop }}px;
    --hp6-bs-pb-desk: {{ padding_bottom_desktop }}px;
    --hp6-bs-pt-mob: {{ padding_top_mobile }}px;
    --hp6-bs-pb-mob: {{ padding_bottom_mobile }}px;
  }

  .hp6-sports-bs-{{ section.id }} {
    padding-top: var(--hp6-bs-pt-desk);
    padding-bottom: var(--hp6-bs-pb-desk);
    background-color: var(--hp6-bs-bg);
    color: var(--hp6-bs-text);
  }

  .hp6-bs-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .hp6-bs-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 40px;
  }

  .hp6-bs-title {
    font-family: 'Oswald', sans-serif;
    font-size: clamp(32px, 4vw, 56px);
    font-weight: 700;
    text-transform: uppercase;
    margin: 0;
    line-height: 1.1;
  }

  .hp6-bs-nav {
    display: flex;
    gap: 15px;
  }
  .hp6-bs-btn {
    width: 45px; height: 45px;
    background: transparent;
    border: 2px solid rgba(255,255,255,0.2);
    color: var(--hp6-bs-text);
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    clip-path: polygon(15% 0, 100% 0, 85% 100%, 0% 100%);
  }
  .hp6-bs-btn:hover {
    border-color: var(--hp6-bs-accent);
    background: var(--hp6-bs-accent);
    color: #fff;
  }
  .hp6-bs-btn svg { width: 20px; height: 20px; fill: currentColor; }

  /* Carousel */
  .hp6-bs-carousel-wrap {
    position: relative;
    overflow: hidden;
  }
  .hp6-bs-track {
    display: flex;
    gap: 30px;
    transition: transform 0.5s cubic-bezier(0.25, 1, 0.5, 1);
  }
  .hp6-bs-slide {
    flex: 0 0 calc(25% - 22.5px); /* 4 items desktop */
    min-width: 0;
  }

  .hp6-bs-card {
    background: #1a1a1a;
    padding: 20px;
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: transform 0.3s ease;
  }
  .hp6-bs-card:hover { transform: translateY(-5px); }

  .hp6-bs-rank {
    font-family: 'Oswald', sans-serif;
    font-size: 40px;
    font-weight: 700;
    color: transparent;
    -webkit-text-stroke: 1px rgba(255,255,255,0.3);
    line-height: 1;
    margin-bottom: 10px;
  }

  .hp6-bs-img-wrap {
    width: 100%;
    aspect-ratio: 1/1;
    background: #000;
    margin-bottom: 20px;
    position: relative;
  }
  .hp6-bs-img-wrap img {
    width: 100%; height: 100%; object-fit: cover;
  }

  .hp6-bs-info {
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .hp6-bs-product-title {
    font-family: 'Oswald', sans-serif;
    font-size: 18px;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--hp6-bs-text);
    text-decoration: none;
    margin-bottom: 10px;
  }
  .hp6-bs-price {
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    font-weight: 600;
    color: var(--hp6-bs-accent);
    margin-bottom: 15px;
    margin-top: auto;
  }

  .hp6-bs-add {
    width: 100%;
    padding: 12px;
    background: rgba(255,255,255,0.1);
    color: #fff;
    border: none;
    font-family: 'Oswald', sans-serif;
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    cursor: pointer;
    clip-path: polygon(5% 0, 100% 0, 95% 100%, 0% 100%);
    transition: background 0.3s ease;
  }
  .hp6-bs-add:hover {
    background: var(--hp6-bs-accent);
  }

  @media screen and (max-width: 1024px) {
    .hp6-bs-slide { flex: 0 0 calc(33.333% - 20px); }
  }
  @media screen and (max-width: 768px) {
    .hp6-sports-bs-{{ section.id }} {
      padding-top: var(--hp6-bs-pt-mob);
      padding-bottom: var(--hp6-bs-pb-mob);
    }
    .hp6-bs-inner { padding: 0 20px; }
    .hp6-bs-slide { flex: 0 0 calc(80% - 15px); }
    .hp6-bs-track { gap: 15px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
    .hp6-bs-track::-webkit-scrollbar { display: none; }
    .hp6-bs-slide { scroll-snap-align: start; }
    .hp6-bs-nav { display: none; } /* Hide arrows on mobile, use swipe */
  }
</style>

<section class="hp6-sports-bs-{{ section.id }}" aria-label="Bestsellers">
  <div class="hp6-bs-inner">
    
    <div class="hp6-bs-header">
      <h2 class="hp6-bs-title">{{ section.settings.heading }}</h2>
      <div class="hp6-bs-nav">
        <button class="hp6-bs-btn hp6-bs-prev" aria-label="Previous">
          <svg viewBox="0 0 24 24"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <button class="hp6-bs-btn hp6-bs-next" aria-label="Next">
          <svg viewBox="0 0 24 24"><path d="M9 18l6-6-6-6"/></svg>
        </button>
      </div>
    </div>

    <div class="hp6-bs-carousel-wrap">
      <div class="hp6-bs-track" id="hp6-bs-track-{{ section.id }}">
        {%- if collection != blank and collection.products_count > 0 -%}
          {%- for product in collection.products limit: 8 -%}
            <div class="hp6-bs-slide">
              <div class="hp6-bs-card">
                <div class="hp6-bs-rank">#{{ forloop.index }}</div>
                <div class="hp6-bs-img-wrap">
                  <a href="{{ product.url }}">
                    <img height="{{ product.featured_image.height }}" width="{{ product.featured_image.width }}" src="{{ product.featured_image | image_url: width: 400 }}" loading="lazy" alt="{{ product.title }}">
                  </a>
                </div>
                <div class="hp6-bs-info">
                  <a href="{{ product.url }}" class="hp6-bs-product-title">{{ product.title }}</a>
                  <div class="hp6-bs-price">{{ product.price | money }}</div>
                  <button type="button" class="hp6-bs-add" onclick="window.location.href='{{ product.url }}'">View Gear</button>
                </div>
              </div>
            </div>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..6) -%}
            <div class="hp6-bs-slide">
              <div class="hp6-bs-card">
                <div class="hp6-bs-rank">#{{ i }}</div>
                <div class="hp6-bs-img-wrap">
                  {{ 'product-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
                <div class="hp6-bs-info">
                  <a href="#" class="hp6-bs-product-title">Pro Training Top</a>
                  <div class="hp6-bs-price">$45.00</div>
                  <button type="button" class="hp6-bs-add">View Gear</button>
                </div>
              </div>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>

  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const track = document.getElementById('hp6-bs-track-{{ section.id }}');
    const prevBtn = document.querySelector('.hp6-sports-bs-{{ section.id }} .hp6-bs-prev');
    const nextBtn = document.querySelector('.hp6-sports-bs-{{ section.id }} .hp6-bs-next');
    if(!track || !prevBtn || !nextBtn) return;

    let currentIndex = 0;
    
    function updateCarousel() {
      const slides = track.children;
      if(slides.length === 0) return;
      const slideWidth = slides[0].offsetWidth;
      const gap = window.innerWidth > 768 ? 30 : 15;
      track.style.transform = `translateX(-${currentIndex * (slideWidth + gap)}px)`;
    }

    nextBtn.addEventListener('click', () => {
      const slides = track.children;
      const maxIndex = window.innerWidth > 1024 ? slides.length - 4 : (window.innerWidth > 768 ? slides.length - 3 : slides.length - 1);
      if(currentIndex < maxIndex) {
        currentIndex++;
        updateCarousel();
      }
    });

    prevBtn.addEventListener('click', () => {
      if(currentIndex > 0) {
        currentIndex--;
        updateCarousel();
      }
    });

    window.addEventListener('resize', updateCarousel);
  });
</script>

{% schema %}
{
  "name": "HP6 Sports Bestsellers",
  "tag": "section",
  "class": "section-hp6-bestsellers",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "TOP PERFORMANCE GEAR"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#ff4500"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Top (Desktop)", "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Bottom (Desktop)", "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Top (Mobile)", "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Bottom (Mobile)", "default": 50
    }
  ],
  "presets": [
    {
      "name": "HP6 Sports Bestsellers",
      "category": "Collection"
    }
  ]
}
{% endschema %}
