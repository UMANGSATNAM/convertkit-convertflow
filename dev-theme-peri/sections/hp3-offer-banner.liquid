{%- liquid
  assign bg_color = section.settings.bg_color | default: '#050505'
  assign text_color = section.settings.text_color | default: '#ffffff'
  assign accent_color = section.settings.accent_color | default: '#00ffcc'
  
  assign padding_top_desktop = section.settings.padding_top_desktop
  assign padding_bottom_desktop = section.settings.padding_bottom_desktop
  assign padding_top_mobile = section.settings.padding_top_mobile
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile
-%}

<style>
  #shopify-section-{{ section.id }} {
    --hp3-offer-bg: {{ bg_color }};
    --hp3-offer-text: {{ text_color }};
    --hp3-offer-accent: {{ accent_color }};
    
    --hp3-offer-pt-desk: {{ padding_top_desktop }}px;
    --hp3-offer-pb-desk: {{ padding_bottom_desktop }}px;
    --hp3-offer-pt-mob: {{ padding_top_mobile }}px;
    --hp3-offer-pb-mob: {{ padding_bottom_mobile }}px;
  }

  .hp3-tech-offer-{{ section.id }} {
    padding-top: var(--hp3-offer-pt-desk);
    padding-bottom: var(--hp3-offer-pb-desk);
    background-color: var(--hp3-offer-bg);
    color: var(--hp3-offer-text);
    font-family: 'Inter', sans-serif;
  }

  .hp3-offer-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .hp3-offer-banner {
    background: #111;
    border: 1px solid rgba(0, 255, 204, 0.3);
    border-radius: 12px;
    padding: 60px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: relative;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0,0,0,0.5);
  }

  /* Glitch/Scanline overlay */
  .hp3-offer-banner::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(rgba(0,255,204,0.05) 50%, transparent 50%);
    background-size: 100% 4px;
    z-index: 1;
    pointer-events: none;
  }

  .hp3-offer-content {
    position: relative;
    z-index: 2;
    max-width: 600px;
  }

  .hp3-offer-badge {
    display: inline-block;
    padding: 6px 12px;
    background: var(--hp3-offer-accent);
    color: #000;
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 2px;
    border-radius: 4px;
    margin-bottom: 20px;
  }

  .hp3-offer-title {
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 900;
    line-height: 1.1;
    margin: 0 0 15px 0;
    text-transform: uppercase;
    letter-spacing: -1px;
  }

  .hp3-offer-desc {
    font-size: 18px;
    color: rgba(255,255,255,0.7);
    margin: 0 0 30px 0;
    line-height: 1.5;
  }

  .hp3-offer-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 15px 30px;
    background: #fff;
    color: #000;
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    text-decoration: none;
    border-radius: 4px;
    transition: all 0.3s ease;
  }

  .hp3-offer-btn:hover {
    background: var(--hp3-offer-accent);
    transform: translateX(5px);
  }

  /* Timer */
  .hp3-offer-timer {
    position: relative;
    z-index: 2;
    display: flex;
    gap: 20px;
  }

  .hp3-timer-box {
    background: rgba(0,0,0,0.5);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 8px;
    width: 80px;
    height: 80px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    box-shadow: inset 0 0 15px rgba(0,255,204,0.1);
  }

  .hp3-timer-num {
    font-size: 32px;
    font-weight: 900;
    color: var(--hp3-offer-accent);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .hp3-timer-lbl {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: rgba(255,255,255,0.5);
    margin-top: 5px;
  }

  @media screen and (max-width: 900px) {
    .hp3-offer-banner {
      flex-direction: column;
      align-items: flex-start;
      padding: 40px;
      gap: 40px;
    }
  }

  @media screen and (max-width: 768px) {
    .hp3-tech-offer-{{ section.id }} {
      padding-top: var(--hp3-offer-pt-mob);
      padding-bottom: var(--hp3-offer-pb-mob);
    }
    .hp3-offer-inner {
      padding: 0 20px;
    }
    .hp3-offer-banner {
      padding: 30px 20px;
    }
    .hp3-offer-title {
      font-size: 28px;
    }
    .hp3-offer-desc {
      font-size: 16px;
    }
    .hp3-timer-box {
      width: 60px;
      height: 60px;
    }
    .hp3-timer-num {
      font-size: 24px;
    }
  }
</style>

<section class="hp3-tech-offer-{{ section.id }}" aria-label="Special Offer">
  <div class="hp3-offer-inner">
    
    <div class="hp3-offer-banner">
      <div class="hp3-offer-content">
        {%- if section.settings.badge != blank -%}
          <div class="hp3-offer-badge">{{ section.settings.badge }}</div>
        {%- endif -%}
        
        {%- if section.settings.heading != blank -%}
          <h2 class="hp3-offer-title">{{ section.settings.heading }}</h2>
        {%- endif -%}
        
        {%- if section.settings.description != blank -%}
          <p class="hp3-offer-desc">{{ section.settings.description }}</p>
        {%- endif -%}
        
        {%- if section.settings.btn_text != blank and section.settings.btn_link != blank -%}
          <a href="{{ section.settings.btn_link }}" class="hp3-offer-btn">
            {{ section.settings.btn_text }}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </a>
        {%- endif -%}
      </div>

      {%- if section.settings.show_timer -%}
        <div class="hp3-offer-timer" id="countdown-{{ section.id }}" data-date="{{ section.settings.end_date }}">
          <div class="hp3-timer-box">
            <span class="hp3-timer-num" id="cd-days-{{ section.id }}">00</span>
            <span class="hp3-timer-lbl">DAYS</span>
          </div>
          <div class="hp3-timer-box">
            <span class="hp3-timer-num" id="cd-hours-{{ section.id }}">00</span>
            <span class="hp3-timer-lbl">HRS</span>
          </div>
          <div class="hp3-timer-box">
            <span class="hp3-timer-num" id="cd-mins-{{ section.id }}">00</span>
            <span class="hp3-timer-lbl">MINS</span>
          </div>
          <div class="hp3-timer-box">
            <span class="hp3-timer-num" id="cd-secs-{{ section.id }}">00</span>
            <span class="hp3-timer-lbl">SECS</span>
          </div>
        </div>
      {%- endif -%}
    </div>

  </div>
</section>

{%- if section.settings.show_timer -%}
<script>
  document.addEventListener('DOMContentLoaded', function() {
    const countdownEl = document.getElementById('countdown-{{ section.id }}');
    if(!countdownEl) return;
    
    const targetDateStr = countdownEl.getAttribute('data-date');
    if(!targetDateStr) return;
    
    const targetDate = new Date(targetDateStr).getTime();
    
    const daysEl = document.getElementById('cd-days-{{ section.id }}');
    const hoursEl = document.getElementById('cd-hours-{{ section.id }}');
    const minsEl = document.getElementById('cd-mins-{{ section.id }}');
    const secsEl = document.getElementById('cd-secs-{{ section.id }}');
    
    const updateTimer = setInterval(() => {
      const now = new Date().getTime();
      const distance = targetDate - now;
      
      if (distance < 0) {
        clearInterval(updateTimer);
        countdownEl.style.display = 'none';
        return;
      }
      
      const days = Math.floor(distance / (1000 * 60 * 60 * 24));
      const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
      const seconds = Math.floor((distance % (1000 * 60)) / 1000);
      
      if(daysEl) daysEl.innerText = days < 10 ? '0' + days : days;
      if(hoursEl) hoursEl.innerText = hours < 10 ? '0' + hours : hours;
      if(minsEl) minsEl.innerText = minutes < 10 ? '0' + minutes : minutes;
      if(secsEl) secsEl.innerText = seconds < 10 ? '0' + seconds : seconds;
      
    }, 1000);
  });
</script>
{%- endif -%}

{% schema %}
{
  "name": "HP3 Tech Offer Banner",
  "tag": "section",
  "class": "section-hp3-offer",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "default": "LIMITED TIME"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "CYBER WEEKEND DEALS"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Up to 40% off selected peripherals and components. Upgrade your setup before time runs out."
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "SHOP THE SALE"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Countdown Timer"
    },
    {
      "type": "checkbox",
      "id": "show_timer",
      "label": "Show Timer",
      "default": true
    },
    {
      "type": "text",
      "id": "end_date",
      "label": "End Date",
      "info": "Format: YYYY-MM-DDTHH:MM:SS (e.g., 2024-12-31T23:59:59)",
      "default": "2024-12-31T23:59:59"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#050505"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#00ffcc"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Top (Desktop)", "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Bottom (Desktop)", "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Top (Mobile)", "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Bottom (Mobile)", "default": 40
    }
  ],
  "presets": [
    {
      "name": "HP3 Tech Offer Banner (Adv)",
      "category": "Promotional"
    }
  ]
}
{% endschema %}
