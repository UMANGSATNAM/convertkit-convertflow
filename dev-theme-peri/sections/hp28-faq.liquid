{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Chakra+Petch:ital,wght@0,300;0,400;0,600;0,700;1,400&family=Press+Start+2P&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --cyan: {{ section.settings.cyan_color }};
    --magenta: {{ section.settings.magenta_color }};
    --green: {{ section.settings.green_color }};
    
    --font-heading: 'Press Start 2P', cursive;
    --font-body: 'Chakra Petch', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    border-bottom: 2px dashed var(--cyan);
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.8 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.8 | round }}px;
    }
  }

  .hp28-faq-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp28-faq-wrapper {
      padding: 0 20px;
    }
  }

  .hp28-faq__header {
    text-align: center;
    margin-bottom: 50px;
  }

  .hp28-faq__title {
    font-family: var(--font-heading);
    font-size: clamp(20px, 3.5vw, {{ section.settings.title_size }}px);
    color: var(--green);
    text-shadow: 2px 2px 0 #000;
    margin: 0;
    text-transform: uppercase;
  }

  .hp28-faq__subtitle {
    font-family: var(--font-body);
    font-size: 16px;
    color: var(--text-color);
    margin: 15px 0 0;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .hp28-faq__container {
    background: #000;
    border: 3px solid var(--magenta);
    box-shadow: 10px 10px 0 var(--cyan);
    padding: 20px;
  }

  .hp28-faq__item {
    border-bottom: 2px dashed var(--text-color);
  }
  .hp28-faq__item:last-child {
    border-bottom: none;
  }

  .hp28-faq__question {
    width: 100%;
    text-align: left;
    background: transparent;
    border: none;
    color: var(--cyan);
    font-family: var(--font-heading);
    font-size: 12px;
    line-height: 1.5;
    padding: 25px 0;
    cursor: pointer;
    display: flex;
    align-items: center;
    text-transform: uppercase;
  }

  .hp28-faq__item.is-active .hp28-faq__question {
    color: var(--magenta);
  }

  .hp28-faq__icon {
    flex-shrink: 0;
    width: 20px;
    color: var(--green);
    margin-right: 15px;
    font-size: 16px;
  }

  .hp28-faq__answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }

  .hp28-faq__answer-inner {
    padding: 0 0 25px 35px;
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.6;
    color: var(--text-color);
    /* Simple glitch-in animation simulation */
    animation: none;
  }

  .hp28-faq__item.is-active .hp28-faq__answer-inner {
    animation: hp28TextReveal 0.4s steps(10, end);
  }

  @keyframes hp28TextReveal {
    0% { opacity: 0; transform: translateX(-10px); color: var(--magenta); }
    50% { opacity: 0.5; color: var(--cyan); }
    100% { opacity: 1; transform: translateX(0); color: var(--text-color); }
  }

  .hp28-faq__answer p {
    margin: 0 0 15px;
  }
  .hp28-faq__answer p:last-child {
    margin: 0;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp28-faq-wrapper" id="HP28Faq-{{ section.id }}">
  
  <div class="hp28-faq__header">
    {%- if section.settings.title != blank -%}
      <h2 class="hp28-faq__title">{{ section.settings.title }}</h2>
    {%- endif -%}
    {%- if section.settings.subtitle != blank -%}
      <p class="hp28-faq__subtitle">{{ section.settings.subtitle }}</p>
    {%- endif -%}
  </div>

  <div class="hp28-faq__container">
    {%- for block in section.blocks -%}
      <div class="hp28-faq__item" {{ block.shopify_attributes }}>
        <button class="hp28-faq__question" aria-expanded="false">
          <span class="hp28-faq__icon">[+]</span>
          {{ block.settings.question }}
        </button>
        <div class="hp28-faq__answer">
          <div class="hp28-faq__answer-inner">
            {{ block.settings.answer }}
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>

</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const items = document.querySelectorAll('#HP28Faq-{{ section.id }} .hp28-faq__item');
    
    items.forEach(item => {
      const btn = item.querySelector('.hp28-faq__question');
      const icon = item.querySelector('.hp28-faq__icon');
      const answer = item.querySelector('.hp28-faq__answer');
      
      btn.addEventListener('click', () => {
        const isActive = item.classList.contains('is-active');
        
        // Close all
        items.forEach(el => {
          el.classList.remove('is-active');
          el.querySelector('.hp28-faq__question').setAttribute('aria-expanded', 'false');
          el.querySelector('.hp28-faq__icon').textContent = '[+]';
          el.querySelector('.hp28-faq__answer').style.maxHeight = null;
        });

        if(!isActive) {
          item.classList.add('is-active');
          btn.setAttribute('aria-expanded', 'true');
          icon.textContent = '[-]';
          answer.style.maxHeight = answer.scrollHeight + "px";
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "HP28 - Y2K FAQ",
  "class": "section-hp28-faq",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "SYSTEM DIAGNOSTICS"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "FREQUENTLY ASKED QUERIES"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 600,
      "max": 1200,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 900
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 20,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 40
    },
    {
      "type": "header",
      "content": "Y2K Cyber Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (Deep Purple)",
      "default": "#1C0B2B"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Base Text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "cyan_color",
      "label": "Cyan Accent",
      "default": "#00FFFF"
    },
    {
      "type": "color",
      "id": "magenta_color",
      "label": "Magenta Accent",
      "default": "#FF00FF"
    },
    {
      "type": "color",
      "id": "green_color",
      "label": "Acid Green Accent",
      "default": "#39FF14"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "HOW DO I UPGRADE MY FIRMWARE?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Initiate the download sequence from the user portal. Ensure your connection is stable before applying patches.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP28 - Y2K FAQ",
      "blocks": [
        { "type": "faq" },
        { "type": "faq", "settings": { "question": "IS THE HARDWARE COMPATIBLE WITH OLDER SYSTEMS?", "answer": "<p>Legacy systems are supported via an external adapter. Please check the compatibility matrix before purchase.</p>" } },
        { "type": "faq", "settings": { "question": "WHAT HAPPENS IF THE CONNECTION FAILS?", "answer": "<p>Our systems automatically cache your progress and will resume once the network handshakes again.</p>" } }
      ]
    }
  ]
}
{% endschema %}
