{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#f7f4ed'
  assign text_color = section.settings.text_color | default: '#2b302a'
  assign accent_color = section.settings.accent_color | default: '#4a6741'
  assign heading = section.settings.heading | default: 'Frequently Asked Questions'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 100px 20px;
    color: {{ text_color }};
  }
  
  .hp7-faq-container-{{ section_id }} {
    max-width: 900px;
    margin: 0 auto;
  }
  
  .hp7-faq-header-{{ section_id }} {
    text-align: center;
    margin-bottom: 60px;
  }
  
  .hp7-faq-header-{{ section_id }} h2 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 500;
    margin: 0;
  }
  
  .hp7-faq-list-{{ section_id }} {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  
  .hp7-faq-item-{{ section_id }} {
    background-color: #ffffff;
    border-radius: 30px;
    overflow: hidden;
    transition: box-shadow 0.3s ease;
    border: 1px solid rgba(43, 48, 42, 0.05);
  }
  
  .hp7-faq-item-{{ section_id }}:hover {
    box-shadow: 0 10px 30px rgba(74, 103, 65, 0.05);
  }
  
  .hp7-faq-question-{{ section_id }} {
    width: 100%;
    text-align: left;
    background: none;
    border: none;
    padding: 25px 30px;
    font-family: 'DM Sans', sans-serif;
    font-size: 1.15rem;
    font-weight: 600;
    color: {{ text_color }};
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  .hp7-faq-icon-{{ section_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background-color: {{ bg_color }};
    color: {{ accent_color }};
    transition: all 0.4s ease;
  }
  
  .hp7-faq-icon-{{ section_id }} svg {
    width: 16px;
    height: 16px;
    transition: transform 0.4s ease;
  }
  
  .hp7-faq-item-{{ section_id }}.active .hp7-faq-icon-{{ section_id }} {
    background-color: {{ accent_color }};
    color: #fff;
  }
  
  .hp7-faq-item-{{ section_id }}.active .hp7-faq-icon-{{ section_id }} svg {
    transform: rotate(180deg);
  }
  
  .hp7-faq-answer-{{ section_id }} {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.5s cubic-bezier(0.25, 1, 0.5, 1);
  }
  
  .hp7-faq-item-{{ section_id }}.active .hp7-faq-answer-{{ section_id }} {
    max-height: 500px;
  }
  
  .hp7-faq-answer-inner-{{ section_id }} {
    padding: 0 30px 25px 30px;
    font-family: 'DM Sans', sans-serif;
    font-size: 1rem;
    line-height: 1.6;
    color: {{ text_color | color_modify: 'alpha', 0.75 }};
  }
  
  .hp7-faq-answer-inner-{{ section_id }} a {
    color: {{ accent_color }};
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  @media (max-width: 768px) {
    .hp7-faq-question-{{ section_id }} {
      padding: 20px;
      font-size: 1.05rem;
    }
    .hp7-faq-answer-inner-{{ section_id }} {
      padding: 0 20px 20px 20px;
    }
  }
</style>

<div class="hp7-faq-container-{{ section_id }}">
  {% if heading != blank %}
    <div class="hp7-faq-header-{{ section_id }}">
      <h2>{{ heading }}</h2>
    </div>
  {% endif %}
  
  <div class="hp7-faq-list-{{ section_id }}">
    {% for block in section.blocks %}
      <div class="hp7-faq-item-{{ section_id }}" {{ block.shopify_attributes }}>
        <button class="hp7-faq-question-{{ section_id }}" aria-expanded="false">
          {{ block.settings.question }}
          <span class="hp7-faq-icon-{{ section_id }}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </span>
        </button>
        <div class="hp7-faq-answer-{{ section_id }}">
          <div class="hp7-faq-answer-inner-{{ section_id }}">
            {{ block.settings.answer }}
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const faqItems = document.querySelectorAll('.hp7-faq-item-{{ section_id }}');
    
    faqItems.forEach(item => {
      const button = item.querySelector('.hp7-faq-question-{{ section_id }}');
      
      button.addEventListener('click', () => {
        const isActive = item.classList.contains('active');
        
        faqItems.forEach(otherItem => {
          otherItem.classList.remove('active');
          otherItem.querySelector('.hp7-faq-question-{{ section_id }}').setAttribute('aria-expanded', 'false');
        });
        
        if (!isActive) {
          item.classList.add('active');
          button.setAttribute('aria-expanded', 'true');
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "HP7 FAQ",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f7f4ed"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2b302a"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#4a6741"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Where are your products made?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>All of our products are ethically manufactured in certified sustainable facilities in Portugal and Vietnam. We ensure fair wages and safe working conditions for all workers.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP7 FAQ",
      "blocks": [
        { "type": "faq", "settings": { "question": "Are your materials 100% organic?" } },
        { "type": "faq", "settings": { "question": "What is your shipping policy?" } },
        { "type": "faq", "settings": { "question": "How do I care for my garments?" } }
      ]
    }
  ]
}
{% endschema %}
