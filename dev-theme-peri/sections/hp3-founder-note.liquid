{%- liquid
  assign bg_color = section.settings.bg_color | default: '#0a0a0a'
  assign text_color = section.settings.text_color | default: '#ffffff'
  assign accent_color = section.settings.accent_color | default: '#00ffcc'
  
  assign padding_top_desktop = section.settings.padding_top_desktop
  assign padding_bottom_desktop = section.settings.padding_bottom_desktop
  assign padding_top_mobile = section.settings.padding_top_mobile
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile
-%}

<style>
  #shopify-section-{{ section.id }} {
    --hp3-fn-bg: {{ bg_color }};
    --hp3-fn-text: {{ text_color }};
    --hp3-fn-accent: {{ accent_color }};
    
    --hp3-fn-pt-desk: {{ padding_top_desktop }}px;
    --hp3-fn-pb-desk: {{ padding_bottom_desktop }}px;
    --hp3-fn-pt-mob: {{ padding_top_mobile }}px;
    --hp3-fn-pb-mob: {{ padding_bottom_mobile }}px;
  }

  .hp3-tech-founder-{{ section.id }} {
    padding-top: var(--hp3-fn-pt-desk);
    padding-bottom: var(--hp3-fn-pb-desk);
    background-color: var(--hp3-fn-bg);
    color: var(--hp3-fn-text);
    font-family: 'Inter', sans-serif;
  }

  .hp3-fn-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    align-items: center;
    gap: 80px;
  }

  /* Image Column */
  .hp3-fn-img-col {
    flex: 1;
    position: relative;
  }
  
  .hp3-fn-img-wrapper {
    width: 100%;
    aspect-ratio: 3/4;
    background: #111;
    border-radius: 12px;
    overflow: hidden;
    position: relative;
    border: 1px solid rgba(255,255,255,0.1);
  }
  
  /* Cyber scanline over image */
  .hp3-fn-img-wrapper::after {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: linear-gradient(rgba(0, 255, 204, 0.1) 1px, transparent 1px);
    background-size: 100% 4px;
    pointer-events: none;
    opacity: 0.5;
  }

  .hp3-fn-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: contrast(1.2) grayscale({{ section.settings.grayscale }}%);
  }

  /* Decorative tech frame */
  .hp3-fn-frame {
    position: absolute;
    inset: -10px;
    border: 2px solid var(--hp3-fn-accent);
    z-index: 0;
    pointer-events: none;
    clip-path: polygon(0 0, 30% 0, 30% 2px, 2px 2px, 2px 30%, 0 30%, 0 100%, 2px 100%, 2px 70%, 30% 70%, 30% 100%, 100% 100%, 100% 70%, 98% 70%, 98% 98%, 70% 98%, 70% 100%, 0 100%);
  }

  /* Text Column */
  .hp3-fn-txt-col {
    flex: 1;
    display: flex;
    flex-direction: column;
    position: relative;
    z-index: 2;
  }

  .hp3-fn-badge {
    display: inline-block;
    padding: 4px 10px;
    background: rgba(255,255,255,0.1);
    border: 1px solid rgba(255,255,255,0.2);
    font-size: 10px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 20px;
    align-self: flex-start;
  }

  .hp3-fn-title {
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 900;
    line-height: 1.1;
    margin: 0 0 30px 0;
    letter-spacing: -1px;
  }
  .hp3-fn-title span {
    color: var(--hp3-fn-accent);
  }

  .hp3-fn-desc {
    font-size: 16px;
    line-height: 1.6;
    color: rgba(255,255,255,0.7);
    margin-bottom: 40px;
    position: relative;
    padding-left: 20px;
    border-left: 2px solid var(--hp3-fn-accent);
  }
  .hp3-fn-desc p { margin-top: 0; }
  .hp3-fn-desc p:last-child { margin-bottom: 0; }

  .hp3-fn-profile {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  
  .hp3-fn-name-wrap {
    display: flex;
    flex-direction: column;
  }

  .hp3-fn-name {
    font-size: 18px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin: 0 0 5px 0;
  }

  .hp3-fn-role {
    font-size: 12px;
    color: var(--hp3-fn-accent);
    text-transform: uppercase;
    letter-spacing: 2px;
  }

  .hp3-fn-signature {
    width: 120px;
    height: auto;
    filter: invert(1);
    opacity: 0.8;
  }

  @media screen and (max-width: 900px) {
    .hp3-fn-inner {
      flex-direction: column;
      gap: 50px;
    }
    .hp3-fn-img-col, .hp3-fn-txt-col {
      width: 100%;
    }
    .hp3-fn-frame {
      display: none; /* Hide complex frame on mobile */
    }
  }

  @media screen and (max-width: 768px) {
    .hp3-tech-founder-{{ section.id }} {
      padding-top: var(--hp3-fn-pt-mob);
      padding-bottom: var(--hp3-fn-pb-mob);
    }
    .hp3-fn-inner {
      padding: 0 20px;
    }
    .hp3-fn-desc {
      font-size: 14px;
    }
  }
</style>

<section class="hp3-tech-founder-{{ section.id }}" aria-label="Founder Message">
  <div class="hp3-fn-inner">
    
    <div class="hp3-fn-img-col">
      <div class="hp3-fn-frame"></div>
      <div class="hp3-fn-img-wrapper">
        {%- if section.settings.image != blank -%}
          <img height="{{ section.settings.image.height }}" width="{{ section.settings.image.width }}" src="{{ section.settings.image | image_url: width: 800 }}" 
               class="hp3-fn-img" 
               loading="lazy" 
               alt="{{ section.settings.image.alt | default: 'Founder' }}">
        {%- else -%}
          {{ 'portrait-2' | placeholder_svg_tag: 'hp3-fn-img placeholder-svg' }}
        {%- endif -%}
      </div>
    </div>

    <div class="hp3-fn-txt-col">
      <div class="hp3-fn-badge">LOG ENTRIES</div>
      
      {%- if section.settings.heading != blank -%}
        <h2 class="hp3-fn-title">{{ section.settings.heading }}</h2>
      {%- endif -%}
      
      {%- if section.settings.description != blank -%}
        <div class="hp3-fn-desc">{{ section.settings.description }}</div>
      {%- endif -%}
      
      <div class="hp3-fn-profile">
        <div class="hp3-fn-name-wrap">
          <h3 class="hp3-fn-name">{{ section.settings.name | default: 'J.D. ARCHITECT' }}</h3>
          <span class="hp3-fn-role">{{ section.settings.role | default: 'LEAD ENGINEER / FOUNDER' }}</span>
        </div>
        
        {%- if section.settings.signature_image != blank -%}
          <img height="{{ section.settings.signature_image.height }}" width="{{ section.settings.signature_image.width }}" src="{{ section.settings.signature_image | image_url: width: 240 }}" 
               class="hp3-fn-signature" 
               loading="lazy" 
               alt="Signature">
        {%- endif -%}
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "HP3 Tech Founder",
  "tag": "section",
  "class": "section-hp3-founder",
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Portrait Image"
    },
    {
      "type": "range",
      "id": "grayscale",
      "min": 0, "max": 100, "step": 10, "unit": "%",
      "label": "Image Grayscale",
      "default": 100
    },
    {
      "type": "image_picker",
      "id": "signature_image",
      "label": "Signature Image (Optional)"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "ENGINEERED FOR <span>PERFECTION.</span>",
      "info": "Use <span> for accent color"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Message",
      "default": "<p>When we started, the industry was stagnant. We decided to build hardware that doesn't just meet expectations, but shatters them. Every component, every line of code, designed to elevate your workflow.</p>"
    },
    {
      "type": "text",
      "id": "name",
      "label": "Name",
      "default": "J.D. ARCHITECT"
    },
    {
      "type": "text",
      "id": "role",
      "label": "Role",
      "default": "LEAD ENGINEER"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#0a0a0a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#00ffcc"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Top (Desktop)", "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Bottom (Desktop)", "default": 120
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Top (Mobile)", "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Bottom (Mobile)", "default": 60
    }
  ],
  "presets": [
    {
      "name": "HP3 Tech Founder (Adv)",
      "category": "Text"
    }
  ]
}
{% endschema %}
