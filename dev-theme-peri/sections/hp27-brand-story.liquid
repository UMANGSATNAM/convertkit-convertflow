{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600&family=Syncopate:wght@400;700&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --font-heading: 'Syncopate', sans-serif;
    --font-body: 'Space Grotesk', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    position: relative;
    overflow: hidden;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.8 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.8 | round }}px;
    }
  }

  .hp27-story-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    align-items: center;
    gap: 80px;
  }

  @media screen and (max-width: 992px) {
    .hp27-story-wrapper {
      flex-direction: column;
      gap: 50px;
    }
  }

  @media screen and (max-width: 768px) {
    .hp27-story-wrapper {
      padding: 0 20px;
    }
  }

  /* Reversed layout option */
  {%- if section.settings.layout == 'right' -%}
    .hp27-story-wrapper {
      flex-direction: row-reverse;
    }
    @media screen and (max-width: 992px) {
      .hp27-story-wrapper {
        flex-direction: column;
      }
    }
  {%- endif -%}

  .hp27-story__image-col {
    flex: 1;
    position: relative;
  }

  .hp27-story__image-wrapper {
    position: relative;
    aspect-ratio: 4/5;
    background: #111;
    overflow: hidden;
    border: 1px solid rgba(226, 226, 226, 0.1);
  }

  /* Scanline effect */
  .hp27-story__image-wrapper::after {
    content: '';
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background: linear-gradient(
      to bottom,
      transparent 50%,
      rgba(0, 0, 0, 0.2) 51%
    );
    background-size: 100% 4px;
    pointer-events: none;
    z-index: 2;
  }

  /* Corner brackets */
  .hp27-story__brackets {
    position: absolute;
    top: -10px; left: -10px; right: -10px; bottom: -10px;
    pointer-events: none;
    z-index: 3;
  }
  .hp27-story__brackets::before,
  .hp27-story__brackets::after {
    content: '';
    position: absolute;
    width: 20px; height: 20px;
    border: 2px solid var(--accent-color);
  }
  .hp27-story__brackets::before {
    top: 0; left: 0;
    border-right: none; border-bottom: none;
  }
  .hp27-story__brackets::after {
    bottom: 0; right: 0;
    border-left: none; border-top: none;
  }

  .hp27-story__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%) contrast(1.1);
    transition: filter 0.5s ease, transform 1s ease;
  }

  .hp27-story__image-wrapper:hover .hp27-story__image {
    filter: grayscale(0%) contrast(1);
    transform: scale(1.05);
  }

  .hp27-story__text-col {
    flex: 1;
    max-width: 500px;
  }

  .hp27-story__label {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent-color);
    margin-bottom: 20px;
    padding-bottom: 5px;
    border-bottom: 1px solid var(--accent-color);
  }

  .hp27-story__title {
    font-family: var(--font-heading);
    font-size: clamp(28px, 4vw, {{ section.settings.title_size }}px);
    font-weight: 700;
    line-height: 1.1;
    color: var(--text-color);
    margin: 0 0 30px;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }

  .hp27-story__text {
    font-family: var(--font-body);
    font-size: clamp(14px, 1.5vw, 16px);
    font-weight: 300;
    line-height: 1.7;
    color: var(--text-color);
    opacity: 0.7;
    margin: 0 0 40px;
  }

  /* Data read-out style stats */
  .hp27-story__stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 40px;
    padding-top: 20px;
    border-top: 1px solid rgba(226, 226, 226, 0.1);
  }

  .hp27-story__stat-num {
    font-family: var(--font-heading);
    font-size: 24px;
    font-weight: 700;
    color: var(--text-color);
    margin-bottom: 5px;
  }
  
  .hp27-story__stat-label {
    font-family: var(--font-body);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-color);
    opacity: 0.5;
  }

  .hp27-story__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 28px;
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--bg-color);
    background: var(--text-color);
    transition: all 0.3s ease;
    border-radius: 0;
  }

  .hp27-story__btn:hover {
    background: var(--accent-color);
    color: #fff;
    box-shadow: 0 0 15px rgba(255, 42, 42, 0.4);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp27-story-wrapper" id="HP27Story-{{ section.id }}">
  
  <div class="hp27-story__image-col">
    <div class="hp27-story__brackets"></div>
    <div class="hp27-story__image-wrapper">
      {%- if section.settings.image != blank -%}
        <img height="{{ section.settings.image.height }}" width="{{ section.settings.image.width }}" src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.title | escape }}" class="hp27-story__image" loading="lazy">
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'hp27-story__image' }}
      {%- endif -%}
    </div>
  </div>

  <div class="hp27-story__text-col">
    {%- if section.settings.label != blank -%}
      <div class="hp27-story__label">{{ section.settings.label }}</div>
    {%- endif -%}

    {%- if section.settings.title != blank -%}
      <h2 class="hp27-story__title">{{ section.settings.title }}</h2>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="hp27-story__text">{{ section.settings.text }}</div>
    {%- endif -%}

    <div class="hp27-story__stats">
      {%- if section.settings.stat_1_num != blank -%}
        <div>
          <div class="hp27-story__stat-num">{{ section.settings.stat_1_num }}</div>
          <div class="hp27-story__stat-label">{{ section.settings.stat_1_label }}</div>
        </div>
      {%- endif -%}
      {%- if section.settings.stat_2_num != blank -%}
        <div>
          <div class="hp27-story__stat-num">{{ section.settings.stat_2_num }}</div>
          <div class="hp27-story__stat-label">{{ section.settings.stat_2_label }}</div>
        </div>
      {%- endif -%}
    </div>

    {%- if section.settings.btn_text != blank -%}
      <a href="{{ section.settings.btn_link | default: '#' }}" class="hp27-story__btn">
        {{ section.settings.btn_text }}
      </a>
    {%- endif -%}
  </div>

</div>

{% schema %}
{
  "name": "HP27 - Eng Brand Story",
  "class": "section-hp27-brand-story",
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Image Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Small Label",
      "default": "DATA.LOG_01"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "UNCOMPROMISING\nARCHITECTURE"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>We build systems for the modern era. Utilizing aerospace grade materials and sub-millimeter precision, every component is rigorously tested to ensure absolute reliability in any environment.</p>"
    },
    {
      "type": "text",
      "id": "stat_1_num",
      "label": "Stat 1 Number",
      "default": "0.1mm"
    },
    {
      "type": "text",
      "id": "stat_1_label",
      "label": "Stat 1 Label",
      "default": "TOLERANCE"
    },
    {
      "type": "text",
      "id": "stat_2_num",
      "label": "Stat 2 Number",
      "default": "40+"
    },
    {
      "type": "text",
      "id": "stat_2_label",
      "label": "Stat 2 Label",
      "default": "TEST CYCLES"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "READ SPECIFICATIONS"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1400
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 32,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 48
    },
    {
      "type": "header",
      "content": "Dark Engineered Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#0A0A0A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#E2E2E2"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#FF2A2A"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 100
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP27 - Eng Brand Story"
    }
  ]
}
{% endschema %}
