{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Montserrat:wght@300;400;500&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --gold-color: {{ section.settings.gold_color }};
    
    --font-heading: 'Playfair Display', serif;
    --font-body: 'Montserrat', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    border-bottom: 1px solid rgba(212, 175, 55, 0.2);
  }

  .hp33-feat-wrapper {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp33-feat-wrapper {
      padding: 0 20px;
    }
  }

  .hp33-feat__header {
    text-align: center;
    margin-bottom: 60px;
  }

  .hp33-feat__subtitle {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    color: var(--gold-color);
    text-transform: uppercase;
    letter-spacing: 4px;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 15px;
  }

  .hp33-feat__subtitle::before,
  .hp33-feat__subtitle::after {
    content: '';
    height: 1px;
    width: 30px;
    background: var(--gold-color);
  }

  .hp33-feat__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    line-height: 1.1;
    color: var(--text-color);
    margin: 0;
    font-weight: 400;
  }

  .hp33-feat__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: 40px;
  }

  @media screen and (max-width: 992px) {
    .hp33-feat__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 30px;
    }
  }

  @media screen and (max-width: 576px) {
    .hp33-feat__grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }

  .hp33-feat__card {
    text-decoration: none;
    display: block;
    group: card;
  }

  .hp33-feat__image-wrap {
    position: relative;
    aspect-ratio: 3/4;
    overflow: hidden;
    margin-bottom: 25px;
    background: rgba(255,255,255,0.05);
  }

  /* Ornate frame that appears on hover */
  .hp33-feat__frame {
    position: absolute;
    top: 15px; left: 15px; right: 15px; bottom: 15px;
    border: 1px solid rgba(212, 175, 55, 0);
    z-index: 2;
    pointer-events: none;
    transition: all 0.4s ease;
  }

  .hp33-feat__card:hover .hp33-feat__frame {
    border-color: rgba(212, 175, 55, 0.8);
    top: 10px; left: 10px; right: 10px; bottom: 10px;
  }

  .hp33-feat__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s ease;
  }

  .hp33-feat__card:hover .hp33-feat__image {
    transform: scale(1.05);
  }

  .hp33-feat__quick-add {
    position: absolute;
    bottom: -50px; left: 0; right: 0;
    background: var(--gold-color);
    color: #000;
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    text-align: center;
    padding: 15px 0;
    text-transform: uppercase;
    letter-spacing: 2px;
    transition: bottom 0.4s ease;
    z-index: 3;
  }

  .hp33-feat__card:hover .hp33-feat__quick-add {
    bottom: 0;
  }

  .hp33-feat__info {
    text-align: center;
  }

  .hp33-feat__product-title {
    font-family: var(--font-heading);
    font-size: 22px;
    color: var(--text-color);
    margin: 0 0 10px;
    font-weight: 400;
  }

  .hp33-feat__product-price {
    font-family: var(--font-body);
    font-size: 15px;
    color: var(--gold-color);
    font-weight: 300;
    letter-spacing: 1px;
  }

  .hp33-feat__view-all {
    display: table;
    margin: 60px auto 0;
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    color: var(--text-color);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 2px;
    padding: 16px 40px;
    border: 1px solid var(--gold-color);
    position: relative;
    overflow: hidden;
    transition: all 0.4s ease;
  }

  .hp33-feat__view-all::before {
    content: '';
    position: absolute;
    top: 4px; left: 4px; right: 4px; bottom: 4px;
    border: 1px solid rgba(212, 175, 55, 0.3);
    transition: all 0.4s ease;
  }

  .hp33-feat__view-all:hover {
    background: var(--gold-color);
    color: #000;
  }

  .hp33-feat__view-all:hover::before {
    border-color: #000;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp33-feat-wrapper" id="HP33Feat-{{ section.id }}">
  <div class="hp33-feat__header">
    {%- if section.settings.subtitle != blank -%}
      <div class="hp33-feat__subtitle">{{ section.settings.subtitle }}</div>
    {%- endif -%}
    <h2 class="hp33-feat__title">{{ section.settings.title }}</h2>
  </div>

  <div class="hp33-feat__grid">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.product_link | default: '#' }}" class="hp33-feat__card" {{ block.shopify_attributes }}>
        <div class="hp33-feat__image-wrap">
          <div class="hp33-feat__frame"></div>
          {%- if block.settings.image != blank -%}
            <img height="{{ block.settings.image.height }}" width="{{ block.settings.image.width }}" src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title | escape }}" class="hp33-feat__image" loading="lazy">
          {%- else -%}
            {%- assign placeholder = 'product-' | append: forloop.index -%}
            {%- if forloop.index > 6 -%}{%- assign placeholder = 'product-1' -%}{%- endif -%}
            {{ placeholder | placeholder_svg_tag: 'hp33-feat__image' }}
          {%- endif -%}
          <div class="hp33-feat__quick-add">View Details</div>
        </div>
        <div class="hp33-feat__info">
          <h3 class="hp33-feat__product-title">{{ block.settings.title }}</h3>
          <div class="hp33-feat__product-price">{{ block.settings.price }}</div>
        </div>
      </a>
    {%- endfor -%}
  </div>

  {%- if section.settings.btn_label != blank -%}
    <a href="{{ section.settings.btn_link | default: '#' }}" class="hp33-feat__view-all">
      {{ section.settings.btn_label }}
    </a>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "HP33 - Deco Collection",
  "class": "section-hp33-featured-collection",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "CURATED SELECTION"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Featured Acquisitions"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "VIEW FULL COLLECTION"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns (Desktop)",
      "default": 3
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 30,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 48
    },
    {
      "type": "header",
      "content": "Deco Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (e.g. Deep Emerald)",
      "default": "#0e1a14"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "gold_color",
      "label": "Gold Accent",
      "default": "#d4af37"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 100
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Product Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "The Heritage Watch"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "$1,250"
        },
        {
          "type": "url",
          "id": "product_link",
          "label": "Product Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP33 - Deco Collection",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
