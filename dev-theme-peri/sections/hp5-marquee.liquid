{%- liquid
  assign bg_color = section.settings.bg_color | default: '#0066cc'
  assign text_color = section.settings.text_color | default: '#ffffff'
  assign speed = section.settings.speed | default: 20
-%}

<style>
  #shopify-section-{{ section.id }} {
    --hp5-mq-bg: {{ bg_color }};
    --hp5-mq-text: {{ text_color }};
    --hp5-mq-speed: {{ speed }}s;
  }

  .hp5-health-marquee-{{ section.id }} {
    background-color: var(--hp5-mq-bg);
    color: var(--hp5-mq-text);
    padding: 15px 0;
    overflow: hidden;
    display: flex;
    white-space: nowrap;
    position: relative;
    font-family: 'Inter', sans-serif;
  }

  /* Fade Edges */
  .hp5-health-marquee-{{ section.id }}::before,
  .hp5-health-marquee-{{ section.id }}::after {
    content: '';
    position: absolute;
    top: 0; bottom: 0;
    width: 100px;
    z-index: 2;
    pointer-events: none;
  }
  .hp5-health-marquee-{{ section.id }}::before {
    left: 0;
    background: linear-gradient(to right, var(--hp5-mq-bg), transparent);
  }
  .hp5-health-marquee-{{ section.id }}::after {
    right: 0;
    background: linear-gradient(to left, var(--hp5-mq-bg), transparent);
  }

  .hp5-mq-track {
    display: inline-flex;
    align-items: center;
    animation: hp5Marquee var(--hp5-mq-speed) linear infinite;
  }

  .hp5-mq-item {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 0 30px;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .hp5-mq-icon {
    width: 20px; height: 20px;
    fill: currentColor;
    opacity: 0.8;
  }
  .hp5-mq-icon svg {
    width: 100%; height: 100%;
  }

  @keyframes hp5Marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  @media screen and (max-width: 768px) {
    .hp5-health-marquee-{{ section.id }} {
      padding: 12px 0;
    }
    .hp5-mq-item {
      font-size: 12px;
      padding: 0 20px;
    }
    .hp5-mq-icon {
      width: 16px; height: 16px;
    }
  }
</style>

<section class="hp5-health-marquee-{{ section.id }}" aria-label="Benefits Marquee">
  <div class="hp5-mq-track">
    {%- for i in (1..3) -%}
      {%- for block in section.blocks -%}
        <div class="hp5-mq-item" {{ block.shopify_attributes }}>
          {%- if block.settings.icon == 'shield' -%}
            <span class="hp5-mq-icon"><svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></span>
          {%- elsif block.settings.icon == 'heart' -%}
            <span class="hp5-mq-icon"><svg viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg></span>
          {%- elsif block.settings.icon == 'leaf' -%}
            <span class="hp5-mq-icon"><svg viewBox="0 0 24 24"><path d="M11 20A7 7 0 0 1 4 13c0-3.86 3.14-7 7-7h1a7 7 0 0 1 7 7c0 3.86-3.14 7-7 7v0z"/></svg></span>
          {%- elsif block.settings.icon == 'check' -%}
            <span class="hp5-mq-icon"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>
          {%- endif -%}
          {{ block.settings.text }}
        </div>
      {%- endfor -%}
      {%- if section.blocks.size == 0 -%}
        <div class="hp5-mq-item"><span class="hp5-mq-icon"><svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></span> CLINICALLY PROVEN</div>
        <div class="hp5-mq-item"><span class="hp5-mq-icon"><svg viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg></span> DOCTOR FORMULATED</div>
        <div class="hp5-mq-item"><span class="hp5-mq-icon"><svg viewBox="0 0 24 24"><path d="M11 20A7 7 0 0 1 4 13c0-3.86 3.14-7 7-7h1a7 7 0 0 1 7 7c0 3.86-3.14 7-7 7v0z"/></svg></span> 100% NATURAL</div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "HP5 Health Marquee",
  "tag": "section",
  "class": "section-hp5-marquee",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#0066cc"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 10, "max": 50, "step": 2, "unit": "sec",
      "label": "Animation Speed",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Benefit Text",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "CLINICALLY PROVEN"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shield", "label": "Shield" },
            { "value": "heart", "label": "Heart" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "check", "label": "Check" },
            { "value": "none", "label": "None" }
          ],
          "default": "check"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP5 Health Marquee",
      "category": "Text",
      "blocks": [
        { "type": "text", "settings": { "text": "CLINICALLY PROVEN", "icon": "shield" } },
        { "type": "text", "settings": { "text": "DOCTOR FORMULATED", "icon": "heart" } },
        { "type": "text", "settings": { "text": "NO ARTIFICIAL FILLERS", "icon": "leaf" } }
      ]
    }
  ]
}
{% endschema %}
