{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#4a6741'
  assign text_color = section.settings.text_color | default: '#f7f4ed'
  assign highlight_color = section.settings.highlight_color | default: '#e8ecd6'
  assign heading = section.settings.heading | default: 'Less Impact, More Savings'
  assign subtext = section.settings.subtext | default: 'Enjoy 15% off your first order of sustainable essentials.'
  assign button_text = section.settings.button_text | default: 'Claim Offer'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    color: {{ text_color }};
    padding: 80px 20px;
    position: relative;
    overflow: hidden;
  }
  
  .hp7-offer-container-{{ section_id }} {
    max-width: 1200px;
    margin: 0 auto;
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 60px;
    padding: 80px 40px;
    text-align: center;
    position: relative;
    z-index: 2;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  
  .hp7-offer-heading-{{ section_id }} {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    font-weight: 400;
    margin: 0 0 20px 0;
    line-height: 1.1;
  }
  
  .hp7-offer-heading-{{ section_id }} em {
    font-style: italic;
    color: {{ highlight_color }};
  }
  
  .hp7-offer-subtext-{{ section_id }} {
    font-family: 'DM Sans', sans-serif;
    font-size: clamp(1.1rem, 2vw, 1.25rem);
    margin: 0 auto 40px auto;
    max-width: 600px;
    opacity: 0.9;
    line-height: 1.6;
  }
  
  .hp7-offer-btn-{{ section_id }} {
    display: inline-block;
    background-color: {{ highlight_color }};
    color: {{ bg_color }};
    font-family: 'DM Sans', sans-serif;
    font-size: 1.1rem;
    font-weight: 700;
    padding: 18px 50px;
    border-radius: 40px;
    text-decoration: none;
    transition: all 0.3s ease;
  }
  
  .hp7-offer-btn-{{ section_id }}:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 20px rgba(0,0,0,0.1);
    background-color: #ffffff;
  }

  /* Decorative floating elements */
  .hp7-offer-shape-{{ section_id }} {
    position: absolute;
    background: {{ highlight_color }};
    border-radius: 50%;
    opacity: 0.05;
    z-index: 1;
  }
  
  .hp7-shape-1-{{ section_id }} {
    width: 400px;
    height: 400px;
    top: -100px;
    left: -100px;
  }
  
  .hp7-shape-2-{{ section_id }} {
    width: 600px;
    height: 600px;
    bottom: -200px;
    right: -100px;
  }
  
  .hp7-shape-3-{{ section_id }} {
    width: 200px;
    height: 200px;
    top: 50%;
    left: 20%;
    opacity: 0.03;
  }

  @media (max-width: 768px) {
    .hp7-offer-container-{{ section_id }} {
      padding: 50px 20px;
      border-radius: 40px;
    }
    #shopify-section-{{ section_id }} {
      padding: 40px 15px;
    }
  }
</style>

<div class="hp7-offer-shape-{{ section_id }} hp7-shape-1-{{ section_id }}"></div>
<div class="hp7-offer-shape-{{ section_id }} hp7-shape-2-{{ section_id }}"></div>
<div class="hp7-offer-shape-{{ section_id }} hp7-shape-3-{{ section_id }}"></div>

<div class="hp7-offer-container-{{ section_id }}">
  <h2 class="hp7-offer-heading-{{ section_id }}">{{ heading | replace: 'Impact', '<em>Impact</em>' | replace: 'Savings', '<em>Savings</em>' }}</h2>
  <p class="hp7-offer-subtext-{{ section_id }}">{{ subtext }}</p>
  <a href="#" class="hp7-offer-btn-{{ section_id }}">{{ button_text }}</a>
</div>

{% schema %}
{
  "name": "HP7 Offer Banner",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#4a6741"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#f7f4ed"
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "Highlight Color",
      "default": "#e8ecd6"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Less Impact, More Savings"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Enjoy 15% off your first order of sustainable essentials."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Claim Offer"
    }
  ],
  "presets": [
    {
      "name": "HP7 Offer Banner"
    }
  ]
}
{% endschema %}
