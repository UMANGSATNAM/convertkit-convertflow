{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,100..900;1,9..144,100..900&family=Outfit:wght@300;400;600;800&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-orange: {{ section.settings.accent_orange }};
    --accent-yellow: {{ section.settings.accent_yellow }};
    --accent-green: {{ section.settings.accent_green }};
    --font-heading: 'Fraunces', serif;
    --font-body: 'Outfit', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    position: relative;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.03'/%3E%3C/svg%3E");
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }

  .hp25-featured-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
    position: relative;
    z-index: 1;
  }

  @media screen and (max-width: 768px) {
    .hp25-featured-wrapper {
      padding: 0 20px;
    }
  }

  .hp25-featured__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: {{ section.settings.header_margin }}px;
    border-bottom: 4px solid var(--text-color);
    padding-bottom: 15px;
  }

  @media screen and (max-width: 768px) {
    .hp25-featured__header {
      flex-direction: column;
      align-items: flex-start;
      gap: 15px;
    }
  }

  .hp25-featured__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    font-weight: 900;
    font-style: italic;
    color: var(--text-color);
    margin: 0;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .hp25-featured__view-all {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 800;
    color: var(--text-color);
    text-transform: uppercase;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--accent-yellow);
    padding: 8px 20px;
    border: 2px solid var(--text-color);
    border-radius: 50px;
    box-shadow: 2px 2px 0 var(--text-color);
    transition: all 0.3s ease;
  }

  .hp25-featured__view-all:hover {
    transform: translate(2px, 2px);
    box-shadow: 0 0 0 var(--text-color);
    background: var(--accent-orange);
    color: var(--bg-color);
  }

  .hp25-featured__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: 30px;
  }

  @media screen and (max-width: 992px) {
    .hp25-featured__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 600px) {
    .hp25-featured__grid {
      display: flex;
      flex-wrap: nowrap;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-bottom: 20px;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .hp25-featured__grid::-webkit-scrollbar {
      display: none;
    }
  }

  /* 70s Product Card */
  .hp25-product-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    background: var(--bg-color);
    border: 3px solid var(--text-color);
    border-radius: 20px;
    padding: 15px;
    transition: all 0.3s ease;
    box-shadow: 6px 6px 0 var(--accent-orange);
  }

  @media screen and (max-width: 600px) {
    .hp25-product-card {
      flex: 0 0 80%;
      scroll-snap-align: center;
    }
  }

  .hp25-product-card:hover {
    transform: translateY(-5px);
    box-shadow: 10px 10px 0 var(--accent-green);
  }

  .hp25-product-card__image-wrapper {
    width: 100%;
    aspect-ratio: {{ section.settings.image_aspect_ratio }};
    overflow: hidden;
    /* Groovy Arch shape for images */
    border-radius: 100px 100px 10px 10px;
    border: 2px solid var(--text-color);
    margin-bottom: 20px;
    background-color: var(--accent-yellow);
    position: relative;
  }

  .hp25-product-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease, filter 0.3s ease;
    filter: sepia(0.2) contrast(1.1);
  }

  .hp25-product-card:hover .hp25-product-card__image {
    transform: scale(1.05);
    filter: none;
  }

  .hp25-product-card__badge {
    position: absolute;
    top: 15px;
    left: 15px;
    background: var(--text-color);
    color: var(--bg-color);
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 800;
    padding: 5px 12px;
    border-radius: 50px;
    text-transform: uppercase;
    letter-spacing: 1px;
    z-index: 2;
    transform: rotate(-5deg);
  }

  .hp25-product-card__info {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    text-align: center;
  }

  .hp25-product-card__title {
    font-family: var(--font-heading);
    font-size: 22px;
    font-weight: 700;
    color: var(--text-color);
    margin: 0 0 10px;
    line-height: 1.2;
  }

  .hp25-product-card__price-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 10px;
    margin-top: auto;
    margin-bottom: 15px;
  }

  .hp25-product-card__price {
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 800;
    color: var(--accent-orange);
  }

  .hp25-product-card__price--compare {
    font-size: 14px;
    color: var(--text-color);
    opacity: 0.6;
    text-decoration: line-through;
  }

  .hp25-product-card__add-btn {
    display: block;
    width: 100%;
    padding: 12px;
    background-color: var(--text-color);
    color: var(--bg-color);
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 800;
    text-transform: uppercase;
    border: 2px solid var(--text-color);
    border-radius: 50px;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .hp25-product-card:hover .hp25-product-card__add-btn {
    background-color: var(--accent-green);
    color: var(--bg-color);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp25-featured-wrapper" id="HP25Featured-{{ section.id }}">
  <div class="hp25-featured__header">
    {%- if section.settings.title != blank -%}
      <h2 class="hp25-featured__title">{{ section.settings.title }}</h2>
    {%- endif -%}
    
    {%- if section.settings.show_view_all and section.settings.collection != blank -%}
      <a href="{{ section.settings.collection.url }}" class="hp25-featured__view-all">
        {{ 'See All Threads' | escape }}
      </a>
    {%- endif -%}
  </div>

  <div class="hp25-featured__grid">
    {%- assign collection = section.settings.collection -%}
    {%- assign limit = section.settings.limit -%}
    
    {%- if collection != blank and collection.products_count > 0 -%}
      {%- for product in collection.products limit: limit -%}
        <a href="{{ product.url }}" class="hp25-product-card" {{ block.shopify_attributes }}>
          
          <div class="hp25-product-card__image-wrapper">
            {%- if product.compare_at_price > product.price -%}
              <div class="hp25-product-card__badge">FAR OUT DEAL</div>
            {%- endif -%}
            
            <img 
              src="{{ product.featured_image | image_url: width: 600 }}" 
              alt="{{ product.title | escape }}"
              class="hp25-product-card__image"
              loading="lazy"
            >
          </div>

          <div class="hp25-product-card__info">
            <h3 class="hp25-product-card__title">{{ product.title }}</h3>
            
            <div class="hp25-product-card__price-wrapper">
              <span class="hp25-product-card__price">{{ product.price | money }}</span>
              {%- if product.compare_at_price > product.price -%}
                <span class="hp25-product-card__price--compare">{{ product.compare_at_price | money }}</span>
              {%- endif -%}
            </div>
            
            <button class="hp25-product-card__add-btn" tabindex="-1">DIG IT</button>
          </div>
        </a>
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..limit) -%}
        <a href="#" class="hp25-product-card">
          <div class="hp25-product-card__image-wrapper">
            <div class="hp25-product-card__badge">FAR OUT</div>
            <div style="width:100%;height:100%;background:var(--accent-yellow);display:flex;align-items:center;justify-content:center;font-family:var(--font-heading);font-style:italic;color:var(--text-color);">PHOTO</div>
          </div>
          <div class="hp25-product-card__info">
            <h3 class="hp25-product-card__title">Vintage Bell Bottoms</h3>
            <div class="hp25-product-card__price-wrapper">
              <span class="hp25-product-card__price">$75.00</span>
            </div>
            <button class="hp25-product-card__add-btn" tabindex="-1">DIG IT</button>
          </div>
        </a>
      {%- endfor -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP25 - Retro Collection",
  "class": "section-hp25-featured-collection",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Far Out Finds"
    },
    {
      "type": "range",
      "id": "header_margin",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Margin Below Header",
      "default": 50
    },
    {
      "type": "header",
      "content": "Collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Products to Show",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View All' Button",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1400
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Columns (Desktop)",
      "default": 4
    },
    {
      "type": "select",
      "id": "image_aspect_ratio",
      "label": "Image Aspect Ratio",
      "options": [
        { "value": "1/1", "label": "Square (1:1)" },
        { "value": "3/4", "label": "Portrait (3:4)" },
        { "value": "4/5", "label": "Portrait (4:5)" }
      ],
      "default": "4/5"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 48
    },
    {
      "type": "header",
      "content": "Retro 70s Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#F5E6D3"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text / Border (Dark Brown)",
      "default": "#3E2723"
    },
    {
      "type": "color",
      "id": "accent_orange",
      "label": "Accent (Burnt Orange)",
      "default": "#D15F3C"
    },
    {
      "type": "color",
      "id": "accent_yellow",
      "label": "Accent (Mustard)",
      "default": "#E2B144"
    },
    {
      "type": "color",
      "id": "accent_green",
      "label": "Accent (Avocado Green)",
      "default": "#76834F"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP25 - Retro Collection"
    }
  ]
}
{% endschema %}
