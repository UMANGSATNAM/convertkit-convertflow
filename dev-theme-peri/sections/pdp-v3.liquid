{%- comment -%}
  PDP V3: Fashion / Footwear Edition
  Features: Stacked Images, Countdown Timer Banner, Gender Toggle, Tabbed Offers
{%- endcomment -%}

{%- assign current_variant = product.selected_or_first_available_variant -%}

<style>
  :root {
    --v3-primary: {{ section.settings.primary_color }};
    --v3-accent: {{ section.settings.accent_color }};
    --v3-bg: {{ section.settings.bg_color }};
    --v3-text: #2C2C2C;
    --v3-text-light: #767676;
    --v3-border: #E5E5E5;
    --v3-font: {{ section.settings.base_font.family }}, {{ section.settings.base_font.fallback_families }};
  }
  
  .pdp-v3 {
    font-family: var(--v3-font);
    color: var(--v3-text);
    background: var(--v3-bg);
    max-width: 1440px;
    margin: 0 auto;
    padding: 20px;
  }
  
  .pdp-v3-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 30px;
  }
  
  @media (min-width: 990px) {
    .pdp-v3-grid {
      grid-template-columns: 1.5fr 1fr;
      gap: 50px;
      align-items: start;
    }
  }

  /* Gallery (Stacked on desktop) */
  .pdp-v3-gallery {
    display: flex;
    flex-direction: column;
    gap: 15px;
  }
  .pdp-v3-gallery__img {
    width: 100%;
    border-radius: 12px;
    background: #EFEFEF;
  }

  /* Info Sticky (Desktop) */
  @media (min-width: 990px) {
    .pdp-v3-info-wrap {
      position: sticky;
      top: 40px;
    }
  }

  .pdp-v3-info {
    border: 1px solid var(--v3-border);
    border-radius: 16px;
    padding: 24px;
    background: #fff;
    margin-bottom: 20px;
  }

  /* Header */
  .pdp-v3-tag {
    display: inline-block;
    background: #15803D;
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    padding: 4px 8px;
    border-radius: 4px;
    text-transform: uppercase;
    margin-bottom: 12px;
  }
  
  .pdp-v3-title-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }
  .pdp-v3-title {
    font-size: 26px;
    font-weight: 400;
    margin: 0 0 15px 0;
    line-height: 1.2;
    max-width: 80%;
  }
  .pdp-v3-rating {
    display: flex;
    align-items: center;
    gap: 4px;
    border: 1px solid var(--v3-border);
    padding: 4px 10px;
    border-radius: 100px;
    font-size: 13px;
    font-weight: 600;
  }

  /* Countdown Banner */
  .pdp-v3-timer {
    background: #166534;
    border-radius: 8px;
    padding: 12px;
    color: #fff;
    margin-bottom: 15px;
  }
  .pdp-v3-timer-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 11px;
    font-weight: 700;
    margin-bottom: 12px;
    border-bottom: 1px solid rgba(255,255,255,0.2);
    padding-bottom: 8px;
  }
  .pdp-v3-timer-clock { display: flex; gap: 4px; align-items: center; }
  
  .pdp-v3-timer-bot {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .pdp-v3-timer-price {
    font-size: 20px;
    font-weight: 700;
  }
  .pdp-v3-timer-save {
    background: #DCFCE7;
    color: #166534;
    font-size: 10px;
    padding: 2px 6px;
    border-radius: 4px;
    font-weight: 700;
  }
  .pdp-v3-timer-coupon {
    font-size: 11px;
    margin-top: 4px;
  }
  .pdp-v3-timer-copy {
    background: #DCFCE7;
    color: #166534;
    border: none;
    padding: 6px 12px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  /* Main Price */
  .pdp-v3-price-wrap {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .pdp-v3-price {
    font-size: 24px;
    font-weight: 700;
  }
  .pdp-v3-compare {
    font-size: 14px;
    color: var(--v3-text-light);
    text-decoration: line-through;
  }
  .pdp-v3-discount {
    font-size: 14px;
    color: #16A34A;
    font-weight: 700;
  }

  /* Variants */
  .pdp-v3-variants {
    border: 1px solid var(--v3-border);
    border-radius: 16px;
    padding: 24px;
    background: #fff;
    margin-bottom: 20px;
  }
  
  .pdp-v3-opt-title {
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 12px;
    display: flex;
    justify-content: space-between;
  }
  
  /* Gender Pill */
  .pdp-v3-gender-toggle {
    display: flex;
    background: #F5F5F5;
    border-radius: 100px;
    padding: 4px;
    margin-bottom: 25px;
  }
  .pdp-v3-gender-btn {
    flex: 1;
    text-align: center;
    padding: 8px;
    font-size: 13px;
    font-weight: 600;
    border-radius: 100px;
    cursor: pointer;
    color: var(--v3-text-light);
  }
  .pdp-v3-gender-btn.is-active {
    background: #C4A484;
    color: #fff;
  }

  /* Colors */
  .pdp-v3-colors {
    display: flex;
    gap: 10px;
    margin-bottom: 25px;
  }
  .pdp-v3-color-swatch {
    width: 40px;
    height: 40px;
    border-radius: 8px;
    border: 1px solid var(--v3-border);
    padding: 2px;
    cursor: pointer;
  }
  .pdp-v3-color-swatch.is-active {
    border: 2px solid var(--v3-text);
  }
  .pdp-v3-color-swatch img {
    width: 100%;
    height: 100%;
    border-radius: 6px;
    object-fit: cover;
  }

  /* Sizes */
  .pdp-v3-sizes {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 25px;
  }
  .pdp-v3-size-btn {
    width: 45px;
    height: 45px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--v3-border);
    border-radius: 8px;
    font-size: 14px;
    cursor: pointer;
    background: #fff;
  }
  .pdp-v3-size-btn.is-active {
    border: 2px solid var(--v3-text);
    font-weight: 700;
  }

  /* Add to Cart */
  .pdp-v3-atc-wrap {
    display: flex;
    gap: 10px;
  }
  .pdp-v3-btn-icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--v3-border);
    border-radius: 100px;
    cursor: pointer;
    background: #fff;
  }
  .pdp-v3-btn-main {
    flex: 1;
    background: var(--v3-primary);
    color: #fff;
    border: none;
    border-radius: 100px;
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
  }

  /* Offers Tab */
  .pdp-v3-offers {
    background: #FAF9F6;
    border-radius: 16px;
    padding: 24px;
  }
  .pdp-v3-offers-title {
    font-size: 16px;
    font-weight: 700;
    margin-bottom: 15px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .pdp-v3-offers-tabs {
    display: flex;
    gap: 10px;
    margin-bottom: 15px;
  }
  .pdp-v3-offer-tab {
    flex: 1;
    text-align: center;
    padding: 10px;
    font-size: 12px;
    font-weight: 700;
    border-radius: 8px;
    cursor: pointer;
    background: #fff;
    color: var(--v3-text-light);
  }
  .pdp-v3-offer-tab.is-active {
    background: #B68D60;
    color: #fff;
  }
  .pdp-v3-offer-list {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    padding-bottom: 10px;
  }
  .pdp-v3-offer-card {
    min-width: 220px;
    background: #fff;
    border-radius: 8px;
    padding: 15px;
    border: 1px solid var(--v3-border);
    display: flex;
    gap: 12px;
  }
  .pdp-v3-offer-icon {
    width: 32px;
    height: 32px;
    background: #FAF9F6;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #B68D60;
  }

</style>

<div class="pdp-v3" data-section="{{ section.id }}">
  <div class="pdp-v3-grid">
    
    <!-- Left: Gallery Stack -->
    <div class="pdp-v3-gallery">
      {% for media in product.media limit: 4 %}
        <img src="{{ media | image_url: width: 1000 }}" class="pdp-v3-gallery__img">
      {% endfor %}
      {% if product.media.size == 0 %}
        {{ 'product-3' | placeholder_svg_tag: 'pdp-v3-gallery__img' }}
        {{ 'product-4' | placeholder_svg_tag: 'pdp-v3-gallery__img' }}
      {% endif %}
    </div>

    <!-- Right: Sticky Info -->
    <div class="pdp-v3-info-wrap">
      
      <div class="pdp-v3-info">
        {% if section.settings.show_tag %}
          <div class="pdp-v3-tag">ðŸ“‰ Price Drop</div>
        {% endif %}
        
        <div class="pdp-v3-title-row">
          <h1 class="pdp-v3-title">{{ product.title }}</h1>
          {% if section.settings.show_rating %}
            <div class="pdp-v3-rating">
              <span style="color:#D97706;">â˜…</span> {{ section.settings.rating_value }}
            </div>
          {% endif %}
        </div>

        <!-- Timer Banner -->
        {% if section.settings.show_timer %}
          <div class="pdp-v3-timer">
            <div class="pdp-v3-timer-top">
              <span>âš¡ Exclusive Launch Price Ends In:</span>
              <div class="pdp-v3-timer-clock">
                <span>â±ï¸</span> 14h 30m 37s
              </div>
            </div>
            <div class="pdp-v3-timer-bot">
              <div>
                <div style="display:flex;align-items:center;gap:8px;">
                  <span class="pdp-v3-timer-price">Get it at {{ current_variant.price | times: 0.9 | money }}</span>
                  <span class="pdp-v3-timer-save">Extra â‚¹260 off</span>
                </div>
                <div class="pdp-v3-timer-coupon">Apply <strong>NEWSLU10</strong> at checkout</div>
              </div>
              <button class="pdp-v3-timer-copy">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                Copy
              </button>
            </div>
          </div>
        {% endif %}

        <div class="pdp-v3-price-wrap">
          <span class="pdp-v3-price">{{ current_variant.price | money }}</span>
          {% if current_variant.compare_at_price > current_variant.price %}
            {% assign save = current_variant.compare_at_price | minus: current_variant.price | times: 100.0 | divided_by: current_variant.compare_at_price | round %}
            <span class="pdp-v3-discount">{{ save }}% OFF</span>
            <span class="pdp-v3-compare">{{ current_variant.compare_at_price | money }}</span>
          {% endif %}
          <span style="font-size:11px;color:var(--v3-text-light);">(MRP Incl. of all taxes)</span>
        </div>
      </div>

      <!-- Variants Box -->
      <div class="pdp-v3-variants">
        
        {% if section.settings.show_gender %}
          <div class="pdp-v3-opt-title">Select Gender : <strong>Men</strong></div>
          <div class="pdp-v3-gender-toggle">
            <div class="pdp-v3-gender-btn is-active">Men</div>
            <div class="pdp-v3-gender-btn">Women</div>
          </div>
        {% endif %}

        {% if section.settings.show_color %}
          <div class="pdp-v3-opt-title">Select Color: <strong>Orange</strong></div>
          <div class="pdp-v3-colors">
            {% for variant in product.variants limit: 4 %}
              <div class="pdp-v3-color-swatch {% if forloop.first %}is-active{% endif %}">
                {% if variant.featured_image %}
                  <img src="{{ variant.featured_image | image_url: width: 80 }}">
                {% else %}
                  {{ 'image' | placeholder_svg_tag }}
                {% endif %}
              </div>
            {% endfor %}
          </div>
        {% endif %}

        {% if section.settings.show_size %}
          <div class="pdp-v3-opt-title">
            <span>Select Size (UK):</span>
            <a href="#" style="color:#B68D60;text-decoration:underline;">ðŸ“ SIZE CHART</a>
          </div>
          <div class="pdp-v3-sizes">
            <div class="pdp-v3-size-btn">6</div>
            <div class="pdp-v3-size-btn is-active">7</div>
            <div class="pdp-v3-size-btn">8</div>
            <div class="pdp-v3-size-btn">9</div>
            <div class="pdp-v3-size-btn">10</div>
            <div class="pdp-v3-size-btn">11</div>
          </div>
        {% endif %}

        <div class="pdp-v3-atc-wrap">
          <div class="pdp-v3-btn-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
          </div>
          <button class="pdp-v3-btn-main">Buy Now >></button>
        </div>

      </div>

      <!-- Offers Tab Box -->
      {% if section.settings.show_offers %}
        <div class="pdp-v3-offers">
          <div class="pdp-v3-offers-title">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>
            Offers
          </div>
          
          <div class="pdp-v3-offers-tabs">
            <div class="pdp-v3-offer-tab is-active">Active Coupons (3)</div>
            <div class="pdp-v3-offer-tab">Payment Offers (4)</div>
          </div>

          <div class="pdp-v3-offer-list">
            <div class="pdp-v3-offer-card">
              <div class="pdp-v3-offer-icon">ðŸ·ï¸</div>
              <div>
                <div style="font-size:12px;font-weight:600;margin-bottom:8px;">Buy any 2 products, get <strong>Extra 7% OFF</strong></div>
                <div style="font-size:11px;color:var(--v3-text-light);">Discounted Price:</div>
                <div style="display:flex;justify-content:space-between;align-items:center;">
                  <strong style="color:var(--v3-text);">â‚¹ 2,417</strong>
                  <span style="color:#B68D60;font-size:10px;font-weight:700;">Auto Applied</span>
                </div>
              </div>
            </div>
            
            <div class="pdp-v3-offer-card">
              <div class="pdp-v3-offer-icon">ðŸ·ï¸</div>
              <div>
                <div style="font-size:12px;font-weight:600;margin-bottom:8px;">Buy any 3 products, get <strong>10% OFF</strong></div>
                <div style="font-size:11px;color:var(--v3-text-light);">Discounted Price:</div>
                <div style="display:flex;justify-content:space-between;align-items:center;">
                  <strong style="color:var(--v3-text);">â‚¹ 2,339</strong>
                  <span style="color:#B68D60;font-size:10px;font-weight:700;">Auto Applied</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      {% endif %}

    </div>
  </div>
</div>


<!-- STICKY ATC -->
<style>
  .sticky-atc-{{ section.id }} {
    position: fixed;
    bottom: -100px;
    left: 0;
    width: 100%;
    background: #FFF;
    box-shadow: 0 -4px 10px rgba(0,0,0,0.1);
    z-index: 999;
    padding: 10px 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: bottom 0.3s ease-in-out;
    border-top: 1px solid #eee;
  }
  .sticky-atc-{{ section.id }}.visible {
    bottom: 0;
  }
  .sticky-atc-{{ section.id }}__info { display: flex; align-items: center; gap: 10px; }
  .sticky-atc-{{ section.id }}__img { width: 40px; height: 40px; object-fit: cover; border-radius: 4px; }
  .sticky-atc-{{ section.id }}__title { font-weight: 600; font-size: 14px; color: #000; }
  .sticky-atc-{{ section.id }}__price { font-weight: 700; color: #D32F2F; font-size: 14px; }
  .sticky-atc-{{ section.id }}__btn { background: #000; color: #FFF; border: none; padding: 12px 24px; font-weight: 700; cursor: pointer; border-radius: 4px; text-transform: uppercase; }
  .sticky-atc-{{ section.id }}__btn:hover { opacity: 0.8; }
  @media (max-width: 768px) {
    .sticky-atc-{{ section.id }}__info { display: none; }
    .sticky-atc-{{ section.id }}__btn { width: 100%; padding: 14px; font-size: 16px; }
  }
</style>

<div class="sticky-atc-{{ section.id }}" id="sticky-atc-{{ section.id }}">
  <div class="sticky-atc-{{ section.id }}__info">
    {% if product.featured_media %}
      <img src="{{ product.featured_media | image_url: width: 100 }}" class="sticky-atc-{{ section.id }}__img">
    {% endif %}
    <div>
      <div class="sticky-atc-{{ section.id }}__title">{{ product.title }}</div>
      <div class="sticky-atc-{{ section.id }}__price">{{ product.selected_or_first_available_variant.price | money }}</div>
    </div>
  </div>
  <button class="sticky-atc-{{ section.id }}__btn" onclick="window.scrollTo({top: 0, behavior: 'smooth'})">ADD TO CART</button>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const stickyBar = document.getElementById('sticky-atc-{{ section.id }}');
    if(stickyBar) {
      window.addEventListener('scroll', function() {
        if (window.scrollY > 600) {
          stickyBar.classList.add('visible');
        } else {
          stickyBar.classList.remove('visible');
        }
      });
    }
  });
</script>

{% schema %}

{
  "name": "PDP V3 - Fashion",
  "settings": [
    {
      "type": "header",
      "content": "Theme Styling"
    },
    { "type": "color", "id": "primary_color", "label": "Primary Button Color", "default": "#333333" },
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#FFFFFF" },
    { "type": "font_picker", "id": "base_font", "label": "Base Font", "default": "sans-serif" },
    
    {
      "type": "header",
      "content": "Product Info"
    },
    { "type": "checkbox", "id": "show_tag", "label": "Show Price Drop Tag", "default": true },
    { "type": "checkbox", "id": "show_rating", "label": "Show Rating", "default": true },
    { "type": "text", "id": "rating_value", "label": "Rating Value", "default": "5.0 (7)" },

    {
      "type": "header",
      "content": "Features"
    },
    { "type": "checkbox", "id": "show_timer", "label": "Show Countdown Timer & Coupon", "default": true },
    { "type": "checkbox", "id": "show_gender", "label": "Show Gender Toggle", "default": true },
    { "type": "checkbox", "id": "show_color", "label": "Show Image Swatches", "default": true },
    { "type": "checkbox", "id": "show_size", "label": "Show Size Grid", "default": true },
    { "type": "checkbox", "id": "show_offers", "label": "Show Tabbed Offers", "default": true }
  ],
  "presets": [
    {
      "name": "PDP V3 - Fashion"
    }
  ]
}
{% endschema %}
