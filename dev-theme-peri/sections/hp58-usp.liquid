{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#0B0F19' }};
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
  }
  .hp58-usp__container { max-width: {{ section.settings.container_width | default: 1280 }}px; margin: 0 auto; padding: 0 24px; }
  .hp58-usp__grid { display: grid; grid-template-columns: repeat({{ section.settings.columns | default: 4 }}, 1fr); gap: 20px; }
  .hp58-usp__card {
    background: {{ section.settings.card_bg | default: '#111827' }};
    border: 1px solid rgba(6, 182, 212, 0.2);
    border-radius: 8px; padding: 32px 22px; text-align: center;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .hp58-usp__card:hover {
    transform: translateY(-4px);
    border-color: #06B6D4;
    box-shadow: 0 0 25px rgba(6, 182, 212, 0.25);
  }
  .hp58-usp__icon {
    width: 52px; height: 52px;
    background: linear-gradient(135deg, #1E1B4B, #8B5CF6);
    border-radius: 8px; display: flex; align-items: center; justify-content: center;
    margin: 0 auto 16px; font-size: 22px; color: #06B6D4;
    border: 1px solid rgba(6, 182, 212, 0.3);
    box-shadow: 0 0 15px rgba(6, 182, 212, 0.2);
  }
  .hp58-usp__title {
    font-family: 'Syne', sans-serif; font-size: 16px; font-weight: 700; color: #FFFFFF; margin: 0 0 8px;
  }
  .hp58-usp__desc { font-size: 13px; line-height: 1.6; color: #94A3B8; margin: 0; }
  @media screen and (max-width: 992px) { .hp58-usp__grid { grid-template-columns: repeat(2, 1fr); } }
  @media screen and (max-width: 480px) { .hp58-usp__grid { grid-template-columns: 1fr; } }
{%- endstyle -%}
<div class="hp58-usp__container">
  <div class="hp58-usp__grid">
    {%- for block in section.blocks -%}
      <div class="hp58-usp__card" {{ block.shopify_attributes }}>
        <div class="hp58-usp__icon">{{ block.settings.icon | default: '⚡' }}</div>
        <h3 class="hp58-usp__title">{{ block.settings.title | default: 'Quantum Peptides' }}</h3>
        <p class="hp58-usp__desc">{{ block.settings.description | default: 'Precision engineered bio-actives.' }}</p>
      </div>
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "HP58 Pillars",
  "class": "section-hp58-usp",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#0B0F19" },
    { "type": "color", "id": "card_bg", "label": "Card BG", "default": "#111827" },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "label": "Columns", "default": 4 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 80 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "blocks": [{ "type": "pillar", "name": "Pillar", "settings": [
    { "type": "text", "id": "icon", "label": "Icon", "default": "⚡" },
    { "type": "text", "id": "title", "label": "Title", "default": "Quantum Peptides" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Precision engineered bio-actives." }
  ]}],
  "presets": [{ "name": "HP58 Pillars", "blocks": [
    { "type": "pillar", "settings": { "icon": "🧬", "title": "Quantum Peptide 7X", "description": "Nanoscale protein sequences targeted for deep matrix repair." } },
    { "type": "pillar", "settings": { "icon": "⚡", "title": "Cyber-Algae Ferment", "description": "Bioluminescent marine ferment hyper-energizing mitochondrial ATP." } },
    { "type": "pillar", "settings": { "icon": "🛡️", "title": "Neon Photoshield", "description": "Complete protection from blue light, HEV radiation, and pollution." } },
    { "type": "pillar", "settings": { "icon": "🧪", "title": "Shibuya Lab Synthesis", "description": "Purity certified >99.8% via Tokyo spectroscopic analysis." } }
  ]}]
}
{% endschema %}
