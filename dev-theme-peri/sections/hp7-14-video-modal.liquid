{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#050505'
  assign padding_top = section.settings.padding_top | default: 0
  assign padding_bottom = section.settings.padding_bottom | default: 0
-%}

<style>
  #shopify-section-{{ section_id }} {
    --bg-color: {{ bg_color }};
    --padding-top: {{ padding_top }}px;
    --padding-bottom: {{ padding_bottom }}px;
    
    background-color: var(--bg-color);
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
  }

  .hp7-video-{{ section_id }} {
    position: relative;
    width: 100%;
    height: 80vh;
    min-height: 500px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hp7-video__cover {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }
  
  .hp7-video__cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.7);
  }

  /* HTML5 Native details acts as our modal state */
  .hp7-video__modal {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
  }
  
  .hp7-video__modal > summary {
    list-style: none;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  
  .hp7-video__modal > summary::-webkit-details-marker {
    display: none;
  }
  
  .hp7-video__play-text {
    font-family: 'Playfair Display', serif;
    font-size: clamp(4rem, 8vw, 10rem);
    color: #F4F4F0;
    text-transform: uppercase;
    font-weight: 400;
    letter-spacing: 0.1em;
    mix-blend-mode: overlay;
    transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  
  .hp7-video__modal > summary:hover .hp7-video__play-text {
    transform: scale(1.1);
  }

  /* Modal Content */
  .hp7-video__modal-content {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: #000;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hp7-video__iframe-wrap {
    width: 90%;
    max-width: 1400px;
    aspect-ratio: 16/9;
    position: relative;
  }

  .hp7-video__iframe-wrap iframe,
  .hp7-video__iframe-wrap video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  /* Close button - we use a secondary details summary trick or js */
  .hp7-video__close {
    position: absolute;
    top: 2rem;
    right: 2rem;
    font-family: 'Inter', sans-serif;
    color: #FFF;
    font-size: 14px;
    letter-spacing: 0.1em;
    background: transparent;
    border: none;
    cursor: pointer;
    z-index: 10000;
  }

</style>

<section class="hp7-video-{{ section_id }}">
  
  <div class="hp7-video__cover">
    {%- if section.settings.cover_image != blank -%}
      {{ section.settings.cover_image | image_url: width: 2400 | image_tag: class: 'hp7-video__cover-img' }}
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'hp7-video__cover-img placeholder-svg' }}
    {%- endif -%}
  </div>

  <details class="hp7-video__modal" id="video-modal-{{ section_id }}">
    <summary aria-label="Play Video">
      <span class="hp7-video__play-text">PLAY</span>
    </summary>
    
    <div class="hp7-video__modal-content">
      <button class="hp7-video__close" aria-label="Close video" onclick="document.getElementById('video-modal-{{ section_id }}').removeAttribute('open')">CLOSE</button>
      
      <div class="hp7-video__iframe-wrap">
        {%- if section.settings.video_url != blank -%}
          {%- if section.settings.video_url.type == 'youtube' -%}
            <iframe src="https://www.youtube.com/embed/{{ section.settings.video_url.id }}?autoplay=1" frameborder="0" allow="autoplay; encrypted-media" allowfullscreen></iframe>
          {%- elsif section.settings.video_url.type == 'vimeo' -%}
            <iframe src="https://player.vimeo.com/video/{{ section.settings.video_url.id }}?autoplay=1" frameborder="0" allow="autoplay; fullscreen" allowfullscreen></iframe>
          {%- endif -%}
        {%- elsif section.settings.html5_video != blank -%}
          {{ section.settings.html5_video | video_tag: controls: true, autoplay: true, style: 'width: 100%; height: 100%;' }}
        {%- else -%}
          <div style="background:#222;width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:#fff;">
            VIDEO PLACEHOLDER
          </div>
        {%- endif -%}
      </div>
    </div>
  </details>

</section>

<script>
  // Autoplay functionality requires JS to append the autoplay param on click for iframes
  // Here we use native details/summary which is accessible out of the box,
  // The close button uses a simple inline onclick.
</script>

{% schema %}
{
  "name": "HP7 Video Modal",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Aesthetic: Editorial Brutalism",
      "info": "Edge-to-edge cover image with massive typography PLAY button opening a full-screen modal."
    },
    {
      "type": "image_picker",
      "id": "cover_image",
      "label": "Cover Image"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "YouTube / Vimeo URL",
      "accept": ["youtube", "vimeo"]
    },
    {
      "type": "video",
      "id": "html5_video",
      "label": "Shopify Hosted Video (Overrides URL)"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#050505"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "HP7 Video Modal"
    }
  ]
}
{% endschema %}
