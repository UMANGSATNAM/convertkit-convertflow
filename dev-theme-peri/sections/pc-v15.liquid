{%- comment -%}
  PC V15 — LUXURY FINE JEWELRY & PRECIOUS GOODS PRODUCT GRID
  Design: Pearl Ivory (#FCFCF9), Rose Gold (#B76E79) accents, Cormorant Garamond & Jost typography
  Card Shape: Delicate 2px corners, soft ivory border, subtle golden shimmer hover
{%- endcomment -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,400&family=Jost:wght@300;400;500;600&display=swap');

  .pcv15 {
    --bg: {{ section.settings.bg_color | default: '#FCFCF9' }};
    --card-bg: {{ section.settings.card_bg | default: '#FFFFFF' }};
    --text: {{ section.settings.text_color | default: '#2C2725' }};
    --muted: {{ section.settings.muted_color | default: '#8C827D' }};
    --accent: {{ section.settings.accent_color | default: '#B76E79' }};
    --accent-hover: {{ section.settings.accent_hover | default: '#9B545F' }};
    --border: {{ section.settings.border_color | default: '#F0EAE1' }};
    --badge-sale-bg: #B76E79;
    --badge-sale-text: #FFFFFF;
    --f-serif: 'Cormorant Garamond', serif;
    --f-sans: 'Jost', sans-serif;
    --ease: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    background-color: var(--bg);
    color: var(--text);
    font-family: var(--f-sans);
    padding: {{ section.settings.padding_top | default: 60 }}px 0 {{ section.settings.padding_bottom | default: 60 }}px 0;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }

  .pcv15 *, .pcv15 *::before, .pcv15 *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .pcv15 a { color: inherit; text-decoration: none; }
  .pcv15 button { font-family: inherit; cursor: pointer; border: none; background: none; }
  .pcv15 img { max-width: 100%; display: block; }

  .pcv15__wrap { max-width: 1280px; margin: 0 auto; padding: 0 24px; }

  /* HEADER */
  .pcv15__head { display: flex; flex-direction: column; gap: 10px; margin-bottom: 40px; text-align: {{ section.settings.header_align | default: 'center' }}; }
  @media (min-width: 768px) {
    .pcv15__head { display: flex; flex-direction: row; justify-content: space-between; align-items: flex-end; }
  }
  .pcv15__title { font-family: var(--f-serif); font-size: 34px; font-weight: 500; color: var(--text); letter-spacing: 0.02em; font-style: italic; }
  @media (min-width: 768px) { .pcv15__title { font-size: 44px; } }
  .pcv15__sub { font-size: 14px; color: var(--muted); font-weight: 300; letter-spacing: 0.05em; }
  .pcv15__viewall { display: inline-flex; align-items: center; gap: 8px; font-weight: 500; font-size: 12px; text-transform: uppercase; letter-spacing: 0.15em; color: var(--accent); border-bottom: 1px solid var(--accent); padding-bottom: 2px; transition: var(--ease); }
  .pcv15__viewall:hover { color: var(--accent-hover); border-color: var(--accent-hover); }

  /* GRID */
  .pcv15__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr);
    gap: 20px;
  }
  @media (min-width: 640px) {
    .pcv15__grid { grid-template-columns: repeat({{ section.settings.cols_tablet | default: 3 }}, 1fr); gap: 28px; }
  }
  @media (min-width: 1024px) {
    .pcv15__grid { grid-template-columns: repeat({{ section.settings.cols_desktop | default: 4 }}, 1fr); gap: 32px; }
  }

  /* CARD */
  .pcv15__card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 2px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    position: relative;
    transition: var(--ease);
  }
  .pcv15__card:hover {
    box-shadow: 0 16px 36px -10px rgba(183, 110, 121, 0.15);
    border-color: #E2D5C7;
  }

  /* IMAGE BOX */
  .pcv15__img-box {
    position: relative;
    width: 100%;
    aspect-ratio: {{ section.settings.img_ratio | default: '1/1' }};
    background: #F9F6F0;
    overflow: hidden;
  }
  .pcv15__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .pcv15__img--sec {
    position: absolute;
    top: 0; left: 0;
    opacity: 0;
  }
  .pcv15__card:hover .pcv15__img--pri {
    {% if section.settings.enable_sec_img %}
      opacity: 0;
    {% else %}
      transform: scale(1.05);
    {% endif %}
  }
  .pcv15__card:hover .pcv15__img--sec { opacity: 1; transform: scale(1.05); }

  /* BADGES */
  .pcv15__badges { position: absolute; top: 12px; left: 12px; display: flex; flex-direction: column; gap: 6px; z-index: 2; pointer-events: none; }
  .pcv15__badge { font-size: 10px; font-weight: 500; text-transform: uppercase; padding: 4px 10px; letter-spacing: 0.1em; font-family: var(--f-sans); }
  .pcv15__badge--sale { background: var(--badge-sale-bg); color: var(--badge-sale-text); }
  .pcv15__badge--tag { background: #2C2725; color: #FFFFFF; }
  .pcv15__badge--sold { background: #8C827D; color: #FFFFFF; }

  /* WISHLIST BUTTON */
  .pcv15__wish {
    position: absolute;
    top: 12px; right: 12px;
    width: 36px; height: 36px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(4px);
    display: flex; align-items: center; justify-content: center;
    color: var(--muted);
    z-index: 3;
    transition: var(--ease);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
  }
  .pcv15__wish:hover { background: #FFFFFF; color: var(--accent); transform: scale(1.1); }
  .pcv15__wish.active { color: var(--accent); background: #FFFFFF; }

  /* QUICK ADD HOVER */
  .pcv15__quick-box {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    z-index: 3;
    transform: translateY(100%);
    opacity: 0;
    transition: var(--ease);
  }
  .pcv15__card:hover .pcv15__quick-box { transform: translateY(0); opacity: 1; }
  @media (max-width: 767px) {
    .pcv15__quick-box { transform: translateY(0); opacity: 1; position: relative; bottom: auto; left: auto; right: auto; padding: 0 16px 16px; }
  }

  .pcv15__quick-btn {
    width: 100%;
    padding: 12px 16px;
    background: var(--text);
    color: #FFFFFF;
    font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.15em;
    font-family: var(--f-sans);
    display: flex; align-items: center; justify-content: center; gap: 8px;
    transition: var(--ease);
  }
  .pcv15__quick-btn:hover { background: var(--accent); }
  .pcv15__quick-btn:disabled { background: #F0EAE1; color: #8C827D; cursor: not-allowed; }

  /* CARD CONTENT */
  .pcv15__content { padding: 18px; display: flex; flex-direction: column; gap: 6px; flex-grow: 1; text-align: center; }

  .pcv15__vendor { font-size: 10px; text-transform: uppercase; color: var(--accent); font-weight: 500; letter-spacing: 0.15em; }
  .pcv15__item-title { font-family: var(--f-serif); font-size: 18px; font-weight: 500; color: var(--text); line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  /* RATING */
  .pcv15__rating { display: flex; align-items: center; justify-content: center; gap: 6px; font-size: 11px; color: var(--accent); }
  .pcv15__stars { letter-spacing: 2px; }
  .pcv15__rev-cnt { color: var(--muted); font-size: 11px; font-weight: 300; }

  /* PRICE */
  .pcv15__price-row { display: flex; align-items: baseline; justify-content: center; gap: 10px; margin-top: auto; padding-top: 4px; }
  .pcv15__price { font-size: 16px; font-weight: 600; color: var(--text); font-family: var(--f-sans); }
  .pcv15__cmp-price { font-size: 13px; color: var(--muted); text-decoration: line-through; }

  /* SWATCHES */
  .pcv15__swatches { display: flex; gap: 6px; align-items: center; justify-content: center; margin-top: 4px; }
  .pcv15__swatch { width: 12px; height: 12px; border-radius: 50%; border: 1px solid var(--border); cursor: pointer; transition: var(--ease); }
  .pcv15__swatch:hover, .pcv15__swatch.active { transform: scale(1.25); border-color: var(--accent); }

  /* URGENCY MICRO */
  .pcv15__urgency { font-size: 11px; color: var(--accent); font-style: italic; font-family: var(--f-serif); display: flex; align-items: center; justify-content: center; gap: 4px; margin-top: 2px; }

  /* TOAST */
  .pcv15__toast {
    position: fixed; bottom: 24px; right: 24px;
    background: var(--text); color: #FFFFFF;
    padding: 12px 24px; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.12em;
    font-family: var(--f-sans);
    z-index: 9999;
    transform: translateY(100px); opacity: 0;
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .pcv15__toast.show { transform: translateY(0); opacity: 1; }
</style>

<div class="pcv15">
  <div class="pcv15__wrap">
    
    {% if section.settings.title != blank or section.settings.subheading != blank %}
      <div class="pcv15__head">
        <div>
          {% if section.settings.title != blank %}
            <h2 class="pcv15__title">{{ section.settings.title | escape }}</h2>
          {% endif %}
          {% if section.settings.subheading != blank %}
            <p class="pcv15__sub">{{ section.settings.subheading | escape }}</p>
          {% endif %}
        </div>
        {% if section.settings.show_view_all and section.settings.collection != blank %}
          <a href="{{ collections[section.settings.collection].url }}" class="pcv15__viewall">
            {{ section.settings.view_all_label | default: 'View High Jewelry' }} &rarr;
          </a>
        {% endif %}
      </div>
    {% endif %}

    <div class="pcv15__grid">
      {% assign target_coll = collections[section.settings.collection] %}
      {% assign limit_num = section.settings.products_per_page | default: 8 %}

      {% if target_coll != blank and target_coll.products.size > 0 %}
        {% for product in target_coll.products limit: limit_num %}
          {% assign current_variant = product.selected_or_first_available_variant %}
          
          {% render 'card-v15', product: product, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v15', product: nil, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% endif %}
    </div>

  </div>
</div>

<div class="pcv15__toast" id="pcv15-toast">Added To Velvet Pouch</div>

<script>
(function(){
  // Wishlist is handled globally by assets/wishlist.js (shared store: cf_wishlist_items).
  // Buttons are rendered by snippets/wishlist-button.liquid — no per-section storage.


  document.querySelectorAll('[data-pcv15-add]').forEach(function(btn){
    btn.addEventListener('click', function(e){
      e.preventDefault(); e.stopPropagation();
      var id = btn.dataset.pcv15Add, orig = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = 'Placing...';

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: id, quantity: 1 })
      })
      .then(function(r){ return r.json(); })
      .then(function(){
        btn.innerHTML = '✓ Placed';
        showT('Added To Velvet Pouch');
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      })
      .catch(function(){
        btn.innerHTML = 'Error';
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      });
    });
  });

  function showT(msg){
    var t = document.getElementById('pcv15-toast');
    if(!t) return;
    t.textContent = msg;
    t.classList.add('show');
    setTimeout(function(){ t.classList.remove('show'); }, 3000);
  }
})();
</script>

