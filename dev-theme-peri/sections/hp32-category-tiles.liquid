{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Space+Mono:ital,wght@0,400;0,700;1,400;1,700&family=Syne:wght@700;800&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --border-color: #000000;
    --accent-color: {{ section.settings.accent_color }};
    
    --font-heading: 'Syne', sans-serif;
    --font-body: 'Space Mono', monospace;
    
    background-color: var(--bg-color);
    border-bottom: 4px solid var(--border-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .hp32-tiles-wrapper {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp32-tiles-wrapper {
      padding: 0 20px;
    }
  }

  .hp32-tiles__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 40px;
  }

  .hp32-tiles__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    line-height: 1;
    color: #000;
    text-transform: uppercase;
    margin: 0;
    letter-spacing: -1px;
  }

  .hp32-tiles__title::before {
    content: '//';
    color: var(--accent-color);
    margin-right: 10px;
  }

  .hp32-tiles__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: 350px;
    gap: 20px;
  }

  @media screen and (max-width: 992px) {
    .hp32-tiles__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 768px) {
    .hp32-tiles__grid {
      grid-template-columns: 1fr;
      grid-auto-rows: 250px;
    }
  }

  .hp32-tile {
    position: relative;
    border: 4px solid var(--border-color);
    background: #fff;
    box-shadow: 8px 8px 0 var(--border-color);
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: #000;
    overflow: hidden;
    transition: transform 0.1s ease, box-shadow 0.1s ease;
  }

  .hp32-tile:hover {
    transform: translate(4px, 4px);
    box-shadow: 4px 4px 0 var(--border-color);
  }

  /* Specific sizing for first item (featured) */
  .hp32-tile:nth-child(1) {
    grid-column: span 2;
    grid-row: span 2;
  }

  @media screen and (max-width: 992px) {
    .hp32-tile:nth-child(1) {
      grid-column: span 2;
      grid-row: span 1;
    }
  }

  @media screen and (max-width: 768px) {
    .hp32-tile:nth-child(1) {
      grid-column: span 1;
    }
  }

  .hp32-tile__image {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%);
    transition: filter 0.3s ease;
    z-index: 1;
  }

  .hp32-tile:hover .hp32-tile__image {
    filter: grayscale(0%);
  }

  .hp32-tile__overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: var(--accent-color);
    mix-blend-mode: multiply;
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: 2;
  }

  .hp32-tile:hover .hp32-tile__overlay {
    opacity: 1;
  }

  .hp32-tile__content {
    position: absolute;
    bottom: 20px;
    left: 20px;
    right: 20px;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .hp32-tile__label {
    background: #000;
    color: var(--accent-color);
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 700;
    padding: 6px 12px;
    text-transform: uppercase;
    border: 2px solid var(--border-color);
    margin-bottom: 10px;
    transition: background 0.3s ease, color 0.3s ease;
  }

  .hp32-tile:hover .hp32-tile__label {
    background: var(--accent-color);
    color: #000;
  }

  .hp32-tile__title {
    background: #fff;
    color: #000;
    font-family: var(--font-heading);
    font-size: clamp(24px, 3vw, 36px);
    line-height: 1;
    padding: 10px 15px;
    border: 3px solid var(--border-color);
    margin: 0;
    text-transform: uppercase;
  }

  .hp32-tile:nth-child(1) .hp32-tile__title {
    font-size: clamp(32px, 5vw, 48px);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp32-tiles-wrapper" id="HP32Tiles-{{ section.id }}">
  <div class="hp32-tiles__header">
    <h2 class="hp32-tiles__title">{{ section.settings.title }}</h2>
  </div>

  <div class="hp32-tiles__grid">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.link | default: '#' }}" class="hp32-tile" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          <img height="{{ block.settings.image.height }}" width="{{ block.settings.image.width }}" src="{{ block.settings.image | image_url: width: 1000 }}" alt="{{ block.settings.title | escape }}" class="hp32-tile__image" loading="lazy">
        {%- else -%}
          {%- assign placeholder = 'collection-' | append: forloop.index -%}
          {%- if forloop.index > 6 -%}{%- assign placeholder = 'collection-1' -%}{%- endif -%}
          {{ placeholder | placeholder_svg_tag: 'hp32-tile__image' }}
        {%- endif -%}
        
        <div class="hp32-tile__overlay"></div>
        
        <div class="hp32-tile__content">
          {%- if block.settings.label != blank -%}
            <span class="hp32-tile__label">{{ block.settings.label }}</span>
          {%- endif -%}
          <h3 class="hp32-tile__title">{{ block.settings.title }}</h3>
        </div>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "HP32 - Brutalist Tiles",
  "class": "section-hp32-category-tiles",
  "max_blocks": 5,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "INDEX_DIRECTORY"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 48
    },
    {
      "type": "header",
      "content": "Brutalist Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (e.g. Light Grey)",
      "default": "#f4f4f4"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color (e.g. Lime)",
      "default": "#ccff00"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Category Tile",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "EXPLORE"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "SYSTEM_GEAR"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP32 - Brutalist Tiles",
      "blocks": [
        { "type": "tile", "settings": { "title": "OUTERWEAR" } },
        { "type": "tile", "settings": { "title": "TACTICAL" } },
        { "type": "tile", "settings": { "title": "HARDWARE" } },
        { "type": "tile", "settings": { "title": "ACCESSORIES" } }
      ]
    }
  ]
}
{% endschema %}
