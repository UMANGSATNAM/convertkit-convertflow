{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#D1FAE5' }};
    padding: {{ section.settings.padding_vertical | default: 35 }}px 0;
  }
  .hp62-pills__container { max-width: 1280px; margin: 0 auto; padding: 0 24px; }
  .hp62-pills__scroll { display: flex; gap: 12px; overflow-x: auto; scrollbar-width: none; justify-content: center; flex-wrap: wrap; }
  .hp62-pills__scroll::-webkit-scrollbar { display: none; }
  .hp62-pills__pill {
    display: inline-flex; align-items: center; gap: 8px; padding: 10px 22px;
    background: {{ section.settings.pill_bg | default: '#FFFFFF' }};
    border: 1px solid rgba(6, 78, 59, 0.2); border-radius: 50px;
    font-family: 'Outfit', sans-serif; font-size: 13px; font-weight: 600;
    color: {{ section.settings.pill_text | default: '#064E3B' }};
    text-decoration: none; white-space: nowrap; transition: all 0.3s ease;
    box-shadow: 0 2px 10px rgba(6, 78, 59, 0.05);
  }
  .hp62-pills__pill:hover { background: #064E3B; color: #FFFFFF; border-color: #064E3B; box-shadow: 0 4px 15px rgba(6, 78, 59, 0.25); }
  @media screen and (max-width: 768px) { .hp62-pills__scroll { justify-content: flex-start; flex-wrap: nowrap; } }
{%- endstyle -%}
<div class="hp62-pills__container">
  <div class="hp62-pills__scroll">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.url | default: '#' }}" class="hp62-pills__pill" {{ block.shopify_attributes }}>
        {%- if block.settings.icon != blank -%}<span>{{ block.settings.icon }}</span>{%- endif -%}
        <span>{{ block.settings.label | default: 'Category' }}</span>
      </a>
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "HP62 Categories",
  "class": "section-hp62-pills",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#D1FAE5" },
    { "type": "color", "id": "pill_bg", "label": "Pill BG", "default": "#FFFFFF" },
    { "type": "color", "id": "pill_text", "label": "Pill Text", "default": "#064E3B" },
    { "type": "range", "id": "padding_vertical", "min": 10, "max": 60, "step": 5, "unit": "px", "label": "Padding", "default": 35 }
  ],
  "blocks": [{ "type": "pill", "name": "Category", "settings": [
    { "type": "text", "id": "icon", "label": "Icon", "default": "🏔️" },
    { "type": "text", "id": "label", "label": "Label", "default": "Edelweiss Serums" },
    { "type": "url", "id": "url", "label": "URL" }
  ]}],
  "presets": [{ "name": "HP62 Categories", "blocks": [
    { "type": "pill", "settings": { "icon": "🏔️", "label": "Edelweiss Serums" } },
    { "type": "pill", "settings": { "icon": "❄️", "label": "Glacial Mists" } },
    { "type": "pill", "settings": { "icon": "🌿", "label": "Alpine Rose Balms" } },
    { "type": "pill", "settings": { "icon": "💧", "label": "Cryo-Elixirs" } },
    { "type": "pill", "settings": { "icon": "🛡️", "label": "Altitude Defense" } }
  ]}]
}
{% endschema %}
