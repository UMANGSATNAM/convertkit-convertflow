{%- liquid
  assign bg_color = section.settings.bg_color | default: '#ffffff'
  assign text_color = section.settings.text_color | default: '#2c2c2c'
  assign product_1 = all_products[section.settings.product_1]
  assign product_2 = all_products[section.settings.product_2]
-%}

<section class="hp1-beauty-bundle" style="background-color: {{ bg_color }}; color: {{ text_color }};" id="hp1-bundle-{{ section.id }}">
  <div class="hp1-bundle-inner">
    
    <div class="hp1-bundle-grid">
      
      <div class="hp1-bundle-images">
        <div class="hp1-bundle-img-wrapper hp1-img-main">
          {%- if section.settings.image_main != blank -%}
            <img height="{{ section.settings.image_main.height }}" width="{{ section.settings.image_main.width }}" src="{{ section.settings.image_main | image_url: width: 800 }}" alt="" loading="lazy">
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
        <div class="hp1-bundle-plus">+</div>
        <div class="hp1-bundle-img-wrapper hp1-img-sub">
          {%- if section.settings.image_sub != blank -%}
            <img height="{{ section.settings.image_sub.height }}" width="{{ section.settings.image_sub.width }}" src="{{ section.settings.image_sub | image_url: width: 400 }}" alt="" loading="lazy">
          {%- else -%}
            {{ 'product-2' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
      </div>

      <div class="hp1-bundle-info">
        {%- if section.settings.subheading != blank -%}
          <span class="hp1-bundle-subheading">{{ section.settings.subheading }}</span>
        {%- endif -%}
        
        {%- if section.settings.heading != blank -%}
          <h2 class="hp1-bundle-heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        
        {%- if section.settings.text != blank -%}
          <p class="hp1-bundle-text">{{ section.settings.text }}</p>
        {%- endif -%}

        <div class="hp1-bundle-products">
          <ul class="hp1-bundle-list">
            <li>
              <span class="hp1-checkmark">✓</span>
              {{ product_1.title | default: 'Radiance Serum' }}
            </li>
            <li>
              <span class="hp1-checkmark">✓</span>
              {{ product_2.title | default: 'Hydrating Moisturizer' }}
            </li>
          </ul>
        </div>
        
        <div class="hp1-bundle-price-box">
          <span class="hp1-bundle-compare-price">{{ section.settings.compare_price }}</span>
          <span class="hp1-bundle-price">{{ section.settings.price }}</span>
        </div>

        {%- if section.settings.btn_label != blank and section.settings.btn_link != blank -%}
          <a href="{{ section.settings.btn_link }}" class="hp1-bundle-btn">
            {{ section.settings.btn_label }}
          </a>
        {%- endif -%}
      </div>
      
    </div>

  </div>
</section>

<style>
  .hp1-beauty-bundle {
    padding: 80px 0;
    font-family: 'Inter', sans-serif;
  }
  .hp1-bundle-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }
  .hp1-bundle-grid {
    display: flex;
    align-items: center;
    gap: 80px;
    background: #fcfaf8;
    border-radius: 20px;
    padding: 60px;
  }
  .hp1-bundle-images {
    flex: 1;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .hp1-bundle-img-wrapper {
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0,0,0,0.1);
  }
  .hp1-bundle-img-wrapper img, .hp1-bundle-img-wrapper svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hp1-img-main {
    width: 70%;
    aspect-ratio: 4/5;
  }
  .hp1-img-sub {
    width: 45%;
    aspect-ratio: 1/1;
    position: absolute;
    bottom: -20px;
    right: -20px;
    border: 5px solid #fcfaf8;
  }
  .hp1-bundle-plus {
    position: absolute;
    z-index: 2;
    background: {{ text_color }};
    color: #fff;
    width: 40px; height: 40px;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 20px;
    right: 20%;
    bottom: 20%;
  }

  .hp1-bundle-info {
    flex: 1;
  }
  .hp1-bundle-subheading {
    display: block;
    font-size: 13px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #8a7a6c;
    margin-bottom: 15px;
  }
  .hp1-bundle-heading {
    font-family: 'Playfair Display', serif;
    font-size: clamp(32px, 4vw, 42px);
    font-weight: 400;
    margin: 0 0 20px;
    line-height: 1.2;
  }
  .hp1-bundle-text {
    font-size: 16px;
    line-height: 1.6;
    color: #555;
    margin-bottom: 30px;
  }
  .hp1-bundle-list {
    list-style: none;
    padding: 0;
    margin: 0 0 30px;
  }
  .hp1-bundle-list li {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
    font-size: 15px;
  }
  .hp1-checkmark {
    color: #8a7a6c;
    font-weight: bold;
  }
  .hp1-bundle-price-box {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-bottom: 30px;
  }
  .hp1-bundle-compare-price {
    text-decoration: line-through;
    color: #999;
    font-size: 18px;
  }
  .hp1-bundle-price {
    font-size: 24px;
    font-weight: 600;
    color: {{ text_color }};
  }
  .hp1-bundle-btn {
    display: inline-block;
    padding: 15px 40px;
    background: {{ text_color }};
    color: #fff;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-size: 14px;
    border-radius: 30px;
    transition: all 0.3s ease;
  }
  .hp1-bundle-btn:hover {
    background: #8a7a6c;
    transform: translateY(-2px);
  }

  @media (max-width: 991px) {
    .hp1-bundle-grid {
      flex-direction: column;
      padding: 40px 20px;
      gap: 50px;
    }
    .hp1-bundle-images {
      width: 100%;
      max-width: 400px;
      margin: 0 auto;
    }
    .hp1-img-sub { right: -10px; }
  }
</style>

{% schema %}
{
  "name": "HP1 Bundle Offer",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image_main",
      "label": "Main Image"
    },
    {
      "type": "image_picker",
      "id": "image_sub",
      "label": "Secondary Image"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "The Perfect Pair"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Radiant Glow Routine"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Pair our best-selling serum with the ultra-hydrating moisturizer for optimal results."
    },
    {
      "type": "product",
      "id": "product_1",
      "label": "Product 1"
    },
    {
      "type": "product",
      "id": "product_2",
      "label": "Product 2"
    },
    {
      "type": "text",
      "id": "compare_price",
      "label": "Compare at Price",
      "default": "$110.00"
    },
    {
      "type": "text",
      "id": "price",
      "label": "Bundle Price",
      "default": "$89.00"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "Add Bundle to Cart"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2c2c2c"
    }
  ],
  "presets": [
    {
      "name": "HP1 Bundle Offer"
    }
  ]
}
{% endschema %}
