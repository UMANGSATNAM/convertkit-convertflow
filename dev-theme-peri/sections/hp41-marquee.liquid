{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@900&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --border-color: #000000;
    --speed: {{ section.settings.speed }}s;
    
    --font-heading: 'Space Grotesk', sans-serif;
  }

  .hp41-marquee-wrapper {
    background: var(--bg-color);
    padding: 20px 0;
    border-top: 4px solid var(--border-color);
    border-bottom: 4px solid var(--border-color);
    overflow: hidden;
    white-space: nowrap;
    display: flex;
    align-items: center;
    position: relative;
    /* Optional: Slight rotation for a sticker/tape effect */
    {% if section.settings.rotate %}
      transform: rotate(-2deg);
      width: 105%;
      margin-left: -2.5%;
      box-shadow: 0 10px 0px rgba(0,0,0,1);
    {% endif %}
  }

  .hp41-marquee__track {
    display: inline-block;
    animation: hp41-scroll var(--speed) linear infinite;
  }
  
  .hp41-marquee__track:hover {
    animation-play-state: paused;
  }

  @keyframes hp41-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  .hp41-marquee__content {
    display: inline-flex;
    align-items: center;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .hp41-marquee__item {
    display: inline-flex;
    align-items: center;
    padding: 0 30px;
    font-family: var(--font-heading);
    font-size: clamp(24px, 4vw, {{ section.settings.text_size }}px);
    font-weight: 900;
    color: var(--border-color);
    text-transform: uppercase;
  }
  
  .hp41-marquee__icon {
    display: inline-block;
    margin: 0 30px;
    width: clamp(24px, 4vw, {{ section.settings.text_size }}px);
    height: clamp(24px, 4vw, {{ section.settings.text_size }}px);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp41-marquee-wrapper" id="HP41Marquee-{{ section.id }}">
  <div class="hp41-marquee__track">
    <ul class="hp41-marquee__content">
      {%- for block in section.blocks -%}
        <li class="hp41-marquee__item" {{ block.shopify_attributes }}>
          {{ block.settings.text }}
          <svg class="hp41-marquee__icon" viewBox="0 0 100 100">
            <path d="M50 0 L60 40 L100 50 L60 60 L50 100 L40 60 L0 50 L40 40 Z" fill="#000"/>
          </svg>
        </li>
      {%- endfor -%}
      {%- for block in section.blocks -%}
        <li class="hp41-marquee__item" aria-hidden="true">
          {{ block.settings.text }}
          <svg class="hp41-marquee__icon" viewBox="0 0 100 100">
            <path d="M50 0 L60 40 L100 50 L60 60 L50 100 L40 60 L0 50 L40 40 Z" fill="#000"/>
          </svg>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "HP41 - Neo Marquee",
  "class": "section-hp41-marquee",
  "settings": [
    {
      "type": "checkbox",
      "id": "rotate",
      "label": "Tilted Tape Effect",
      "default": true
    },
    {
      "type": "range",
      "id": "speed",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "s",
      "label": "Scroll Speed",
      "default": 16
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Text Size",
      "default": 40
    },
    {
      "type": "header",
      "content": "Neo Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#38C6F4"
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "text_block",
      "name": "Marquee Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "FUN STUFF"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP41 - Neo Marquee",
      "blocks": [
        { "type": "text_block", "settings": { "text": "FREE SHIPPING" } },
        { "type": "text_block", "settings": { "text": "100% AWESOME" } },
        { "type": "text_block", "settings": { "text": "NO BORING RULES" } },
        { "type": "text_block", "settings": { "text": "JOIN THE CLUB" } }
      ]
    }
  ]
}
{% endschema %}
