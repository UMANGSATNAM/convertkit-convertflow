{% comment %} CL V60 — Tools / Hardware (Industrial Yellow/Grey) {% endcomment %}
{{ 'component-facets.css' | asset_url | stylesheet_tag }}
<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
<style>
  .clv60 { background: {{ section.settings.bg_color | default: '#F4F4F4' }}; color: {{ section.settings.text_color | default: '#222222' }}; padding: 40px 20px; font-family: 'Barlow Condensed', 'Impact', sans-serif; text-transform: uppercase; }
  .clv60-hero { text-align: left; margin-bottom: 40px; padding: 50px; background: #FFD700; color: #111; border: 4px solid #111; position: relative; box-shadow: 8px 8px 0 #111; }
  .clv60-hero::after { content: ''; position: absolute; right: 0; bottom: 0; width: 0; height: 0; border-style: solid; border-width: 0 0 50px 50px; border-color: transparent transparent #111 transparent; }
  .clv60-hero h1 { font-size: 58px; font-weight: 900; margin-bottom: 10px; line-height: 1; letter-spacing: 1px; }
  .clv60-hero p { font-size: 18px; font-weight: 600; font-family: 'Arial', sans-serif; max-width: 600px; text-transform: none; }
  .clv60-chips { display: flex; gap: 15px; margin-bottom: 40px; flex-wrap: wrap; }
  .clv60-chips a { padding: 10px 20px; background: #FFF; color: #111; text-decoration: none; font-size: 16px; font-weight: 800; border: 2px solid #111; transition: 0.2s; box-shadow: 3px 3px 0 #111; }
  .clv60-chips a:hover, .clv60-chips a.active { background: #111; color: #FFD700; transform: translate(2px, 2px); box-shadow: 1px 1px 0 #111; }
  .clv60-toolbar { background: #333; color: #FFF; padding: 15px 25px; margin-bottom: 30px; display: flex; justify-content: space-between; align-items: center; font-family: 'Arial', sans-serif; text-transform: none; }
  .clv60-grid { display: grid; grid-template-columns: repeat({{ section.settings.cols_desktop | default: 4 }}, 1fr); gap: 20px; }
  .clv60-promo { grid-column: span 1; background: #111; color: #FFD700; border: 4px solid #FFD700; padding: 30px; display: flex; flex-direction: column; justify-content: center; align-items: flex-start; }
  .clv60-promo h3 { font-size: 34px; font-weight: 900; margin-bottom: 20px; line-height: 1; }
  .clv60-promo a { display: inline-block; padding: 12px 25px; background: #FFD700; color: #111; text-decoration: none; font-weight: 900; font-size: 16px; border: 2px solid #FFD700; transition: 0.2s; }
  .clv60-promo a:hover { background: transparent; color: #FFD700; }
  .clv60-seo { margin-top: 60px; background: #E0E0E0; padding: 40px; border-left: 8px solid #FFD700; border-right: 8px solid #111; }
  @media (max-width: 768px) { .clv60-grid { grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr); gap: 15px; } .clv60-hero h1 { font-size: 42px; } .clv60-hero { padding: 30px; } }
</style>
<div class="clv60" style="max-width: 1400px; margin: 0 auto;">
  <div class="clv60-hero">
    <h1>{% if collection.title != blank %}{{ collection.title | escape }}{% else %}HEAVY DUTY TOOLS{% endif %}</h1>
    <p>{% if collection.description != blank %}{{ collection.description }}{% else %}Built tough for the professionals who build our world.{% endif %}</p>
  </div>
  {% if section.settings.sub_collections != blank %}
    <div class="clv60-chips">
      {% for link in section.settings.sub_collections.links %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% endfor %}
    </div>
  {% endif %}
  <div class="clv60-toolbar">
    <facet-filters-form style="width: 100%;">
      <form id="FacetFiltersForm" style="display: flex; justify-content: space-between; align-items: center; width: 100%; flex-wrap: wrap; gap: 20px;">
        <div style="display: flex; gap: 25px;">
          {%- for filter in collection.filters -%}
            <details style="position: relative;">
              <summary style="cursor: pointer; font-size: 14px; font-weight: bold; color: #FFF; text-transform: uppercase;">{{ filter.label }} [+]</summary>
              <div style="position: absolute; background: #111; border: 2px solid #FFD700; padding: 20px; z-index: 10; margin-top: 15px; min-width: 220px; box-shadow: 4px 4px 0 #FFD700;">
                {%- for value in filter.values -%}
                  <label style="display: block; margin-bottom: 12px; cursor: pointer; font-size: 14px; color: #FFF; font-weight: normal;">
                    <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} style="accent-color: #FFD700;">
                    {{ value.label }} ({{ value.count }})
                  </label>
                {%- endfor -%}
              </div>
            </details>
          {%- endfor -%}
        </div>
        <select name="sort_by" onchange="this.form.submit()" style="background: #FFF; border: 2px solid #111; color: #111; padding: 8px 12px; font-size: 14px; font-weight: bold; cursor: pointer; outline: none; text-transform: uppercase;">
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>
          {%- endfor -%}
        </select>
      </form>
    </facet-filters-form>
  </div>
  {% assign limit_num = section.settings.products_per_page | default: 16 %}
  {% paginate collection.products by limit_num %}
    <div class="clv60-grid">
      {% for product in collection.products %}
        {% render 'card-v60', product: product %}
        {% if forloop.index == 8 and section.settings.show_promo_tile %}
          <div class="clv60-promo">
            <h3>PRO<br>CONTRACTOR<br>DISCOUNTS</h3>
            <a href="/pages/pro-program">APPLY HERE</a>
          </div>
        {% endif %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v60', product: nil %}
        {% endfor %}
      {% endfor %}
    </div>
    <div style="margin-top: 40px; text-align: center; font-size: 24px; font-weight: 900; color: #111;">{{ paginate | default_pagination }}</div>
  {% endpaginate %}
  {% if section.settings.show_seo_block %}
    <div class="clv60-seo">
      <h2 style="font-size: 28px; font-weight: 900; color: #111; margin-bottom: 10px;">{{ section.settings.seo_title | default: 'LIFETIME WARRANTY' }}</h2>
      <p style="font-size: 16px; color: #333; max-width: 800px; font-family: 'Arial', sans-serif; text-transform: none; line-height: 1.5;">{{ section.settings.seo_text | default: 'Our tools are forged from industrial-grade materials to withstand the harshest jobsite conditions. We back our hardware for life.' }}</p>
    </div>
  {% endif %}
</div>
{% schema %}
{
  "name": "CL V60 — Hardware", "settings": [
    {"type": "range", "id": "products_per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 16},
    {"type": "range", "id": "cols_desktop", "label": "Desktop Columns", "min": 2, "max": 5, "default": 4},
    {"type": "select", "id": "cols_mobile", "label": "Mobile Columns", "options": [{"value": "1", "label": "1"}, {"value": "2", "label": "2"}], "default": "2"},
    {"type": "link_list", "id": "sub_collections", "label": "Sub-Collection Menu"},
    {"type": "checkbox", "id": "show_promo_tile", "label": "Show Promo Card", "default": true},
    {"type": "checkbox", "id": "show_seo_block", "label": "Show SEO Block", "default": true},
    {"type": "color", "id": "bg_color", "label": "Background Color", "default": "#F4F4F4"},
    {"type": "color", "id": "text_color", "label": "Text Color", "default": "#222222"}
  ], "presets": [{"name": "CL V60 — Hardware"}]
}
{% endschema %}
