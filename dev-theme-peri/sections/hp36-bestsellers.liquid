{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400;1,600&family=Oswald:wght@300;400;500&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --border-color: {{ section.settings.border_color }};
    
    --font-serif: 'Playfair Display', serif;
    --font-sans: 'Oswald', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    border-bottom: 1px solid var(--border-color);
    overflow: hidden;
  }

  .hp36-best-wrapper {
    display: flex;
    flex-direction: column;
  }

  .hp36-best__header {
    padding: 0 40px 40px;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    border-bottom: 1px solid var(--border-color);
  }

  @media screen and (max-width: 768px) {
    .hp36-best__header {
      padding: 0 20px 30px;
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }
  }

  .hp36-best__title {
    font-family: var(--font-serif);
    font-size: clamp(40px, 6vw, {{ section.settings.title_size }}px);
    line-height: 1;
    color: var(--text-color);
    margin: 0;
    text-transform: uppercase;
  }
  
  .hp36-best__title em {
    font-style: italic;
    text-transform: lowercase;
  }

  .hp36-best__subtitle {
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--text-color);
    text-transform: uppercase;
    letter-spacing: 0.2em;
  }

  .hp36-best__carousel {
    display: flex;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  
  .hp36-best__carousel::-webkit-scrollbar {
    display: none;
  }

  .hp36-best__item {
    flex: 0 0 400px;
    border-right: 1px solid var(--border-color);
    text-decoration: none;
    display: flex;
    flex-direction: column;
    group: card;
  }

  @media screen and (max-width: 768px) {
    .hp36-best__item {
      flex: 0 0 300px;
    }
  }

  .hp36-best__image-wrap {
    aspect-ratio: 3/4;
    position: relative;
    overflow: hidden;
    background: #f4f4f4;
  }

  .hp36-best__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%);
    transition: filter 0.4s ease, transform 0.8s ease;
  }

  .hp36-best__item:hover .hp36-best__image {
    filter: grayscale(0%);
    transform: scale(1.05);
  }

  .hp36-best__info {
    padding: 30px;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    border-top: 1px solid var(--border-color);
  }

  .hp36-best__product-title {
    font-family: var(--font-serif);
    font-size: 20px;
    color: var(--text-color);
    margin: 0 0 10px;
    max-width: 80%;
  }

  .hp36-best__price {
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--text-color);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp36-best-wrapper" id="HP36Best-{{ section.id }}">
  <div class="hp36-best__header">
    <h2 class="hp36-best__title">{{ section.settings.title | replace: 'Icons', '<em>Icons</em>' }}</h2>
    {%- if section.settings.subtitle != blank -%}
      <div class="hp36-best__subtitle">{{ section.settings.subtitle }}</div>
    {%- endif -%}
  </div>

  <div class="hp36-best__carousel">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.product_link | default: '#' }}" class="hp36-best__item" {{ block.shopify_attributes }}>
        <div class="hp36-best__image-wrap">
          {%- if block.settings.image != blank -%}
            <img height="{{ block.settings.image.height }}" width="{{ block.settings.image.width }}" src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title | escape }}" class="hp36-best__image" loading="lazy">
          {%- else -%}
            {%- assign placeholder = 'product-' | append: forloop.index -%}
            {%- if forloop.index > 6 -%}{%- assign placeholder = 'product-1' -%}{%- endif -%}
            {{ placeholder | placeholder_svg_tag: 'hp36-best__image' }}
          {%- endif -%}
        </div>
        
        <div class="hp36-best__info">
          <h3 class="hp36-best__product-title">{{ block.settings.title }}</h3>
          <div class="hp36-best__price">{{ block.settings.price }}</div>
        </div>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "HP36 - Editorial Carousel",
  "class": "section-hp36-bestsellers",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Modern Icons"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "MOST DESIRED"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 40,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 80
    },
    {
      "type": "header",
      "content": "Editorial Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 0
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Structured Blazer"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "$650"
        },
        {
          "type": "url",
          "id": "product_link",
          "label": "Product Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP36 - Editorial Carousel",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
