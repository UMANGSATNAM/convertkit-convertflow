{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: "#080B10" }};
    padding: 90px 20px;
  }

  .hp43-faq__wrap {
    max-width: 860px;
    margin: 0 auto;
  }

  .hp43-faq__title {
    font-family: 'Orbitron', sans-serif;
    font-size: 32px;
    font-weight: 800;
    color: #F1F5F9;
    text-align: center;
    margin: 0 0 45px;
    text-transform: uppercase;
  }

  .hp43-faq__item {
    background: #101622;
    border: 1px solid #1E293B;
    border-radius: 6px;
    padding: 24px;
    margin-bottom: 18px;
    box-shadow: 0 10px 25px rgba(0,0,0,0.4);
  }

  .hp43-faq__q {
    font-family: 'Orbitron', sans-serif;
    font-size: 17px;
    font-weight: 700;
    color: #00F0FF;
    margin: 0 0 10px;
    text-transform: uppercase;
  }

  .hp43-faq__a {
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    color: #64748B;
    line-height: 1.65;
    margin: 0;
  }
{%- endstyle -%}

<div class="hp43-faq__wrap">
  <h2 class="hp43-faq__title">TECHNICAL KNOWLEDGE BASE</h2>

  <div class="hp43-faq__item">
    <h3 class="hp43-faq__q">// HOW DOES INTERNATIONAL COURIER DISPATCH WORK?</h3>
    <p class="hp43-faq__a">All orders are dispatched from our automated hubs within 24 hours via express DHL/FedEx air freight. Taxes and duties are pre-cleared at checkout for seamless doorstep arrival.</p>
  </div>

  <div class="hp43-faq__item">
    <h3 class="hp43-faq__q">// WHAT DOES THE 2-YEAR WARRANTY COVER?</h3>
    <p class="hp43-faq__a">Full hardware replacement for any manufacturing defects, PCB anomalies, or component failures with zero out-of-pocket shipping costs for warranty exchanges.</p>
  </div>

  <div class="hp43-faq__item">
    <h3 class="hp43-faq__q">// CAN I CUSTOMIZE SWITCHES AND KEYCAPS?</h3>
    <p class="hp43-faq__a">Yes, all our keyboards feature universal 5-pin hot-swappable sockets compatible with Cherry, Gateron, Kailh, and custom artisan switches.</p>
  </div>
</div>

{% schema %}
{
  "name": "HP43 - Cyber FAQ",
  "class": "section-hp43-faq",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#080B10"
    }
  ],
  "presets": [
    {
      "name": "HP43 - Cyber FAQ"
    }
  ]
}
{% endschema %}
