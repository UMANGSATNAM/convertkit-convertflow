{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#FEFCE8' }};
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }
  .hp60-test__container { max-width: {{ section.settings.container_width | default: 1280 }}px; margin: 0 auto; padding: 0 24px; }
  .hp60-test__header { text-align: center; margin-bottom: 50px; }
  .hp60-test__eyebrow { font-family: 'Outfit', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: #3F6212; margin: 0 0 12px; }
  .hp60-test__heading { font-family: 'Bodoni Moda', serif; font-size: clamp(28px, 3.5vw, 42px); font-weight: 700; color: #1E293B; margin: 0; }
  .hp60-test__grid { display: grid; grid-template-columns: repeat({{ section.settings.columns | default: 3 }}, 1fr); gap: 20px; }
  .hp60-test__card { background: #FFFFFF; border: 1px solid rgba(63, 98, 18, 0.2); border-radius: 6px; padding: 32px 24px; box-shadow: 0 4px 20px rgba(63, 98, 18, 0.05); }
  .hp60-test__stars { color: #D97706; font-size: 16px; margin-bottom: 16px; letter-spacing: 2px; }
  .hp60-test__quote { font-family: 'Bodoni Moda', serif; font-size: 17px; font-style: italic; line-height: 1.6; color: #334155; margin: 0 0 20px; }
  .hp60-test__author { font-family: 'Outfit', sans-serif; font-size: 13px; font-weight: 700; color: #1E293B; margin: 0; }
  .hp60-test__role { font-size: 11px; color: #3F6212; margin: 4px 0 0; letter-spacing: 1px; text-transform: uppercase; }
  @media screen and (max-width: 992px) { .hp60-test__grid { grid-template-columns: 1fr; max-width: 600px; margin: 0 auto; } }
{%- endstyle -%}
<div class="hp60-test__container">
  <div class="hp60-test__header">
    {%- if section.settings.eyebrow != blank -%}<p class="hp60-test__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="hp60-test__heading">{{ section.settings.heading | default: 'Patron Accolades' }}</h2>
  </div>
  <div class="hp60-test__grid">
    {%- for block in section.blocks -%}
      <div class="hp60-test__card" {{ block.shopify_attributes }}>
        <div class="hp60-test__stars">{{ block.settings.stars | default: '★★★★★' }}</div>
        <p class="hp60-test__quote">"{{ block.settings.quote | default: 'The Tuscan olive leaf cream smoothed my fine lines like an Italian spa treatment.' }}"</p>
        <p class="hp60-test__author">{{ block.settings.author | default: 'Giulia Bertolucci' }}</p>
        <p class="hp60-test__role">{{ block.settings.role | default: 'Florence Beauty Director' }}</p>
      </div>
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "HP60 Reviews",
  "class": "section-hp60-test",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FEFCE8" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "🏛️ REVIEWS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Patron Accolades" },
    { "type": "range", "id": "columns", "min": 1, "max": 3, "step": 1, "label": "Columns", "default": 3 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "blocks": [{ "type": "testimonial", "name": "Review", "settings": [
    { "type": "text", "id": "stars", "label": "Stars", "default": "★★★★★" },
    { "type": "textarea", "id": "quote", "label": "Quote", "default": "The Tuscan olive leaf cream smoothed my fine lines like an Italian spa treatment." },
    { "type": "text", "id": "author", "label": "Author", "default": "Giulia Bertolucci" },
    { "type": "text", "id": "role", "label": "Role", "default": "Florence Beauty Director" }
  ]}],
  "presets": [{ "name": "HP60 Reviews", "blocks": [
    { "type": "testimonial" },
    { "type": "testimonial", "settings": { "quote": "The pure aroma of fresh bergamot and Mediterranean sunshine in every drop.", "author": "Marco V.", "role": "Sommelier & Organic Enthusiast" } },
    { "type": "testimonial", "settings": { "quote": "My pigmentation faded significantly within 3 weeks of the C-Serum.", "author": "Elena Rossi", "role": "Milan Dermatologist" } }
  ]}]
}
{% endschema %}
