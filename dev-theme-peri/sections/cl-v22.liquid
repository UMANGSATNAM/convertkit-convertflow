{% comment %} CL V22 — Kids Toys / Playful {% endcomment %}
{{ 'component-facets.css' | asset_url | stylesheet_tag }}
<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
<style>
  .clv22 { background: {{ section.settings.bg_color | default: '#FFF9E6' }}; color: {{ section.settings.text_color | default: '#333' }}; padding: 50px 20px; font-family: 'Fredoka One', cursive; }
  .clv22-hero { text-align: center; margin-bottom: 50px; background: #FF6B6B; border-radius: 40px; padding: 60px; color: #FFF; border: 5px solid #111; box-shadow: 8px 8px 0px #111; }
  .clv22-hero h1 { font-size: 50px; margin-bottom: 15px; letter-spacing: 2px; text-transform: uppercase; text-shadow: 3px 3px 0px #111; }
  .clv22-hero p { font-size: 18px; font-family: 'Quicksand', sans-serif; font-weight: 700; max-width: 600px; margin: 0 auto; background: rgba(0,0,0,0.2); padding: 10px 20px; border-radius: 20px; }
  .clv22-chips { display: flex; gap: 15px; justify-content: center; margin-bottom: 40px; flex-wrap: wrap; }
  .clv22-chips a { padding: 12px 25px; background: #4ECDC4; color: #FFF; text-decoration: none; font-size: 16px; border-radius: 30px; border: 3px solid #111; box-shadow: 4px 4px 0px #111; transition: 0.2s; }
  .clv22-chips a:hover, .clv22-chips a.active { background: #FFE66D; color: #111; transform: translateY(-3px); box-shadow: 4px 7px 0px #111; }
  .clv22-toolbar { display: flex; justify-content: space-between; align-items: center; background: #FFF; border: 4px dashed #FF6B6B; border-radius: 20px; padding: 20px; margin-bottom: 40px; font-family: 'Quicksand', sans-serif; }
  .clv22-grid { display: grid; grid-template-columns: repeat({{ section.settings.cols_desktop | default: 4 }}, 1fr); gap: 30px; }
  .clv22-promo { grid-column: span 1; background: #1A535C; border: 4px solid #111; border-radius: 30px; box-shadow: 6px 6px 0px #111; padding: 40px; text-align: center; display: flex; flex-direction: column; justify-content: center; color: #FFF; }
  .clv22-promo h3 { font-size: 28px; margin-bottom: 20px; }
  .clv22-promo a { display: inline-block; padding: 12px 24px; background: #FFE66D; color: #111; text-decoration: none; border-radius: 20px; font-size: 16px; border: 3px solid #111; box-shadow: 3px 3px 0px #111; }
  .clv22-seo { margin-top: 60px; text-align: center; padding: 50px; background: #4ECDC4; border-radius: 40px; border: 5px solid #111; color: #FFF; }
  @media (max-width: 768px) { .clv22-grid { grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr); gap: 20px; } .clv22-hero h1 { font-size: 36px; } }
</style>
<div class="clv22" style="max-width: 1300px; margin: 0 auto;">
  <div class="clv22-hero">
    <h1>{% if collection.title != blank %}{{ collection.title | escape }}{% else %}Playtime Fun{% endif %}</h1>
    <p>{% if collection.description != blank %}{{ collection.description }}{% else %}Toys that spark imagination and joy.{% endif %}</p>
  </div>
  {% if section.settings.sub_collections != blank %}
    <div class="clv22-chips">
      {% for link in section.settings.sub_collections.links %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% endfor %}
    </div>
  {% endif %}
  <div class="clv22-toolbar">
    <facet-filters-form style="width: 100%;">
      <form id="FacetFiltersForm" style="display: flex; justify-content: space-between; align-items: center; width: 100%; flex-wrap: wrap; gap: 20px;">
        <div style="display: flex; gap: 20px;">
          {%- for filter in collection.filters -%}
            <details style="position: relative;">
              <summary style="cursor: pointer; font-size: 16px; font-weight: 700; color: #1A535C;">{{ filter.label }} ✨</summary>
              <div style="position: absolute; background: #FFF; border: 3px solid #111; padding: 20px; border-radius: 15px; z-index: 10; margin-top: 15px; min-width: 220px; box-shadow: 5px 5px 0px #111;">
                {%- for value in filter.values -%}
                  <label style="display: block; margin-bottom: 12px; cursor: pointer; font-size: 15px; font-weight: 600; color: #333;">
                    <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %}>
                    {{ value.label }} ({{ value.count }})
                  </label>
                {%- endfor -%}
              </div>
            </details>
          {%- endfor -%}
        </div>
        <select name="sort_by" onchange="this.form.submit()" style="background: #FFE66D; border: 3px solid #111; padding: 10px 20px; border-radius: 15px; font-size: 15px; font-weight: 700; cursor: pointer; box-shadow: 3px 3px 0px #111;">
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>
          {%- endfor -%}
        </select>
      </form>
    </facet-filters-form>
  </div>
  {% assign limit_num = section.settings.products_per_page | default: 16 %}
  {% paginate collection.products by limit_num %}
    <div class="clv22-grid">
      {% for product in collection.products %}
        {% render 'card-v22', product: product %}
        {% if forloop.index == 8 and section.settings.show_promo_tile %}
          <div class="clv22-promo">
            <h3>🎁 Gift Cards</h3>
            <a href="/products/gift-card">Buy Now</a>
          </div>
        {% endif %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v22', product: nil %}
        {% endfor %}
      {% endfor %}
    </div>
    <div style="margin-top: 50px; text-align: center; font-size: 20px;">{{ paginate | default_pagination }}</div>
  {% endpaginate %}
  {% if section.settings.show_seo_block %}
    <div class="clv22-seo">
      <h2 style="font-size: 32px; margin-bottom: 15px; text-shadow: 2px 2px 0px #111;">{{ section.settings.seo_title | default: 'Safe & Sustainable' }}</h2>
      <p style="font-family: 'Quicksand', sans-serif; font-size: 18px; font-weight: 700; max-width: 700px; margin: 0 auto; line-height: 1.6;">{{ section.settings.seo_text | default: 'Every toy is tested for safety and made with non-toxic materials. Because they deserve the best.' }}</p>
    </div>
  {% endif %}
</div>
{% schema %}
{
  "name": "CL V22 — Kids", "settings": [
    {"type": "range", "id": "products_per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 16},
    {"type": "range", "id": "cols_desktop", "label": "Desktop Columns", "min": 2, "max": 5, "default": 4},
    {"type": "select", "id": "cols_mobile", "label": "Mobile Columns", "options": [{"value": "1", "label": "1"}, {"value": "2", "label": "2"}], "default": "2"},
    {"type": "link_list", "id": "sub_collections", "label": "Sub-Collection Menu"},
    {"type": "checkbox", "id": "show_promo_tile", "label": "Show Promo Card", "default": true},
    {"type": "checkbox", "id": "show_seo_block", "label": "Show SEO Block", "default": true},
    {"type": "color", "id": "bg_color", "label": "Background Color", "default": "#FFF9E6"},
    {"type": "color", "id": "text_color", "label": "Text Color", "default": "#333333"}
  ], "presets": [{"name": "CL V22 — Kids"}]
}
{% endschema %}
