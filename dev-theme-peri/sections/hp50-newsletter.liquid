{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp50-news-bg: {{ section.settings.bg_color | default: '#000000' }};
    
    background-color: var(--hp50-news-bg);
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }

  .hp50-news__box {
    max-width: {{ section.settings.container_width | default: 760 }}px;
    margin: 0 auto;
    padding: 50px 40px;
    background: #111111;
    border: 1px solid rgba(226, 232, 240, 0.25);
    text-align: center;
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.8);
  }

  .hp50-news__title {
    font-family: 'Italiana', serif;
    font-size: clamp(32px, 4.5vw, 44px);
    font-weight: 400;
    color: #FFFFFF;
    margin: 0 0 12px;
    letter-spacing: 1px;
  }

  .hp50-news__desc {
    font-size: 14px;
    line-height: 1.8;
    color: #94A3B8;
    margin: 0 0 32px;
  }

  .hp50-news__form {
    display: flex;
    gap: 12px;
    max-width: 500px;
    margin: 0 auto;
  }

  .hp50-news__input {
    flex: 1;
    padding: 15px 20px;
    background: #000000;
    border: 1px solid rgba(226, 232, 240, 0.3);
    color: #FFFFFF;
    font-size: 13px;
    outline: none;
    font-family: 'Syne', sans-serif;
  }

  .hp50-news__input:focus { border-color: #FFFFFF; }

  .hp50-news__btn {
    padding: 15px 32px;
    background: #FFFFFF;
    color: #000000;
    border: 1px solid #FFFFFF;
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: 12px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .hp50-news__btn:hover { background: transparent; color: #FFFFFF; }

  @media screen and (max-width: 600px) {
    .hp50-news__box { padding: 36px 20px; }
    .hp50-news__form { flex-direction: column; }
  }
{%- endstyle -%}

<div class="hp50-news__box">
  <h2 class="hp50-news__title">{{ section.settings.heading | default: 'The Runway Syndicate' }}</h2>
  <p class="hp50-news__desc">{{ section.settings.description | default: 'Subscribe to receive private backstage dispatch notifications and an instant 15% VIP welcome code.' }}</p>
  <form class="hp50-news__form" onsubmit="event.preventDefault(); alert('Subscribed to Runway Syndicate.');">
    <input type="email" class="hp50-news__input" placeholder="{{ section.settings.placeholder | default: 'Enter your email address' }}" required>
    <button type="submit" class="hp50-news__btn">{{ section.settings.btn_text | default: 'Subscribe' }}</button>
  </form>
</div>

{% schema %}
{
  "name": "HP50 - Runway News",
  "class": "section-hp50-news",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#000000" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Runway Syndicate" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Subscribe to receive private backstage dispatch notifications." },
    { "type": "text", "id": "placeholder", "label": "Placeholder", "default": "Enter your email address" },
    { "type": "text", "id": "btn_text", "label": "Button Text", "default": "Subscribe" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 500, "max": 1000, "step": 20, "unit": "px", "label": "Container Width", "default": 760 }
  ],
  "presets": [
    { "name": "HP50 - Runway News" }
  ]
}
{% endschema %}
