{%- liquid
  assign sec_id = section.id
  assign bg_color = section.settings.bg_color
  assign text_color = section.settings.text_color
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
  assign title = section.settings.title
-%}

<style>
  .hp19-collist-{{ sec_id }} {
    background-color: {{ bg_color }};
    padding-top: {{ padding_top }}px;
    padding-bottom: {{ padding_bottom }}px;
  }

  .hp19-collist-{{ sec_id }}__container {
    max-width: var(--page-width, 1400px);
    margin: 0 auto;
    padding: 0 40px;
  }

  .hp19-collist-{{ sec_id }}__header {
    text-align: center;
    margin-bottom: 80px;
  }

  .hp19-collist-{{ sec_id }}__title {
    font-family: 'Times New Roman', Times, serif;
    font-size: clamp(36px, 5vw, 64px);
    color: {{ text_color }};
    font-weight: normal;
    margin: 0;
  }

  .hp19-collist-{{ sec_id }}__grid {
    display: flex;
    justify-content: center;
    gap: 60px;
    flex-wrap: wrap;
  }

  .hp19-collist-{{ sec_id }}__item {
    flex: 1 1 300px;
    max-width: 400px;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hp19-collist-{{ sec_id }}__image-wrap {
    width: 100%;
    aspect-ratio: 4/5;
    overflow: hidden;
    margin-bottom: 30px;
    position: relative;
    background-color: #f4f4f4;
  }

  .hp19-collist-{{ sec_id }}__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .hp19-collist-{{ sec_id }}__item:hover .hp19-collist-{{ sec_id }}__image {
    transform: scale(1.05);
  }

  .hp19-collist-{{ sec_id }}__name {
    font-family: 'Times New Roman', Times, serif;
    font-size: 24px;
    color: {{ text_color }};
    margin: 0 0 10px 0;
    font-weight: normal;
  }

  .hp19-collist-{{ sec_id }}__link-text {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: {{ text_color }};
    opacity: 0.6;
    transition: opacity 0.3s ease;
    position: relative;
    padding-bottom: 4px;
  }

  .hp19-collist-{{ sec_id }}__link-text::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0; width: 100%; height: 1px;
    background-color: {{ text_color }};
    transform-origin: right;
    transform: scaleX(0);
    transition: transform 0.4s ease;
  }

  .hp19-collist-{{ sec_id }}__item:hover .hp19-collist-{{ sec_id }}__link-text {
    opacity: 1;
  }
  .hp19-collist-{{ sec_id }}__item:hover .hp19-collist-{{ sec_id }}__link-text::after {
    transform-origin: left;
    transform: scaleX(1);
  }

  @media screen and (max-width: 992px) {
    .hp19-collist-{{ sec_id }}__grid { gap: 30px; }
  }

  @media screen and (max-width: 768px) {
    .hp19-collist-{{ sec_id }}__container { padding: 0 20px; }
    .hp19-collist-{{ sec_id }}__header { margin-bottom: 50px; }
    .hp19-collist-{{ sec_id }}__item { flex: 1 1 100%; max-width: 100%; }
  }
</style>

<section class="hp19-collist-{{ sec_id }}">
  <div class="hp19-collist-{{ sec_id }}__container">
    
    {% if title != blank %}
    <div class="hp19-collist-{{ sec_id }}__header">
      <h2 class="hp19-collist-{{ sec_id }}__title">{{ title }}</h2>
    </div>
    {% endif %}

    <div class="hp19-collist-{{ sec_id }}__grid">
      {% for block in section.blocks %}
        <a href="{{ block.settings.collection.url | default: '#' }}" class="hp19-collist-{{ sec_id }}__item" {{ block.shopify_attributes }}>
          <div class="hp19-collist-{{ sec_id }}__image-wrap">
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title }}" class="hp19-collist-{{ sec_id }}__image" loading="lazy">
            {% elsif block.settings.collection.image %}
              <img src="{{ block.settings.collection.image | image_url: width: 600 }}" alt="{{ block.settings.title }}" class="hp19-collist-{{ sec_id }}__image" loading="lazy">
            {% else %}
              {% capture tmp_class %}hp19-collist-{{ sec_id }}__image{% endcapture %}{{ 'collection-' | append: forloop.index  | placeholder_svg_tag: tmp_class }}
            {% endif %}
          </div>
          
          <h3 class="hp19-collist-{{ sec_id }}__name">
            {{ block.settings.title | default: block.settings.collection.title | default: 'Collection' }}
          </h3>
          <span class="hp19-collist-{{ sec_id }}__link-text">Discover</span>
        </a>
      {% else %}
        <a href="#" class="hp19-collist-{{ sec_id }}__item">
          <div class="hp19-collist-{{ sec_id }}__image-wrap">{% capture tmp_class %}hp19-collist-{{ sec_id }}__image{% endcapture %}{{ 'collection-1'  | placeholder_svg_tag: tmp_class }}</div>
          <h3 class="hp19-collist-{{ sec_id }}__name">Womenswear</h3>
          <span class="hp19-collist-{{ sec_id }}__link-text">Discover</span>
        </a>
        <a href="#" class="hp19-collist-{{ sec_id }}__item">
          <div class="hp19-collist-{{ sec_id }}__image-wrap">{% capture tmp_class %}hp19-collist-{{ sec_id }}__image{% endcapture %}{{ 'collection-2'  | placeholder_svg_tag: tmp_class }}</div>
          <h3 class="hp19-collist-{{ sec_id }}__name">Menswear</h3>
          <span class="hp19-collist-{{ sec_id }}__link-text">Discover</span>
        </a>
        <a href="#" class="hp19-collist-{{ sec_id }}__item">
          <div class="hp19-collist-{{ sec_id }}__image-wrap">{% capture tmp_class %}hp19-collist-{{ sec_id }}__image{% endcapture %}{{ 'collection-3'  | placeholder_svg_tag: tmp_class }}</div>
          <h3 class="hp19-collist-{{ sec_id }}__name">Accessories</h3>
          <span class="hp19-collist-{{ sec_id }}__link-text">Discover</span>
        </a>
      {% endfor %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "HP19 Luxury Collection",
  "max_blocks": 3,
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "The Collections"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 10,
      "unit": "px",
      "label": "Padding Top",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 10,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 100
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection Block",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom Title"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP19 Luxury Collection",
      "blocks": [
        { "type": "collection", "settings": { "title": "Womenswear" } },
        { "type": "collection", "settings": { "title": "Menswear" } },
        { "type": "collection", "settings": { "title": "Accessories" } }
      ]
    }
  ]
}
{% endschema %}
