{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp44-usp-bg: {{ section.settings.bg_color | default: '#EDF4EE' }};
    --hp44-card-bg: {{ section.settings.card_bg | default: '#FFFFFF' }};
    --hp44-card-border: {{ section.settings.card_border | default: '#D8E8DC' }};
    --hp44-title-color: {{ section.settings.title_color | default: '#143D2B' }};
    --hp44-desc-color: {{ section.settings.desc_color | default: '#406352' }};
    
    background-color: var(--hp44-usp-bg);
    padding-top: {{ section.settings.padding_top | default: 70 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 70 }}px;
  }

  .hp44-usp__grid {
    max-width: {{ section.settings.container_width | default: 1280 }}px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: 4 }}, 1fr);
    gap: 24px;
  }

  .hp44-usp__card {
    background: var(--hp44-card-bg);
    border: 1px solid var(--hp44-card-border);
    border-radius: 20px;
    padding: 36px 24px;
    text-align: center;
    box-shadow: 0 10px 30px rgba(20, 61, 43, 0.04);
    transition: all 0.3s ease;
  }

  .hp44-usp__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 15px 40px rgba(20, 61, 43, 0.08);
  }

  .hp44-usp__icon {
    width: 60px;
    height: 60px;
    background: #EDF4EE;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 26px;
    margin-bottom: 18px;
  }

  .hp44-usp__title {
    font-family: 'Playfair Display', serif;
    font-size: 19px;
    font-weight: 700;
    color: var(--hp44-title-color);
    margin: 0 0 10px;
  }

  .hp44-usp__text {
    font-size: 14px;
    line-height: 1.65;
    color: var(--hp44-desc-color);
    margin: 0;
  }

  @media screen and (max-width: 992px) {
    .hp44-usp__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
  }

  @media screen and (max-width: 576px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | default: 70 | times: 0.7 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | default: 70 | times: 0.7 | round }}px;
    }
    .hp44-usp__grid {
      grid-template-columns: 1fr;
    }
    .hp44-usp__card {
      padding: 28px 20px;
    }
  }
{%- endstyle -%}

<div class="hp44-usp__grid">
  {%- if section.blocks.size > 0 -%}
    {%- for block in section.blocks -%}
      <div class="hp44-usp__card" {{ block.shopify_attributes }}>
        <div class="hp44-usp__icon">{{ block.settings.icon | default: '🌿' }}</div>
        <h3 class="hp44-usp__title">{{ block.settings.title }}</h3>
        <p class="hp44-usp__text">{{ block.settings.description }}</p>
      </div>
    {%- endfor -%}
  {%- else -%}
    <div class="hp44-usp__card">
      <div class="hp44-usp__icon">🌿</div>
      <h3 class="hp44-usp__title">Nordic Clary Sage</h3>
      <p class="hp44-usp__text">Naturally rich in balancing linalyl acetate to soothe skin irritation and redness.</p>
    </div>
    <div class="hp44-usp__card">
      <div class="hp44-usp__icon">🌱</div>
      <h3 class="hp44-usp__title">Bio-Fermented Active</h3>
      <p class="hp44-usp__text">Micro-fermentation enhances nutrient absorption by 400% for deeper barrier repair.</p>
    </div>
    <div class="hp44-usp__card">
      <div class="hp44-usp__icon">✈️</div>
      <h3 class="hp44-usp__title">Pre-Paid Global Duties</h3>
      <p class="hp44-usp__text">Express door delivery with zero hidden customs tariffs in over 180 countries.</p>
    </div>
    <div class="hp44-usp__card">
      <div class="hp44-usp__icon">🛡️</div>
      <h3 class="hp44-usp__title">Pure Botanicals Shield</h3>
      <p class="hp44-usp__text">Cruelty-free, vegan certified, with 100% recyclable frosted amber glass vessels.</p>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "HP44 - Sage Pillars",
  "class": "section-hp44-usp",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#EDF4EE" },
    { "type": "color", "id": "card_bg", "label": "Card Background", "default": "#FFFFFF" },
    { "type": "color", "id": "card_border", "label": "Card Border", "default": "#D8E8DC" },
    { "type": "color", "id": "title_color", "label": "Title Color", "default": "#143D2B" },
    { "type": "color", "id": "desc_color", "label": "Description Color", "default": "#406352" },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "label": "Desktop Columns", "default": 4 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 70 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 70 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "USP Card",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon / Emoji", "default": "🌿" },
        { "type": "text", "id": "title", "label": "Title", "default": "Nordic Clary Sage" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Naturally rich in balancing linalyl acetate to soothe skin irritation and redness." }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP44 - Sage Pillars",
      "blocks": [
        { "type": "pillar", "settings": { "icon": "🌿", "title": "Nordic Clary Sage", "description": "Naturally rich in balancing linalyl acetate to soothe skin irritation and redness." } },
        { "type": "pillar", "settings": { "icon": "🌱", "title": "Bio-Fermented Active", "description": "Micro-fermentation enhances nutrient absorption by 400% for deeper barrier repair." } },
        { "type": "pillar", "settings": { "icon": "✈️", "title": "Pre-Paid Global Duties", "description": "Express door delivery with zero hidden customs tariffs in over 180 countries." } },
        { "type": "pillar", "settings": { "icon": "🛡️", "title": "Pure Botanicals Shield", "description": "Cruelty-free, vegan certified, with 100% recyclable frosted amber glass vessels." } }
      ]
    }
  ]
}
{% endschema %}
