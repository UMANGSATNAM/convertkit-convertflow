{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;700;900&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    
    --font-heading: 'Inter', sans-serif;
    --font-body: 'Inter', sans-serif;
    
    background-color: var(--bg-color);
    border-bottom: 2px solid var(--text-color);
  }

  .hp40-usp-wrapper {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }

  @media screen and (max-width: 992px) {
    .hp40-usp-wrapper {
      grid-template-columns: 1fr;
    }
  }

  .hp40-usp__card {
    padding: 60px 40px;
    border-right: 2px solid var(--text-color);
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    position: relative;
    overflow: hidden;
    transition: background 0.3s ease, color 0.3s ease;
  }

  .hp40-usp__card:last-child {
    border-right: none;
  }

  @media screen and (max-width: 992px) {
    .hp40-usp__card {
      border-right: none;
      border-bottom: 2px solid var(--text-color);
    }
    .hp40-usp__card:last-child {
      border-bottom: none;
    }
  }

  .hp40-usp__card:hover {
    background: var(--text-color);
    color: var(--bg-color);
  }

  /* Target elements on hover */
  .hp40-usp__card:hover .hp40-usp__number {
    color: var(--bg-color);
    opacity: 0.2;
  }
  .hp40-usp__card:hover .hp40-usp__title {
    color: var(--bg-color);
  }
  .hp40-usp__card:hover .hp40-usp__text {
    color: var(--bg-color);
  }
  .hp40-usp__card:hover .hp40-usp__icon {
    background: var(--accent-color);
  }

  .hp40-usp__number {
    position: absolute;
    top: -20px;
    right: -20px;
    font-family: var(--font-heading);
    font-size: 180px;
    font-weight: 900;
    line-height: 1;
    color: var(--text-color);
    opacity: 0.05;
    letter-spacing: -10px;
    pointer-events: none;
    transition: color 0.3s ease, opacity 0.3s ease;
  }

  .hp40-usp__icon {
    width: 60px;
    height: 60px;
    background: var(--text-color);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 40px;
    transition: background 0.3s ease;
  }

  .hp40-usp__icon svg {
    width: 30px;
    height: 30px;
    fill: var(--bg-color);
  }

  .hp40-usp__title {
    font-family: var(--font-heading);
    font-size: clamp(24px, 3vw, {{ section.settings.title_size }}px);
    font-weight: 700;
    color: var(--text-color);
    margin: 0 0 15px;
    letter-spacing: -1px;
    text-transform: uppercase;
    transition: color 0.3s ease;
    position: relative;
    z-index: 2;
  }

  .hp40-usp__text {
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.5;
    font-weight: 400;
    color: var(--text-color);
    margin: 0;
    opacity: 0.8;
    max-width: 80%;
    transition: color 0.3s ease;
    position: relative;
    z-index: 2;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp40-usp-wrapper" id="HP40Usp-{{ section.id }}">
  {%- for block in section.blocks limit: 3 -%}
    <div class="hp40-usp__card" {{ block.shopify_attributes }}>
      <div class="hp40-usp__number">0{{ forloop.index }}</div>
      
      <div class="hp40-usp__icon">
        <svg viewBox="0 0 24 24"><path d="M12 2L2 22h20L12 2zm0 3.8L18.4 19H5.6L12 5.8z"/></svg>
      </div>
      
      <h3 class="hp40-usp__title">{{ block.settings.title }}</h3>
      {%- if block.settings.text != blank -%}
        <p class="hp40-usp__text">{{ block.settings.text }}</p>
      {%- endif -%}
    </div>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "HP40 - Swiss USP",
  "class": "section-hp40-usp",
  "settings": [
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 16,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 36
    },
    {
      "type": "header",
      "content": "Swiss Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#F4F4F4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text & Lines",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color (Hover Icon)",
      "default": "#0055FF"
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "SYSTEMATIC"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Logical organization of elements based on a strict grid system."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP40 - Swiss USP",
      "blocks": [
        { "type": "benefit", "settings": { "title": "PRECISION" } },
        { "type": "benefit", "settings": { "title": "CLARITY" } },
        { "type": "benefit", "settings": { "title": "OBJECTIVITY" } }
      ]
    }
  ]
}
{% endschema %}
