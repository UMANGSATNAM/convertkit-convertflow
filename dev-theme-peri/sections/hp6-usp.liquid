{%- liquid
  assign bg_color = section.settings.bg_color | default: '#111111'
  assign text_color = section.settings.text_color | default: '#ffffff'
  assign accent_color = section.settings.accent_color | default: '#ff4500'
  
  assign padding_top_desktop = section.settings.padding_top_desktop
  assign padding_bottom_desktop = section.settings.padding_bottom_desktop
  assign padding_top_mobile = section.settings.padding_top_mobile
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile
-%}

<style>
  #shopify-section-{{ section.id }} {
    --hp6-usp-bg: {{ bg_color }};
    --hp6-usp-text: {{ text_color }};
    --hp6-usp-accent: {{ accent_color }};
    
    --hp6-usp-pt-desk: {{ padding_top_desktop }}px;
    --hp6-usp-pb-desk: {{ padding_bottom_desktop }}px;
    --hp6-usp-pt-mob: {{ padding_top_mobile }}px;
    --hp6-usp-pb-mob: {{ padding_bottom_mobile }}px;
  }

  .hp6-sports-usp-{{ section.id }} {
    padding-top: var(--hp6-usp-pt-desk);
    padding-bottom: var(--hp6-usp-pb-desk);
    background-color: var(--hp6-usp-bg);
    color: var(--hp6-usp-text);
    font-family: 'Inter', sans-serif;
  }

  .hp6-usp-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .hp6-usp-grid {
    display: grid;
    grid-template-columns: repeat({{ section.blocks.size | default: 4 | at_most: 4 }}, 1fr);
    gap: 30px;
  }

  .hp6-usp-item {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 40px;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.05);
    border-radius: 4px;
    clip-path: polygon(10% 0, 100% 0, 100% 90%, 90% 100%, 0 100%, 0 10%);
    transition: all 0.4s ease;
    position: relative;
    overflow: hidden;
  }

  .hp6-usp-item::before {
    content: '';
    position: absolute;
    top: 0; left: 0;
    width: 4px; height: 100%;
    background: var(--hp6-usp-accent);
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 0.4s ease;
  }

  .hp6-usp-item:hover {
    background: rgba(255,255,255,0.05);
    transform: translateY(-5px);
  }
  .hp6-usp-item:hover::before {
    transform: scaleY(1);
  }

  .hp6-usp-icon {
    width: 50px;
    height: 50px;
    margin-bottom: 25px;
    color: var(--hp6-usp-accent);
  }
  .hp6-usp-icon svg, .hp6-usp-icon img {
    width: 100%; height: 100%;
    object-fit: contain;
  }

  .hp6-usp-title {
    font-family: 'Oswald', sans-serif;
    font-size: 22px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin: 0 0 15px 0;
    color: var(--hp6-usp-text);
  }

  .hp6-usp-desc {
    font-size: 15px;
    line-height: 1.6;
    color: rgba(255,255,255,0.6);
    margin: 0;
  }

  /* Responsive */
  @media screen and (max-width: 1024px) {
    .hp6-usp-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 768px) {
    .hp6-sports-usp-{{ section.id }} {
      padding-top: var(--hp6-usp-pt-mob);
      padding-bottom: var(--hp6-usp-pb-mob);
    }
    .hp6-usp-inner {
      padding: 0 20px;
    }
    .hp6-usp-grid {
      grid-template-columns: 1fr;
      gap: 15px;
    }
    .hp6-usp-item {
      padding: 30px;
      flex-direction: row;
      align-items: center;
      gap: 20px;
      clip-path: none;
      border-radius: 8px;
    }
    .hp6-usp-icon {
      margin-bottom: 0;
      width: 40px; height: 40px;
      flex-shrink: 0;
    }
    .hp6-usp-item::before { width: 3px; }
  }
</style>

<section class="hp6-sports-usp-{{ section.id }}" aria-label="Performance Features">
  <div class="hp6-usp-inner">
    <div class="hp6-usp-grid">
      
      {%- for block in section.blocks -%}
        <div class="hp6-usp-item" {{ block.shopify_attributes }}>
          <div class="hp6-usp-icon">
            {%- if block.settings.custom_icon != blank -%}
              <img height="{{ block.settings.custom_icon.height }}" width="{{ block.settings.custom_icon.width }}" src="{{ block.settings.custom_icon | image_url: width: 100 }}" loading="lazy" alt="{{ block.settings.title }}">
            {%- else -%}
              {%- case block.settings.icon -%}
                {%- when 'shield' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                {%- when 'wind' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9.59 4.59A2 2 0 1 1 11 8H2m10.59 11.41A2 2 0 1 0 14 16H2m15.73-8.27A2.5 2.5 0 1 1 19.5 12H2"/></svg>
                {%- when 'droplet' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/></svg>
                {%- when 'activity' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
              {%- endcase -%}
            {%- endif -%}
          </div>
          <div class="hp6-usp-content">
            <h3 class="hp6-usp-title">{{ block.settings.title }}</h3>
            <p class="hp6-usp-desc">{{ block.settings.text }}</p>
          </div>
        </div>
      {%- endfor -%}

      {%- if section.blocks.size == 0 -%}
        {%- for i in (1..4) -%}
          <div class="hp6-usp-item">
            <div class="hp6-usp-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <div class="hp6-usp-content">
              <h3 class="hp6-usp-title">PRO DURABILITY</h3>
              <p class="hp6-usp-desc">Engineered with rip-stop fabrics to withstand the most intense workouts.</p>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "HP6 Sports USP",
  "tag": "section",
  "class": "section-hp6-usp",
  "max_blocks": 4,
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#ff4500"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Top (Desktop)", "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Bottom (Desktop)", "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Top (Mobile)", "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Bottom (Mobile)", "default": 50
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shield", "label": "Shield" },
            { "value": "wind", "label": "Breathable/Wind" },
            { "value": "droplet", "label": "Sweat/Water" },
            { "value": "activity", "label": "Heartbeat/Activity" }
          ],
          "default": "shield"
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Custom Icon (Overrides above)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "PRO DURABILITY"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Engineered with rip-stop fabrics to withstand intense workouts."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP6 Sports USP",
      "category": "Features",
      "blocks": [
        { "type": "feature", "settings": { "title": "PRO DURABILITY", "icon": "shield" } },
        { "type": "feature", "settings": { "title": "ULTRA BREATHABLE", "icon": "wind" } },
        { "type": "feature", "settings": { "title": "SWEAT WICKING", "icon": "droplet" } },
        { "type": "feature", "settings": { "title": "MAX PERFORMANCE", "icon": "activity" } }
      ]
    }
  ]
}
{% endschema %}
