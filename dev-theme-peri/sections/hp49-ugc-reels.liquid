{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp49-ugc-bg: {{ section.settings.bg_color | default: '#F5F3FF' }};
    
    background-color: var(--hp49-ugc-bg);
    padding-top: {{ section.settings.padding_top | default: 70 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 70 }}px;
  }

  .hp49-ugc__wrap {
    max-width: {{ section.settings.container_width | default: 1240 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp49-ugc__header {
    text-align: center;
    margin-bottom: 40px;
  }

  .hp49-ugc__heading {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: clamp(28px, 4vw, 38px);
    font-weight: 800;
    color: #2E1065;
    margin: 0;
  }

  .hp49-ugc__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: 4 }}, 1fr);
    gap: 18px;
  }

  .hp49-ugc__card {
    aspect-ratio: 9/16;
    border-radius: 28px;
    overflow: hidden;
    position: relative;
    border: 1px solid rgba(124, 58, 237, 0.15);
    background: #EDE9FE;
    box-shadow: 0 10px 30px rgba(124, 58, 237, 0.08);
  }

  .hp49-ugc__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .hp49-ugc__card:hover .hp49-ugc__img { transform: scale(1.05); }

  .hp49-ugc__overlay {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    padding: 18px;
    background: linear-gradient(to top, rgba(46, 16, 101, 0.85), transparent);
    color: #FFFFFF;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
  }

  .hp49-ugc__handle {
    font-family: 'Urbanist', sans-serif;
    font-size: 13px;
    font-weight: 800;
    margin: 0 0 2px;
  }

  .hp49-ugc__tag {
    font-size: 11px;
    color: #E9D5FF;
    margin: 0;
  }

  @media screen and (max-width: 992px) {
    .hp49-ugc__grid { grid-template-columns: repeat(2, 1fr); }
  }
{%- endstyle -%}

<div class="hp49-ugc__wrap">
  <div class="hp49-ugc__header">
    <h2 class="hp49-ugc__heading">{{ section.settings.heading | default: 'Lavender Glow In Real Life' }}</h2>
  </div>

  <div class="hp49-ugc__grid">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <div class="hp49-ugc__card" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img height="{{ block.settings.image.height }}" width="{{ block.settings.image.width }}" src="{{ block.settings.image | image_url: width: 600 }}" class="hp49-ugc__img" alt="{{ block.settings.handle }}" loading="lazy">
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'hp49-ugc__img' }}
          {%- endif -%}
          <div class="hp49-ugc__overlay">
            <div>
              <p class="hp49-ugc__handle">{{ block.settings.handle | default: '@lavender_dreamer' }}</p>
              <p class="hp49-ugc__tag">{{ block.settings.tag | default: '#CloudSerumGlow' }}</p>
            </div>
            <span>▶</span>
          </div>
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="hp49-ugc__card">
        {{ 'lifestyle-2' | placeholder_svg_tag: 'hp49-ugc__img' }}
        <div class="hp49-ugc__overlay">
          <div><p class="hp49-ugc__handle">@claire_glow</p><p class="hp49-ugc__tag">#LavenderSerum</p></div>
          <span>▶</span>
        </div>
      </div>
      <div class="hp49-ugc__card">
        {{ 'lifestyle-2' | placeholder_svg_tag: 'hp49-ugc__img' }}
        <div class="hp49-ugc__overlay">
          <div><p class="hp49-ugc__handle">@blossom_skin</p><p class="hp49-ugc__tag">#CherryMist</p></div>
          <span>▶</span>
        </div>
      </div>
      <div class="hp49-ugc__card">
        {{ 'lifestyle-2' | placeholder_svg_tag: 'hp49-ugc__img' }}
        <div class="hp49-ugc__overlay">
          <div><p class="hp49-ugc__handle">@night_routine</p><p class="hp49-ugc__tag">#PillowMask</p></div>
          <span>▶</span>
        </div>
      </div>
      <div class="hp49-ugc__card">
        {{ 'lifestyle-2' | placeholder_svg_tag: 'hp49-ugc__img' }}
        <div class="hp49-ugc__overlay">
          <div><p class="hp49-ugc__handle">@cloud_beauty</p><p class="hp49-ugc__tag">#PastelBalm</p></div>
          <span>▶</span>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP49 - Lavender UGC",
  "class": "section-hp49-ugc",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#F5F3FF" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Lavender Glow In Real Life" },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "label": "Desktop Columns", "default": 4 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 70 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 70 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1240 }
  ],
  "blocks": [
    {
      "type": "reel",
      "name": "Reel Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "handle", "label": "Handle", "default": "@lavender_dreamer" },
        { "type": "text", "id": "tag", "label": "Tag", "default": "#CloudSerumGlow" }
      ]
    }
  ],
  "presets": [
    { "name": "HP49 - Lavender UGC" }
  ]
}
{% endschema %}
