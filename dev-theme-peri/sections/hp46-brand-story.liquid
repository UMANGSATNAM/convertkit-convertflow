{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp46-story-bg: {{ section.settings.bg_color | default: '#0B0F19' }};
    
    background-color: var(--hp46-story-bg);
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
    position: relative;
    overflow: hidden;
  }

  .hp46-story__container {
    max-width: {{ section.settings.container_width | default: 1240 }}px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  .hp46-story__media {
    background: rgba(15, 23, 42, 0.7);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(244, 114, 182, 0.3);
    border-radius: 28px;
    padding: 16px;
    box-shadow: 0 0 35px rgba(244, 114, 182, 0.15);
  }

  .hp46-story__img {
    width: 100%;
    height: 480px;
    object-fit: cover;
    border-radius: 18px;
    display: block;
  }

  .hp46-story__tag {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: #38BDF8;
    margin: 0 0 12px;
    text-transform: uppercase;
  }

  .hp46-story__title {
    font-family: 'Syne', sans-serif;
    font-size: clamp(32px, 4.5vw, 48px);
    font-weight: 800;
    line-height: 1.1;
    color: #FFFFFF;
    margin: 0 0 20px;
  }

  .hp46-story__title span {
    background: linear-gradient(135deg, #38BDF8, #F472B6);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hp46-story__desc {
    font-size: 16px;
    line-height: 1.75;
    color: #94A3B8;
    margin: 0 0 32px;
  }

  .hp46-story__grid-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    border-top: 1px solid rgba(56, 189, 248, 0.2);
    padding-top: 24px;
    margin-bottom: 36px;
  }

  .hp46-story__val {
    font-family: 'Syne', sans-serif;
    font-size: 28px;
    font-weight: 800;
    color: #38BDF8;
    margin: 0 0 4px;
  }

  .hp46-story__lbl {
    font-size: 12px;
    color: #64748B;
    margin: 0;
  }

  .hp46-story__btn {
    display: inline-flex;
    padding: 16px 36px;
    background: linear-gradient(135deg, #38BDF8, #F472B6);
    color: #0B0F19;
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: 14px;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 50px;
    box-shadow: 0 0 25px rgba(56, 189, 248, 0.3);
    transition: all 0.25s ease;
  }

  .hp46-story__btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 40px rgba(244, 114, 182, 0.5);
  }

  @media screen and (max-width: 992px) {
    .hp46-story__container { grid-template-columns: 1fr; text-align: center; }
    .hp46-story__img { height: 320px; }
  }
{%- endstyle -%}

<div class="hp46-story__container">
  <div class="hp46-story__media">
    {%- if section.settings.image != blank -%}
      <img height="{{ section.settings.image.height }}" width="{{ section.settings.image.width }}" src="{{ section.settings.image | image_url: width: 1000 }}" class="hp46-story__img" alt="Holographic Lab" loading="lazy">
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'hp46-story__img' }}
    {%- endif -%}
  </div>

  <div>
    <p class="hp46-story__tag">CYBER CELLULAR PROTOCOL</p>
    <h2 class="hp46-story__title">{{ section.settings.heading | default: 'THE FUTURE OF <span>CELLULAR OPTICS</span>' }}</h2>
    <p class="hp46-story__desc">
      {{ section.settings.description | default: 'Engineered at the intersection of deep-sea bioluminescence and quantum nanotechnology. We extract photon-reactive enzymes that synchronize with circadian epidermal repair cycles.' }}
    </p>

    <div class="hp46-story__grid-stats">
      <div>
        <p class="hp46-story__val">99.4%</p>
        <p class="hp46-story__lbl">BIO-ACTIVE PURITY</p>
      </div>
      <div>
        <p class="hp46-story__val">400%</p>
        <p class="hp46-story__lbl">OPTICAL GLOW</p>
      </div>
      <div>
        <p class="hp46-story__val">24HR</p>
        <p class="hp46-story__lbl">CELLULAR DEFENSE</p>
      </div>
    </div>

    <a href="{{ section.settings.btn_url | default: '/pages/about' }}" class="hp46-story__btn">
      {{ section.settings.btn_text | default: 'EXPLORE QUANTUM ATELIER &rarr;' }}
    </a>
  </div>
</div>

{% schema %}
{
  "name": "HP46 - Cyber Story",
  "class": "section-hp46-story",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#0B0F19" },
    { "type": "image_picker", "id": "image", "label": "Story Image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "THE FUTURE OF CELLULAR OPTICS" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Engineered at the intersection of deep-sea bioluminescence and quantum nanotechnology." },
    { "type": "text", "id": "btn_text", "label": "Button Text", "default": "EXPLORE QUANTUM ATELIER →" },
    { "type": "url", "id": "btn_url", "label": "Button URL" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1240 }
  ],
  "presets": [
    { "name": "HP46 - Cyber Story" }
  ]
}
{% endschema %}
