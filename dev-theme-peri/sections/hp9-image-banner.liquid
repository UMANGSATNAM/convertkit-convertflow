{%- liquid
  assign section_id = section.id
-%}

<style>
  #shopify-section-{{ section_id }} {
    position: relative;
    width: 100%;
    height: 70vh;
    min-height: 500px;
    background-color: #050505;
    overflow: hidden;
  }
  
  .hp9-banner-image-{{ section_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.6;
    filter: contrast(1.2);
  }
  
  .hp9-banner-overlay-{{ section_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, #050505 0%, transparent 50%, #050505 100%);
    z-index: 2;
  }
  
  .hp9-banner-content-{{ section_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 3;
    text-align: center;
    width: 100%;
    max-width: 800px;
    padding: 0 20px;
  }
  
  .hp9-banner-heading-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 900;
    line-height: 1;
    color: #fff;
    margin: 0 0 20px 0;
    text-transform: uppercase;
    letter-spacing: -1px;
    text-shadow: 0 0 20px rgba(0, 255, 136, 0.3);
  }
  
  .hp9-banner-btn-{{ section_id }} {
    display: inline-block;
    padding: 15px 40px;
    background-color: transparent;
    color: #00ff88;
    border: 2px solid #00ff88;
    text-decoration: none;
    font-family: 'Space Mono', monospace;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    transition: all 0.3s ease;
    box-shadow: inset 0 0 10px rgba(0, 255, 136, 0.2);
  }
  
  .hp9-banner-btn-{{ section_id }}:hover {
    background-color: #00ff88;
    color: #000;
    box-shadow: 0 0 30px rgba(0, 255, 136, 0.5);
  }
</style>

{% if section.settings.image != blank %}
  <img height="{{ section.settings.image.height }}" width="{{ section.settings.image.width }}" src="{{ section.settings.image | image_url: width: 2000 }}" alt="Banner" class="hp9-banner-image-{{ section_id }}" loading="lazy">
{% else %}
  <div style="width:100%; height:100%; background: radial-gradient(circle, #1a2a22 0%, #050505 100%); position:absolute;"></div>
{% endif %}

<div class="hp9-banner-overlay-{{ section_id }}"></div>

<div class="hp9-banner-content-{{ section_id }}">
  <h2 class="hp9-banner-heading-{{ section_id }}">{{ section.settings.heading | default: 'UPGRADE YOUR REALITY' }}</h2>
  {% if section.settings.button_text != blank %}
    <a href="{{ section.settings.button_link | default: '#' }}" class="hp9-banner-btn-{{ section_id }}">{{ section.settings.button_text }}</a>
  {% endif %}
</div>

{% schema %}
{
  "name": "HP9 Image Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "UPGRADE YOUR REALITY"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "HP9 Image Banner"
    }
  ]
}
{% endschema %}
