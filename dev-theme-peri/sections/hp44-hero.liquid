{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,400&family=Outfit:wght@400;500;600;700&display=swap');

  #shopify-section-{{ section.id }} {
    --hp44-bg: {{ section.settings.bg_color | default: '#EDF4EE' }};
    --hp44-text: {{ section.settings.text_color | default: '#143D2B' }};
    --hp44-accent: {{ section.settings.accent_color | default: '#2D6A4F' }};
    --hp44-badge-bg: {{ section.settings.badge_bg | default: '#D8E8DC' }};
    --hp44-btn-bg: {{ section.settings.btn_bg | default: '#143D2B' }};
    --hp44-btn-text: {{ section.settings.btn_text | default: '#FFFFFF' }};
    
    background-color: var(--hp44-bg);
    color: var(--hp44-text);
    font-family: 'Outfit', sans-serif;
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
    position: relative;
    overflow: hidden;
  }

  .hp44-hero__container {
    max-width: {{ section.settings.container_width | default: 1280 }}px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 60px;
    align-items: center;
  }

  .hp44-hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 20px;
    background: var(--hp44-badge-bg);
    border: 1px solid rgba(45, 106, 79, 0.2);
    border-radius: 50px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1px;
    color: var(--hp44-text);
    margin-bottom: 24px;
  }

  .hp44-hero__title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(38px, 5.5vw, 66px);
    font-weight: 700;
    line-height: 1.1;
    color: var(--hp44-text);
    margin: 0 0 24px;
    letter-spacing: -0.5px;
  }

  .hp44-hero__title em {
    font-style: italic;
    font-weight: 400;
    color: var(--hp44-accent);
  }

  .hp44-hero__desc {
    font-size: clamp(15px, 1.8vw, 18px);
    line-height: 1.7;
    color: #406352;
    margin: 0 0 36px;
    max-width: 520px;
  }

  .hp44-hero__actions {
    display: flex;
    gap: 16px;
    align-items: center;
    flex-wrap: wrap;
  }

  .hp44-hero__btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 36px;
    background: var(--hp44-btn-bg);
    color: var(--hp44-btn-text);
    font-family: 'Outfit', sans-serif;
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
    border-radius: 50px;
    box-shadow: 0 10px 25px rgba(20, 61, 43, 0.18);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hp44-hero__btn-primary:hover {
    background: var(--hp44-accent);
    transform: translateY(-2px);
    box-shadow: 0 15px 30px rgba(20, 61, 43, 0.25);
  }

  .hp44-hero__btn-secondary {
    display: inline-flex;
    align-items: center;
    padding: 16px 30px;
    background: transparent;
    color: var(--hp44-text);
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
    border: 1.5px solid var(--hp44-text);
    border-radius: 50px;
    transition: all 0.25s ease;
  }

  .hp44-hero__btn-secondary:hover {
    background: rgba(20, 61, 43, 0.06);
  }

  .hp44-hero__media-card {
    position: relative;
    background: #FFFFFF;
    padding: 16px;
    border-radius: 28px;
    border: 1px solid #D8E8DC;
    box-shadow: 0 20px 50px rgba(20, 61, 43, 0.08);
  }

  .hp44-hero__image {
    width: 100%;
    height: 480px;
    object-fit: cover;
    border-radius: 18px;
    display: block;
  }

  .hp44-hero__floating-chip {
    position: absolute;
    bottom: -20px;
    left: -20px;
    background: #FFFFFF;
    border: 1px solid #D8E8DC;
    border-radius: 20px;
    padding: 14px 22px;
    display: flex;
    align-items: center;
    gap: 12px;
    box-shadow: 0 12px 35px rgba(20, 61, 43, 0.12);
  }

  .hp44-hero__chip-icon {
    width: 40px;
    height: 40px;
    background: #EDF4EE;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
  }

  .hp44-hero__chip-title {
    font-size: 14px;
    font-weight: 700;
    color: var(--hp44-text);
    margin: 0;
  }

  .hp44-hero__chip-sub {
    font-size: 12px;
    color: #52796F;
    margin: 0;
  }

  @media screen and (max-width: 992px) {
    .hp44-hero__container {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 50px;
    }
    .hp44-hero__desc {
      margin-left: auto;
      margin-right: auto;
    }
    .hp44-hero__actions {
      justify-content: center;
    }
    .hp44-hero__image {
      height: 360px;
    }
    .hp44-hero__floating-chip {
      left: 20px;
      bottom: -15px;
    }
  }

  @media screen and (max-width: 576px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | default: 90 | times: 0.65 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | default: 90 | times: 0.65 | round }}px;
    }
    .hp44-hero__actions {
      flex-direction: column;
      width: 100%;
    }
    .hp44-hero__btn-primary, .hp44-hero__btn-secondary {
      width: 100%;
      justify-content: center;
    }
  }
{%- endstyle -%}

<div class="hp44-hero__container">
  <div>
    {%- if section.settings.badge_text != blank -%}
      <div class="hp44-hero__badge">
        <span>🌿</span>
        <span>{{ section.settings.badge_text }}</span>
      </div>
    {%- endif -%}

    <h1 class="hp44-hero__title">
      {{ section.settings.heading_html | default: 'Pure Botanical <em>Sage Alchemy</em> for Radiance' }}
    </h1>

    <p class="hp44-hero__desc">
      {{ section.settings.description | default: 'Crafted with cold-extracted clary sage bio-peptides, wild organic calendula, and adaptogenic white tea to calm cellular stress and restore epidermal balance.' }}
    </p>

    <div class="hp44-hero__actions">
      <a href="{{ section.settings.primary_btn_url | default: '/collections/all' }}" class="hp44-hero__btn-primary">
        <span>{{ section.settings.primary_btn_text | default: 'Shop Sage Collection' }}</span>
        <span>&rarr;</span>
      </a>
      {%- if section.settings.show_secondary_btn -%}
        <a href="{{ section.settings.secondary_btn_url | default: '/pages/about' }}" class="hp44-hero__btn-secondary">
          {{ section.settings.secondary_btn_text | default: 'Discover Science' }}
        </a>
      {%- endif -%}
    </div>
  </div>

  <div class="hp44-hero__media-card">
    {%- if section.settings.hero_image != blank -%}
      <img height="{{ section.settings.hero_image.height }}" width="{{ section.settings.hero_image.width }}" src="{{ section.settings.hero_image | image_url: width: 1000 }}" class="hp44-hero__image" alt="{{ section.settings.hero_image.alt | default: 'Botanical Skincare' }}" loading="eager">
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'hp44-hero__image' }}
    {%- endif -%}

    <div class="hp44-hero__floating-chip">
      <div class="hp44-hero__chip-icon">✨</div>
      <div>
        <p class="hp44-hero__chip-title">{{ section.settings.chip_title | default: '100% Eco-Certified Organic' }}</p>
        <p class="hp44-hero__chip-sub">{{ section.settings.chip_sub | default: 'Grown sustainably in Nordic fields' }}</p>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "HP44 - Sage Hero",
  "class": "section-hp44-hero",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#EDF4EE" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#143D2B" },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#2D6A4F" },
    { "type": "color", "id": "badge_bg", "label": "Badge Background", "default": "#D8E8DC" },
    { "type": "color", "id": "btn_bg", "label": "Button Background", "default": "#143D2B" },
    { "type": "color", "id": "btn_text", "label": "Button Text Color", "default": "#FFFFFF" },
    { "type": "text", "id": "badge_text", "label": "Badge Text", "default": "NORDIC HERBARIUM FORMULA v44" },
    { "type": "textarea", "id": "heading_html", "label": "Heading (HTML allowed)", "default": "Pure Botanical <em>Sage Alchemy</em> for Radiance" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Crafted with cold-extracted clary sage bio-peptides, wild organic calendula, and adaptogenic white tea to calm cellular stress and restore epidermal balance." },
    { "type": "text", "id": "primary_btn_text", "label": "Primary Button Text", "default": "Shop Sage Collection" },
    { "type": "url", "id": "primary_btn_url", "label": "Primary Button URL" },
    { "type": "checkbox", "id": "show_secondary_btn", "label": "Show Secondary Button", "default": true },
    { "type": "text", "id": "secondary_btn_text", "label": "Secondary Button Text", "default": "Discover Science" },
    { "type": "url", "id": "secondary_btn_url", "label": "Secondary Button URL" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero Image" },
    { "type": "text", "id": "chip_title", "label": "Floating Chip Title", "default": "100% Eco-Certified Organic" },
    { "type": "text", "id": "chip_sub", "label": "Floating Chip Subtitle", "default": "Grown sustainably in Nordic fields" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "presets": [
    { "name": "HP44 - Sage Hero" }
  ]
}
{% endschema %}
