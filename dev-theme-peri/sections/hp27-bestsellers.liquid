{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600&family=Syncopate:wght@400;700&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --font-heading: 'Syncopate', sans-serif;
    --font-body: 'Space Grotesk', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.8 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.8 | round }}px;
    }
  }

  .hp27-bs-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp27-bs-wrapper {
      padding: 0 20px;
    }
  }

  .hp27-bs__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 40px;
    border-bottom: 1px solid rgba(226, 226, 226, 0.1);
    padding-bottom: 15px;
  }

  @media screen and (max-width: 768px) {
    .hp27-bs__header {
      flex-direction: column;
      align-items: flex-start;
      gap: 15px;
    }
  }

  .hp27-bs__title {
    font-family: var(--font-heading);
    font-size: clamp(24px, 3vw, {{ section.settings.title_size }}px);
    font-weight: 700;
    color: var(--text-color);
    margin: 0;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }

  .hp27-bs__nav {
    display: flex;
    gap: 10px;
  }

  .hp27-bs__nav-btn {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid rgba(226, 226, 226, 0.3);
    color: var(--text-color);
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .hp27-bs__nav-btn:hover {
    border-color: var(--accent-color);
    color: var(--accent-color);
  }

  .hp27-bs__nav-btn svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
  }

  .hp27-bs__slider-container {
    position: relative;
    overflow: hidden;
  }

  .hp27-bs__track {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none;  /* IE 10+ */
    scroll-behavior: smooth;
    padding-bottom: 20px; /* space for scrollbar or shadow */
  }

  .hp27-bs__track::-webkit-scrollbar { 
    display: none; 
  }

  .hp27-bs__item {
    flex: 0 0 calc((100% - (20px * ({{ section.settings.columns_desktop }} - 1))) / {{ section.settings.columns_desktop }});
    scroll-snap-align: start;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    position: relative;
    border: 1px solid rgba(226, 226, 226, 0.1);
    background: #111;
    transition: border-color 0.3s ease;
  }

  @media screen and (max-width: 992px) {
    .hp27-bs__item {
      flex: 0 0 calc((100% - 20px) / 2);
    }
  }

  @media screen and (max-width: 600px) {
    .hp27-bs__item {
      flex: 0 0 85%;
    }
  }

  .hp27-bs__item:hover {
    border-color: rgba(226, 226, 226, 0.3);
  }

  .hp27-bs__image-wrapper {
    position: relative;
    aspect-ratio: {{ section.settings.image_aspect_ratio }};
    overflow: hidden;
    padding: 1px;
    border-bottom: 1px solid rgba(226, 226, 226, 0.1);
  }

  .hp27-bs__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%) contrast(1.1);
    transition: filter 0.4s ease, transform 0.8s ease;
  }

  .hp27-bs__item:hover .hp27-bs__image {
    filter: grayscale(0%) contrast(1);
    transform: scale(1.05);
  }

  .hp27-bs__badge {
    position: absolute;
    top: 10px;
    left: 10px;
    background: var(--text-color);
    color: var(--bg-color);
    font-family: var(--font-body);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.15em;
    padding: 4px 8px;
    text-transform: uppercase;
    z-index: 2;
  }

  .hp27-bs__meta {
    padding: 20px;
    display: flex;
    flex-direction: column;
    flex: 1;
    background: var(--bg-color);
  }

  .hp27-bs__product-title {
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--text-color);
    margin: 0 0 5px;
    text-transform: uppercase;
  }

  .hp27-bs__product-price {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 500;
    color: var(--text-color);
    margin-bottom: 15px;
  }

  .hp27-bs__add-btn {
    margin-top: auto;
    width: 100%;
    padding: 12px 0;
    background: transparent;
    border: 1px solid var(--text-color);
    color: var(--text-color);
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .hp27-bs__item:hover .hp27-bs__add-btn {
    background: var(--text-color);
    color: var(--bg-color);
    box-shadow: 0 0 10px rgba(255, 42, 42, 0.2);
  }

  .hp27-bs__add-btn:hover {
    border-color: var(--accent-color) !important;
    background: var(--accent-color) !important;
    color: #fff !important;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp27-bs-wrapper" id="HP27BS-{{ section.id }}">
  <div class="hp27-bs__header">
    <h2 class="hp27-bs__title">{{ section.settings.title }}</h2>
    
    <div class="hp27-bs__nav">
      <button class="hp27-bs__nav-btn hp27-bs__nav-btn--prev" aria-label="Previous">
        <svg viewBox="0 0 24 24"><path d="M15 18L9 12L15 6"/></svg>
      </button>
      <button class="hp27-bs__nav-btn hp27-bs__nav-btn--next" aria-label="Next">
        <svg viewBox="0 0 24 24"><path d="M9 18L15 12L9 6"/></svg>
      </button>
    </div>
  </div>

  <div class="hp27-bs__slider-container">
    <div class="hp27-bs__track" id="HP27Track-{{ section.id }}">
      {%- if section.settings.collection != blank -%}
        {%- for product in collections[section.settings.collection].products limit: section.settings.limit -%}
          <a href="{{ product.url }}" class="hp27-bs__item">
            <div class="hp27-bs__image-wrapper">
              {%- if forloop.index <= 2 -%}
                <div class="hp27-bs__badge">BEST SELLER</div>
              {%- endif -%}
              <img height="{{ product.featured_image.height }}" width="{{ product.featured_image.width }}" src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" class="hp27-bs__image" loading="lazy">
            </div>
            <div class="hp27-bs__meta">
              <h3 class="hp27-bs__product-title">{{ product.title }}</h3>
              <div class="hp27-bs__product-price">{{ product.price | money }}</div>
              
              <button class="hp27-bs__add-btn" type="button" onclick="event.preventDefault(); window.location.href='{{ product.url }}';">
                INITIALIZE
              </button>
            </div>
          </a>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..section.settings.limit) -%}
          <a href="#" class="hp27-bs__item">
            <div class="hp27-bs__image-wrapper">
              {%- if i <= 2 -%}
                <div class="hp27-bs__badge">TOP SPEC</div>
              {%- endif -%}
              {{ 'product-' | append: i | placeholder_svg_tag: 'hp27-bs__image' }}
            </div>
            <div class="hp27-bs__meta">
              <h3 class="hp27-bs__product-title">UNIT_0{{ i }}</h3>
              <div class="hp27-bs__product-price">$350.00</div>
              <button class="hp27-bs__add-btn" type="button">INITIALIZE</button>
            </div>
          </a>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const track = document.getElementById('HP27Track-{{ section.id }}');
    const prevBtn = document.querySelector('#HP27BS-{{ section.id }} .hp27-bs__nav-btn--prev');
    const nextBtn = document.querySelector('#HP27BS-{{ section.id }} .hp27-bs__nav-btn--next');

    if (track && prevBtn && nextBtn) {
      const scrollAmount = track.clientWidth > 768 ? track.clientWidth / 2 : track.clientWidth * 0.85;

      prevBtn.addEventListener('click', () => {
        track.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
      });

      nextBtn.addEventListener('click', () => {
        track.scrollBy({ left: scrollAmount, behavior: 'smooth' });
      });
    }
  });
</script>

{% schema %}
{
  "name": "HP27 - Eng Bestsellers",
  "class": "section-hp27-bestsellers",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "TOP PERFORMERS"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "min": 4,
      "max": 12,
      "step": 1,
      "label": "Number of Products",
      "default": 8
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1400
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 3,
      "max": 5,
      "step": 1,
      "label": "Columns (Desktop)",
      "default": 4
    },
    {
      "type": "select",
      "id": "image_aspect_ratio",
      "label": "Image Aspect Ratio",
      "options": [
        { "value": "1/1", "label": "Square (1:1)" },
        { "value": "3/4", "label": "Portrait (3:4)" },
        { "value": "4/5", "label": "Portrait (4:5)" }
      ],
      "default": "1/1"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 20,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "Heading Size",
      "default": 32
    },
    {
      "type": "header",
      "content": "Dark Engineered Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#0A0A0A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#E2E2E2"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#FF2A2A"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP27 - Eng Bestsellers"
    }
  ]
}
{% endschema %}
