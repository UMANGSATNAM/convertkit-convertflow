{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,900;1,900&family=Inter:wght@300&display=swap');

  #shopify-section-{{ section.id }} {
    --bg: {{ section.settings.bg_color }};
    --text: {{ section.settings.text_color }};
    --gold: {{ section.settings.accent_color }};
    --serif: 'Playfair Display', serif;
    --sans: 'Inter', sans-serif;
    background: var(--bg);
    position: relative;
    min-height: 50vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 100px 20px;
    overflow: hidden;
  }

  .hp42-offer__bg-text {
    position: absolute;
    font-family: var(--serif);
    font-size: clamp(120px, 25vw, 300px);
    font-weight: 900;
    font-style: italic;
    color: var(--text);
    opacity: 0.03;
    white-space: nowrap;
    pointer-events: none;
    z-index: 1;
  }

  .hp42-offer__content {
    position: relative;
    z-index: 2;
  }

  .hp42-offer__line {
    width: 60px;
    height: 1px;
    background: var(--gold);
    margin: 0 auto 30px;
  }

  .hp42-offer__title {
    font-family: var(--serif);
    font-size: clamp(36px, 8vw, {{ section.settings.title_size }}px);
    font-weight: 900;
    font-style: italic;
    color: var(--text);
    margin: 0 0 40px;
    line-height: 1.1;
  }

  .hp42-offer__btn {
    display: inline-block;
    padding: 16px 60px;
    border: 1px solid var(--gold);
    color: var(--gold);
    font-family: var(--sans);
    font-size: 13px;
    font-weight: 300;
    letter-spacing: 3px;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.4s ease;
  }
  .hp42-offer__btn:hover { background: var(--gold); color: var(--bg); }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<section id="HP42Offer-{{ section.id }}">
  <div class="hp42-offer__bg-text">{{ section.settings.bg_text }}</div>
  <div class="hp42-offer__content">
    <div class="hp42-offer__line"></div>
    <h2 class="hp42-offer__title">{{ section.settings.title }}</h2>
    {%- if section.settings.btn_label != blank -%}
      <a href="{{ section.settings.btn_link | default: '#' }}" class="hp42-offer__btn">{{ section.settings.btn_label }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "HP42 - Noir Offer",
  "class": "section-hp42-offer-banner",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Private Sale — 30% Off" },
    { "type": "text", "id": "bg_text", "label": "Background Watermark", "default": "EXCLUSIVE" },
    { "type": "text", "id": "btn_label", "label": "Button", "default": "Access Now" },
    { "type": "url", "id": "btn_link", "label": "Link" },
    { "type": "range", "id": "title_size", "min": 36, "max": 120, "step": 4, "unit": "px", "label": "Title Size", "default": 64 },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#0A0A0A" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#F5F0EB" },
    { "type": "color", "id": "accent_color", "label": "Gold", "default": "#C9A96E" },
    { "type": "html", "id": "custom_css", "label": "Custom CSS" }
  ],
  "presets": [{ "name": "HP42 - Noir Offer" }]
}
{% endschema %}
