{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp53-fc-bg: {{ section.settings.bg_color | default: '#F5EDE3' }};
    --hp53-fc-card: {{ section.settings.card_bg | default: '#FFFFFF' }};
    --hp53-fc-title: {{ section.settings.title_color | default: '#5C3D2E' }};

    background-color: var(--hp53-fc-bg);
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }

  .hp53-fc__container {
    max-width: {{ section.settings.container_width | default: 1280 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp53-fc__header {
    text-align: center;
    margin-bottom: 50px;
  }

  .hp53-fc__eyebrow {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: {{ section.settings.accent_color | default: '#C2703E' }};
    margin: 0 0 12px;
  }

  .hp53-fc__heading {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(30px, 4vw, 46px);
    font-weight: 700;
    color: var(--hp53-fc-title);
    margin: 0;
  }

  .hp53-fc__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns | default: 4 }}, 1fr);
    gap: 24px;
  }

  .hp53-fc__card {
    background: var(--hp53-fc-card);
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid {{ section.settings.border_color | default: '#E8D5C0' }};
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .hp53-fc__card:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 40px rgba(92, 61, 46, 0.12);
  }

  .hp53-fc__img-wrap {
    aspect-ratio: 3/4;
    overflow: hidden;
    background: #E8D5C0;
  }

  .hp53-fc__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .hp53-fc__card:hover .hp53-fc__img {
    transform: scale(1.06);
  }

  .hp53-fc__info {
    padding: 18px 16px;
  }

  .hp53-fc__product-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 16px;
    font-weight: 700;
    color: var(--hp53-fc-title);
    margin: 0 0 6px;
    text-decoration: none;
    display: block;
  }

  .hp53-fc__price {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 15px;
    font-weight: 700;
    color: {{ section.settings.accent_color | default: '#C2703E' }};
    margin: 0;
  }

  .hp53-fc__view-all {
    display: block;
    text-align: center;
    margin-top: 40px;
  }

  .hp53-fc__view-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 32px;
    background: {{ section.settings.btn_bg | default: '#5C3D2E' }};
    color: {{ section.settings.btn_text | default: '#FAF5EF' }};
    font-family: 'Space Grotesk', sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 4px;
    transition: all 0.3s ease;
    border: 2px solid {{ section.settings.btn_bg | default: '#5C3D2E' }};
  }

  .hp53-fc__view-btn:hover {
    background: transparent;
    color: {{ section.settings.btn_bg | default: '#5C3D2E' }};
  }

  @media screen and (max-width: 992px) {
    .hp53-fc__grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media screen and (max-width: 480px) {
    .hp53-fc__grid { grid-template-columns: repeat(2, 1fr); gap: 14px; }
    .hp53-fc__info { padding: 12px 10px; }
  }
{%- endstyle -%}

<div class="hp53-fc__container">
  <div class="hp53-fc__header">
    {%- if section.settings.eyebrow != blank -%}
      <p class="hp53-fc__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h2 class="hp53-fc__heading">{{ section.settings.heading | default: 'Dune Collection' }}</h2>
  </div>

  {%- assign collection = collections[section.settings.collection] -%}
  <div class="hp53-fc__grid">
    {%- assign limit = section.settings.products_to_show | default: 4 -%}
    {%- for product in collection.products limit: limit -%}
      <div class="hp53-fc__card">
        <a href="{{ product.url }}" class="hp53-fc__img-wrap">
          {%- if product.featured_image != blank -%}
            <img src="{{ product.featured_image | image_url: width: 600 }}" class="hp53-fc__img" alt="{{ product.title }}" loading="lazy">
          {%- endif -%}
        </a>
        <div class="hp53-fc__info">
          <a href="{{ product.url }}" class="hp53-fc__product-title">{{ product.title }}</a>
          <p class="hp53-fc__price">{{ product.price | money }}</p>
        </div>
      </div>
    {%- endfor -%}
  </div>

  {%- if section.settings.show_view_all -%}
    <div class="hp53-fc__view-all">
      <a href="{{ collection.url | default: '/collections/all' }}" class="hp53-fc__view-btn">
        {{ section.settings.view_all_text | default: 'View All' }} &rarr;
      </a>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "HP53 - Dune Featured",
  "class": "section-hp53-fc",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#F5EDE3" },
    { "type": "color", "id": "card_bg", "label": "Card Background", "default": "#FFFFFF" },
    { "type": "color", "id": "border_color", "label": "Border Color", "default": "#E8D5C0" },
    { "type": "color", "id": "title_color", "label": "Title Color", "default": "#5C3D2E" },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#C2703E" },
    { "type": "color", "id": "btn_bg", "label": "Button BG", "default": "#5C3D2E" },
    { "type": "color", "id": "btn_text", "label": "Button Text", "default": "#FAF5EF" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "◈ CURATED SELECTION" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Dune Collection" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 12, "step": 1, "label": "Products", "default": 4 },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "label": "Columns", "default": 4 },
    { "type": "checkbox", "id": "show_view_all", "label": "Show View All", "default": true },
    { "type": "text", "id": "view_all_text", "label": "View All Text", "default": "View All" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "presets": [{ "name": "HP53 - Dune Featured" }]
}
{% endschema %}
