{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: "#080B10" }};
    padding: 90px 20px;
  }

  .hp43-comp__title {
    font-family: 'Orbitron', sans-serif;
    font-size: 32px;
    font-weight: 800;
    color: #F1F5F9;
    text-align: center;
    margin: 0 0 45px;
    text-transform: uppercase;
  }

  .hp43-comp__table {
    max-width: 960px;
    margin: 0 auto;
    background: #101622;
    border: 1px solid #1E293B;
    border-radius: 6px;
    overflow: hidden;
    box-shadow: 0 15px 40px rgba(0,0,0,0.5);
    width: 100%;
    border-collapse: collapse;
  }

  .hp43-comp__table th, .hp43-comp__table td {
    padding: 18px 24px;
    text-align: center;
    border-bottom: 1px solid #1E293B;
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    color: #F1F5F9;
  }

  .hp43-comp__table th {
    font-family: 'Orbitron', sans-serif;
    font-weight: 700;
    font-size: 14px;
    text-transform: uppercase;
    background: rgba(0, 240, 255, 0.05);
  }

  .hp43-comp__highlight {
    background: rgba(0, 240, 255, 0.08);
    font-weight: 700;
    color: #00F0FF;
  }
{%- endstyle -%}

<div class="hp43-comp__title">SPECIFICATIONS MATRIX</div>
<table class="hp43-comp__table">
  <thead>
    <tr>
      <th style="text-align:left;">SYSTEM BENCHMARK</th>
      <th class="hp43-comp__highlight">NEON TECH GEAR</th>
      <th>STANDARD RETAIL</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td style="text-align:left;">Polling & Input Rate</td>
      <td class="hp43-comp__highlight">8000Hz (0.125ms)</td>
      <td>1000Hz (1.0ms)</td>
    </tr>
    <tr>
      <td style="text-align:left;">Chassis Construction</td>
      <td class="hp43-comp__highlight">CNC Anodized Alloy</td>
      <td>Injection Molded ABS</td>
    </tr>
    <tr>
      <td style="text-align:left;">International Customs</td>
      <td class="hp43-comp__highlight">Pre-paid DDP Shipping</td>
      <td>Unpaid Duty Delivery</td>
    </tr>
    <tr>
      <td style="text-align:left;">Hardware Protection</td>
      <td class="hp43-comp__highlight">2-Year Full Coverage</td>
      <td>30 Days Limited</td>
    </tr>
  </tbody>
</table>

{% schema %}
{
  "name": "HP43 - Cyber Matrix",
  "class": "section-hp43-matrix",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#080B10"
    }
  ],
  "presets": [
    {
      "name": "HP43 - Cyber Matrix"
    }
  ]
}
{% endschema %}
