{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp47-news-bg: {{ section.settings.bg_color | default: '#F5F0EB' }};
    
    background-color: var(--hp47-news-bg);
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
  }

  .hp47-news__box {
    max-width: {{ section.settings.container_width | default: 760 }}px;
    margin: 0 auto;
    padding: 50px 40px;
    background: #FAF7F2;
    border: 1px solid #EAE3DA;
    border-radius: 32px;
    text-align: center;
    box-shadow: 0 15px 40px rgba(56, 46, 43, 0.05);
  }

  .hp47-news__title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(30px, 4.5vw, 42px);
    font-weight: 600;
    color: #382E2B;
    margin: 0 0 12px;
  }

  .hp47-news__desc {
    font-size: 15px;
    line-height: 1.7;
    color: #6E5E58;
    margin: 0 0 32px;
  }

  .hp47-news__form {
    display: flex;
    gap: 12px;
    max-width: 500px;
    margin: 0 auto;
  }

  .hp47-news__input {
    flex: 1;
    padding: 15px 22px;
    background: #FFFFFF;
    border: 1px solid #EAE3DA;
    border-radius: 50px;
    color: #382E2B;
    font-size: 14px;
    outline: none;
    font-family: 'Plus Jakarta Sans', sans-serif;
  }

  .hp47-news__input:focus { border-color: #8C6D58; }

  .hp47-news__btn {
    padding: 15px 32px;
    background: #382E2B;
    color: #FFFFFF;
    border: none;
    border-radius: 50px;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-weight: 700;
    font-size: 14px;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .hp47-news__btn:hover { background: #8C6D58; }

  @media screen and (max-width: 600px) {
    .hp47-news__box { padding: 36px 20px; }
    .hp47-news__form { flex-direction: column; }
  }
{%- endstyle -%}

<div class="hp47-news__box">
  <h2 class="hp47-news__title">{{ section.settings.heading | default: 'Join The Linen Circle' }}</h2>
  <p class="hp47-news__desc">{{ section.settings.description | default: 'Receive seasonal harvest invitations and an instant 15% privilege voucher for your initial Scandinavian ritual.' }}</p>
  <form class="hp47-news__form" onsubmit="event.preventDefault(); alert('Subscribed to Linen Circle.');">
    <input type="email" class="hp47-news__input" placeholder="{{ section.settings.placeholder | default: 'Enter your email address' }}" required>
    <button type="submit" class="hp47-news__btn">{{ section.settings.btn_text | default: 'Subscribe' }}</button>
  </form>
</div>

{% schema %}
{
  "name": "HP47 - Taupe News",
  "class": "section-hp47-news",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#F5F0EB" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join The Linen Circle" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Receive seasonal harvest invitations and an instant 15% privilege voucher." },
    { "type": "text", "id": "placeholder", "label": "Placeholder", "default": "Enter your email address" },
    { "type": "text", "id": "btn_text", "label": "Button Text", "default": "Subscribe" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 80 },
    { "type": "range", "id": "container_width", "min": 500, "max": 1000, "step": 20, "unit": "px", "label": "Container Width", "default": 760 }
  ],
  "presets": [
    { "name": "HP47 - Taupe News" }
  ]
}
{% endschema %}
