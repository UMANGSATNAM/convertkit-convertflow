{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Oswald:wght@700&family=Space+Grotesk:wght@400;700&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --border-color: {{ section.settings.border_color }};
    --accent-color: {{ section.settings.accent_color }};
    
    --font-heading: 'Oswald', sans-serif;
    --font-body: 'Space Grotesk', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    border-bottom: 4px solid var(--border-color);
  }

  .hp30-fc-wrapper {
    max-width: 1800px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp30-fc-wrapper {
      padding: 0 20px;
    }
  }

  .hp30-fc__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 40px;
    border-bottom: 4px solid var(--border-color);
    padding-bottom: 20px;
  }

  @media screen and (max-width: 768px) {
    .hp30-fc__header {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }
  }

  .hp30-fc__title {
    font-family: var(--font-heading);
    font-size: clamp(40px, 8vw, {{ section.settings.title_size }}px);
    line-height: 1;
    text-transform: uppercase;
    color: var(--text-color);
    margin: 0;
    letter-spacing: -0.02em;
  }

  .hp30-fc__btn {
    display: inline-block;
    padding: 10px 20px;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 2px;
    text-decoration: none;
    background: var(--text-color);
    color: var(--bg-color);
    border: 4px solid var(--text-color);
    transition: all 0s;
  }

  .hp30-fc__btn:hover {
    background: var(--accent-color);
    border-color: var(--border-color);
    color: var(--text-color);
  }

  .hp30-fc__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: 40px;
  }

  @media screen and (max-width: 992px) {
    .hp30-fc__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
  }

  @media screen and (max-width: 576px) {
    .hp30-fc__grid {
      grid-template-columns: 1fr;
    }
  }

  .hp30-fc__card {
    position: relative;
    border: 4px solid transparent;
    transition: border-color 0s;
    background: var(--bg-color);
  }

  .hp30-fc__card:hover {
    border-color: var(--accent-color);
  }

  .hp30-fc__image-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 3/4;
    overflow: hidden;
    background: #111;
    border-bottom: 4px solid var(--border-color);
  }

  .hp30-fc__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: contrast(110%) grayscale(20%);
    transition: transform 0.2s steps(4);
  }

  .hp30-fc__card:hover .hp30-fc__image {
    transform: scale(1.05);
  }

  .hp30-fc__badge {
    position: absolute;
    top: 10px; left: 10px;
    background: var(--text-color);
    color: var(--bg-color);
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 12px;
    text-transform: uppercase;
    padding: 5px 10px;
    letter-spacing: 1px;
    z-index: 2;
  }

  .hp30-fc__info {
    padding: 20px 0;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 15px;
  }

  .hp30-fc__product-title {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--text-color);
    margin: 0;
    line-height: 1.2;
    text-decoration: none;
  }

  .hp30-fc__product-title:hover {
    color: var(--accent-color);
  }

  .hp30-fc__price {
    font-family: var(--font-heading);
    font-size: 20px;
    color: var(--text-color);
    margin-top: 5px;
  }

  .hp30-fc__add-btn {
    background: var(--text-color);
    color: var(--bg-color);
    border: none;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-family: var(--font-heading);
    font-size: 24px;
    line-height: 1;
    transition: background-color 0s;
  }

  .hp30-fc__add-btn:hover {
    background: var(--accent-color);
    color: var(--text-color);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp30-fc-wrapper" id="HP30FeaturedCollection-{{ section.id }}">
  <div class="hp30-fc__header">
    <h2 class="hp30-fc__title">{{ section.settings.title }}</h2>
    {%- if section.settings.btn_label != blank -%}
      <a href="{{ section.settings.btn_link | default: '#' }}" class="hp30-fc__btn">
        {{ section.settings.btn_label }}
      </a>
    {%- endif -%}
  </div>

  <div class="hp30-fc__grid">
    {%- assign product_count = section.settings.columns_desktop | times: 1 -%}
    {%- for i in (1..product_count) -%}
      <div class="hp30-fc__card">
        <a href="#" class="hp30-fc__image-wrap">
          {%- if forloop.index == 1 -%}
            <div class="hp30-fc__badge">NEW</div>
          {%- endif -%}
          {%- assign placeholder = 'product-' | append: forloop.index -%}
          {%- if forloop.index > 6 -%}{%- assign placeholder = 'product-1' -%}{%- endif -%}
          {{ placeholder | placeholder_svg_tag: 'hp30-fc__image' }}
        </a>
        <div class="hp30-fc__info">
          <div>
            <a href="#" class="hp30-fc__product-title">Object 00{{ i }}</a>
            <div class="hp30-fc__price">$1{{ i }}0.00</div>
          </div>
          <button class="hp30-fc__add-btn" aria-label="Add to cart">+</button>
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "HP30 - Brutalist Products",
  "class": "section-hp30-featured-collection",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "NEW ARRIVALS"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "VIEW ALL"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Grid Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Columns (Desktop)",
      "default": 4
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 40,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "Heading Size",
      "default": 80
    },
    {
      "type": "header",
      "content": "Brutalist Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (White)",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text (Black)",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Borders",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent (Red)",
      "default": "#FF0000"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP30 - Brutalist Products"
    }
  ]
}
{% endschema %}
