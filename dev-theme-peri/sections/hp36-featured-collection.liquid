{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400;1,600&family=Oswald:wght@300;400;500&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --border-color: {{ section.settings.border_color }};
    --accent-color: {{ section.settings.accent_color }};
    
    --font-serif: 'Playfair Display', serif;
    --font-sans: 'Oswald', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    border-bottom: 1px solid var(--border-color);
  }

  .hp36-collection-wrapper {
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp36-collection-wrapper {
      padding: 0 20px;
    }
  }

  .hp36-collection__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 80px;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 40px;
  }

  @media screen and (max-width: 768px) {
    .hp36-collection__header {
      flex-direction: column;
      align-items: flex-start;
      gap: 30px;
      margin-bottom: 50px;
    }
  }

  .hp36-collection__title {
    font-family: var(--font-serif);
    font-size: clamp(48px, 8vw, {{ section.settings.title_size }}px);
    line-height: 1;
    color: var(--text-color);
    margin: 0;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }
  
  .hp36-collection__title em {
    font-style: italic;
    color: var(--accent-color);
    text-transform: lowercase;
  }

  .hp36-collection__link {
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--text-color);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .hp36-collection__link svg {
    width: 20px; height: 20px;
    fill: currentColor;
    transition: transform 0.3s ease;
  }

  .hp36-collection__link:hover svg {
    transform: translateX(5px);
  }

  .hp36-collection__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background-color: var(--border-color);
    border: 1px solid var(--border-color);
  }

  @media screen and (max-width: 1200px) {
    .hp36-collection__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media screen and (max-width: 768px) {
    .hp36-collection__grid {
      grid-template-columns: 1fr;
    }
  }

  .hp36-product {
    background-color: var(--bg-color);
    text-decoration: none;
    display: flex;
    flex-direction: column;
    group: card;
    position: relative;
    padding: 30px;
  }

  .hp36-product__image-wrap {
    aspect-ratio: 3/4;
    position: relative;
    overflow: hidden;
    margin-bottom: 30px;
  }

  .hp36-product__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%);
    transition: filter 0.5s ease, transform 1s ease;
  }

  .hp36-product:hover .hp36-product__image {
    filter: grayscale(0%);
    transform: scale(1.05);
  }
  
  .hp36-product__badge {
    position: absolute;
    top: 0; left: 0;
    background: var(--text-color);
    color: var(--bg-color);
    font-family: var(--font-sans);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    padding: 8px 12px;
    z-index: 2;
  }

  .hp36-product__info {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
  }

  .hp36-product__title {
    font-family: var(--font-serif);
    font-size: 24px;
    color: var(--text-color);
    margin: 0;
    max-width: 70%;
  }

  .hp36-product__price {
    font-family: var(--font-sans);
    font-size: 16px;
    color: var(--text-color);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp36-collection-wrapper" id="HP36Collection-{{ section.id }}">
  <div class="hp36-collection__header">
    <h2 class="hp36-collection__title">{{ section.settings.title | replace: 'Editor', '<em>Editor</em>' }}</h2>
    
    {%- if section.settings.btn_label != blank -%}
      <a href="{{ section.settings.btn_link | default: '#' }}" class="hp36-collection__link">
        {{ section.settings.btn_label }}
        <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" fill="none"/></svg>
      </a>
    {%- endif -%}
  </div>

  <div class="hp36-collection__grid">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.product_link | default: '#' }}" class="hp36-product" {{ block.shopify_attributes }}>
        <div class="hp36-product__image-wrap">
          {%- if block.settings.badge != blank -%}
            <div class="hp36-product__badge">{{ block.settings.badge }}</div>
          {%- endif -%}
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title | escape }}" class="hp36-product__image" loading="lazy">
          {%- else -%}
            {%- assign placeholder = 'product-' | append: forloop.index -%}
            {%- if forloop.index > 6 -%}{%- assign placeholder = 'product-1' -%}{%- endif -%}
            {{ placeholder | placeholder_svg_tag: 'hp36-product__image' }}
          {%- endif -%}
        </div>
        
        <div class="hp36-product__info">
          <h3 class="hp36-product__title">{{ block.settings.title }}</h3>
          <div class="hp36-product__price">{{ block.settings.price }}</div>
        </div>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "HP36 - Editorial Grids",
  "class": "section-hp36-featured-collection",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Editor's Picks"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "View Entire Collection"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 40,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 80
    },
    {
      "type": "header",
      "content": "Editorial Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#8B0000"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 100
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge (Optional)",
          "default": "NEW IN"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "The Vanguard Coat"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "$450"
        },
        {
          "type": "url",
          "id": "product_link",
          "label": "Product Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP36 - Editorial Grids",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
