{%- comment -%}
  PC V1 — MODERN CLEAN MINIMALIST PRODUCT GRID
  Design: Clean, crisp modern D2C e-commerce aesthetic, Inter font
  Card Shape: 8px rounded corners, soft hover elevate shadow
{%- endcomment -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

  .pcv1 {
    --bg: {{ section.settings.bg_color | default: '#F9FAFB' }};
    --card-bg: {{ section.settings.card_bg | default: '#FFFFFF' }};
    --text: {{ section.settings.text_color | default: '#111827' }};
    --muted: {{ section.settings.muted_color | default: '#6B7280' }};
    --accent: {{ section.settings.accent_color | default: '#2563EB' }};
    --accent-hover: {{ section.settings.accent_hover | default: '#1D4ED8' }};
    --border: {{ section.settings.border_color | default: '#E5E7EB' }};
    --badge-sale-bg: #EF4444;
    --badge-sale-text: #FFFFFF;
    --f-main: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    --r-card: 10px;
    --ease: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    background-color: var(--bg);
    color: var(--text);
    font-family: var(--f-main);
    padding: {{ section.settings.padding_top | default: 48 }}px 0 {{ section.settings.padding_bottom | default: 48 }}px 0;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }

  .pcv1 *, .pcv1 *::before, .pcv1 *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .pcv1 a { color: inherit; text-decoration: none; }
  .pcv1 button { font-family: inherit; cursor: pointer; border: none; background: none; }
  .pcv1 img { max-width: 100%; display: block; }

  .pcv1__wrap { max-width: 1280px; margin: 0 auto; padding: 0 20px; }

  /* HEADER */
  .pcv1__head { display: flex; flex-direction: column; gap: 8px; margin-bottom: 32px; text-align: {{ section.settings.header_align | default: 'left' }}; }
  @media (min-width: 768px) {
    .pcv1__head { display: flex; flex-direction: row; justify-content: space-between; align-items: flex-end; }
  }
  .pcv1__title { font-size: 28px; font-weight: 700; color: var(--text); letter-spacing: -0.02em; }
  @media (min-width: 768px) { .pcv1__title { font-size: 34px; } }
  .pcv1__sub { font-size: 15px; color: var(--muted); }
  .pcv1__viewall { display: inline-flex; align-items: center; gap: 6px; font-weight: 600; font-size: 14px; color: var(--accent); transition: var(--ease); margin-top: 8px; }
  .pcv1__viewall:hover { color: var(--accent-hover); gap: 10px; }

  /* GRID */
  .pcv1__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr);
    gap: 16px;
  }
  @media (min-width: 640px) {
    .pcv1__grid { grid-template-columns: repeat({{ section.settings.cols_tablet | default: 3 }}, 1fr); gap: 20px; }
  }
  @media (min-width: 1024px) {
    .pcv1__grid { grid-template-columns: repeat({{ section.settings.cols_desktop | default: 4 }}, 1fr); gap: 24px; }
  }

  /* CARD */
  .pcv1__card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--r-card);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    position: relative;
    transition: var(--ease);
  }
  .pcv1__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px -6px rgba(0, 0, 0, 0.08);
    border-color: #D1D5DB;
  }

  /* IMAGE BOX */
  .pcv1__img-box {
    position: relative;
    width: 100%;
    aspect-ratio: {{ section.settings.img_ratio | default: '3/4' }};
    background: #F3F4F6;
    overflow: hidden;
  }
  .pcv1__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
  }
  .pcv1__img--sec {
    position: absolute;
    top: 0; left: 0;
    opacity: 0;
  }
  .pcv1__card:hover .pcv1__img--pri {
    {% if section.settings.enable_sec_img %}
      opacity: 0;
    {% else %}
      transform: scale(1.04);
    {% endif %}
  }
  .pcv1__card:hover .pcv1__img--sec { opacity: 1; transform: scale(1.04); }

  /* BADGES */
  .pcv1__badges { position: absolute; top: 12px; left: 12px; display: flex; flex-direction: column; gap: 6px; z-index: 2; pointer-events: none; }
  .pcv1__badge { font-size: 11px; font-weight: 700; text-transform: uppercase; padding: 4px 8px; border-radius: 4px; letter-spacing: 0.04em; }
  .pcv1__badge--sale { background: var(--badge-sale-bg); color: var(--badge-sale-text); }
  .pcv1__badge--tag { background: #111827; color: #FFFFFF; }
  .pcv1__badge--sold { background: #6B7280; color: #FFFFFF; }

  /* WISHLIST BUTTON */
  .pcv1__wish {
    position: absolute;
    top: 10px; right: 10px;
    width: 34px; height: 34px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(4px);
    display: flex; align-items: center; justify-content: center;
    color: #4B5563;
    z-index: 3;
    transition: var(--ease);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
  }
  .pcv1__wish:hover { background: #FFFFFF; color: #EF4444; transform: scale(1.1); }
  .pcv1__wish.active { color: #EF4444; background: #FFFFFF; }

  /* QUICK ADD HOVER */
  .pcv1__quick-box {
    position: absolute;
    bottom: 12px; left: 12px; right: 12px;
    z-index: 3;
    transform: translateY(16px);
    opacity: 0;
    transition: var(--ease);
  }
  .pcv1__card:hover .pcv1__quick-box { transform: translateY(0); opacity: 1; }
  @media (max-width: 767px) {
    .pcv1__quick-box { transform: translateY(0); opacity: 1; position: relative; bottom: auto; left: auto; right: auto; padding: 0 14px 14px; }
  }

  .pcv1__quick-btn {
    width: 100%;
    padding: 10px 14px;
    background: var(--accent);
    color: #FFFFFF;
    font-size: 13px; font-weight: 600;
    border-radius: 6px;
    display: flex; align-items: center; justify-content: center; gap: 8px;
    transition: var(--ease);
    box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25);
  }
  .pcv1__quick-btn:hover { background: var(--accent-hover); }
  .pcv1__quick-btn:disabled { background: #9CA3AF; cursor: not-allowed; box-shadow: none; }

  /* CARD CONTENT */
  .pcv1__content { padding: 14px; display: flex; flex-direction: column; gap: 8px; flex-grow: 1; }

  .pcv1__vendor { font-size: 11px; text-transform: uppercase; color: var(--muted); font-weight: 600; letter-spacing: 0.05em; }
  .pcv1__item-title { font-size: 14px; font-weight: 600; color: var(--text); line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  
  /* RATING */
  .pcv1__rating { display: flex; align-items: center; gap: 4px; font-size: 12px; color: #F59E0B; font-weight: 600; }
  .pcv1__stars { letter-spacing: 1px; }
  .pcv1__rev-cnt { color: var(--muted); font-weight: 400; font-size: 11px; }

  /* PRICE */
  .pcv1__price-row { display: flex; align-items: baseline; gap: 8px; margin-top: auto; }
  .pcv1__price { font-size: 15px; font-weight: 700; color: var(--text); }
  .pcv1__cmp-price { font-size: 13px; color: var(--muted); text-decoration: line-through; }

  /* SWATCHES */
  .pcv1__swatches { display: flex; gap: 6px; align-items: center; margin-top: 4px; }
  .pcv1__swatch { width: 14px; height: 14px; border-radius: 50%; border: 1px solid #D1D5DB; cursor: pointer; transition: var(--ease); }
  .pcv1__swatch:hover, .pcv1__swatch.active { transform: scale(1.2); border-color: var(--text); }

  /* URGENCY MICRO */
  .pcv1__urgency { font-size: 11px; color: #D97706; font-weight: 600; display: flex; align-items: center; gap: 4px; margin-top: 2px; }
  .pcv1__urgency-dot { width: 6px; height: 6px; border-radius: 50%; background: #D97706; animation: pcv1pulse 1.5s infinite; }
  @keyframes pcv1pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.3; } }

  /* TOAST */
  .pcv1__toast {
    position: fixed; bottom: 20px; right: 20px;
    background: #111827; color: #FFFFFF;
    padding: 12px 20px; border-radius: 8px;
    font-size: 13px; font-weight: 600;
    z-index: 9999;
    transform: translateY(100px); opacity: 0;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
  }
  .pcv1__toast.show { transform: translateY(0); opacity: 1; }
</style>

<div class="pcv1">
  <div class="pcv1__wrap">
    
    {% if section.settings.title != blank or section.settings.subheading != blank %}
      <div class="pcv1__head">
        <div>
          {% if section.settings.title != blank %}
            <h2 class="pcv1__title">{{ section.settings.title | escape }}</h2>
          {% endif %}
          {% if section.settings.subheading != blank %}
            <p class="pcv1__sub">{{ section.settings.subheading | escape }}</p>
          {% endif %}
        </div>
        {% if section.settings.show_view_all and section.settings.collection != blank %}
          <a href="{{ collections[section.settings.collection].url }}" class="pcv1__viewall">
            {{ section.settings.view_all_label | default: 'View all products' }} &rarr;
          </a>
        {% endif %}
      </div>
    {% endif %}

    <div class="pcv1__grid">
      {% assign target_coll = collections[section.settings.collection] %}
      {% assign limit_num = section.settings.products_per_page | default: 8 %}

      {% if target_coll != blank and target_coll.products.size > 0 %}
        {% for product in target_coll.products limit: limit_num %}
          {% assign current_variant = product.selected_or_first_available_variant %}
          
          {% render 'card-v1', product: product, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v1', product: nil, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% endif %}
    </div>

  </div>
</div>

<div class="pcv1__toast" id="pcv1-toast">✓ Added to cart!</div>

<script>
(function(){
  // Wishlist Storage
  // Wishlist is handled globally by assets/wishlist.js (shared store: cf_wishlist_items).
  // Buttons are rendered by snippets/wishlist-button.liquid — no per-section storage.


  // Quick Add AJAX
  document.querySelectorAll('[data-pcv1-add]').forEach(function(btn){
    btn.addEventListener('click', function(e){
      e.preventDefault(); e.stopPropagation();
      var id = btn.dataset.pcv1Add, orig = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = 'Adding...';

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: id, quantity: 1 })
      })
      .then(function(r){ return r.json(); })
      .then(function(){
        btn.innerHTML = '✓ Added!';
        showT('Product added to cart!');
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      })
      .catch(function(){
        btn.innerHTML = 'Error';
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      });
    });
  });

  function showT(msg){
    var t = document.getElementById('pcv1-toast');
    if(!t) return;
    t.textContent = msg;
    t.classList.add('show');
    setTimeout(function(){ t.classList.remove('show'); }, 3000);
  }
})();
</script>

{% schema %}
{
