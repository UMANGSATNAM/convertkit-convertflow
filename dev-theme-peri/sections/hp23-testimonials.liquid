{%- style -%}
  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --border-color: #000000;
    --border-width: 3px;
    --shadow-offset: 6px;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    border-bottom: var(--border-width) solid var(--border-color);
    font-family: 'Space Grotesk', 'Outfit', sans-serif;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }

  .hp23-tests-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp23-tests-wrapper {
      padding: 0 20px;
    }
  }

  .hp23-tests__header {
    margin-bottom: {{ section.settings.header_margin }}px;
    border-bottom: var(--border-width) solid var(--border-color);
    padding-bottom: 20px;
  }

  .hp23-tests__title {
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    font-weight: 900;
    color: var(--text-color);
    margin: 0;
    text-transform: uppercase;
    line-height: 1.1;
    letter-spacing: -1px;
    text-align: center;
  }

  .hp23-tests__title em {
    font-style: normal;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--text-color);
  }

  .hp23-tests__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: 30px;
  }

  @media screen and (max-width: 992px) {
    .hp23-tests__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
  }

  @media screen and (max-width: 768px) {
    .hp23-tests__grid {
      display: flex;
      flex-wrap: nowrap;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-bottom: 20px;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .hp23-tests__grid::-webkit-scrollbar {
      display: none;
    }
  }

  .hp23-test-card {
    background: #ffffff;
    border: var(--border-width) solid var(--border-color);
    border-radius: {{ section.settings.border_radius }}px;
    box-shadow: var(--shadow-offset) var(--shadow-offset) 0 var(--border-color);
    padding: 40px 30px;
    display: flex;
    flex-direction: column;
    position: relative;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  @media screen and (max-width: 768px) {
    .hp23-test-card {
      flex: 0 0 85%;
      scroll-snap-align: center;
    }
  }

  .hp23-test-card:hover {
    transform: translate(2px, 2px);
    box-shadow: calc(var(--shadow-offset) - 2px) calc(var(--shadow-offset) - 2px) 0 var(--border-color);
  }

  /* Make some cards alternating colors for that brutalist messy vibe */
  .hp23-test-card:nth-child(even) {
    background: var(--accent-color);
  }

  .hp23-test-card__quote-mark {
    font-family: serif;
    font-size: 80px;
    line-height: 1;
    color: var(--text-color);
    opacity: 0.1;
    position: absolute;
    top: 20px;
    left: 20px;
    pointer-events: none;
  }

  .hp23-test-card__rating {
    display: flex;
    gap: 4px;
    margin-bottom: 20px;
    z-index: 1;
  }

  .hp23-test-card__rating svg {
    width: 24px;
    height: 24px;
    fill: var(--text-color);
  }

  .hp23-test-card__text {
    font-size: clamp(16px, 2vw, 20px);
    font-weight: 700;
    color: var(--text-color);
    line-height: 1.4;
    margin: 0 0 30px;
    z-index: 1;
    flex-grow: 1;
  }

  .hp23-test-card__footer {
    display: flex;
    align-items: center;
    gap: 15px;
    border-top: 2px solid var(--border-color);
    padding-top: 20px;
    z-index: 1;
  }

  .hp23-test-card__initial {
    width: 50px;
    height: 50px;
    background: var(--text-color);
    color: var(--bg-color);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 900;
    font-size: 20px;
  }
  
  .hp23-test-card:nth-child(even) .hp23-test-card__initial {
    background: #ffffff;
    color: var(--text-color);
    border: 2px solid var(--border-color);
  }

  .hp23-test-card__author {
    display: flex;
    flex-direction: column;
  }

  .hp23-test-card__name {
    font-weight: 900;
    font-size: 16px;
    text-transform: uppercase;
  }

  .hp23-test-card__verified {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    opacity: 0.7;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp23-tests-wrapper" id="HP23Tests-{{ section.id }}">
  
  {%- if section.settings.title != blank -%}
    <div class="hp23-tests__header">
      <h2 class="hp23-tests__title">{{ section.settings.title }}</h2>
    </div>
  {%- endif -%}

  <div class="hp23-tests__grid">
    {%- for block in section.blocks -%}
      <div class="hp23-test-card" {{ block.shopify_attributes }}>
        <div class="hp23-test-card__quote-mark">"</div>
        
        <div class="hp23-test-card__rating">
          {%- for i in (1..5) -%}
            <svg viewBox="0 0 24 24"><path d="M12,17.27L18.18,21L16.54,13.97L22,9.24L14.81,8.62L12,2L9.19,8.62L2,9.24L7.45,13.97L5.82,21L12,17.27Z"/></svg>
          {%- endfor -%}
        </div>

        <div class="hp23-test-card__text">"{{ block.settings.text | escape }}"</div>

        <div class="hp23-test-card__footer">
          {%- assign initial = block.settings.author | slice: 0 | upcase -%}
          <div class="hp23-test-card__initial">{{ initial }}</div>
          <div class="hp23-test-card__author">
            <span class="hp23-test-card__name">{{ block.settings.author | escape }}</span>
            <span class="hp23-test-card__verified">VERIFIED BUYER</span>
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>

</div>

{% schema %}
{
  "name": "HP23 - Brutalist Reviews",
  "class": "section-hp23-testimonials",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Heading",
      "default": "<p>DON'T JUST TAKE <em>OUR WORD</em> FOR IT</p>"
    },
    {
      "type": "range",
      "id": "header_margin",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Margin Below Header",
      "default": 60
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1400
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns (Desktop)",
      "default": 3
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Card Border Radius",
      "default": 12
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 48
    },
    {
      "type": "header",
      "content": "Brutalist Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#F4F4F0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color (Alternating Cards)",
      "default": "#FFEB3B"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Review",
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "Review Text",
          "default": "Literally changed my life. I threw away all my other products."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author Name",
          "default": "JESSICA T."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP23 - Brutalist Reviews",
      "blocks": [
        { "type": "testimonial", "settings": { "text": "I was skeptical because of the bold claims, but it actually works exactly as advertised.", "author": "SARAH M." } },
        { "type": "testimonial", "settings": { "text": "Unapologetically effective. No fluffy marketing, just results that speak for themselves.", "author": "MICHAEL R." } },
        { "type": "testimonial", "settings": { "text": "Finally a brand that cuts through the noise. I'm a customer for life.", "author": "ELENA D." } }
      ]
    }
  ]
}
{% endschema %}
