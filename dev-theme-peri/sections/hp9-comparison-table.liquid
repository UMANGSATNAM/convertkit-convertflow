{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#050505'
  assign text_color = section.settings.text_color | default: '#ffffff'
  assign accent_color = section.settings.accent_color | default: '#00ff88'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 100px 20px;
    color: {{ text_color }};
    font-family: 'Space Mono', monospace;
  }
  
  .hp9-specs-container-{{ section_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }
  
  .hp9-specs-header-{{ section_id }} {
    text-align: center;
    margin-bottom: 60px;
  }
  
  .hp9-specs-title-{{ section_id }} {
    font-size: 2rem;
    font-weight: 700;
    color: #fff;
    margin: 0 0 15px 0;
    text-transform: uppercase;
  }
  
  .hp9-specs-title-{{ section_id }} span {
    color: {{ accent_color }};
  }
  
  .hp9-specs-table-wrapper-{{ section_id }} {
    background: #0a0a0d;
    border: 1px solid rgba(0, 255, 136, 0.2);
    border-radius: 4px;
    overflow-x: auto;
  }
  
  .hp9-specs-table-{{ section_id }} {
    width: 100%;
    border-collapse: collapse;
    min-width: 600px;
  }
  
  .hp9-specs-table-{{ section_id }} th,
  .hp9-specs-table-{{ section_id }} td {
    padding: 20px 25px;
    text-align: left;
    border-bottom: 1px solid rgba(255,255,255,0.05);
  }
  
  .hp9-specs-table-{{ section_id }} th {
    font-weight: 700;
    color: rgba(255,255,255,0.5);
    text-transform: uppercase;
    font-size: 0.85rem;
    letter-spacing: 1px;
    border-bottom: 1px solid rgba(0, 255, 136, 0.2);
  }
  
  .hp9-specs-table-{{ section_id }} td {
    font-size: 0.95rem;
    color: #ccc;
  }
  
  .hp9-specs-table-{{ section_id }} tr:last-child td {
    border-bottom: none;
  }
  
  .hp9-specs-table-{{ section_id }} tbody tr:hover {
    background: rgba(0, 255, 136, 0.03);
  }
  
  .hp9-specs-table-{{ section_id }} td:first-child {
    font-weight: 700;
    color: {{ accent_color }};
    width: 30%;
  }

  @media (max-width: 768px) {
    .hp9-specs-table-{{ section_id }} th,
    .hp9-specs-table-{{ section_id }} td {
      padding: 15px;
    }
  }
</style>

<div class="hp9-specs-container-{{ section_id }}">
  <div class="hp9-specs-header-{{ section_id }}">
    <h2 class="hp9-specs-title-{{ section_id }}">SYSTEM <span>SPECIFICATIONS</span></h2>
  </div>
  
  <div class="hp9-specs-table-wrapper-{{ section_id }}">
    <table class="hp9-specs-table-{{ section_id }}">
      <thead>
        <tr>
          <th>PARAMETER</th>
          <th>CURRENT_GEN</th>
          <th>NEXT_GEN (OURS)</th>
        </tr>
      </thead>
      <tbody>
        {% for block in section.blocks %}
          <tr {{ block.shopify_attributes }}>
            <td>> {{ block.settings.param }}</td>
            <td>{{ block.settings.val1 }}</td>
            <td style="color: #fff; font-weight: 700;">{{ block.settings.val2 }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>

{% schema %}
{
  "name": "HP9 Specs Table",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#050505"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#00ff88"
    }
  ],
  "blocks": [
    {
      "type": "spec",
      "name": "Specification",
      "settings": [
        {
          "type": "text",
          "id": "param",
          "label": "Parameter Name",
          "default": "Processing Speed"
        },
        {
          "type": "text",
          "id": "val1",
          "label": "Standard Value",
          "default": "3.5 GHz"
        },
        {
          "type": "text",
          "id": "val2",
          "label": "Our Value",
          "default": "5.2 GHz Max Boost"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP9 Specs Table",
      "blocks": [
        { "type": "spec", "settings": { "param": "Processing Speed", "val1": "3.5 GHz", "val2": "5.2 GHz Max Boost" } },
        { "type": "spec", "settings": { "param": "Thermal Design", "val1": "Standard Air", "val2": "Cryo-Liquid Cooling" } },
        { "type": "spec", "settings": { "param": "Latency", "val1": "15ms", "val2": "< 1ms" } },
        { "type": "spec", "settings": { "param": "Build Material", "val1": "Plastic / Aluminum", "val2": "Carbon Fiber / Titanium" } }
      ]
    }
  ]
}
{% endschema %}
