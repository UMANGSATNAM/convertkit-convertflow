{%- style -%}
  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --border-color: {{ section.settings.border_color }};
    --border-thickness: {{ section.settings.border_thickness }}px;
    --shadow-color: {{ section.settings.shadow_color }};
    --shadow-offset: {{ section.settings.shadow_offset }}px;
    --accent-color: {{ section.settings.accent_color }};
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }

  .hp20-faq-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    flex-direction: {% if section.settings.layout == 'side_by_side' %}row{% else %}column{% endif %};
    gap: 40px;
    align-items: {% if section.settings.layout == 'side_by_side' %}flex-start{% else %}center{% endif %};
  }

  @media screen and (max-width: 992px) {
    .hp20-faq-wrapper {
      flex-direction: column;
      align-items: stretch;
    }
  }

  .hp20-faq__header {
    flex: 1;
    max-width: {% if section.settings.layout == 'side_by_side' %}400px{% else %}100%{% endif %};
    text-align: {% if section.settings.layout == 'side_by_side' %}left{% else %}center{% endif %};
  }

  .hp20-faq__title {
    font-family: 'Inter', sans-serif;
    font-weight: 900;
    font-size: clamp(36px, 6vw, {{ section.settings.title_size }}px);
    color: var(--text-color);
    text-transform: uppercase;
    letter-spacing: -1px;
    margin: 0 0 16px;
    line-height: 1.1;
  }

  .hp20-faq__subtitle {
    font-family: 'Inter', sans-serif;
    font-size: {{ section.settings.subtitle_size }}px;
    font-weight: 500;
    color: var(--text-color);
    margin: 0 0 32px;
  }

  .hp20-faq__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 32px;
    background: var(--text-color);
    color: var(--bg-color); /* assuming contrast */
    font-family: 'Inter', sans-serif;
    font-weight: 800;
    font-size: 15px;
    text-transform: uppercase;
    letter-spacing: 1px;
    text-decoration: none;
    border: var(--border-thickness) solid var(--border-color);
    box-shadow: calc(var(--shadow-offset)/2) calc(var(--shadow-offset)/2) 0px var(--shadow-color);
    transition: all 0.1s ease;
  }

  .hp20-faq__btn:hover {
    background: var(--accent-color);
    color: var(--text-color);
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0px var(--shadow-color);
  }

  .hp20-faq__content {
    flex: 2;
    width: 100%;
  }

  .hp20-faq__item {
    background: #fff;
    border: var(--border-thickness) solid var(--border-color);
    margin-bottom: {{ section.settings.item_gap }}px;
    box-shadow: var(--shadow-offset) var(--shadow-offset) 0px var(--shadow-color);
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .hp20-faq__item:hover {
    transform: translate(calc(var(--shadow-offset) * -0.2), calc(var(--shadow-offset) * -0.2));
    box-shadow: calc(var(--shadow-offset) * 1.2) calc(var(--shadow-offset) * 1.2) 0px var(--shadow-color);
  }

  .hp20-faq__question {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24px;
    cursor: pointer;
  }

  .hp20-faq__q-text {
    font-family: 'Inter', sans-serif;
    font-weight: 800;
    font-size: {{ section.settings.q_size }}px;
    color: var(--text-color);
    text-transform: uppercase;
    margin: 0;
    padding-right: 24px;
  }

  .hp20-faq__icon {
    width: 32px;
    height: 32px;
    background: var(--accent-color);
    border: var(--border-thickness) solid var(--border-color);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Inter', sans-serif;
    font-weight: 900;
    font-size: 24px;
    color: var(--text-color);
    flex-shrink: 0;
    transition: transform 0.3s ease;
  }

  .hp20-faq__item.is-open .hp20-faq__icon {
    transform: rotate(45deg);
    background: var(--text-color);
    color: var(--accent-color);
  }

  .hp20-faq__answer {
    display: none;
    padding: 0 24px 24px 24px;
    border-top: var(--border-thickness) dashed var(--border-color);
    margin-top: -10px; /* pull up under dashed border */
    padding-top: 24px;
  }

  .hp20-faq__item.is-open .hp20-faq__answer {
    display: block;
    animation: hp20SlideDown 0.3s ease forwards;
  }
  
  @keyframes hp20SlideDown {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .hp20-faq__a-text {
    font-family: 'Inter', sans-serif;
    font-size: {{ section.settings.a_size }}px;
    font-weight: 500;
    line-height: 1.6;
    color: var(--text-color);
    margin: 0;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp20-faq-wrapper" id="HP20FAQ-{{ section.id }}">
  
  <div class="hp20-faq__header">
    {%- if section.settings.title != blank -%}
      <h2 class="hp20-faq__title">{{ section.settings.title | escape }}</h2>
    {%- endif -%}
    
    {%- if section.settings.subtitle != blank -%}
      <p class="hp20-faq__subtitle">{{ section.settings.subtitle | escape }}</p>
    {%- endif -%}
    
    {%- if section.settings.btn_text != blank and section.settings.btn_link != blank -%}
      <a href="{{ section.settings.btn_link }}" class="hp20-faq__btn">
        {{ section.settings.btn_text | escape }}
      </a>
    {%- endif -%}
  </div>

  <div class="hp20-faq__content">
    {%- for block in section.blocks -%}
      <div class="hp20-faq__item {% if forloop.first and section.settings.open_first %}is-open{% endif %}" {{ block.shopify_attributes }}>
        <div class="hp20-faq__question" onclick="this.parentElement.classList.toggle('is-open')">
          <h3 class="hp20-faq__q-text">{{ block.settings.question | escape }}</h3>
          <div class="hp20-faq__icon">+</div>
        </div>
        <div class="hp20-faq__answer">
          <div class="hp20-faq__a-text">{{ block.settings.answer }}</div>
        </div>
      </div>
    {%- endfor -%}
  </div>

</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const section = document.getElementById('HP20FAQ-{{ section.id }}');
    if (!section) return;
    
    const questions = section.querySelectorAll('.hp20-faq__question');
    
    questions.forEach(q => {
      q.addEventListener('click', () => {
        {% if section.settings.accordion_mode %}
        // Close others
        const allItems = section.querySelectorAll('.hp20-faq__item');
        allItems.forEach(item => {
          if (item !== q.parentElement) {
            item.classList.remove('is-open');
          }
        });
        {% endif %}
      });
    });
  });
</script>

{% schema %}
{
  "name": "HP20 - Brutalist FAQ",
  "class": "section-hp20-faq",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
