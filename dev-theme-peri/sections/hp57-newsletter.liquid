{%- style -%}
  #shopify-section-{{ section.id }} {
    background: radial-gradient(circle at 50% 50%, #1B4332 0%, #0A1C14 100%);
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }
  .hp57-news__container { max-width: {{ section.settings.container_width | default: 700 }}px; margin: 0 auto; padding: 0 24px; text-align: center; }
  .hp57-news__eyebrow { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: #D97706; margin: 0 0 16px; }
  .hp57-news__heading { font-family: 'Cormorant Garamond', serif; font-size: clamp(28px, 4vw, 44px); font-weight: 700; color: #FFFFFF; margin: 0 0 16px; }
  .hp57-news__desc { font-size: 15px; line-height: 1.7; color: #CBD5E1; margin: 0 0 32px; }
  .hp57-news__form { display: flex; gap: 12px; max-width: 480px; margin: 0 auto; }
  .hp57-news__input {
    flex: 1; padding: 15px 22px; background: #0F291E; border: 1px solid rgba(167, 243, 208, 0.3);
    border-radius: 6px; color: #FFFFFF; font-family: 'Plus Jakarta Sans', sans-serif; font-size: 14px;
  }
  .hp57-news__input::placeholder { color: rgba(203, 213, 225, 0.6); }
  .hp57-news__btn {
    padding: 15px 32px; background: {{ section.settings.btn_bg | default: '#D97706' }};
    color: #0F291E; border: none; border-radius: 6px; font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 13px; font-weight: 700; cursor: pointer; transition: all 0.3s ease;
    box-shadow: 0 4px 20px rgba(217, 119, 6, 0.35);
  }
  .hp57-news__btn:hover { box-shadow: 0 8px 30px rgba(217, 119, 6, 0.55); transform: translateY(-2px); }
  @media screen and (max-width: 480px) { .hp57-news__form { flex-direction: column; } }
{%- endstyle -%}
<div class="hp57-news__container">
  {%- if section.settings.eyebrow != blank -%}<p class="hp57-news__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
  <h2 class="hp57-news__heading">{{ section.settings.heading | default: 'The Herbalist Almanac' }}</h2>
  <p class="hp57-news__desc">{{ section.settings.description | default: 'Receive seasonal botanical harvesting calendars, apothecary formulation notes, and member privileges.' }}</p>
  {%- form 'customer', id: 'hp57-newsletter' -%}
    <input type="hidden" name="contact[tags]" value="newsletter">
    <div class="hp57-news__form">
      <input type="email" name="contact[email]" class="hp57-news__input" placeholder="{{ section.settings.placeholder | default: 'Your botanical email' }}" required>
      <button type="submit" class="hp57-news__btn">{{ section.settings.btn_label | default: 'Subscribe' }}</button>
    </div>
  {%- endform -%}
</div>
{% schema %}
{
  "name": "HP57 Newsletter",
  "class": "section-hp57-news",
  "settings": [
    { "type": "color", "id": "btn_bg", "label": "Button BG", "default": "#D97706" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "🌿 BOTANICAL ALMANAC" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Herbalist Almanac" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Receive seasonal botanical harvesting calendars and apothecary formulation notes." },
    { "type": "text", "id": "placeholder", "label": "Placeholder", "default": "Your botanical email" },
    { "type": "text", "id": "btn_label", "label": "Button Label", "default": "Subscribe" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 500, "max": 900, "step": 20, "unit": "px", "label": "Container Width", "default": 700 }
  ],
  "presets": [{ "name": "HP57 Newsletter" }]
}
{% endschema %}
