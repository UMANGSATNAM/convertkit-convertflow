{%- comment -%}
  PDP V12: ACTIVEWEAR / GYM GEAR (Gymshark Style)
  Aesthetic: High Contrast, Athletic, Bold Typography.
  CRO: Size scarcity, "Complete the Set" bundles, Sticky ATC.
{%- endcomment -%}

{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign random_viewing = 'now' | date: '%s' | modulo: 40 | plus: 15 -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Teko:wght@500;600;700&family=Inter:wght@400;600;700&display=swap');

  :root {
    --v12-bg: #FFFFFF;
    --v12-text: #111111;
    --v12-text-light: #666666;
    --v12-accent: #E50000; /* Athletic Red */
    --v12-border: #EEEEEE;
    --v12-font-head: 'Teko', sans-serif;
    --v12-font-body: 'Inter', sans-serif;
  }

  .pdp-v12 {
    background-color: var(--v12-bg);
    color: var(--v12-text);
    font-family: var(--v12-font-body);
  }

  .pdp-v12__container {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
  }
  @media (min-width: 992px) {
    .pdp-v12__container { grid-template-columns: 1fr 450px; }
  }

  /* --- GALLERY (MASONRY STYLE) --- */
  .pdp-v12__gallery {
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px;
    background: var(--v12-border);
  }
  .pdp-v12__gallery img, .pdp-v12__gallery svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 3/4;
    background: #F8F8F8;
    display: block;
  }
  .pdp-v12__gallery-hero { grid-column: 1 / -1; aspect-ratio: 4/5; }

  /* --- INFO BOX --- */
  .pdp-v12__info {
    padding: 24px;
    background: var(--v12-bg);
  }
  @media (min-width: 992px) {
    .pdp-v12__info { padding: 40px; position: sticky; top: 0; height: 100vh; overflow-y: auto; }
  }

  /* --- HEADER --- */
  .pdp-v12__trending {
    display: inline-flex; align-items: center; gap: 6px;
    background: #FEE2E2; color: var(--v12-accent);
    padding: 4px 10px; border-radius: 4px;
    font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px;
    margin-bottom: 16px;
  }
  .pdp-v12__trending span { width: 6px; height: 6px; background: var(--v12-accent); border-radius: 50%; animation: pulse 2s infinite; }
  @keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(229, 0, 0, 0.4); } 70% { box-shadow: 0 0 0 6px rgba(229, 0, 0, 0); } 100% { box-shadow: 0 0 0 0 rgba(229, 0, 0, 0); } }

  .pdp-v12__title { font-family: var(--v12-font-head); font-size: 42px; font-weight: 600; line-height: 1; text-transform: uppercase; margin: 0 0 8px 0; }
  .pdp-v12__subtitle { font-size: 14px; color: var(--v12-text-light); margin-bottom: 24px; }
  
  .pdp-v12__price-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 32px; border-bottom: 1px solid var(--v12-border); padding-bottom: 24px; }
  .pdp-v12__price { font-size: 24px; font-weight: 700; }
  .pdp-v12__compare { font-size: 16px; color: var(--v12-text-light); text-decoration: line-through; margin-left: 8px; font-weight: 400; }
  .pdp-v12__urgency { font-size: 12px; font-weight: 600; display: flex; align-items: center; gap: 6px; }
  .pdp-v12__urgency svg { width: 14px; height: 14px; }

  /* --- SIZE SELECTOR --- */
  .pdp-v12__size-head { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 12px; }
  .pdp-v12__label { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; }
  .pdp-v12__guide { font-size: 12px; text-decoration: underline; color: var(--v12-text-light); cursor: pointer; }
  .pdp-v12__sizes { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; margin-bottom: 8px; }
  .pdp-v12__size {
    border: 1px solid var(--v12-border); background: #FFF; padding: 12px 0; text-align: center;
    font-size: 14px; font-weight: 600; cursor: pointer; transition: all 0.2s; border-radius: 4px;
  }
  .pdp-v12__size.active { border-color: var(--v12-text); background: var(--v12-text); color: #FFF; }
  .pdp-v12__size.low-stock { border-color: var(--v12-accent); color: var(--v12-accent); }
  .pdp-v12__stock-msg { font-size: 11px; color: var(--v12-accent); font-weight: 600; margin-bottom: 32px; text-align: right; }

  /* --- ATC --- */
  .pdp-v12__atc {
    width: 100%; background: var(--v12-text); color: #FFF; border: none; padding: 20px;
    font-family: var(--v12-font-head); font-size: 24px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px;
    cursor: pointer; margin-bottom: 16px; transition: transform 0.1s;
  }
  .pdp-v12__atc:active { transform: scale(0.98); }

  /* --- FEATURES LIST --- */
  .pdp-v12__features { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 32px; }
  .pdp-v12__feature { display: flex; align-items: center; gap: 8px; font-size: 12px; font-weight: 600; text-transform: uppercase; color: var(--v12-text-light); }
  .pdp-v12__feature svg { width: 16px; height: 16px; color: var(--v12-text); }

  /* --- COMPLETE THE SET (FBT) --- */
  .pdp-v12__set { background: #F9F9F9; padding: 20px; margin-bottom: 32px; border: 1px solid var(--v12-border); }
  .pdp-v12__set-title { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 16px; }
  .pdp-v12__set-item { display: flex; gap: 16px; align-items: center; }
  .pdp-v12__set-img { width: 70px; height: 90px; object-fit: cover; background: #EEE; }
  .pdp-v12__set-info { flex: 1; }
  .pdp-v12__set-name { font-weight: 700; font-size: 13px; text-transform: uppercase; margin-bottom: 4px; }
  .pdp-v12__set-price { font-size: 13px; margin-bottom: 8px; }
  .pdp-v12__set-btn {
    border: 1px solid var(--v12-text); background: transparent; padding: 6px 16px;
    font-size: 11px; font-weight: 700; text-transform: uppercase; cursor: pointer;
  }
  .pdp-v12__set-btn:hover { background: var(--v12-text); color: #FFF; }

  /* --- ACCORDION --- */
  .pdp-v12__acc { border-top: 1px solid var(--v12-border); }
  .pdp-v12__acc-btn {
    width: 100%; text-align: left; background: none; border: none; padding: 20px 0;
    font-family: var(--v12-font-head); font-size: 22px; font-weight: 600; text-transform: uppercase;
    display: flex; justify-content: space-between; cursor: pointer; align-items: center;
  }
  .pdp-v12__acc-content { padding-bottom: 20px; font-size: 14px; color: var(--v12-text-light); line-height: 1.6; }
  .pdp-v12__acc-content ul { padding-left: 20px; margin: 0; }
  .pdp-v12__acc-content li { margin-bottom: 8px; }

  /* --- STICKY ATC --- */
  .pdp-v12-sticky {
    position: fixed; bottom: -100px; left: 0; width: 100%; background: #FFF; box-shadow: 0 -4px 10px rgba(0,0,0,0.1);
    z-index: 999; padding: 12px 20px; display: flex; justify-content: space-between; align-items: center;
    transition: bottom 0.3s ease; border-top: 2px solid var(--v12-text);
  }
  .pdp-v12-sticky.visible { bottom: 0; }
  .pdp-v12-sticky__title { font-family: var(--v12-font-head); font-size: 24px; font-weight: 600; text-transform: uppercase; line-height: 1; }
  .pdp-v12-sticky__price { font-size: 14px; font-weight: 700; color: var(--v12-text-light); }
  .pdp-v12-sticky__btn {
    background: var(--v12-text); color: #FFF; border: none; padding: 12px 32px;
    font-family: var(--v12-font-head); font-size: 20px; font-weight: 600; text-transform: uppercase; cursor: pointer;
  }

</style>

<div class="pdp-v12" data-section="{{ section.id }}">
  
  <div class="pdp-v12__container">
    
    <!-- GALLERY -->
    <div class="pdp-v12__gallery">
      {% if product.featured_media %}
        <img src="{{ product.featured_media | image_url: width: 800 }}" class="pdp-v12__gallery-hero">
        <img src="{{ product.featured_media | image_url: width: 600 }}">
        <img src="{{ product.featured_media | image_url: width: 600 }}">
        <img src="{{ product.featured_media | image_url: width: 600 }}">
        <img src="{{ product.featured_media | image_url: width: 600 }}">
      {% else %}
        <div class="pdp-v12__gallery-hero">{{ 'product-1' | placeholder_svg_tag }}</div>
        <div>{{ 'product-2' | placeholder_svg_tag }}</div>
        <div>{{ 'product-3' | placeholder_svg_tag }}</div>
        <div>{{ 'product-4' | placeholder_svg_tag }}</div>
        <div>{{ 'product-5' | placeholder_svg_tag }}</div>
      {% endif %}
    </div>

    <!-- INFO BOX -->
    <div class="pdp-v12__info">
      
      {% if section.settings.show_trending %}
        <div class="pdp-v12__trending">
          <span></span> High Demand
        </div>
      {% endif %}
      
      <h1 class="pdp-v12__title">{{ product.title | default: "Adapt Seamless Leggings" }}</h1>
      <div class="pdp-v12__subtitle">Black / High-Waisted Fit</div>
      
      <div class="pdp-v12__price-row">
        <div>
          <span class="pdp-v12__price">{{ current_variant.price | money }}</span>
          {% if current_variant.compare_at_price > current_variant.price %}
            <span class="pdp-v12__compare">{{ current_variant.compare_at_price | money }}</span>
          {% endif %}
        </div>
        <div class="pdp-v12__urgency">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
          {{ random_viewing }} VIEWING RIGHT NOW
        </div>
      </div>

      <!-- SIZES -->
      <div class="pdp-v12__size-head">
        <span class="pdp-v12__label">Select Size</span>
        <span class="pdp-v12__guide">Size Guide</span>
      </div>
      <div class="pdp-v12__sizes">
        <div class="pdp-v12__size">XS</div>
        <div class="pdp-v12__size active">S</div>
        <div class="pdp-v12__size low-stock">M</div>
        <div class="pdp-v12__size">L</div>
      </div>
      <div class="pdp-v12__stock-msg">Only 2 left in Size M!</div>

      <button class="pdp-v12__atc" id="v12-atc">ADD TO BAG</button>

      <!-- FEATURES -->
      <div class="pdp-v12__features">
        <div class="pdp-v12__feature">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg> Squat Proof
        </div>
        <div class="pdp-v12__feature">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg> Sweat-Wicking
        </div>
        <div class="pdp-v12__feature">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg> Seamless Knit
        </div>
        <div class="pdp-v12__feature">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg> Free Returns
        </div>
      </div>

      <!-- COMPLETE THE SET (FBT) -->
      {% if section.settings.show_set %}
        <div class="pdp-v12__set">
          <div class="pdp-v12__set-title">Complete The Set</div>
          <div class="pdp-v12__set-item">
            {{ 'product-3' | placeholder_svg_tag: 'pdp-v12__set-img' }}
            <div class="pdp-v12__set-info">
              <div class="pdp-v12__set-name">Adapt Seamless Sports Bra</div>
              <div class="pdp-v12__set-price">â‚¹1499</div>
              <button class="pdp-v12__set-btn">Add To Bag</button>
            </div>
          </div>
        </div>
      {% endif %}

      <!-- ACCORDIONS -->
      <div class="pdp-v12__acc">
        <button class="pdp-v12__acc-btn">Description <span>+</span></button>
        <div class="pdp-v12__acc-content">
          {{ product.description | strip_html | default: "The Adapt Seamless Leggings are designed to move with you. High-waisted fit, ribbed waistband, and seamless contouring details." }}
        </div>
      </div>
      <div class="pdp-v12__acc">
        <button class="pdp-v12__acc-btn">Features <span>+</span></button>
        <div class="pdp-v12__acc-content" style="display:none;">
          <ul>
            <li>High waisted fit</li>
            <li>Ribbed waistband</li>
            <li>Seamless contouring patterns</li>
            <li>Sweat-wicking fabric</li>
          </ul>
        </div>
      </div>
      <div class="pdp-v12__acc" style="border-bottom: 1px solid var(--v12-border);">
        <button class="pdp-v12__acc-btn">Delivery & Returns <span>+</span></button>
        <div class="pdp-v12__acc-content" style="display:none;">
          Free standard shipping on orders over â‚¹2000. Free returns within 30 days.
        </div>
      </div>

    </div>
  </div>

  <!-- FULL WIDTH IMAGE / LIFESTYLE -->
  {% if section.settings.show_full_image %}
    <div style="width: 100%; position: relative; margin-top: 40px; border-top: 5px solid var(--v12-text);">
      {{ 'lifestyle-1' | placeholder_svg_tag: 'style="width: 100%; height: 60vh; object-fit: cover;"' }}
      <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; color: #FFF; padding: 20px;">
        <h2 style="font-family: var(--v12-font-head); font-size: 64px; font-weight: 700; margin-bottom: 0; text-transform: uppercase; line-height: 1;">PUSH YOUR LIMITS.</h2>
        <p style="font-size: 18px; max-width: 600px; margin-bottom: 32px; font-weight: 600;">Engineered for peak performance. Built to withstand your toughest workouts.</p>
        <button style="background: #FFF; color: var(--v12-text); border: none; padding: 16px 40px; font-family: var(--v12-font-head); font-weight: 700; font-size: 24px; cursor: pointer; text-transform: uppercase; transition: transform 0.2s;" onclick="window.scrollTo({top: 0, behavior: 'smooth'})" onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'">SHOP MENS</button>
      </div>
    </div>
  {% endif %}

  <!-- FEATURED PRODUCT SECTION -->
  {% if section.settings.show_featured %}
    <div style="max-width: 1400px; margin: 40px auto; padding: 20px;">
      <h2 style="font-family: var(--v12-font-head); font-size: 32px; font-weight: 600; text-transform: uppercase; margin-bottom: 20px; color: var(--v12-text);">Trending Gear</h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px;">
        <div style="background: var(--v12-bg); padding: 16px; border: 1px solid var(--v12-border); border-radius: 4px;">
          {{ 'product-6' | placeholder_svg_tag: 'style="width:100%; border-radius:4px; margin-bottom:12px; background:#F8F8F8;"' }}
          <h3 style="font-family: var(--v12-font-head); font-size: 20px; font-weight: 600; text-transform: uppercase; margin-bottom: 4px; color: var(--v12-text);">Vital Seamless 2.0</h3>
          <p style="color: var(--v12-text-light); font-weight: 600; font-size: 14px;">â‚¹2,199</p>
          <button style="width: 100%; background: var(--v12-text); color: #FFF; border: none; padding: 10px; font-family: var(--v12-font-head); font-size: 18px; text-transform: uppercase; margin-top: 12px; cursor: pointer;">Add to Bag</button>
        </div>
        <div style="background: var(--v12-bg); padding: 16px; border: 1px solid var(--v12-border); border-radius: 4px;">
          {{ 'product-5' | placeholder_svg_tag: 'style="width:100%; border-radius:4px; margin-bottom:12px; background:#F8F8F8;"' }}
          <h3 style="font-family: var(--v12-font-head); font-size: 20px; font-weight: 600; text-transform: uppercase; margin-bottom: 4px; color: var(--v12-text);">Legacy Drop Arm Tank</h3>
          <p style="color: var(--v12-text-light); font-weight: 600; font-size: 14px;">â‚¹1,299</p>
          <button style="width: 100%; background: var(--v12-text); color: #FFF; border: none; padding: 10px; font-family: var(--v12-font-head); font-size: 18px; text-transform: uppercase; margin-top: 12px; cursor: pointer;">Add to Bag</button>
        </div>
        <div style="background: var(--v12-bg); padding: 16px; border: 1px solid var(--v12-border); border-radius: 4px;">
          {{ 'product-4' | placeholder_svg_tag: 'style="width:100%; border-radius:4px; margin-bottom:12px; background:#F8F8F8;"' }}
          <h3 style="font-family: var(--v12-font-head); font-size: 20px; font-weight: 600; text-transform: uppercase; margin-bottom: 4px; color: var(--v12-text);">Apex Perform Shorts</h3>
          <p style="color: var(--v12-text-light); font-weight: 600; font-size: 14px;">â‚¹1,799</p>
          <button style="width: 100%; background: var(--v12-text); color: #FFF; border: none; padding: 10px; font-family: var(--v12-font-head); font-size: 18px; text-transform: uppercase; margin-top: 12px; cursor: pointer;">Add to Bag</button>
        </div>
        <div style="background: var(--v12-bg); padding: 16px; border: 1px solid var(--v12-border); border-radius: 4px;">
          {{ 'product-3' | placeholder_svg_tag: 'style="width:100%; border-radius:4px; margin-bottom:12px; background:#F8F8F8;"' }}
          <h3 style="font-family: var(--v12-font-head); font-size: 20px; font-weight: 600; text-transform: uppercase; margin-bottom: 4px; color: var(--v12-text);">Power Zip Hoodie</h3>
          <p style="color: var(--v12-text-light); font-weight: 600; font-size: 14px;">â‚¹2,999</p>
          <button style="width: 100%; background: var(--v12-text); color: #FFF; border: none; padding: 10px; font-family: var(--v12-font-head); font-size: 18px; text-transform: uppercase; margin-top: 12px; cursor: pointer;">Add to Bag</button>
        </div>
      </div>
    </div>
  {% endif %}

  <!-- RECENTLY VIEWED SECTION -->
  {% if section.settings.show_recent %}
    <div style="max-width: 1400px; margin: 40px auto 80px auto; padding: 20px;">
      <h2 style="font-family: var(--v12-font-head); font-size: 24px; font-weight: 600; text-transform: uppercase; margin-bottom: 20px; color: var(--v12-text);">Recently Viewed</h2>
      <div style="display: flex; gap: 16px; overflow-x: auto; padding-bottom: 16px;">
        <div style="min-width: 150px; background: var(--v12-bg); padding: 12px; border: 1px solid var(--v12-border); border-radius: 4px;">
          {{ 'product-2' | placeholder_svg_tag: 'style="width:100%; border-radius:4px; margin-bottom:8px; background:#F8F8F8;"' }}
          <h4 style="font-size: 12px; font-weight: 700; text-transform: uppercase; margin: 0; color: var(--v12-text);">Speed Shorts</h4>
        </div>
        <div style="min-width: 150px; background: var(--v12-bg); padding: 12px; border: 1px solid var(--v12-border); border-radius: 4px;">
          {{ 'product-1' | placeholder_svg_tag: 'style="width:100%; border-radius:4px; margin-bottom:8px; background:#F8F8F8;"' }}
          <h4 style="font-size: 12px; font-weight: 700; text-transform: uppercase; margin: 0; color: var(--v12-text);">Everyday Tee</h4>
        </div>
        <div style="min-width: 150px; background: var(--v12-bg); padding: 12px; border: 1px solid var(--v12-border); border-radius: 4px;">
          {{ 'product-4' | placeholder_svg_tag: 'style="width:100%; border-radius:4px; margin-bottom:8px; background:#F8F8F8;"' }}
          <h4 style="font-size: 12px; font-weight: 700; text-transform: uppercase; margin: 0; color: var(--v12-text);">Lifting Belt</h4>
        </div>
      </div>
    </div>
  {% endif %}

  <!-- BUILT-IN STICKY ATC -->
  <div class="pdp-v12-sticky" id="v12-sticky">
    <div>
      <div class="pdp-v12-sticky__title">{{ product.title | default: "Adapt Leggings" }}</div>
      <div class="pdp-v12-sticky__price">{{ current_variant.price | money }}</div>
    </div>
    <button class="pdp-v12-sticky__btn" onclick="window.scrollTo({top: 0, behavior: 'smooth'})">ADD TO BAG</button>
  </div>

  <script>
    document.addEventListener("DOMContentLoaded", function() {
      const accBtns = document.querySelectorAll('.pdp-v12__acc-btn');
      accBtns.forEach(btn => {
        btn.addEventListener('click', function() {
          const content = this.nextElementSibling;
          if (content.style.display === "none" || content.style.display === "") {
            content.style.display = "block";
            this.querySelector('span').innerText = "-";
          } else {
            content.style.display = "none";
            this.querySelector('span').innerText = "+";
          }
        });
      });

      const stickyBar = document.getElementById('v12-sticky');
      const mainAtc = document.getElementById('v12-atc');
      if(stickyBar && mainAtc) {
        window.addEventListener('scroll', function() {
          const mainAtcRect = mainAtc.getBoundingClientRect();
          if (mainAtcRect.top < 0) {
            stickyBar.classList.add('visible');
          } else {
            stickyBar.classList.remove('visible');
          }
        });
      }
    });
  </script>

</div>

{% schema %}
{
  "name": "PDP V12 - Activewear",
  "settings": [
    {
      "type": "header",
      "content": "Urgency Settings"
    },
    {
      "type": "checkbox",
      "id": "show_trending",
      "label": "Show 'High Demand' Pulse",
      "default": true
    },
    {
      "type": "header",
      "content": "Cross Sell Settings"
    },
    {
      "type": "checkbox",
      "id": "show_set",
      "label": "Show 'Complete The Set'",
      "default": true
    },
    {
      "type": "header",
      "content": "Bottom Sections"
    },
    {
      "type": "checkbox",
      "id": "show_full_image",
      "label": "Show Full Width Lifestyle Image",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_featured",
      "label": "Show Featured Products",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_recent",
      "label": "Show Recently Viewed",
