{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#00FFFF'
  assign text_color = section.settings.text_color | default: '#000000'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 100px 40px;
    border-bottom: 4px solid #000;
  }
  
  .hp16-faq-container-{{ section_id }} {
    max-width: 800px;
    margin: 0 auto;
  }
  
  .hp16-faq-header-{{ section_id }} {
    text-align: center;
    margin-bottom: 50px;
    position: relative;
  }
  
  .hp16-faq-title-{{ section_id }} {
    font-family: 'Arial Black', Impact, sans-serif;
    font-size: clamp(3rem, 5vw, 5rem);
    text-transform: uppercase;
    color: #FF00FF;
    -webkit-text-stroke: 2px #000;
    text-shadow: 4px 4px 0 #FFFF00;
    margin: 0;
    line-height: 1;
    transform: rotate(-2deg);
    display: inline-block;
  }
  
  .hp16-faq-item-{{ section_id }} {
    background: #FFF;
    border: 4px solid #000;
    border-radius: 20px;
    margin-bottom: 20px;
    box-shadow: 8px 8px 0 #000;
    overflow: hidden;
  }
  
  .hp16-faq-question-{{ section_id }} {
    padding: 20px;
    font-family: 'Comic Sans MS', cursive;
    font-size: 1.2rem;
    font-weight: bold;
    color: {{ text_color }};
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    background: #FFF;
  }
  
  .hp16-faq-icon-{{ section_id }} {
    width: 30px;
    height: 30px;
    background: #FF00FF;
    border: 3px solid #000;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #FFF;
    font-size: 1.2rem;
    line-height: 1;
    box-shadow: 3px 3px 0 #000;
  }
  
  .hp16-faq-answer-{{ section_id }} {
    padding: 0 20px 20px;
    font-family: 'Courier New', Courier, monospace;
    font-size: 1rem;
    font-weight: bold;
    color: #333;
    display: none;
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 60px 20px;
    }
    .hp16-faq-item-{{ section_id }} {
      box-shadow: 5px 5px 0 #000;
    }
  }
</style>

<div class="hp16-faq-container-{{ section_id }}">
  <div class="hp16-faq-header-{{ section_id }}">
    <h2 class="hp16-faq-title-{{ section_id }}">{{ section.settings.title | default: 'TEA TIME (FAQ)' }}</h2>
  </div>
  
  <div class="hp16-faq-list-{{ section_id }}">
    {% for block in section.blocks %}
      <div class="hp16-faq-item-{{ section_id }}" {{ block.shopify_attributes }}>
        <div class="hp16-faq-question-{{ section_id }}" onclick="this.nextElementSibling.style.display = this.nextElementSibling.style.display === 'block' ? 'none' : 'block';">
          {{ block.settings.title }}
          <div class="hp16-faq-icon-{{ section_id }}">+</div>
        </div>
        <div class="hp16-faq-answer-{{ section_id }}">
          {{ block.settings.text }}
        </div>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "HP16 FAQ",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#00FFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "TEA TIME (FAQ)"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Question"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Answer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP16 FAQ",
      "blocks": [
        { "type": "faq", "settings": { "title": "Do you ship internationally?", "text": "<p>Um, obviously! We ship worldwide so all the girlies can match.</p>" } },
        { "type": "faq", "settings": { "title": "How long does shipping take?", "text": "<p>Usually 3-5 business days. We know you need it for the weekend!</p>" } },
        { "type": "faq", "settings": { "title": "Can I return my stuff?", "text": "<p>Yes! As long as it's unworn with tags attached, within 30 days. Easy peasy.</p>" } }
      ]
    }
  ]
}
{% endschema %}
