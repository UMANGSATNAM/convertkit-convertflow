{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#FF00FF'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 100px 40px;
    border-bottom: 4px solid #000;
  }
  
  .hp16-newsletter-container-{{ section_id }} {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
    background: #FFFF00;
    border: 4px solid #000;
    border-radius: 40px;
    padding: 60px;
    box-shadow: 15px 15px 0 #00FFFF;
  }
  
  .hp16-newsletter-title-{{ section_id }} {
    font-family: 'Arial Black', Impact, sans-serif;
    font-size: clamp(2.5rem, 4vw, 4rem);
    text-transform: uppercase;
    color: #FFF;
    -webkit-text-stroke: 1.5px #000;
    text-shadow: 3px 3px 0 #000;
    margin: 0 0 15px 0;
  }
  
  .hp16-newsletter-text-{{ section_id }} {
    font-family: 'Comic Sans MS', cursive;
    font-size: 1.2rem;
    font-weight: bold;
    color: #000;
    margin: 0 0 40px 0;
  }
  
  .hp16-newsletter-form-{{ section_id }} {
    display: flex;
    gap: 10px;
    max-width: 500px;
    margin: 0 auto;
  }
  
  .hp16-newsletter-input-{{ section_id }} {
    flex: 1;
    padding: 15px 20px;
    border: 3px solid #000;
    border-radius: 30px;
    font-family: 'Comic Sans MS', cursive;
    font-size: 1rem;
    outline: none;
    background: #FFF;
  }
  
  .hp16-newsletter-btn-{{ section_id }} {
    padding: 15px 30px;
    background: #00FFFF;
    color: #000;
    border: 3px solid #000;
    border-radius: 30px;
    font-family: 'Arial Black', sans-serif;
    font-size: 1rem;
    cursor: pointer;
    box-shadow: 4px 4px 0 #000;
    transition: all 0.2s ease;
  }
  
  .hp16-newsletter-btn-{{ section_id }}:hover {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0 #000;
    background: #FFF;
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 60px 20px;
    }
    .hp16-newsletter-container-{{ section_id }} {
      padding: 40px 20px;
      box-shadow: 8px 8px 0 #00FFFF;
    }
    .hp16-newsletter-form-{{ section_id }} {
      flex-direction: column;
    }
  }
</style>

<div class="hp16-newsletter-container-{{ section_id }}">
  <h2 class="hp16-newsletter-title-{{ section_id }}">{{ section.settings.title | default: 'TXT ME LATER' }}</h2>
  <p class="hp16-newsletter-text-{{ section_id }}">{{ section.settings.text | default: 'Sign up for 10% off your first order, bestie.' }}</p>
  
  {% form 'customer', class: 'hp16-newsletter-form-' | append: section_id %}
    <input type="email" name="contact[email]" class="hp16-newsletter-input-{{ section_id }}" placeholder="your@email.com" required>
    <button type="submit" class="hp16-newsletter-btn-{{ section_id }}">SUBMIT</button>
  {% endform %}
</div>

{% schema %}
{
  "name": "HP16 Newsletter",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FF00FF"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "TXT ME LATER"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Sign up for 10% off your first order, bestie."
    }
  ],
  "presets": [
    {
      "name": "HP16 Newsletter"
    }
  ]
}
{% endschema %}
