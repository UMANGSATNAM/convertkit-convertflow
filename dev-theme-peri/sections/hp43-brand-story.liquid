{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: "#080B10" }};
    padding: {{ section.settings.padding_top | default: 100 }}px 20px {{ section.settings.padding_bottom | default: 100 }}px;
    position: relative;
  }

  .hp43-story__grid {
    max-width: 1320px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 70px;
    align-items: center;
    {% if section.settings.media_position == 'right' %}direction: rtl;{% endif %}
  }
  .hp43-story__grid > * { direction: ltr; }

  .hp43-story__media-box {
    background: {{ section.settings.card_bg | default: "#101622" }};
    border: 1px solid {{ section.settings.border_color | default: "#1E293B" }};
    border-radius: 8px;
    padding: 16px;
    box-shadow: 0 20px 50px rgba(0,0,0,0.5);
  }

  .hp43-story__media-box img,
  .hp43-story__media-box svg {
    width: 100%;
    height: {{ section.settings.image_height | default: 480 }}px;
    object-fit: cover;
    border-radius: 4px;
    display: block;
  }

  .hp43-story__badge {
    font-family: 'Rajdhani', sans-serif;
    font-size: 14px;
    font-weight: 700;
    color: {{ section.settings.badge_color | default: "#FF0055" }};
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 12px;
  }

  .hp43-story__title {
    font-family: 'Orbitron', sans-serif;
    font-size: 38px;
    font-weight: 900;
    color: {{ section.settings.text_color | default: "#F1F5F9" }};
    line-height: 1.15;
    margin: 0 0 24px;
    text-transform: uppercase;
  }

  .hp43-story__desc {
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    color: {{ section.settings.muted_color | default: "#64748B" }};
    line-height: 1.7;
    margin: 0 0 35px;
  }
  .hp43-story__desc p:first-child { margin-top: 0; }
  .hp43-story__desc p:last-child { margin-bottom: 0; }

  .hp43-story__metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 20px;
    border-top: 1px solid {{ section.settings.border_color | default: "#1E293B" }};
    padding-top: 24px;
  }

  .hp43-story__stat-num {
    font-family: 'Orbitron', sans-serif;
    font-size: 26px;
    font-weight: 800;
    color: {{ section.settings.accent_color | default: "#00F0FF" }};
  }

  .hp43-story__stat-lbl {
    font-family: 'Rajdhani', sans-serif;
    font-size: 13px;
    font-weight: 600;
    color: {{ section.settings.muted_color | default: "#64748B" }};
    text-transform: uppercase;
  }

  .hp43-story__cta {
    display: inline-block;
    margin-top: 28px;
    padding: 14px 28px;
    background: {{ section.settings.accent_color | default: "#00F0FF" }};
    color: {{ section.settings.bg_color | default: "#080B10" }};
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    text-decoration: none;
    border-radius: 4px;
    min-height: 44px;
  }

  @media screen and (max-width: 990px) {
    .hp43-story__grid { grid-template-columns: 1fr; gap: 40px; direction: ltr; }
    .hp43-story__media-box img,
    .hp43-story__media-box svg { height: 320px; }
    .hp43-story__title { font-size: 28px; }
  }
{%- endstyle -%}

<div id="hp43-story" class="hp43-story__grid">
  <div class="hp43-story__media-box">
    {%- if section.settings.image != blank -%}
      <img
        src="{{ section.settings.image | image_url: width: 1000 }}"
        alt="{{ section.settings.image.alt | default: section.settings.title | escape }}"
        width="1000" height="{{ section.settings.image_height | default: 480 }}" loading="lazy">
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag }}
    {%- endif -%}
  </div>

  <div class="hp43-story__content">
    {%- if section.settings.badge != blank -%}
      <div class="hp43-story__badge">{{ section.settings.badge }}</div>
    {%- endif -%}

    {%- if section.settings.title != blank -%}
      <h2 class="hp43-story__title">{{ section.settings.title }}</h2>
    {%- endif -%}

    {%- if section.settings.description != blank -%}
      <div class="hp43-story__desc">{{ section.settings.description }}</div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="hp43-story__metrics">
        {%- for block in section.blocks -%}
          <div {{ block.shopify_attributes }}>
            <div class="hp43-story__stat-num">{{ block.settings.value }}</div>
            <div class="hp43-story__stat-lbl">{{ block.settings.label }}</div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.cta_label != blank and section.settings.cta_link != blank -%}
      <a class="hp43-story__cta" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label }}</a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP43 - Cyber Story",
  "class": "section-hp43-story",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "image_height",
      "label": "Image height",
      "min": 240,
      "max": 640,
      "step": 20,
      "unit": "px",
      "default": 480
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Eyebrow",
      "default": "// Manifesto"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Built for uncompromising precision"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Body",
      "default": "<p>Tell your brand story here. What you make, who you make it for, and why it is built the way it is.</p>"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 180,
      "step": 4,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 180,
      "step": 4,
      "unit": "px",
      "default": 100
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#080B10"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Image frame",
      "default": "#101622"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Heading",
      "default": "#F1F5F9"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Body text",
      "default": "#64748B"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#00F0FF"
    },
    {
      "type": "color",
      "id": "badge_color",
      "label": "Eyebrow",
      "default": "#FF0055"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#1E293B"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "50K+"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Active users"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "HP43 - Cyber Story",
      "blocks": [
        { "type": "stat" },
        { "type": "stat" },
        { "type": "stat" }
      ]
    }
  ]
}
{% endschema %}
