{%- liquid
  assign bg_color = section.settings.bg_color | default: '#0066cc'
  assign text_color = section.settings.text_color | default: '#ffffff'
  
  assign padding_top_desktop = section.settings.padding_top_desktop
  assign padding_bottom_desktop = section.settings.padding_bottom_desktop
  assign padding_top_mobile = section.settings.padding_top_mobile
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile
-%}

<style>
  #shopify-section-{{ section.id }} {
    --hp5-press-bg: {{ bg_color }};
    --hp5-press-text: {{ text_color }};
    
    --hp5-press-pt-desk: {{ padding_top_desktop }}px;
    --hp5-press-pb-desk: {{ padding_bottom_desktop }}px;
    --hp5-press-pt-mob: {{ padding_top_mobile }}px;
    --hp5-press-pb-mob: {{ padding_bottom_mobile }}px;
  }

  .hp5-health-press-{{ section.id }} {
    padding-top: var(--hp5-press-pt-desk);
    padding-bottom: var(--hp5-press-pb-desk);
    background-color: var(--hp5-press-bg);
  }

  .hp5-press-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hp5-press-title {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--hp5-press-text);
    margin: 0 0 40px 0;
    opacity: 0.8;
  }

  .hp5-press-logos {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 60px;
    width: 100%;
  }

  .hp5-press-logo {
    opacity: 0.6;
    transition: all 0.3s ease;
    filter: grayscale(100%) brightness(200%);
    max-width: 150px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  /* If background is light, we might need a different filter. Let's make it invert dynamically if needed */
  {%- if bg_color == '#ffffff' or bg_color == '#f4f7f9' -%}
    .hp5-press-logo { filter: grayscale(100%) contrast(150%); opacity: 0.4; }
    .hp5-press-logo:hover { opacity: 1; filter: grayscale(0%) contrast(100%); }
  {%- else -%}
    .hp5-press-logo:hover { opacity: 1; }
  {%- endif -%}

  .hp5-press-logo img {
    max-width: 100%;
    height: auto;
    max-height: 45px;
    object-fit: contain;
  }

  .hp5-press-logo svg {
    max-width: 100%;
    height: 35px;
    fill: var(--hp5-press-text);
  }

  @media screen and (max-width: 1024px) {
    .hp5-press-logos {
      gap: 40px;
    }
  }

  @media screen and (max-width: 768px) {
    .hp5-health-press-{{ section.id }} {
      padding-top: var(--hp5-press-pt-mob);
      padding-bottom: var(--hp5-press-pb-mob);
    }
    .hp5-press-inner {
      padding: 0 20px;
    }
    .hp5-press-logos {
      gap: 30px 20px;
    }
    .hp5-press-logo {
      width: calc(33.333% - 14px);
      max-width: none;
    }
    .hp5-press-logo img {
      max-height: 30px;
    }
  }
</style>

<section class="hp5-health-press-{{ section.id }}" aria-label="Press Logos">
  <div class="hp5-press-inner">
    
    {%- if section.settings.heading != blank -%}
      <h3 class="hp5-press-title">{{ section.settings.heading }}</h3>
    {%- endif -%}

    <div class="hp5-press-logos">
      {%- for block in section.blocks -%}
        <div class="hp5-press-logo" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img height="{{ block.settings.image.height }}" width="{{ block.settings.image.width }}" src="{{ block.settings.image | image_url: width: 300 }}" loading="lazy" alt="Press Logo">
          {%- else -%}
            <!-- Placeholder SVG Logo -->
            <svg viewBox="0 0 100 30">
              <text x="50%" y="50%" dominant-baseline="middle" text-anchor="middle" font-family="Arial, sans-serif" font-size="18" font-weight="900" letter-spacing="1">JOURNAL</text>
            </svg>
          {%- endif -%}
        </div>
      {%- endfor -%}

      {%- if section.blocks.size == 0 -%}
        {%- for i in (1..5) -%}
          <div class="hp5-press-logo">
            <svg viewBox="0 0 100 30">
              <text x="50%" y="50%" dominant-baseline="middle" text-anchor="middle" font-family="Arial, sans-serif" font-size="18" font-weight="900" letter-spacing="1">HEALTHMAG</text>
            </svg>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "HP5 Health Press Logos",
  "tag": "section",
  "class": "section-hp5-press",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "RECOMMENDED BY LEADING HEALTH PUBLICATIONS"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#0066cc"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Top (Desktop)", "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Bottom (Desktop)", "default": 60
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Top (Mobile)", "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Bottom (Mobile)", "default": 40
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo Image (Use PNG/SVG)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP5 Health Press Logos",
      "category": "Trust",
      "blocks": [
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" }
      ]
    }
  ]
}
{% endschema %}
