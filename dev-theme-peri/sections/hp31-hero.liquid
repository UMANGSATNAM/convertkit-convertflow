{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Lato:wght@300;400;700&family=Playfair+Display:ital,wght@0,400;0,500;1,400&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --btn-bg: {{ section.settings.btn_bg }};
    --btn-text: {{ section.settings.btn_text }};
    
    --font-heading: 'Playfair Display', serif;
    --font-body: 'Lato', sans-serif;
    
    background-color: var(--bg-color);
    overflow: hidden;
  }

  .hp31-hero {
    position: relative;
    max-width: 1400px;
    margin: 0 auto;
    min-height: clamp(600px, 85vh, 900px);
    display: flex;
    align-items: center;
    padding: 100px 40px;
  }

  @media screen and (max-width: 992px) {
    .hp31-hero {
      flex-direction: column;
      padding: 60px 20px;
      min-height: auto;
      text-align: center;
    }
  }

  .hp31-hero__content {
    flex: 0 0 45%;
    padding-right: 80px;
    position: relative;
    z-index: 2;
    animation: hp31FadeUp 1.2s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
    opacity: 0;
  }

  @media screen and (max-width: 992px) {
    .hp31-hero__content {
      flex: 1;
      padding-right: 0;
      margin-bottom: 50px;
    }
  }

  .hp31-hero__tagline {
    font-family: var(--font-body);
    font-size: 13px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--text-color);
    margin-bottom: 24px;
    display: block;
    opacity: 0.7;
  }

  .hp31-hero__title {
    font-family: var(--font-heading);
    font-size: clamp(40px, 5vw, {{ section.settings.title_size }}px);
    line-height: 1.1;
    color: var(--text-color);
    margin: 0 0 32px;
    font-weight: 400;
  }
  
  .hp31-hero__title em {
    font-style: italic;
    font-weight: 400;
  }

  .hp31-hero__text {
    font-family: var(--font-body);
    font-size: clamp(16px, 1.5vw, 18px);
    line-height: 1.8;
    color: var(--text-color);
    margin: 0 0 48px;
    max-width: 85%;
    opacity: 0.8;
    font-weight: 300;
  }

  @media screen and (max-width: 992px) {
    .hp31-hero__text {
      max-width: 100%;
      margin-left: auto;
      margin-right: auto;
    }
  }

  .hp31-hero__btn-group {
    display: flex;
    gap: 20px;
    align-items: center;
  }

  @media screen and (max-width: 992px) {
    .hp31-hero__btn-group {
      justify-content: center;
      flex-direction: column;
    }
  }

  .hp31-hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 36px;
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    background: var(--btn-bg);
    color: var(--btn-text);
    border-radius: 50px;
    border: 1px solid var(--btn-bg);
    transition: all 0.4s ease;
  }

  .hp31-hero__btn--outline {
    background: transparent;
    color: var(--text-color);
    border: 1px solid var(--text-color);
  }

  .hp31-hero__btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgba(0,0,0,0.05);
    background: var(--text-color);
    color: var(--bg-color);
    border-color: var(--text-color);
  }

  .hp31-hero__btn--outline:hover {
    background: var(--text-color);
    color: var(--bg-color);
  }

  .hp31-hero__image-col {
    flex: 1;
    position: relative;
    height: 70vh;
    min-height: 500px;
    animation: hp31ImageReveal 1.5s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
    opacity: 0;
  }

  @media screen and (max-width: 992px) {
    .hp31-hero__image-col {
      width: 100%;
      height: 50vh;
    }
  }

  .hp31-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 24px; /* soft corners */
  }

  .hp31-hero__accent-shape {
    position: absolute;
    width: 300px;
    height: 300px;
    background: #E8E2D6;
    border-radius: 50%;
    filter: blur(80px);
    z-index: -1;
    opacity: 0.6;
    top: -100px;
    right: -100px;
  }

  @keyframes hp31FadeUp {
    0% { opacity: 0; transform: translateY(30px); }
    100% { opacity: 1; transform: translateY(0); }
  }

  @keyframes hp31ImageReveal {
    0% { opacity: 0; transform: scale(0.95); }
    100% { opacity: 1; transform: scale(1); }
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp31-hero" id="HP31Hero-{{ section.id }}">
  <div class="hp31-hero__accent-shape"></div>
  
  <div class="hp31-hero__content">
    {%- if section.settings.tagline != blank -%}
      <span class="hp31-hero__tagline">{{ section.settings.tagline }}</span>
    {%- endif -%}
    
    <h1 class="hp31-hero__title">
      {{ section.settings.title }}
    </h1>
    
    {%- if section.settings.text != blank -%}
      <p class="hp31-hero__text">{{ section.settings.text }}</p>
    {%- endif -%}
    
    <div class="hp31-hero__btn-group">
      {%- if section.settings.btn_1_label != blank -%}
        <a href="{{ section.settings.btn_1_link | default: '#' }}" class="hp31-hero__btn">
          {{ section.settings.btn_1_label }}
        </a>
      {%- endif -%}
      {%- if section.settings.btn_2_label != blank -%}
        <a href="{{ section.settings.btn_2_link | default: '#' }}" class="hp31-hero__btn hp31-hero__btn--outline">
          {{ section.settings.btn_2_label }}
        </a>
      {%- endif -%}
    </div>
  </div>

  <div class="hp31-hero__image-col">
    {%- if section.settings.image != blank -%}
      <img height="{{ section.settings.image.height }}" width="{{ section.settings.image.width }}" src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.title | escape }}" class="hp31-hero__image" loading="eager" fetchpriority="high">
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'hp31-hero__image' }}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP31 - Zen Hero",
  "class": "section-hp31-hero",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Image"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "New Arrivals"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Heading",
      "default": "Embrace the <em>quiet</em> moments."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Discover a curated collection designed to bring balance and tranquility to your everyday spaces."
    },
    {
      "type": "text",
      "id": "btn_1_label",
      "label": "Primary Button Label",
      "default": "Shop Collection"
    },
    {
      "type": "url",
      "id": "btn_1_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "btn_2_label",
      "label": "Secondary Button Label",
      "default": "Our Story"
    },
    {
      "type": "url",
      "id": "btn_2_link",
      "label": "Secondary Button Link"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 40,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 72
    },
    {
      "type": "header",
      "content": "Zen Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (Beige)",
      "default": "#F9F6F0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text (Charcoal)",
      "default": "#2C2C2C"
    },
    {
      "type": "color",
      "id": "btn_bg",
      "label": "Button Background",
      "default": "#2C2C2C"
    },
    {
      "type": "color",
      "id": "btn_text",
      "label": "Button Text",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP31 - Zen Hero"
    }
  ]
}
{% endschema %}
