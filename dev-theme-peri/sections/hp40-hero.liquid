{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;700;900&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    
    --font-heading: 'Inter', sans-serif;
    --font-body: 'Inter', sans-serif;
    
    background-color: var(--bg-color);
  }

  .hp40-hero-wrapper {
    position: relative;
    width: 100%;
    min-height: 90vh;
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-bottom: 2px solid var(--text-color);
  }

  @media screen and (max-width: 992px) {
    .hp40-hero-wrapper {
      grid-template-columns: 1fr;
      min-height: auto;
    }
  }

  /* Left Column: Typography */
  .hp40-hero__text-col {
    padding: 60px 40px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border-right: 2px solid var(--text-color);
  }

  @media screen and (max-width: 992px) {
    .hp40-hero__text-col {
      border-right: none;
      border-bottom: 2px solid var(--text-color);
      min-height: 60vh;
    }
  }

  .hp40-hero__meta {
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--text-color);
    letter-spacing: -0.5px;
  }

  .hp40-hero__title {
    font-family: var(--font-heading);
    font-size: clamp(60px, 12vw, {{ section.settings.title_size }}px);
    font-weight: 900;
    line-height: 0.85;
    color: var(--text-color);
    margin: 40px 0;
    letter-spacing: -3px;
    text-transform: uppercase;
  }
  
  /* Right Column: Image and overlapping elements */
  .hp40-hero__image-col {
    position: relative;
    background: var(--accent-color);
    overflow: hidden;
  }
  
  @media screen and (max-width: 992px) {
    .hp40-hero__image-col {
      min-height: 400px;
    }
  }

  .hp40-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    mix-blend-mode: multiply; /* Classic Swiss overlay effect */
    filter: grayscale(100%) contrast(1.2);
  }

  .hp40-hero__tag {
    position: absolute;
    bottom: 20px;
    right: -30px;
    transform: rotate(-90deg);
    transform-origin: bottom right;
    font-family: var(--font-heading);
    font-size: 80px;
    font-weight: 900;
    color: var(--bg-color);
    opacity: 0.5;
    white-space: nowrap;
    letter-spacing: -2px;
    pointer-events: none;
  }

  .hp40-hero__bottom {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
  }
  
  @media screen and (max-width: 600px) {
    .hp40-hero__bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  .hp40-hero__text {
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.4;
    font-weight: 400;
    color: var(--text-color);
    max-width: 300px;
    margin: 0;
  }

  .hp40-hero__btn {
    display: inline-block;
    padding: 15px 30px;
    background: var(--text-color);
    color: var(--bg-color);
    font-family: var(--font-heading);
    font-size: 18px;
    font-weight: 700;
    text-transform: uppercase;
    text-decoration: none;
    letter-spacing: -0.5px;
    transition: all 0.3s ease;
  }

  .hp40-hero__btn:hover {
    background: var(--accent-color);
    color: var(--text-color);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp40-hero-wrapper" id="HP40Hero-{{ section.id }}">
  
  <div class="hp40-hero__text-col">
    <div class="hp40-hero__meta">NO. 001 / {{ section.settings.badge }}</div>
    
    <h1 class="hp40-hero__title">{{ section.settings.title }}</h1>
    
    <div class="hp40-hero__bottom">
      <p class="hp40-hero__text">{{ section.settings.text }}</p>
      
      {%- if section.settings.btn_label != blank -%}
        <a href="{{ section.settings.btn_link | default: '#' }}" class="hp40-hero__btn">
          {{ section.settings.btn_label }}
        </a>
      {%- endif -%}
    </div>
  </div>

  <div class="hp40-hero__image-col">
    {%- if section.settings.image != blank -%}
      <img height="{{ section.settings.image.height }}" width="{{ section.settings.image.width }}" src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.title | escape }}" class="hp40-hero__image" loading="eager">
    {%- else -%}
      {{ 'collection-1' | placeholder_svg_tag: 'hp40-hero__image' }}
    {%- endif -%}
    
    <div class="hp40-hero__tag">{{ section.settings.large_tag }}</div>
  </div>

</div>

{% schema %}
{
  "name": "HP40 - Swiss Hero",
  "class": "section-hp40-hero",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Small Top Text",
      "default": "Exhibition"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Form & Function"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Body Text",
      "default": "A study in clarity. Eliminating the unnecessary so that the necessary may speak."
    },
    {
      "type": "text",
      "id": "large_tag",
      "label": "Rotated Large Text",
      "default": "2026."
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "Discover"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image (Will be Grayscale & Multiplied)"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 60,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "Heading Size (Desktop)",
      "default": 140
    },
    {
      "type": "header",
      "content": "Swiss Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#F4F4F4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text & Lines",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Primary Accent Block",
      "default": "#E21833"
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP40 - Swiss Hero"
    }
  ]
}
{% endschema %}
