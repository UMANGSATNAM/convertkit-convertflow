{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600&family=Syncopate:wght@400;700&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --font-heading: 'Syncopate', sans-serif;
    --font-body: 'Space Grotesk', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    border-top: 1px solid rgba(226, 226, 226, 0.1);
    border-bottom: 1px solid rgba(226, 226, 226, 0.1);
    overflow: hidden;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.8 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.8 | round }}px;
    }
  }

  .hp27-marquee-wrapper {
    width: 100%;
    display: flex;
    align-items: center;
    position: relative;
    white-space: nowrap;
  }

  /* Fade edges for slick tech look */
  .hp27-marquee-wrapper::before,
  .hp27-marquee-wrapper::after {
    content: '';
    position: absolute;
    top: 0;
    width: 10vw;
    height: 100%;
    z-index: 2;
    pointer-events: none;
  }

  .hp27-marquee-wrapper::before {
    left: 0;
    background: linear-gradient(to right, var(--bg-color), transparent);
  }

  .hp27-marquee-wrapper::after {
    right: 0;
    background: linear-gradient(to left, var(--bg-color), transparent);
  }

  .hp27-marquee__track {
    display: flex;
    align-items: center;
    animation: hp27Marquee {{ section.settings.speed }}s linear infinite;
    will-change: transform;
  }

  .hp27-marquee__track--reverse {
    animation-direction: reverse;
  }

  /* Pause on hover if setting enabled */
  {%- if section.settings.pause_on_hover -%}
    .hp27-marquee-wrapper:hover .hp27-marquee__track {
      animation-play-state: paused;
    }
  {%- endif -%}

  @keyframes hp27Marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  .hp27-marquee__item {
    display: inline-flex;
    align-items: center;
    padding: 0 40px;
    font-family: var(--font-heading);
    font-size: clamp(14px, 2vw, {{ section.settings.text_size }}px);
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--text-color);
  }

  .hp27-marquee__separator {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-color);
    margin: 0 10px;
  }

  .hp27-marquee__separator svg {
    width: 12px;
    height: 12px;
    fill: currentColor;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp27-marquee-wrapper" id="HP27Marquee-{{ section.id }}">
  <div class="hp27-marquee__track {% if section.settings.direction == 'right' %}hp27-marquee__track--reverse{% endif %}">
    
    <!-- Repeated twice for seamless loop -->
    {%- for i in (1..2) -%}
      <div style="display:flex; align-items:center;">
        {%- for block in section.blocks -%}
          <div class="hp27-marquee__item" {{ block.shopify_attributes }}>
            {{ block.settings.text }}
          </div>
          {%- if section.settings.show_separators -%}
            <div class="hp27-marquee__separator">
              {%- case section.settings.separator_style -%}
                {%- when 'dot' -%}
                  &bull;
                {%- when 'slash' -%}
                  /
                {%- when 'cross' -%}
                  <svg viewBox="0 0 24 24"><path d="M19 6.41L17.59 5L12 10.59L6.41 5L5 6.41L10.59 12L5 17.59L6.41 19L12 13.41L17.59 19L19 17.59L13.41 12L19 6.41Z"/></svg>
                {%- when 'diamond' -%}
                  <svg viewBox="0 0 24 24"><path d="M12 2L22 12L12 22L2 12L12 2Z"/></svg>
              {%- endcase -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endfor -%}

  </div>
</div>

{% schema %}
{
  "name": "HP27 - Eng Marquee",
  "class": "section-hp27-marquee",
  "settings": [
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "s",
      "label": "Scroll Speed",
      "default": 30
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Direction",
      "options": [
        { "value": "left", "label": "Right to Left" },
        { "value": "right", "label": "Left to Right" }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on Hover",
      "default": false
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 12,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "Text Size",
      "default": 16
    },
    {
      "type": "header",
      "content": "Separators"
    },
    {
      "type": "checkbox",
      "id": "show_separators",
      "label": "Show Separators",
      "default": true
    },
    {
      "type": "select",
      "id": "separator_style",
      "label": "Separator Style",
      "options": [
        { "value": "dot", "label": "Bullet Dot" },
        { "value": "slash", "label": "Forward Slash" },
        { "value": "cross", "label": "Tech Cross" },
        { "value": "diamond", "label": "Diamond" }
      ],
      "default": "cross"
    },
    {
      "type": "header",
      "content": "Dark Engineered Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#0A0A0A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#E2E2E2"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Separator Color (Accent)",
      "default": "#FF2A2A"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Top Padding",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 16
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text Block",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "NEXT-GEN MATERIALS"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP27 - Eng Marquee",
      "blocks": [
        { "type": "text", "settings": { "text": "ENGINEERED FOR PERFORMANCE" } },
        { "type": "text", "settings": { "text": "AEROSPACE GRADE" } },
        { "type": "text", "settings": { "text": "ULTRA LIGHTWEIGHT" } },
        { "type": "text", "settings": { "text": "PRECISION MILLED" } },
        { "type": "text", "settings": { "text": "FREE EXPEDITED SHIPPING" } }
      ]
    }
  ]
}
{% endschema %}
