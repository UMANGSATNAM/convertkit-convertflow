{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#f7f4ed'
  assign text_color = section.settings.text_color | default: '#2b302a'
  assign accent_color = section.settings.accent_color | default: '#4a6741'
  assign heading = section.settings.heading | default: 'Harmony with Nature.'
  assign subheading = section.settings.subheading | default: 'Discover our new collection of ethically sourced, sustainable essentials designed for everyday living.'
  assign button_text = section.settings.button_text | default: 'Shop the Collection'
  assign image = section.settings.image
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 60px 20px 100px 20px;
    overflow: hidden;
    position: relative;
  }
  
  .hp7-hero-container-{{ section_id }} {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }
  
  .hp7-hero-content-{{ section_id }} {
    max-width: 600px;
    position: relative;
    z-index: 2;
  }
  
  .hp7-hero-badge-{{ section_id }} {
    display: inline-block;
    padding: 8px 16px;
    background-color: rgba(74, 103, 65, 0.1);
    color: {{ accent_color }};
    font-family: 'DM Sans', sans-serif;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    border-radius: 30px;
    margin-bottom: 30px;
  }
  
  .hp7-hero-heading-{{ section_id }} {
    font-family: 'Playfair Display', serif;
    font-size: clamp(3.5rem, 6vw, 5.5rem);
    color: {{ text_color }};
    font-weight: 500;
    line-height: 1.1;
    margin: 0 0 25px 0;
    letter-spacing: -0.02em;
  }
  
  /* Soft emphasis using italic */
  .hp7-hero-heading-{{ section_id }} em {
    font-style: italic;
    color: {{ accent_color }};
  }
  
  .hp7-hero-subheading-{{ section_id }} {
    font-family: 'DM Sans', sans-serif;
    font-size: clamp(1.1rem, 2vw, 1.3rem);
    color: rgba({{ text_color | color_to_rgb | remove: 'rgb(' | remove: ')' }}, {{ 0.8 }});
    line-height: 1.6;
    margin: 0 0 40px 0;
    max-width: 500px;
  }
  
  .hp7-hero-btn-{{ section_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 18px 40px;
    background-color: {{ accent_color }};
    color: #ffffff;
    font-family: 'DM Sans', sans-serif;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: 50px; /* Soft pill shape */
    transition: all 0.4s cubic-bezier(0.25, 1, 0.5, 1);
    position: relative;
    overflow: hidden;
  }
  
  /* Hover effect - simple scale and shadow */
  .hp7-hero-btn-{{ section_id }}:hover {
    transform: translateY(-3px);
    box-shadow: 0 15px 30px rgba(74, 103, 65, 0.2);
    background-color: {{ text_color }};
  }
  
  .hp7-hero-image-wrapper-{{ section_id }} {
    position: relative;
    height: 700px;
    width: 100%;
    /* Organic leaf-like border radius */
    border-radius: 300px 300px 0 300px;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0,0,0,0.05);
    transform: translateZ(0);
  }
  
  .hp7-hero-image-{{ section_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.5s cubic-bezier(0.25, 1, 0.5, 1);
  }
  
  .hp7-hero-image-wrapper-{{ section_id }}:hover .hp7-hero-image-{{ section_id }} {
    transform: scale(1.05);
  }
  
  /* Soft decorative shapes behind image */
  .hp7-hero-shape-1-{{ section_id }} {
    position: absolute;
    bottom: -30px;
    right: -30px;
    width: 200px;
    height: 200px;
    border-radius: 50%;
    background-color: rgba({{ accent_color | color_to_rgb | remove: 'rgb(' | remove: ')' }}, {{ 0.1 }});
    z-index: 0;
  }
  
  .hp7-hero-shape-2-{{ section_id }} {
    position: absolute;
    top: 50px;
    left: -50px;
    width: 150px;
    height: 150px;
    border-radius: 50%;
    border: 1px solid rgba({{ accent_color | color_to_rgb | remove: 'rgb(' | remove: ')' }}, {{ 0.2 }});
    z-index: 0;
  }

  @media (max-width: 992px) {
    .hp7-hero-container-{{ section_id }} {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 40px;
    }
    .hp7-hero-content-{{ section_id }} {
      margin: 0 auto;
    }
    .hp7-hero-subheading-{{ section_id }} {
      margin-left: auto;
      margin-right: auto;
    }
    .hp7-hero-image-wrapper-{{ section_id }} {
      height: 500px;
      border-radius: 200px 200px 0 200px;
    }
  }
  
  @media (max-width: 576px) {
    .hp7-hero-image-wrapper-{{ section_id }} {
      height: 400px;
      border-radius: 150px 150px 0 150px;
    }
    #shopify-section-{{ section_id }} {
      padding: 30px 15px 60px 15px;
    }
  }
</style>

<div class="hp7-hero-container-{{ section_id }}">
  <div class="hp7-hero-content-{{ section_id }}">
    <div class="hp7-hero-badge-{{ section_id }}">New Collection</div>
    <h1 class="hp7-hero-heading-{{ section_id }}">{{ heading | replace: 'Nature', '<em>Nature</em>' }}</h1>
    <p class="hp7-hero-subheading-{{ section_id }}">{{ subheading }}</p>
    <a href="#" class="hp7-hero-btn-{{ section_id }}">{{ button_text }}</a>
  </div>
  
  <div style="position: relative;">
    <div class="hp7-hero-shape-1-{{ section_id }}"></div>
    <div class="hp7-hero-shape-2-{{ section_id }}"></div>
    <div class="hp7-hero-image-wrapper-{{ section_id }}">
      {% if image != blank %}
        <img src="{{ image | image_url: width: 1200 }}" alt="Sustainable living" class="hp7-hero-image-{{ section_id }}" loading="eager" width="800" height="700">
      {% else %}
        <div style="width:100%; height:100%; background: #e0ddd5; display:flex; align-items:center; justify-content:center; color:#888;">
          HERO IMAGE 800x700
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "HP7 Eco Hero",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f7f4ed"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2b302a"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#4a6741"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Harmony with Nature."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Discover our new collection of ethically sourced, sustainable essentials designed for everyday living."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Shop the Collection"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Image"
    }
  ],
  "presets": [
    {
      "name": "HP7 Eco Hero"
    }
  ]
}
{% endschema %}
