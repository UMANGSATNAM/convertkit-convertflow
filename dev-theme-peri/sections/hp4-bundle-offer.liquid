{%- liquid
  assign bg_color = section.settings.bg_color | default: '#f9f6f0'
  assign text_color = section.settings.text_color | default: '#2c2c2c'
  assign accent_color = section.settings.accent_color | default: '#d4af37'
  
  assign product = all_products[section.settings.product]
  
  assign padding_top_desktop = section.settings.padding_top_desktop
  assign padding_bottom_desktop = section.settings.padding_bottom_desktop
  assign padding_top_mobile = section.settings.padding_top_mobile
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile
-%}

<style>
  #shopify-section-{{ section.id }} {
    --hp4-bundle-bg: {{ bg_color }};
    --hp4-bundle-text: {{ text_color }};
    --hp4-bundle-accent: {{ accent_color }};
    
    --hp4-bundle-pt-desk: {{ padding_top_desktop }}px;
    --hp4-bundle-pb-desk: {{ padding_bottom_desktop }}px;
    --hp4-bundle-pt-mob: {{ padding_top_mobile }}px;
    --hp4-bundle-pb-mob: {{ padding_bottom_mobile }}px;
  }

  .hp4-decor-bundle-{{ section.id }} {
    padding-top: var(--hp4-bundle-pt-desk);
    padding-bottom: var(--hp4-bundle-pb-desk);
    background-color: var(--hp4-bundle-bg);
    color: var(--hp4-bundle-text);
    font-family: 'Inter', sans-serif;
  }

  .hp4-bundle-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    align-items: center;
    gap: 60px;
  }

  /* Image Side */
  .hp4-bundle-media {
    flex: 1;
    position: relative;
  }

  .hp4-bundle-img-wrap {
    width: 100%;
    aspect-ratio: 4/5;
    background: #e8e3d8;
    overflow: hidden;
  }
  .hp4-bundle-img {
    width: 100%; height: 100%;
    object-fit: cover;
  }

  /* Info points on image */
  .hp4-bundle-pin {
    position: absolute;
    width: 16px; height: 16px;
    background: #fff;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    box-shadow: 0 0 0 4px rgba(255,255,255,0.3);
    cursor: pointer;
  }
  .hp4-bundle-pin::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: #fff;
    animation: hp4Pulse 2s infinite;
  }
  @keyframes hp4Pulse {
    0% { transform: scale(1); opacity: 0.8; }
    100% { transform: scale(2.5); opacity: 0; }
  }

  .hp4-bundle-pin:nth-child(2) { top: 30%; left: 40%; }
  .hp4-bundle-pin:nth-child(3) { top: 70%; left: 60%; }

  /* Content Side */
  .hp4-bundle-content {
    flex: 1;
  }

  .hp4-bundle-badge {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: rgba(44,44,44,0.6);
    margin-bottom: 20px;
    display: block;
  }

  .hp4-bundle-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 400;
    margin: 0 0 20px 0;
    line-height: 1.1;
  }

  .hp4-bundle-desc {
    font-size: 15px;
    line-height: 1.6;
    color: rgba(44,44,44,0.7);
    margin-bottom: 40px;
    font-weight: 300;
  }

  /* List of items */
  .hp4-bundle-items {
    list-style: none;
    padding: 0; margin: 0 0 40px 0;
    border-top: 1px solid rgba(0,0,0,0.1);
  }
  .hp4-bundle-item-row {
    display: flex;
    justify-content: space-between;
    padding: 15px 0;
    border-bottom: 1px solid rgba(0,0,0,0.1);
    font-size: 15px;
  }
  .hp4-bundle-item-name {
    font-weight: 500;
  }
  .hp4-bundle-item-price {
    color: rgba(44,44,44,0.6);
  }

  /* Total & Button */
  .hp4-bundle-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .hp4-bundle-total-wrap {
    display: flex;
    flex-direction: column;
  }
  .hp4-bundle-total-label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: rgba(44,44,44,0.5);
  }
  .hp4-bundle-total-price {
    font-family: 'Playfair Display', serif;
    font-size: 28px;
    font-weight: 500;
  }

  .hp4-bundle-btn {
    display: inline-flex;
    padding: 16px 40px;
    background: var(--hp4-bundle-text);
    color: var(--hp4-bundle-bg);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.4s ease;
    border: none;
    cursor: pointer;
  }
  .hp4-bundle-btn:hover {
    background: var(--hp4-bundle-accent);
    color: #fff;
  }

  @media screen and (max-width: 900px) {
    .hp4-bundle-inner {
      flex-direction: column;
      gap: 40px;
    }
    .hp4-bundle-media, .hp4-bundle-content {
      width: 100%;
    }
  }

  @media screen and (max-width: 768px) {
    .hp4-decor-bundle-{{ section.id }} {
      padding-top: var(--hp4-bundle-pt-mob);
      padding-bottom: var(--hp4-bundle-pb-mob);
    }
    .hp4-bundle-inner {
      padding: 0 20px;
    }
    .hp4-bundle-footer {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }
    .hp4-bundle-btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>

<section class="hp4-decor-bundle-{{ section.id }}" aria-label="Curated Set">
  <div class="hp4-bundle-inner">
    
    <div class="hp4-bundle-media">
      <div class="hp4-bundle-img-wrap">
        {%- if section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 800 }}" class="hp4-bundle-img" loading="lazy" alt="Curated Room">
        {%- elsif product != blank -%}
          <img src="{{ product.featured_image | image_url: width: 800 }}" class="hp4-bundle-img" loading="lazy" alt="{{ product.title }}">
        {%- else -%}
          {{ 'collection-2' | placeholder_svg_tag: 'hp4-bundle-img placeholder-svg' }}
        {%- endif -%}
      </div>
      <!-- Decorative Pins -->
      <div class="hp4-bundle-pin"></div>
      <div class="hp4-bundle-pin"></div>
    </div>

    <div class="hp4-bundle-content">
      <span class="hp4-bundle-badge">{{ section.settings.badge | default: 'COMPLETE THE LOOK' }}</span>
      <h2 class="hp4-bundle-title">{{ section.settings.heading | default: 'The Reading Nook Set' }}</h2>
      <p class="hp4-bundle-desc">{{ section.settings.description | default: 'Perfectly paired pieces to create a cozy corner in any room. Buy as a set and enjoy special pricing.' }}</p>
      
      <ul class="hp4-bundle-items">
        {%- for block in section.blocks -%}
          <li class="hp4-bundle-item-row" {{ block.shopify_attributes }}>
            <span class="hp4-bundle-item-name">{{ block.settings.title }}</span>
            <span class="hp4-bundle-item-price">{{ block.settings.price }}</span>
          </li>
        {%- endfor -%}
        
        {%- if section.blocks.size == 0 -%}
          <li class="hp4-bundle-item-row">
            <span class="hp4-bundle-item-name">Bouclé Lounge Chair</span>
            <span class="hp4-bundle-item-price">$450</span>
          </li>
          <li class="hp4-bundle-item-row">
            <span class="hp4-bundle-item-name">Brass Floor Lamp</span>
            <span class="hp4-bundle-item-price">$120</span>
          </li>
          <li class="hp4-bundle-item-row">
            <span class="hp4-bundle-item-name">Textured Throw Pillow</span>
            <span class="hp4-bundle-item-price">$45</span>
          </li>
        {%- endif -%}
      </ul>

      <div class="hp4-bundle-footer">
        <div class="hp4-bundle-total-wrap">
          <span class="hp4-bundle-total-label">Bundle Price</span>
          <span class="hp4-bundle-total-price">{{ section.settings.total_price | default: '$550.00' }}</span>
        </div>
        <button class="hp4-bundle-btn">{{ section.settings.btn_text | default: 'ADD SET TO BAG' }}</button>
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "HP4 Decor Curated Set",
  "tag": "section",
  "class": "section-hp4-bundle",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Main Image"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Fallback Product Image"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "default": "COMPLETE THE LOOK"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Reading Nook Set"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Perfectly paired pieces to create a cozy corner in any room. Buy as a set and enjoy special pricing."
    },
    {
      "type": "text",
      "id": "total_price",
      "label": "Displayed Total Price",
      "default": "$550.00"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "ADD SET TO BAG"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f9f6f0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2c2c2c"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#d4af37"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Top (Desktop)", "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Bottom (Desktop)", "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Top (Mobile)", "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Bottom (Mobile)", "default": 40
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item in Set",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Item Name",
          "default": "Product Name"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Item Price",
          "default": "$0.00"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP4 Decor Curated Set",
      "category": "Promotional",
      "blocks": [
        { "type": "item", "settings": { "title": "Bouclé Lounge Chair", "price": "$450" } },
        { "type": "item", "settings": { "title": "Brass Floor Lamp", "price": "$120" } },
        { "type": "item", "settings": { "title": "Textured Throw Pillow", "price": "$45" } }
      ]
    }
  ]
}
{% endschema %}
