{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#0a0a0d'
  assign text_color = section.settings.text_color | default: '#00ff88'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 120px 0;
    overflow: hidden;
    position: relative;
    border-top: 1px solid rgba(0,255,136,0.1);
    border-bottom: 1px solid rgba(0,255,136,0.1);
  }
  
  .hp9-scrolling-text-container-{{ section_id }} {
    display: flex;
    white-space: nowrap;
    position: relative;
    /* Angle the text slightly for dynamic effect */
    transform: rotate(-2deg) scale(1.1);
  }
  
  .hp9-scrolling-text-content-{{ section_id }} {
    display: flex;
    animation: hp9-scroll-text-{{ section_id }} 20s linear infinite;
  }
  
  .hp9-scrolling-text-content-{{ section_id }}:nth-child(even) {
    /* Optional: reverse animation for alternating rows if needed, but here it's one row */
  }
  
  .hp9-scrolling-text-item-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: clamp(4rem, 8vw, 8rem);
    font-weight: 900;
    line-height: 1;
    text-transform: uppercase;
    color: transparent;
    -webkit-text-stroke: 2px rgba(255,255,255,0.1);
    padding: 0 40px;
    display: flex;
    align-items: center;
    transition: all 0.3s ease;
  }
  
  .hp9-scrolling-text-item-{{ section_id }}.filled {
    color: {{ text_color }};
    -webkit-text-stroke: 0;
    text-shadow: 0 0 30px rgba(0, 255, 136, 0.4);
  }
  
  .hp9-scrolling-text-container-{{ section_id }}:hover .hp9-scrolling-text-content-{{ section_id }} {
    animation-play-state: paused;
  }
  
  .hp9-scrolling-text-item-{{ section_id }}:hover {
    color: #fff;
    -webkit-text-stroke: 0;
    text-shadow: 0 0 20px rgba(255,255,255,0.5);
  }
  
  @keyframes hp9-scroll-text-{{ section_id }} {
    0% { transform: translateX(0); }
    100% { transform: translateX(-100%); }
  }
  
  .hp9-bg-grid-{{ section_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: 
      linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px);
    background-size: 40px 40px;
    z-index: 0;
    pointer-events: none;
  }
</style>

<div class="hp9-bg-grid-{{ section_id }}"></div>

<div class="hp9-scrolling-text-container-{{ section_id }}">
  <!-- Duplicate for infinite scroll -->
  {% for i in (1..3) %}
    <div class="hp9-scrolling-text-content-{{ section_id }}">
      <div class="hp9-scrolling-text-item-{{ section_id }} filled">{{ section.settings.text_1 | default: 'OVERRIDE' }}</div>
      <div class="hp9-scrolling-text-item-{{ section_id }}">{{ section.settings.text_2 | default: 'THE' }}</div>
      <div class="hp9-scrolling-text-item-{{ section_id }} filled">{{ section.settings.text_3 | default: 'SYSTEM' }}</div>
      <div class="hp9-scrolling-text-item-{{ section_id }}">{{ section.settings.text_1 | default: 'OVERRIDE' }}</div>
    </div>
  {% endfor %}
</div>

{% schema %}
{
  "name": "HP9 Scrolling Text",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#0a0a0d"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Highlight Color",
      "default": "#00ff88"
    },
    {
      "type": "text",
      "id": "text_1",
      "label": "Text Part 1 (Highlighted)",
      "default": "OVERRIDE"
    },
    {
      "type": "text",
      "id": "text_2",
      "label": "Text Part 2 (Outline)",
      "default": "THE"
    },
    {
      "type": "text",
      "id": "text_3",
      "label": "Text Part 3 (Highlighted)",
      "default": "SYSTEM"
    }
  ],
  "presets": [
    {
      "name": "HP9 Scrolling Text"
    }
  ]
}
{% endschema %}
