{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#FAFAFA'
  assign text_color = section.settings.text_color | default: '#333333'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 150px 40px;
    color: {{ text_color }};
    border-bottom: 1px solid #E5E5E5;
    text-align: center;
  }
  
  .hp12-brand-story-container-{{ section_id }} {
    max-width: 800px;
    margin: 0 auto;
  }
  
  .hp12-brand-story-heading-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 300;
    margin: 0 0 40px 0;
    letter-spacing: 1px;
    line-height: 1.2;
  }
  
  .hp12-brand-story-text-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: 1.1rem;
    font-weight: 300;
    line-height: 1.8;
    margin: 0 0 60px 0;
    opacity: 0.8;
  }
  
  .hp12-brand-story-signature-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 3px;
    opacity: 0.6;
  }
  
  .hp12-brand-story-btn-{{ section_id }} {
    display: inline-block;
    padding: 10px 0;
    color: {{ text_color }};
    font-family: 'Inter', sans-serif;
    font-size: 0.85rem;
    font-weight: 400;
    text-transform: uppercase;
    text-decoration: none;
    letter-spacing: 2px;
    border-bottom: 1px solid {{ text_color }};
    transition: opacity 0.3s ease;
    margin-top: 40px;
  }
  
  .hp12-brand-story-btn-{{ section_id }}:hover {
    opacity: 0.5;
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 80px 20px;
    }
    .hp12-brand-story-text-{{ section_id }} {
      font-size: 1rem;
    }
  }
</style>

<div class="hp12-brand-story-container-{{ section_id }}">
  <h2 class="hp12-brand-story-heading-{{ section_id }}">{{ section.settings.heading | default: 'Less, but better.' }}</h2>
  <div class="hp12-brand-story-text-{{ section_id }}">
    {{ section.settings.text | default: 'We are guided by the belief that space shapes emotion. By paring back the unnecessary, we allow the essential to speak clearly, bringing balance and calm into the modern home.' }}
  </div>
  <div class="hp12-brand-story-signature-{{ section_id }}">
    {{ section.settings.signature | default: 'FOUNDERS' }}
  </div>
  
  {% if section.settings.button_label != blank %}
    <a href="{{ section.settings.button_link | default: '#' }}" class="hp12-brand-story-btn-{{ section_id }}">
      {{ section.settings.button_label }}
    </a>
  {% endif %}
</div>

{% schema %}
{
  "name": "HP12 Brand Story",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FAFAFA"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#333333"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Less, but better."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "We are guided by the belief that space shapes emotion. By paring back the unnecessary, we allow the essential to speak clearly, bringing balance and calm into the modern home."
    },
    {
      "type": "text",
      "id": "signature",
      "label": "Signature",
      "default": "FOUNDERS"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Read our story"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "HP12 Brand Story"
    }
  ]
}
{% endschema %}
