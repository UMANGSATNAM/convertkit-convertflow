{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Lato:wght@300;400;700&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    
    --font-body: 'Lato', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .hp31-press-wrapper {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
    text-align: center;
  }

  @media screen and (max-width: 768px) {
    .hp31-press-wrapper {
      padding: 0 20px;
    }
  }

  .hp31-press__title {
    font-family: var(--font-body);
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-color);
    margin: 0 0 40px;
    opacity: 0.5;
  }

  .hp31-press__grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 60px;
  }

  @media screen and (max-width: 768px) {
    .hp31-press__grid {
      gap: 40px;
    }
  }

  .hp31-press__logo {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 35px;
    opacity: 0.4;
    filter: grayscale(100%);
    transition: all 0.4s ease;
  }

  .hp31-press__logo:hover {
    opacity: 0.8;
  }

  .hp31-press__logo img,
  .hp31-press__logo svg {
    max-height: 100%;
    width: auto;
    fill: var(--text-color);
    color: var(--text-color);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp31-press-wrapper" id="HP31Press-{{ section.id }}">
  <h2 class="hp31-press__title">{{ section.settings.title }}</h2>
  
  <div class="hp31-press__grid">
    {%- for block in section.blocks -%}
      <div class="hp31-press__logo" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          <img src="{{ block.settings.image | image_url: width: 250 }}" alt="Press Logo" loading="lazy">
        {%- else -%}
          <svg viewBox="0 0 150 40" width="150" height="40">
            <text x="50%" y="50%" dominant-baseline="middle" text-anchor="middle" font-family="'Lato', sans-serif" font-size="20" font-weight="300" letter-spacing="2" fill="currentColor">
              PUBLICATION
            </text>
          </svg>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "HP31 - Zen Press Logos",
  "class": "section-hp31-press-logos",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "As Featured In"
    },
    {
      "type": "header",
      "content": "Zen Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (Beige)",
      "default": "#F9F6F0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text / Logos (Charcoal)",
      "default": "#2C2C2C"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 60
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Press Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP31 - Zen Press Logos",
      "blocks": [
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" }
      ]
    }
  ]
}
{% endschema %}
