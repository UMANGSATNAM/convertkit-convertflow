{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#0F1D32' }};
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }
  .hp54-comp__container { max-width: {{ section.settings.container_width | default: 1000 }}px; margin: 0 auto; padding: 0 24px; }
  .hp54-comp__header { text-align: center; margin-bottom: 50px; }
  .hp54-comp__eyebrow { font-family: 'Inter', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: {{ section.settings.accent_color | default: '#60A5FA' }}; margin: 0 0 12px; }
  .hp54-comp__heading { font-family: 'Tenor Sans', serif; font-size: clamp(28px, 3.5vw, 42px); color: #FFFFFF; margin: 0; }
  .hp54-comp__table {
    width: 100%; border-collapse: collapse; background: {{ section.settings.card_bg | default: '#111D33' }};
    border-radius: 12px; overflow: hidden; border: 1px solid rgba(59, 130, 246, 0.2);
  }
  .hp54-comp__table th {
    background: #0A1628; color: #60A5FA; font-family: 'Inter', sans-serif;
    font-size: 12px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase;
    padding: 18px 20px; text-align: left; border-bottom: 1px solid rgba(59, 130, 246, 0.2);
  }
  .hp54-comp__table td {
    padding: 16px 20px; font-size: 14px; color: #E0E7FF;
    border-bottom: 1px solid rgba(59, 130, 246, 0.1);
  }
  .hp54-comp__table tr:last-child td { border-bottom: none; }
  .hp54-comp__check { color: #60A5FA; font-weight: 700; }
  @media screen and (max-width: 768px) {
    .hp54-comp__table { font-size: 13px; }
    .hp54-comp__table th, .hp54-comp__table td { padding: 12px 14px; }
  }
{%- endstyle -%}
<div class="hp54-comp__container">
  <div class="hp54-comp__header">
    {%- if section.settings.eyebrow != blank -%}<p class="hp54-comp__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="hp54-comp__heading">{{ section.settings.heading | default: 'The Sapphire Advantage' }}</h2>
  </div>
  <table class="hp54-comp__table">
    <thead>
      <tr>
        <th>{{ section.settings.col1_head | default: 'Night Benchmark' }}</th>
        <th>{{ section.settings.col2_head | default: 'Midnight Sapphire' }}</th>
        <th>{{ section.settings.col3_head | default: 'Standard Night Creams' }}</th>
      </tr>
    </thead>
    <tbody>
      {%- for block in section.blocks -%}
        <tr {{ block.shopify_attributes }}>
          <td>{{ block.settings.feature | default: 'Deep Penetration' }}</td>
          <td class="hp54-comp__check">{{ block.settings.us | default: '◆ 100% Bio-Active' }}</td>
          <td style="color:#64748B;">{{ block.settings.them | default: 'Surface Only' }}</td>
        </tr>
      {%- endfor -%}
    </tbody>
  </table>
</div>
{% schema %}
{
  "name": "HP54 - Sapphire Compare",
  "class": "section-hp54-comp",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#0F1D32" },
    { "type": "color", "id": "card_bg", "label": "Table BG", "default": "#111D33" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#60A5FA" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "◆ COMPARISON" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Sapphire Advantage" },
    { "type": "text", "id": "col1_head", "label": "Column 1", "default": "Night Benchmark" },
    { "type": "text", "id": "col2_head", "label": "Column 2", "default": "Midnight Sapphire" },
    { "type": "text", "id": "col3_head", "label": "Column 3", "default": "Standard Night Creams" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 700, "max": 1200, "step": 20, "unit": "px", "label": "Container Width", "default": 1000 }
  ],
  "blocks": [{
    "type": "row", "name": "Row",
    "settings": [
      { "type": "text", "id": "feature", "label": "Feature", "default": "Deep Penetration" },
      { "type": "text", "id": "us", "label": "Us", "default": "◆ 100% Bio-Active" },
      { "type": "text", "id": "them", "label": "Others", "default": "Surface Only" }
    ]
  }],
  "presets": [{
    "name": "HP54 - Sapphire Compare",
    "blocks": [
      { "type": "row", "settings": { "feature": "Sapphire Crystal Peptides", "us": "◆ Genuine Micro-Crystals", "them": "Synthetic Imitation" } },
      { "type": "row", "settings": { "feature": "Overnight Moisture Lock", "us": "◆ 72-Hour Cellular Retention", "them": "8-12 Hours" } },
      { "type": "row", "settings": { "feature": "Blue Tansy Calming Bio-Lipids", "us": "◆ Certified Pure Moroccan", "them": "Diluted Extract" } },
      { "type": "row", "settings": { "feature": "Marine Collagen Synthesis", "us": "◆ +340% Clinical Rate", "them": "No Clinical Data" } }
    ]
  }]
}
{% endschema %}
