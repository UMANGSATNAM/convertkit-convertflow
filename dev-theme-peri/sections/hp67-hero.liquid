{%- style -%}
@import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=Syne:wght@700;800&display=swap');
#shopify-section-{{ section.id }}{
  --hp67-bg: {{ section.settings.bg_color | default: '#FFF1F2' }};
  --hp67-text: {{ section.settings.text_color | default: '#4A044E' }};
  --hp67-accent: {{ section.settings.accent | default: '#EC4899' }};
  --hp67-accent2: {{ section.settings.accent2 | default: '#F43F5E' }};
  background: var(--hp67-bg);
  color: var(--hp67-text);
  font-family:'Space Grotesk',sans-serif;
  padding-top:{{ section.settings.padding_top | default: 90 }}px;
  padding-bottom:{{ section.settings.padding_bottom | default: 90 }}px;
  position:relative;overflow:hidden;
}
.hp67-hero__container{max-width:{{ section.settings.container_width | default: 1280 }}px;margin:0 auto;padding:0 24px;display:grid;grid-template-columns:1.1fr 0.9fr;gap:60px;align-items:center}
.hp67-hero__badge{display:inline-flex;align-items:center;gap:8px;padding:7px 16px;border:1px solid var(--hp67-accent);border-radius:999px;font-size:11px;font-weight:700;letter-spacing:2.4px;text-transform:uppercase;color:var(--hp67-accent);margin-bottom:22px}
.hp67-hero__title{font-family:'Syne',sans-serif;font-size:clamp(34px,5vw,58px);font-weight:800;line-height:1.05;margin:0 0 18px;letter-spacing:-.5px}
.hp67-hero__title span{color:var(--hp67-accent)}
.hp67-hero__desc{font-size:16px;line-height:1.8;opacity:.75;margin:0 0 28px;max-width:520px}
.hp67-hero__actions{display:flex;gap:14px;flex-wrap:wrap}
.hp67-hero__btn{display:inline-flex;align-items:center;gap:8px;padding:15px 30px;background:var(--hp67-accent);color:#fff;font-size:13px;font-weight:700;letter-spacing:1.4px;text-transform:uppercase;text-decoration:none;border-radius:8px;transition:transform .3s,box-shadow .3s}
.hp67-hero__btn:hover{transform:translateY(-2px);box-shadow:0 12px 30px rgba(0,0,0,.18)}
.hp67-hero__btn--ghost{background:transparent;color:var(--hp67-accent);border:1.5px solid var(--hp67-accent)}
.hp67-hero__media{position:relative}
.hp67-hero__img-wrap{border-radius:16px;overflow:hidden;height:520px;border:1px solid rgba(0,0,0,.08);box-shadow:0 24px 60px rgba(0,0,0,.12)}
.hp67-hero__img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .6s}
.hp67-hero__img-wrap:hover .hp67-hero__img{transform:scale(1.04)}
.hp67-hero__float{position:absolute;bottom:-18px;left:-18px;background:rgba(255,255,255,.96);backdrop-filter:blur(10px);border:1px solid rgba(0,0,0,.08);border-radius:12px;padding:14px 18px;display:flex;gap:12px;align-items:center;box-shadow:0 10px 30px rgba(0,0,0,.12)}
@media(max-width:992px){.hp67-hero__container{grid-template-columns:1fr;text-align:center;gap:40px}.hp67-hero__desc{margin-left:auto;margin-right:auto}.hp67-hero__actions{justify-content:center}.hp67-hero__img-wrap{height:380px}.hp67-hero__float{left:50%;transform:translateX(-50%)}}
@media(max-width:480px){.hp67-hero__img-wrap{height:300px}}
{%- endstyle -%}
<div class="hp67-hero__container">
  <div>
    <div class="hp67-hero__badge"><span>✦</span><span>{{ section.settings.badge | default: 'BEAUTY RITUAL v67' }}</span></div>
    <h1 class="hp67-hero__title">{{ section.settings.heading | default: 'Skin That <span>Glows Different</span>' }}</h1>
    <p class="hp67-hero__desc">{{ section.settings.description | default: 'Clean botanicals, clinical potency & sensorial textures for real skin.' }}</p>
    <div class="hp67-hero__actions">
      <a href="{{ section.settings.btn_url | default: '/collections/all' }}" class="hp67-hero__btn">{{ section.settings.btn_text | default: 'Shop Now' }} &rarr;</a>
      {%- if section.settings.btn2_text != blank -%}<a href="{{ section.settings.btn2_url }}" class="hp67-hero__btn hp67-hero__btn--ghost">{{ section.settings.btn2_text }}</a>{%- endif -%}
    </div>
  </div>
  <div class="hp67-hero__media">
    <div class="hp67-hero__img-wrap">
      {%- if section.settings.image != blank -%}<img src="{{ section.settings.image | image_url: width: 1000 }}" alt="{{ section.settings.heading | strip_html }}" class="hp67-hero__img" loading="eager" width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}">{%- else -%}{{ 'lifestyle-1' | placeholder_svg_tag: 'hp67-hero__img' }}{%- endif -%}
      <div class="hp67-hero__float"><div style="width:38px;height:38px;border-radius:8px;background:var(--hp67-accent);display:flex;align-items:center;justify-content:center;color:#fff">✦</div><div><p style="margin:0;font-weight:700;font-size:14px">{{ section.settings.float_title | default: 'Trusted by 50k+' }}</p><p style="margin:2px 0 0;font-size:11px;opacity:.7;letter-spacing:1px;text-transform:uppercase">{{ section.settings.float_sub | default: '4.8 ★ rating' }}</p></div></div>
    </div>
  </div>
</div>
{% schema %}{"name":"HP67 Hero","settings":[{"type":"color","id":"bg_color","label":"BG","default":"#FFF1F2"},{"type":"color","id":"text_color","label":"Text","default":"#4A044E"},{"type":"color","id":"accent","label":"Accent","default":"#EC4899"},{"type":"color","id":"accent2","label":"Accent 2","default":"#F43F5E"},{"type":"text","id":"badge","label":"Badge","default":"BEAUTY RITUAL v67"},{"type":"textarea","id":"heading","label":"Heading (HTML)","default":"Skin That <span>Glows Different</span>"},{"type":"textarea","id":"description","label":"Description","default":"Clean botanicals, clinical potency & sensorial textures for real skin."},{"type":"text","id":"btn_text","label":"CTA","default":"Shop Now"},{"type":"url","id":"btn_url","label":"CTA Link"},{"type":"text","id":"btn2_text","label":"Ghost CTA"},{"type":"url","id":"btn2_url","label":"Ghost Link"},{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"float_title","label":"Float Title","default":"Trusted by 50k+"},{"type":"text","id":"float_sub","label":"Float Sub","default":"4.8 ★ rating"},{"type":"range","id":"padding_top","min":20,"max":140,"step":10,"unit":"px","label":"Pad Top","default":90},{"type":"range","id":"padding_bottom","min":20,"max":140,"step":10,"unit":"px","label":"Pad Bottom","default":90},{"type":"range","id":"container_width","min":1000,"max":1440,"step":20,"unit":"px","label":"Width","default":1280}],"presets":[{"name":"HP67 Hero"}]}{% endschema %}