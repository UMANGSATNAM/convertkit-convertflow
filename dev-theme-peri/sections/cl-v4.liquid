{% comment %} CL V4 — High-End Luxury {% endcomment %}
{{ 'component-facets.css' | asset_url | stylesheet_tag }}
<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
<style>
  .clv4 { background: {{ section.settings.bg_color | default: '#1A1A1A' }}; color: {{ section.settings.text_color | default: '#D4AF37' }}; padding: 80px 20px; font-family: 'Cinzel', serif; }
  .clv4-hero { text-align: center; margin-bottom: 60px; }
  .clv4-hero h1 { font-size: 50px; font-weight: 300; letter-spacing: 4px; text-transform: uppercase; margin-bottom: 20px; }
  .clv4-hero p { font-size: 14px; font-family: 'Lato', sans-serif; color: #CCC; max-width: 600px; margin: 0 auto; letter-spacing: 1px; line-height: 1.6; }
  .clv4-chips { display: flex; gap: 20px; justify-content: center; margin-bottom: 50px; flex-wrap: wrap; }
  .clv4-chips a { padding: 10px 0; color: #D4AF37; text-decoration: none; font-size: 13px; font-family: 'Lato', sans-serif; text-transform: uppercase; letter-spacing: 2px; border-bottom: 1px solid transparent; transition: 0.3s; }
  .clv4-chips a:hover { border-bottom: 1px solid #D4AF37; }
  .clv4-toolbar { display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #333; border-bottom: 1px solid #333; padding: 20px 0; margin-bottom: 50px; font-family: 'Lato', sans-serif; }
  .clv4-grid { display: grid; grid-template-columns: repeat({{ section.settings.cols_desktop | default: 3 }}, 1fr); gap: 40px; }
  .clv4-promo { grid-column: span 1; background: #000; border: 1px solid #D4AF37; padding: 40px; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; }
  .clv4-promo h3 { font-size: 26px; font-weight: 300; letter-spacing: 2px; margin-bottom: 20px; }
  .clv4-promo a { display: inline-block; padding: 12px 30px; border: 1px solid #D4AF37; color: #D4AF37; text-decoration: none; font-family: 'Lato', sans-serif; font-size: 12px; text-transform: uppercase; letter-spacing: 2px; transition: 0.3s; }
  .clv4-promo a:hover { background: #D4AF37; color: #000; }
  .clv4-seo { margin-top: 80px; text-align: center; border-top: 1px solid #333; padding-top: 60px; }
  @media (max-width: 768px) { .clv4-grid { grid-template-columns: repeat({{ section.settings.cols_mobile | default: 1 }}, 1fr); gap: 30px; } .clv4-hero h1 { font-size: 32px; } }
</style>
<div class="clv4" style="max-width: 1200px; margin: 0 auto;">
  <div class="clv4-hero">
    <h1>{% if collection.title != blank %}{{ collection.title | escape }}{% else %}The Prestige{% endif %}</h1>
    <p>{% if collection.description != blank %}{{ collection.description }}{% else %}An exclusive curation of our most luxurious pieces.{% endif %}</p>
  </div>
  {% if section.settings.sub_collections != blank %}
    <div class="clv4-chips">
      {% for link in section.settings.sub_collections.links %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% endfor %}
    </div>
  {% endif %}
  <div class="clv4-toolbar">
    <facet-filters-form style="width: 100%;">
      <form id="FacetFiltersForm" style="display: flex; justify-content: space-between; width: 100%; align-items: center; flex-wrap: wrap; gap: 20px;">
        <div style="display: flex; gap: 30px;">
          {%- for filter in collection.filters -%}
            <details style="position: relative;">
              <summary style="cursor: pointer; font-size: 12px; text-transform: uppercase; letter-spacing: 2px; color: #D4AF37;">{{ filter.label }} +</summary>
              <div style="position: absolute; background: #000; border: 1px solid #333; padding: 25px; z-index: 10; margin-top: 20px; min-width: 250px;">
                {%- for value in filter.values -%}
                  <label style="display: block; margin-bottom: 15px; cursor: pointer; font-size: 13px; color: #CCC;">
                    <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %}>
                    {{ value.label }} <span style="color:#666;">({{ value.count }})</span>
                  </label>
                {%- endfor -%}
              </div>
            </details>
          {%- endfor -%}
        </div>
        <select name="sort_by" onchange="this.form.submit()" style="background: transparent; border: none; font-size: 12px; text-transform: uppercase; letter-spacing: 2px; color: #D4AF37; cursor: pointer;">
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>Sort: {{ option.name }}</option>
          {%- endfor -%}
        </select>
      </form>
    </facet-filters-form>
  </div>
  {% assign limit_num = section.settings.products_per_page | default: 12 %}
  {% paginate collection.products by limit_num %}
    <div class="clv4-grid">
      {% for product in collection.products %}
        {% render 'card-v4', product: product %}
        {% if forloop.index == 8 and section.settings.show_promo_tile %}
          <div class="clv4-promo">
            <span style="font-family: 'Lato', sans-serif; font-size: 10px; text-transform: uppercase; letter-spacing: 3px; margin-bottom: 15px; color: #CCC;">Private Event</span>
            <h3>Trunk Show Collection</h3>
            <a href="/pages/trunk-show">View Schedule</a>
          </div>
        {% endif %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v4', product: nil %}
        {% endfor %}
      {% endfor %}
    </div>
    <div style="margin-top: 60px; text-align: center; font-family: 'Lato', sans-serif;">{{ paginate | default_pagination }}</div>
  {% endpaginate %}
  {% if section.settings.show_seo_block %}
    <div class="clv4-seo">
      <h2 style="font-size: 28px; font-weight: 300; letter-spacing: 3px; margin-bottom: 20px;">{{ section.settings.seo_title | default: 'Excellence Embodied' }}</h2>
      <p style="font-family: 'Lato', sans-serif; font-size: 14px; color: #CCC; max-width: 700px; margin: 0 auto; line-height: 1.8; letter-spacing: 0.5px;">{{ section.settings.seo_text | default: 'Every item in our luxury collection is a testament to unparalleled craftsmanship and timeless elegance.' }}</p>
    </div>
  {% endif %}
</div>
{% schema %}
{
  "name": "CL V4 — Luxury", "settings": [
    {"type": "range", "id": "products_per_page", "label": "Products per page", "min": 6, "max": 36, "step": 3, "default": 12},
    {"type": "range", "id": "cols_desktop", "label": "Desktop Columns", "min": 2, "max": 4, "default": 3},
    {"type": "select", "id": "cols_mobile", "label": "Mobile Columns", "options": [{"value": "1", "label": "1"}, {"value": "2", "label": "2"}], "default": "1"},
    {"type": "link_list", "id": "sub_collections", "label": "Sub-Collection Menu"},
    {"type": "checkbox", "id": "show_promo_tile", "label": "Show Promo Card", "default": true},
    {"type": "checkbox", "id": "show_seo_block", "label": "Show SEO Block", "default": true},
    {"type": "color", "id": "bg_color", "label": "Background Color", "default": "#1A1A1A"},
    {"type": "color", "id": "text_color", "label": "Text Color", "default": "#D4AF37"}
  ], "presets": [{"name": "CL V4 — Luxury"}]
}
{% endschema %}
