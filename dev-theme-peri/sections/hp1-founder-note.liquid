{%- liquid
  assign bg_color = section.settings.bg_color | default: '#ffffff'
  assign text_color = section.settings.text_color | default: '#2c2c2c'
-%}

<section class="hp1-beauty-founder" style="background-color: {{ bg_color }}; color: {{ text_color }};" id="hp1-founder-{{ section.id }}">
  <div class="hp1-founder-inner">
    
    <div class="hp1-founder-grid">
      
      <div class="hp1-founder-image">
        <div class="hp1-founder-img-wrapper">
          {%- if section.settings.image != blank -%}
            <img height="{{ section.settings.image.height }}" width="{{ section.settings.image.width }}" src="{{ section.settings.image | image_url: width: 800 }}" alt="" loading="lazy">
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
      </div>

      <div class="hp1-founder-content">
        {%- if section.settings.subheading != blank -%}
          <span class="hp1-founder-subheading">{{ section.settings.subheading }}</span>
        {%- endif -%}
        
        {%- if section.settings.heading != blank -%}
          <h2 class="hp1-founder-heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        
        <div class="hp1-founder-text">
          {{ section.settings.text }}
        </div>
        
        {%- if section.settings.signature != blank -%}
          <div class="hp1-founder-signature">
            {{ section.settings.signature }}
          </div>
        {%- endif -%}
      </div>
      
    </div>

  </div>
</section>

<style>
  .hp1-beauty-founder {
    padding: 100px 0;
    font-family: 'Inter', sans-serif;
  }
  .hp1-founder-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }
  .hp1-founder-grid {
    display: flex;
    align-items: center;
    gap: 80px;
  }
  .hp1-founder-image {
    flex: 1;
  }
  .hp1-founder-img-wrapper {
    position: relative;
    border-radius: 200px 200px 0 0;
    overflow: hidden;
    aspect-ratio: 3/4;
  }
  .hp1-founder-img-wrapper img, .hp1-founder-img-wrapper svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hp1-founder-img-wrapper::after {
    content: '';
    position: absolute;
    inset: 15px;
    border: 1px solid rgba(255,255,255,0.5);
    border-radius: 185px 185px 0 0;
    pointer-events: none;
  }

  .hp1-founder-content {
    flex: 1;
  }
  .hp1-founder-subheading {
    display: block;
    font-size: 13px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #8a7a6c;
    margin-bottom: 20px;
  }
  .hp1-founder-heading {
    font-family: 'Playfair Display', serif;
    font-size: clamp(32px, 4vw, 42px);
    font-weight: 400;
    margin: 0 0 30px;
    line-height: 1.2;
  }
  .hp1-founder-text {
    font-size: 16px;
    line-height: 1.8;
    color: #555;
    margin-bottom: 40px;
  }
  .hp1-founder-text p {
    margin: 0 0 15px;
  }
  .hp1-founder-signature {
    font-family: 'Playfair Display', serif; /* Or a cursive web font if added */
    font-size: 32px;
    font-style: italic;
    color: #8a7a6c;
  }

  @media (max-width: 991px) {
    .hp1-founder-grid {
      flex-direction: column;
      gap: 50px;
    }
    .hp1-founder-image {
      width: 100%;
      max-width: 400px;
      margin: 0 auto;
    }
    .hp1-founder-content {
      text-align: center;
    }
  }
  @media (max-width: 767px) {
    .hp1-beauty-founder { padding: 60px 0; }
  }
</style>

{% schema %}
{
  "name": "HP1 Founder Note",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Founder Image"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Our Story"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A Note From The Founder"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>I started this brand because I couldn't find skincare that was both gentle and effective. We believe in transparency, high-quality ingredients, and products that make you feel beautiful in your own skin.</p>"
    },
    {
      "type": "text",
      "id": "signature",
      "label": "Signature Text",
      "default": "Eleanor Vance"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2c2c2c"
    }
  ],
  "presets": [
    {
      "name": "HP1 Founder Note"
    }
  ]
}
{% endschema %}
