{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#0F1D32' }};
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }
  .hp54-story__container {
    max-width: {{ section.settings.container_width | default: 1280 }}px;
    margin: 0 auto; padding: 0 24px;
    display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 70px; align-items: center;
  }
  .hp54-story__img-wrap { border-radius: 16px; overflow: hidden; height: 480px; border: 1px solid rgba(59, 130, 246, 0.2); }
  .hp54-story__img { width: 100%; height: 100%; object-fit: cover; filter: brightness(0.85) contrast(1.1); }
  .hp54-story__eyebrow { font-family: 'Inter', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: {{ section.settings.accent_color | default: '#60A5FA' }}; margin: 0 0 16px; }
  .hp54-story__heading { font-family: 'Tenor Sans', serif; font-size: clamp(28px, 3.5vw, 42px); color: #FFFFFF; margin: 0 0 22px; line-height: 1.15; }
  .hp54-story__text { font-size: 15px; line-height: 1.8; color: #94A3B8; margin: 0 0 32px; }
  .hp54-story__btn {
    display: inline-flex; align-items: center; gap: 10px; padding: 14px 30px;
    background: {{ section.settings.btn_bg | default: '#3B82F6' }}; color: #FFFFFF;
    font-family: 'Inter', sans-serif; font-size: 13px; font-weight: 700;
    text-decoration: none; border-radius: 8px; transition: all 0.3s ease;
    box-shadow: 0 4px 16px rgba(59, 130, 246, 0.3);
  }
  .hp54-story__btn:hover { box-shadow: 0 8px 25px rgba(59, 130, 246, 0.5); transform: translateY(-2px); }
  @media screen and (max-width: 992px) { .hp54-story__container { grid-template-columns: 1fr; text-align: center; gap: 40px; } .hp54-story__img-wrap { height: 350px; } }
{%- endstyle -%}
<div class="hp54-story__container">
  <div class="hp54-story__img-wrap">
    {%- if section.settings.image != blank -%}
      <img src="{{ section.settings.image | image_url: width: 800 }}" class="hp54-story__img" alt="{{ section.settings.heading }}" loading="lazy">
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'hp54-story__img' }}
    {%- endif -%}
  </div>
  <div>
    <p class="hp54-story__eyebrow">{{ section.settings.eyebrow | default: '◆ OUR ORIGIN' }}</p>
    <h2 class="hp54-story__heading">{{ section.settings.heading | default: 'Born from Midnight Waters' }}</h2>
    <p class="hp54-story__text">{{ section.settings.text | default: 'Deep beneath the ocean surface, where light fades and pressure creates diamonds, our scientists discovered a sapphire-blue peptide complex that revolutionizes skin repair during the darkest hours.' }}</p>
    {%- if section.settings.btn_label != blank -%}
      <a href="{{ section.settings.btn_url | default: '/pages/about' }}" class="hp54-story__btn">{{ section.settings.btn_label }} &rarr;</a>
    {%- endif -%}
  </div>
</div>
{% schema %}
{
  "name": "HP54 - Sapphire Story",
  "class": "section-hp54-story",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#0F1D32" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#60A5FA" },
    { "type": "color", "id": "btn_bg", "label": "Button BG", "default": "#3B82F6" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "◆ OUR ORIGIN" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Born from Midnight Waters" },
    { "type": "textarea", "id": "text", "label": "Story Text", "default": "Deep beneath the ocean surface, our scientists discovered a sapphire-blue peptide complex." },
    { "type": "text", "id": "btn_label", "label": "Button Label", "default": "Read Our Story" },
    { "type": "url", "id": "btn_url", "label": "Button URL" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "presets": [{ "name": "HP54 - Sapphire Story" }]
}
{% endschema %}
