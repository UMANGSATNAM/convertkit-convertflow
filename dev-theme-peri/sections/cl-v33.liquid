{% comment %} CL V33 — Craft Beer / Brewery (Industrial) {% endcomment %}
{{ 'component-facets.css' | asset_url | stylesheet_tag }}
<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
<style>
  .clv33 { background: {{ section.settings.bg_color | default: '#1C1614' }}; color: {{ section.settings.text_color | default: '#E0C3A0' }}; padding: 60px 20px; font-family: 'Oswald', sans-serif; text-transform: uppercase; }
  .clv33-hero { text-align: center; margin-bottom: 50px; border-bottom: 4px solid #E0C3A0; padding-bottom: 40px; }
  .clv33-hero h1 { font-size: 56px; font-weight: 700; color: #E0C3A0; margin-bottom: 10px; line-height: 1; letter-spacing: 2px; }
  .clv33-hero p { font-size: 16px; color: #9A8370; font-family: 'Roboto', sans-serif; text-transform: none; max-width: 500px; margin: 0 auto; }
  .clv33-chips { display: flex; gap: 15px; justify-content: center; margin-bottom: 40px; flex-wrap: wrap; }
  .clv33-chips a { padding: 12px 24px; background: #2A211D; color: #E0C3A0; text-decoration: none; font-size: 14px; font-weight: 700; letter-spacing: 1px; border: 2px solid #E0C3A0; transition: 0.2s; }
  .clv33-chips a:hover, .clv33-chips a.active { background: #E0C3A0; color: #1C1614; }
  .clv33-toolbar { display: flex; justify-content: space-between; align-items: center; background: #2A211D; padding: 15px 25px; margin-bottom: 40px; border: 1px solid #3F332D; }
  .clv33-grid { display: grid; grid-template-columns: repeat({{ section.settings.cols_desktop | default: 4 }}, 1fr); gap: 25px; }
  .clv33-promo { grid-column: span 1; background: #8B4513; color: #E0C3A0; border: 4px solid #E0C3A0; padding: 40px; text-align: center; display: flex; flex-direction: column; justify-content: center; position: relative; }
  .clv33-promo h3 { font-size: 32px; font-weight: 700; margin-bottom: 20px; line-height: 1.1; }
  .clv33-promo a { display: inline-block; padding: 12px 25px; background: #E0C3A0; color: #1C1614; text-decoration: none; font-weight: 700; font-size: 14px; letter-spacing: 1px; }
  .clv33-seo { margin-top: 60px; text-align: center; padding: 40px; background: #2A211D; border: 1px solid #3F332D; }
  @media (max-width: 768px) { .clv33-grid { grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr); gap: 15px; } .clv33-hero h1 { font-size: 40px; } }
</style>
<div class="clv33" style="max-width: 1300px; margin: 0 auto;">
  <div class="clv33-hero">
    <h1>{% if collection.title != blank %}{{ collection.title | escape }}{% else %}ON TAP NOW{% endif %}</h1>
    <p>{% if collection.description != blank %}{{ collection.description }}{% else %}Small batch, independently brewed craft beer.{% endif %}</p>
  </div>
  {% if section.settings.sub_collections != blank %}
    <div class="clv33-chips">
      {% for link in section.settings.sub_collections.links %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% endfor %}
    </div>
  {% endif %}
  <div class="clv33-toolbar">
    <facet-filters-form style="width: 100%;">
      <form id="FacetFiltersForm" style="display: flex; justify-content: space-between; align-items: center; width: 100%; flex-wrap: wrap; gap: 20px;">
        <div style="display: flex; gap: 20px;">
          {%- for filter in collection.filters -%}
            <details style="position: relative;">
              <summary style="cursor: pointer; font-size: 16px; font-weight: 700; color: #E0C3A0; letter-spacing: 1px;">{{ filter.label }} +</summary>
              <div style="position: absolute; background: #1C1614; border: 2px solid #E0C3A0; padding: 20px; z-index: 10; margin-top: 10px; min-width: 220px;">
                {%- for value in filter.values -%}
                  <label style="display: block; margin-bottom: 12px; cursor: pointer; font-size: 14px; font-family: 'Roboto', sans-serif; text-transform: none; color: #E0C3A0;">
                    <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %}>
                    {{ value.label }} ({{ value.count }})
                  </label>
                {%- endfor -%}
              </div>
            </details>
          {%- endfor -%}
        </div>
        <select name="sort_by" onchange="this.form.submit()" style="background: transparent; border: 1px solid #E0C3A0; color: #E0C3A0; padding: 10px 15px; font-size: 14px; font-weight: 700; font-family: 'Oswald', sans-serif; text-transform: uppercase; cursor: pointer;">
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>
          {%- endfor -%}
        </select>
      </form>
    </facet-filters-form>
  </div>
  {% assign limit_num = section.settings.products_per_page | default: 16 %}
  {% paginate collection.products by limit_num %}
    <div class="clv33-grid">
      {% for product in collection.products %}
        {% render 'card-v33', product: product %}
        {% if forloop.index == 8 and section.settings.show_promo_tile %}
          <div class="clv33-promo">
            <h3>Brewery<br>Tours</h3>
            <a href="/pages/tours">Book Now</a>
          </div>
        {% endif %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v33', product: nil %}
        {% endfor %}
      {% endfor %}
    </div>
    <div style="margin-top: 50px; text-align: center; font-size: 20px; letter-spacing: 2px;">{{ paginate | default_pagination }}</div>
  {% endpaginate %}
  {% if section.settings.show_seo_block %}
    <div class="clv33-seo">
      <h2 style="font-size: 32px; font-weight: 700; margin-bottom: 15px; letter-spacing: 1px;">{{ section.settings.seo_title | default: 'BREWED WITH GUTS' }}</h2>
      <p style="font-family: 'Roboto', sans-serif; text-transform: none; color: #9A8370; max-width: 650px; margin: 0 auto; line-height: 1.6;">{{ section.settings.seo_text | default: "We don't cut corners. From the malt to the hops, everything we put in the tank is premium quality." }}</p>
    </div>
  {% endif %}
</div>
{% schema %}
{
  "name": "CL V33 — Brewery", "settings": [
    {"type": "range", "id": "products_per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 16},
    {"type": "range", "id": "cols_desktop", "label": "Desktop Columns", "min": 2, "max": 5, "default": 4},
    {"type": "select", "id": "cols_mobile", "label": "Mobile Columns", "options": [{"value": "1", "label": "1"}, {"value": "2", "label": "2"}], "default": "2"},
    {"type": "link_list", "id": "sub_collections", "label": "Sub-Collection Menu"},
    {"type": "checkbox", "id": "show_promo_tile", "label": "Show Promo Card", "default": true},
    {"type": "checkbox", "id": "show_seo_block", "label": "Show SEO Block", "default": true},
    {"type": "color", "id": "bg_color", "label": "Background Color", "default": "#1C1614"},
    {"type": "color", "id": "text_color", "label": "Text Color", "default": "#E0C3A0"}
  ], "presets": [{"name": "CL V33 — Brewery"}]
}
{% endschema %}
