{%- liquid
  assign sec_id = section.id
  assign bg_color = section.settings.bg_color
  assign text_color = section.settings.text_color
  assign accent_color = section.settings.accent_color
  assign border_color = section.settings.border_color
  assign border_width = section.settings.border_width
  assign shadow_color = section.settings.shadow_color
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
-%}

<style>
  .hp18-brand-story-{{ sec_id }} {
    background-color: {{ bg_color }};
    padding-top: {{ padding_top }}px;
    padding-bottom: {{ padding_bottom }}px;
    border-bottom: {{ border_width }}px solid {{ border_color }};
    position: relative;
    overflow: hidden;
  }

  .hp18-brand-story-{{ sec_id }}::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-image: repeating-linear-gradient(
      45deg,
      {{ border_color }}22 0,
      {{ border_color }}22 2px,
      transparent 2px,
      transparent 10px
    );
    opacity: 0.3;
    pointer-events: none;
  }

  .hp18-brand-story-{{ sec_id }}__container {
    max-width: var(--page-width, 1200px);
    margin: 0 auto;
    padding: 0 40px;
    position: relative;
    z-index: 2;
  }

  .hp18-brand-story-{{ sec_id }}__wrapper {
    background-color: #ffffff;
    border: {{ border_width }}px solid {{ border_color }};
    box-shadow: 20px 20px 0px {{ shadow_color }};
    padding: 80px;
    text-align: center;
    position: relative;
  }

  /* Decorative corner pins */
  .hp18-brand-story-{{ sec_id }}__pin {
    position: absolute;
    width: 24px;
    height: 24px;
    background-color: {{ accent_color }};
    border: {{ border_width }}px solid {{ border_color }};
    border-radius: 50%;
    z-index: 3;
  }
  .hp18-brand-story-{{ sec_id }}__pin--tl { top: 20px; left: 20px; }
  .hp18-brand-story-{{ sec_id }}__pin--tr { top: 20px; right: 20px; }
  .hp18-brand-story-{{ sec_id }}__pin--bl { bottom: 20px; left: 20px; }
  .hp18-brand-story-{{ sec_id }}__pin--br { bottom: 20px; right: 20px; }

  .hp18-brand-story-{{ sec_id }}__eyebrow {
    font-family: 'Courier New', monospace;
    font-size: 16px;
    font-weight: bold;
    color: {{ border_color }};
    text-transform: uppercase;
    display: inline-block;
    background-color: {{ accent_color }};
    padding: 5px 15px;
    border: 2px solid {{ border_color }};
    margin-bottom: 20px;
  }

  .hp18-brand-story-{{ sec_id }}__title {
    font-family: 'Arial Black', Impact, sans-serif;
    font-size: clamp(36px, 5vw, 64px);
    color: {{ text_color }};
    text-transform: uppercase;
    margin: 0 0 30px 0;
    line-height: 1.1;
    letter-spacing: -2px;
  }

  .hp18-brand-story-{{ sec_id }}__text {
    font-family: 'Courier New', monospace;
    font-size: 20px;
    line-height: 1.6;
    color: {{ text_color }};
    max-width: 800px;
    margin: 0 auto 40px auto;
    font-weight: bold;
  }

  .hp18-brand-story-{{ sec_id }}__signature {
    font-family: 'Brush Script MT', cursive;
    font-size: 48px;
    color: {{ accent_color }};
    transform: rotate(-5deg);
    display: inline-block;
    text-shadow: 2px 2px 0px {{ border_color }};
  }

  @media screen and (max-width: 768px) {
    .hp18-brand-story-{{ sec_id }}__container { padding: 0 20px; }
    .hp18-brand-story-{{ sec_id }}__wrapper { 
      padding: 50px 30px; 
      box-shadow: 10px 10px 0px {{ shadow_color }};
    }
    .hp18-brand-story-{{ sec_id }}__pin { width: 16px; height: 16px; }
    .hp18-brand-story-{{ sec_id }}__pin--tl { top: 10px; left: 10px; }
    .hp18-brand-story-{{ sec_id }}__pin--tr { top: 10px; right: 10px; }
    .hp18-brand-story-{{ sec_id }}__pin--bl { bottom: 10px; left: 10px; }
    .hp18-brand-story-{{ sec_id }}__pin--br { bottom: 10px; right: 10px; }
    .hp18-brand-story-{{ sec_id }}__text { font-size: 16px; }
  }
</style>

<section class="hp18-brand-story-{{ sec_id }}">
  <div class="hp18-brand-story-{{ sec_id }}__container">
    <div class="hp18-brand-story-{{ sec_id }}__wrapper">
      
      <div class="hp18-brand-story-{{ sec_id }}__pin hp18-brand-story-{{ sec_id }}__pin--tl"></div>
      <div class="hp18-brand-story-{{ sec_id }}__pin hp18-brand-story-{{ sec_id }}__pin--tr"></div>
      <div class="hp18-brand-story-{{ sec_id }}__pin hp18-brand-story-{{ sec_id }}__pin--bl"></div>
      <div class="hp18-brand-story-{{ sec_id }}__pin hp18-brand-story-{{ sec_id }}__pin--br"></div>

      {% if section.settings.eyebrow != blank %}
        <div class="hp18-brand-story-{{ sec_id }}__eyebrow">{{ section.settings.eyebrow }}</div>
      {% endif %}

      {% if section.settings.title != blank %}
        <h2 class="hp18-brand-story-{{ sec_id }}__title">{{ section.settings.title }}</h2>
      {% endif %}

      {% if section.settings.text != blank %}
        <div class="hp18-brand-story-{{ sec_id }}__text">
          {{ section.settings.text | newline_to_br }}
        </div>
      {% endif %}

      {% if section.settings.signature != blank %}
        <div class="hp18-brand-story-{{ sec_id }}__signature">{{ section.settings.signature }}</div>
      {% endif %}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "HP18 Adv Brand Story",
  "settings": [
    {
      "type": "header",
      "content": "Color Settings"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#eeeeee"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#CCFF00"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "shadow_color",
      "label": "Shadow Color",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "Border Width",
      "default": 3
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 10,
      "unit": "px",
      "label": "Padding Top",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 10,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 100
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "EST. 2024"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "NOT JUST A BRAND. A MOVEMENT."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "We started in a garage with one printing press and a refusal to conform. Today, we are setting the standard for streetwear globally. Unapologetic design, premium materials, zero compromises."
    },
    {
      "type": "text",
      "id": "signature",
      "label": "Signature Text",
      "default": "The Founders"
    }
  ],
  "presets": [
    {
      "name": "HP18 Advanced Brand Story"
    }
  ]
}
{% endschema %}
