{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#D1FAE5' }};
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
  }
  .hp62-usp__container { max-width: {{ section.settings.container_width | default: 1280 }}px; margin: 0 auto; padding: 0 24px; }
  .hp62-usp__grid { display: grid; grid-template-columns: repeat({{ section.settings.columns | default: 4 }}, 1fr); gap: 20px; }
  .hp62-usp__card {
    background: {{ section.settings.card_bg | default: '#FFFFFF' }};
    border: 1px solid rgba(6, 78, 59, 0.15);
    border-radius: 16px; padding: 32px 22px; text-align: center;
    box-shadow: 0 4px 20px rgba(6, 78, 59, 0.05);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .hp62-usp__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 30px rgba(6, 78, 59, 0.12);
  }
  .hp62-usp__icon {
    width: 52px; height: 52px;
    background: linear-gradient(135deg, #ECFDF5, #A7F3D0);
    border-radius: 50%; display: flex; align-items: center; justify-content: center;
    margin: 0 auto 16px; font-size: 22px; color: #064E3B;
    border: 1px solid rgba(6, 78, 59, 0.2);
  }
  .hp62-usp__title {
    font-family: 'Italiana', serif; font-size: 19px; font-weight: 700; color: #064E3B; margin: 0 0 8px;
  }
  .hp62-usp__desc { font-size: 13px; line-height: 1.6; color: #475569; margin: 0; }
  @media screen and (max-width: 992px) { .hp62-usp__grid { grid-template-columns: repeat(2, 1fr); } }
  @media screen and (max-width: 480px) { .hp62-usp__grid { grid-template-columns: 1fr; } }
{%- endstyle -%}
<div class="hp62-usp__container">
  <div class="hp62-usp__grid">
    {%- for block in section.blocks -%}
      <div class="hp62-usp__card" {{ block.shopify_attributes }}>
        <div class="hp62-usp__icon">{{ block.settings.icon | default: '🏔️' }}</div>
        <h3 class="hp62-usp__title">{{ block.settings.title | default: 'Alpine Edelweiss' }}</h3>
        <p class="hp62-usp__desc">{{ block.settings.description | default: 'High altitude bio-actives.' }}</p>
      </div>
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "HP62 Pillars",
  "class": "section-hp62-usp",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#D1FAE5" },
    { "type": "color", "id": "card_bg", "label": "Card BG", "default": "#FFFFFF" },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "label": "Columns", "default": 4 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 80 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "blocks": [{ "type": "pillar", "name": "Pillar", "settings": [
    { "type": "text", "id": "icon", "label": "Icon", "default": "🏔️" },
    { "type": "text", "id": "title", "label": "Title", "default": "Alpine Edelweiss" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "High altitude bio-actives." }
  ]}],
  "presets": [{ "name": "HP62 Pillars", "blocks": [
    { "type": "pillar", "settings": { "icon": "🏔️", "title": "Alpine Leontopodic Acid", "description": "Superior antioxidant neutralizing intense UV and altitude-induced oxidative stress." } },
    { "type": "pillar", "settings": { "icon": "❄️", "title": "Zermatt Glacial Dew", "description": "Natural oxygen-rich glacial water filtered through alpine granite rock beds." } },
    { "type": "pillar", "settings": { "icon": "🌿", "title": "Alpine Rose Stem Cells", "description": "Increases skin stem cell vitality and improves dermal barrier functionality." } },
    { "type": "pillar", "settings": { "icon": "💧", "title": "Glacial Cryo-Hydration", "description": "Locks in multi-depth dermal hydration with refreshing cooling sensation." } }
  ]}]
}
{% endschema %}
