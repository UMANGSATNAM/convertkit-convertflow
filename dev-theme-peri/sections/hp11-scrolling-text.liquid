{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#CCFF00'
  assign text_color = section.settings.text_color | default: '#000000'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 60px 0;
    overflow: hidden;
    border-bottom: 3px solid #000;
  }
  
  .hp11-scrolling-text-container-{{ section_id }} {
    display: flex;
    white-space: nowrap;
    overflow: hidden;
  }
  
  .hp11-scrolling-text-content-{{ section_id }} {
    display: flex;
    animation: hp11-scroll-text-{{ section_id }} 15s linear infinite;
  }
  
  .hp11-scrolling-text-item-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: clamp(4rem, 10vw, 8rem);
    font-weight: 900;
    color: transparent;
    -webkit-text-stroke: 2px {{ text_color }};
    text-transform: uppercase;
    letter-spacing: -2px;
    padding: 0 40px;
    line-height: 1;
    display: flex;
    align-items: center;
  }
  
  .hp11-scrolling-text-item-{{ section_id }} span {
    color: {{ text_color }};
    -webkit-text-stroke: 0;
    margin: 0 20px;
  }

  @keyframes hp11-scroll-text-{{ section_id }} {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
</style>

<div class="hp11-scrolling-text-container-{{ section_id }}">
  <div class="hp11-scrolling-text-content-{{ section_id }}">
    {% for i in (1..4) %}
      <div class="hp11-scrolling-text-item-{{ section_id }}">
        {{ section.settings.text | default: 'STAY READY' }} <span>✦</span>
      </div>
    {% endfor %}
    {% for i in (1..4) %}
      <div class="hp11-scrolling-text-item-{{ section_id }}">
        {{ section.settings.text | default: 'STAY READY' }} <span>✦</span>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "HP11 Scrolling Text",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#CCFF00"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text/Stroke Color",
      "default": "#000000"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "STAY READY"
    }
  ],
  "presets": [
    {
      "name": "HP11 Scrolling Text"
    }
  ]
}
{% endschema %}
