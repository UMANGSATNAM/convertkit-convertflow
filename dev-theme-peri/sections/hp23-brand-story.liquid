{%- style -%}
  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --border-color: #000000;
    --border-width: 3px;
    --shadow-offset: 8px;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    border-bottom: var(--border-width) solid var(--border-color);
    font-family: 'Space Grotesk', 'Outfit', sans-serif;
    position: relative;
    overflow: hidden;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }

  .hp23-story-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp23-story-wrapper {
      padding: 0 20px;
    }
  }

  .hp23-story__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
    align-items: stretch;
  }

  @media screen and (max-width: 992px) {
    .hp23-story__grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }

  /* Keep media on the left/right based on setting */
  {%- if section.settings.layout == 'right' -%}
    @media screen and (min-width: 993px) {
      .hp23-story__media-col {
        order: 2;
      }
      .hp23-story__content-col {
        order: 1;
      }
    }
  {%- endif -%}

  .hp23-story__box {
    background: #ffffff;
    border: var(--border-width) solid var(--border-color);
    box-shadow: var(--shadow-offset) var(--shadow-offset) 0 var(--border-color);
    border-radius: {{ section.settings.border_radius }}px;
    overflow: hidden;
  }

  .hp23-story__media-col {
    position: relative;
    min-height: 500px;
    background: var(--accent-color);
  }

  @media screen and (max-width: 992px) {
    .hp23-story__media-col {
      min-height: 400px;
    }
  }

  .hp23-story__image {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: contrast(1.2) grayscale(0.2); /* Slight brutalist image treatment */
  }

  .hp23-story__media-badge {
    position: absolute;
    bottom: -15px;
    right: -15px;
    background: #FFEB3B;
    border: var(--border-width) solid var(--border-color);
    padding: 10px 20px;
    transform: rotate(-10deg);
    font-weight: 900;
    font-size: 24px;
    text-transform: uppercase;
    box-shadow: 4px 4px 0 var(--border-color);
    z-index: 2;
  }
  
  .hp23-story__content-col {
    padding: 60px 50px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: #ffffff;
    position: relative;
  }

  @media screen and (max-width: 768px) {
    .hp23-story__content-col {
      padding: 40px 30px;
    }
  }

  /* Decorative repeating background text */
  .hp23-story__bg-text {
    position: absolute;
    top: -20px;
    left: -20px;
    font-size: 150px;
    font-weight: 900;
    color: transparent;
    -webkit-text-stroke: 1px rgba(0,0,0,0.05);
    line-height: 0.8;
    z-index: 0;
    pointer-events: none;
    text-transform: uppercase;
    white-space: nowrap;
    user-select: none;
  }

  .hp23-story__content-inner {
    position: relative;
    z-index: 1;
  }

  .hp23-story__label {
    display: inline-block;
    padding: 6px 12px;
    background: var(--text-color);
    color: #ffffff;
    font-size: 14px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 24px;
  }

  .hp23-story__title {
    font-size: clamp(36px, 5vw, {{ section.settings.title_size }}px);
    font-weight: 900;
    color: var(--text-color);
    line-height: 1.1;
    margin: 0 0 24px;
    text-transform: uppercase;
    letter-spacing: -1px;
  }
  
  .hp23-story__title em {
    font-style: normal;
    background: var(--accent-color);
    padding: 0 4px;
    display: inline-block;
    transform: rotate(2deg);
    border: 2px solid var(--border-color);
    box-shadow: 3px 3px 0 var(--border-color);
  }

  .hp23-story__text {
    font-family: var(--font-body);
    font-size: {{ section.settings.text_size }}px;
    font-weight: 500;
    color: var(--text-color);
    line-height: 1.5;
    margin: 0 0 40px;
  }

  .hp23-story__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 32px;
    background: var(--text-color);
    color: #ffffff;
    font-weight: 800;
    font-size: 16px;
    text-transform: uppercase;
    letter-spacing: 1px;
    text-decoration: none;
    border: var(--border-width) solid var(--border-color);
    border-radius: {{ section.settings.border_radius }}px;
    box-shadow: 4px 4px 0 var(--border-color);
    transition: all 0.2s ease;
    align-self: flex-start;
  }

  .hp23-story__btn:hover {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0 var(--border-color);
    background: var(--accent-color);
    color: var(--text-color);
  }

  .hp23-story__btn:active {
    transform: translate(4px, 4px);
    box-shadow: 0 0 0 var(--border-color);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp23-story-wrapper" id="HP23Story-{{ section.id }}">
  <div class="hp23-story__grid">
    
    <div class="hp23-story__box hp23-story__media-col">
      {%- if section.settings.image != blank -%}
        <img height="{{ section.settings.image.height }}" width="{{ section.settings.image.width }}" src="{{ section.settings.image | image_url: width: 1000 }}" alt="{{ section.settings.title | strip_html | escape }}" class="hp23-story__image" loading="lazy">
      {%- else -%}
        <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:24px;font-weight:900;background:var(--accent-color);">STORY IMAGE</div>
      {%- endif -%}
      
      {%- if section.settings.show_badge -%}
        <div class="hp23-story__media-badge">SINCE 2024</div>
      {%- endif -%}
    </div>

    <div class="hp23-story__box hp23-story__content-col">
      <div class="hp23-story__bg-text">OUR<br>STORY</div>
      
      <div class="hp23-story__content-inner">
        {%- if section.settings.label != blank -%}
          <div class="hp23-story__label">{{ section.settings.label | escape }}</div>
        {%- endif -%}

        {%- if section.settings.title != blank -%}
          <h2 class="hp23-story__title">{{ section.settings.title }}</h2>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="hp23-story__text">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- if section.settings.btn_text != blank -%}
          <a href="{{ section.settings.btn_link | default: '#' }}" class="hp23-story__btn">
            {{ section.settings.btn_text | escape }}
          </a>
        {%- endif -%}
      </div>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "HP23 - Brutalist Story",
  "class": "section-hp23-brand-story",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1400
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Desktop Image Position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Box Border Radius",
      "default": 12
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "THE ORIGIN"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Heading",
      "default": "<p>NO SECRETS.<br>JUST <em>SCIENCE.</em></p>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Body Text",
      "default": "<p>We got tired of the beauty industry's endless promises and zero transparency. So we built something different. Formulations that don't hide behind pretty packaging.</p>"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "READ THE MANIFESTO"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Story Image"
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show Decorative Badge",
      "default": true
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 32,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 64
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Text Size",
      "default": 18
    },
    {
      "type": "header",
      "content": "Brutalist Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#F4F4F0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#39FF14",
      "info": "Try bright red, lime green, or bold yellow"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP23 - Brutalist Story"
    }
  ]
}
{% endschema %}
