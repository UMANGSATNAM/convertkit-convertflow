{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#1F0B18' }};
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }
  .hp55-faq__container { max-width: {{ section.settings.container_width | default: 800 }}px; margin: 0 auto; padding: 0 24px; }
  .hp55-faq__header { text-align: center; margin-bottom: 50px; }
  .hp55-faq__eyebrow { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: {{ section.settings.accent_color | default: '#C084FC' }}; margin: 0 0 12px; }
  .hp55-faq__heading { font-family: 'Playfair Display', serif; font-size: clamp(28px, 3.5vw, 42px); color: #FFFFFF; margin: 0; }
  .hp55-faq__item {
    background: {{ section.settings.card_bg | default: '#2A0E22' }};
    border: 1px solid rgba(233, 213, 255, 0.15);
    border-radius: 14px; margin-bottom: 14px; overflow: hidden;
    transition: border-color 0.3s ease;
  }
  .hp55-faq__item.active { border-color: rgba(192, 132, 252, 0.5); }
  .hp55-faq__question {
    width: 100%; background: none; border: none; padding: 20px 24px;
    display: flex; justify-content: space-between; align-items: center; cursor: pointer;
    font-family: 'Playfair Display', serif; font-size: 17px; color: #FFFFFF; text-align: left;
  }
  .hp55-faq__icon { font-size: 20px; color: {{ section.settings.accent_color | default: '#C084FC' }}; transition: transform 0.3s ease; flex-shrink: 0; margin-left: 16px; }
  .hp55-faq__item.active .hp55-faq__icon { transform: rotate(45deg); }
  .hp55-faq__answer { max-height: 0; overflow: hidden; transition: max-height 0.35s ease; }
  .hp55-faq__item.active .hp55-faq__answer { max-height: 300px; }
  .hp55-faq__answer-inner { padding: 0 24px 20px; font-size: 14px; line-height: 1.7; color: #E9D5FF; opacity: 0.9; }
{%- endstyle -%}
<div class="hp55-faq__container">
  <div class="hp55-faq__header">
    {%- if section.settings.eyebrow != blank -%}<p class="hp55-faq__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="hp55-faq__heading">{{ section.settings.heading | default: 'Royal Inquiries' }}</h2>
  </div>
  {%- for block in section.blocks -%}
    <div class="hp55-faq__item" {{ block.shopify_attributes }}>
      <button class="hp55-faq__question" onclick="this.parentElement.classList.toggle('active')">
        <span>{{ block.settings.question | default: 'How is the South Sea pearl nacre extracted?' }}</span>
        <span class="hp55-faq__icon">+</span>
      </button>
      <div class="hp55-faq__answer">
        <div class="hp55-faq__answer-inner">{{ block.settings.answer | default: 'We use a patented cold-ultrasonic micronization process that preserves 100% of the pearl conchiolin protein intact.' }}</div>
      </div>
    </div>
  {%- endfor -%}
</div>
{% schema %}
{
  "name": "HP55 FAQ",
  "class": "section-hp55-faq",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#1F0B18" },
    { "type": "color", "id": "card_bg", "label": "Card Background", "default": "#2A0E22" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#C084FC" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "✦ FAQ" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Royal Inquiries" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 600, "max": 1000, "step": 20, "unit": "px", "label": "Container Width", "default": 800 }
  ],
  "blocks": [{
    "type": "faq", "name": "Question",
    "settings": [
      { "type": "text", "id": "question", "label": "Question", "default": "How is South Sea pearl nacre extracted?" },
      { "type": "textarea", "id": "answer", "label": "Answer", "default": "We use a cold-ultrasonic micronization process that preserves conchiolin protein intact." }
    ]
  }],
  "presets": [{
    "name": "HP55 FAQ",
    "blocks": [
      { "type": "faq" },
      { "type": "faq", "settings": { "question": "Is this suitable for mature skin?", "answer": "Yes, our clinical trials showed 94% improvement in skin elasticity and firmness within 21 days." } },
      { "type": "faq", "settings": { "question": "Are the pearls ethically harvested?", "answer": "All pearls are sustainably cultured in protected South Sea marine reserves with zero harm to marine biomes." } }
    ]
  }]
}
{% endschema %}
