{%- liquid
  assign sec_id = section.id
-%}

<style>
  #shopify-section-{{ sec_id }} {
    background-color: {{ section.settings.bg_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px 0;
  }

  .hp20-testi-{{ sec_id }} {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 24px;
    text-align: center;
    position: relative;
  }

  .hp20-testi-{{ sec_id }}__quote-icon {
    font-family: Georgia, serif;
    font-size: 80px;
    color: {{ section.settings.text_color }};
    opacity: 0.1;
    line-height: 1;
    margin-bottom: -20px;
  }

  .hp20-testi-slider {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
    gap: 40px;
    padding-bottom: 20px;
  }
  .hp20-testi-slider::-webkit-scrollbar {
    display: none;
  }

  .hp20-testi-slide {
    flex: 0 0 100%;
    scroll-snap-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    opacity: 0.5;
    transition: opacity 0.4s ease;
  }

  .hp20-testi-slide.is-active {
    opacity: 1;
  }

  .hp20-testi-slide__text {
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-size: clamp(24px, 3.5vw, 40px);
    font-weight: 300;
    line-height: 1.3;
    color: {{ section.settings.text_color }};
    margin: 0 0 40px 0;
  }

  .hp20-testi-slide__author {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: {{ section.settings.text_color }};
  }

  .hp20-testi-nav {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-top: 40px;
  }

  .hp20-testi-nav__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: {{ section.settings.text_color }};
    opacity: 0.2;
    border: none;
    padding: 0;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .hp20-testi-nav__dot.is-active {
    opacity: 1;
    transform: scale(1.5);
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ sec_id }} {
      padding: {{ section.settings.padding_top_mobile }}px 0 {{ section.settings.padding_bottom_mobile }}px 0;
    }
  }
</style>

<section class="hp20-testi-{{ sec_id }}">
  <div class="hp20-testi-{{ sec_id }}__quote-icon">&ldquo;</div>
  
  <div class="hp20-testi-slider" id="hp20-testi-slider-{{ sec_id }}">
    {% for block in section.blocks %}
      <div class="hp20-testi-slide {% if forloop.first %}is-active{% endif %}" {{ block.shopify_attributes }}>
        <h3 class="hp20-testi-slide__text">{{ block.settings.text }}</h3>
        <div class="hp20-testi-slide__author">{{ block.settings.author }}</div>
      </div>
    {% endfor %}
  </div>

  <div class="hp20-testi-nav">
    {% for block in section.blocks %}
      <button class="hp20-testi-nav__dot {% if forloop.first %}is-active{% endif %}" aria-label="Go to slide {{ forloop.index }}"></button>
    {% endfor %}
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const slider = document.getElementById('hp20-testi-slider-{{ sec_id }}');
    if(!slider) return;
    const dots = slider.nextElementSibling.querySelectorAll('.hp20-testi-nav__dot');
    const slides = slider.querySelectorAll('.hp20-testi-slide');

    slider.addEventListener('scroll', () => {
      let index = Math.round(slider.scrollLeft / slider.offsetWidth);
      dots.forEach(d => d.classList.remove('is-active'));
      slides.forEach(s => s.classList.remove('is-active'));
      if(dots[index]) dots[index].classList.add('is-active');
      if(slides[index]) slides[index].classList.add('is-active');
    });

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        slider.scrollTo({ left: i * slider.offsetWidth, behavior: 'smooth' });
      });
    });
  });
</script>

{% schema %}
{
  "name": "HP20 Testimonials",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f9f9f9"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1a1a1a"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0, "max": 160, "step": 10, "unit": "px",
      "label": "Desktop Top Padding", "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0, "max": 160, "step": 10, "unit": "px",
      "label": "Desktop Bottom Padding", "default": 120
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0, "max": 100, "step": 10, "unit": "px",
      "label": "Mobile Top Padding", "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0, "max": 100, "step": 10, "unit": "px",
      "label": "Mobile Bottom Padding", "default": 60
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "Quote",
          "default": "An absolute masterclass in minimalist design. Every piece feels intentional and perfectly crafted."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Design Magazine"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP20 Testimonials",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" }
      ]
    }
  ]
}
{% endschema %}
