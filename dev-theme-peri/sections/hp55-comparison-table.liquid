{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#2A0E22' }};
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }
  .hp55-comp__container { max-width: {{ section.settings.container_width | default: 1000 }}px; margin: 0 auto; padding: 0 24px; }
  .hp55-comp__header { text-align: center; margin-bottom: 50px; }
  .hp55-comp__eyebrow { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: {{ section.settings.accent_color | default: '#C084FC' }}; margin: 0 0 12px; }
  .hp55-comp__heading { font-family: 'Playfair Display', serif; font-size: clamp(28px, 3.5vw, 42px); color: #FFFFFF; margin: 0; }
  .hp55-comp__table {
    width: 100%; border-collapse: collapse; background: {{ section.settings.card_bg | default: '#1F0B18' }};
    border-radius: 16px; overflow: hidden; border: 1px solid rgba(233, 213, 255, 0.2);
  }
  .hp55-comp__table th {
    background: #140510; color: #C084FC; font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 12px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase;
    padding: 18px 20px; text-align: left; border-bottom: 1px solid rgba(233, 213, 255, 0.2);
  }
  .hp55-comp__table td {
    padding: 16px 20px; font-size: 14px; color: #FDF4FF;
    border-bottom: 1px solid rgba(233, 213, 255, 0.1);
  }
  .hp55-comp__table tr:last-child td { border-bottom: none; }
  .hp55-comp__check { color: #C084FC; font-weight: 700; }
  @media screen and (max-width: 768px) {
    .hp55-comp__table { font-size: 13px; }
    .hp55-comp__table th, .hp55-comp__table td { padding: 12px 14px; }
  }
{%- endstyle -%}
<div class="hp55-comp__container">
  <div class="hp55-comp__header">
    {%- if section.settings.eyebrow != blank -%}<p class="hp55-comp__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="hp55-comp__heading">{{ section.settings.heading | default: 'The Pearl Standard' }}</h2>
  </div>
  <table class="hp55-comp__table">
    <thead>
      <tr>
        <th>{{ section.settings.col1_head | default: 'Attribute' }}</th>
        <th>{{ section.settings.col2_head | default: 'Royal Pearl' }}</th>
        <th>{{ section.settings.col3_head | default: 'Standard Luxury' }}</th>
      </tr>
    </thead>
    <tbody>
      {%- for block in section.blocks -%}
        <tr {{ block.shopify_attributes }}>
          <td>{{ block.settings.feature | default: 'Pearl Purity' }}</td>
          <td class="hp55-comp__check">{{ block.settings.us | default: '✦ Genuine South Sea Nacre' }}</td>
          <td style="color:#A855F7;opacity:0.6;">{{ block.settings.them | default: 'Mica / Mineral Glitter' }}</td>
        </tr>
      {%- endfor -%}
    </tbody>
  </table>
</div>
{% schema %}
{
  "name": "HP55 Compare",
  "class": "section-hp55-comp",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#2A0E22" },
    { "type": "color", "id": "card_bg", "label": "Table BG", "default": "#1F0B18" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#C084FC" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "✦ BENCHMARK" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Pearl Standard" },
    { "type": "text", "id": "col1_head", "label": "Column 1", "default": "Attribute" },
    { "type": "text", "id": "col2_head", "label": "Column 2", "default": "Royal Pearl" },
    { "type": "text", "id": "col3_head", "label": "Column 3", "default": "Standard Luxury" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 700, "max": 1200, "step": 20, "unit": "px", "label": "Container Width", "default": 1000 }
  ],
  "blocks": [{
    "type": "row", "name": "Row",
    "settings": [
      { "type": "text", "id": "feature", "label": "Feature", "default": "Pearl Purity" },
      { "type": "text", "id": "us", "label": "Us", "default": "✦ Genuine South Sea Nacre" },
      { "type": "text", "id": "them", "label": "Others", "default": "Mica / Mineral Glitter" }
    ]
  }],
  "presets": [{
    "name": "HP55 Compare",
    "blocks": [
      { "type": "row", "settings": { "feature": "Pearl Purity", "us": "✦ Genuine South Sea Nacre", "them": "Mica / Mineral Glitter" } },
      { "type": "row", "settings": { "feature": "Bio-Lipid Delivery", "us": "✦ Cold-Pressed Wild Plum", "them": "Mineral Oil Base" } },
      { "type": "row", "settings": { "feature": "Antioxidant Potency", "us": "✦ Black Orchid Phyto-Matrix", "them": "Standard Green Tea" } },
      { "type": "row", "settings": { "feature": "Cellular Longevity", "us": "✦ Proven +420% SIRT-1 Gene", "them": "No Genetic Testing" } }
    ]
  }]
}
{% endschema %}
