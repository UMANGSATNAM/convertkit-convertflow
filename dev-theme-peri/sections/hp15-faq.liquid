{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#ffffff'
  assign text_color = section.settings.text_color | default: '#000000'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 120px 40px;
    color: {{ text_color }};
  }
  
  .hp15-faq-container-{{ section_id }} {
    max-width: 800px;
    margin: 0 auto;
  }
  
  .hp15-faq-heading-{{ section_id }} {
    font-family: 'Didot', 'Playfair Display', serif;
    font-size: clamp(2.5rem, 4vw, 4rem);
    font-weight: normal;
    text-transform: uppercase;
    letter-spacing: 2px;
    text-align: center;
    margin: 0 0 60px 0;
  }
  
  .hp15-faq-list-{{ section_id }} {
    display: flex;
    flex-direction: column;
    border-top: 1px solid {{ text_color }};
  }
  
  .hp15-faq-item-{{ section_id }} {
    border-bottom: 1px solid {{ text_color }};
  }
  
  .hp15-faq-question-{{ section_id }} {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 25px 0;
    background: transparent;
    border: none;
    color: {{ text_color }};
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    cursor: pointer;
    text-align: left;
    outline: none;
  }
  
  .hp15-faq-icon-{{ section_id }} {
    font-size: 1.5rem;
    font-weight: 300;
    transition: transform 0.3s ease;
  }
  
  .hp15-faq-item-{{ section_id }}.is-active .hp15-faq-icon-{{ section_id }} {
    transform: rotate(45deg);
  }
  
  .hp15-faq-answer-{{ section_id }} {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease, padding 0.3s ease;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.95rem;
    line-height: 1.6;
    opacity: 0.7;
    padding: 0;
  }
  
  .hp15-faq-item-{{ section_id }}.is-active .hp15-faq-answer-{{ section_id }} {
    max-height: 500px;
    padding: 0 0 30px 0;
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 60px 20px;
    }
  }
</style>

<div class="hp15-faq-container-{{ section_id }}">
  <h2 class="hp15-faq-heading-{{ section_id }}">CLIENT SERVICES</h2>
  
  <div class="hp15-faq-list-{{ section_id }}">
    {% for block in section.blocks %}
      <div class="hp15-faq-item-{{ section_id }}" {{ block.shopify_attributes }}>
        <button class="hp15-faq-question-{{ section_id }}" onclick="this.parentElement.classList.toggle('is-active')">
          {{ block.settings.question | default: 'DO YOU OFFER INTERNATIONAL SHIPPING?' }}
          <span class="hp15-faq-icon-{{ section_id }}">+</span>
        </button>
        <div class="hp15-faq-answer-{{ section_id }}">
          {{ block.settings.answer | default: 'Yes, we ship globally via express courier. All duties and taxes are calculated at checkout.' }}
        </div>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "HP15 FAQ",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "DO YOU OFFER INTERNATIONAL SHIPPING?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "Yes, we ship globally via express courier. All duties and taxes are calculated at checkout."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP15 FAQ",
      "blocks": [
        { "type": "faq", "settings": { "question": "DO YOU OFFER INTERNATIONAL SHIPPING?", "answer": "Yes, we ship globally via express courier. All duties and taxes are calculated at checkout." } },
        { "type": "faq", "settings": { "question": "WHAT IS YOUR RETURN POLICY?", "answer": "We accept returns within 14 days of delivery for all unworn items in original condition." } },
        { "type": "faq", "settings": { "question": "HOW CAN I BOOK A PRIVATE APPOINTMENT?", "answer": "Private fittings can be arranged at our Paris or New York flagships. Please contact concierge." } }
      ]
    }
  ]
}
{% endschema %}
