{%- liquid
  assign sec_id = section.id
  assign bg_color = section.settings.bg_color
  assign text_color = section.settings.text_color
  assign speed = section.settings.speed
  assign text_size = section.settings.text_size
-%}

<style>
  #shopify-section-{{ sec_id }} {
    background-color: {{ bg_color }};
    padding: {{ section.settings.padding_y }}px 0;
    overflow: hidden;
  }

  .hp20-marquee-{{ sec_id }} {
    display: flex;
    white-space: nowrap;
    overflow: hidden;
    position: relative;
    width: 100vw;
    left: 50%;
    transform: translateX(-50%);
  }

  .hp20-marquee-{{ sec_id }}__track {
    display: flex;
    animation: hp20Marquee {{ speed }}s linear infinite;
  }

  .hp20-marquee-{{ sec_id }}__item {
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-size: {{ text_size }}px;
    font-weight: 500;
    color: {{ text_color }};
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0 40px;
    display: flex;
    align-items: center;
  }

  .hp20-marquee-{{ sec_id }}__separator {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: {{ text_color }};
    margin: 0 40px;
    opacity: 0.3;
  }

  @keyframes hp20Marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ sec_id }} {
      padding: {{ section.settings.padding_y_mobile }}px 0;
    }
    .hp20-marquee-{{ sec_id }}__item {
      font-size: {{ text_size | times: 0.6 | round }}px;
      padding: 0 20px;
    }
    .hp20-marquee-{{ sec_id }}__separator {
      margin: 0 20px;
    }
  }
</style>

<section class="hp20-marquee-{{ sec_id }}">
  <div class="hp20-marquee-{{ sec_id }}__track">
    {%- capture marquee_content -%}
      {% for block in section.blocks %}
        <div class="hp20-marquee-{{ sec_id }}__item" {{ block.shopify_attributes }}>
          {{ block.settings.text }}
          {% unless forloop.last and section.blocks.size == 1 %}
            <span class="hp20-marquee-{{ sec_id }}__separator"></span>
          {% endunless %}
        </div>
      {% endfor %}
    {%- endcapture -%}
    
    <!-- Repeat content for seamless loop -->
    {{ marquee_content }}
    {{ marquee_content }}
    {{ marquee_content }}
    {{ marquee_content }}
  </div>
</section>

{% schema %}
{
  "name": "HP20 Marquee",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 5,
      "max": 60,
      "step": 1,
      "unit": "s",
      "label": "Animation Speed",
      "default": 20
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 12,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Desktop Text Size",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_y",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Desktop Vertical Padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_y_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Mobile Vertical Padding",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free Shipping on Orders Over $100"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP20 Marquee",
      "blocks": [
        { "type": "text" },
        { "type": "text" },
        { "type": "text" }
      ]
    }
  ]
}
{% endschema %}
