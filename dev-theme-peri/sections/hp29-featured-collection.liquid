{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@300;400;500&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    
    --font-heading: 'Lora', serif;
    --font-body: 'Inter', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    position: relative;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.8 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.8 | round }}px;
    }
  }

  .hp29-feat-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp29-feat-wrapper {
      padding: 0 20px;
    }
  }

  .hp29-feat__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 50px;
  }

  @media screen and (max-width: 768px) {
    .hp29-feat__header {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }
  }

  .hp29-feat__title-area {
    max-width: 600px;
  }

  .hp29-feat__title {
    font-family: var(--font-heading);
    font-size: clamp(28px, 4vw, {{ section.settings.title_size }}px);
    font-weight: 400;
    color: var(--text-color);
    margin: 0 0 15px;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  
  .hp29-feat__title em {
    font-style: italic;
    color: var(--accent-color);
  }

  .hp29-feat__subtitle {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 300;
    color: var(--text-color);
    opacity: 0.7;
    margin: 0;
  }

  .hp29-feat__view-all {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 500;
    color: var(--text-color);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding-bottom: 4px;
    border-bottom: 1px solid var(--accent-color);
    transition: all 0.3s ease;
  }

  .hp29-feat__view-all svg {
    width: 16px; height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    transition: transform 0.3s ease;
  }

  .hp29-feat__view-all:hover {
    color: var(--accent-color);
  }
  .hp29-feat__view-all:hover svg {
    transform: translateX(5px);
  }

  .hp29-feat__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: 40px 30px;
  }

  @media screen and (max-width: 992px) {
    .hp29-feat__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 576px) {
    .hp29-feat__grid {
      grid-template-columns: 1fr;
    }
  }

  .hp29-feat__item {
    text-decoration: none;
    display: flex;
    flex-direction: column;
    group: item;
  }

  .hp29-feat__image-wrapper {
    position: relative;
    aspect-ratio: {{ section.settings.image_ratio }};
    border-radius: 20px;
    overflow: hidden;
    margin-bottom: 25px;
    background: rgba(0,0,0,0.03);
  }

  .hp29-feat__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .hp29-feat__image--hover {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.5s ease, transform 0.8s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .hp29-feat__item:hover .hp29-feat__image {
    transform: scale(1.03);
  }

  .hp29-feat__item:hover .hp29-feat__image--hover {
    opacity: 1;
    transform: scale(1.03);
  }

  .hp29-feat__content {
    text-align: center;
  }

  .hp29-feat__product-title {
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 400;
    font-style: italic;
    color: var(--text-color);
    margin: 0 0 10px;
  }

  .hp29-feat__product-price {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 400;
    color: var(--text-color);
    opacity: 0.7;
    margin: 0;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp29-feat-wrapper" id="HP29Feat-{{ section.id }}">
  
  <div class="hp29-feat__header">
    <div class="hp29-feat__title-area">
      {%- if section.settings.title != blank -%}
        <h2 class="hp29-feat__title">{{ section.settings.title }}</h2>
      {%- endif -%}
      {%- if section.settings.subtitle != blank -%}
        <p class="hp29-feat__subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>
    
    {%- if section.settings.btn_text != blank -%}
      <a href="{{ section.settings.collection.url | default: '#' }}" class="hp29-feat__view-all">
        {{ section.settings.btn_text }}
        <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    {%- endif -%}
  </div>

  <div class="hp29-feat__grid">
    {%- if section.settings.collection != blank and section.settings.collection.products_count > 0 -%}
      {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
        <a href="{{ product.url }}" class="hp29-feat__item">
          <div class="hp29-feat__image-wrapper">
            <img height="{{ product.featured_image.height }}" width="{{ product.featured_image.width }}" src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" class="hp29-feat__image" loading="lazy">
            {%- if product.images[1] != blank -%}
              <img height="{{ product.images[1].height }}" width="{{ product.images[1].width }}" src="{{ product.images[1] | image_url: width: 600 }}" alt="{{ product.title | escape }}" class="hp29-feat__image--hover" loading="lazy">
            {%- endif -%}
          </div>
          <div class="hp29-feat__content">
            <h3 class="hp29-feat__product-title">{{ product.title }}</h3>
            <div class="hp29-feat__product-price">
              {{ product.price | money }}
            </div>
          </div>
        </a>
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..section.settings.products_to_show) -%}
        <a href="#" class="hp29-feat__item">
          <div class="hp29-feat__image-wrapper">
            {{ 'product-' | append: i | placeholder_svg_tag: 'hp29-feat__image' }}
          </div>
          <div class="hp29-feat__content">
            <h3 class="hp29-feat__product-title">Organic Linen Shirt {{ i }}</h3>
            <div class="hp29-feat__product-price">$85.00</div>
          </div>
        </a>
      {%- endfor -%}
    {%- endif -%}
  </div>

</div>

{% schema %}
{
  "name": "HP29 - Boho Featured",
  "class": "section-hp29-featured-collection",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Heading",
      "default": "New Arrivals for <em>Spring</em>"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Breathe life into your wardrobe with our latest organic collection."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Products to Show",
      "default": 4
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "Explore Collection"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1400
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Columns (Desktop)",
      "default": 4
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image Ratio",
      "options": [
        { "value": "1/1", "label": "Square (1:1)" },
        { "value": "3/4", "label": "Portrait (3:4)" },
        { "value": "4/5", "label": "Vertical (4:5)" }
      ],
      "default": "3/4"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 42
    },
    {
      "type": "header",
      "content": "Earthy Boho Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (Beige/Sand)",
      "default": "#F4F1DE"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text (Charcoal)",
      "default": "#3D405B"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent (Terracotta)",
      "default": "#E07A5F"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP29 - Boho Featured"
    }
  ]
}
{% endschema %}
