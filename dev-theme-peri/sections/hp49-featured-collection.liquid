{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp49-fc-bg: {{ section.settings.bg_color | default: '#F5F3FF' }};
    --hp49-fc-card: {{ section.settings.card_bg | default: '#FFFFFF' }};
    --hp49-fc-title: {{ section.settings.title_color | default: '#2E1065' }};
    --hp49-accent: {{ section.settings.accent_color | default: '#7C3AED' }};
    
    background-color: var(--hp49-fc-bg);
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
  }

  .hp49-fc__wrapper {
    max-width: {{ section.settings.container_width | default: 1280 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp49-fc__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 40px;
  }

  .hp49-fc__heading {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: clamp(30px, 4vw, 42px);
    font-weight: 800;
    color: var(--hp49-fc-title);
    margin: 0;
  }

  .hp49-fc__view-all {
    color: var(--hp49-accent);
    font-size: 14px;
    font-weight: 800;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .hp49-fc__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: 4 }}, 1fr);
    gap: 24px;
  }

  .hp49-card {
    background: var(--hp49-fc-card);
    border: 1px solid rgba(124, 58, 237, 0.15);
    border-radius: 28px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 10px 30px rgba(124, 58, 237, 0.06);
    transition: all 0.3s ease;
  }

  .hp49-card:hover {
    border-color: var(--hp49-accent);
    transform: translateY(-6px);
    box-shadow: 0 18px 45px rgba(124, 58, 237, 0.16);
  }

  .hp49-card__media {
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    position: relative;
    background: #EDE9FE;
  }

  .hp49-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .hp49-card:hover .hp49-card__img { transform: scale(1.05); }

  .hp49-card__badge {
    position: absolute;
    top: 12px; left: 12px;
    background: #7C3AED;
    color: #FFFFFF;
    font-size: 11px;
    font-weight: 800;
    padding: 4px 12px;
    border-radius: 50px;
  }

  .hp49-card__body {
    padding: 22px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .hp49-card__tag {
    font-size: 11px;
    font-weight: 800;
    color: var(--hp49-accent);
    text-transform: uppercase;
    margin: 0 0 6px;
  }

  .hp49-card__title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 17px;
    font-weight: 800;
    color: var(--hp49-fc-title);
    margin: 0 0 8px;
  }

  .hp49-card__price {
    font-size: 16px;
    font-weight: 800;
    color: var(--hp49-accent);
    margin-bottom: 16px;
  }

  .hp49-card__btn {
    width: 100%;
    margin-top: auto;
    padding: 13px;
    background: #7C3AED;
    color: #FFFFFF;
    border: none;
    border-radius: 50px;
    font-family: 'Urbanist', sans-serif;
    font-size: 13px;
    font-weight: 800;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .hp49-card__btn:hover { background: #6D28D9; }

  @media screen and (max-width: 992px) {
    .hp49-fc__grid { grid-template-columns: repeat(2, 1fr); gap: 16px; }
  }
{%- endstyle -%}

<div class="hp49-fc__wrapper">
  <div class="hp49-fc__header">
    <h2 class="hp49-fc__heading">{{ section.settings.heading | default: 'The Lavender Cloud Collection' }}</h2>
    <a href="{{ section.settings.view_all_url | default: '/collections/all' }}" class="hp49-fc__view-all">
      {{ section.settings.view_all_text | default: 'View All Dream Care &rarr;' }}
    </a>
  </div>

  <div class="hp49-fc__grid">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <div class="hp49-card" {{ block.shopify_attributes }}>
          <div class="hp49-card__media">
            {%- if block.settings.badge != blank -%}
              <span class="hp49-card__badge">{{ block.settings.badge }}</span>
            {%- endif -%}
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 600 }}" class="hp49-card__img" alt="{{ block.settings.title }}" loading="lazy">
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'hp49-card__img' }}
            {%- endif -%}
          </div>
          <div class="hp49-card__body">
            <span class="hp49-card__tag">{{ block.settings.tag | default: 'CALMING RITUAL' }}</span>
            <h3 class="hp49-card__title">{{ block.settings.title }}</h3>
            <div class="hp49-card__price">{{ block.settings.price | default: '$54.00 USD' }}</div>
            <button class="hp49-card__btn">{{ block.settings.btn_text | default: 'Add to Cloud Bag' }}</button>
          </div>
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="hp49-card">
        <div class="hp49-card__media">
          <span class="hp49-card__badge">Bestseller</span>
          {{ 'product-1' | placeholder_svg_tag: 'hp49-card__img' }}
        </div>
        <div class="hp49-card__body">
          <span class="hp49-card__tag">CALMING BARRIER</span>
          <h3 class="hp49-card__title">Alpine Lavender Cloud Recovery Serum</h3>
          <div class="hp49-card__price">$54.00 USD</div>
          <button class="hp49-card__btn">Add to Cloud Bag</button>
        </div>
      </div>
      <div class="hp49-card">
        <div class="hp49-card__media">
          <span class="hp49-card__badge">Soft Blossom</span>
          {{ 'product-1' | placeholder_svg_tag: 'hp49-card__img' }}
        </div>
        <div class="hp49-card__body">
          <span class="hp49-card__tag">HYDROSOL MIST</span>
          <h3 class="hp49-card__title">Cherry Blossom Petal Moisture Mist</h3>
          <div class="hp49-card__price">$42.00 USD</div>
          <button class="hp49-card__btn">Add to Cloud Bag</button>
        </div>
      </div>
      <div class="hp49-card">
        <div class="hp49-card__media">
          {{ 'product-1' | placeholder_svg_tag: 'hp49-card__img' }}
        </div>
        <div class="hp49-card__body">
          <span class="hp49-card__tag">CUSHION CREME</span>
          <h3 class="hp49-card__title">Velvet Lilac Night Pillow Sleeping Mask</h3>
          <div class="hp49-card__price">$62.00 USD</div>
          <button class="hp49-card__btn">Add to Cloud Bag</button>
        </div>
      </div>
      <div class="hp49-card">
        <div class="hp49-card__media">
          <span class="hp49-card__badge">Hydra Glow</span>
          {{ 'product-1' | placeholder_svg_tag: 'hp49-card__img' }}
        </div>
        <div class="hp49-card__body">
          <span class="hp49-card__tag">LIPID BALM</span>
          <h3 class="hp49-card__title">Pastel Lavender Melt-In Cleansing Balm</h3>
          <div class="hp49-card__price">$48.00 USD</div>
          <button class="hp49-card__btn">Add to Cloud Bag</button>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP49 - Lavender Grid",
  "class": "section-hp49-grid",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#F5F3FF" },
    { "type": "color", "id": "card_bg", "label": "Card Background", "default": "#FFFFFF" },
    { "type": "color", "id": "title_color", "label": "Title Color", "default": "#2E1065" },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#7C3AED" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Lavender Cloud Collection" },
    { "type": "text", "id": "view_all_text", "label": "View All Text", "default": "View All Dream Care →" },
    { "type": "url", "id": "view_all_url", "label": "View All URL" },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "label": "Desktop Columns", "default": 4 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 80 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "badge", "label": "Badge", "default": "Bestseller" },
        { "type": "text", "id": "tag", "label": "Tag", "default": "CALMING RITUAL" },
        { "type": "text", "id": "title", "label": "Title", "default": "Alpine Lavender Cloud Recovery Serum" },
        { "type": "text", "id": "price", "label": "Price", "default": "$54.00 USD" },
        { "type": "text", "id": "btn_text", "label": "Button Label", "default": "Add to Cloud Bag" },
        { "type": "url", "id": "url", "label": "Product Link" }
      ]
    }
  ],
  "presets": [
    { "name": "HP49 - Lavender Grid" }
  ]
}
{% endschema %}
