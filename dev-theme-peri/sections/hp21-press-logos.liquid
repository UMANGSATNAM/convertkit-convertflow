{%- style -%}
  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --border-color: {{ section.settings.border_color }};
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    border-top: 1px solid var(--border-color);
    border-bottom: 1px solid var(--border-color);
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }

  .hp21-press-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
    overflow: hidden;
  }

  @media screen and (max-width: 768px) {
    .hp21-press-wrapper {
      padding: 0 20px;
    }
  }

  .hp21-press__title {
    font-family: 'Jost', sans-serif;
    font-size: 12px;
    font-weight: 300;
    color: {{ section.settings.text_color }};
    text-transform: uppercase;
    letter-spacing: 4px;
    text-align: center;
    margin: 0 0 40px;
    opacity: 0.6;
  }

  .hp21-press__grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: {{ section.settings.gap }}px;
  }

  .hp21-press__item {
    flex: 0 0 calc({{ 100.0 | divided_by: section.settings.desktop_columns }}% - {{ section.settings.gap }}px);
    max-width: {{ section.settings.logo_max_width }}px;
    display: flex;
    justify-content: center;
    align-items: center;
    transition: opacity 0.4s ease;
  }

  .hp21-press__item:hover {
    opacity: 1 !important; /* Override inline opacity if used */
  }
  
  /* Applying a general opacity to logos unless hovered, for subtlety in luxury design */
  .hp21-press__item {
    opacity: {{ section.settings.logo_opacity | divided_by: 100.0 }};
  }

  @media screen and (max-width: 992px) {
    .hp21-press__item {
      flex: 0 0 calc({{ 100.0 | divided_by: section.settings.tablet_columns }}% - {{ section.settings.gap }}px);
    }
  }

  @media screen and (max-width: 768px) {
    .hp21-press__item {
      flex: 0 0 calc({{ 100.0 | divided_by: section.settings.mobile_columns }}% - {{ section.settings.gap }}px);
      max-width: {{ section.settings.logo_max_width | times: 0.8 | round }}px;
    }
  }

  .hp21-press__item img {
    max-width: 100%;
    height: auto;
    /* In dark mode luxury, white logos look best. If original logo is black, invert it. */
    filter: {% if section.settings.invert_logos %}invert(1){% else %}none{% endif %};
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp21-press-wrapper" id="HP21Press-{{ section.id }}">
  
  {%- if section.settings.title != blank -%}
    <h3 class="hp21-press__title">{{ section.settings.title | escape }}</h3>
  {%- endif -%}

  <div class="hp21-press__grid">
    {%- for block in section.blocks -%}
      <div class="hp21-press__item" {{ block.shopify_attributes }}>
        {%- if block.settings.logo != blank -%}
          <img src="{{ block.settings.logo | image_url: width: 300 }}" alt="{{ block.settings.logo.alt | default: 'Press Logo' | escape }}" loading="lazy">
        {%- else -%}
          <div style="font-family:'Playfair Display',serif; font-size:24px; color:#fff; font-style:italic;">Publication</div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>

</div>

{% schema %}
{
  "name": "HP21 - Luxury Press",
  "class": "section-hp21-press-logos",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "AS FEATURED IN"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 800,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1200
    },
    {
      "type": "range",
      "id": "desktop_columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Desktop Columns",
      "default": 4
    },
    {
      "type": "range",
      "id": "tablet_columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Tablet Columns",
      "default": 3
    },
    {
      "type": "range",
      "id": "mobile_columns",
      "min": 1,
      "max": 3,
      "step": 1,
      "label": "Mobile Columns",
      "default": 2
    },
    {
      "type": "range",
      "id": "gap",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Gap between logos",
      "default": 60
    },
    {
      "type": "header",
      "content": "Logo Styling"
    },
    {
      "type": "range",
      "id": "logo_max_width",
      "min": 50,
      "max": 300,
      "step": 10,
      "unit": "px",
      "label": "Logo Max Width",
      "default": 150
    },
    {
      "type": "range",
      "id": "logo_opacity",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Default Logo Opacity",
      "info": "Opacity returns to 100% on hover",
      "default": 50
    },
    {
      "type": "checkbox",
      "id": "invert_logos",
      "label": "Invert Logos (Make Black to White)",
      "default": true
    },
    {
      "type": "header",
      "content": "Luxury Styling"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#0A0A0A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Top/Bottom Border Color",
      "default": "rgba(255, 255, 255, 0.05)"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 60
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Press Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP21 - Luxury Press",
      "blocks": [
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" }
      ]
    }
  ]
}
{% endschema %}
