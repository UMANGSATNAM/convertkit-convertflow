{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp48-usp-bg: {{ section.settings.bg_color | default: '#FAF8F5' }};
    --hp48-card-bg: {{ section.settings.card_bg | default: '#FFFFFF' }};
    --hp48-gold: {{ section.settings.accent_gold | default: '#C59B27' }};
    --hp48-title: {{ section.settings.title_color | default: '#1A1715' }};
    
    background-color: var(--hp48-usp-bg);
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
  }

  .hp48-usp__grid {
    max-width: {{ section.settings.container_width | default: 1280 }}px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: 4 }}, 1fr);
    gap: 24px;
  }

  .hp48-usp__card {
    background: var(--hp48-card-bg);
    border: 1px solid rgba(197, 155, 39, 0.3);
    border-radius: 8px;
    padding: 36px 24px;
    text-align: center;
    box-shadow: 0 10px 30px rgba(26, 23, 21, 0.04);
    transition: all 0.3s ease;
  }

  .hp48-usp__card:hover {
    border-color: var(--hp48-gold);
    transform: translateY(-4px);
    box-shadow: 0 15px 40px rgba(197, 155, 39, 0.15);
  }

  .hp48-usp__icon {
    font-size: 28px;
    margin-bottom: 16px;
    color: var(--hp48-gold);
  }

  .hp48-usp__title {
    font-family: 'Cinzel', serif;
    font-size: 17px;
    font-weight: 700;
    color: var(--hp48-title);
    margin: 0 0 10px;
    letter-spacing: 0.5px;
  }

  .hp48-usp__desc {
    font-size: 13px;
    line-height: 1.7;
    color: #5C554E;
    margin: 0;
  }

  @media screen and (max-width: 992px) {
    .hp48-usp__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media screen and (max-width: 576px) {
    .hp48-usp__grid { grid-template-columns: 1fr; }
  }
{%- endstyle -%}

<div class="hp48-usp__grid">
  {%- if section.blocks.size > 0 -%}
    {%- for block in section.blocks -%}
      <div class="hp48-usp__card" {{ block.shopify_attributes }}>
        <div class="hp48-usp__icon">{{ block.settings.icon | default: '👑' }}</div>
        <h3 class="hp48-usp__title">{{ block.settings.title }}</h3>
        <p class="hp48-usp__desc">{{ block.settings.description }}</p>
      </div>
    {%- endfor -%}
  {%- else -%}
    <div class="hp48-usp__card">
      <div class="hp48-usp__icon">👑</div>
      <h3 class="hp48-usp__title">24K Colloidal Gold</h3>
      <p class="hp48-usp__desc">Infuses cellular micro-current vitality to diminish deep expression contours.</p>
    </div>
    <div class="hp48-usp__card">
      <div class="hp48-usp__icon">🦪</div>
      <h3 class="hp48-usp__title">Imperial Pearl Nectar</h3>
      <p class="hp48-usp__desc">Hydrolyzed conchiolin protein delivers luminous porcelain translucence.</p>
    </div>
    <div class="hp48-usp__card">
      <div class="hp48-usp__icon">✈️</div>
      <h3 class="hp48-usp__title">White-Glove DDP Air</h3>
      <p class="hp48-usp__desc">Direct diplomatic-tier air clearance with all border tariffs pre-paid.</p>
    </div>
    <div class="hp48-usp__card">
      <div class="hp48-usp__icon">🛡️</div>
      <h3 class="hp48-usp__title">Sovereign Warranty</h3>
      <p class="hp48-usp__desc">Complete satisfaction guaranteed with personal concierges on standby.</p>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "HP48 - Royal Pillars",
  "class": "section-hp48-usp",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#FAF8F5" },
    { "type": "color", "id": "card_bg", "label": "Card Background", "default": "#FFFFFF" },
    { "type": "color", "id": "accent_gold", "label": "Gold Accent", "default": "#C59B27" },
    { "type": "color", "id": "title_color", "label": "Title Color", "default": "#1A1715" },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "label": "Desktop Columns", "default": 4 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 80 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar Card",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon", "default": "👑" },
        { "type": "text", "id": "title", "label": "Title", "default": "24K Colloidal Gold" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Infuses cellular micro-current vitality." }
      ]
    }
  ],
  "presets": [
    { "name": "HP48 - Royal Pillars" }
  ]
}
{% endschema %}
