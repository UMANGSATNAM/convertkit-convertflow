{%- liquid
  assign bg_color = section.settings.bg_color | default: '#f4f7f9'
  assign text_color = section.settings.text_color | default: '#1a2a3a'
  assign accent_color = section.settings.accent_color | default: '#0066cc'
  
  assign padding_top_desktop = section.settings.padding_top_desktop
  assign padding_bottom_desktop = section.settings.padding_bottom_desktop
  assign padding_top_mobile = section.settings.padding_top_mobile
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile
-%}

<style>
  #shopify-section-{{ section.id }} {
    --hp5-pills-bg: {{ bg_color }};
    --hp5-pills-text: {{ text_color }};
    --hp5-pills-accent: {{ accent_color }};
    
    --hp5-pills-pt-desk: {{ padding_top_desktop }}px;
    --hp5-pills-pb-desk: {{ padding_bottom_desktop }}px;
    --hp5-pills-pt-mob: {{ padding_top_mobile }}px;
    --hp5-pills-pb-mob: {{ padding_bottom_mobile }}px;
  }

  .hp5-health-pills-{{ section.id }} {
    padding-top: var(--hp5-pills-pt-desk);
    padding-bottom: var(--hp5-pills-pb-desk);
    background-color: var(--hp5-pills-bg);
    color: var(--hp5-pills-text);
    font-family: 'Inter', sans-serif;
  }

  .hp5-pills-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
    text-align: center;
  }

  .hp5-pills-title {
    font-size: clamp(28px, 3vw, 36px);
    font-weight: 700;
    margin: 0 0 40px 0;
    letter-spacing: -0.5px;
  }

  .hp5-pills-track {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 15px;
  }

  .hp5-pill-item {
    background: #ffffff;
    border: 1px solid rgba(26,42,58,0.1);
    color: var(--hp5-pills-text);
    text-decoration: none;
    padding: 12px 24px;
    border-radius: 50px;
    font-size: 15px;
    font-weight: 600;
    transition: all 0.3s ease;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    box-shadow: 0 2px 5px rgba(0,0,0,0.02);
  }

  .hp5-pill-item:hover {
    background: var(--hp5-pills-accent);
    color: #ffffff;
    border-color: var(--hp5-pills-accent);
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(0, 102, 204, 0.2);
  }

  /* Optional icon dot */
  .hp5-pill-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--hp5-pills-accent);
    transition: background 0.3s ease;
  }
  .hp5-pill-item:hover .hp5-pill-dot {
    background: #ffffff;
  }

  @media screen and (max-width: 768px) {
    .hp5-health-pills-{{ section.id }} {
      padding-top: var(--hp5-pills-pt-mob);
      padding-bottom: var(--hp5-pills-pb-mob);
    }
    .hp5-pills-inner {
      padding: 0 20px;
    }
    .hp5-pills-track {
      gap: 10px;
    }
    .hp5-pill-item {
      font-size: 14px;
      padding: 10px 20px;
    }
  }
</style>

<section class="hp5-health-pills-{{ section.id }}" aria-label="Shop by Goal">
  <div class="hp5-pills-inner">
    
    {%- if section.settings.title != blank -%}
      <h2 class="hp5-pills-title">{{ section.settings.title }}</h2>
    {%- endif -%}

    <div class="hp5-pills-track">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link | default: '#' }}" class="hp5-pill-item" {{ block.shopify_attributes }}>
          <span class="hp5-pill-dot"></span>
          {{ block.settings.title }}
        </a>
      {%- endfor -%}

      {%- if section.blocks.size == 0 -%}
        {%- assign defaults = "Immunity,Gut Health,Sleep & Stress,Energy,Brain Focus,Joint Support" | split: "," -%}
        {%- for d in defaults -%}
          <a href="#" class="hp5-pill-item">
            <span class="hp5-pill-dot"></span>
            {{ d }}
          </a>
        {%- endfor -%}
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "HP5 Health Category Pills",
  "tag": "section",
  "class": "section-hp5-category-pills",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Shop by Health Goal"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f4f7f9"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1a2a3a"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Hover/Accent Color",
      "default": "#0066cc"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Top (Desktop)", "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Bottom (Desktop)", "default": 60
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Top (Mobile)", "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Bottom (Mobile)", "default": 40
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Label",
          "default": "Gut Health"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP5 Health Category Pills",
      "category": "Collection",
      "blocks": [
        { "type": "category", "settings": { "title": "Immunity" } },
        { "type": "category", "settings": { "title": "Gut Health" } },
        { "type": "category", "settings": { "title": "Sleep & Stress" } },
        { "type": "category", "settings": { "title": "Energy" } },
        { "type": "category", "settings": { "title": "Focus" } }
      ]
    }
  ]
}
{% endschema %}
