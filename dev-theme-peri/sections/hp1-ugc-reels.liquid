{%- liquid
  assign bg_color = section.settings.bg_color | default: '#ffffff'
  assign text_color = section.settings.text_color | default: '#2c2c2c'
-%}

<section class="hp1-beauty-ugc" style="background-color: {{ bg_color }}; color: {{ text_color }};" id="hp1-ugc-{{ section.id }}">
  <div class="hp1-ugc-inner">
    
    <div class="hp1-section-header">
      {%- if section.settings.subheading != blank -%}
        <span class="hp1-section-subheading">{{ section.settings.subheading }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="hp1-section-heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>

    <div class="hp1-ugc-grid">
      {%- for block in section.blocks -%}
        <div class="hp1-ugc-item" {{ block.shopify_attributes }}>
          <div class="hp1-ugc-thumbnail">
            {%- if block.settings.image != blank -%}
              <img height="{{ block.settings.image.height }}" width="{{ block.settings.image.width }}" src="{{ block.settings.image | image_url: width: 600 }}" alt="" class="hp1-ugc-img" loading="lazy">
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'hp1-ugc-img placeholder-svg' }}
            {%- endif -%}
            
            <div class="hp1-ugc-overlay">
              <div class="hp1-play-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M8 5v14l11-7z" fill="currentColor"/>
                </svg>
              </div>
            </div>
            
            {%- if block.settings.product != blank -%}
              {%- assign ugc_product = all_products[block.settings.product] -%}
              <a href="{{ ugc_product.url }}" class="hp1-ugc-product-tag">
                <img src="{{ ugc_product.featured_image | image_url: width: 60 }}" alt="" width="30" height="30">
                <span class="hp1-ugc-product-title">{{ ugc_product.title }}</span>
              </a>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>

  </div>
</section>

<style>
  .hp1-beauty-ugc {
    padding: 80px 0;
    font-family: 'Inter', sans-serif;
  }
  .hp1-ugc-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }
  .hp1-section-header {
    text-align: center;
    margin-bottom: 50px;
  }
  .hp1-section-subheading {
    display: block;
    font-size: 13px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #8a7a6c;
    margin-bottom: 10px;
  }
  .hp1-section-heading {
    font-family: 'Playfair Display', serif;
    font-size: clamp(28px, 4vw, 40px);
    font-weight: 400;
    margin: 0;
  }
  
  .hp1-ugc-grid {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding-bottom: 20px;
  }
  .hp1-ugc-grid::-webkit-scrollbar {
    display: none;
  }
  .hp1-ugc-item {
    flex: 0 0 calc(25% - 15px);
    scroll-snap-align: start;
  }
  .hp1-ugc-thumbnail {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    aspect-ratio: 9/16;
    cursor: pointer;
  }
  .hp1-ugc-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .hp1-ugc-thumbnail:hover .hp1-ugc-img {
    transform: scale(1.05);
  }
  .hp1-ugc-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0,0,0,0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.3s ease;
  }
  .hp1-ugc-thumbnail:hover .hp1-ugc-overlay {
    background: rgba(0,0,0,0.4);
  }
  .hp1-play-icon {
    width: 60px; height: 60px;
    background: rgba(255,255,255,0.3);
    backdrop-filter: blur(4px);
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    color: #fff;
    transition: transform 0.3s ease;
  }
  .hp1-ugc-thumbnail:hover .hp1-play-icon {
    transform: scale(1.1);
  }
  
  .hp1-ugc-product-tag {
    position: absolute;
    bottom: 20px;
    left: 20px;
    right: 20px;
    background: rgba(255,255,255,0.95);
    border-radius: 8px;
    padding: 8px;
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: #2c2c2c;
    transform: translateY(10px);
    opacity: 0;
    transition: all 0.3s ease;
  }
  .hp1-ugc-thumbnail:hover .hp1-ugc-product-tag {
    transform: translateY(0);
    opacity: 1;
  }
  .hp1-ugc-product-tag img {
    border-radius: 4px;
  }
  .hp1-ugc-product-title {
    font-size: 12px;
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (max-width: 991px) {
    .hp1-ugc-item { flex: 0 0 calc(33.333% - 13.33px); }
  }
  @media (max-width: 767px) {
    .hp1-beauty-ugc { padding: 50px 0; }
    .hp1-ugc-item { flex: 0 0 calc(60% - 15px); }
    .hp1-ugc-product-tag {
      transform: translateY(0);
      opacity: 1;
      bottom: 10px; left: 10px; right: 10px;
    }
  }
</style>

{% schema %}
{
  "name": "HP1 UGC Reels",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Real Results"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by You"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2c2c2c"
    }
  ],
  "blocks": [
    {
      "type": "reel",
      "name": "Reel",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Video Thumbnail"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Featured Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP1 UGC Reels",
      "blocks": [
        { "type": "reel" },
        { "type": "reel" },
        { "type": "reel" },
        { "type": "reel" }
      ]
    }
  ]
}
{% endschema %}
