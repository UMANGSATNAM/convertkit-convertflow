{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#f4f1de'
  assign text_color = section.settings.text_color | default: '#6b705c'
  assign layout = section.settings.layout | default: 'image_left'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 100px 40px;
  }
  
  .hp14-iwt-container-{{ section_id }} {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 80px;
    flex-direction: {% if layout == 'image_right' %}row-reverse{% else %}row{% endif %};
  }
  
  .hp14-iwt-image-wrap-{{ section_id }} {
    flex: 1;
    border-radius: 200px 200px 20px 20px;
    overflow: hidden;
    height: 700px;
    position: relative;
  }
  
  .hp14-iwt-image-{{ section_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .hp14-iwt-content-{{ section_id }} {
    flex: 1;
    max-width: 500px;
  }
  
  .hp14-iwt-subheading-{{ section_id }} {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 20px;
    color: #cb997e;
  }
  
  .hp14-iwt-heading-{{ section_id }} {
    font-family: 'Georgia', serif;
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: normal;
    color: {{ text_color }};
    line-height: 1.1;
    margin: 0 0 30px 0;
  }
  
  .hp14-iwt-heading-{{ section_id }} span {
    font-style: italic;
    color: #a5a58d;
  }
  
  .hp14-iwt-text-{{ section_id }} {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 1.1rem;
    line-height: 1.6;
    color: #6b705c;
    margin: 0 0 40px 0;
  }
  
  .hp14-iwt-btn-{{ section_id }} {
    display: inline-block;
    padding: 16px 40px;
    background: #cb997e;
    color: #fff;
    text-decoration: none;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    border-radius: 50px;
    transition: background 0.3s ease;
  }
  
  .hp14-iwt-btn-{{ section_id }}:hover {
    background: #b58368;
  }

  @media (max-width: 992px) {
    .hp14-iwt-container-{{ section_id }} {
      flex-direction: column;
      text-align: center;
      gap: 40px;
    }
    .hp14-iwt-image-wrap-{{ section_id }} {
      width: 100%;
      height: 500px;
      border-radius: 100px 100px 20px 20px;
    }
    .hp14-iwt-content-{{ section_id }} {
      margin: 0 auto;
    }
  }
  
  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 60px 20px;
    }
  }
</style>

<div class="hp14-iwt-container-{{ section_id }}">
  <div class="hp14-iwt-image-wrap-{{ section_id }}">
    {% if section.settings.image != blank %}
      <img src="{{ section.settings.image | image_url: width: 1000 }}" alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}" width="1000" height="1000" class="hp14-iwt-image-{{ section_id }}" loading="lazy">
    {% else %}
      <div class="hp14-iwt-image-{{ section_id }}" style="background: repeating-linear-gradient(45deg, #EFEFEF, #EFEFEF 12px, #E6E6E6 12px, #E6E6E6 24px);"></div>
    {% endif %}
  </div>
  
  <div class="hp14-iwt-content-{{ section_id }}">
    <div class="hp14-iwt-subheading-{{ section_id }}">{{ section.settings.subheading | default: 'Our Philosophy' }}</div>
    <h2 class="hp14-iwt-heading-{{ section_id }}">{{ section.settings.heading | default: 'Rooted in <span>nature.</span>' }}</h2>
    <div class="hp14-iwt-text-{{ section_id }}">
      {{ section.settings.text | default: 'We believe that the earth provides everything we need to heal and nourish our bodies. Our products are formulated with wild-harvested botanicals and organic essential oils.' }}
    </div>
    {% if section.settings.button_label != blank %}
      <a href="{{ section.settings.button_link | default: '#' }}" class="hp14-iwt-btn-{{ section_id }}">{{ section.settings.button_label }}</a>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "HP14 Image with Text",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f4f1de"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#6b705c"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Image Alignment",
      "options": [
        { "value": "image_left", "label": "Left" },
        { "value": "image_right", "label": "Right" }
      ],
      "default": "image_left"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Our Philosophy"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Rooted in <span>nature.</span>"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "We believe that the earth provides everything we need to heal and nourish our bodies. Our products are formulated with wild-harvested botanicals and organic essential oils."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Discover Our Story"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "HP14 Image with Text"
    }
  ]
}
{% endschema %}
