{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp52-vid-bg: {{ section.settings.bg_color | default: '#F7EFE6' }};
    
    background-color: var(--hp52-vid-bg);
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
  }

  .hp52-video__box {
    max-width: {{ section.settings.container_width | default: 1240 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp52-video__media {
    width: 100%;
    height: {{ section.settings.video_height | default: 480 }}px;
    background: #EFE4D6;
    border-radius: 120px 120px 24px 24px;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 20px 50px rgba(45, 59, 45, 0.08);
    border: 3px solid #FFFDF9;
  }

  .hp52-video__poster {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hp52-video__play-btn {
    position: absolute;
    width: 80px;
    height: 80px;
    background: #C2593F;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #FFFDF9;
    font-size: 24px;
    cursor: pointer;
    box-shadow: 0 10px 30px rgba(194, 89, 63, 0.3);
    transition: all 0.3s ease;
  }

  .hp52-video__play-btn:hover {
    transform: scale(1.1);
    background: #2D3B2D;
  }

  @media screen and (max-width: 768px) {
    .hp52-video__media { height: 320px; }
  }
{%- endstyle -%}

<div class="hp52-video__box">
  <div class="hp52-video__media">
    {%- if section.settings.poster_image != blank -%}
      <img height="{{ section.settings.poster_image.height }}" width="{{ section.settings.poster_image.width }}" src="{{ section.settings.poster_image | image_url: width: 1400 }}" class="hp52-video__poster" alt="Mediterranean Cinema" loading="lazy">
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'hp52-video__poster' }}
    {%- endif -%}
    <div class="hp52-video__play-btn" onclick="alert('Streaming Tuscan Olive Harvest Documentary');">▶</div>
  </div>
</div>

{% schema %}
{
  "name": "HP52 - Terra Video",
  "class": "section-hp52-video",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#F7EFE6" },
    { "type": "image_picker", "id": "poster_image", "label": "Poster Image" },
    { "type": "range", "id": "video_height", "min": 300, "max": 700, "step": 20, "unit": "px", "label": "Video Height", "default": 480 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 80 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1240 }
  ],
  "presets": [
    { "name": "HP52 - Terra Video" }
  ]
}
{% endschema %}
