{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#FFFFFF'
  assign text_color = section.settings.text_color | default: '#2A3B2C'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 60px 20px;
    border-top: 1px solid rgba(42, 59, 44, 0.1);
    border-bottom: 1px solid rgba(42, 59, 44, 0.1);
  }
  
  .hp10-logos-container-{{ section_id }} {
    max-width: 1200px;
    margin: 0 auto;
    text-align: center;
  }
  
  .hp10-logos-text-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: rgba(42, 59, 44, 0.5);
    margin: 0 0 40px 0;
  }
  
  .hp10-logos-grid-{{ section_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 40px 80px;
  }
  
  .hp10-logo-item-{{ section_id }} {
    font-family: 'Lora', serif;
    font-size: 1.5rem;
    font-weight: 600;
    color: {{ text_color }};
    opacity: 0.6;
    transition: opacity 0.3s ease;
  }
  
  .hp10-logo-item-{{ section_id }}:hover {
    opacity: 1;
  }
</style>

<div class="hp10-logos-container-{{ section_id }}">
  <div class="hp10-logos-text-{{ section_id }}">{{ section.settings.text | default: 'Featured In' }}</div>
  
  <div class="hp10-logos-grid-{{ section_id }}">
    {% for block in section.blocks %}
      {% if block.settings.image != blank %}
        <img src="{{ block.settings.image | image_url: width: 200 }}" class="hp10-logo-item-{{ section_id }}" alt="Press Logo" {{ block.shopify_attributes }}>
      {% else %}
        <div class="hp10-logo-item-{{ section_id }}" {{ block.shopify_attributes }}>{{ block.settings.title | default: 'PUBLICATION' }}</div>
      {% endif %}
    {% else %}
      <div class="hp10-logo-item-{{ section_id }}">VOGUE</div>
      <div class="hp10-logo-item-{{ section_id }}">ELLE</div>
      <div class="hp10-logo-item-{{ section_id }}">ALLURE</div>
      <div class="hp10-logo-item-{{ section_id }}">GLAMOUR</div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "HP10 Press Logos",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Small Text",
      "default": "Featured In"
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (Optional)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Text Fallback",
          "default": "PUBLICATION"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP10 Press Logos",
      "blocks": [
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" }
      ]
    }
  ]
}
{% endschema %}
