{%- liquid
  assign bg_color = section.settings.bg_color | default: '#1C1917'
  assign text_color = section.settings.text_color | default: '#FFFFFF'
-%}

<section class="hp1-fresh-bundle" style="--bg: {{ bg_color }}; --text: {{ text_color }};">
  <div class="hp1-fresh-bundle__container">
    
    <!-- Section Header -->
    <div class="hp1-fresh-bundle__header">
      <span class="hp1-fresh-bundle__badge">⚡ Limited Bundle Deal</span>
      <h2 class="hp1-fresh-bundle__title">Build Your Complete 3-Step Routine — Save 25%</h2>
      <p class="hp1-fresh-bundle__subtitle">Select 3 steps below to unlock your clinical glow regimen + receive a FREE Rose Quartz Facial Roller ($24 Value).</p>
    </div>

    <!-- Bundle Builder Matrix -->
    <div class="hp1-fresh-bundle__grid">
      
      <!-- Step 1: Cleanser -->
      <div class="hp1-fresh-bundle__card hp1-fresh-bundle__card--selected">
        <div class="hp1-fresh-bundle__step-pill">Step 1: Cleanse</div>
        <img src="https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?q=80&w=600&auto=format&fit=crop" alt="Oil Cleanser" class="hp1-fresh-bundle__img">
        <h3 class="hp1-fresh-bundle__item-title">Velvet Oil Cleanser</h3>
        <span class="hp1-fresh-bundle__item-price">$36.00</span>
        <div class="hp1-fresh-bundle__check">✓ Selected</div>
      </div>

      <!-- Plus Separator -->
      <div class="hp1-fresh-bundle__plus">+</div>

      <!-- Step 2: Serum -->
      <div class="hp1-fresh-bundle__card hp1-fresh-bundle__card--selected">
        <div class="hp1-fresh-bundle__step-pill">Step 2: Treat</div>
        <img src="https://images.unsplash.com/photo-1620916566398-39f1143ab7be?q=80&w=600&auto=format&fit=crop" alt="Glow Serum" class="hp1-fresh-bundle__img">
        <h3 class="hp1-fresh-bundle__item-title">Barrier Glow Serum</h3>
        <span class="hp1-fresh-bundle__item-price">$42.00</span>
        <div class="hp1-fresh-bundle__check">✓ Selected</div>
      </div>

      <!-- Plus Separator -->
      <div class="hp1-fresh-bundle__plus">+</div>

      <!-- Step 3: Moisturizer -->
      <div class="hp1-fresh-bundle__card hp1-fresh-bundle__card--selected">
        <div class="hp1-fresh-bundle__step-pill">Step 3: Hydrate</div>
        <img src="https://images.unsplash.com/photo-1556228720-195a672e8a03?q=80&w=600&auto=format&fit=crop" alt="Barrier Cream" class="hp1-fresh-bundle__img">
        <h3 class="hp1-fresh-bundle__item-title">Dewy Barrier Cream</h3>
        <span class="hp1-fresh-bundle__item-price">$48.00</span>
        <div class="hp1-fresh-bundle__check">✓ Selected</div>
      </div>

    </div>

    <!-- Bundle Checkout Bar -->
    <div class="hp1-fresh-bundle__summary-box">
      <div class="hp1-fresh-bundle__price-info">
        <div class="hp1-fresh-bundle__savings-pill">🎉 You Save $31.50 (25% OFF)</div>
        <div class="hp1-fresh-bundle__price-row">
          <span class="hp1-fresh-bundle__total-price">$94.50</span>
          <span class="hp1-fresh-bundle__original-price">$126.00</span>
        </div>
        <span class="hp1-fresh-bundle__free-shipping">✓ Includes Free Express Shipping & Gift</span>
      </div>
      
      <button class="hp1-fresh-bundle__atc-btn">
        <span>Add 3-Step Routine To Cart — $94.50</span>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
      </button>
    </div>

  </div>
</section>

<style>
  .hp1-fresh-bundle {
    background-color: var(--bg);
    color: var(--text);
    padding: 96px 24px;
    font-family: 'Plus Jakarta Sans', sans-serif;
  }
  .hp1-fresh-bundle__container {
    max-width: 1280px;
    margin: 0 auto;
  }

  .hp1-fresh-bundle__header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 56px;
  }
  .hp1-fresh-bundle__badge {
    display: inline-block;
    background: #D97706;
    color: #FFF;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 6px 14px;
    border-radius: 100px;
    margin-bottom: 16px;
  }
  .hp1-fresh-bundle__title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(30px, 4vw, 44px);
    font-weight: 700;
    margin: 0 0 16px 0;
  }
  .hp1-fresh-bundle__subtitle {
    font-size: 16px;
    color: rgba(255, 255, 255, 0.75);
    line-height: 1.6;
    margin: 0;
  }

  /* Grid Matrix */
  .hp1-fresh-bundle__grid {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    margin-bottom: 48px;
  }
  @media (max-width: 991px) {
    .hp1-fresh-bundle__grid { flex-direction: column; }
    .hp1-fresh-bundle__plus { display: none; }
  }

  .hp1-fresh-bundle__card {
    background: rgba(255, 255, 255, 0.05);
    border: 2px solid rgba(255, 255, 255, 0.15);
    border-radius: 20px;
    padding: 24px;
    text-align: center;
    width: 280px;
    position: relative;
    transition: all 0.3s ease;
  }
  .hp1-fresh-bundle__card--selected {
    border-color: #F59E0B;
    background: rgba(245, 158, 11, 0.08);
  }
  .hp1-fresh-bundle__step-pill {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    color: #F59E0B;
    margin-bottom: 16px;
  }
  .hp1-fresh-bundle__img {
    width: 140px;
    height: 140px;
    object-fit: cover;
    border-radius: 16px;
    margin: 0 auto 16px;
    display: block;
  }
  .hp1-fresh-bundle__item-title {
    font-size: 16px;
    font-weight: 600;
    margin: 0 0 4px 0;
    color: #FFF;
  }
  .hp1-fresh-bundle__item-price {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.7);
    display: block;
    margin-bottom: 16px;
  }
  .hp1-fresh-bundle__check {
    background: #F59E0B;
    color: #1C1917;
    font-size: 12px;
    font-weight: 700;
    padding: 6px 12px;
    border-radius: 100px;
    display: inline-block;
  }

  .hp1-fresh-bundle__plus {
    font-size: 32px;
    font-weight: 300;
    color: rgba(255, 255, 255, 0.4);
  }

  /* Summary Box */
  .hp1-fresh-bundle__summary-box {
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 24px;
    padding: 32px 40px;
    max-width: 800px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }
  @media (max-width: 768px) {
    .hp1-fresh-bundle__summary-box { flex-direction: column; text-align: center; }
  }

  .hp1-fresh-bundle__savings-pill {
    display: inline-block;
    font-size: 12px;
    font-weight: 700;
    color: #10B981;
    background: rgba(16, 185, 129, 0.15);
    padding: 4px 10px;
    border-radius: 6px;
    margin-bottom: 8px;
  }
  .hp1-fresh-bundle__price-row {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }
  .hp1-fresh-bundle__total-price {
    font-size: 32px;
    font-weight: 800;
    color: #FFF;
  }
  .hp1-fresh-bundle__original-price {
    font-size: 18px;
    color: rgba(255, 255, 255, 0.4);
    text-decoration: line-through;
  }
  .hp1-fresh-bundle__free-shipping {
    display: block;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.7);
    margin-top: 4px;
  }

  .hp1-fresh-bundle__atc-btn {
    background: #F59E0B;
    color: #1C1917;
    border: none;
    padding: 18px 36px;
    border-radius: 100px;
    font-size: 16px;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    transition: all 0.25s ease;
    white-space: nowrap;
  }
  .hp1-fresh-bundle__atc-btn:hover {
    background: #D97706;
    color: #FFF;
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(245, 158, 11, 0.3);
  }
</style>

{% schema %}
{
  "name": "HP1 Fresh - Bundle Builder",
  "tag": "section",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#1C1917" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#FFFFFF" }
  ],
  "presets": [
    { "name": "HP1 Fresh - Bundle Builder" }
  ]
}
{% endschema %}
