{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,400;1,600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');

  #shopify-section-{{ section.id }} {
    --hp55-bg: {{ section.settings.bg_color | default: '#1F0B18' }};
    --hp55-text: {{ section.settings.text_color | default: '#FDF4FF' }};
    --hp55-pearl: {{ section.settings.accent_pearl | default: '#F3E8FF' }};
    --hp55-plum: {{ section.settings.accent_plum | default: '#C084FC' }};
    --hp55-btn-bg: {{ section.settings.btn_bg | default: '#C084FC' }};
    --hp55-btn-text: {{ section.settings.btn_text_color | default: '#1F0B18' }};

    background: radial-gradient(circle at 80% 20%, #3B1230 0%, var(--hp55-bg) 70%);
    color: var(--hp55-text);
    font-family: 'Plus Jakarta Sans', sans-serif;
    padding-top: {{ section.settings.padding_top | default: 100 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 100 }}px;
    position: relative;
    overflow: hidden;
  }

  .hp55-hero__pearl-glow {
    position: absolute;
    bottom: -100px;
    left: -100px;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(192, 132, 252, 0.12) 0%, transparent 70%);
    pointer-events: none;
  }

  .hp55-hero__container {
    max-width: {{ section.settings.container_width | default: 1280 }}px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 70px;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  .hp55-hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 20px;
    background: rgba(243, 232, 255, 0.08);
    border: 1px solid rgba(233, 213, 255, 0.3);
    border-radius: 50px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--hp55-pearl);
    margin-bottom: 26px;
  }

  .hp55-hero__title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(40px, 5.5vw, 68px);
    font-weight: 700;
    line-height: 1.08;
    color: #FFFFFF;
    margin: 0 0 24px;
  }

  .hp55-hero__title em {
    font-style: italic;
    font-weight: 400;
    background: linear-gradient(135deg, #FDF4FF 0%, #E9D5FF 50%, #C084FC 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hp55-hero__desc {
    font-size: 16px;
    line-height: 1.75;
    color: #E9D5FF;
    margin: 0 0 36px;
    max-width: 520px;
    opacity: 0.9;
  }

  .hp55-hero__actions {
    display: flex;
    gap: 16px;
    align-items: center;
    flex-wrap: wrap;
  }

  .hp55-hero__btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 36px;
    background: var(--hp55-btn-bg);
    color: var(--hp55-btn-text);
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 50px;
    transition: all 0.35s ease;
    box-shadow: 0 8px 30px rgba(192, 132, 252, 0.35);
  }

  .hp55-hero__btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 40px rgba(192, 132, 252, 0.55);
  }

  .hp55-hero__media {
    position: relative;
  }

  .hp55-hero__img-wrap {
    position: relative;
    border-radius: 200px 200px 20px 20px;
    overflow: hidden;
    height: 520px;
    border: 1px solid rgba(233, 213, 255, 0.25);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.7);
  }

  .hp55-hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: contrast(1.05);
    transition: transform 0.6s ease;
  }

  .hp55-hero__img-wrap:hover .hp55-hero__img {
    transform: scale(1.04);
  }

  .hp55-hero__float-card {
    position: absolute;
    bottom: -16px;
    left: -16px;
    background: rgba(31, 11, 24, 0.9);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(233, 213, 255, 0.3);
    border-radius: 16px;
    padding: 16px 22px;
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .hp55-hero__float-icon {
    width: 42px;
    height: 42px;
    background: linear-gradient(135deg, #C084FC, #E9D5FF);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #1F0B18;
    font-size: 18px;
  }

  .hp55-hero__float-label {
    font-family: 'Playfair Display', serif;
    font-size: 16px;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0;
  }

  .hp55-hero__float-sub {
    font-size: 11px;
    color: #C084FC;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin: 2px 0 0;
  }

  @media screen and (max-width: 992px) {
    .hp55-hero__container { grid-template-columns: 1fr; text-align: center; gap: 40px; }
    .hp55-hero__desc { margin-left: auto; margin-right: auto; }
    .hp55-hero__actions { justify-content: center; }
    .hp55-hero__img-wrap { height: 380px; }
    .hp55-hero__float-card { left: 50%; transform: translateX(-50%); bottom: -16px; }
  }

  @media screen and (max-width: 480px) {
    .hp55-hero__img-wrap { height: 300px; border-radius: 120px 120px 16px 16px; }
  }
{%- endstyle -%}

<div class="hp55-hero__pearl-glow"></div>

<div class="hp55-hero__container">
  <div>
    <div class="hp55-hero__badge">
      <span>✦</span>
      <span>{{ section.settings.badge | default: 'ROYAL PEARL VAULT v55' }}</span>
    </div>

    <h1 class="hp55-hero__title">
      {{ section.settings.heading | default: 'Royal <em>Plum & Pearl</em> Radiance' }}
    </h1>

    <p class="hp55-hero__desc">
      {{ section.settings.description | default: 'Formulated with crushed South Sea pearl nacre, wild plum bio-lipids, and black orchid extract for timeless royal skin majesty.' }}
    </p>

    <div class="hp55-hero__actions">
      <a href="{{ section.settings.btn_url | default: '/collections/all' }}" class="hp55-hero__btn">
        <span>{{ section.settings.btn_text | default: 'Discover Vault' }}</span>
        <span>&rarr;</span>
      </a>
    </div>
  </div>

  <div class="hp55-hero__media">
    <div class="hp55-hero__img-wrap">
      {%- if section.settings.image != blank -%}
        <img height="{{ section.settings.image.height }}" width="{{ section.settings.image.width }}" src="{{ section.settings.image | image_url: width: 1000 }}" class="hp55-hero__img" alt="{{ section.settings.heading }}" loading="eager">
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'hp55-hero__img' }}
      {%- endif -%}

      <div class="hp55-hero__float-card">
        <div class="hp55-hero__float-icon">✦</div>
        <div>
          <p class="hp55-hero__float-label">South Sea Pearl Extract</p>
          <p class="hp55-hero__float-sub">Cellular Nacre Formula</p>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "HP55 - Plum Hero",
  "class": "section-hp55-hero",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#1F0B18" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#FDF4FF" },
    { "type": "color", "id": "accent_pearl", "label": "Pearl Accent", "default": "#F3E8FF" },
    { "type": "color", "id": "accent_plum", "label": "Plum Accent", "default": "#C084FC" },
    { "type": "color", "id": "btn_bg", "label": "Button Background", "default": "#C084FC" },
    { "type": "color", "id": "btn_text_color", "label": "Button Text Color", "default": "#1F0B18" },
    { "type": "text", "id": "badge", "label": "Badge", "default": "ROYAL PEARL VAULT v55" },
    { "type": "textarea", "id": "heading", "label": "Heading (HTML allowed)", "default": "Royal <em>Plum & Pearl</em> Radiance" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Formulated with crushed South Sea pearl nacre and wild plum bio-lipids." },
    { "type": "text", "id": "btn_text", "label": "Button Text", "default": "Discover Vault" },
    { "type": "url", "id": "btn_url", "label": "Button URL" },
    { "type": "image_picker", "id": "image", "label": "Hero Image" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 100 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 100 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "presets": [{ "name": "HP55 - Plum Hero" }]
}
{% endschema %}
