{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --card-bg: {{ section.settings.card_bg }};
    --text-color: {{ section.settings.text_color }};
    
    --font-heading: 'Outfit', sans-serif;
    --font-body: 'Outfit', sans-serif;
    
    background-color: var(--bg-color);
    padding: 80px 20px;
  }

  .hp39-usp-wrapper {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 30px;
  }

  .hp39-usp__card {
    background: var(--card-bg);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 40px;
    padding: 50px 30px;
    text-align: center;
    box-shadow: 0 20px 40px rgba(0,0,0,0.02);
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hp39-usp__card:hover {
    transform: translateY(-10px) scale(1.02);
    box-shadow: 0 30px 50px rgba(0,0,0,0.05);
  }

  .hp39-usp__icon {
    width: 70px;
    height: 70px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #fff;
    border-radius: 50%;
    margin-bottom: 25px;
    box-shadow: 0 10px 20px rgba(0,0,0,0.05);
    color: var(--text-color);
  }

  .hp39-usp__icon svg {
    width: 30px;
    height: 30px;
    fill: currentColor;
    stroke: currentColor;
    stroke-width: 0.5;
  }

  .hp39-usp__title {
    font-family: var(--font-heading);
    font-size: clamp(20px, 3vw, {{ section.settings.title_size }}px);
    font-weight: 600;
    color: var(--text-color);
    margin: 0 0 15px;
  }

  .hp39-usp__text {
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-color);
    opacity: 0.7;
    margin: 0;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp39-usp-wrapper" id="HP39Usp-{{ section.id }}">
  {%- for block in section.blocks -%}
    <div class="hp39-usp__card" {{ block.shopify_attributes }}>
      <div class="hp39-usp__icon">
        {%- if block.settings.custom_icon != blank -%}
          {{ block.settings.custom_icon }}
        {%- else -%}
          <svg viewBox="0 0 24 24"><path d="M12 2L2 22h20L12 2zm0 3.8L18.4 19H5.6L12 5.8z"/></svg>
        {%- endif -%}
      </div>
      <h3 class="hp39-usp__title">{{ block.settings.title }}</h3>
      {%- if block.settings.text != blank -%}
        <p class="hp39-usp__text">{{ block.settings.text }}</p>
      {%- endif -%}
    </div>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "HP39 - Aura USP",
  "class": "section-hp39-usp",
  "settings": [
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 16,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Heading Size",
      "default": 24
    },
    {
      "type": "header",
      "content": "Aura Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#faf9f8"
    },
    {
      "type": "color_background",
      "id": "card_bg",
      "label": "Card Glass Background",
      "default": "rgba(255, 255, 255, 0.7)"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2D2D2D"
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "limit": 4,
      "settings": [
        {
          "type": "html",
          "id": "custom_icon",
          "label": "Custom Icon (SVG)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Soft Comfort"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Crafted for a gentle touch and ethereal feel."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP39 - Aura USP",
      "blocks": [
        { "type": "benefit" },
        { "type": "benefit" },
        { "type": "benefit" }
      ]
    }
  ]
}
{% endschema %}
