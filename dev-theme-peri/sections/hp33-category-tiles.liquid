{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Montserrat:wght@300;400;500&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --gold-color: {{ section.settings.gold_color }};
    
    --font-heading: 'Playfair Display', serif;
    --font-body: 'Montserrat', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    border-bottom: 1px solid rgba(212, 175, 55, 0.2);
  }

  .hp33-tiles-wrapper {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp33-tiles-wrapper {
      padding: 0 20px;
    }
  }

  .hp33-tiles__header {
    text-align: center;
    margin-bottom: 50px;
  }

  .hp33-tiles__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    line-height: 1.1;
    color: var(--text-color);
    margin: 0;
    font-weight: 400;
  }

  .hp33-tiles__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 40px;
  }

  @media screen and (max-width: 768px) {
    .hp33-tiles__grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }

  .hp33-tile {
    position: relative;
    aspect-ratio: 4/5;
    overflow: hidden;
    text-decoration: none;
    display: block;
    group: card;
  }

  .hp33-tile__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1s ease, filter 0.5s ease;
    filter: sepia(20%);
  }

  .hp33-tile:hover .hp33-tile__image {
    transform: scale(1.05);
    filter: sepia(0%);
  }

  /* Overlay */
  .hp33-tile::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.6) 0%, rgba(0,0,0,0) 50%);
    z-index: 1;
    transition: opacity 0.5s ease;
  }

  .hp33-tile:hover::before {
    opacity: 0.8;
  }

  /* Ornate frame */
  .hp33-tile__frame {
    position: absolute;
    top: 20px; left: 20px; right: 20px; bottom: 20px;
    border: 1px solid rgba(212, 175, 55, 0.4);
    z-index: 2;
    pointer-events: none;
    transition: all 0.5s ease;
  }

  .hp33-tile:hover .hp33-tile__frame {
    border-color: rgba(212, 175, 55, 1);
    top: 15px; left: 15px; right: 15px; bottom: 15px;
  }

  /* Corner accents for frame */
  .hp33-tile__frame::before,
  .hp33-tile__frame::after {
    content: '';
    position: absolute;
    width: 15px; height: 15px;
    border: 1px solid var(--gold-color);
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  .hp33-tile__frame::before { top: -4px; left: -4px; border-right: none; border-bottom: none; }
  .hp33-tile__frame::after { bottom: -4px; right: -4px; border-left: none; border-top: none; }
  
  .hp33-tile:hover .hp33-tile__frame::before,
  .hp33-tile:hover .hp33-tile__frame::after {
    opacity: 1;
  }

  .hp33-tile__content {
    position: absolute;
    bottom: 40px;
    left: 40px;
    right: 40px;
    z-index: 3;
    text-align: center;
  }

  .hp33-tile__title {
    font-family: var(--font-heading);
    font-size: clamp(28px, 4vw, 42px);
    color: #fff;
    margin: 0 0 10px;
    font-weight: 400;
  }

  .hp33-tile__link-text {
    font-family: var(--font-body);
    font-size: 12px;
    color: var(--gold-color);
    text-transform: uppercase;
    letter-spacing: 3px;
    font-weight: 500;
    position: relative;
    display: inline-block;
  }

  .hp33-tile__link-text::after {
    content: '';
    position: absolute;
    bottom: -5px; left: 50%;
    transform: translateX(-50%);
    width: 0;
    height: 1px;
    background: var(--gold-color);
    transition: width 0.3s ease;
  }

  .hp33-tile:hover .hp33-tile__link-text::after {
    width: 100%;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp33-tiles-wrapper" id="HP33Tiles-{{ section.id }}">
  {%- if section.settings.title != blank -%}
    <div class="hp33-tiles__header">
      <h2 class="hp33-tiles__title">{{ section.settings.title }}</h2>
    </div>
  {%- endif -%}

  <div class="hp33-tiles__grid">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.link | default: '#' }}" class="hp33-tile" {{ block.shopify_attributes }}>
        <div class="hp33-tile__frame"></div>
        {%- if block.settings.image != blank -%}
          <img height="{{ block.settings.image.height }}" width="{{ block.settings.image.width }}" src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title | escape }}" class="hp33-tile__image" loading="lazy">
        {%- else -%}
          {%- assign placeholder = 'collection-' | append: forloop.index -%}
          {%- if forloop.index > 6 -%}{%- assign placeholder = 'collection-1' -%}{%- endif -%}
          {{ placeholder | placeholder_svg_tag: 'hp33-tile__image' }}
        {%- endif -%}
        
        <div class="hp33-tile__content">
          <h3 class="hp33-tile__title">{{ block.settings.title }}</h3>
          <span class="hp33-tile__link-text">{{ block.settings.link_text }}</span>
        </div>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "HP33 - Deco Tiles",
  "class": "section-hp33-category-tiles",
  "max_blocks": 4,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "The Collections"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 48
    },
    {
      "type": "header",
      "content": "Deco Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (e.g. Deep Emerald)",
      "default": "#0e1a14"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "gold_color",
      "label": "Gold Accent",
      "default": "#d4af37"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Category Tile",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "The Heritage"
        },
        {
          "type": "text",
          "id": "link_text",
          "label": "Link Text",
          "default": "EXPLORE"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP33 - Deco Tiles",
      "blocks": [
        { "type": "tile", "settings": { "title": "For Him" } },
        { "type": "tile", "settings": { "title": "For Her" } }
      ]
    }
  ]
}
{% endschema %}
