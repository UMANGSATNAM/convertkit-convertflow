{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#09090B' }};
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }
  .hp61-test__container { max-width: {{ section.settings.container_width | default: 1280 }}px; margin: 0 auto; padding: 0 24px; }
  .hp61-test__header { text-align: center; margin-bottom: 50px; }
  .hp61-test__eyebrow { font-family: 'Space Grotesk', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: #EF4444; margin: 0 0 12px; }
  .hp61-test__heading { font-family: 'Syne', sans-serif; font-size: clamp(28px, 3.5vw, 42px); font-weight: 800; color: #FFFFFF; margin: 0; }
  .hp61-test__grid { display: grid; grid-template-columns: repeat({{ section.settings.columns | default: 3 }}, 1fr); gap: 20px; }
  .hp61-test__card { background: #18181B; border: 1px solid rgba(239, 68, 68, 0.2); border-radius: 6px; padding: 32px 24px; }
  .hp61-test__stars { color: #EF4444; font-size: 16px; margin-bottom: 16px; letter-spacing: 2px; }
  .hp61-test__quote { font-size: 15px; line-height: 1.6; color: #E4E4E7; margin: 0 0 20px; }
  .hp61-test__author { font-family: 'Syne', sans-serif; font-size: 14px; font-weight: 700; color: #FFFFFF; margin: 0; }
  .hp61-test__role { font-size: 11px; color: #F59E0B; margin: 4px 0 0; letter-spacing: 1px; text-transform: uppercase; }
  @media screen and (max-width: 992px) { .hp61-test__grid { grid-template-columns: 1fr; max-width: 600px; margin: 0 auto; } }
{%- endstyle -%}
<div class="hp61-test__container">
  <div class="hp61-test__header">
    {%- if section.settings.eyebrow != blank -%}<p class="hp61-test__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="hp61-test__heading">{{ section.settings.heading | default: 'Thermal Case Studies' }}</h2>
  </div>
  <div class="hp61-test__grid">
    {%- for block in section.blocks -%}
      <div class="hp61-test__card" {{ block.shopify_attributes }}>
        <div class="hp61-test__stars">{{ block.settings.stars | default: '★★★★★' }}</div>
        <p class="hp61-test__quote">"{{ block.settings.quote | default: 'The basalt ash mask purged my stubborn blackheads in a single 15-minute treatment.' }}"</p>
        <p class="hp61-test__author">{{ block.settings.author | default: 'Astrid Lindholm' }}</p>
        <p class="hp61-test__role">{{ block.settings.role | default: 'Reykjavik Spa Director' }}</p>
      </div>
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "HP61 Reviews",
  "class": "section-hp61-test",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#09090B" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "🌋 REVIEWS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Thermal Case Studies" },
    { "type": "range", "id": "columns", "min": 1, "max": 3, "step": 1, "label": "Columns", "default": 3 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "blocks": [{ "type": "testimonial", "name": "Review", "settings": [
    { "type": "text", "id": "stars", "label": "Stars", "default": "★★★★★" },
    { "type": "textarea", "id": "quote", "label": "Quote", "default": "The basalt ash mask purged my stubborn blackheads instantly." },
    { "type": "text", "id": "author", "label": "Author", "default": "Astrid Lindholm" },
    { "type": "text", "id": "role", "label": "Role", "default": "Reykjavik Spa Director" }
  ]}],
  "presets": [{ "name": "HP61 Reviews", "blocks": [
    { "type": "testimonial" },
    { "type": "testimonial", "settings": { "quote": "The thermal silica serum strengthened my depleted skin barrier noticeably.", "author": "Magnus E.", "role": "Dermal Toxicologist" } },
    { "type": "testimonial", "settings": { "quote": "Unbelievable pore-refining results without drying or stripping skin.", "author": "Freja Holm", "role": "Nordic Skincare Specialist" } }
  ]}]
}
{% endschema %}
