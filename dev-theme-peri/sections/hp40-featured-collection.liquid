{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;700;900&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    
    --font-heading: 'Inter', sans-serif;
    --font-body: 'Inter', sans-serif;
    
    background-color: var(--bg-color);
    border-bottom: 2px solid var(--text-color);
  }

  .hp40-featured-wrapper {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  @media screen and (max-width: 992px) {
    .hp40-featured-wrapper {
      grid-template-columns: 1fr;
    }
  }

  .hp40-featured__header {
    padding: 60px 40px;
    border-right: 2px solid var(--text-color);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  
  @media screen and (max-width: 992px) {
    .hp40-featured__header {
      border-right: none;
      border-bottom: 2px solid var(--text-color);
    }
  }

  .hp40-featured__title {
    font-family: var(--font-heading);
    font-size: clamp(40px, 8vw, {{ section.settings.title_size }}px);
    font-weight: 900;
    line-height: 0.9;
    text-transform: uppercase;
    color: var(--text-color);
    margin: 0 0 40px;
    letter-spacing: -2px;
  }

  .hp40-featured__btn {
    align-self: flex-start;
    display: inline-block;
    padding: 15px 30px;
    background: transparent;
    color: var(--text-color);
    border: 2px solid var(--text-color);
    font-family: var(--font-heading);
    font-size: 18px;
    font-weight: 700;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .hp40-featured__btn:hover {
    background: var(--text-color);
    color: var(--bg-color);
  }

  .hp40-featured__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  
  @media screen and (max-width: 600px) {
    .hp40-featured__grid {
      grid-template-columns: 1fr;
    }
  }

  .hp40-fc-card {
    border-right: 2px solid var(--text-color);
    border-bottom: 2px solid var(--text-color);
    position: relative;
    text-decoration: none;
    overflow: hidden;
    background: var(--bg-color);
    display: flex;
    flex-direction: column;
  }

  /* Handle borders for 2x grid */
  .hp40-fc-card:nth-child(even) {
    border-right: none;
  }
  .hp40-fc-card:nth-last-child(-n+2) {
    /* If even number of items, last row shouldn't have bottom border in its own container, 
       but we want the grid lines to match up. Actually, keeping bottom border is fine for Swiss style. */
  }
  
  @media screen and (max-width: 600px) {
    .hp40-fc-card {
      border-right: none;
    }
  }

  .hp40-fc-card__image-wrapper {
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--accent-color);
    position: relative;
    border-bottom: 2px solid var(--text-color);
  }

  .hp40-fc-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%);
    transition: mix-blend-mode 0.3s ease, filter 0.3s ease;
  }

  .hp40-fc-card:hover .hp40-fc-card__image {
    mix-blend-mode: multiply;
    filter: grayscale(0%);
  }

  .hp40-fc-card__info {
    padding: 20px;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    background: var(--bg-color);
    transition: background 0.3s ease, color 0.3s ease;
  }

  .hp40-fc-card:hover .hp40-fc-card__info {
    background: var(--text-color);
    color: var(--bg-color);
  }

  .hp40-fc-card__title {
    font-family: var(--font-heading);
    font-size: 18px;
    font-weight: 700;
    color: inherit;
    margin: 0;
    text-transform: uppercase;
  }

  .hp40-fc-card__price {
    font-family: var(--font-heading);
    font-size: 18px;
    font-weight: 700;
    color: inherit;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp40-featured-wrapper" id="HP40Featured-{{ section.id }}">
  <div class="hp40-featured__header">
    <h2 class="hp40-featured__title">{{ section.settings.title }}</h2>
    
    {%- if section.settings.btn_label != blank -%}
      <a href="{{ section.settings.btn_link | default: collections[section.settings.collection].url | default: '#' }}" class="hp40-featured__btn">
        {{ section.settings.btn_label }}
      </a>
    {%- endif -%}
  </div>

  <div class="hp40-featured__grid">
    {%- assign collection = collections[section.settings.collection] -%}
    {%- if collection != blank and collection.products_count > 0 -%}
      {%- for product in collection.products limit: section.settings.limit -%}
        <a href="{{ product.url }}" class="hp40-fc-card">
          <div class="hp40-fc-card__image-wrapper">
            <img height="{{ product.featured_image.height }}" width="{{ product.featured_image.width }}" src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" class="hp40-fc-card__image" loading="lazy">
          </div>
          <div class="hp40-fc-card__info">
            <h3 class="hp40-fc-card__title">{{ product.title }}</h3>
            <div class="hp40-fc-card__price">{{ product.price | money }}</div>
          </div>
        </a>
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..section.settings.limit) -%}
        <a href="#" class="hp40-fc-card">
          <div class="hp40-fc-card__image-wrapper">
            {{ 'product-' | append: i | placeholder_svg_tag: 'hp40-fc-card__image' }}
          </div>
          <div class="hp40-fc-card__info">
            <h3 class="hp40-fc-card__title">Item 0{{ i }}</h3>
            <div class="hp40-fc-card__price">$99.00</div>
          </div>
        </a>
      {%- endfor -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP40 - Swiss Collection",
  "class": "section-hp40-featured-collection",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "SELECTED\nWORKS"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "min": 2,
      "max": 8,
      "step": 2,
      "label": "Product Limit",
      "default": 4
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "VIEW INDEX"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 40,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "Heading Size",
      "default": 80
    },
    {
      "type": "header",
      "content": "Swiss Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#F4F4F4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text & Lines",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Image Hover Accent",
      "default": "#FFDD00"
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP40 - Swiss Collection"
    }
  ]
}
{% endschema %}
