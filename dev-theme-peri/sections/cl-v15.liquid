{% comment %} CL V15 — Sneakerhead / Hype {% endcomment %}
{{ 'component-facets.css' | asset_url | stylesheet_tag }}
<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
<style>
  .clv15 { background: {{ section.settings.bg_color | default: '#F3F4F6' }}; color: {{ section.settings.text_color | default: '#111827' }}; padding: 40px 20px; font-family: 'Oswald', sans-serif; text-transform: uppercase; }
  .clv15-hero { background: #111827; color: #FFF; padding: 60px 40px; margin-bottom: 40px; display: flex; justify-content: space-between; align-items: center; }
  .clv15-hero h1 { font-size: 60px; font-weight: 800; margin: 0; line-height: 1; letter-spacing: -1px; }
  .clv15-hero p { font-size: 18px; color: #9CA3AF; margin: 0; max-width: 400px; text-align: right; font-family: sans-serif; text-transform: none; }
  .clv15-chips { display: flex; gap: 10px; margin-bottom: 30px; overflow-x: auto; }
  .clv15-chips a { padding: 12px 24px; background: #FFF; color: #111827; text-decoration: none; font-size: 16px; font-weight: 700; border: 2px solid #E5E7EB; transition: 0.2s; }
  .clv15-chips a:hover, .clv15-chips a.active { background: #111827; color: #FFF; border-color: #111827; }
  .clv15-toolbar { display: flex; justify-content: space-between; align-items: center; background: #FFF; border: 2px solid #E5E7EB; padding: 20px; margin-bottom: 40px; }
  .clv15-grid { display: grid; grid-template-columns: repeat({{ section.settings.cols_desktop | default: 4 }}, 1fr); gap: 20px; }
  .clv15-promo { grid-column: span 1; background: #EF4444; color: #FFF; padding: 40px; display: flex; flex-direction: column; justify-content: flex-end; position: relative; overflow: hidden; }
  .clv15-promo h3 { font-size: 32px; font-weight: 800; margin-bottom: 15px; position: relative; z-index: 1; line-height: 1.1; }
  .clv15-promo a { display: inline-block; padding: 12px; background: #FFF; color: #EF4444; text-decoration: none; font-weight: 800; font-size: 16px; text-align: center; position: relative; z-index: 1; }
  .clv15-seo { margin-top: 60px; padding: 40px; background: #FFF; border: 2px solid #E5E7EB; }
  @media (max-width: 768px) { .clv15-grid { grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr); gap: 10px; } .clv15-hero { flex-direction: column; text-align: center; align-items: center; } .clv15-hero p { text-align: center; margin-top: 15px; } }
</style>
<div class="clv15" style="max-width: 1400px; margin: 0 auto;">
  <div class="clv15-hero">
    <h1>{% if collection.title != blank %}{{ collection.title | escape }}{% else %}HYPE GRAILS{% endif %}</h1>
    <p>{% if collection.description != blank %}{{ collection.description }}{% else %}The most sought-after drops. Limited quantities.{% endif %}</p>
  </div>
  {% if section.settings.sub_collections != blank %}
    <div class="clv15-chips">
      {% for link in section.settings.sub_collections.links %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% endfor %}
    </div>
  {% endif %}
  <div class="clv15-toolbar">
    <facet-filters-form style="width: 100%;">
      <form id="FacetFiltersForm" style="display: flex; justify-content: space-between; align-items: center; width: 100%; flex-wrap: wrap; gap: 20px;">
        <div style="display: flex; gap: 15px;">
          {%- for filter in collection.filters -%}
            <details style="position: relative;">
              <summary style="cursor: pointer; font-size: 16px; font-weight: 700;">{{ filter.label }} ▼</summary>
              <div style="position: absolute; background: #FFF; border: 2px solid #111827; padding: 20px; z-index: 10; margin-top: 10px; min-width: 220px;">
                {%- for value in filter.values -%}
                  <label style="display: block; margin-bottom: 12px; cursor: pointer; font-size: 14px; font-family: sans-serif; text-transform: none;">
                    <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %}>
                    {{ value.label }} ({{ value.count }})
                  </label>
                {%- endfor -%}
              </div>
            </details>
          {%- endfor -%}
        </div>
        <select name="sort_by" onchange="this.form.submit()" style="background: #F3F4F6; border: none; padding: 10px 15px; font-size: 16px; font-weight: 700; font-family: 'Oswald', sans-serif; text-transform: uppercase; cursor: pointer;">
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>
          {%- endfor -%}
        </select>
      </form>
    </facet-filters-form>
  </div>
  {% assign limit_num = section.settings.products_per_page | default: 16 %}
  {% paginate collection.products by limit_num %}
    <div class="clv15-grid">
      {% for product in collection.products %}
        {% render 'card-v15', product: product %}
        {% if forloop.index == 8 and section.settings.show_promo_tile %}
          <div class="clv15-promo">
            <h3>Restock<br>Alerts</h3>
            <a href="/pages/app">DOWNLOAD APP</a>
          </div>
        {% endif %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v15', product: nil %}
        {% endfor %}
      {% endfor %}
    </div>
    <div style="margin-top: 50px; text-align: center; font-size: 20px; font-weight: 700;">{{ paginate | default_pagination }}</div>
  {% endpaginate %}
  {% if section.settings.show_seo_block %}
    <div class="clv15-seo">
      <h2 style="font-size: 32px; font-weight: 800; margin-bottom: 15px;">{{ section.settings.seo_title | default: '100% AUTHENTIC GUARANTEED' }}</h2>
      <p style="font-family: sans-serif; text-transform: none; color: #4B5563; line-height: 1.6;">{{ section.settings.seo_text | default: 'Every item is meticulously authenticated by our team of experts before it ships.' }}</p>
    </div>
  {% endif %}
</div>
{% schema %}
{
  "name": "CL V15 — Hype", "settings": [
    {"type": "range", "id": "products_per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 16},
    {"type": "range", "id": "cols_desktop", "label": "Desktop Columns", "min": 2, "max": 5, "default": 4},
    {"type": "select", "id": "cols_mobile", "label": "Mobile Columns", "options": [{"value": "1", "label": "1"}, {"value": "2", "label": "2"}], "default": "2"},
    {"type": "link_list", "id": "sub_collections", "label": "Sub-Collection Menu"},
    {"type": "checkbox", "id": "show_promo_tile", "label": "Show Promo Card", "default": true},
    {"type": "checkbox", "id": "show_seo_block", "label": "Show SEO Block", "default": true},
    {"type": "color", "id": "bg_color", "label": "Background Color", "default": "#F3F4F6"},
    {"type": "color", "id": "text_color", "label": "Text Color", "default": "#111827"}
  ], "presets": [{"name": "CL V15 — Hype"}]
}
{% endschema %}
