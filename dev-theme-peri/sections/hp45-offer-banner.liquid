{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp45-offer-bg: {{ section.settings.bg_color | default: '#0A0A0A' }};
    --hp45-offer-text: {{ section.settings.text_color | default: '#FFFFFF' }};
    
    background: var(--hp45-offer-bg);
    color: var(--hp45-offer-text);
    padding-top: {{ section.settings.padding_top | default: 75 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 75 }}px;
    border-top: 2px solid #0A0A0A;
    border-bottom: 2px solid #0A0A0A;
  }

  .hp45-offer__box {
    max-width: {{ section.settings.container_width | default: 900 }}px;
    margin: 0 auto;
    padding: 0 24px;
    text-align: center;
  }

  .hp45-offer__title {
    font-size: clamp(32px, 5vw, 54px);
    font-weight: 700;
    text-transform: uppercase;
    line-height: 1.1;
    letter-spacing: -1.5px;
    margin: 0 0 16px;
  }

  .hp45-offer__desc {
    font-family: 'JetBrains Mono', monospace;
    font-size: 14px;
    color: #CCCCCC;
    line-height: 1.7;
    margin: 0 auto 30px;
    max-width: 600px;
  }

  .hp45-offer__code-box {
    display: inline-block;
    background: #FFFFFF;
    color: #0A0A0A;
    border: 2px solid #FFFFFF;
    box-shadow: 4px 4px 0 #333333;
    padding: 10px 24px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 18px;
    font-weight: 700;
    margin-bottom: 30px;
    letter-spacing: 2px;
  }

  .hp45-offer__btn {
    display: inline-flex;
    padding: 16px 36px;
    background: #F5F5F0;
    color: #0A0A0A;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    text-decoration: none;
    border: 2px solid #FFFFFF;
    box-shadow: 4px 4px 0 #FFFFFF;
    transition: all 0.2s ease;
  }

  .hp45-offer__btn:hover {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0 #FFFFFF;
  }
{%- endstyle -%}

<div class="hp45-offer__box">
  <h2 class="hp45-offer__title">{{ section.settings.heading | default: 'PROTOCOL ALLOCATION: 20% PRIVILEGE' }}</h2>
  <p class="hp45-offer__desc">
    {{ section.settings.description | default: 'Apply institutional allocation code during cart verification. Valid on all baseline compound orders above $60 USD.' }}
  </p>

  <div class="hp45-offer__code-box">
    CODE: {{ section.settings.promo_code | default: 'BRUTAL20' }}
  </div>

  <div>
    <a href="{{ section.settings.btn_url | default: '/collections/all' }}" class="hp45-offer__btn">
      {{ section.settings.btn_text | default: 'INITIALIZE ORDER [→]' }}
    </a>
  </div>
</div>

{% schema %}
{
  "name": "HP45 - Brutal Offer",
  "class": "section-hp45-offer",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#0A0A0A" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#FFFFFF" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "PROTOCOL ALLOCATION: 20% PRIVILEGE" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Apply institutional allocation code during cart verification." },
    { "type": "text", "id": "promo_code", "label": "Promo Code", "default": "BRUTAL20" },
    { "type": "text", "id": "btn_text", "label": "Button Text", "default": "INITIALIZE ORDER [→]" },
    { "type": "url", "id": "btn_url", "label": "Button URL" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 5, "unit": "px", "label": "Padding Top", "default": 75 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 5, "unit": "px", "label": "Padding Bottom", "default": 75 },
    { "type": "range", "id": "container_width", "min": 600, "max": 1200, "step": 20, "unit": "px", "label": "Container Width", "default": 900 }
  ],
  "presets": [
    { "name": "HP45 - Brutal Offer" }
  ]
}
{% endschema %}
