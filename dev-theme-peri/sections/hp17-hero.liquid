{%- liquid
  assign section_id = section.id
-%}

<style>
  #shopify-section-{{ section_id }} {
    padding: 0;
    background-color: #0A0A0A;
    border-bottom: 1px solid rgba(0, 255, 65, 0.3);
  }
  
  .hp17-hero-container-{{ section_id }} {
    position: relative;
    width: 100%;
    height: 90vh;
    min-height: 700px;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    padding: 60px;
    overflow: hidden;
  }
  
  .hp17-hero-grid-bg-{{ section_id }} {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background-image: 
      linear-gradient(rgba(0, 255, 65, 0.1) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 255, 65, 0.1) 1px, transparent 1px);
    background-size: 30px 30px;
    z-index: 1;
    perspective: 1000px;
    transform: rotateX(60deg) scale(2);
    transform-origin: bottom center;
    opacity: 0.3;
  }
  
  .hp17-hero-image-{{ section_id }} {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover;
    z-index: 0;
    opacity: 0.4;
    filter: grayscale(100%) contrast(120%);
  }
  
  .hp17-hero-content-{{ section_id }} {
    position: relative;
    z-index: 2;
    max-width: 800px;
    background: rgba(10, 10, 10, 0.8);
    border: 1px solid rgba(0, 255, 65, 0.5);
    padding: 50px;
    box-shadow: 0 0 20px rgba(0, 255, 65, 0.1);
    backdrop-filter: blur(10px);
  }
  
  .hp17-hero-content-{{ section_id }}::before {
    content: '';
    position: absolute;
    top: -1px; left: -1px;
    width: 20px; height: 20px;
    border-top: 2px solid #00FF41;
    border-left: 2px solid #00FF41;
  }
  
  .hp17-hero-content-{{ section_id }}::after {
    content: '';
    position: absolute;
    bottom: -1px; right: -1px;
    width: 20px; height: 20px;
    border-bottom: 2px solid #00FF41;
    border-right: 2px solid #00FF41;
  }
  
  .hp17-hero-subtitle-{{ section_id }} {
    font-family: 'Courier New', Courier, monospace;
    font-weight: bold;
    font-size: 1rem;
    letter-spacing: 4px;
    color: #B800FF;
    text-transform: uppercase;
    margin-bottom: 20px;
    text-shadow: 0 0 5px rgba(184, 0, 255, 0.5);
  }
  
  .hp17-hero-subtitle-{{ section_id }}::before {
    content: "// ";
  }
  
  .hp17-hero-title-{{ section_id }} {
    font-family: 'Arial Black', sans-serif;
    font-size: clamp(3.5rem, 6vw, 6rem);
    text-transform: uppercase;
    color: #FFF;
    margin: 0 0 30px 0;
    line-height: 1;
    letter-spacing: 2px;
  }
  
  .hp17-hero-title-{{ section_id }} span {
    color: transparent;
    -webkit-text-stroke: 1.5px #00FF41;
    text-shadow: 0 0 10px rgba(0,255,65,0.3);
  }
  
  .hp17-hero-btn-{{ section_id }} {
    font-family: 'Courier New', Courier, monospace;
    font-size: 1rem;
    font-weight: bold;
    text-transform: uppercase;
    color: #0A0A0A;
    background: #00FF41;
    text-decoration: none;
    padding: 15px 40px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    letter-spacing: 2px;
    box-shadow: 0 0 15px rgba(0, 255, 65, 0.4);
    transition: all 0.3s ease;
    clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);
  }
  
  .hp17-hero-btn-{{ section_id }}:hover {
    background: #B800FF;
    color: #FFF;
    box-shadow: 0 0 20px rgba(184, 0, 255, 0.6);
  }
  
  @media (max-width: 768px) {
    .hp17-hero-container-{{ section_id }} {
      padding: 20px;
      justify-content: center;
    }
    .hp17-hero-content-{{ section_id }} {
      padding: 30px 20px;
    }
  }
</style>

<div class="hp17-hero-container-{{ section_id }}">
  <div class="hp17-hero-grid-bg-{{ section_id }}"></div>
  
  {% if section.settings.image != blank %}
    <img src="{{ section.settings.image | image_url: width: 2000 }}" class="hp17-hero-image-{{ section_id }}" loading="lazy" alt="Hero">
  {% else %}
    <div class="hp17-hero-image-{{ section_id }}" style="background: repeating-linear-gradient(45deg, #EFEFEF, #EFEFEF 12px, #E6E6E6 12px, #E6E6E6 24px);"></div>
  {% endif %}
  
  <div class="hp17-hero-content-{{ section_id }}">
    {% if section.settings.subtitle != blank %}
      <div class="hp17-hero-subtitle-{{ section_id }}">{{ section.settings.subtitle }}</div>
    {% endif %}
    {% if section.settings.title != blank %}
      <h1 class="hp17-hero-title-{{ section_id }}">SYSTEM <span>OVERRIDE</span></h1>
    {% endif %}
    {% if section.settings.btn_text != blank %}
      <a href="{{ section.settings.btn_link | default: '#' }}" class="hp17-hero-btn-{{ section_id }}">
        {{ section.settings.btn_text }}
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "HP17 Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "FW_26 PROTOTYPE"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "SYSTEM OVERRIDE"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "ACCESS GEAR"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "HP17 Hero"
    }
  ]
}
{% endschema %}
