{%- style -%}
#shopify-section-{{ section.id }}{
  --hdr-bg: #f7fee7;
  --hdr-text: #14532d;
  --hdr-accent: #16a34a;
  background: var(--hdr-bg);
  border-bottom:1px solid rgba(0,0,0,.06);
  position:sticky; top:0; z-index:40; backdrop-filter:blur(8px);
}
.hdr-collection{max-width:1280px;margin:0 auto;padding:14px 24px;display:flex;align-items:center;justify-content:space-between;gap:16px}
.hdr-collection__logo{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:var(--hdr-text);font-size:16px;text-decoration:none}
.hdr-collection__nav{display:flex;gap:18px;align-items:center}
.hdr-collection__nav a{font-size:13px;font-weight:600;color:var(--hdr-text);text-decoration:none;opacity:.8}
.hdr-collection__nav a:hover{opacity:1;color:var(--hdr-accent)}
.hdr-collection__actions{display:flex;gap:10px;align-items:center}
.hdr-collection__cart{background:var(--hdr-accent);color:#fff;padding:8px 14px;border-radius:999px;font-size:12px;font-weight:700;text-decoration:none}
@media(max-width:768px){.hdr-collection__nav{display:none}}
{%- endstyle -%}
<header class="hdr-collection">
  <a href="/" class="hdr-collection__logo">GENERAL <span style="color:var(--hdr-accent)">•</span> COLLECTION</a>
  <nav class="hdr-collection__nav">
    <a href="/collections/all">Shop</a>
    <a href="/collections/all">New</a>
    <a href="/pages/about">Story</a>
    <a href="/pages/contact">Contact</a>
  </nav>
  <div class="hdr-collection__actions">
    <a href="/search" style="color:var(--hdr-text);opacity:.7">Search</a>
    <a href="{{ routes.cart_url }}" class="hdr-collection__cart">Cart {{'{{ cart.item_count }}'}}</a>
  </div>
</header>
{% schema %}{"name":"Header collection","settings":[],"presets":[{"name":"Header collection"}]}{% endschema %}