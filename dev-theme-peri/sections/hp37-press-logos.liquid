{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Shrikhand&family=DM+Sans:wght@400;500;700&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    
    --font-heading: 'Shrikhand', cursive;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .hp37-press-wrapper {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp37-press-wrapper {
      padding: 0 20px;
    }
  }

  .hp37-press__container {
    border: 4px solid var(--text-color);
    border-radius: 20px;
    display: flex;
    align-items: stretch;
    background: #fff;
    box-shadow: 8px 8px 0px var(--accent-color);
    overflow: hidden;
  }

  @media screen and (max-width: 992px) {
    .hp37-press__container {
      flex-direction: column;
    }
  }

  .hp37-press__title-col {
    padding: 30px;
    background: var(--text-color);
    color: var(--bg-color);
    display: flex;
    align-items: center;
    justify-content: center;
    border-right: 4px solid var(--text-color);
  }

  @media screen and (max-width: 992px) {
    .hp37-press__title-col {
      border-right: none;
      border-bottom: 4px solid var(--text-color);
    }
  }

  .hp37-press__title {
    font-family: var(--font-heading);
    font-size: 24px;
    margin: 0;
    text-align: center;
    transform: rotate(-2deg);
  }

  .hp37-press__logos {
    display: flex;
    flex: 1;
  }

  @media screen and (max-width: 768px) {
    .hp37-press__logos {
      flex-wrap: wrap;
    }
  }

  .hp37-press__logo-item {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 30px;
    border-right: 4px solid var(--text-color);
  }

  .hp37-press__logo-item:last-child {
    border-right: none;
  }

  @media screen and (max-width: 768px) {
    .hp37-press__logo-item {
      flex: 50%;
      border-bottom: 4px solid var(--text-color);
    }
    .hp37-press__logo-item:nth-child(even) {
      border-right: none;
    }
    .hp37-press__logo-item:nth-last-child(-n+2) {
      border-bottom: none;
    }
  }

  .hp37-press__logo {
    max-height: 40px;
    width: auto;
    filter: sepia(1) hue-rotate(340deg) saturate(3) contrast(1.2); /* Make logos look slightly retro brown/orange */
  }

  .hp37-press__logo-text {
    font-family: var(--font-heading);
    font-size: 24px;
    color: var(--text-color);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp37-press-wrapper" id="HP37Press-{{ section.id }}">
  <div class="hp37-press__container">
    <div class="hp37-press__title-col">
      <h2 class="hp37-press__title">{{ section.settings.title }}</h2>
    </div>
    
    <div class="hp37-press__logos">
      {%- for block in section.blocks -%}
        <div class="hp37-press__logo-item" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img height="{{ block.settings.image.height }}" width="{{ block.settings.image.width }}" src="{{ block.settings.image | image_url: height: 80 }}" alt="Press Logo" class="hp37-press__logo" loading="lazy">
          {%- else -%}
            <span class="hp37-press__logo-text">{{ block.settings.text_fallback }}</span>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "HP37 - Retro Press",
  "class": "section-hp37-press-logos",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Word on the Street"
    },
    {
      "type": "header",
      "content": "Retro Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#F4E3C5"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#4A3219"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#D96C4A"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Press Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo Image"
        },
        {
          "type": "text",
          "id": "text_fallback",
          "label": "Text Fallback",
          "default": "GQ"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP37 - Retro Press",
      "blocks": [
        { "type": "logo", "settings": { "text_fallback": "GQ" } },
        { "type": "logo", "settings": { "text_fallback": "VOGUE" } },
        { "type": "logo", "settings": { "text_fallback": "SURFER" } },
        { "type": "logo", "settings": { "text_fallback": "HYPEBEAST" } }
      ]
    }
  ]
}
{% endschema %}
