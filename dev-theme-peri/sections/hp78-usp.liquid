{%- style -%}#shopify-section-{{ section.id }}{background:{{ section.settings.bg_color | default: '#ffffff' }};padding:28px 0;border-bottom:1px solid rgba(0,0,0,.06)}.hp78-usp{max-width:1280px;margin:0 auto;padding:0 24px;display:grid;grid-template-columns:repeat(4,1fr);gap:20px}@media(max-width:768px){.hp78-usp{grid-template-columns:repeat(2,1fr)}}@media(max-width:480px){.hp78-usp{grid-template-columns:1fr}}.hp78-usp__item{display:flex;gap:12px;align-items:center}.hp78-usp__icon{width:42px;height:42px;border-radius:10px;background:#6366F110;display:flex;align-items:center;justify-content:center;color:#6366F1;font-size:18px;border:1px solid #6366F122}.hp78-usp__title{font-weight:700;font-size:14px;margin:0}.hp78-usp__desc{font-size:12px;opacity:.6;margin:2px 0 0}{%- endstyle -%}<div class="hp78-usp">{% for block in section.blocks %}<div class="hp78-usp__item"><div class="hp78-usp__icon">{{ block.settings.icon }}</div><div><p class="hp78-usp__title">{{ block.settings.title }}</p><p class="hp78-usp__desc">{{ block.settings.desc }}</p></div></div>{% endfor %}{% if section.blocks.size==0 %}<div class="hp78-usp__item"><div class="hp78-usp__icon">✓</div><div><p class="hp78-usp__title">Free Shipping</p><p class="hp78-usp__desc">Over ₹999</p></div></div><div class="hp78-usp__item"><div class="hp78-usp__icon">↺</div><div><p class="hp78-usp__title">Easy Returns</p><p class="hp78-usp__desc">7 days</p></div></div><div class="hp78-usp__item"><div class="hp78-usp__icon">✦</div><div><p class="hp78-usp__title">COD Available</p><p class="hp78-usp__desc">Pan India</p></div></div><div class="hp78-usp__item"><div class="hp78-usp__icon">★</div><div><p class="hp78-usp__title">4.8 Rated</p><p class="hp78-usp__desc">50k Reviews</p></div></div>{% endif %}</div>{% schema %}{"name":"HP78 USP","settings":[{"type":"color","id":"bg_color","label":"BG","default":"#ffffff"}],"blocks":[{"type":"usp","name":"USP","settings":[{"type":"text","id":"icon","label":"Icon","default":"✓"},{"type":"text","id":"title","label":"Title","default":"Free Shipping"},{"type":"text","id":"desc","label":"Desc","default":"Over ₹999"}]}]}{% endschema %}