{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Italiana&family=Syne:wght@400;600;700;800&display=swap');

  #shopify-section-{{ section.id }} {
    --hp50-bg: {{ section.settings.bg_color | default: '#000000' }};
    --hp50-text: {{ section.settings.text_color | default: '#FFFFFF' }};
    --hp50-silver: {{ section.settings.accent_silver | default: '#E2E8F0' }};
    --hp50-card-bg: {{ section.settings.card_bg | default: '#111111' }};
    --hp50-btn-bg: {{ section.settings.btn_bg | default: '#FFFFFF' }};
    --hp50-btn-text-color: {{ section.settings.btn_text_color | default: '#000000' }};
    
    background-color: var(--hp50-bg);
    color: var(--hp50-text);
    font-family: 'Syne', sans-serif;
    padding-top: {{ section.settings.padding_top | default: 100 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 100 }}px;
    position: relative;
    overflow: hidden;
  }

  .hp50-hero__container {
    max-width: {{ section.settings.container_width | default: 1280 }}px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  .hp50-hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 18px;
    background: #111111;
    border: 1px solid rgba(226, 232, 240, 0.3);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--hp50-silver);
    margin-bottom: 24px;
  }

  .hp50-hero__title {
    font-family: 'Italiana', serif;
    font-size: clamp(42px, 6vw, 68px);
    font-weight: 400;
    line-height: 1.05;
    color: #FFFFFF;
    margin: 0 0 22px;
    letter-spacing: 1px;
  }

  .hp50-hero__title em {
    font-family: 'Syne', sans-serif;
    font-style: normal;
    font-weight: 800;
    background: linear-gradient(135deg, #FFFFFF, #94A3B8);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hp50-hero__desc {
    font-size: 15px;
    line-height: 1.8;
    color: #94A3B8;
    margin: 0 0 36px;
    max-width: 520px;
    font-weight: 400;
  }

  .hp50-hero__actions {
    display: flex;
    gap: 16px;
    align-items: center;
    flex-wrap: wrap;
  }

  .hp50-hero__btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 36px;
    background: var(--hp50-btn-bg);
    color: var(--hp50-btn-text-color);
    font-family: 'Syne', sans-serif;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
    text-decoration: none;
    border: 1px solid #FFFFFF;
    transition: all 0.3s ease;
  }

  .hp50-hero__btn-primary:hover {
    background: transparent;
    color: #FFFFFF;
  }

  .hp50-hero__media-frame {
    position: relative;
    border: 1px solid rgba(226, 232, 240, 0.25);
    background: #111111;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.8);
    height: 520px;
    overflow: hidden;
  }

  .hp50-hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: grayscale(40%) contrast(1.1);
  }

  .hp50-hero__floating-card {
    position: absolute;
    bottom: 24px;
    left: 24px;
    right: 24px;
    background: rgba(0, 0, 0, 0.88);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(226, 232, 240, 0.3);
    padding: 16px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .hp50-hero__float-title {
    font-family: 'Italiana', serif;
    font-size: 18px;
    color: #FFFFFF;
    margin: 0;
  }

  .hp50-hero__float-sub {
    font-size: 11px;
    color: #94A3B8;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin: 0;
  }

  @media screen and (max-width: 992px) {
    .hp50-hero__container { grid-template-columns: 1fr; text-align: center; }
    .hp50-hero__desc { margin-left: auto; margin-right: auto; }
    .hp50-hero__actions { justify-content: center; }
    .hp50-hero__media-frame { height: 380px; }
  }
{%- endstyle -%}

<div class="hp50-hero__container">
  <div>
    <div class="hp50-hero__badge">
      <span>✦</span>
      <span>{{ section.settings.badge | default: 'RUNWAY NOIR EDITORIAL v50' }}</span>
    </div>

    <h1 class="hp50-hero__title">
      {{ section.settings.heading | default: 'Runway Noir & <em>Sterling Silver</em> Haute Care' }}
    </h1>

    <p class="hp50-hero__desc">
      {{ section.settings.description | default: 'High-fashion editorial skincare engineered with platinum micro-peptides and obsidian mineral catalysts for sharp runway contour definition.' }}
    </p>

    <div class="hp50-hero__actions">
      <a href="{{ section.settings.btn_url | default: '/collections/all' }}" class="hp50-hero__btn-primary">
        <span>{{ section.settings.btn_text | default: 'View Runway Collection' }}</span>
        <span>&rarr;</span>
      </a>
    </div>
  </div>

  <div class="hp50-hero__media-frame">
    {%- if section.settings.image != blank -%}
      <img height="{{ section.settings.image.height }}" width="{{ section.settings.image.width }}" src="{{ section.settings.image | image_url: width: 1000 }}" class="hp50-hero__img" alt="{{ section.settings.heading }}" loading="eager">
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'hp50-hero__img' }}
    {%- endif -%}

    <div class="hp50-hero__floating-card">
      <div>
        <p class="hp50-hero__float-title">Platinum Peptide Catalyst</p>
        <p class="hp50-hero__float-sub">Paris Fashion Week Approved</p>
      </div>
      <span>✦</span>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "HP50 - Runway Hero",
  "class": "section-hp50-hero",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#000000" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#FFFFFF" },
    { "type": "color", "id": "accent_silver", "label": "Silver Accent", "default": "#E2E8F0" },
    { "type": "color", "id": "btn_bg", "label": "Button Background", "default": "#FFFFFF" },
    { "type": "color", "id": "btn_text_color", "label": "Button Text Color", "default": "#000000" },
    { "type": "text", "id": "badge", "label": "Badge", "default": "RUNWAY NOIR EDITORIAL v50" },
    { "type": "textarea", "id": "heading", "label": "Heading (HTML allowed)", "default": "Runway Noir & <em>Sterling Silver</em> Haute Care" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "High-fashion editorial skincare engineered with platinum micro-peptides." },
    { "type": "text", "id": "btn_text", "label": "Button Text", "default": "View Runway Collection" },
    { "type": "url", "id": "btn_url", "label": "Button URL" },
    { "type": "image_picker", "id": "image", "label": "Hero Image" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 100 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 100 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "presets": [
    { "name": "HP50 - Runway Hero" }
  ]
}
{% endschema %}
