{%- style -%}
  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --border-color: {{ section.settings.border_color }};
    --font-heading: 'Playfair Display', serif;
    --font-body: 'Jost', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }

  .hp21-tiles-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp21-tiles-wrapper {
      padding: 0 20px;
    }
  }

  .hp21-tiles__grid {
    display: grid;
    gap: {{ section.settings.gap }}px;
    /* Create a nice asymmetrical masonry-ish look using grid areas if needed, or simple columns */
    grid-template-columns: repeat({{ section.settings.desktop_columns }}, 1fr);
  }

  @media screen and (max-width: 992px) {
    .hp21-tiles__grid {
      grid-template-columns: repeat({{ section.settings.tablet_columns }}, 1fr);
    }
  }

  @media screen and (max-width: 768px) {
    .hp21-tiles__grid {
      grid-template-columns: repeat({{ section.settings.mobile_columns }}, 1fr);
      gap: {{ section.settings.mobile_gap }}px;
    }
  }

  .hp21-tiles__item {
    position: relative;
    display: block;
    aspect-ratio: {{ section.settings.aspect_ratio }};
    overflow: hidden;
    text-decoration: none;
    border: 1px solid var(--border-color);
  }

  .hp21-tiles__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.5s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .hp21-tiles__item:hover .hp21-tiles__image {
    transform: scale(1.08);
  }

  .hp21-tiles__overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0,0,0,0.4);
    transition: background 0.5s ease;
  }

  .hp21-tiles__item:hover .hp21-tiles__overlay {
    background: rgba(0,0,0,0.2);
  }

  .hp21-tiles__content {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    width: 90%;
    z-index: 2;
    padding: 24px;
    border: 1px solid rgba(255,255,255,0);
    transition: all 0.5s ease;
  }

  .hp21-tiles__item:hover .hp21-tiles__content {
    border-color: rgba(255,255,255,0.3);
    width: 85%;
    height: 85%;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .hp21-tiles__title {
    font-family: var(--font-heading);
    font-size: {{ section.settings.title_size }}px;
    font-weight: 400;
    color: var(--text-color);
    margin: 0;
    line-height: 1.2;
    transition: transform 0.5s ease;
  }

  .hp21-tiles__subtitle {
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 300;
    letter-spacing: 2px;
    color: var(--text-color);
    text-transform: uppercase;
    margin-top: 12px;
    opacity: 0;
    transform: translateY(10px);
    transition: all 0.5s ease;
  }

  .hp21-tiles__item:hover .hp21-tiles__title {
    transform: translateY(-5px);
  }

  .hp21-tiles__item:hover .hp21-tiles__subtitle {
    opacity: 1;
    transform: translateY(0);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp21-tiles-wrapper" id="HP21CategoryTiles-{{ section.id }}">
  <div class="hp21-tiles__grid">
    
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.link | default: '#' }}" class="hp21-tiles__item" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title | escape }}" class="hp21-tiles__image" loading="lazy">
        {%- else -%}
          {{ 'collection-' | append: forloop.index | placeholder_svg_tag: 'hp21-tiles__image' }}
        {%- endif -%}
        
        <div class="hp21-tiles__overlay"></div>
        
        <div class="hp21-tiles__content">
          <h3 class="hp21-tiles__title">{{ block.settings.title | escape }}</h3>
          <span class="hp21-tiles__subtitle">{{ section.settings.hover_text | escape }}</span>
        </div>
      </a>
    {%- endfor -%}

  </div>
</div>

{% schema %}
{
  "name": "HP21 - Luxury Tiles",
  "class": "section-hp21-category-tiles",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1400
    },
    {
      "type": "range",
      "id": "desktop_columns",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Desktop Columns",
      "default": 3
    },
    {
      "type": "range",
      "id": "tablet_columns",
      "min": 1,
      "max": 3,
      "step": 1,
      "label": "Tablet Columns",
      "default": 2
    },
    {
      "type": "range",
      "id": "mobile_columns",
      "min": 1,
      "max": 2,
      "step": 1,
      "label": "Mobile Columns",
      "default": 1
    },
    {
      "type": "range",
      "id": "gap",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Desktop Gap",
      "default": 24
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "min": 10,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Mobile Gap",
      "default": 16
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Tile Aspect Ratio",
      "options": [
        { "value": "1/1", "label": "Square (1:1)" },
        { "value": "3/4", "label": "Portrait (3:4)" },
        { "value": "4/3", "label": "Landscape (4:3)" }
      ],
      "default": "3/4"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "hover_text",
      "label": "Hover Subtitle",
      "default": "EXPLORE"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Title Size",
      "default": 32
    },
    {
      "type": "header",
      "content": "Luxury Styling"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#0A0A0A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "rgba(255, 255, 255, 0.1)"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Tile",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "THE EDIT"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP21 - Luxury Tiles",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
