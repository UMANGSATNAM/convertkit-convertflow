{%- liquid
  assign sec_id = section.id
-%}

<style>
  #shopify-section-{{ sec_id }} {
    background-color: {{ section.settings.bg_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px 0;
  }

  .hp20-faq-{{ sec_id }} {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp20-faq-{{ sec_id }}__header {
    text-align: center;
    margin-bottom: 60px;
  }

  .hp20-faq-{{ sec_id }}__title {
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 300;
    color: {{ section.settings.text_color }};
    margin: 0;
    letter-spacing: -0.02em;
  }

  .hp20-faq-list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid rgba({{ section.settings.text_color | color_to_rgb | remove: 'rgb(' | remove: ')' }}, {{ 0.1 }});
  }

  .hp20-faq-item {
    border-bottom: 1px solid rgba({{ section.settings.text_color | color_to_rgb | remove: 'rgb(' | remove: ')' }}, {{ 0.1 }});
  }

  .hp20-faq-item__btn {
    width: 100%;
    text-align: left;
    background: transparent;
    border: none;
    padding: 32px 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-size: 20px;
    font-weight: 400;
    color: {{ section.settings.text_color }};
  }

  .hp20-faq-item__icon {
    width: 24px;
    height: 24px;
    position: relative;
    flex-shrink: 0;
  }
  
  .hp20-faq-item__icon::before,
  .hp20-faq-item__icon::after {
    content: '';
    position: absolute;
    background-color: {{ section.settings.text_color }};
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    transition: transform 0.3s ease;
  }

  .hp20-faq-item__icon::before {
    width: 14px;
    height: 1px;
  }

  .hp20-faq-item__icon::after {
    width: 1px;
    height: 14px;
  }

  .hp20-faq-item.is-open .hp20-faq-item__icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .hp20-faq-item__content {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s ease;
  }

  .hp20-faq-item__inner {
    padding-bottom: 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 15px;
    line-height: 1.6;
    color: {{ section.settings.text_color }};
    opacity: 0.8;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ sec_id }} {
      padding: {{ section.settings.padding_top_mobile }}px 0 {{ section.settings.padding_bottom_mobile }}px 0;
    }
    .hp20-faq-item__btn {
      padding: 24px 0;
      font-size: 18px;
    }
    .hp20-faq-item__inner {
      padding-bottom: 24px;
    }
  }
</style>

<section class="hp20-faq-{{ sec_id }}">
  <div class="hp20-faq-{{ sec_id }}__header">
    <h2 class="hp20-faq-{{ sec_id }}__title">{{ section.settings.title }}</h2>
  </div>

  <div class="hp20-faq-list" id="hp20-faq-{{ sec_id }}">
    {% for block in section.blocks %}
      <div class="hp20-faq-item" {{ block.shopify_attributes }}>
        <button type="button" class="hp20-faq-item__btn" aria-expanded="false">
          {{ block.settings.question }}
          <span class="hp20-faq-item__icon"></span>
        </button>
        <div class="hp20-faq-item__content">
          <div class="hp20-faq-item__inner">
            {{ block.settings.answer }}
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const list = document.getElementById('hp20-faq-{{ sec_id }}');
    if(!list) return;
    const items = list.querySelectorAll('.hp20-faq-item');
    
    items.forEach(item => {
      const btn = item.querySelector('.hp20-faq-item__btn');
      const content = item.querySelector('.hp20-faq-item__content');
      
      btn.addEventListener('click', () => {
        const isOpen = item.classList.contains('is-open');
        
        // Close all
        items.forEach(otherItem => {
          otherItem.classList.remove('is-open');
          otherItem.querySelector('.hp20-faq-item__btn').setAttribute('aria-expanded', 'false');
          otherItem.querySelector('.hp20-faq-item__content').style.maxHeight = null;
        });
        
        if(!isOpen) {
          item.classList.add('is-open');
          btn.setAttribute('aria-expanded', 'true');
          content.style.maxHeight = content.scrollHeight + "px";
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "HP20 FAQ Accordion",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1a1a1a"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0, "max": 160, "step": 10, "unit": "px",
      "label": "Desktop Top Padding", "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0, "max": 160, "step": 10, "unit": "px",
      "label": "Desktop Bottom Padding", "default": 120
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0, "max": 100, "step": 10, "unit": "px",
      "label": "Mobile Top Padding", "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0, "max": 100, "step": 10, "unit": "px",
      "label": "Mobile Bottom Padding", "default": 60
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What materials do you use?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>We source only the highest quality sustainable materials for our minimalist collection.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP20 FAQ Accordion",
      "blocks": [
        { "type": "faq" },
        { "type": "faq" },
        { "type": "faq" }
      ]
    }
  ]
}
{% endschema %}
