<style>
@media screen and (max-width: 768px) {
  .hp51-press-logos {
    padding-left: 16px !important;
    padding-right: 16px !important;
    box-sizing: border-box !important;
  }
  img {
    max-width: 100% !important;
    height: auto !important;
  }
}
</style>
{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp51-press-bg: {{ section.settings.bg_color | default: '#F2EFE9' }};
    
    background-color: var(--hp51-press-bg);
    padding: {{ section.settings.padding_vertical | default: 30 }}px 0;
    border-top: 1px solid rgba(30, 58, 43, 0.1);
    border-bottom: 1px solid rgba(30, 58, 43, 0.1);
  }

  .hp51-press__wrap {
    max-width: {{ section.settings.container_width | default: 1100 }}px;
    margin: 0 auto;
    padding: 0 20px;
    display: flex;
    justify-content: space-around;
    align-items: center;
    flex-wrap: wrap;
    gap: 30px;
    font-family: 'Noto Serif JP', serif;
    font-size: 20px;
    font-weight: 700;
    color: #1E3A2B;
    opacity: 0.8;
  }
{%- endstyle -%}

<div class="hp51-press__wrap">
  {%- if section.blocks.size > 0 -%}
    {%- for block in section.blocks -%}
      <span {{ block.shopify_attributes }}>{{ block.settings.title }}</span>
    {%- endfor -%}
  {%- else -%}
    <span>VOGUE JAPAN</span>
    <span>ELLE KYOTO</span>
    <span>HARPER'S BAZAAR</span>
    <span>MONOCLE WELLNESS</span>
    <span>KATEIGAHO</span>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "HP51 - Zen Press",
  "class": "section-hp51-press",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#F2EFE9" },
    { "type": "range", "id": "padding_vertical", "min": 15, "max": 60, "step": 5, "unit": "px", "label": "Vertical Padding", "default": 30 },
    { "type": "range", "id": "container_width", "min": 800, "max": 1400, "step": 20, "unit": "px", "label": "Container Width", "default": 1100 }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Press Item",
      "settings": [
        { "type": "text", "id": "title", "label": "Publication Name", "default": "VOGUE JAPAN" }
      ]
    }
  ],
  "presets": [
    { "name": "HP51 - Zen Press" }
  ]
}
{% endschema %}
