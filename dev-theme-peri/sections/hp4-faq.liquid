{%- liquid
  assign bg_color = section.settings.bg_color | default: '#ffffff'
  assign text_color = section.settings.text_color | default: '#2c2c2c'
  
  assign padding_top_desktop = section.settings.padding_top_desktop
  assign padding_bottom_desktop = section.settings.padding_bottom_desktop
  assign padding_top_mobile = section.settings.padding_top_mobile
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile
-%}

<style>
  #shopify-section-{{ section.id }} {
    --hp4-faq-bg: {{ bg_color }};
    --hp4-faq-text: {{ text_color }};
    
    --hp4-faq-pt-desk: {{ padding_top_desktop }}px;
    --hp4-faq-pb-desk: {{ padding_bottom_desktop }}px;
    --hp4-faq-pt-mob: {{ padding_top_mobile }}px;
    --hp4-faq-pb-mob: {{ padding_bottom_mobile }}px;
  }

  .hp4-decor-faq-{{ section.id }} {
    padding-top: var(--hp4-faq-pt-desk);
    padding-bottom: var(--hp4-faq-pb-desk);
    background-color: var(--hp4-faq-bg);
    color: var(--hp4-faq-text);
    font-family: 'Inter', sans-serif;
  }

  .hp4-faq-inner {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .hp4-faq-header {
    text-align: center;
    margin-bottom: 50px;
  }

  .hp4-faq-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 400;
    line-height: 1.2;
    margin: 0;
  }
  .hp4-faq-title em { font-style: italic; }

  /* Accordion Styling */
  .hp4-faq-list {
    border-top: 1px solid rgba(0,0,0,0.1);
  }

  .hp4-faq-item {
    border-bottom: 1px solid rgba(0,0,0,0.1);
  }

  .hp4-faq-question {
    width: 100%;
    text-align: left;
    background: transparent;
    border: none;
    padding: 30px 0;
    font-family: 'Playfair Display', serif;
    font-size: 20px;
    font-weight: 400;
    color: var(--hp4-faq-text);
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: color 0.3s ease;
  }

  .hp4-faq-icon {
    position: relative;
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    margin-left: 20px;
  }
  .hp4-faq-icon::before, .hp4-faq-icon::after {
    content: '';
    position: absolute;
    background: currentColor;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    transition: transform 0.3s ease;
  }
  .hp4-faq-icon::before { width: 100%; height: 1px; }
  .hp4-faq-icon::after { height: 100%; width: 1px; }

  .hp4-faq-item.is-open .hp4-faq-icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
    opacity: 0;
  }

  .hp4-faq-answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .hp4-faq-answer-inner {
    padding-bottom: 30px;
    font-size: 15px;
    line-height: 1.8;
    color: rgba(44,44,44,0.7);
    font-weight: 300;
  }
  .hp4-faq-answer-inner p { margin: 0 0 15px 0; }
  .hp4-faq-answer-inner p:last-child { margin: 0; }

  @media screen and (max-width: 768px) {
    .hp4-decor-faq-{{ section.id }} {
      padding-top: var(--hp4-faq-pt-mob);
      padding-bottom: var(--hp4-faq-pb-mob);
    }
    .hp4-faq-inner {
      padding: 0 20px;
    }
    .hp4-faq-question {
      font-size: 18px;
      padding: 20px 0;
    }
    .hp4-faq-answer-inner {
      padding-bottom: 20px;
    }
  }
</style>

<section class="hp4-decor-faq-{{ section.id }}" aria-label="FAQ">
  <div class="hp4-faq-inner">
    
    {%- if section.settings.heading != blank -%}
      <div class="hp4-faq-header">
        <h2 class="hp4-faq-title">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    <div class="hp4-faq-list">
      {%- for block in section.blocks -%}
        <div class="hp4-faq-item" {{ block.shopify_attributes }}>
          <button class="hp4-faq-question" aria-expanded="false">
            {{ block.settings.question }}
            <span class="hp4-faq-icon"></span>
          </button>
          <div class="hp4-faq-answer">
            <div class="hp4-faq-answer-inner">
              {{ block.settings.answer }}
            </div>
          </div>
        </div>
      {%- endfor -%}

      {%- if section.blocks.size == 0 -%}
        {%- for i in (1..4) -%}
          <div class="hp4-faq-item">
            <button class="hp4-faq-question" aria-expanded="false">
              Where are your products made?
              <span class="hp4-faq-icon"></span>
            </button>
            <div class="hp4-faq-answer">
              <div class="hp4-faq-answer-inner">
                <p>We work with master artisans across the globe. Each piece is crafted in small batches using traditional techniques and sustainable materials.</p>
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const section = document.querySelector('.hp4-decor-faq-{{ section.id }}');
    if(!section) return;

    const questions = section.querySelectorAll('.hp4-faq-question');
    questions.forEach(q => {
      q.addEventListener('click', function() {
        const item = this.parentElement;
        const answer = item.querySelector('.hp4-faq-answer');
        const isOpen = item.classList.contains('is-open');

        // Close all others (optional)
        section.querySelectorAll('.hp4-faq-item').forEach(otherItem => {
          if(otherItem !== item) {
            otherItem.classList.remove('is-open');
            otherItem.querySelector('.hp4-faq-answer').style.maxHeight = null;
            otherItem.querySelector('.hp4-faq-question').setAttribute('aria-expanded', 'false');
          }
        });

        // Toggle current
        if(isOpen) {
          item.classList.remove('is-open');
          answer.style.maxHeight = null;
          this.setAttribute('aria-expanded', 'false');
        } else {
          item.classList.add('is-open');
          answer.style.maxHeight = answer.scrollHeight + "px";
          this.setAttribute('aria-expanded', 'true');
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "HP4 Decor FAQ",
  "tag": "section",
  "class": "section-hp4-faq",
  "settings": [
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently <em>Asked</em>"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2c2c2c"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Top (Desktop)", "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Bottom (Desktop)", "default": 100
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Top (Mobile)", "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Bottom (Mobile)", "default": 60
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What is your return policy?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>We accept returns within 30 days of delivery for a full refund. Items must be in original condition and packaging.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP4 Decor FAQ",
      "category": "Text",
      "blocks": [
        { "type": "faq" },
        { "type": "faq" },
        { "type": "faq" },
        { "type": "faq" }
      ]
    }
  ]
}
{% endschema %}
