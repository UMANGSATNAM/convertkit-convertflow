{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: "#080B10" }};
    padding: 90px 20px;
  }

  .hp43-news__box {
    max-width: 740px;
    margin: 0 auto;
    background: #101622;
    border: 1px solid #1E293B;
    border-radius: 8px;
    padding: 50px 30px;
    text-align: center;
    box-shadow: 0 20px 50px rgba(0,0,0,0.5);
    position: relative;
    overflow: hidden;
  }

  .hp43-news__title {
    font-family: 'Orbitron', sans-serif;
    font-size: 30px;
    font-weight: 800;
    color: #F1F5F9;
    margin: 0 0 12px;
    text-transform: uppercase;
  }

  .hp43-news__desc {
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    color: #64748B;
    margin: 0 0 30px;
  }

  .hp43-news__form {
    display: flex;
    gap: 12px;
    max-width: 500px;
    margin: 0 auto;
  }

  .hp43-news__input {
    flex: 1;
    padding: 16px 20px;
    border: 1px solid #1E293B;
    border-radius: 4px;
    background: #080B10;
    color: #F1F5F9;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
  }

  .hp43-news__input:focus {
    outline: none;
    border-color: #00F0FF;
    box-shadow: 0 0 15px rgba(0, 240, 255, 0.3);
  }

  .hp43-news__btn {
    padding: 16px 32px;
    background: #00F0FF;
    color: #080B10;
    border: none;
    border-radius: 4px;
    font-family: 'Rajdhani', sans-serif;
    font-size: 16px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1px;
    cursor: pointer;
    box-shadow: 0 0 20px rgba(0, 240, 255, 0.3);
  }

  @media screen and (max-width: 600px) {
    .hp43-news__form { flex-direction: column; }
  }
{%- endstyle -%}

<div class="hp43-news__box">
  <h2 class="hp43-news__title">JOIN THE CYBER DISPATCH</h2>
  <p class="hp43-news__desc">Get instant notifications on limited hardware drops and VIP protocol codes.</p>
  <form class="hp43-news__form" onsubmit="event.preventDefault(); alert('AUTHENTICATED: Subscribed to Cyber Dispatch');">
    <input type="email" class="hp43-news__input" placeholder="Enter your email address" required>
    <button type="submit" class="hp43-news__btn">SUBSCRIBE</button>
  </form>
</div>

{% schema %}
{
  "name": "HP43 - Cyber Newsletter",
  "class": "section-hp43-newsletter",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#080B10"
    }
  ],
  "presets": [
    {
      "name": "HP43 - Cyber Newsletter"
    }
  ]
}
{% endschema %}
