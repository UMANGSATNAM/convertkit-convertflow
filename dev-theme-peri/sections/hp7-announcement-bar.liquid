{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#4a6741'
  assign text_color = section.settings.text_color | default: '#f7f4ed'
  assign speed = section.settings.speed | default: 20
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    color: {{ text_color }};
    padding: 10px 0;
    overflow: hidden;
    position: relative;
    font-family: 'DM Sans', 'Inter', sans-serif;
    border-bottom: 1px solid rgba(247, 244, 237, 0.1);
  }
  
  .hp7-announcement-wrapper-{{ section_id }} {
    display: flex;
    white-space: nowrap;
    overflow: hidden;
  }
  
  .hp7-announcement-track-{{ section_id }} {
    display: flex;
    align-items: center;
    gap: 40px;
    padding-right: 40px;
    animation: hp7Scroll {{ speed }}s linear infinite;
  }
  
  .hp7-announcement-item-{{ section_id }} {
    display: flex;
    align-items: center;
    gap: 15px;
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 0.5px;
  }
  
  .hp7-announcement-icon-{{ section_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  
  .hp7-announcement-icon-{{ section_id }} svg {
    width: 16px;
    height: 16px;
    fill: currentColor;
    opacity: 0.8;
  }
  
  @keyframes hp7Scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-100%); }
  }
  
  /* Pause on hover for accessibility */
  .hp7-announcement-wrapper-{{ section_id }}:hover .hp7-announcement-track-{{ section_id }} {
    animation-play-state: paused;
  }

@media screen and (max-width: 768px) {
  .hp7-announcement-bar {
    padding-left: 16px !important;
    padding-right: 16px !important;
    box-sizing: border-box !important;
  }
  img {
    max-width: 100% !important;
    height: auto !important;
  }
}

</style>

<div class="hp7-announcement-wrapper-{{ section_id }}">
  {%- for i in (1..3) -%}
    <div class="hp7-announcement-track-{{ section_id }}" aria-hidden="{% if forloop.index > 1 %}true{% else %}false{% endif %}">
      {%- for block in section.blocks -%}
        <div class="hp7-announcement-item-{{ section_id }}" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != 'none' -%}
            <span class="hp7-announcement-icon-{{ section_id }}">
              {%- case block.settings.icon -%}
                {%- when 'leaf' -%}
                  <svg viewBox="0 0 24 24"><path d="M17.5,3.34C15.82,2.37 13.91,2 12,2C6.48,2 2,6.48 2,12C2,17.52 6.48,22 12,22C17.52,22 22,17.52 22,12C22,9.65 21.13,7.5 19.74,5.83C19.86,5.33 19.95,4.82 20,4.3C20.08,3.46 19.84,2.62 19.34,1.96C18.84,1.31 18.06,0.92 17.2,0.85C16.34,0.78 15.5,1.06 14.88,1.61C14.26,2.16 13.92,2.94 13.95,3.8L14.05,6.17C12.19,6.04 10.33,6.23 8.61,6.77L17.5,3.34M12,4C14.54,4 16.92,4.86 18.81,6.31L8.29,10.36C9.17,9.08 10.43,8.08 11.91,7.5C11.94,7.49 11.97,7.49 12,7.48V4M12,20C7.58,20 4,16.42 4,12C4,9.63 5.03,7.5 6.66,6.05L16.27,15.66C15.11,16.82 13.63,17.65 12,18.04V20Z" /></svg>
                {%- when 'recycle' -%}
                  <svg viewBox="0 0 24 24"><path d="M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4M15,16H9V14H15V16M13,12H9V10H13V12M17,8H9V6H17V8Z" /></svg>
                {%- when 'heart' -%}
                  <svg viewBox="0 0 24 24"><path d="M12,21.35L10.55,20.03C5.4,15.36 2,12.28 2,8.5C2,5.42 4.42,3 7.5,3C9.24,3 10.91,3.81 12,5.09C13.09,3.81 14.76,3 16.5,3C19.58,3 22,5.42 22,8.5C22,12.28 18.6,15.36 13.45,20.04L12,21.35Z" /></svg>
                {%- when 'truck' -%}
                  <svg viewBox="0 0 24 24"><path d="M20,8H17V4H3C1.89,4 1,4.89 1,6V17H3A3,3 0 0,0 6,20A3,3 0 0,0 9,17H15A3,3 0 0,0 18,20A3,3 0 0,0 21,17H23V12L20,8M6,18.5A1.5,1.5 0 0,1 4.5,17A1.5,1.5 0 0,1 6,15.5A1.5,1.5 0 0,1 7.5,17A1.5,1.5 0 0,1 6,18.5M18,18.5A1.5,1.5 0 0,1 16.5,17A1.5,1.5 0 0,1 18,15.5A1.5,1.5 0 0,1 19.5,17A1.5,1.5 0 0,1 18,18.5M17,12V9.5H19.5L21.47,12H17Z" /></svg>
              {%- endcase -%}
            </span>
          {%- endif -%}
          <span>{{ block.settings.text }}</span>
        </div>
      {%- endfor -%}
    </div>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "HP7 Announcement Bar",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#4a6741"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#f7f4ed"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Animation Speed",
      "min": 10,
      "max": 50,
      "step": 1,
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "recycle", "label": "Recycle" },
            { "value": "heart", "label": "Heart" },
            { "value": "truck", "label": "Truck" }
          ],
          "default": "leaf"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "100% Organic Materials"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP7 Announcement Bar",
      "blocks": [
        { "type": "message", "settings": { "text": "Sustainable Materials", "icon": "leaf" } },
        { "type": "message", "settings": { "text": "Carbon Neutral Shipping", "icon": "truck" } },
        { "type": "message", "settings": { "text": "Ethically Sourced", "icon": "heart" } }
      ]
    }
  ]
}
{% endschema %}
