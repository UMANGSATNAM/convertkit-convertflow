{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp52-feat-bg: {{ section.settings.bg_color | default: '#F7EFE6' }};
    --hp52-terra: {{ section.settings.accent_terra | default: '#C2593F' }};
    
    background-color: var(--hp52-feat-bg);
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }

  .hp52-feat__wrap {
    max-width: {{ section.settings.container_width | default: 1240 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp52-feat__header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 50px;
  }

  .hp52-feat__heading {
    font-family: 'Bodoni Moda', serif;
    font-size: clamp(32px, 4.5vw, 44px);
    font-weight: 700;
    color: #2D3B2D;
    margin: 0 0 8px;
  }

  .hp52-feat__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: 3 }}, 1fr);
    gap: 24px;
  }

  .hp52-feat__card {
    background: #FFFDF9;
    border: 1px solid rgba(194, 89, 63, 0.15);
    border-radius: 36px 36px 12px 12px;
    padding: 36px 28px;
    box-shadow: 0 10px 30px rgba(45, 59, 45, 0.04);
    transition: all 0.3s ease;
  }

  .hp52-feat__card:hover {
    border-color: var(--hp52-terra);
    transform: translateY(-4px);
    box-shadow: 0 15px 40px rgba(194, 89, 63, 0.1);
  }

  .hp52-feat__title {
    font-family: 'Bodoni Moda', serif;
    font-size: 18px;
    font-weight: 700;
    color: #2D3B2D;
    margin: 0 0 12px;
  }

  .hp52-feat__desc {
    font-size: 14px;
    line-height: 1.8;
    color: #5C675B;
    margin: 0;
  }

  @media screen and (max-width: 992px) {
    .hp52-feat__grid { grid-template-columns: 1fr; }
  }
{%- endstyle -%}

<div class="hp52-feat__wrap">
  <div class="hp52-feat__header">
    <h2 class="hp52-feat__heading">Artisanal Italian Formulation Craft</h2>
    <p style="font-size:14px; color:#5C675B;">{{ section.settings.subheading | default: 'Ancient Mediterranean apothecaries combined with modern lipid barrier science.' }}</p>
  </div>

  <div class="hp52-feat__grid">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <div class="hp52-feat__card" {{ block.shopify_attributes }}>
          <h3 class="hp52-feat__title">{{ block.settings.title }}</h3>
          <p class="hp52-feat__desc">{{ block.settings.description }}</p>
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="hp52-feat__card">
        <h3 class="hp52-feat__title">Single-Estate Olive Groves</h3>
        <p class="hp52-feat__desc">Harvested exclusively from organically farmed family estates in Chianti, cold-pressed within four hours of picking.</p>
      </div>
      <div class="hp52-feat__card">
        <h3 class="hp52-feat__title">Sicilian Volcanic Minerals</h3>
        <p class="hp52-feat__desc">Naturally rich in magnesium, iron, and potassium to restore cellular vitality and draw out environmental micro-toxins.</p>
      </div>
      <div class="hp52-feat__card">
        <h3 class="hp52-feat__title">Sun-Cured Herbal Macerates</h3>
        <p class="hp52-feat__desc">Calendula, wild rosemary, and chamomile infused slowly in Italian sunlight to capture volatile therapeutic bio-actives.</p>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP52 - Terra Feat",
  "class": "section-hp52-features",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#F7EFE6" },
    { "type": "color", "id": "accent_terra", "label": "Terracotta Accent", "default": "#C2593F" },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "label": "Desktop Columns", "default": 3 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1240 }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Card",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Single-Estate Olive Groves" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Harvested exclusively from organically farmed estates." }
      ]
    }
  ],
  "presets": [
    { "name": "HP52 - Terra Feat" }
  ]
}
{% endschema %}
