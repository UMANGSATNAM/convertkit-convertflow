{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --card-bg: {{ section.settings.card_bg }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    
    --font-heading: 'Outfit', sans-serif;
    --font-body: 'Outfit', sans-serif;
    
    background-color: var(--bg-color);
    padding: 80px 20px;
  }

  .hp39-featured-wrapper {
    max-width: 1400px;
    margin: 0 auto;
  }

  .hp39-featured__header {
    text-align: center;
    margin-bottom: 60px;
  }

  .hp39-featured__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    font-weight: 700;
    color: var(--text-color);
    margin: 0 0 15px;
    letter-spacing: -0.5px;
  }

  .hp39-featured__subtitle {
    font-family: var(--font-body);
    font-size: 18px;
    color: var(--text-color);
    opacity: 0.7;
    margin: 0;
  }

  .hp39-featured__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 30px;
  }

  .hp39-fc-card {
    background: var(--card-bg);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.6);
    border-radius: 40px;
    padding: 20px;
    box-shadow: 0 20px 40px rgba(0,0,0,0.03);
    transition: transform 0.4s ease, box-shadow 0.4s ease;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .hp39-fc-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 30px 60px rgba(var(--accent-color-rgb, 0,0,0), 0.08);
  }

  .hp39-fc-card__image-wrapper {
    width: 100%;
    aspect-ratio: 4/5;
    border-radius: 25px;
    overflow: hidden;
    margin-bottom: 25px;
    background: #f0f0f0;
  }

  .hp39-fc-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .hp39-fc-card:hover .hp39-fc-card__image {
    transform: scale(1.05);
  }

  .hp39-fc-card__info {
    padding: 0 10px 10px;
    text-align: center;
  }

  .hp39-fc-card__title {
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 600;
    color: var(--text-color);
    margin: 0 0 10px;
  }

  .hp39-fc-card__price {
    font-family: var(--font-body);
    font-size: 16px;
    color: var(--text-color);
    opacity: 0.8;
  }

  .hp39-featured__footer {
    text-align: center;
    margin-top: 60px;
  }

  .hp39-featured__btn {
    display: inline-block;
    padding: 16px 40px;
    background: var(--accent-color);
    color: #fff;
    font-family: var(--font-heading);
    font-size: 16px;
    font-weight: 600;
    border-radius: 50px;
    text-decoration: none;
    box-shadow: 0 10px 20px rgba(0,0,0,0.1);
    transition: all 0.3s ease;
  }

  .hp39-featured__btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 15px 25px rgba(0,0,0,0.15);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp39-featured-wrapper" id="HP39Featured-{{ section.id }}">
  <div class="hp39-featured__header">
    <h2 class="hp39-featured__title">{{ section.settings.title }}</h2>
    {%- if section.settings.subtitle != blank -%}
      <p class="hp39-featured__subtitle">{{ section.settings.subtitle }}</p>
    {%- endif -%}
  </div>

  <div class="hp39-featured__grid">
    {%- assign collection = collections[section.settings.collection] -%}
    {%- if collection != blank and collection.products_count > 0 -%}
      {%- for product in collection.products limit: section.settings.limit -%}
        <a href="{{ product.url }}" class="hp39-fc-card">
          <div class="hp39-fc-card__image-wrapper">
            <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" class="hp39-fc-card__image" loading="lazy">
          </div>
          <div class="hp39-fc-card__info">
            <h3 class="hp39-fc-card__title">{{ product.title }}</h3>
            <div class="hp39-fc-card__price">{{ product.price | money }}</div>
          </div>
        </a>
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..section.settings.limit) -%}
        <a href="#" class="hp39-fc-card">
          <div class="hp39-fc-card__image-wrapper">
            {{ 'product-' | append: i | placeholder_svg_tag: 'hp39-fc-card__image' }}
          </div>
          <div class="hp39-fc-card__info">
            <h3 class="hp39-fc-card__title">Soft Product {{ i }}</h3>
            <div class="hp39-fc-card__price">$99.00</div>
          </div>
        </a>
      {%- endfor -%}
    {%- endif -%}
  </div>

  {%- if section.settings.btn_label != blank -%}
    <div class="hp39-featured__footer">
      <a href="{{ section.settings.btn_link | default: collection.url | default: '#' }}" class="hp39-featured__btn">
        {{ section.settings.btn_label }}
      </a>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "HP39 - Aura Collection",
  "class": "section-hp39-featured-collection",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Soft Essentials"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Curated for comfort."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Product Limit",
      "default": 4
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "View All"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 48
    },
    {
      "type": "header",
      "content": "Aura Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#faf9f8"
    },
    {
      "type": "color_background",
      "id": "card_bg",
      "label": "Card Glass Background",
      "default": "rgba(255, 255, 255, 0.7)"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2D2D2D"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#C7CEEA"
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP39 - Aura Collection"
    }
  ]
}
{% endschema %}
