{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;700&family=JetBrains+Mono:wght@400;700&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --grid-color: rgba(255, 255, 255, 0.1);
    
    --font-heading: 'Inter', sans-serif;
    --font-body: 'JetBrains Mono', monospace;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    border-bottom: 1px solid var(--grid-color);
  }

  .hp34-tiles-wrapper {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp34-tiles-wrapper {
      padding: 0 20px;
    }
  }

  .hp34-tiles__header {
    margin-bottom: 40px;
    border-bottom: 1px solid var(--grid-color);
    padding-bottom: 20px;
  }

  .hp34-tiles__subtitle {
    font-family: var(--font-body);
    font-size: 11px;
    color: var(--accent-color);
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 10px;
  }

  .hp34-tiles__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    line-height: 1;
    color: var(--text-color);
    margin: 0;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }

  .hp34-tiles__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--grid-color);
    border: 1px solid var(--grid-color);
  }

  @media screen and (max-width: 768px) {
    .hp34-tiles__grid {
      grid-template-columns: 1fr;
    }
  }

  .hp34-tile {
    position: relative;
    aspect-ratio: 16/9;
    background: var(--bg-color);
    text-decoration: none;
    display: block;
    overflow: hidden;
    group: card;
  }

  @media screen and (max-width: 768px) {
    .hp34-tile {
      aspect-ratio: 1/1;
    }
  }

  .hp34-tile__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.6;
    transition: transform 10s linear, opacity 0.3s ease;
    filter: grayscale(100%);
  }

  .hp34-tile:hover .hp34-tile__image {
    transform: scale(1.1);
    opacity: 1;
    filter: grayscale(0%);
  }

  .hp34-tile__content {
    position: absolute;
    top: 30px;
    left: 30px;
    z-index: 2;
  }

  .hp34-tile__title {
    font-family: var(--font-heading);
    font-size: clamp(24px, 4vw, 40px);
    color: #fff;
    margin: 0 0 5px;
    font-weight: 700;
    text-transform: uppercase;
    background: #000;
    display: inline-block;
    padding: 5px 10px;
  }

  .hp34-tile__tag {
    font-family: var(--font-body);
    font-size: 11px;
    color: var(--accent-color);
    text-transform: uppercase;
    letter-spacing: 2px;
    background: #000;
    display: inline-block;
    padding: 5px 10px;
    margin-top: 5px;
  }

  .hp34-tile__data {
    position: absolute;
    bottom: 30px;
    right: 30px;
    font-family: var(--font-body);
    font-size: 10px;
    color: var(--text-color);
    text-align: right;
    line-height: 1.5;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp34-tiles-wrapper" id="HP34Tiles-{{ section.id }}">
  <div class="hp34-tiles__header">
    {%- if section.settings.subtitle != blank -%}
      <div class="hp34-tiles__subtitle">{{ section.settings.subtitle }}</div>
    {%- endif -%}
    <h2 class="hp34-tiles__title">{{ section.settings.title }}</h2>
  </div>

  <div class="hp34-tiles__grid">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.link | default: '#' }}" class="hp34-tile" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          <img height="{{ block.settings.image.height }}" width="{{ block.settings.image.width }}" src="{{ block.settings.image | image_url: width: 1000 }}" alt="{{ block.settings.title | escape }}" class="hp34-tile__image" loading="lazy">
        {%- else -%}
          {%- assign placeholder = 'collection-' | append: forloop.index -%}
          {%- if forloop.index > 6 -%}{%- assign placeholder = 'collection-1' -%}{%- endif -%}
          {{ placeholder | placeholder_svg_tag: 'hp34-tile__image' }}
        {%- endif -%}
        
        <div class="hp34-tile__content">
          <h3 class="hp34-tile__title">{{ block.settings.title }}</h3><br>
          <div class="hp34-tile__tag">{{ block.settings.tag }}</div>
        </div>
        
        <div class="hp34-tile__data">
          LOC: {{ block.id | slice: 0, 6 | upcase }}<br>
          STAT: VERIFIED
        </div>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "HP34 - Tech Tiles",
  "class": "section-hp34-category-tiles",
  "max_blocks": 4,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "DIRECTORY"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "System Architecture"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 40
    },
    {
      "type": "header",
      "content": "Tech Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (e.g. Black)",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#FF4500"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Category Tile",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Core Layer"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Tag",
          "default": "[ BASE_LAYERS ]"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP34 - Tech Tiles",
      "blocks": [
        { "type": "tile", "settings": { "title": "Core Layer", "tag": "[ BASE_LAYERS ]" } },
        { "type": "tile", "settings": { "title": "Outer Shell", "tag": "[ JACKETS ]" } },
        { "type": "tile", "settings": { "title": "Hardware", "tag": "[ ACCESSORIES ]" } },
        { "type": "tile", "settings": { "title": "Footwear", "tag": "[ MOBILITY ]" } }
      ]
    }
  ]
}
{% endschema %}
