{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#050505'
  assign padding_top = section.settings.padding_top | default: 0
  assign padding_bottom = section.settings.padding_bottom | default: 0
-%}

<style>
  #shopify-section-{{ section_id }} {
    --bg-color: {{ bg_color }};
    --padding-top: {{ padding_top }}px;
    --padding-bottom: {{ padding_bottom }}px;
    
    background-color: var(--bg-color);
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
  }

  .hp7-insta-{{ section_id }} {
    max-width: 100%;
    margin: 0 auto;
    position: relative;
  }

  .hp7-insta__grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    grid-auto-rows: 20vw;
    gap: 0;
  }
  
  /* Asymmetrical Brutalist Layout */
  .hp7-insta__item:nth-child(1) { grid-column: span 2; grid-row: span 2; }
  .hp7-insta__item:nth-child(2) { grid-column: span 1; grid-row: span 1; }
  .hp7-insta__item:nth-child(3) { grid-column: span 2; grid-row: span 1; }
  .hp7-insta__item:nth-child(4) { grid-column: span 1; grid-row: span 2; }
  .hp7-insta__item:nth-child(5) { grid-column: span 2; grid-row: span 1; }

  .hp7-insta__item {
    position: relative;
    overflow: hidden;
    background: #111;
    border: 1px solid var(--bg-color);
  }

  .hp7-insta__link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hp7-insta__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    filter: brightness(0.8);
  }
  
  .hp7-insta__overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0,0,0,0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  
  .hp7-insta__link:hover .hp7-insta__image {
    transform: scale(1.05);
    filter: brightness(1);
  }

  .hp7-insta__link:hover .hp7-insta__overlay {
    opacity: 1;
  }

  .hp7-insta__icon {
    width: 48px;
    height: 48px;
    fill: #F4F4F0;
  }

  /* Center Badge / Title overlay */
  .hp7-insta__badge {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: #F4F4F0;
    color: #050505;
    padding: 2rem 4rem;
    text-align: center;
    z-index: 10;
    mix-blend-mode: normal;
  }
  
  .hp7-insta__badge-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2rem, 4vw, 4rem);
    font-weight: 700;
    text-transform: uppercase;
    margin: 0 0 1rem 0;
    line-height: 1;
  }
  
  .hp7-insta__badge-handle {
    font-family: 'Inter', monospace;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-decoration: none;
    color: inherit;
    border-bottom: 2px solid #050505;
  }

  @media screen and (max-width: 990px) {
    .hp7-insta__grid {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 50vw;
    }
    
    .hp7-insta__item:nth-child(1) { grid-column: span 2; grid-row: span 2; }
    .hp7-insta__item:nth-child(2) { grid-column: span 1; grid-row: span 1; }
    .hp7-insta__item:nth-child(3) { grid-column: span 1; grid-row: span 1; }
    .hp7-insta__item:nth-child(4) { grid-column: span 2; grid-row: span 1; }
    .hp7-insta__item:nth-child(5) { display: none; }
    
    .hp7-insta__badge {
      padding: 1.5rem 2rem;
    }
  }
</style>

<section class="hp7-insta-{{ section_id }}">
  
  <div class="hp7-insta__badge">
    <h2 class="hp7-insta__badge-title">THE NETWORK</h2>
    {%- if section.settings.handle != blank -%}
      <a href="https://instagram.com/{{ section.settings.handle | remove: '@' }}" target="_blank" class="hp7-insta__badge-handle">{{ section.settings.handle }}</a>
    {%- endif -%}
  </div>

  <div class="hp7-insta__grid">
    {%- for block in section.blocks -%}
      <div class="hp7-insta__item" {{ block.shopify_attributes }}>
        <a href="{{ block.settings.link | default: '#' }}" target="_blank" class="hp7-insta__link" aria-label="View on Instagram">
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 1000 | image_tag: 
               loading: 'lazy',
               class: 'hp7-insta__image',
               alt: 'Instagram image'
            }}
          {%- else -%}
            {{ 'collection-' | append: forloop.index | placeholder_svg_tag: 'hp7-insta__image placeholder-svg' }}
          {%- endif -%}
          
          <div class="hp7-insta__overlay">
            <svg class="hp7-insta__icon" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
          </div>
        </a>
      </div>
    {%- endfor -%}
  </div>

</section>

{% schema %}
{
  "name": "HP7 Instagram Grid",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Aesthetic: Editorial Brutalism",
      "info": "Asymmetrical edge-to-edge grid with a solid badge overlay. Best with 5 images."
    },
    {
      "type": "text",
      "id": "handle",
      "label": "Instagram Handle",
      "default": "@AVANTGARDE"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Grid Border Color",
      "default": "#050505"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Instagram Post",
      "limit": 5,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Post Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP7 Instagram Grid",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
