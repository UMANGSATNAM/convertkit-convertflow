<style>
@media screen and (max-width: 768px) {
  .hp52-marquee {
    padding-left: 16px !important;
    padding-right: 16px !important;
    box-sizing: border-box !important;
  }
  img {
    max-width: 100% !important;
    height: auto !important;
  }
}
</style>
{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp52-marq-bg: {{ section.settings.bg_color | default: '#C2593F' }};
    --hp52-marq-text: {{ section.settings.text_color | default: '#FFFDF9' }};
    
    background: var(--hp52-marq-bg);
    color: var(--hp52-marq-text);
    padding: {{ section.settings.padding_vertical | default: 16 }}px 0;
    overflow: hidden;
    white-space: nowrap;
  }

  .hp52-marquee__track {
    display: inline-flex;
    gap: 40px;
    animation: hp52-scroll {{ section.settings.speed | default: 22 }}s linear infinite;
    font-family: 'Jost', sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .hp52-marquee__item {
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }

  @keyframes hp52-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
{%- endstyle -%}

<div class="hp52-marquee__track">
  {%- if section.blocks.size > 0 -%}
    {%- for i in (1..2) -%}
      {%- for block in section.blocks -%}
        <div class="hp52-marquee__item" {{ block.shopify_attributes }}>
          <span>☀️</span>
          <span>{{ block.settings.text }}</span>
        </div>
      {%- endfor -%}
    {%- endfor -%}
  {%- else -%}
    {%- for i in (1..2) -%}
      <div class="hp52-marquee__item"><span>☀️</span><span>COLD-PRESSED TUSCAN OLIVE SQUALANE</span></div>
      <div class="hp52-marquee__item"><span>🏺</span><span>SICILIAN SUN-DRIED TERRACOTTA CLAY</span></div>
      <div class="hp52-marquee__item"><span>✈️</span><span>FREE EXPRESS AIR SHIPPING OVER $70</span></div>
      <div class="hp52-marquee__item"><span>🛡️</span><span>100% ARTISANAL BOTANICAL ACCORD</span></div>
    {%- endfor -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "HP52 - Terra Marquee",
  "class": "section-hp52-marquee",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#C2593F" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#FFFDF9" },
    { "type": "range", "id": "speed", "min": 10, "max": 60, "step": 2, "unit": "s", "label": "Scroll Duration", "default": 22 },
    { "type": "range", "id": "padding_vertical", "min": 8, "max": 40, "step": 2, "unit": "px", "label": "Padding Vertical", "default": 16 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Ticker Item",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "COLD-PRESSED TUSCAN OLIVE SQUALANE" }
      ]
    }
  ],
  "presets": [
    { "name": "HP52 - Terra Marquee" }
  ]
}
{% endschema %}
