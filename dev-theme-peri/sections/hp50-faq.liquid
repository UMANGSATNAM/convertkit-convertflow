{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp50-faq-bg: {{ section.settings.bg_color | default: '#000000' }};
    
    background-color: var(--hp50-faq-bg);
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }

  .hp50-faq__wrap {
    max-width: {{ section.settings.container_width | default: 860 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp50-faq__header {
    text-align: center;
    margin-bottom: 45px;
  }

  .hp50-faq__heading {
    font-family: 'Italiana', serif;
    font-size: clamp(34px, 4.5vw, 46px);
    font-weight: 400;
    color: #FFFFFF;
    margin: 0 0 8px;
    letter-spacing: 1px;
  }

  .hp50-faq__item {
    background: #111111;
    border: 1px solid rgba(226, 232, 240, 0.2);
    padding: 24px 28px;
    margin-bottom: 16px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .hp50-faq__item:hover { border-color: #FFFFFF; }

  .hp50-faq__q {
    font-family: 'Syne', sans-serif;
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: #FFFFFF;
    margin: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .hp50-faq__a {
    font-size: 14px;
    line-height: 1.8;
    color: #94A3B8;
    margin: 14px 0 0;
    padding-top: 14px;
    border-top: 1px solid rgba(226, 232, 240, 0.15);
  }
{%- endstyle -%}

<div class="hp50-faq__wrap">
  <div class="hp50-faq__header">
    <h2 class="hp50-faq__heading">{{ section.settings.heading | default: 'Runway Technical Dossier' }}</h2>
    <p style="font-size:12px; color:#94A3B8; letter-spacing:1.5px; text-transform:uppercase;">{{ section.settings.subheading | default: 'Concierge answers regarding platinum delivery, camera matte finishes, and global dispatch.' }}</p>
  </div>

  {%- if section.blocks.size > 0 -%}
    {%- for block in section.blocks -%}
      <div class="hp50-faq__item" {{ block.shopify_attributes }}>
        <h3 class="hp50-faq__q">
          <span>{{ block.settings.question }}</span>
          <span>+</span>
        </h3>
        <p class="hp50-faq__a">{{ block.settings.answer }}</p>
      </div>
    {%- endfor -%}
  {%- else -%}
    <div class="hp50-faq__item">
      <h3 class="hp50-faq__q"><span>How do platinum peptides define cheekbone vectors?</span><span>+</span></h3>
      <p class="hp50-faq__a">Colloidal platinum particles anchor bio-peptides across structural dermal matrices, delivering an immediate high-tensile tightening effect observable within 60 seconds.</p>
    </div>
    <div class="hp50-faq__item">
      <h3 class="hp50-faq__q"><span>Are international customs duties fully handled?</span><span>+</span></h3>
      <p class="hp50-faq__a">Yes, all international shipments are dispatched via white-glove DDP air courier with all local import taxes, customs, and duties 100% pre-paid by our atelier.</p>
    </div>
    <div class="hp50-faq__item">
      <h3 class="hp50-faq__q"><span>Is the formula suitable for high-definition photography?</span><span>+</span></h3>
      <p class="hp50-faq__a">Yes, micronized obsidian minerals diffuse specular flash reflection, eliminating flashback and maintaining a satin velvet finish on 8K digital cinema cameras.</p>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "HP50 - Runway FAQ",
  "class": "section-hp50-faq",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#000000" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Runway Technical Dossier" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Concierge answers regarding platinum delivery, camera matte finishes, and global dispatch." },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 600, "max": 1200, "step": 20, "unit": "px", "label": "Container Width", "default": 860 }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How do platinum peptides define cheekbone vectors?" },
        { "type": "textarea", "id": "answer", "label": "Answer", "default": "Colloidal platinum particles anchor bio-peptides." }
      ]
    }
  ],
  "presets": [
    { "name": "HP50 - Runway FAQ" }
  ]
}
{% endschema %}
