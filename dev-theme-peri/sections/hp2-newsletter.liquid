{%- liquid
  assign bg_color = section.settings.bg_color | default: '#000000'
  assign text_color = section.settings.text_color | default: '#ffffff'
  
  assign padding_top_desktop = section.settings.padding_top_desktop
  assign padding_bottom_desktop = section.settings.padding_bottom_desktop
  assign padding_top_mobile = section.settings.padding_top_mobile
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile
-%}

<style>
  #shopify-section-{{ section.id }} {
    --hp2-news-bg: {{ bg_color }};
    --hp2-news-text: {{ text_color }};
    
    --hp2-news-pt-desk: {{ padding_top_desktop }}px;
    --hp2-news-pb-desk: {{ padding_bottom_desktop }}px;
    --hp2-news-pt-mob: {{ padding_top_mobile }}px;
    --hp2-news-pb-mob: {{ padding_bottom_mobile }}px;
  }

  .hp2-fashion-newsletter-{{ section.id }} {
    padding-top: var(--hp2-news-pt-desk);
    padding-bottom: var(--hp2-news-pb-desk);
    background-color: var(--hp2-news-bg);
    color: var(--hp2-news-text);
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
  }

  .hp2-news-inner {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 40px;
    text-align: center;
  }

  .hp2-news-title {
    font-size: clamp(40px, 6vw, 80px);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -2px;
    line-height: 0.9;
    margin: 0 0 20px 0;
  }

  .hp2-news-desc {
    font-size: 16px;
    line-height: 1.6;
    margin: 0 auto 40px;
    max-width: 500px;
    opacity: 0.8;
  }

  /* Form Styles */
  .hp2-news-form {
    position: relative;
    max-width: 600px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  .hp2-news-input-group {
    position: relative;
    display: flex;
    align-items: center;
    border-bottom: 2px solid var(--hp2-news-text);
  }

  .hp2-news-input {
    width: 100%;
    background: transparent;
    border: none;
    color: var(--hp2-news-text);
    padding: 15px 0;
    font-size: 16px;
    font-family: inherit;
    outline: none;
  }
  .hp2-news-input::placeholder {
    color: var(--hp2-news-text);
    opacity: 0.5;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .hp2-news-submit {
    background: transparent;
    border: none;
    color: var(--hp2-news-text);
    font-weight: 900;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 2px;
    cursor: pointer;
    padding: 10px 0 10px 20px;
    transition: opacity 0.3s ease;
  }
  .hp2-news-submit:hover {
    opacity: 0.6;
  }

  /* Form Status Messages */
  .hp2-news-success {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    color: #4caf50;
    font-weight: 800;
    margin-top: 20px;
    font-size: 14px;
    text-transform: uppercase;
  }
  .hp2-news-success svg {
    width: 20px;
    height: 20px;
  }

  .hp2-news-error {
    color: #f44336;
    font-size: 13px;
    margin-top: 10px;
    text-align: left;
  }

  @media screen and (max-width: 768px) {
    .hp2-fashion-newsletter-{{ section.id }} {
      padding-top: var(--hp2-news-pt-mob);
      padding-bottom: var(--hp2-news-pb-mob);
    }
    .hp2-news-inner {
      padding: 0 20px;
    }
    .hp2-news-title {
      font-size: 40px;
    }
    .hp2-news-desc {
      font-size: 14px;
    }
  }
</style>

<section class="hp2-fashion-newsletter-{{ section.id }}" aria-label="Newsletter Signup">
  <div class="hp2-news-inner">
    
    {%- if section.settings.heading != blank -%}
      <h2 class="hp2-news-title">{{ section.settings.heading }}</h2>
    {%- endif -%}
    
    {%- if section.settings.description != blank -%}
      <p class="hp2-news-desc">{{ section.settings.description }}</p>
    {%- endif -%}

    {% form 'customer', class: 'hp2-news-form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      
      <div class="hp2-news-input-group">
        <input 
          id="NewsletterEmail-{{ section.id }}"
          type="email"
          name="contact[email]"
          class="hp2-news-input"
          value="{{ form.email }}"
          aria-required="true"
          autocorrect="off"
          autocapitalize="off"
          autocomplete="email"
          {% if form.errors %}
            autofocus
            aria-invalid="true"
            aria-describedby="Newsletter-error--{{ section.id }}"
          {% elsif form.posted_successfully? %}
            aria-describedby="Newsletter-success--{{ section.id }}"
          {% endif %}
          placeholder="{{ section.settings.placeholder_text | default: 'YOUR EMAIL ADDRESS' }}"
          required
        >
        <button type="submit" class="hp2-news-submit" name="commit" id="Subscribe-{{ section.id }}" aria-label="Subscribe">
          {{ section.settings.btn_text | default: 'JOIN' }}
        </button>
      </div>

      {%- if form.errors -%}
        <div class="hp2-news-error" id="Newsletter-error--{{ section.id }}">
          {{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}
        </div>
      {%- endif -%}

      {%- if form.posted_successfully? -%}
        <div class="hp2-news-success" id="Newsletter-success--{{ section.id }}" tabindex="-1" autofocus>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
          {{ section.settings.success_text | default: 'YOU ARE ON THE LIST.' }}
        </div>
      {%- endif -%}
    {% endform %}

  </div>
</section>

{% schema %}
{
  "name": "HP2 Newsletter",
  "tag": "section",
  "class": "section-hp2-newsletter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "JOIN THE CLUB"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Sign up for early access to drops, exclusive content, and 10% off your first order."
    },
    {
      "type": "text",
      "id": "placeholder_text",
      "label": "Input Placeholder",
      "default": "ENTER EMAIL"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "SUBMIT"
    },
    {
      "type": "text",
      "id": "success_text",
      "label": "Success Message",
      "default": "WELCOME TO THE FAMILY."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Top (Desktop)", "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Bottom (Desktop)", "default": 120
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Top (Mobile)", "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Bottom (Mobile)", "default": 80
    }
  ],
  "presets": [
    {
      "name": "HP2 Newsletter (Advanced)",
      "category": "Promotional"
    }
  ]
}
{% endschema %}
