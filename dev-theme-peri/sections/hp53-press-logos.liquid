{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp53-press-bg: {{ section.settings.bg_color | default: '#F5EDE3' }};

    background-color: var(--hp53-press-bg);
    padding: {{ section.settings.padding_vertical | default: 30 }}px 0;
  }

  .hp53-press__container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp53-press__label {
    text-align: center;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: {{ section.settings.label_color | default: '#C2703E' }};
    margin: 0 0 24px;
  }

  .hp53-press__logos {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 50px;
    flex-wrap: wrap;
  }

  .hp53-press__logo {
    height: {{ section.settings.logo_height | default: 26 }}px;
    opacity: 0.45;
    filter: grayscale(100%) sepia(30%);
    transition: all 0.3s ease;
  }

  .hp53-press__logo:hover {
    opacity: 0.8;
    filter: grayscale(0%);
  }

  @media screen and (max-width: 768px) {
    .hp53-press__logos { gap: 30px; }
    .hp53-press__logo { height: 20px; }
  }
{%- endstyle -%}

<div class="hp53-press__container">
  {%- if section.settings.label != blank -%}
    <p class="hp53-press__label">{{ section.settings.label }}</p>
  {%- endif -%}
  <div class="hp53-press__logos">
    {%- for block in section.blocks -%}
      {%- if block.settings.logo != blank -%}
        <img src="{{ block.settings.logo | image_url: height: 60 }}" class="hp53-press__logo" alt="{{ block.settings.alt | default: 'Press logo' }}" loading="lazy">
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "HP53 - Dune Press Logos",
  "class": "section-hp53-press",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#F5EDE3" },
    { "type": "color", "id": "label_color", "label": "Label Color", "default": "#C2703E" },
    { "type": "text", "id": "label", "label": "Label", "default": "AS FEATURED IN" },
    { "type": "range", "id": "logo_height", "min": 16, "max": 50, "step": 2, "unit": "px", "label": "Logo Height", "default": 26 },
    { "type": "range", "id": "padding_vertical", "min": 10, "max": 60, "step": 5, "unit": "px", "label": "Padding", "default": 30 }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        { "type": "image_picker", "id": "logo", "label": "Logo Image" },
        { "type": "text", "id": "alt", "label": "Alt Text" }
      ]
    }
  ],
  "presets": [{ "name": "HP53 - Dune Press Logos" }]
}
{% endschema %}
