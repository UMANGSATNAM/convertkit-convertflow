{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@300;400;500&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --line-color: rgba({{ section.settings.text_color | color_to_rgb | remove: 'rgb(' | remove: ')' }}, {{ 0.15 }});
    
    --font-heading: 'Lora', serif;
    --font-body: 'Inter', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    position: relative;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.8 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.8 | round }}px;
    }
  }

  .hp29-usp-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp29-usp-wrapper {
      padding: 0 20px;
    }
  }

  .hp29-usp__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: 0; /* Handled by borders */
    border-top: 1px solid var(--line-color);
    border-bottom: 1px solid var(--line-color);
  }

  @media screen and (max-width: 992px) {
    .hp29-usp__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 576px) {
    .hp29-usp__grid {
      grid-template-columns: 1fr;
    }
  }

  .hp29-usp__item {
    padding: 60px 40px;
    text-align: center;
    border-right: 1px solid var(--line-color);
    transition: background 0.3s ease;
  }

  /* Handle borders appropriately for grid */
  .hp29-usp__item:nth-child({{ section.settings.columns_desktop }}n) {
    border-right: none;
  }

  @media screen and (max-width: 992px) {
    .hp29-usp__item {
      border-right: 1px solid var(--line-color);
      border-bottom: 1px solid var(--line-color);
    }
    .hp29-usp__item:nth-child(2n) {
      border-right: none;
    }
    .hp29-usp__item:nth-last-child(-n+2):nth-child(odd),
    .hp29-usp__item:last-child {
      border-bottom: none;
    }
  }

  @media screen and (max-width: 576px) {
    .hp29-usp__item {
      border-right: none;
      border-bottom: 1px solid var(--line-color);
      padding: 40px 20px;
    }
    .hp29-usp__item:last-child {
      border-bottom: none;
    }
  }

  .hp29-usp__item:hover {
    background: rgba(255, 255, 255, 0.2);
  }

  .hp29-usp__icon {
    width: 48px;
    height: 48px;
    margin: 0 auto 25px;
    color: var(--accent-color);
  }
  
  .hp29-usp__icon svg {
    width: 100%;
    height: 100%;
    fill: currentColor;
  }

  .hp29-usp__title {
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 500;
    color: var(--text-color);
    margin: 0 0 15px;
    letter-spacing: 0.02em;
  }

  .hp29-usp__text {
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 300;
    line-height: 1.6;
    color: var(--text-color);
    opacity: 0.75;
    margin: 0;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp29-usp-wrapper" id="HP29Usp-{{ section.id }}">
  <div class="hp29-usp__grid">
    {%- for block in section.blocks -%}
      <div class="hp29-usp__item" {{ block.shopify_attributes }}>
        <div class="hp29-usp__icon">
          {%- if block.settings.icon_svg != blank -%}
            {{ block.settings.icon_svg }}
          {%- else -%}
            <svg viewBox="0 0 24 24"><path d="M12 2L2 22h20L12 2zm0 4.3l6.5 13.7H5.5L12 6.3z"/></svg>
          {%- endif -%}
        </div>
        <h3 class="hp29-usp__title">{{ block.settings.title }}</h3>
        <p class="hp29-usp__text">{{ block.settings.text }}</p>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "HP29 - Boho USP",
  "class": "section-hp29-usp",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1400
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns (Desktop)",
      "default": 4
    },
    {
      "type": "header",
      "content": "Earthy Boho Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#F4F1DE"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#3D405B"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Icon/Accent",
      "default": "#E07A5F"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 60
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "usp",
      "name": "USP Item",
      "settings": [
        {
          "type": "html",
          "id": "icon_svg",
          "label": "Custom SVG Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Ethically Sourced"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Materials chosen with care for the earth and people."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP29 - Boho USP",
      "blocks": [
        { "type": "usp", "settings": { "title": "Organic Fibers", "text": "Crafted from nature's most breathable materials." } },
        { "type": "usp", "settings": { "title": "Mindful Production", "text": "Small batch runs to reduce unnecessary waste." } },
        { "type": "usp", "settings": { "title": "Carbon Neutral", "text": "Offsetting our footprint every step of the way." } },
        { "type": "usp", "settings": { "title": "Lifetime Repair", "text": "Designed to last, repaired for free." } }
      ]
    }
  ]
}
{% endschema %}
