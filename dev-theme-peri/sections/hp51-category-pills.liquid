{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp51-pills-bg: {{ section.settings.bg_color | default: '#F2EFE9' }};
    
    background-color: var(--hp51-pills-bg);
    padding: {{ section.settings.padding_vertical | default: 35 }}px 0;
  }

  .hp51-pills__wrap {
    max-width: {{ section.settings.container_width | default: 1100 }}px;
    margin: 0 auto;
    padding: 0 20px;
    display: flex;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .hp51-pill {
    padding: 10px 24px;
    background: #FAF8F5;
    border: 1px solid rgba(30, 58, 43, 0.15);
    border-radius: 50px;
    color: #1E3A2B;
    font-family: 'DM Sans', sans-serif;
    font-weight: 700;
    font-size: 13px;
    text-decoration: none;
    transition: all 0.25s ease;
    box-shadow: 0 4px 12px rgba(30, 58, 43, 0.03);
  }

  .hp51-pill:hover, .hp51-pill--active {
    background: #1E3A2B;
    color: #FAF8F5;
    border-color: #1E3A2B;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(30, 58, 43, 0.15);
  }

  @media screen and (max-width: 576px) {
    .hp51-pills__wrap { justify-content: flex-start; overflow-x: auto; flex-wrap: nowrap; }
    .hp51-pill { flex-shrink: 0; }
  }
{%- endstyle -%}

<div class="hp51-pills__wrap">
  {%- if section.blocks.size > 0 -%}
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.url | default: '/collections/all' }}" class="hp51-pill {% if forloop.first %}hp51-pill--active{% endif %}" {{ block.shopify_attributes }}>
        {{ block.settings.title }}
      </a>
    {%- endfor -%}
  {%- else -%}
    <a href="/collections/all" class="hp51-pill hp51-pill--active">🍵 All Zen Care</a>
    <a href="/collections/matcha" class="hp51-pill">🍵 Uji Matcha EGCG</a>
    <a href="/collections/bamboo" class="hp51-pill">🎍 Bamboo Sap Water</a>
    <a href="/collections/cremes" class="hp51-pill">✨ Silk Barrier Crèmes</a>
    <a href="/collections/masks" class="hp51-pill">🌿 Kyoto Clay Masks</a>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "HP51 - Zen Pills",
  "class": "section-hp51-pills",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#F2EFE9" },
    { "type": "range", "id": "padding_vertical", "min": 10, "max": 70, "step": 5, "unit": "px", "label": "Vertical Padding", "default": 35 },
    { "type": "range", "id": "container_width", "min": 800, "max": 1400, "step": 20, "unit": "px", "label": "Container Width", "default": 1100 }
  ],
  "blocks": [
    {
      "type": "pill",
      "name": "Pill",
      "settings": [
        { "type": "text", "id": "title", "label": "Label", "default": "🍵 All Zen Care" },
        { "type": "url", "id": "url", "label": "Link URL" }
      ]
    }
  ],
  "presets": [
    { "name": "HP51 - Zen Pills" }
  ]
}
{% endschema %}
