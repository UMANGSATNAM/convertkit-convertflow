{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;700&family=JetBrains+Mono:wght@400;700&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --grid-color: rgba(255, 255, 255, 0.1);
    
    --font-heading: 'Inter', sans-serif;
    --font-body: 'JetBrains Mono', monospace;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    border-bottom: 1px solid var(--grid-color);
  }

  .hp34-bundle-wrapper {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    gap: 0; /* grid lines handled via border */
    border: 1px solid var(--grid-color);
  }

  @media screen and (max-width: 992px) {
    .hp34-bundle-wrapper {
      flex-direction: column;
      padding: 0;
      border-left: none; border-right: none;
    }
  }

  .hp34-bundle__image-col {
    flex: 1;
    position: relative;
    border-right: 1px solid var(--grid-color);
    background: #050505;
  }

  @media screen and (max-width: 992px) {
    .hp34-bundle__image-col {
      border-right: none;
      border-bottom: 1px solid var(--grid-color);
    }
  }

  .hp34-bundle__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%);
    display: block;
  }

  .hp34-bundle__reticle {
    position: absolute;
    width: 40px; height: 40px;
    border: 1px solid var(--accent-color);
    z-index: 2;
    pointer-events: none;
  }
  
  .hp34-bundle__reticle--center {
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    border-style: dashed;
  }

  .hp34-bundle__content-col {
    flex: 1.2;
    padding: 60px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  @media screen and (max-width: 768px) {
    .hp34-bundle__content-col {
      padding: 30px 20px;
    }
  }

  .hp34-bundle__subtitle {
    font-family: var(--font-body);
    font-size: 11px;
    color: var(--accent-color);
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 15px;
  }

  .hp34-bundle__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    line-height: 1.1;
    color: var(--text-color);
    margin: 0 0 20px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }

  .hp34-bundle__price-wrap {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 40px;
    font-family: var(--font-body);
  }

  .hp34-bundle__price {
    font-size: 24px;
    color: var(--accent-color);
    font-weight: 700;
  }

  .hp34-bundle__price-old {
    font-size: 16px;
    color: var(--text-color);
    text-decoration: line-through;
    opacity: 0.5;
  }

  .hp34-bundle__text {
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-color);
    margin: 0 0 40px;
    opacity: 0.8;
  }

  .hp34-bundle__components {
    margin-bottom: 40px;
  }

  .hp34-bundle__comp-header {
    font-family: var(--font-body);
    font-size: 10px;
    color: var(--text-color);
    opacity: 0.5;
    text-transform: uppercase;
    margin-bottom: 15px;
    border-bottom: 1px solid var(--grid-color);
    padding-bottom: 5px;
  }

  .hp34-bundle__list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .hp34-bundle__list li {
    font-family: var(--font-body);
    font-size: 13px;
    color: var(--text-color);
    padding: 10px 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px dashed var(--grid-color);
  }

  .hp34-bundle__list li::before {
    content: '[+]';
    color: var(--accent-color);
    margin-right: 10px;
  }

  /* Fake stat bar */
  .hp34-bundle__stat-bar {
    width: 60px;
    height: 4px;
    background: var(--grid-color);
    position: relative;
    margin-left: auto;
    margin-right: 15px;
  }
  .hp34-bundle__stat-bar::after {
    content: '';
    position: absolute;
    top: 0; left: 0; bottom: 0;
    background: var(--accent-color);
    width: var(--level, 50%);
  }

  .hp34-bundle__btn {
    font-family: var(--font-body);
    font-size: 14px;
    text-transform: uppercase;
    text-decoration: none;
    padding: 20px 40px;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: var(--accent-color);
    color: #000;
    align-self: flex-start;
    transition: all 0.3s ease;
  }

  .hp34-bundle__btn:hover {
    background-color: #fff;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp34-bundle-wrapper" id="HP34Bundle-{{ section.id }}">
  <div class="hp34-bundle__image-col">
    <div class="hp34-bundle__reticle hp34-bundle__reticle--center"></div>
    {%- if section.settings.image != blank -%}
      <img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.title | escape }}" class="hp34-bundle__image" loading="lazy">
    {%- else -%}
      {{ 'collection-1' | placeholder_svg_tag: 'hp34-bundle__image' }}
    {%- endif -%}
  </div>

  <div class="hp34-bundle__content-col">
    {%- if section.settings.subtitle != blank -%}
      <div class="hp34-bundle__subtitle">{{ section.settings.subtitle }}</div>
    {%- endif -%}
    
    <h2 class="hp34-bundle__title">{{ section.settings.title }}</h2>
    
    <div class="hp34-bundle__price-wrap">
      <span class="hp34-bundle__price">{{ section.settings.price }}</span>
      {%- if section.settings.compare_price != blank -%}
        <span class="hp34-bundle__price-old">{{ section.settings.compare_price }}</span>
      {%- endif -%}
    </div>
    
    <p class="hp34-bundle__text">{{ section.settings.text }}</p>
    
    <div class="hp34-bundle__components">
      <div class="hp34-bundle__comp-header">LOADOUT_COMPONENTS</div>
      <ul class="hp34-bundle__list">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            <span>{{ block.settings.item_name }}</span>
            <div class="hp34-bundle__stat-bar" style="--level: {{ block.settings.stat_level }}%;"></div>
            <span style="opacity: 0.5;">v{{ forloop.index }}.0</span>
          </li>
        {%- endfor -%}
      </ul>
    </div>
    
    {%- if section.settings.btn_label != blank -%}
      <a href="{{ section.settings.btn_link | default: '#' }}" class="hp34-bundle__btn">
        {{ section.settings.btn_label }}
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP34 - Tech Bundle",
  "class": "section-hp34-bundle-offer",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Bundle Image"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "SYS.BUNDLE_CONFIG"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Heading",
      "default": "Urban Operator Kit"
    },
    {
      "type": "text",
      "id": "price",
      "label": "Price",
      "default": "$450"
    },
    {
      "type": "text",
      "id": "compare_price",
      "label": "Compare Price",
      "default": "$520"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "A pre-configured loadout designed for maximum efficiency in varying environmental conditions."
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "[ DEPLOY KIT ]"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 48
    },
    {
      "type": "header",
      "content": "Tech Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (e.g. Black)",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#FF4500"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Bundle Component",
      "settings": [
        {
          "type": "text",
          "id": "item_name",
          "label": "Component Name",
          "default": "Tactical Vest"
        },
        {
          "type": "range",
          "id": "stat_level",
          "min": 10,
          "max": 100,
          "step": 10,
          "unit": "%",
          "label": "Stat Bar Level",
          "default": 80
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP34 - Tech Bundle",
      "blocks": [
        { "type": "item", "settings": { "item_name": "Outer Shell Jacket", "stat_level": 90 } },
        { "type": "item", "settings": { "item_name": "Base Layer Top", "stat_level": 70 } },
        { "type": "item", "settings": { "item_name": "Utility Pants", "stat_level": 100 } }
      ]
    }
  ]
}
{% endschema %}
