{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#6b705c'
  assign text_color = section.settings.text_color | default: '#ffe8d6'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 100px 40px 40px;
    color: {{ text_color }};
  }
  
  .hp14-footer-container-{{ section_id }} {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 60px;
  }
  
  .hp14-footer-logo-wrap-{{ section_id }} {
    max-width: 300px;
  }
  
  .hp14-footer-logo-{{ section_id }} {
    font-family: 'Georgia', serif;
    font-size: 2.5rem;
    font-weight: normal;
    color: {{ text_color }};
    text-decoration: none;
    letter-spacing: -0.5px;
    display: block;
    margin-bottom: 20px;
  }
  
  .hp14-footer-text-{{ section_id }} {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.95rem;
    line-height: 1.6;
    opacity: 0.8;
  }
  
  .hp14-footer-heading-{{ section_id }} {
    font-family: 'Georgia', serif;
    font-size: 1.2rem;
    font-weight: normal;
    margin: 0 0 25px 0;
    color: {{ text_color }};
  }
  
  .hp14-footer-menu-{{ section_id }} {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  
  .hp14-footer-menu-{{ section_id }} li {
    margin-bottom: 15px;
  }
  
  .hp14-footer-menu-{{ section_id }} a {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.95rem;
    color: {{ text_color }};
    text-decoration: none;
    opacity: 0.8;
    transition: opacity 0.3s ease;
  }
  
  .hp14-footer-menu-{{ section_id }} a:hover {
    opacity: 1;
    text-decoration: underline;
  }
  
  .hp14-footer-bottom-{{ section_id }} {
    max-width: 1400px;
    margin: 80px auto 0;
    padding-top: 40px;
    border-top: 1px solid rgba(255, 232, 214, 0.2);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  .hp14-footer-copyright-{{ section_id }} {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.9rem;
    opacity: 0.7;
  }
  
  .hp14-footer-payments-{{ section_id }} {
    display: flex;
    gap: 10px;
    opacity: 0.8;
  }
  
  .hp14-footer-payments-{{ section_id }} svg {
    width: 38px;
    height: 24px;
  }

  @media (max-width: 992px) {
    .hp14-footer-container-{{ section_id }} {
      grid-template-columns: 1fr 1fr;
      gap: 40px;
    }
  }
  
  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 60px 20px 20px;
    }
    .hp14-footer-container-{{ section_id }} {
      grid-template-columns: 1fr;
    }
    .hp14-footer-bottom-{{ section_id }} {
      flex-direction: column;
      gap: 20px;
      text-align: center;
      margin-top: 40px;
      padding-top: 20px;
    }
  }
</style>

<div class="hp14-footer-container-{{ section_id }}">
  <div class="hp14-footer-logo-wrap-{{ section_id }}">
    <a href="/" class="hp14-footer-logo-{{ section_id }}">{{ shop.name | default: 'Botanica.' }}</a>
    <p class="hp14-footer-text-{{ section_id }}">Crafting pure, botanical skincare for the mindful soul. Earth to skin.</p>
  </div>
  
  <div class="hp14-footer-column-{{ section_id }}">
    <h4 class="hp14-footer-heading-{{ section_id }}">Shop</h4>
    <ul class="hp14-footer-menu-{{ section_id }}">
      {%- assign cf_menu = section.settings.menu | default: linklists['footer'] -%}

      {%- if cf_menu == blank -%}{%- assign cf_menu = linklists['main-menu'] -%}{%- endif -%}

      {%- for link in cf_menu.links -%}

        <li><a href="{{ link.url }}">{{ link.title }}</a></li>

      {%- endfor -%}
    </ul>
  </div>
  
  <div class="hp14-footer-column-{{ section_id }}">
    <h4 class="hp14-footer-heading-{{ section_id }}">About</h4>
    <ul class="hp14-footer-menu-{{ section_id }}">
      {%- assign cf_menu = section.settings.menu | default: linklists['footer'] -%}

      {%- if cf_menu == blank -%}{%- assign cf_menu = linklists['main-menu'] -%}{%- endif -%}

      {%- for link in cf_menu.links -%}

        <li><a href="{{ link.url }}">{{ link.title }}</a></li>

      {%- endfor -%}
    </ul>
  </div>
  
  <div class="hp14-footer-column-{{ section_id }}">
    <h4 class="hp14-footer-heading-{{ section_id }}">Support</h4>
    <ul class="hp14-footer-menu-{{ section_id }}">
      {%- assign cf_menu = section.settings.menu | default: linklists['footer'] -%}

      {%- if cf_menu == blank -%}{%- assign cf_menu = linklists['main-menu'] -%}{%- endif -%}

      {%- for link in cf_menu.links -%}

        <li><a href="{{ link.url }}">{{ link.title }}</a></li>

      {%- endfor -%}
    </ul>
  </div>
</div>

<div class="hp14-footer-bottom-{{ section_id }}">
  <div class="hp14-footer-copyright-{{ section_id }}">
    &copy; {{ 'now' | date: "%Y" }} {{ shop.name }}. All rights reserved.
  </div>
  <div class="hp14-footer-payments-{{ section_id }}">
    {{ shop.enabled_payment_types | payment_type_svg_tag }}
  </div>
</div>

{% schema %}
{
  "name": "HP14 Footer",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#6b705c"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffe8d6"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Footer menu",
      "info": "Leave empty to use the store's main menu.",
      "default": "footer"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_mobile",
      "label": "Mobile padding",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border colour",
      "default": "#E5E7EB"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Footer logo"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show social links",
      "default": true
    },
    {
      "type": "text",
      "id": "copyright_note",
      "label": "Copyright line",
      "info": "The year and store name are added automatically.",
      "default": "All rights reserved."
    }
  ],
  "presets": [
    {
      "name": "HP14 Footer"
    }
  ]
}
{% endschema %}
