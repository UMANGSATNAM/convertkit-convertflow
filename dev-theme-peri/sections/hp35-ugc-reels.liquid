{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;1,400&family=Nunito:wght@300;400;600&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    
    --font-heading: 'Lora', serif;
    --font-body: 'Nunito', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .hp35-ugc-wrapper {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp35-ugc-wrapper {
      padding: 0 20px;
    }
  }

  .hp35-ugc__header {
    text-align: center;
    margin-bottom: 60px;
  }

  .hp35-ugc__subtitle {
    font-family: var(--font-body);
    font-size: 13px;
    color: var(--accent-color);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-bottom: 15px;
    font-weight: 600;
  }

  .hp35-ugc__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    line-height: 1.2;
    color: var(--text-color);
    margin: 0;
    font-weight: 400;
  }
  
  .hp35-ugc__title em {
    font-style: italic;
    color: var(--accent-color);
  }

  .hp35-ugc__grid {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    padding-bottom: 40px;
    scrollbar-width: thin;
    scrollbar-color: var(--accent-color) transparent;
  }

  .hp35-ugc__grid::-webkit-scrollbar {
    height: 4px;
  }
  .hp35-ugc__grid::-webkit-scrollbar-track {
    background: transparent;
  }
  .hp35-ugc__grid::-webkit-scrollbar-thumb {
    background-color: var(--accent-color);
    border-radius: 4px;
  }

  .hp35-ugc__card {
    flex: 0 0 280px;
    position: relative;
    aspect-ratio: 9/16;
    border-radius: 140px; /* Pill shape */
    overflow: hidden;
    background: #e9e5de;
    text-decoration: none;
    transform: translateY(0);
    transition: transform 0.4s ease;
  }

  /* Stagger heights slightly */
  .hp35-ugc__card:nth-child(even) {
    margin-top: 40px;
  }

  .hp35-ugc__card:hover {
    transform: translateY(-10px);
  }

  .hp35-ugc__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hp35-ugc__overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.5) 0%, transparent 50%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
    padding: 30px 20px;
    z-index: 2;
  }

  .hp35-ugc__handle {
    font-family: var(--font-body);
    font-size: 14px;
    color: #fff;
    font-weight: 600;
    margin-bottom: 5px;
  }

  .hp35-ugc__icon {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 50px; height: 50px;
    background: rgba(255,255,255,0.2);
    backdrop-filter: blur(5px);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .hp35-ugc__icon svg {
    width: 20px; height: 20px;
    fill: currentColor;
    margin-left: 2px;
  }

  .hp35-ugc__card:hover .hp35-ugc__icon {
    opacity: 1;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp35-ugc-wrapper" id="HP35UGC-{{ section.id }}">
  <div class="hp35-ugc__header">
    {%- if section.settings.subtitle != blank -%}
      <div class="hp35-ugc__subtitle">{{ section.settings.subtitle }}</div>
    {%- endif -%}
    <h2 class="hp35-ugc__title">{{ section.settings.title | replace: 'community', '<em>community</em>' }}</h2>
  </div>

  <div class="hp35-ugc__grid">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.link | default: '#' }}" class="hp35-ugc__card" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.handle | escape }}" class="hp35-ugc__image" loading="lazy">
        {%- else -%}
          {%- assign placeholder = 'collection-' | append: forloop.index -%}
          {%- if forloop.index > 6 -%}{%- assign placeholder = 'collection-1' -%}{%- endif -%}
          {{ placeholder | placeholder_svg_tag: 'hp35-ugc__image' }}
        {%- endif -%}
        
        <div class="hp35-ugc__icon">
          <svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
        </div>
        
        <div class="hp35-ugc__overlay">
          <div class="hp35-ugc__handle">{{ block.settings.handle }}</div>
        </div>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "HP35 - Organic UGC",
  "class": "section-hp35-ugc-reels",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "IN REAL LIFE"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Our vibrant community"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 48
    },
    {
      "type": "header",
      "content": "Organic Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#FDFBF7"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2C422F"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#CC7B5E"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 100
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "ugc",
      "name": "UGC Post",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "handle",
          "label": "Social Handle",
          "default": "@username"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP35 - Organic UGC",
      "blocks": [
        { "type": "ugc" },
        { "type": "ugc" },
        { "type": "ugc" },
        { "type": "ugc" },
        { "type": "ugc" }
      ]
    }
  ]
}
{% endschema %}
