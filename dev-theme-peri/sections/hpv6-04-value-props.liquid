{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#FFFFFF'
  assign text_color = section.settings.text_color | default: '#2D3748'
  assign padding_top = section.settings.padding_top | default: 80
  assign padding_bottom = section.settings.padding_bottom | default: 80
  assign padding_top_mobile = section.settings.padding_top_mobile | default: 40
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile | default: 40
  assign columns_desktop = section.settings.columns_desktop | default: 4
  assign columns_mobile = section.settings.columns_mobile | default: 1
  assign alignment = section.settings.alignment | default: 'center'
  assign icon_size = section.settings.icon_size | default: 48
-%}

<style>
  #shopify-section-{{ section_id }} {
    --bg-color: {{ bg_color }};
    --text-color: {{ text_color }};
    --padding-top: {{ padding_top }}px;
    --padding-bottom: {{ padding_bottom }}px;
    --padding-top-mobile: {{ padding_top_mobile }}px;
    --padding-bottom-mobile: {{ padding_bottom_mobile }}px;
    --cols-desktop: {{ columns_desktop }};
    --cols-mobile: {{ columns_mobile }};
    --alignment: {{ alignment }};
    --icon-size: {{ icon_size }}px;
    
    background-color: var(--bg-color);
    color: var(--text-color);
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
  }

  .hpv6-values-{{ section_id }} {
    max-width: var(--page-width, 1400px);
    margin: 0 auto;
    padding: 0 4vw;
  }

  .hpv6-values__title-wrapper {
    text-align: center;
    margin-bottom: 4rem;
  }

  .hpv6-values__title {
    font-family: 'Playfair Display', 'Georgia', serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 400;
    margin: 0;
  }

  .hpv6-values__grid {
    display: grid;
    grid-template-columns: repeat(var(--cols-desktop), 1fr);
    gap: 3rem;
  }

  .hpv6-value-item {
    text-align: var(--alignment);
    display: flex;
    flex-direction: column;
    align-items: {% if alignment == 'center' %}center{% elsif alignment == 'right' %}flex-end{% else %}flex-start{% endif %};
  }

  .hpv6-value-item__icon {
    width: var(--icon-size);
    height: var(--icon-size);
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-color);
  }

  .hpv6-value-item__icon svg {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }

  .hpv6-value-item__icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .hpv6-value-item__heading {
    font-family: 'Playfair Display', 'Georgia', serif;
    font-size: 1.25rem;
    font-weight: 400;
    margin: 0 0 1rem 0;
  }

  .hpv6-value-item__text {
    font-family: 'Inter', sans-serif;
    font-size: 1rem;
    line-height: 1.6;
    opacity: 0.8;
  }

  .hpv6-value-item__link {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    letter-spacing: 1px;
    text-transform: uppercase;
    text-decoration: none;
    color: inherit;
    border-bottom: 1px solid currentColor;
    padding-bottom: 2px;
    margin-top: 1.5rem;
    transition: opacity 0.3s ease;
  }

  .hpv6-value-item__link:hover {
    opacity: 0.6;
  }

  @media screen and (max-width: 989px) {
    .hpv6-values__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2.5rem;
    }
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding-top: var(--padding-top-mobile);
      padding-bottom: var(--padding-bottom-mobile);
    }
    .hpv6-values__grid {
      grid-template-columns: repeat(var(--cols-mobile), 1fr);
      gap: 3rem;
    }
    .hpv6-values__title-wrapper {
      margin-bottom: 3rem;
    }
  }
</style>

<div class="hpv6-values-{{ section_id }}">
  {%- if section.settings.title != blank -%}
    <div class="hpv6-values__title-wrapper">
      <h2 class="hpv6-values__title">{{ section.settings.title | escape }}</h2>
    </div>
  {%- endif -%}

  <div class="hpv6-values__grid">
    {%- for block in section.blocks -%}
      <div class="hpv6-value-item" {{ block.shopify_attributes }}>
        
        {%- if block.settings.custom_icon != blank or block.settings.icon_svg != blank -%}
          <div class="hpv6-value-item__icon" aria-hidden="true">
            {%- if block.settings.custom_icon != blank -%}
              {{ block.settings.custom_icon | image_url: width: 150 | image_tag: loading: 'lazy' }}
            {%- elsif block.settings.icon_svg != blank -%}
              {{ block.settings.icon_svg }}
            {%- endif -%}
          </div>
        {%- else -%}
          <div class="hpv6-value-item__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-2-8 2v7c0 6 8 10 8 10z"/></svg>
          </div>
        {%- endif -%}

        {%- if block.settings.title != blank -%}
          <h3 class="hpv6-value-item__heading">{{ block.settings.title | escape }}</h3>
        {%- endif -%}

        {%- if block.settings.text != blank -%}
          <div class="hpv6-value-item__text">{{ block.settings.text }}</div>
        {%- endif -%}

        {%- if block.settings.link_label != blank and block.settings.link != blank -%}
          <a href="{{ block.settings.link }}" class="hpv6-value-item__link">
            {{ block.settings.link_label | escape }}
          </a>
        {%- endif -%}

      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "HPV6 Value Props",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "info": "Optional"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2D3748"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 24,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Icon Size",
      "default": 48
    },
    {
      "type": "header",
      "content": "Desktop Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Columns on Desktop",
      "default": 4
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 80
    },
    {
      "type": "header",
      "content": "Mobile Layout"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on Mobile",
      "options": [
        { "value": "1", "label": "1 Column" },
        { "value": "2", "label": "2 Columns" }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value Proposition",
      "settings": [
        {
          "type": "html",
          "id": "icon_svg",
          "label": "Icon (SVG HTML)",
          "info": "Paste Raw SVG code here."
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Custom Image Icon",
          "info": "Overrides SVG if set."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Sustainable Design"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Crafted with profound respect for nature and longevity.</p>"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link Label",
          "info": "Leave blank to hide link."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HPV6 Value Props",
      "blocks": [
        { "type": "value" },
        { "type": "value" },
        { "type": "value" },
        { "type": "value" }
      ]
    }
  ]
}
{% endschema %}
