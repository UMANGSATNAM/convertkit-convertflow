{%- liquid
  assign bg_color = section.settings.bg_color | default: '#0a0a0a'
  assign text_color = section.settings.text_color | default: '#ffffff'
  assign accent_color = section.settings.accent_color | default: '#00ffcc'
  
  assign padding_top_desktop = section.settings.padding_top_desktop
  assign padding_bottom_desktop = section.settings.padding_bottom_desktop
  assign padding_top_mobile = section.settings.padding_top_mobile
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile
-%}

<style>
  #shopify-section-{{ section.id }} {
    --hp3-ig-bg: {{ bg_color }};
    --hp3-ig-text: {{ text_color }};
    --hp3-ig-accent: {{ accent_color }};
    
    --hp3-ig-pt-desk: {{ padding_top_desktop }}px;
    --hp3-ig-pb-desk: {{ padding_bottom_desktop }}px;
    --hp3-ig-pt-mob: {{ padding_top_mobile }}px;
    --hp3-ig-pb-mob: {{ padding_bottom_mobile }}px;
  }

  .hp3-tech-ig-{{ section.id }} {
    padding-top: var(--hp3-ig-pt-desk);
    padding-bottom: var(--hp3-ig-pb-desk);
    background-color: var(--hp3-ig-bg);
    color: var(--hp3-ig-text);
    font-family: 'Inter', sans-serif;
  }

  .hp3-ig-inner {
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .hp3-ig-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 40px;
  }

  .hp3-ig-title {
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -1px;
    margin: 0 0 10px 0;
  }

  .hp3-ig-handle {
    font-size: 14px;
    font-weight: 600;
    color: var(--hp3-ig-accent);
    text-decoration: none;
    letter-spacing: 1px;
  }

  .hp3-ig-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 24px;
    background: transparent;
    border: 1px solid rgba(255,255,255,0.2);
    color: var(--hp3-ig-text);
    text-decoration: none;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    border-radius: 4px;
    transition: all 0.3s ease;
  }
  .hp3-ig-btn:hover {
    background: var(--hp3-ig-text);
    color: #000;
  }

  /* Grid Layout - Masonry style */
  .hp3-ig-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: 250px;
    gap: 15px;
  }

  .hp3-ig-item {
    position: relative;
    border-radius: 8px;
    overflow: hidden;
    display: block;
    background: #111;
  }

  /* Make items span differently for a dynamic grid */
  .hp3-ig-item:nth-child(1) { grid-column: span 2; grid-row: span 2; }
  .hp3-ig-item:nth-child(4) { grid-column: span 2; grid-row: span 1; }

  .hp3-ig-media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    opacity: 0.8;
  }
  .hp3-ig-item:hover .hp3-ig-media {
    transform: scale(1.05);
    opacity: 1;
  }

  /* Glitch overlay on hover */
  .hp3-ig-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0,255,204,0.1);
    opacity: 0;
    transition: opacity 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }
  .hp3-ig-item:hover .hp3-ig-overlay {
    opacity: 1;
  }

  .hp3-ig-icon {
    width: 40px; height: 40px;
    color: #fff;
    transform: scale(0.8);
    transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }
  .hp3-ig-item:hover .hp3-ig-icon {
    transform: scale(1);
  }

  @media screen and (max-width: 1024px) {
    .hp3-ig-grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .hp3-ig-item:nth-child(1) { grid-column: span 2; grid-row: span 2; }
    .hp3-ig-item:nth-child(4) { grid-column: span 1; grid-row: span 1; }
  }

  @media screen and (max-width: 768px) {
    .hp3-tech-ig-{{ section.id }} {
      padding-top: var(--hp3-ig-pt-mob);
      padding-bottom: var(--hp3-ig-pb-mob);
    }
    .hp3-ig-inner {
      padding: 0 20px;
    }
    .hp3-ig-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }
    .hp3-ig-grid {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 150px;
      gap: 10px;
    }
    .hp3-ig-item:nth-child(1) { grid-column: span 2; grid-row: span 2; }
    .hp3-ig-item:nth-child(4) { grid-column: span 1; grid-row: span 1; }
  }
</style>

<section class="hp3-tech-ig-{{ section.id }}" aria-label="Social Feed">
  <div class="hp3-ig-inner">
    
    <div class="hp3-ig-header">
      <div>
        <h2 class="hp3-ig-title">{{ section.settings.heading | default: 'SOCIAL HUB' }}</h2>
        <a href="{{ section.settings.link }}" class="hp3-ig-handle">{{ section.settings.handle | default: '@TECHBRAND' }}</a>
      </div>
      <a href="{{ section.settings.link }}" class="hp3-ig-btn" target="_blank" rel="noopener">FOLLOW US</a>
    </div>

    <div class="hp3-ig-grid">
      {%- for block in section.blocks limit: 5 -%}
        <a href="{{ block.settings.link | default: '#' }}" class="hp3-ig-item" target="_blank" rel="noopener" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img height="{{ block.settings.image.height }}" width="{{ block.settings.image.width }}" src="{{ block.settings.image | image_url: width: 800 }}" class="hp3-ig-media" loading="lazy" alt="Social Post">
          {%- else -%}
            {%- capture current -%}{% cycle 1, 2, 3, 4, 5 %}{%- endcapture -%}
            {{ 'product-' | append: current | placeholder_svg_tag: 'hp3-ig-media placeholder-svg' }}
          {%- endif -%}
          <div class="hp3-ig-overlay">
            <svg class="hp3-ig-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
          </div>
        </a>
      {%- endfor -%}

      {%- if section.blocks.size == 0 -%}
        {%- for i in (1..5) -%}
          <a href="#" class="hp3-ig-item">
            {%- capture current -%}{% cycle 1, 2, 3, 4, 5 %}{%- endcapture -%}
            {{ 'product-' | append: current | placeholder_svg_tag: 'hp3-ig-media placeholder-svg' }}
          </a>
        {%- endfor -%}
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "HP3 Tech Instagram",
  "tag": "section",
  "class": "section-hp3-ig",
  "max_blocks": 5,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "SOCIAL HUB"
    },
    {
      "type": "text",
      "id": "handle",
      "label": "Handle",
      "default": "@TECHBRAND"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Profile Link"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#0a0a0a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#00ffcc"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Top (Desktop)", "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Bottom (Desktop)", "default": 100
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Top (Mobile)", "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Bottom (Mobile)", "default": 60
    }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Social Post",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Post Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP3 Tech Instagram (Adv)",
      "category": "Social",
      "blocks": [
        { "type": "post" },
        { "type": "post" },
        { "type": "post" },
        { "type": "post" },
        { "type": "post" }
      ]
    }
  ]
}
{% endschema %}
