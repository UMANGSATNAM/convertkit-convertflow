{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@300;400;500&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --overlay-color: {{ section.settings.overlay_color }};
    
    --font-heading: 'Lora', serif;
    --font-body: 'Inter', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.8 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.8 | round }}px;
    }
  }

  .hp29-video-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp29-video-wrapper {
      padding: 0 20px;
    }
  }

  .hp29-video__container {
    position: relative;
    width: 100%;
    aspect-ratio: 16/9;
    border-radius: 400px 400px 30px 30px; /* Large Arch */
    overflow: hidden;
    box-shadow: 0 25px 50px rgba(0,0,0,0.08);
  }

  @media screen and (max-width: 992px) {
    .hp29-video__container {
      aspect-ratio: 4/3;
      border-radius: 200px 200px 20px 20px;
    }
  }

  @media screen and (max-width: 576px) {
    .hp29-video__container {
      aspect-ratio: 3/4;
      border-radius: 150px 150px 15px 15px;
    }
  }

  .hp29-video__media {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
  }

  .hp29-video__media video,
  .hp29-video__media iframe,
  .hp29-video__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hp29-video__overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0,0,0,{{ section.settings.overlay_opacity | divided_by: 100.0 }});
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 40px;
  }

  .hp29-video__badge {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--overlay-color);
    margin-bottom: 25px;
  }

  .hp29-video__title {
    font-family: var(--font-heading);
    font-size: clamp(36px, 6vw, {{ section.settings.title_size }}px);
    font-weight: 400;
    color: var(--overlay-color);
    margin: 0 0 20px;
    max-width: 800px;
    line-height: 1.15;
  }

  .hp29-video__title em {
    font-style: italic;
  }

  .hp29-video__play-btn {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: transparent;
    border: 1px solid rgba(255,255,255,0.4);
    color: var(--overlay-color);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    margin-top: 30px;
    transition: all 0.4s ease;
    backdrop-filter: blur(5px);
  }

  .hp29-video__play-btn svg {
    width: 24px;
    height: 24px;
    fill: currentColor;
    margin-left: 4px; /* Optical alignment */
    transition: transform 0.3s ease;
  }

  .hp29-video__play-btn:hover {
    background: rgba(255,255,255,0.1);
    border-color: rgba(255,255,255,0.8);
    transform: scale(1.05);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp29-video-wrapper" id="HP29Video-{{ section.id }}">
  <div class="hp29-video__container">
    
    <div class="hp29-video__media">
      {%- if section.settings.video_url != blank -%}
        <video autoplay muted loop playsinline>
          <source src="{{ section.settings.video_url }}" type="video/mp4">
        </video>
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'hp29-video__media-placeholder' }}
      {%- endif -%}
    </div>

    <div class="hp29-video__overlay">
      {%- if section.settings.badge != blank -%}
        <div class="hp29-video__badge">{{ section.settings.badge }}</div>
      {%- endif -%}

      {%- if section.settings.title != blank -%}
        <h2 class="hp29-video__title">{{ section.settings.title }}</h2>
      {%- endif -%}

      {%- if section.settings.show_play_btn -%}
        <button class="hp29-video__play-btn" aria-label="Play Video">
          <svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
        </button>
      {%- endif -%}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "HP29 - Boho Video",
  "class": "section-hp29-video-banner",
  "settings": [
    {
      "type": "header",
      "content": "Video"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "MP4 Video URL",
      "info": "Paste a direct link to an MP4 video."
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "default": "BEHIND THE SCENES"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Heading",
      "default": "Crafted slowly, <em>intentionally.</em>"
    },
    {
      "type": "checkbox",
      "id": "show_play_btn",
      "label": "Show Decorative Play Button",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1400
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 32,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 72
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Page Background",
      "default": "#F4F1DE"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay Text (White)",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Overlay Opacity",
      "default": 25
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP29 - Boho Video"
    }
  ]
}
{% endschema %}
