{%- style -%}
  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --border-color: #000000;
    --border-width: 3px;
    --shadow-offset: 6px;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    border-bottom: var(--border-width) solid var(--border-color);
    font-family: 'Space Grotesk', 'Outfit', sans-serif;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }

  .hp23-ugc-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp23-ugc-wrapper {
      padding: 0 20px;
    }
  }

  .hp23-ugc__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: {{ section.settings.header_margin }}px;
    border-bottom: var(--border-width) solid var(--border-color);
    padding-bottom: 20px;
  }

  @media screen and (max-width: 768px) {
    .hp23-ugc__header {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
  }

  .hp23-ugc__title {
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    font-weight: 900;
    color: var(--text-color);
    margin: 0;
    text-transform: uppercase;
    line-height: 1.1;
    letter-spacing: -1px;
  }

  .hp23-ugc__title em {
    font-style: normal;
    background: var(--accent-color);
    padding: 0 10px;
    border: var(--border-width) solid var(--border-color);
    box-shadow: 4px 4px 0 var(--border-color);
    display: inline-block;
    transform: rotate(2deg);
    margin-left: 8px;
  }

  .hp23-ugc__btn {
    display: inline-flex;
    align-items: center;
    padding: 12px 24px;
    background: var(--text-color);
    color: #ffffff;
    font-weight: 800;
    font-size: 14px;
    text-transform: uppercase;
    text-decoration: none;
    border: var(--border-width) solid var(--border-color);
    border-radius: {{ section.settings.border_radius }}px;
    box-shadow: 4px 4px 0 var(--border-color);
    transition: all 0.2s ease;
  }

  .hp23-ugc__btn:hover {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0 var(--border-color);
  }

  /* Grid for Reels */
  .hp23-ugc__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: 30px;
    /* Add padding so shadows aren't clipped */
    padding-bottom: 10px;
    padding-right: 10px;
  }

  @media screen and (max-width: 992px) {
    .hp23-ugc__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
  }

  @media screen and (max-width: 600px) {
    .hp23-ugc__grid {
      display: flex;
      flex-wrap: nowrap;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-bottom: 20px;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .hp23-ugc__grid::-webkit-scrollbar {
      display: none;
    }
  }

  .hp23-reel {
    position: relative;
    background: #ffffff;
    border: var(--border-width) solid var(--border-color);
    border-radius: {{ section.settings.border_radius }}px;
    box-shadow: var(--shadow-offset) var(--shadow-offset) 0 var(--border-color);
    aspect-ratio: 9/16;
    overflow: hidden;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  @media screen and (max-width: 600px) {
    .hp23-reel {
      flex: 0 0 75%;
      scroll-snap-align: start;
    }
  }

  .hp23-reel:hover {
    transform: translate(2px, 2px);
    box-shadow: calc(var(--shadow-offset) - 2px) calc(var(--shadow-offset) - 2px) 0 var(--border-color);
  }

  .hp23-reel__media {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hp23-reel__overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: linear-gradient(to bottom, rgba(0,0,0,0) 50%, rgba(0,0,0,0.8) 100%);
    z-index: 1;
  }

  .hp23-reel__play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 60px;
    height: 60px;
    background: var(--accent-color);
    border: 3px solid #000;
    box-shadow: 4px 4px 0 #000;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
  }

  .hp23-reel__play svg {
    width: 24px;
    height: 24px;
    fill: #000;
    margin-left: 4px;
  }

  .hp23-reel__info {
    position: absolute;
    bottom: 20px;
    left: 20px;
    right: 20px;
    z-index: 2;
  }

  .hp23-reel__handle {
    display: inline-block;
    background: #ffffff;
    color: #000000;
    padding: 4px 8px;
    font-size: 14px;
    font-weight: 800;
    border: 2px solid #000;
    margin-bottom: 8px;
  }

  .hp23-reel__caption {
    color: #ffffff;
    font-size: 14px;
    font-weight: 500;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp23-ugc-wrapper" id="HP23Ugc-{{ section.id }}">
  
  <div class="hp23-ugc__header">
    {%- if section.settings.title != blank -%}
      <h2 class="hp23-ugc__title">{{ section.settings.title }}</h2>
    {%- endif -%}

    {%- if section.settings.btn_text != blank -%}
      <a href="{{ section.settings.btn_link | default: '#' }}" class="hp23-ugc__btn">
        {{ section.settings.btn_text | escape }}
      </a>
    {%- endif -%}
  </div>

  <div class="hp23-ugc__grid">
    {%- for block in section.blocks -%}
      <div class="hp23-reel" {{ block.shopify_attributes }}>
        {%- if block.settings.video_url != blank -%}
          <!-- Placeholder for video -->
          <video class="hp23-reel__media" autoplay muted loop playsinline>
            <source src="{{ block.settings.video_url }}" type="video/mp4">
          </video>
        {%- elsif block.settings.image != blank -%}
          <img height="{{ block.settings.image.height }}" width="{{ block.settings.image.width }}" src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.handle | escape }}" class="hp23-reel__media" loading="lazy">
        {%- else -%}
          <div style="width:100%;height:100%;background:#333;" class="hp23-reel__media"></div>
        {%- endif -%}

        <div class="hp23-reel__overlay"></div>

        <div class="hp23-reel__play">
          <svg viewBox="0 0 24 24"><path d="M8,5.14V19.14L19,12.14L8,5.14Z"/></svg>
        </div>

        <div class="hp23-reel__info">
          {%- if block.settings.handle != blank -%}
            <div class="hp23-reel__handle">{{ block.settings.handle | escape }}</div>
          {%- endif -%}
          
          {%- if block.settings.caption != blank -%}
            <p class="hp23-reel__caption">{{ block.settings.caption | escape }}</p>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>

</div>

{% schema %}
{
  "name": "HP23 - Brutalist UGC",
  "class": "section-hp23-ugc-reels",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Heading",
      "default": "<p>AS SEEN ON <em>SOCIALS</em></p>"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "FOLLOW US"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "range",
      "id": "header_margin",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Margin Below Header",
      "default": 40
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1400
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 3,
      "max": 5,
      "step": 1,
      "label": "Columns (Desktop)",
      "default": 4
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Reel Border Radius",
      "default": 12
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 48
    },
    {
      "type": "header",
      "content": "Brutalist Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#F4F4F0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color (Play Button)",
      "default": "#39FF14"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "reel",
      "name": "Reel",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Cover Image"
        },
        {
          "type": "text",
          "id": "video_url",
          "label": "Video URL (MP4)",
          "info": "Overrides image if provided"
        },
        {
          "type": "text",
          "id": "handle",
          "label": "Social Handle",
          "default": "@username"
        },
        {
          "type": "textarea",
          "id": "caption",
          "label": "Caption",
          "default": "The absolute best purchase I've made all year. Don't walk, run! 🏃‍♀️"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP23 - Brutalist UGC",
      "blocks": [
        { "type": "reel" },
        { "type": "reel" },
        { "type": "reel" },
        { "type": "reel" }
      ]
    }
  ]
}
{% endschema %}
