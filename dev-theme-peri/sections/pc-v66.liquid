{%- comment -%}
  PC V66 — RETRO 80S ARCADE & RETROGAMING PRODUCT GRID
  Design: Arcade Black (#0D0B18), Arcade Yellow (#FFE600) & Neon Pink (#FF0066) accents, Bungee & Lexend typography
  Card Shape: 16px corners, 2px neon borders, 4px 3D offset shadows, 80s retrogaming aesthetic
{%- endcomment -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Bungee&family=Lexend:wght@600;700;800&display=swap');

  .pcv66 {
    --bg: {{ section.settings.bg_color | default: '#0D0B18' }};
    --card-bg: {{ section.settings.card_bg | default: '#171427' }};
    --text: {{ section.settings.text_color | default: '#FFFFFF' }};
    --muted: {{ section.settings.muted_color | default: '#A78BFA' }};
    --accent: {{ section.settings.accent_color | default: '#FFE600' }};
    --accent-hover: {{ section.settings.accent_hover | default: '#E6CF00' }};
    --border: {{ section.settings.border_color | default: '#FF0066' }};
    --badge-sale-bg: #FFE600;
    --badge-sale-text: #0D0B18;
    --f-heading: 'Bungee', cursive;
    --f-body: 'Lexend', sans-serif;
    --r-card: 16px;
    --ease: all 0.2s ease;
    background-color: var(--bg);
    color: var(--text);
    font-family: var(--f-body);
    padding: {{ section.settings.padding_top | default: 60 }}px 0 {{ section.settings.padding_bottom | default: 60 }}px 0;
    line-height: 1.4;
    -webkit-font-smoothing: antialiased;
  }

  .pcv66 *, .pcv66 *::before, .pcv66 *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .pcv66 a { color: inherit; text-decoration: none; }
  .pcv66 button { font-family: inherit; cursor: pointer; border: none; background: none; }
  .pcv66 img { max-width: 100%; display: block; }

  .pcv66__wrap { max-width: 1320px; margin: 0 auto; padding: 0 20px; }

  /* HEADER */
  .pcv66__head { display: flex; flex-direction: column; gap: 8px; margin-bottom: 36px; border-bottom: 3px solid var(--accent); padding-bottom: 16px; text-align: {{ section.settings.header_align | default: 'left' }}; }
  @media (min-width: 768px) {
    .pcv66__head { display: flex; flex-direction: row; justify-content: space-between; align-items: flex-end; }
  }
  .pcv66__title { font-family: var(--f-heading); font-size: 28px; font-weight: 400; color: var(--accent); text-shadow: 3px 3px 0px #FF0066; letter-spacing: 0.02em; text-transform: uppercase; }
  @media (min-width: 768px) { .pcv66__title { font-size: 38px; } }
  .pcv66__sub { font-size: 15px; color: var(--muted); }
  .pcv66__viewall { display: inline-flex; align-items: center; gap: 8px; font-weight: 800; font-size: 12px; font-family: var(--f-body); text-transform: uppercase; letter-spacing: 0.1em; color: #0D0B18; background: var(--accent); padding: 8px 20px; border-radius: 12px; border: 2px solid #0D0B18; box-shadow: 3px 3px 0px #FF0066; transition: var(--ease); }
  .pcv66__viewall:hover { background: #FF0066; color: #FFFFFF; box-shadow: 5px 5px 0px var(--accent); }

  /* GRID */
  .pcv66__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr);
    gap: 18px;
  }
  @media (min-width: 640px) {
    .pcv66__grid { grid-template-columns: repeat({{ section.settings.cols_tablet | default: 3 }}, 1fr); gap: 24px; }
  }
  @media (min-width: 1024px) {
    .pcv66__grid { grid-template-columns: repeat({{ section.settings.cols_desktop | default: 4 }}, 1fr); gap: 28px; }
  }

  /* CARD */
  .pcv66__card {
    background: var(--card-bg);
    border: 2px solid var(--border);
    border-radius: var(--r-card);
    display: flex;
    flex-direction: column;
    position: relative;
    box-shadow: 4px 4px 0px #FFE600;
    transition: var(--ease);
  }
  .pcv66__card:hover {
    transform: translate(-3px, -4px);
    border-color: #FFE600;
    box-shadow: 6px 6px 0px #00F0FF;
  }

  /* IMAGE CONTAINER */
  .pcv66__img-box {
    position: relative;
    width: 100%;
    aspect-ratio: {{ section.settings.img_ratio | default: '1/1' }};
    background: #080610;
    overflow: hidden;
    border-top-left-radius: calc(var(--r-card) - 2px);
    border-top-right-radius: calc(var(--r-card) - 2px);
    border-bottom: 2px solid var(--border);
  }
  .pcv66__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .pcv66__img--sec {
    position: absolute;
    top: 0; left: 0;
    opacity: 0;
  }
  .pcv66__card:hover .pcv66__img--pri {
    {% if section.settings.enable_sec_img %}
      opacity: 0;
    {% else %}
      transform: scale(1.06);
    {% endif %}
  }
  .pcv66__card:hover .pcv66__img--sec { opacity: 1; transform: scale(1.06); }

  /* BADGES */
  .pcv66__badges { position: absolute; top: 10px; left: 10px; display: flex; flex-direction: column; gap: 6px; z-index: 2; pointer-events: none; }
  .pcv66__badge { font-size: 10px; font-weight: 800; text-transform: uppercase; padding: 4px 10px; border-radius: 8px; border: 1.5px solid #0D0B18; letter-spacing: 0.05em; font-family: var(--f-body); }
  .pcv66__badge--sale { background: var(--badge-sale-bg); color: var(--badge-sale-text); }
  .pcv66__badge--tag { background: #FF0066; color: #FFFFFF; }
  .pcv66__badge--sold { background: #2D2744; color: #A78BFA; border-color: #2D2744; }

  /* WISHLIST BUTTON */
  .pcv66__wish {
    position: absolute;
    top: 10px; right: 10px;
    width: 36px; height: 36px;
    border-radius: 50%;
    background: #0D0B18;
    border: 2px solid var(--border);
    display: flex; align-items: center; justify-content: center;
    color: var(--accent);
    z-index: 3;
    transition: var(--ease);
  }
  .pcv66__wish:hover { background: var(--accent); color: #0D0B18; border-color: var(--accent); box-shadow: 0 0 10px #FFE600; }
  .pcv66__wish.active { color: #0D0B18; background: var(--accent); border-color: var(--accent); box-shadow: 0 0 10px #FFE600; }

  /* QUICK ADD HOVER */
  .pcv66__quick-box { padding: 12px; background: var(--card-bg); border-top: 2px solid var(--border); border-bottom-left-radius: calc(var(--r-card) - 2px); border-bottom-right-radius: calc(var(--r-card) - 2px); }
  .pcv66__quick-btn {
    width: 100%;
    padding: 10px 14px;
    background: var(--accent);
    color: #0D0B18;
    font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em;
    font-family: var(--f-body);
    border-radius: 10px;
    border: 2px solid #0D0B18;
    box-shadow: 2px 3px 0px #0D0B18;
    display: flex; align-items: center; justify-content: center; gap: 8px;
    transition: var(--ease);
  }
  .pcv66__quick-btn:hover { background: #FF0066; color: #FFFFFF; box-shadow: 4px 5px 0px #FFE600; }
  .pcv66__quick-btn:disabled { background: #2D2744; color: #A78BFA; cursor: not-allowed; box-shadow: none; border-color: #2D2744; }

  /* CARD CONTENT */
  .pcv66__content { padding: 14px; display: flex; flex-direction: column; gap: 6px; flex-grow: 1; }

  .pcv66__vendor { font-size: 10px; text-transform: uppercase; color: var(--accent); font-weight: 800; letter-spacing: 0.1em; }
  .pcv66__item-title { font-family: var(--f-body); font-size: 16px; font-weight: 800; color: var(--text); line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  /* RATING */
  .pcv66__rating { display: flex; align-items: center; gap: 6px; font-size: 12px; color: var(--accent); }
  .pcv66__stars { letter-spacing: 1px; text-shadow: 0 0 6px var(--accent); }
  .pcv66__rev-cnt { color: var(--muted); font-size: 11px; }

  /* PRICE */
  .pcv66__price-row { display: flex; align-items: baseline; gap: 8px; margin-top: auto; padding-top: 4px; }
  .pcv66__price { font-size: 18px; font-weight: 800; color: #FFFFFF; font-family: var(--f-body); }
  .pcv66__cmp-price { font-size: 13px; color: var(--muted); text-decoration: line-through; }

  /* SWATCHES */
  .pcv66__swatches { display: flex; gap: 6px; align-items: center; margin-top: 4px; }
  .pcv66__swatch { width: 14px; height: 14px; border-radius: 50%; border: 1.5px solid var(--border); cursor: pointer; transition: var(--ease); }
  .pcv66__swatch:hover, .pcv66__swatch.active { border-color: var(--accent); background: var(--accent); box-shadow: 0 0 6px var(--accent); }

  /* URGENCY MICRO */
  .pcv66__urgency { font-size: 11px; color: #FF0066; font-weight: 800; font-family: var(--f-body); text-transform: uppercase; display: flex; align-items: center; gap: 4px; margin-top: 2px; }

  /* TOAST */
  .pcv66__toast {
    position: fixed; bottom: 20px; right: 20px;
    background: var(--accent); color: #0D0B18;
    border: 2px solid #0D0B18; padding: 12px 20px; border-radius: 12px;
    font-size: 12px; font-weight: 800; text-transform: uppercase; font-family: var(--f-body);
    box-shadow: 4px 4px 0px #FF0066;
    z-index: 9999;
    transform: translateY(100px); opacity: 0;
    transition: all 0.2s ease;
  }
  .pcv66__toast.show { transform: translateY(0); opacity: 1; }
</style>

<div class="pcv66">
  <div class="pcv66__wrap">
    
    {% if section.settings.title != blank or section.settings.subheading != blank %}
      <div class="pcv66__head">
        <div>
          {% if section.settings.title != blank %}
            <h2 class="pcv66__title">{{ section.settings.title | escape }}</h2>
          {% endif %}
          {% if section.settings.subheading != blank %}
            <p class="pcv66__sub">{{ section.settings.subheading | escape }}</p>
          {% endif %}
        </div>
        {% if section.settings.show_view_all and section.settings.collection != blank %}
          <a href="{{ collections[section.settings.collection].url }}" class="pcv66__viewall">
            {{ section.settings.view_all_label | default: 'Shop 80s Arcade' }} 🕹️ &rarr;
          </a>
        {% endif %}
      </div>
    {% endif %}

    <div class="pcv66__grid">
      {% assign target_coll = collections[section.settings.collection] %}
      {% assign limit_num = section.settings.products_per_page | default: 8 %}

      {% if target_coll != blank and target_coll.products.size > 0 %}
        {% for product in target_coll.products limit: limit_num %}
          {% assign current_variant = product.selected_or_first_available_variant %}
          
          {% render 'card-v66', product: product, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v66', product: nil, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% endif %}
    </div>

  </div>
</div>

<div class="pcv66__toast" id="pcv66-toast">ARCADE ITEM ADDED</div>

<script>
(function(){
  // Wishlist is handled globally by assets/wishlist.js (shared store: cf_wishlist_items).
  // Buttons are rendered by snippets/wishlist-button.liquid — no per-section storage.


  document.querySelectorAll('[data-pcv66-add]').forEach(function(btn){
    btn.addEventListener('click', function(e){
      e.preventDefault(); e.stopPropagation();
      var id = btn.dataset.pcv66Add, orig = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = 'COINING...';

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: id, quantity: 1 })
      })
      .then(function(r){ return r.json(); })
      .then(function(){
        btn.innerHTML = '✓ ADDED';
        showT('ARCADE ITEM ADDED');
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      })
      .catch(function(){
        btn.innerHTML = 'ERROR';
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      });
    });
  });

  function showT(msg){
    var t = document.getElementById('pcv66-toast');
    if(!t) return;
    t.textContent = msg;
    t.classList.add('show');
    setTimeout(function(){ t.classList.remove('show'); }, 3000);
  }
})();
</script>

