{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#050505'
  assign text_color = section.settings.text_color | default: '#00FFA3'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 100px 40px;
    border-bottom: 1px solid #333;
  }
  
  .hp13-bestsellers-container-{{ section_id }} {
    max-width: 1400px;
    margin: 0 auto;
  }
  
  .hp13-bestsellers-header-{{ section_id }} {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 40px;
    border-bottom: 1px solid #333;
    padding-bottom: 20px;
  }
  
  .hp13-bestsellers-heading-{{ section_id }} {
    font-family: 'Arial Black', Impact, sans-serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 900;
    margin: 0;
    text-transform: uppercase;
    color: #FFF;
    letter-spacing: 2px;
  }
  
  .hp13-bestsellers-heading-{{ section_id }} span {
    color: {{ text_color }};
  }
  
  .hp13-view-all-btn-{{ section_id }} {
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.85rem;
    font-weight: bold;
    color: {{ text_color }};
    text-decoration: none;
    text-transform: uppercase;
  }
  
  .hp13-view-all-btn-{{ section_id }}:hover {
    text-decoration: underline;
  }
  
  .hp13-bestsellers-grid-{{ section_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 30px;
  }
  
  .hp13-product-card-{{ section_id }} {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    background: #111;
    border: 1px solid #333;
    position: relative;
    transition: all 0.2s ease;
  }
  
  .hp13-product-card-{{ section_id }}:hover {
    border-color: {{ text_color }};
    box-shadow: 0 0 15px rgba(0,255,163,0.2);
  }
  
  .hp13-product-image-wrap-{{ section_id }} {
    position: relative;
    padding-top: 100%;
    background: #000;
    border-bottom: 1px solid #333;
    overflow: hidden;
  }
  
  .hp13-product-image-{{ section_id }} {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover;
    filter: grayscale(100%);
    transition: filter 0.3s ease;
  }
  
  .hp13-product-card-{{ section_id }}:hover .hp13-product-image-{{ section_id }} {
    filter: grayscale(0%);
  }
  
  .hp13-product-badge-{{ section_id }} {
    position: absolute;
    top: 10px; left: 10px;
    background: {{ text_color }};
    color: #000;
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.7rem;
    font-weight: bold;
    padding: 3px 8px;
    text-transform: uppercase;
  }
  
  .hp13-product-info-{{ section_id }} {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  
  .hp13-product-title-{{ section_id }} {
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.9rem;
    font-weight: bold;
    color: #FFF;
    margin: 0;
    text-transform: uppercase;
  }
  
  .hp13-product-price-{{ section_id }} {
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.9rem;
    font-weight: bold;
    color: {{ text_color }};
  }

  @media (max-width: 1024px) {
    .hp13-bestsellers-grid-{{ section_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 60px 20px;
    }
    .hp13-bestsellers-header-{{ section_id }} {
      flex-direction: column;
      align-items: flex-start;
      gap: 15px;
    }
    .hp13-bestsellers-grid-{{ section_id }} {
      grid-template-columns: 1fr;
    }
  }
</style>

<div class="hp13-bestsellers-container-{{ section_id }}">
  <div class="hp13-bestsellers-header-{{ section_id }}">
    <h2 class="hp13-bestsellers-heading-{{ section_id }}">TOP <span>GEAR</span></h2>
    {% if section.settings.show_view_all %}
      <a href="{{ collections[section.settings.collection].url | default: '#' }}" class="hp13-view-all-btn-{{ section_id }}">[VIEW_ALL_DATA]</a>
    {% endif %}
  </div>
  
  <div class="hp13-bestsellers-grid-{{ section_id }}">
    {% assign collection = collections[section.settings.collection] %}
    {% if collection != blank %}
      {% for product in collection.products limit: section.settings.product_limit %}
        <a href="{{ product.url }}" class="hp13-product-card-{{ section_id }}">
          <div class="hp13-product-image-wrap-{{ section_id }}">
            <img height="{{ product.featured_image.height }}" width="{{ product.featured_image.width }}" src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title }}" class="hp13-product-image-{{ section_id }}" loading="lazy">
            {% if forloop.first %}
              <div class="hp13-product-badge-{{ section_id }}">SYS.BESTSELLER</div>
            {% endif %}
          </div>
          <div class="hp13-product-info-{{ section_id }}">
            <h3 class="hp13-product-title-{{ section_id }}">{{ product.title }}</h3>
            <div class="hp13-product-price-{{ section_id }}">{{ product.price | money }}</div>
          </div>
        </a>
      {% endfor %}
    {% else %}
      {% for i in (1..4) %}
        <a href="#" class="hp13-product-card-{{ section_id }}">
          <div class="hp13-product-image-wrap-{{ section_id }}">
            <div class="hp13-product-image-{{ section_id }}" style="background: #222;"></div>
            {% if i == 1 %}
              <div class="hp13-product-badge-{{ section_id }}">SYS.BESTSELLER</div>
            {% endif %}
          </div>
          <div class="hp13-product-info-{{ section_id }}">
            <h3 class="hp13-product-title-{{ section_id }}">MK-{{ i }} TACTICAL JACKET</h3>
            <div class="hp13-product-price-{{ section_id }}">$350.00</div>
          </div>
        </a>
      {% endfor %}
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "HP13 Bestsellers",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#050505"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Highlight Color",
      "default": "#00FFA3"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "product_limit",
      "min": 4,
      "max": 12,
      "step": 4,
      "label": "Product Limit",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show View All Link",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "HP13 Bestsellers"
    }
  ]
}
{% endschema %}
