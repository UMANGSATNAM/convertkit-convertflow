{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#ffffff'
  assign text_color = section.settings.text_color | default: '#000000'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    border-bottom: 1px solid rgba(0,0,0,0.1);
    position: sticky;
    top: 0;
    z-index: 99;
  }
  
  .hp15-header-container-{{ section_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 40px;
    max-width: 1600px;
    margin: 0 auto;
  }
  
  .hp15-header-menu-{{ section_id }} {
    display: flex;
    gap: 30px;
    list-style: none;
    margin: 0;
    padding: 0;
    flex: 1;
  }
  
  .hp15-header-menu-{{ section_id }} a {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: {{ text_color }};
    text-decoration: none;
    position: relative;
  }
  
  .hp15-header-menu-{{ section_id }} a::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 1px;
    background: {{ text_color }};
    transition: width 0.3s ease;
  }
  
  .hp15-header-menu-{{ section_id }} a:hover::after {
    width: 100%;
  }
  
  .hp15-header-logo-{{ section_id }} {
    font-family: 'Didot', 'Playfair Display', serif;
    font-size: 2.2rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 4px;
    color: {{ text_color }};
    text-decoration: none;
    text-align: center;
    flex: 1;
  }
  
  .hp15-header-icons-{{ section_id }} {
    display: flex;
    gap: 20px;
    justify-content: flex-end;
    flex: 1;
  }
  
  .hp15-header-icon-{{ section_id }} {
    color: {{ text_color }};
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .hp15-header-icon-{{ section_id }} svg {
    width: 20px;
    height: 20px;
    stroke-width: 1.2;
  }
  
  .hp15-header-hamburger-{{ section_id }} {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    color: {{ text_color }};
  }

  @media (max-width: 992px) {
    .hp15-header-menu-{{ section_id }} {
      display: none;
    }
    .hp15-header-hamburger-{{ section_id }} {
      display: block;
      flex: 1;
      text-align: left;
    }
    .hp15-header-container-{{ section_id }} {
      padding: 15px 20px;
    }
    .hp15-header-logo-{{ section_id }} {
      font-size: 1.5rem;
      letter-spacing: 2px;
    }
  }
</style>

<div class="hp15-header-container-{{ section_id }}">
  <button class="hp15-header-hamburger-{{ section_id }}">
    <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="1.2" fill="none"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
  </button>

  <ul class="hp15-header-menu-{{ section_id }}">
    <li><a href="#">New Arrivals</a></li>
    <li><a href="#">Ready to Wear</a></li>
    <li><a href="#">Accessories</a></li>
    <li><a href="#">Campaign</a></li>
  </ul>
  
  <a href="/" class="hp15-header-logo-{{ section_id }}">{{ shop.name | default: 'Maison' }}</a>
  
  <div class="hp15-header-icons-{{ section_id }}">
    <a href="/search" class="hp15-header-icon-{{ section_id }}">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
    </a>
    <a href="/account" class="hp15-header-icon-{{ section_id }}">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
    </a>
    {% render 'search-bar', compact: true %}
    {% render 'wishlist-icon' %}
    <a href="/cart" data-cart-open class="hp15-header-icon-{{ section_id }}">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
    </a>
  </div>
</div>

{% schema %}
{
  "name": "HP15 Header",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "HP15 Header"
    }
  ]
}
{% endschema %}
