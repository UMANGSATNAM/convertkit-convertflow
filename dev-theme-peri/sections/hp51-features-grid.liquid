{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp51-feat-bg: {{ section.settings.bg_color | default: '#F2EFE9' }};
    --hp51-matcha: {{ section.settings.accent_matcha | default: '#2D5A3D' }};
    
    background-color: var(--hp51-feat-bg);
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }

  .hp51-feat__wrap {
    max-width: {{ section.settings.container_width | default: 1240 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp51-feat__header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 50px;
  }

  .hp51-feat__heading {
    font-family: 'Noto Serif JP', serif;
    font-size: clamp(32px, 4.5vw, 44px);
    font-weight: 700;
    color: #1E3A2B;
    margin: 0 0 8px;
  }

  .hp51-feat__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: 3 }}, 1fr);
    gap: 24px;
  }

  .hp51-feat__card {
    background: #FAF8F5;
    border: 1px solid rgba(30, 58, 43, 0.12);
    border-radius: 16px;
    padding: 36px 28px;
    box-shadow: 0 10px 30px rgba(30, 58, 43, 0.04);
    transition: all 0.3s ease;
  }

  .hp51-feat__card:hover {
    border-color: var(--hp51-matcha);
    transform: translateY(-4px);
    box-shadow: 0 15px 40px rgba(30, 58, 43, 0.08);
  }

  .hp51-feat__title {
    font-family: 'Noto Serif JP', serif;
    font-size: 18px;
    font-weight: 700;
    color: #1E3A2B;
    margin: 0 0 12px;
  }

  .hp51-feat__desc {
    font-size: 14px;
    line-height: 1.8;
    color: #4A5B50;
    margin: 0;
  }

  @media screen and (max-width: 992px) {
    .hp51-feat__grid { grid-template-columns: 1fr; }
  }
{%- endstyle -%}

<div class="hp51-feat__wrap">
  <div class="hp51-feat__header">
    <h2 class="hp51-feat__heading">Botanical Science of Kyoto</h2>
    <p style="font-size:14px; color:#4A5B50;">{{ section.settings.subheading | default: 'Traditional Japanese tea harvesting meets micro-cellular delivery.' }}</p>
  </div>

  <div class="hp51-feat__grid">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <div class="hp51-feat__card" {{ block.shopify_attributes }}>
          <h3 class="hp51-feat__title">{{ block.settings.title }}</h3>
          <p class="hp51-feat__desc">{{ block.settings.description }}</p>
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="hp51-feat__card">
        <h3 class="hp51-feat__title">Shade-Canopy Camellia</h3>
        <p class="hp51-feat__desc">Dark tarp covers block 90% of sunlight before harvest, supercharging chlorophyll and calming amino acid levels.</p>
      </div>
      <div class="hp51-feat__card">
        <h3 class="hp51-feat__title">Granite Mill Micronization</h3>
        <p class="hp51-feat__desc">Traditional slow-revolving granite stones grind tea leaves into ultra-fine 5-micron particles for optimal dermal penetration.</p>
      </div>
      <div class="hp51-feat__card">
        <h3 class="hp51-feat__title">Fresh Bamboo Sap Infusion</h3>
        <p class="hp51-feat__desc">Replacing tap water with bio-compatible bamboo sap to flood cells with restorative silica and minerals.</p>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP51 - Zen Feat",
  "class": "section-hp51-features",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#F2EFE9" },
    { "type": "color", "id": "accent_matcha", "label": "Matcha Accent", "default": "#2D5A3D" },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "label": "Desktop Columns", "default": 3 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1240 }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Card",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Shade-Canopy Camellia" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Dark tarp covers block sunlight before harvest." }
      ]
    }
  ],
  "presets": [
    { "name": "HP51 - Zen Feat" }
  ]
}
{% endschema %}
