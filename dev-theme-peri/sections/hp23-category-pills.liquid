{%- style -%}
  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --border-color: #000000;
    --border-width: 3px;
    --shadow-offset: 4px;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    border-bottom: var(--border-width) solid var(--border-color);
    font-family: 'Space Grotesk', 'Outfit', sans-serif;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }

  .hp23-categories-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: {{ section.settings.alignment }};
    gap: 20px;
  }

  @media screen and (max-width: 768px) {
    .hp23-categories-wrapper {
      padding: 0 20px;
      gap: 16px;
      justify-content: flex-start;
      overflow-x: auto;
      flex-wrap: nowrap;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none; /* Firefox */
      padding-bottom: 10px; /* space for shadow */
    }
    .hp23-categories-wrapper::-webkit-scrollbar {
      display: none;
    }
  }

  {%- if section.settings.title != blank -%}
  .hp23-categories__title {
    font-size: clamp(20px, 4vw, {{ section.settings.title_size }}px);
    font-weight: 900;
    color: var(--text-color);
    margin: 0 20px 0 0;
    text-transform: uppercase;
    white-space: nowrap;
  }
  {%- endif -%}

  .hp23-categories__pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 24px;
    background: #ffffff;
    color: var(--text-color);
    text-decoration: none;
    font-weight: 800;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    border: var(--border-width) solid var(--border-color);
    border-radius: {{ section.settings.border_radius }}px;
    box-shadow: var(--shadow-offset) var(--shadow-offset) 0 var(--border-color);
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .hp23-categories__pill:hover {
    background: var(--accent-color);
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0 var(--border-color);
  }
  
  .hp23-categories__pill:active {
    transform: translate(4px, 4px);
    box-shadow: 0 0 0 var(--border-color);
  }

  /* Give random alternating highlight colors on hover to certain blocks if preferred */
  .hp23-categories__pill--highlight-1:hover { background: #FFEB3B; }
  .hp23-categories__pill--highlight-2:hover { background: #39FF14; }
  .hp23-categories__pill--highlight-3:hover { background: #FF3B30; }

  .hp23-categories__icon {
    width: 24px;
    height: 24px;
    object-fit: contain;
  }

  .hp23-categories__icon--svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp23-categories-wrapper" id="HP23Categories-{{ section.id }}">
  {%- if section.settings.title != blank -%}
    <h2 class="hp23-categories__title">{{ section.settings.title | escape }}</h2>
  {%- endif -%}

  {%- for block in section.blocks -%}
    {%- assign mod = forloop.index | modulo: 3 -%}
    {%- assign hover_class = '' -%}
    {%- if section.settings.multicolor_hover -%}
      {%- if mod == 0 -%}{%- assign hover_class = 'hp23-categories__pill--highlight-1' -%}
      {%- elsif mod == 1 -%}{%- assign hover_class = 'hp23-categories__pill--highlight-2' -%}
      {%- else -%}{%- assign hover_class = 'hp23-categories__pill--highlight-3' -%}
      {%- endif -%}
    {%- endif -%}

    <a href="{{ block.settings.link | default: '#' }}" class="hp23-categories__pill {{ hover_class }}" {{ block.shopify_attributes }}>
      {%- if block.settings.image != blank -%}
        <img height="{{ block.settings.image.height }}" width="{{ block.settings.image.width }}" src="{{ block.settings.image | image_url: width: 48 }}" alt="" class="hp23-categories__icon" loading="lazy">
      {%- elsif block.settings.svg != blank -%}
        <div class="hp23-categories__icon--svg">{{ block.settings.svg }}</div>
      {%- endif -%}
      
      <span>{{ block.settings.title | escape }}</span>
    </a>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "HP23 - Brutalist Pills",
  "class": "section-hp23-category-pills",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "JUMP TO:"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Desktop Alignment",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "multicolor_hover",
      "label": "Enable Multi-color hover",
      "default": true,
      "info": "Pills will alternate hover colors (Yellow/Green/Red) instead of just using Accent Color."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1400
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Border Radius",
      "default": 8
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 16,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Heading Size",
      "default": 24
    },
    {
      "type": "header",
      "content": "Brutalist Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#F4F4F0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Base Accent Color (Hover)",
      "default": "#FF3B30"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 40
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Tag",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Tag Title",
          "default": "Category"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image Icon (Optional)"
        },
        {
          "type": "html",
          "id": "svg",
          "label": "SVG Icon (Optional)",
          "info": "Paste raw SVG code"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP23 - Brutalist Pills",
      "blocks": [
        { "type": "category", "settings": { "title": "NEW ARRIVALS", "svg": "<svg viewBox=\"0 0 24 24\"><path d=\"M12,17.27L18.18,21L16.54,13.97L22,9.24L14.81,8.62L12,2L9.19,8.62L2,9.24L7.45,13.97L5.82,21L12,17.27Z\"/></svg>" } },
        { "type": "category", "settings": { "title": "BESTSELLERS", "svg": "<svg viewBox=\"0 0 24 24\"><path d=\"M11 15H6L13 1V9H18L11 23V15Z\"/></svg>" } },
        { "type": "category", "settings": { "title": "SKINCARE", "svg": "<svg viewBox=\"0 0 24 24\"><path d=\"M12 2C12.55 2 13 2.45 13 3V7.5L18.46 16.5C18.82 17.07 19 17.77 19 18.5C19 20.43 17.43 22 15.5 22H8.5C6.57 22 5 20.43 5 18.5C5 17.77 5.18 17.07 5.54 16.5L11 7.5V3C11 2.45 11.45 2 12 2M12 4H12V8L7.54 15.4C7.18 15.96 7 16.73 7 17.5C7 18.33 7.67 19 8.5 19H15.5C16.33 19 17 18.33 17 17.5C17 16.73 16.82 15.96 16.46 15.4L12 8V4Z\"/></svg>" } },
        { "type": "category", "settings": { "title": "BUNDLES", "svg": "<svg viewBox=\"0 0 24 24\"><path d=\"M12,3L2,8L12,13L22,8L12,3M2,10.18V15L12,20L22,15V10.18L12,15.18L2,10.18Z\"/></svg>" } }
      ]
    }
  ]
}
{% endschema %}
