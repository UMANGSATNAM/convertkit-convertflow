{%- liquid
  assign bg_color = section.settings.bg_color | default: '#FFFFFF'
  assign text_color = section.settings.text_color | default: '#1C1917'
-%}

<section class="hp1-fresh-products" style="--bg: {{ bg_color }}; --text: {{ text_color }};">
  <div class="hp1-fresh-products__container">
    
    <!-- Section Header -->
    <div class="hp1-fresh-products__header">
      <div class="hp1-fresh-products__title-wrap">
        <span class="hp1-fresh-products__tag">Clinically Tested Formulations</span>
        <h2 class="hp1-fresh-products__title">{{ section.settings.title | default: 'Customer Most-Loved Best-Sellers' }}</h2>
      </div>
      <a href="{{ section.settings.view_all_link | default: '#' }}" class="hp1-fresh-products__view-all">
        <span>View All Best-Sellers (18)</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
      </a>
    </div>

    <!-- Product Grid -->
    <div class="hp1-fresh-products__grid">
      
      <!-- Product Card 1 -->
      <div class="hp1-fresh-card">
        <div class="hp1-fresh-card__badge hp1-fresh-card__badge--bestseller">Best Seller</div>
        <div class="hp1-fresh-card__media">
          <img src="https://images.unsplash.com/photo-1620916566398-39f1143ab7be?q=80&w=800&auto=format&fit=crop" alt="Botanical Nectar Serum" class="hp1-fresh-card__img hp1-fresh-card__img--primary">
          <img src="https://images.unsplash.com/photo-1608248597261-e4d316b25126?q=80&w=800&auto=format&fit=crop" alt="Botanical Nectar Serum Alt" class="hp1-fresh-card__img hp1-fresh-card__img--secondary">
          <button class="hp1-fresh-card__quick-add" aria-label="Quick Add to Cart">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
            <span>Quick Add — $42</span>
          </button>
        </div>
        <div class="hp1-fresh-card__content">
          <div class="hp1-fresh-card__ratings">
            <span class="hp1-fresh-card__stars">★★★★★</span>
            <span class="hp1-fresh-card__review-count">(3,420)</span>
          </div>
          <h3 class="hp1-fresh-card__title"><a href="#">Botanical Nectar Barrier Glow Serum</a></h3>
          <p class="hp1-fresh-card__desc">Intense hydration with Triple Hyaluronic Acid & Squalane.</p>
          <div class="hp1-fresh-card__footer">
            <div class="hp1-fresh-card__prices">
              <span class="hp1-fresh-card__price">$42.00</span>
              <span class="hp1-fresh-card__compare-price">$52.00</span>
            </div>
            <span class="hp1-fresh-card__urgency">⚡ Only 4 left</span>
          </div>
        </div>
      </div>

      <!-- Product Card 2 -->
      <div class="hp1-fresh-card">
        <div class="hp1-fresh-card__badge hp1-fresh-card__badge--new">New Formula</div>
        <div class="hp1-fresh-card__media">
          <img src="https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?q=80&w=800&auto=format&fit=crop" alt="Velvet Cleansing Elixir" class="hp1-fresh-card__img hp1-fresh-card__img--primary">
          <img src="https://images.unsplash.com/photo-1598440947619-2c35fc9aa908?q=80&w=800&auto=format&fit=crop" alt="Velvet Cleansing Elixir Alt" class="hp1-fresh-card__img hp1-fresh-card__img--secondary">
          <button class="hp1-fresh-card__quick-add" aria-label="Quick Add to Cart">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
            <span>Quick Add — $36</span>
          </button>
        </div>
        <div class="hp1-fresh-card__content">
          <div class="hp1-fresh-card__ratings">
            <span class="hp1-fresh-card__stars">★★★★★</span>
            <span class="hp1-fresh-card__review-count">(1,840)</span>
          </div>
          <h3 class="hp1-fresh-card__title"><a href="#">Velvet Camellia Gentle Oil Cleanser</a></h3>
          <p class="hp1-fresh-card__desc">Melts waterproof makeup while soothing sensitive skin.</p>
          <div class="hp1-fresh-card__footer">
            <div class="hp1-fresh-card__prices">
              <span class="hp1-fresh-card__price">$36.00</span>
            </div>
            <span class="hp1-fresh-card__in-stock">In Stock</span>
          </div>
        </div>
      </div>

      <!-- Product Card 3 -->
      <div class="hp1-fresh-card">
        <div class="hp1-fresh-card__badge hp1-fresh-card__badge--save">Save 20%</div>
        <div class="hp1-fresh-card__media">
          <img src="https://images.unsplash.com/photo-1556228720-195a672e8a03?q=80&w=800&auto=format&fit=crop" alt="Dewy Rose Cream" class="hp1-fresh-card__img hp1-fresh-card__img--primary">
          <img src="https://images.unsplash.com/photo-1567928269569-42bd3d7782b5?q=80&w=800&auto=format&fit=crop" alt="Dewy Rose Cream Alt" class="hp1-fresh-card__img hp1-fresh-card__img--secondary">
          <button class="hp1-fresh-card__quick-add" aria-label="Quick Add to Cart">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
            <span>Quick Add — $48</span>
          </button>
        </div>
        <div class="hp1-fresh-card__content">
          <div class="hp1-fresh-card__ratings">
            <span class="hp1-fresh-card__stars">★★★★★</span>
            <span class="hp1-fresh-card__review-count">(2,910)</span>
          </div>
          <h3 class="hp1-fresh-card__title"><a href="#">Dewy Rose Ceramide Barrier Cream</a></h3>
          <p class="hp1-fresh-card__desc">Rich 24-hour hydration cream infused with Rosehip Oil.</p>
          <div class="hp1-fresh-card__footer">
            <div class="hp1-fresh-card__prices">
              <span class="hp1-fresh-card__price">$48.00</span>
              <span class="hp1-fresh-card__compare-price">$60.00</span>
            </div>
            <span class="hp1-fresh-card__urgency">⚡ Selling fast</span>
          </div>
        </div>
      </div>

      <!-- Product Card 4 -->
      <div class="hp1-fresh-card">
        <div class="hp1-fresh-card__media">
          <img src="https://images.unsplash.com/photo-1617897903246-719242758050?q=80&w=800&auto=format&fit=crop" alt="Midnight Reset Mask" class="hp1-fresh-card__img hp1-fresh-card__img--primary">
          <img src="https://images.unsplash.com/photo-1598440947619-2c35fc9aa908?q=80&w=800&auto=format&fit=crop" alt="Midnight Reset Mask Alt" class="hp1-fresh-card__img hp1-fresh-card__img--secondary">
          <button class="hp1-fresh-card__quick-add" aria-label="Quick Add to Cart">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
            <span>Quick Add — $54</span>
          </button>
        </div>
        <div class="hp1-fresh-card__content">
          <div class="hp1-fresh-card__ratings">
            <span class="hp1-fresh-card__stars">★★★★★</span>
            <span class="hp1-fresh-card__review-count">(1,150)</span>
          </div>
          <h3 class="hp1-fresh-card__title"><a href="#">Midnight Bakuchiol Overnight Mask</a></h3>
          <p class="hp1-fresh-card__desc">Gentle plant-based retinol alternative for firm, smooth skin.</p>
          <div class="hp1-fresh-card__footer">
            <div class="hp1-fresh-card__prices">
              <span class="hp1-fresh-card__price">$54.00</span>
            </div>
            <span class="hp1-fresh-card__in-stock">In Stock</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .hp1-fresh-products {
    background-color: var(--bg);
    color: var(--text);
    padding: 96px 24px;
    font-family: 'Plus Jakarta Sans', sans-serif;
  }
  .hp1-fresh-products__container {
    max-width: 1280px;
    margin: 0 auto;
  }

  .hp1-fresh-products__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 48px;
  }
  .hp1-fresh-products__tag {
    display: block;
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #D97706;
    margin-bottom: 8px;
  }
  .hp1-fresh-products__title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(28px, 3.5vw, 40px);
    font-weight: 700;
    margin: 0;
  }
  .hp1-fresh-products__view-all {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
    transition: gap 0.2s ease;
  }
  .hp1-fresh-products__view-all:hover { gap: 12px; }

  /* Product Grid */
  .hp1-fresh-products__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 28px;
  }
  @media (max-width: 1024px) {
    .hp1-fresh-products__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 576px) {
    .hp1-fresh-products__grid { grid-template-columns: 1fr; }
  }

  /* Card */
  .hp1-fresh-card {
    background: #FAF9F6;
    border-radius: 20px;
    overflow: hidden;
    position: relative;
    display: flex;
    flex-direction: column;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    border: 1px solid rgba(28, 25, 23, 0.06);
  }
  .hp1-fresh-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.08);
  }

  .hp1-fresh-card__badge {
    position: absolute;
    top: 16px;
    left: 16px;
    z-index: 4;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 6px 12px;
    border-radius: 100px;
  }
  .hp1-fresh-card__badge--bestseller { background: #1C1917; color: #FFF; }
  .hp1-fresh-card__badge--new { background: #D97706; color: #FFF; }
  .hp1-fresh-card__badge--save { background: #DC2626; color: #FFF; }

  .hp1-fresh-card__media {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    background: #F3EFEA;
    overflow: hidden;
  }
  .hp1-fresh-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.4s ease, transform 0.4s ease;
  }
  .hp1-fresh-card__img--secondary {
    position: absolute;
    top: 0; left: 0;
    opacity: 0;
  }
  .hp1-fresh-card:hover .hp1-fresh-card__img--primary { opacity: 0; }
  .hp1-fresh-card:hover .hp1-fresh-card__img--secondary { opacity: 1; transform: scale(1.05); }

  /* Quick Add */
  .hp1-fresh-card__quick-add {
    position: absolute;
    bottom: 16px;
    left: 16px;
    right: 16px;
    z-index: 5;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(8px);
    border: none;
    padding: 12px;
    border-radius: 100px;
    font-size: 13px;
    font-weight: 600;
    color: #1C1917;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    cursor: pointer;
    transform: translateY(100%);
    opacity: 0;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .hp1-fresh-card:hover .hp1-fresh-card__quick-add {
    transform: translateY(0);
    opacity: 1;
  }
  .hp1-fresh-card__quick-add:hover {
    background: #1C1917;
    color: #FFF;
  }

  .hp1-fresh-card__content {
    padding: 20px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }
  .hp1-fresh-card__ratings {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 8px;
  }
  .hp1-fresh-card__stars { color: #F59E0B; font-size: 13px; letter-spacing: 1px; }
  .hp1-fresh-card__review-count { font-size: 12px; color: rgba(28, 25, 23, 0.5); }

  .hp1-fresh-card__title {
    font-family: 'Playfair Display', serif;
    font-size: 18px;
    font-weight: 600;
    margin: 0 0 6px 0;
  }
  .hp1-fresh-card__title a {
    color: var(--text);
    text-decoration: none;
  }
  .hp1-fresh-card__desc {
    font-size: 13px;
    color: rgba(28, 25, 23, 0.7);
    line-height: 1.4;
    margin: 0 0 16px 0;
  }

  .hp1-fresh-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    padding-top: 12px;
    border-top: 1px solid rgba(28, 25, 23, 0.08);
  }
  .hp1-fresh-card__prices {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .hp1-fresh-card__price {
    font-size: 16px;
    font-weight: 700;
    color: #1C1917;
  }
  .hp1-fresh-card__compare-price {
    font-size: 13px;
    color: rgba(28, 25, 23, 0.4);
    text-decoration: line-through;
  }

  .hp1-fresh-card__urgency {
    font-size: 11px;
    font-weight: 600;
    color: #DC2626;
    background: #FEF2F2;
    padding: 4px 8px;
    border-radius: 6px;
  }
  .hp1-fresh-card__in-stock {
    font-size: 11px;
    font-weight: 600;
    color: #059669;
    background: #ECFDF5;
    padding: 4px 8px;
    border-radius: 6px;
  }
</style>

{% schema %}
{
  "name": "HP1 Fresh - Products Grid",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "Section Title", "default": "Customer Most-Loved Best-Sellers" },
    { "type": "url", "id": "view_all_link", "label": "View All Link" },
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#1C1917" }
  ],
  "presets": [
    { "name": "HP1 Fresh - Products Grid" }
  ]
}
{% endschema %}
