{%- liquid
  assign bg_color = section.settings.bg_color | default: '#f4f7f9'
  assign text_color = section.settings.text_color | default: '#1a2a3a'
  assign accent_color = section.settings.accent_color | default: '#0066cc'
  
  assign padding_top_desktop = section.settings.padding_top_desktop
  assign padding_bottom_desktop = section.settings.padding_bottom_desktop
  assign padding_top_mobile = section.settings.padding_top_mobile
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile
-%}

<style>
  #shopify-section-{{ section.id }} {
    --hp5-faq-bg: {{ bg_color }};
    --hp5-faq-text: {{ text_color }};
    --hp5-faq-accent: {{ accent_color }};
    
    --hp5-faq-pt-desk: {{ padding_top_desktop }}px;
    --hp5-faq-pb-desk: {{ padding_bottom_desktop }}px;
    --hp5-faq-pt-mob: {{ padding_top_mobile }}px;
    --hp5-faq-pb-mob: {{ padding_bottom_mobile }}px;
  }

  .hp5-health-faq-{{ section.id }} {
    padding-top: var(--hp5-faq-pt-desk);
    padding-bottom: var(--hp5-faq-pb-desk);
    background-color: var(--hp5-faq-bg);
    color: var(--hp5-faq-text);
    font-family: 'Inter', sans-serif;
  }

  .hp5-faq-inner {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .hp5-faq-header {
    text-align: center;
    margin-bottom: 50px;
  }

  .hp5-faq-title {
    font-size: clamp(32px, 4vw, 40px);
    font-weight: 700;
    line-height: 1.2;
    margin: 0;
    letter-spacing: -1px;
  }

  .hp5-faq-list {
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  .hp5-faq-item {
    background: #ffffff;
    border-radius: 12px;
    border: 1px solid rgba(26,42,58,0.05);
    overflow: hidden;
    transition: box-shadow 0.3s ease;
  }
  .hp5-faq-item:hover {
    box-shadow: 0 5px 15px rgba(0,0,0,0.03);
  }

  .hp5-faq-question {
    width: 100%;
    text-align: left;
    background: transparent;
    border: none;
    padding: 25px 30px;
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    font-weight: 700;
    color: var(--hp5-faq-text);
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .hp5-faq-icon {
    width: 24px;
    height: 24px;
    background: #e6eff6;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    color: var(--hp5-faq-accent);
    flex-shrink: 0;
    margin-left: 20px;
    position: relative;
  }
  .hp5-faq-icon::before, .hp5-faq-icon::after {
    content: '';
    position: absolute;
    background: currentColor;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    transition: transform 0.3s ease;
  }
  .hp5-faq-icon::before { width: 10px; height: 2px; }
  .hp5-faq-icon::after { height: 10px; width: 2px; }

  .hp5-faq-item.is-open .hp5-faq-icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
    opacity: 0;
  }
  .hp5-faq-item.is-open .hp5-faq-icon {
    background: var(--hp5-faq-accent);
    color: #ffffff;
  }

  .hp5-faq-answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .hp5-faq-answer-inner {
    padding: 0 30px 25px 30px;
    font-size: 15px;
    line-height: 1.6;
    color: rgba(26,42,58,0.7);
  }
  .hp5-faq-answer-inner p { margin: 0 0 15px 0; }
  .hp5-faq-answer-inner p:last-child { margin: 0; }

  @media screen and (max-width: 768px) {
    .hp5-health-faq-{{ section.id }} {
      padding-top: var(--hp5-faq-pt-mob);
      padding-bottom: var(--hp5-faq-pb-mob);
    }
    .hp5-faq-inner {
      padding: 0 20px;
    }
    .hp5-faq-question {
      font-size: 15px;
      padding: 20px;
    }
    .hp5-faq-answer-inner {
      padding: 0 20px 20px 20px;
    }
  }
</style>

<section class="hp5-health-faq-{{ section.id }}" aria-label="FAQ">
  <div class="hp5-faq-inner">
    
    {%- if section.settings.heading != blank -%}
      <div class="hp5-faq-header">
        <h2 class="hp5-faq-title">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    <div class="hp5-faq-list">
      {%- for block in section.blocks -%}
        <div class="hp5-faq-item" {{ block.shopify_attributes }}>
          <button class="hp5-faq-question" aria-expanded="false">
            {{ block.settings.question }}
            <span class="hp5-faq-icon"></span>
          </button>
          <div class="hp5-faq-answer">
            <div class="hp5-faq-answer-inner">
              {{ block.settings.answer }}
            </div>
          </div>
        </div>
      {%- endfor -%}

      {%- if section.blocks.size == 0 -%}
        {%- for i in (1..4) -%}
          <div class="hp5-faq-item">
            <button class="hp5-faq-question" aria-expanded="false">
              Are your supplements third-party tested?
              <span class="hp5-faq-icon"></span>
            </button>
            <div class="hp5-faq-answer">
              <div class="hp5-faq-answer-inner">
                <p>Yes, every single batch is rigorously tested by independent ISO-certified laboratories to ensure purity, potency, and safety. We test for heavy metals, microbes, and active ingredient concentration.</p>
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const section = document.querySelector('.hp5-health-faq-{{ section.id }}');
    if(!section) return;

    const questions = section.querySelectorAll('.hp5-faq-question');
    questions.forEach(q => {
      q.addEventListener('click', function() {
        const item = this.parentElement;
        const answer = item.querySelector('.hp5-faq-answer');
        const isOpen = item.classList.contains('is-open');

        // Close all others
        section.querySelectorAll('.hp5-faq-item').forEach(otherItem => {
          if(otherItem !== item) {
            otherItem.classList.remove('is-open');
            otherItem.querySelector('.hp5-faq-answer').style.maxHeight = null;
            otherItem.querySelector('.hp5-faq-question').setAttribute('aria-expanded', 'false');
          }
        });

        // Toggle current
        if(isOpen) {
          item.classList.remove('is-open');
          answer.style.maxHeight = null;
          this.setAttribute('aria-expanded', 'false');
        } else {
          item.classList.add('is-open');
          answer.style.maxHeight = answer.scrollHeight + "px";
          this.setAttribute('aria-expanded', 'true');
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "HP5 Health FAQ",
  "tag": "section",
  "class": "section-hp5-faq",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Common Questions"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f4f7f9"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1a2a3a"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent/Icon Color",
      "default": "#0066cc"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Top (Desktop)", "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Bottom (Desktop)", "default": 100
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Top (Mobile)", "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Bottom (Mobile)", "default": 60
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Are your supplements third-party tested?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Yes, every single batch is rigorously tested by independent ISO-certified laboratories to ensure purity, potency, and safety.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP5 Health FAQ",
      "category": "Text",
      "blocks": [
        { "type": "faq" },
        { "type": "faq" },
        { "type": "faq" },
        { "type": "faq" }
      ]
    }
  ]
}
{% endschema %}
