{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#050505'
  assign text_color = section.settings.text_color | default: '#ffffff'
  assign accent_color = section.settings.accent_color | default: '#00ff88'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 120px 20px;
    color: {{ text_color }};
    position: relative;
    overflow: hidden;
  }
  
  /* Tech grid background */
  #shopify-section-{{ section_id }}::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-image: 
      linear-gradient(rgba(0, 255, 136, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 255, 136, 0.05) 1px, transparent 1px);
    background-size: 50px 50px;
    background-position: center center;
    z-index: 1;
    pointer-events: none;
    transform: perspective(500px) rotateX(60deg) translateY(-100px) scale(3);
    opacity: 0.3;
  }
  
  .hp9-brand-container-{{ section_id }} {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    gap: 80px;
    align-items: center;
    position: relative;
    z-index: 2;
  }
  
  .hp9-brand-image-wrap-{{ section_id }} {
    flex: 1;
    position: relative;
    border: 1px solid {{ accent_color }};
    padding: 20px;
  }
  
  /* Corner accents */
  .hp9-brand-image-wrap-{{ section_id }}::before,
  .hp9-brand-image-wrap-{{ section_id }}::after {
    content: '';
    position: absolute;
    width: 30px;
    height: 30px;
    border: 3px solid {{ accent_color }};
    z-index: 3;
  }
  
  .hp9-brand-image-wrap-{{ section_id }}::before {
    top: -3px; left: -3px;
    border-right: none; border-bottom: none;
  }
  
  .hp9-brand-image-wrap-{{ section_id }}::after {
    bottom: -3px; right: -3px;
    border-left: none; border-top: none;
  }
  
  .hp9-brand-image-{{ section_id }} {
    width: 100%;
    height: auto;
    display: block;
    filter: sepia(0.5) hue-rotate(90deg) contrast(1.2);
    transition: filter 0.5s ease;
  }
  
  .hp9-brand-image-wrap-{{ section_id }}:hover .hp9-brand-image-{{ section_id }} {
    filter: sepia(0) hue-rotate(0deg) contrast(1);
  }
  
  .hp9-brand-content-{{ section_id }} {
    flex: 1;
  }
  
  .hp9-brand-subheading-{{ section_id }} {
    font-family: 'Space Mono', monospace;
    font-size: 0.9rem;
    font-weight: 700;
    color: {{ accent_color }};
    margin: 0 0 15px 0;
    letter-spacing: 3px;
    text-transform: uppercase;
    display: inline-block;
    border-left: 3px solid {{ accent_color }};
    padding-left: 15px;
  }
  
  .hp9-brand-heading-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: clamp(2.5rem, 4vw, 4rem);
    font-weight: 900;
    margin: 0 0 30px 0;
    text-transform: uppercase;
    letter-spacing: -1.5px;
    line-height: 1;
    color: #fff;
    text-shadow: 2px 2px 0 rgba(0, 255, 136, 0.3);
  }
  
  .hp9-brand-text-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: 1.1rem;
    line-height: 1.6;
    color: rgba(255,255,255,0.7);
    margin: 0 0 40px 0;
  }
  
  .hp9-brand-text-{{ section_id }} p {
    margin: 0 0 20px 0;
  }
  
  .hp9-brand-btn-{{ section_id }} {
    display: inline-block;
    padding: 15px 40px;
    background: transparent;
    color: {{ accent_color }};
    border: 1px solid {{ accent_color }};
    font-family: 'Space Mono', monospace;
    font-size: 1rem;
    font-weight: 700;
    text-transform: uppercase;
    text-decoration: none;
    letter-spacing: 1px;
    position: relative;
    overflow: hidden;
    transition: all 0.3s ease;
  }
  
  .hp9-brand-btn-{{ section_id }}:hover {
    background: {{ accent_color }};
    color: #000;
    box-shadow: 0 0 30px rgba(0, 255, 136, 0.4);
  }

  /* Scanline effect on button */
  .hp9-brand-btn-{{ section_id }}::after {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: linear-gradient(rgba(255,255,255,0.2) 1px, transparent 1px);
    background-size: 100% 4px;
    transform: rotate(45deg);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s;
  }
  
  .hp9-brand-btn-{{ section_id }}:hover::after {
    opacity: 1;
  }
  
  .hp9-brand-stats-{{ section_id }} {
    display: flex;
    gap: 40px;
    margin-top: 50px;
    padding-top: 30px;
    border-top: 1px dashed rgba(255,255,255,0.1);
  }
  
  .hp9-brand-stat-{{ section_id }} {
    display: flex;
    flex-direction: column;
  }
  
  .hp9-brand-stat-num-{{ section_id }} {
    font-family: 'Space Mono', monospace;
    font-size: 2rem;
    font-weight: 700;
    color: {{ text_color }};
  }
  
  .hp9-brand-stat-label-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: 0.8rem;
    color: rgba(255,255,255,0.5);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-top: 5px;
  }

  @media (max-width: 1024px) {
    .hp9-brand-container-{{ section_id }} {
      flex-direction: column;
      gap: 50px;
    }
    .hp9-brand-image-wrap-{{ section_id }}, .hp9-brand-content-{{ section_id }} {
      width: 100%;
    }
  }
  
  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 80px 20px;
    }
    .hp9-brand-stats-{{ section_id }} {
      flex-wrap: wrap;
      gap: 20px;
    }
  }
</style>

<div class="hp9-brand-container-{{ section_id }}">
  <div class="hp9-brand-image-wrap-{{ section_id }}">
    {% if section.settings.image != blank %}
      <img height="{{ section.settings.image.height }}" width="{{ section.settings.image.width }}" src="{{ section.settings.image | image_url: width: 1000 }}" alt="{{ section.settings.heading | escape }}" class="hp9-brand-image-{{ section_id }}" loading="lazy">
    {% else %}
      <div class="hp9-brand-image-{{ section_id }}" style="background: #222; height: 500px; display:flex; align-items:center; justify-content:center; font-family:monospace; color:#555;">[IMAGE_PLACEHOLDER]</div>
    {% endif %}
  </div>
  
  <div class="hp9-brand-content-{{ section_id }}">
    <div class="hp9-brand-subheading-{{ section_id }}">{{ section.settings.subheading | default: '/// ORIGIN_STORY' }}</div>
    <h2 class="hp9-brand-heading-{{ section_id }}">{{ section.settings.heading | default: 'ENGINEERED FOR TOMORROW' }}</h2>
    
    <div class="hp9-brand-text-{{ section_id }}">
      {% if section.settings.text != blank %}
        {{ section.settings.text }}
      {% else %}
        <p>In the year 2077, boundaries between human and machine blur. We started in a basement server room with a single mission: to enhance human capabilities through accessible cybernetics.</p>
        <p>Today, we lead the industry in neural interfaces, providing uncompromised performance for netrunners and corpo-agents alike. Our hardware doesn't just meet standards; it rewrites them.</p>
      {% endif %}
    </div>
    
    {% if section.settings.button_label != blank %}
      <a href="{{ section.settings.button_link | default: '#' }}" class="hp9-brand-btn-{{ section_id }}">
        {{ section.settings.button_label }}
      </a>
    {% endif %}
    
    <div class="hp9-brand-stats-{{ section_id }}">
      <div class="hp9-brand-stat-{{ section_id }}">
        <span class="hp9-brand-stat-num-{{ section_id }}">99.9%</span>
        <span class="hp9-brand-stat-label-{{ section_id }}">UPTIME_RATING</span>
      </div>
      <div class="hp9-brand-stat-{{ section_id }}">
        <span class="hp9-brand-stat-num-{{ section_id }}">5M+</span>
        <span class="hp9-brand-stat-label-{{ section_id }}">UNITS_DEPLOYED</span>
      </div>
      <div class="hp9-brand-stat-{{ section_id }}">
        <span class="hp9-brand-stat-num-{{ section_id }}">0ms</span>
        <span class="hp9-brand-stat-label-{{ section_id }}">LATENCY_AVG</span>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "HP9 Brand Story",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#050505"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#00ff88"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Brand Image"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "/// ORIGIN_STORY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "ENGINEERED FOR TOMORROW"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text content"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "READ_LOGS"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "HP9 Brand Story"
    }
  ]
}
{% endschema %}
