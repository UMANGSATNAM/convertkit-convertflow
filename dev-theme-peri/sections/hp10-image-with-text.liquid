{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#FFFFFF'
  assign text_color = section.settings.text_color | default: '#2A3B2C'
  assign image_position = section.settings.image_position | default: 'left'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 120px 20px;
    color: {{ text_color }};
  }
  
  .hp10-iwt-container-{{ section_id }} {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 80px;
    flex-direction: {% if image_position == 'right' %}row-reverse{% else %}row{% endif %};
  }
  
  .hp10-iwt-image-wrap-{{ section_id }} {
    flex: 1;
    position: relative;
    border-radius: 40px 40px 0 40px; /* Asymmetric organic shape */
    overflow: hidden;
    padding-top: 100%; /* 1:1 Aspect ratio */
  }
  
  .hp10-iwt-image-{{ section_id }} {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover;
  }
  
  .hp10-iwt-content-{{ section_id }} {
    flex: 1;
    padding: 40px 0;
  }
  
  .hp10-iwt-subheading-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin: 0 0 20px 0;
    color: rgba(42, 59, 44, 0.6);
  }
  
  .hp10-iwt-heading-{{ section_id }} {
    font-family: 'Lora', serif;
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    font-weight: 400;
    margin: 0 0 30px 0;
    line-height: 1.2;
  }
  
  .hp10-iwt-text-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: 1.1rem;
    line-height: 1.6;
    color: rgba(42, 59, 44, 0.8);
    margin: 0 0 40px 0;
  }
  
  .hp10-iwt-btn-{{ section_id }} {
    display: inline-block;
    padding: 16px 40px;
    background: {{ text_color }};
    color: {{ bg_color }};
    border-radius: 40px;
    font-family: 'Inter', sans-serif;
    font-size: 1rem;
    font-weight: 500;
    text-decoration: none;
    letter-spacing: 1px;
    transition: opacity 0.3s ease;
  }
  
  .hp10-iwt-btn-{{ section_id }}:hover {
    opacity: 0.8;
  }

  @media (max-width: 992px) {
    .hp10-iwt-container-{{ section_id }} {
      gap: 50px;
      flex-direction: column;
    }
    .hp10-iwt-image-wrap-{{ section_id }}, .hp10-iwt-content-{{ section_id }} {
      width: 100%;
    }
    .hp10-iwt-image-wrap-{{ section_id }} {
      border-radius: 30px;
    }
  }
</style>

<div class="hp10-iwt-container-{{ section_id }}">
  <div class="hp10-iwt-image-wrap-{{ section_id }}">
    {% if section.settings.image != blank %}
      <img height="{{ section.settings.image.height }}" width="{{ section.settings.image.width }}" src="{{ section.settings.image | image_url: width: 1000 }}" alt="{{ section.settings.heading | escape }}" class="hp10-iwt-image-{{ section_id }}" loading="lazy">
    {% else %}
      <div class="hp10-iwt-image-{{ section_id }}" style="background: #e8e3d5;"></div>
    {% endif %}
  </div>
  
  <div class="hp10-iwt-content-{{ section_id }}">
    <div class="hp10-iwt-subheading-{{ section_id }}">{{ section.settings.subheading | default: 'Pure Ingredients' }}</div>
    <h2 class="hp10-iwt-heading-{{ section_id }}">{{ section.settings.heading | default: 'Rooted in nature, backed by science.' }}</h2>
    <div class="hp10-iwt-text-{{ section_id }}">
      {% if section.settings.text != blank %}
        {{ section.settings.text }}
      {% else %}
        <p>Every ingredient we use is carefully selected from sustainable sources. We believe that what you put on your body should be as pure as what you put in it. Experience the difference of true botanical formulations.</p>
      {% endif %}
    </div>
    {% if section.settings.button_label != blank %}
      <a href="{{ section.settings.button_link | default: '#' }}" class="hp10-iwt-btn-{{ section_id }}">
        {{ section.settings.button_label }}
      </a>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "HP10 Image with Text",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2A3B2C"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Pure Ingredients"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Rooted in nature, backed by science."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Every ingredient we use is carefully selected from sustainable sources. We believe that what you put on your body should be as pure as what you put in it.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Discover Our Process"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "HP10 Image with Text"
    }
  ]
}
{% endschema %}
