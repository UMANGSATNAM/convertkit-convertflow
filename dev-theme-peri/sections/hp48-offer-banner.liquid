{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp48-offer-bg: {{ section.settings.bg_color | default: '#1A1715' }};
    --hp48-gold: {{ section.settings.accent_gold | default: '#C59B27' }};
    
    background: var(--hp48-offer-bg);
    color: #FAF8F5;
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
    text-align: center;
    border-top: 1px solid rgba(197, 155, 39, 0.3);
    border-bottom: 1px solid rgba(197, 155, 39, 0.3);
  }

  .hp48-offer__box {
    max-width: {{ section.settings.container_width | default: 860 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp48-offer__pill {
    display: inline-block;
    padding: 6px 18px;
    background: rgba(197, 155, 39, 0.15);
    border: 1px solid var(--hp48-gold);
    border-radius: 50px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    color: var(--hp48-gold);
    margin-bottom: 20px;
    text-transform: uppercase;
  }

  .hp48-offer__title {
    font-family: 'Cinzel', serif;
    font-size: clamp(32px, 4.5vw, 48px);
    font-weight: 700;
    line-height: 1.15;
    margin: 0 0 16px;
    letter-spacing: 1px;
  }

  .hp48-offer__desc {
    font-size: 15px;
    line-height: 1.8;
    color: #D6CCC2;
    margin: 0 auto 30px;
    max-width: 580px;
  }

  .hp48-offer__code-wrap {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background: rgba(197, 155, 39, 0.1);
    border: 1px dashed var(--hp48-gold);
    padding: 10px 24px;
    border-radius: 4px;
    margin-bottom: 30px;
  }

  .hp48-offer__code {
    font-family: 'Montserrat', sans-serif;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 2px;
    color: var(--hp48-gold);
  }

  .hp48-offer__btn {
    display: inline-flex;
    padding: 16px 36px;
    background: var(--hp48-gold);
    color: #1A1715;
    font-family: 'Montserrat', sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 4px;
    box-shadow: 0 10px 30px rgba(197, 155, 39, 0.3);
    transition: all 0.25s ease;
  }

  .hp48-offer__btn:hover {
    background: #E5C365;
    transform: translateY(-2px);
  }
{%- endstyle -%}

<div class="hp48-offer__box">
  <span class="hp48-offer__pill">{{ section.settings.badge | default: 'IMPERIAL PATRON PRIVILEGE' }}</span>
  <h2 class="hp48-offer__title">{{ section.settings.heading | default: 'RECEIVE 20% PRIVILEGE ON YOUR INITIAL ROYAL ORDER' }}</h2>
  <p class="hp48-offer__desc">
    {{ section.settings.description | default: 'Experience the transformative potency of 24K colloidal gold and white truffle alchemy. Apply code upon acquisition.' }}
  </p>

  <div class="hp48-offer__code-wrap">
    <span class="hp48-offer__code">CODE: {{ section.settings.promo_code | default: 'ROYAL20' }}</span>
  </div>

  <div>
    <a href="{{ section.settings.btn_url | default: '/collections/all' }}" class="hp48-offer__btn">
      {{ section.settings.btn_text | default: 'Claim Sovereign Code &rarr;' }}
    </a>
  </div>
</div>

{% schema %}
{
  "name": "HP48 - Royal Offer",
  "class": "section-hp48-offer",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#1A1715" },
    { "type": "color", "id": "accent_gold", "label": "Gold Accent", "default": "#C59B27" },
    { "type": "text", "id": "badge", "label": "Badge", "default": "IMPERIAL PATRON PRIVILEGE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "RECEIVE 20% PRIVILEGE ON YOUR INITIAL ROYAL ORDER" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Experience the transformative potency of 24K colloidal gold." },
    { "type": "text", "id": "promo_code", "label": "Promo Code", "default": "ROYAL20" },
    { "type": "text", "id": "btn_text", "label": "Button Text", "default": "Claim Sovereign Code →" },
    { "type": "url", "id": "btn_url", "label": "Button URL" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 5, "unit": "px", "label": "Padding Top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 5, "unit": "px", "label": "Padding Bottom", "default": 80 },
    { "type": "range", "id": "container_width", "min": 600, "max": 1200, "step": 20, "unit": "px", "label": "Container Width", "default": 860 }
  ],
  "presets": [
    { "name": "HP48 - Royal Offer" }
  ]
}
{% endschema %}
