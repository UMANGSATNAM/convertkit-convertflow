{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#f7f4ed'
  assign text_color = section.settings.text_color | default: '#2b302a'
  assign accent_color = section.settings.accent_color | default: '#4a6741'
  assign menu = linklists[section.settings.menu]
-%}

<style>
  #shopify-section-{{ section_id }} {
    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
    padding: 15px 0;
    transition: all 0.4s cubic-bezier(0.25, 1, 0.5, 1);
    background: transparent;
  }
  
  /* 
    Pill-shaped floating header aesthetic.
    When scrolled, it gets a solid background and box-shadow.
  */
  .hp7-header-wrapper-{{ section_id }} {
    max-width: 1200px;
    margin: 0 auto;
    background-color: transparent;
    border-radius: 50px;
    padding: 10px 30px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: all 0.4s cubic-bezier(0.25, 1, 0.5, 1);
  }
  
  .hp7-scrolled .hp7-header-wrapper-{{ section_id }} {
    background-color: {{ bg_color | color_modify: 'alpha', 0.95 }};
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    border: 1px solid rgba(43, 48, 42, 0.05);
  }
  
  .hp7-logo-{{ section_id }} a {
    font-family: 'Playfair Display', serif;
    font-size: 1.8rem;
    font-weight: 700;
    color: {{ text_color }};
    text-decoration: none;
    letter-spacing: -0.02em;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  
  .hp7-logo-icon-{{ section_id }} {
    width: 24px;
    height: 24px;
    fill: {{ accent_color }};
  }
  
  .hp7-nav-{{ section_id }} {
    display: flex;
    gap: 35px;
    align-items: center;
  }
  
  .hp7-nav-link-{{ section_id }} {
    font-family: 'DM Sans', sans-serif;
    color: {{ text_color }};
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    position: relative;
    padding: 5px 0;
    transition: color 0.3s ease;
  }
  
  .hp7-nav-link-{{ section_id }}:hover {
    color: {{ accent_color }};
  }
  
  /* Soft organic underline on hover */
  .hp7-nav-link-{{ section_id }}::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 0;
    height: 2px;
    background-color: {{ accent_color }};
    border-radius: 2px;
    transition: width 0.3s cubic-bezier(0.25, 1, 0.5, 1);
  }
  
  .hp7-nav-link-{{ section_id }}:hover::after {
    width: 100%;
  }
  
  .hp7-icons-{{ section_id }} {
    display: flex;
    gap: 20px;
    align-items: center;
  }
  
  .hp7-icon-btn-{{ section_id }} {
    background: none;
    border: none;
    color: {{ text_color }};
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    transition: all 0.3s ease;
  }
  
  .hp7-icon-btn-{{ section_id }}:hover {
    background: rgba(43, 48, 42, 0.05);
    color: {{ accent_color }};
  }
  
  .hp7-icon-btn-{{ section_id }} svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  
  .hp7-cart-count-{{ section_id }} {
    position: absolute;
    top: -2px;
    right: -2px;
    background: {{ accent_color }};
    color: #fff;
    font-size: 0.65rem;
    font-weight: bold;
    width: 16px;
    height: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    font-family: 'DM Sans', sans-serif;
  }
  
  .hp7-hamburger-{{ section_id }} {
    display: none;
    flex-direction: column;
    justify-content: space-around;
    width: 24px;
    height: 20px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
  }
  
  .hp7-hamburger-line-{{ section_id }} {
    width: 24px;
    height: 2px;
    background: {{ text_color }};
    border-radius: 10px;
    transition: all 0.3s linear;
    position: relative;
    transform-origin: 1px;
  }
  
  @media (max-width: 992px) {
    .hp7-nav-{{ section_id }} {
      display: none; /* Mobile menu handled separately */
    }
    .hp7-hamburger-{{ section_id }} {
      display: flex;
    }
    .hp7-header-wrapper-{{ section_id }} {
      border-radius: 0;
      padding: 15px 20px;
    }
    .hp7-scrolled .hp7-header-wrapper-{{ section_id }} {
      border-radius: 0;
    }
    #shopify-section-{{ section_id }} {
      padding: 0;
    }
  }
</style>

<div class="hp7-header-wrapper-{{ section_id }}" id="hp7-header-{{ section_id }}">
  <div class="hp7-logo-{{ section_id }}">
    <a href="/">
      <svg class="hp7-logo-icon-{{ section_id }}" viewBox="0 0 24 24">
        <!-- Abstract leaf shape for eco vibe -->
        <path d="M12,2C12,2 4,6.5 4,13.5C4,17.09 6.91,20 10.5,20C11.55,20 12.54,19.75 13.4,19.3L15.6,21.5L17,20.1L14.7,17.9C15.52,16.71 16,15.17 16,13.5C16,6.5 12,2 12,2ZM10.5,18C8.01,18 6,15.99 6,13.5C6,8.68 10.56,5.1 12,4.04C13.44,5.1 18,8.68 18,13.5C18,15.99 15.99,18 13.5,18C12.44,18 11.45,17.63 10.66,17.02L12,15.68L10.58,14.26L9.25,15.6C8.84,15.02 8.6,14.29 8.6,13.5C8.6,12.45 9.45,11.6 10.5,11.6C11.35,11.6 12.06,12.16 12.33,12.93L14.23,12.31C13.72,10.67 12.24,9.5 10.5,9.5C8.29,9.5 6.5,11.29 6.5,13.5C6.5,14.67 7.02,15.71 7.82,16.43L6.4,17.85C5.54,16.74 5,15.22 5,13.5C5,8.12 10.02,4.08 12,2.83C13.98,4.08 19,8.12 19,13.5C19,15.22 18.46,16.74 17.6,17.85L16.18,16.43C16.98,15.71 17.5,14.67 17.5,13.5C17.5,11.29 15.71,9.5 13.5,9.5C11.76,9.5 10.28,10.67 9.77,12.31L11.67,12.93C11.94,12.16 12.65,11.6 13.5,11.6C14.55,11.6 15.4,12.45 15.4,13.5C15.4,14.29 15.16,15.02 14.75,15.6L13.42,14.26L12,15.68L13.34,17.02C12.55,17.63 11.56,18 10.5,18Z" />
        <path d="M12 2C12 2 4 6.5 4 13.5c0 3.59 2.91 6.5 6.5 6.5 1.05 0 2.04-.25 2.9-.7l2.2 2.2 1.4-1.4-2.3-2.2c.82-1.19 1.3-2.73 1.3-4.4 0-7-4-11.5-4-11.5z" fill="currentColor" />
      </svg>
      {{ shop.name }}
    </a>
  </div>
  
  <nav class="hp7-nav-{{ section_id }}">
    {% if menu.links != blank %}
      {% for link in menu.links %}
        <a href="{{ link.url }}" class="hp7-nav-link-{{ section_id }}">{{ link.title }}</a>
      {% endfor %}
    {% else %}
      <a href="#" class="hp7-nav-link-{{ section_id }}">Shop</a>
      <a href="#" class="hp7-nav-link-{{ section_id }}">Our Story</a>
      <a href="#" class="hp7-nav-link-{{ section_id }}">Materials</a>
      <a href="#" class="hp7-nav-link-{{ section_id }}">Journal</a>
    {% endif %}
  </nav>
  
  <div class="hp7-icons-{{ section_id }}">
    <button class="hp7-icon-btn-{{ section_id }}" aria-label="Search">
      <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
    </button>
    <button class="hp7-icon-btn-{{ section_id }}" aria-label="Account">
      <svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
    </button>
    {% render 'search-bar', compact: true %}
    {% render 'wishlist-icon' %}
    <a href="/cart" data-cart-open class="hp7-icon-btn-{{ section_id }}" aria-label="Cart" style="position:relative;">
      <svg viewBox="0 0 24 24"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
      <span class="hp7-cart-count-{{ section_id }}">{{ cart.item_count | default: 0 }}</span>
    </a>
    
    <button class="hp7-hamburger-{{ section_id }}">
      <div class="hp7-hamburger-line-{{ section_id }}"></div>
      <div class="hp7-hamburger-line-{{ section_id }}"></div>
      <div class="hp7-hamburger-line-{{ section_id }}"></div>
    </button>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const headerWrapper = document.getElementById('shopify-section-{{ section_id }}');
    
    window.addEventListener('scroll', () => {
      if (window.scrollY > 50) {
        headerWrapper.classList.add('hp7-scrolled');
      } else {
        headerWrapper.classList.remove('hp7-scrolled');
      }
    });
  });
</script>

{% schema %}
{
  "name": "HP7 Header",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color (Scrolled)",
      "default": "#f7f4ed"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2b302a"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#4a6741"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu"
    }
  ],
  "presets": [
    {
      "name": "HP7 Header"
    }
  ]
}
{% endschema %}
