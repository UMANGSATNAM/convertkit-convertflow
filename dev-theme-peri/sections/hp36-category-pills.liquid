{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400;1,600&family=Oswald:wght@300;400;500&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --border-color: {{ section.settings.border_color }};
    
    --font-serif: 'Playfair Display', serif;
    --font-sans: 'Oswald', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    border-bottom: 1px solid var(--border-color);
  }

  .hp36-pills-wrapper {
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp36-pills-wrapper {
      padding: 0 20px;
    }
  }

  .hp36-pills__header {
    text-align: center;
    margin-bottom: 50px;
  }

  .hp36-pills__subtitle {
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--text-color);
    text-transform: uppercase;
    letter-spacing: 0.2em;
  }

  .hp36-pills__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 15px;
  }

  .hp36-pill {
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 500;
    color: var(--text-color);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-decoration: none;
    padding: 15px 30px;
    border: 1px solid var(--border-color);
    background: transparent;
    transition: all 0.3s ease;
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  
  .hp36-pill span {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 14px;
    opacity: 0.6;
    margin-left: 5px;
  }

  .hp36-pill:hover {
    background-color: var(--text-color);
    color: var(--bg-color);
  }
  
  .hp36-pill:hover span {
    color: var(--bg-color);
    opacity: 0.8;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp36-pills-wrapper" id="HP36Categories-{{ section.id }}">
  {%- if section.settings.title != blank -%}
    <div class="hp36-pills__header">
      <div class="hp36-pills__subtitle">{{ section.settings.title }}</div>
    </div>
  {%- endif -%}

  <div class="hp36-pills__list">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.link | default: '#' }}" class="hp36-pill" {{ block.shopify_attributes }}>
        {{ block.settings.title }}
        {%- if block.settings.count != blank -%}
          <span>({{ block.settings.count }})</span>
        {%- endif -%}
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "HP36 - Edit Categories",
  "class": "section-hp36-category-pills",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "BROWSE THE DIRECTORY"
    },
    {
      "type": "header",
      "content": "Editorial Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Outerwear"
        },
        {
          "type": "text",
          "id": "count",
          "label": "Item Count (Optional)",
          "default": "24"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP36 - Edit Categories",
      "blocks": [
        { "type": "category", "settings": { "title": "New Arrivals", "count": "12" } },
        { "type": "category", "settings": { "title": "Outerwear", "count": "08" } },
        { "type": "category", "settings": { "title": "Knitwear", "count": "15" } },
        { "type": "category", "settings": { "title": "Tailoring", "count": "06" } },
        { "type": "category", "settings": { "title": "Accessories", "count": "32" } }
      ]
    }
  ]
}
{% endschema %}
