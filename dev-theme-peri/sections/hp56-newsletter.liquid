{%- style -%}
  #shopify-section-{{ section.id }} {
    background: linear-gradient(135deg, #082F49 0%, #0369A1 100%);
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }
  .hp56-news__container { max-width: {{ section.settings.container_width | default: 700 }}px; margin: 0 auto; padding: 0 24px; text-align: center; }
  .hp56-news__eyebrow { font-family: 'Outfit', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: #38BDF8; margin: 0 0 16px; }
  .hp56-news__heading { font-family: 'Syne', sans-serif; font-size: clamp(28px, 4vw, 44px); font-weight: 800; color: #FFFFFF; margin: 0 0 16px; }
  .hp56-news__desc { font-size: 15px; line-height: 1.7; color: #E0F2FE; margin: 0 0 32px; }
  .hp56-news__form { display: flex; gap: 12px; max-width: 480px; margin: 0 auto; }
  .hp56-news__input {
    flex: 1; padding: 15px 22px; background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.25); border-radius: 8px;
    color: #FFFFFF; font-family: 'Outfit', sans-serif; font-size: 14px;
  }
  .hp56-news__input::placeholder { color: rgba(224, 242, 254, 0.6); }
  .hp56-news__btn {
    padding: 15px 32px; background: {{ section.settings.btn_bg | default: '#F59E0B' }};
    color: #082F49; border: none; border-radius: 8px; font-family: 'Outfit', sans-serif;
    font-size: 13px; font-weight: 700; cursor: pointer; transition: all 0.3s ease;
    box-shadow: 0 4px 20px rgba(245, 158, 11, 0.35);
  }
  .hp56-news__btn:hover { box-shadow: 0 8px 30px rgba(245, 158, 11, 0.55); transform: translateY(-2px); }
  @media screen and (max-width: 480px) { .hp56-news__form { flex-direction: column; } }
{%- endstyle -%}
<div class="hp56-news__container">
  {%- if section.settings.eyebrow != blank -%}<p class="hp56-news__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
  <h2 class="hp56-news__heading">{{ section.settings.heading | default: 'Join the Arctic Circle' }}</h2>
  <p class="hp56-news__desc">{{ section.settings.description | default: 'Receive seasonal harvest alerts, sub-zero skin tips, and 20% off your first Scandinavian order.' }}</p>
  {%- form 'customer', id: 'hp56-newsletter' -%}
    <input type="hidden" name="contact[tags]" value="newsletter">
    <div class="hp56-news__form">
      <input type="email" name="contact[email]" class="hp56-news__input" placeholder="{{ section.settings.placeholder | default: 'Your email address' }}" required>
      <button type="submit" class="hp56-news__btn">{{ section.settings.btn_label | default: 'Subscribe' }}</button>
    </div>
  {%- endform -%}
</div>
{% schema %}
{
  "name": "HP56 Newsletter",
  "class": "section-hp56-news",
  "settings": [
    { "type": "color", "id": "btn_bg", "label": "Button BG", "default": "#F59E0B" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "❄️ SUBSCRIBER PRIVILEGE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join the Arctic Circle" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Receive seasonal harvest alerts and sub-zero skin tips." },
    { "type": "text", "id": "placeholder", "label": "Placeholder", "default": "Your email address" },
    { "type": "text", "id": "btn_label", "label": "Button Label", "default": "Subscribe" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 500, "max": 900, "step": 20, "unit": "px", "label": "Container Width", "default": 700 }
  ],
  "presets": [{ "name": "HP56 Newsletter" }]
}
{% endschema %}
