{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400;1,600&family=Oswald:wght@300;400;500&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    
    --font-serif: 'Playfair Display', serif;
    --font-sans: 'Oswald', sans-serif;
    
    background-color: var(--bg-color);
  }

  .hp36-hero {
    display: flex;
    min-height: 100vh;
    border-bottom: 1px solid var(--text-color);
  }

  @media screen and (max-width: 992px) {
    .hp36-hero {
      flex-direction: column;
    }
  }

  .hp36-hero__content {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 100px 80px;
    border-right: 1px solid var(--text-color);
    position: relative;
  }

  @media screen and (max-width: 992px) {
    .hp36-hero__content {
      border-right: none;
      border-bottom: 1px solid var(--text-color);
      padding: 80px 40px;
    }
  }

  @media screen and (max-width: 768px) {
    .hp36-hero__content {
      padding: 60px 20px;
    }
  }

  .hp36-hero__issue {
    position: absolute;
    top: 40px;
    left: 80px;
    font-family: var(--font-sans);
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--text-color);
  }

  @media screen and (max-width: 992px) {
    .hp36-hero__issue {
      left: 40px;
    }
  }
  @media screen and (max-width: 768px) {
    .hp36-hero__issue {
      left: 20px;
      top: 20px;
    }
  }

  .hp36-hero__title {
    font-family: var(--font-serif);
    font-size: clamp(60px, 10vw, {{ section.settings.title_size }}px);
    line-height: 0.9;
    color: var(--text-color);
    margin: 0 0 40px;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .hp36-hero__title em {
    font-style: italic;
    color: var(--accent-color);
    text-transform: lowercase;
  }

  .hp36-hero__text {
    font-family: var(--font-sans);
    font-size: 18px;
    line-height: 1.6;
    color: var(--text-color);
    max-width: 400px;
    margin: 0 0 50px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .hp36-hero__buttons {
    display: flex;
    gap: 20px;
    align-items: center;
  }

  .hp36-hero__btn {
    font-family: var(--font-sans);
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    text-decoration: none;
    padding: 20px 40px;
    border: 1px solid var(--text-color);
    color: var(--bg-color);
    background-color: var(--text-color);
    transition: all 0.3s ease;
  }

  .hp36-hero__btn:hover {
    background-color: transparent;
    color: var(--text-color);
  }

  .hp36-hero__btn--secondary {
    background-color: transparent;
    color: var(--text-color);
  }

  .hp36-hero__btn--secondary:hover {
    background-color: var(--text-color);
    color: var(--bg-color);
  }

  .hp36-hero__image-wrapper {
    flex: 1.2;
    position: relative;
    overflow: hidden;
  }

  .hp36-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%) contrast(1.2); /* High fashion BW feel */
  }

  .hp36-hero__caption {
    position: absolute;
    bottom: 40px;
    right: 40px;
    font-family: var(--font-sans);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--bg-color);
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp36-hero" id="HP36Hero-{{ section.id }}">
  <div class="hp36-hero__content">
    {%- if section.settings.issue != blank -%}
      <div class="hp36-hero__issue">{{ section.settings.issue }}</div>
    {%- endif -%}

    <h1 class="hp36-hero__title">
      {{ section.settings.title | replace: 'Elegance', '<em>Elegance</em>' }}
    </h1>

    {%- if section.settings.text != blank -%}
      <p class="hp36-hero__text">{{ section.settings.text }}</p>
    {%- endif -%}

    <div class="hp36-hero__buttons">
      {%- if section.settings.btn_1_label != blank -%}
        <a href="{{ section.settings.btn_1_link | default: '#' }}" class="hp36-hero__btn">
          {{ section.settings.btn_1_label }}
        </a>
      {%- endif -%}
      {%- if section.settings.btn_2_label != blank -%}
        <a href="{{ section.settings.btn_2_link | default: '#' }}" class="hp36-hero__btn hp36-hero__btn--secondary">
          {{ section.settings.btn_2_label }}
        </a>
      {%- endif -%}
    </div>
  </div>

  <div class="hp36-hero__image-wrapper">
    {%- if section.settings.image != blank -%}
      <img height="{{ section.settings.image.height }}" width="{{ section.settings.image.width }}" src="{{ section.settings.image | image_url: width: 1400 }}" alt="{{ section.settings.title | escape }}" class="hp36-hero__image" loading="eager" fetchpriority="high">
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'hp36-hero__image' }}
    {%- endif -%}
    {%- if section.settings.caption != blank -%}
      <div class="hp36-hero__caption">{{ section.settings.caption }}</div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP36 - Editorial Hero",
  "class": "section-hp36-hero",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "issue",
      "label": "Top Label (e.g., Issue 01)",
      "default": "FW / COLLECTION 24"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Heading",
      "default": "Modern Elegance Redefined."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "An exploration of form, structure, and radical simplicity. Discover the new editorial."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Image Caption",
      "default": "L'EDITION PREMIERE"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "btn_1_label",
      "label": "Primary Button Label",
      "default": "The Collection"
    },
    {
      "type": "url",
      "id": "btn_1_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "btn_2_label",
      "label": "Secondary Button Label",
      "default": "View Editorial"
    },
    {
      "type": "url",
      "id": "btn_2_link",
      "label": "Secondary Button Link"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 60,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Heading Size",
      "default": 120
    },
    {
      "type": "header",
      "content": "Editorial Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#8B0000"
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP36 - Editorial Hero"
    }
  ]
}
{% endschema %}
