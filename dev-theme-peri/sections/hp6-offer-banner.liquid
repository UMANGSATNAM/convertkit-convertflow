{%- liquid
  assign bg_color = section.settings.bg_color | default: '#ff4500'
  assign text_color = section.settings.text_color | default: '#ffffff'
  
  assign padding_top_desktop = section.settings.padding_top_desktop
  assign padding_bottom_desktop = section.settings.padding_bottom_desktop
  assign padding_top_mobile = section.settings.padding_top_mobile
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile
-%}

<style>
  #shopify-section-{{ section.id }} {
    --hp6-ob-bg: {{ bg_color }};
    --hp6-ob-text: {{ text_color }};
    
    --hp6-ob-pt-desk: {{ padding_top_desktop }}px;
    --hp6-ob-pb-desk: {{ padding_bottom_desktop }}px;
    --hp6-ob-pt-mob: {{ padding_top_mobile }}px;
    --hp6-ob-pb-mob: {{ padding_bottom_mobile }}px;
  }

  .hp6-sports-ob-{{ section.id }} {
    padding-top: var(--hp6-ob-pt-desk);
    padding-bottom: var(--hp6-ob-pb-desk);
    background-color: var(--hp6-ob-bg);
  }

  .hp6-ob-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .hp6-ob-wrapper {
    position: relative;
    background: #000;
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    align-items: stretch;
    min-height: 400px;
    clip-path: polygon(0 0, 100% 0, 100% 90%, 95% 100%, 0 100%);
  }

  .hp6-ob-media {
    flex: 1;
    position: relative;
  }
  .hp6-ob-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.8;
  }
  .hp6-ob-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent 0%, #000 100%);
  }
  .hp6-ob-wrapper.layout-right .hp6-ob-media::after {
    background: linear-gradient(-90deg, transparent 0%, #000 100%);
  }

  .hp6-ob-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 60px;
    color: var(--hp6-ob-text);
    z-index: 2;
  }

  .hp6-ob-badge {
    display: inline-block;
    background: var(--hp6-ob-bg);
    color: #fff;
    padding: 6px 12px;
    font-family: 'Oswald', sans-serif;
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 20px;
    align-self: flex-start;
  }

  .hp6-ob-title {
    font-family: 'Oswald', sans-serif;
    font-size: clamp(36px, 5vw, 64px);
    font-weight: 700;
    text-transform: uppercase;
    line-height: 1;
    margin: 0 0 20px 0;
  }

  .hp6-ob-desc {
    font-family: 'Inter', sans-serif;
    font-size: 18px;
    line-height: 1.6;
    color: rgba(255,255,255,0.7);
    margin: 0 0 40px 0;
    max-width: 500px;
  }

  .hp6-ob-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--hp6-ob-bg);
    color: #fff;
    padding: 15px 40px;
    font-family: 'Oswald', sans-serif;
    font-size: 16px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    text-decoration: none;
    align-self: flex-start;
    clip-path: polygon(10% 0, 100% 0, 90% 100%, 0% 100%);
    transition: transform 0.3s ease;
  }
  .hp6-ob-btn:hover {
    transform: skewX(-5deg) scale(1.05);
  }

  .hp6-ob-wrapper.layout-right {
    flex-direction: row-reverse;
  }
  .hp6-ob-wrapper.layout-right .hp6-ob-content {
    align-items: flex-end;
    text-align: right;
  }
  .hp6-ob-wrapper.layout-right .hp6-ob-badge,
  .hp6-ob-wrapper.layout-right .hp6-ob-btn {
    align-self: flex-end;
  }

  /* Timer */
  .hp6-ob-timer {
    display: flex;
    gap: 15px;
    margin-bottom: 30px;
  }
  .hp6-ob-time {
    display: flex;
    flex-direction: column;
    align-items: center;
    background: rgba(255,255,255,0.1);
    padding: 10px 15px;
    border-radius: 4px;
    min-width: 70px;
  }
  .hp6-ob-num { font-family: 'Oswald', sans-serif; font-size: 28px; font-weight: 700; line-height: 1; }
  .hp6-ob-label { font-family: 'Inter', sans-serif; font-size: 10px; text-transform: uppercase; letter-spacing: 1px; margin-top: 5px; opacity: 0.7; }

  @media screen and (max-width: 900px) {
    .hp6-ob-wrapper, .hp6-ob-wrapper.layout-right {
      flex-direction: column;
    }
    .hp6-ob-media::after, .hp6-ob-wrapper.layout-right .hp6-ob-media::after {
      background: linear-gradient(to top, #000 0%, transparent 100%);
    }
    .hp6-ob-content {
      padding: 40px;
      align-items: center !important;
      text-align: center !important;
    }
    .hp6-ob-badge, .hp6-ob-btn { align-self: center !important; }
    .hp6-ob-desc { margin-left: auto; margin-right: auto; }
  }

  @media screen and (max-width: 768px) {
    .hp6-sports-ob-{{ section.id }} {
      padding-top: var(--hp6-ob-pt-mob);
      padding-bottom: var(--hp6-ob-pb-mob);
    }
    .hp6-ob-inner { padding: 0 20px; }
    .hp6-ob-content { padding: 30px 20px; }
    .hp6-ob-timer { justify-content: center; }
  }
</style>

<section class="hp6-sports-ob-{{ section.id }}" aria-label="Offer Banner">
  <div class="hp6-ob-inner">
    
    <div class="hp6-ob-wrapper layout-{{ section.settings.layout }}">
      <div class="hp6-ob-media">
        {%- if section.settings.image != blank -%}
          <img height="{{ section.settings.image.height }}" width="{{ section.settings.image.width }}" src="{{ section.settings.image | image_url: width: 1000 }}" class="hp6-ob-img" loading="lazy" alt="Offer Image">
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'hp6-ob-img placeholder-svg' }}
        {%- endif -%}
      </div>
      
      <div class="hp6-ob-content">
        {%- if section.settings.badge != blank -%}
          <span class="hp6-ob-badge">{{ section.settings.badge }}</span>
        {%- endif -%}
        
        <h2 class="hp6-ob-title">{{ section.settings.title }}</h2>
        
        {%- if section.settings.show_timer -%}
          <div class="hp6-ob-timer" data-date="{{ section.settings.target_date }}">
            <div class="hp6-ob-time"><span class="hp6-ob-num" id="d-{{ section.id }}">00</span><span class="hp6-ob-label">Days</span></div>
            <div class="hp6-ob-time"><span class="hp6-ob-num" id="h-{{ section.id }}">00</span><span class="hp6-ob-label">Hours</span></div>
            <div class="hp6-ob-time"><span class="hp6-ob-num" id="m-{{ section.id }}">00</span><span class="hp6-ob-label">Mins</span></div>
            <div class="hp6-ob-time"><span class="hp6-ob-num" id="s-{{ section.id }}">00</span><span class="hp6-ob-label">Secs</span></div>
          </div>
        {%- endif -%}

        <p class="hp6-ob-desc">{{ section.settings.text }}</p>
        
        {%- if section.settings.btn_text != blank -%}
          <a href="{{ section.settings.btn_link }}" class="hp6-ob-btn">{{ section.settings.btn_text }}</a>
        {%- endif -%}
      </div>
    </div>

  </div>
</section>

{%- if section.settings.show_timer -%}
<script>
  document.addEventListener('DOMContentLoaded', function() {
    const timerEl = document.querySelector('.hp6-sports-ob-{{ section.id }} .hp6-ob-timer');
    if(!timerEl) return;
    const targetDate = new Date(timerEl.getAttribute('data-date')).getTime();
    if(isNaN(targetDate)) return;

    const id = '{{ section.id }}';
    const dEl = document.getElementById('d-' + id);
    const hEl = document.getElementById('h-' + id);
    const mEl = document.getElementById('m-' + id);
    const sEl = document.getElementById('s-' + id);

    setInterval(() => {
      const now = new Date().getTime();
      const distance = targetDate - now;
      if (distance < 0) return;
      
      const d = Math.floor(distance / (1000 * 60 * 60 * 24));
      const h = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const m = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
      const s = Math.floor((distance % (1000 * 60)) / 1000);

      dEl.innerText = d < 10 ? '0' + d : d;
      hEl.innerText = h < 10 ? '0' + h : h;
      mEl.innerText = m < 10 ? '0' + m : m;
      sEl.innerText = s < 10 ? '0' + s : s;
    }, 1000);
  });
</script>
{%- endif -%}

{% schema %}
{
  "name": "HP6 Sports Offer Banner",
  "tag": "section",
  "class": "section-hp6-offer-banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Content Layout",
      "options": [
        { "value": "left", "label": "Image Left, Content Right" },
        { "value": "right", "label": "Content Left, Image Right" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge Text",
      "default": "LIMITED TIME"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "MID-SEASON SALE"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "Get up to 40% off on all performance gear. Equip yourself for the upcoming challenges."
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "CLAIM OFFER"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Countdown Timer"
    },
    {
      "type": "checkbox",
      "id": "show_timer",
      "label": "Show Countdown Timer",
      "default": true
    },
    {
      "type": "text",
      "id": "target_date",
      "label": "Target Date",
      "info": "Format: YYYY-MM-DD",
      "default": "2026-12-31"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background / Accent Color",
      "default": "#ff4500"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Top (Desktop)", "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Bottom (Desktop)", "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Top (Mobile)", "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Bottom (Mobile)", "default": 50
    }
  ],
  "presets": [
    {
      "name": "HP6 Sports Offer Banner",
      "category": "Promotional"
    }
  ]
}
{% endschema %}
