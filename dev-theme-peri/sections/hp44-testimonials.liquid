{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp44-test-bg: {{ section.settings.bg_color | default: '#EDF4EE' }};
    --hp44-test-card: {{ section.settings.card_bg | default: '#FFFFFF' }};
    --hp44-test-border: {{ section.settings.card_border | default: '#D8E8DC' }};
    --hp44-test-title: {{ section.settings.title_color | default: '#143D2B' }};
    --hp44-test-accent: {{ section.settings.accent_color | default: '#2D6A4F' }};
    
    background-color: var(--hp44-test-bg);
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
  }

  .hp44-test__wrapper {
    max-width: {{ section.settings.container_width | default: 1240 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp44-test__title-block {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 50px;
  }

  .hp44-test__subhead {
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--hp44-test-accent);
    margin: 0 0 8px;
  }

  .hp44-test__heading {
    font-family: 'Playfair Display', serif;
    font-size: clamp(28px, 4vw, 42px);
    font-weight: 700;
    color: var(--hp44-test-title);
    margin: 0;
  }

  .hp44-test__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: 3 }}, 1fr);
    gap: 24px;
  }

  .hp44-test__card {
    background: var(--hp44-test-card);
    border: 1px solid var(--hp44-test-border);
    border-radius: 24px;
    padding: 36px 28px;
    box-shadow: 0 10px 30px rgba(20, 61, 43, 0.04);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .hp44-test__stars {
    color: #2D6A4F;
    font-size: 18px;
    margin-bottom: 16px;
    letter-spacing: 2px;
  }

  .hp44-test__quote {
    font-size: 15px;
    line-height: 1.7;
    color: #143D2B;
    margin: 0 0 24px;
    font-style: italic;
  }

  .hp44-test__author-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 18px;
    border-top: 1px solid #EDF4EE;
  }

  .hp44-test__author {
    font-family: 'Outfit', sans-serif;
    font-size: 14px;
    font-weight: 700;
    color: var(--hp44-test-title);
  }

  .hp44-test__location {
    font-size: 12px;
    color: #52796F;
  }

  .hp44-test__verified {
    font-size: 11px;
    font-weight: 700;
    color: #2D6A4F;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  @media screen and (max-width: 992px) {
    .hp44-test__grid {
      grid-template-columns: 1fr;
      max-width: 500px;
      margin: 0 auto;
    }
  }
{%- endstyle -%}

<div class="hp44-test__wrapper">
  <div class="hp44-test__title-block">
    {%- if section.settings.subheading != blank -%}
      <p class="hp44-test__subhead">{{ section.settings.subheading }}</p>
    {%- endif -%}
    <h2 class="hp44-test__heading">{{ section.settings.heading | default: 'Words from Our Botanical Patrons' }}</h2>
  </div>

  <div class="hp44-test__grid">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <div class="hp44-test__card" {{ block.shopify_attributes }}>
          <div>
            <div class="hp44-test__stars">★★★★★</div>
            <p class="hp44-test__quote">"{{ block.settings.quote }}"</p>
          </div>
          <div class="hp44-test__author-row">
            <div>
              <div class="hp44-test__author">{{ block.settings.author }}</div>
              <div class="hp44-test__location">{{ block.settings.location }}</div>
            </div>
            <span class="hp44-test__verified">✓ Verified Buyer</span>
          </div>
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="hp44-test__card">
        <div>
          <div class="hp44-test__stars">★★★★★</div>
          <p class="hp44-test__quote">"The Clary Sage Botanical Elixir completely restored my compromised skin barrier after winter flaking. My holy grail."</p>
        </div>
        <div class="hp44-test__author-row">
          <div>
            <div class="hp44-test__author">Astrid Lindqvist</div>
            <div class="hp44-test__location">Stockholm, Sweden</div>
          </div>
          <span class="hp44-test__verified">✓ Verified</span>
        </div>
      </div>
      <div class="hp44-test__card">
        <div>
          <div class="hp44-test__stars">★★★★★</div>
          <p class="hp44-test__quote">"Sage & Calendula velvet cream is lightweight yet deeply nourishing. My redness disappeared in just 5 days."</p>
        </div>
        <div class="hp44-test__author-row">
          <div>
            <div class="hp44-test__author">Freja Møller</div>
            <div class="hp44-test__location">Copenhagen, Denmark</div>
          </div>
          <span class="hp44-test__verified">✓ Verified</span>
        </div>
      </div>
      <div class="hp44-test__card">
        <div>
          <div class="hp44-test__stars">★★★★★</div>
          <p class="hp44-test__quote">"Superb 2-day air courier shipping with all duties included. The recyclable glass packaging is breathtaking."</p>
        </div>
        <div class="hp44-test__author-row">
          <div>
            <div class="hp44-test__author">Elena Vance</div>
            <div class="hp44-test__location">Oslo, Norway</div>
          </div>
          <span class="hp44-test__verified">✓ Verified</span>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP44 - Sage Reviews",
  "class": "section-hp44-reviews",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#EDF4EE" },
    { "type": "color", "id": "card_bg", "label": "Card Background", "default": "#FFFFFF" },
    { "type": "color", "id": "card_border", "label": "Card Border", "default": "#D8E8DC" },
    { "type": "color", "id": "title_color", "label": "Title Color", "default": "#143D2B" },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#2D6A4F" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Verified Patron Feedback" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Words from Our Botanical Patrons" },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "label": "Desktop Columns", "default": 3 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 80 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1240 }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Testimonial Card",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Review Quote", "default": "The Clary Sage Botanical Elixir completely restored my skin barrier." },
        { "type": "text", "id": "author", "label": "Author Name", "default": "Astrid Lindqvist" },
        { "type": "text", "id": "location", "label": "Location", "default": "Stockholm, Sweden" }
      ]
    }
  ],
  "presets": [
    { "name": "HP44 - Sage Reviews" }
  ]
}
{% endschema %}
