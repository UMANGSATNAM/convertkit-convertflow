{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#ffe8d6'
  assign text_color = section.settings.text_color | default: '#6b705c'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 100px 40px;
  }
  
  .hp14-faq-container-{{ section_id }} {
    max-width: 800px;
    margin: 0 auto;
  }
  
  .hp14-faq-heading-{{ section_id }} {
    font-family: 'Georgia', serif;
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    font-weight: normal;
    text-align: center;
    margin: 0 0 50px 0;
    color: {{ text_color }};
  }
  
  .hp14-faq-heading-{{ section_id }} span {
    font-style: italic;
    color: #cb997e;
  }
  
  .hp14-faq-list-{{ section_id }} {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  
  .hp14-faq-item-{{ section_id }} {
    border-bottom: 1px solid rgba(107, 112, 92, 0.2);
    padding-bottom: 10px;
  }
  
  .hp14-faq-question-{{ section_id }} {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15px 0;
    background: transparent;
    border: none;
    color: {{ text_color }};
    font-family: 'Georgia', serif;
    font-size: 1.2rem;
    cursor: pointer;
    text-align: left;
    outline: none;
  }
  
  .hp14-faq-question-{{ section_id }}:hover {
    color: #cb997e;
  }
  
  .hp14-faq-icon-{{ section_id }} {
    color: #cb997e;
    font-size: 1.5rem;
    font-weight: 300;
    transition: transform 0.3s ease;
  }
  
  .hp14-faq-item-{{ section_id }}.is-active .hp14-faq-icon-{{ section_id }} {
    transform: rotate(45deg);
  }
  
  .hp14-faq-answer-{{ section_id }} {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease, padding 0.3s ease;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 1rem;
    line-height: 1.6;
    color: #8a8d7a;
    padding: 0;
  }
  
  .hp14-faq-item-{{ section_id }}.is-active .hp14-faq-answer-{{ section_id }} {
    max-height: 500px;
    padding: 0 0 20px 0;
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 60px 20px;
    }
  }
</style>

<div class="hp14-faq-container-{{ section_id }}">
  <h2 class="hp14-faq-heading-{{ section_id }}">Common <span>Inquiries</span></h2>
  
  <div class="hp14-faq-list-{{ section_id }}">
    {% for block in section.blocks %}
      <div class="hp14-faq-item-{{ section_id }}" {{ block.shopify_attributes }}>
        <button class="hp14-faq-question-{{ section_id }}" onclick="this.parentElement.classList.toggle('is-active')">
          {{ block.settings.question | default: 'Are your products vegan?' }}
          <span class="hp14-faq-icon-{{ section_id }}">+</span>
        </button>
        <div class="hp14-faq-answer-{{ section_id }}">
          {{ block.settings.answer | default: 'Yes, all of our products are 100% vegan and cruelty-free.' }}
        </div>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "HP14 FAQ",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffe8d6"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#6b705c"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Are your products vegan?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "Yes, all of our products are 100% vegan and cruelty-free."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP14 FAQ",
      "blocks": [
        { "type": "faq", "settings": { "question": "Are your products vegan?", "answer": "Yes, all of our products are 100% vegan and cruelty-free." } },
        { "type": "faq", "settings": { "question": "What is the shelf life?", "answer": "Our products have a shelf life of 12 months after opening." } },
        { "type": "faq", "settings": { "question": "Do you ship internationally?", "answer": "We currently ship to select countries worldwide." } }
      ]
    }
  ]
}
{% endschema %}
