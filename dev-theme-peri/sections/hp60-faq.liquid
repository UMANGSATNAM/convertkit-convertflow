{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#FEFCE8' }};
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }
  .hp60-faq__container { max-width: {{ section.settings.container_width | default: 800 }}px; margin: 0 auto; padding: 0 24px; }
  .hp60-faq__header { text-align: center; margin-bottom: 50px; }
  .hp60-faq__eyebrow { font-family: 'Outfit', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: {{ section.settings.accent_color | default: '#3F6212' }}; margin: 0 0 12px; }
  .hp60-faq__heading { font-family: 'Bodoni Moda', serif; font-size: clamp(28px, 3.5vw, 42px); font-weight: 700; color: #1E293B; margin: 0; }
  .hp60-faq__item {
    background: {{ section.settings.card_bg | default: '#FFFFFF' }};
    border: 1px solid rgba(63, 98, 18, 0.2);
    border-radius: 6px; margin-bottom: 14px; overflow: hidden;
    box-shadow: 0 2px 10px rgba(63, 98, 18, 0.05);
    transition: border-color 0.3s ease;
  }
  .hp60-faq__item.active { border-color: #3F6212; }
  .hp60-faq__question {
    width: 100%; background: none; border: none; padding: 20px 24px;
    display: flex; justify-content: space-between; align-items: center; cursor: pointer;
    font-family: 'Bodoni Moda', serif; font-size: 18px; font-weight: 700; color: #1E293B; text-align: left;
  }
  .hp60-faq__icon { font-size: 20px; color: {{ section.settings.accent_color | default: '#3F6212' }}; transition: transform 0.3s ease; flex-shrink: 0; margin-left: 16px; }
  .hp60-faq__item.active .hp60-faq__icon { transform: rotate(45deg); }
  .hp60-faq__answer { max-height: 0; overflow: hidden; transition: max-height 0.35s ease; }
  .hp60-faq__item.active .hp60-faq__answer { max-height: 300px; }
  .hp60-faq__answer-inner { padding: 0 24px 20px; font-size: 14px; line-height: 1.7; color: #475569; }
{%- endstyle -%}
<div class="hp60-faq__container">
  <div class="hp60-faq__header">
    {%- if section.settings.eyebrow != blank -%}<p class="hp60-faq__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="hp60-faq__heading">{{ section.settings.heading | default: 'Estate Inquiries' }}</h2>
  </div>
  {%- for block in section.blocks -%}
    <div class="hp60-faq__item" {{ block.shopify_attributes }}>
      <button class="hp60-faq__question" onclick="this.parentElement.classList.toggle('active')">
        <span>{{ block.settings.question | default: 'Why is cold-milled olive leaf so powerful?' }}</span>
        <span class="hp60-faq__icon">+</span>
      </button>
      <div class="hp60-faq__answer">
        <div class="hp60-faq__answer-inner">{{ block.settings.answer | default: 'Olive leaves contain up to 400% more oleuropein polyphenols than standard olive oil, defending the cellular matrix against environmental stressors.' }}</div>
      </div>
    </div>
  {%- endfor -%}
</div>
{% schema %}
{
  "name": "HP60 FAQ",
  "class": "section-hp60-faq",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FEFCE8" },
    { "type": "color", "id": "card_bg", "label": "Card Background", "default": "#FFFFFF" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#3F6212" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "🏛️ FAQ" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Estate Inquiries" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 600, "max": 1000, "step": 20, "unit": "px", "label": "Container Width", "default": 800 }
  ],
  "blocks": [{
    "type": "faq", "name": "Question",
    "settings": [
      { "type": "text", "id": "question", "label": "Question", "default": "Why is cold-milled olive leaf so powerful?" },
      { "type": "textarea", "id": "answer", "label": "Answer", "default": "Olive leaves contain up to 400% more oleuropein polyphenols than standard olive oil." }
    ]
  }],
  "presets": [{
    "name": "HP60 FAQ",
    "blocks": [
      { "type": "faq" },
      { "type": "faq", "settings": { "question": "Is Calabrian Bergamot photosensitizing?", "answer": "We utilize cold-distilled, bergapten-free bergamot essence that is 100% safe for full daytime sun exposure." } },
      { "type": "faq", "settings": { "question": "Are the ingredients organically grown?", "answer": "Yes, our certified organic Tuscan estate adheres to biodynamic regenerative farming standards." } }
    ]
  }]
}
{% endschema %}
