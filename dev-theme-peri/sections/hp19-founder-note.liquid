{%- style -%}
  #shopify-section-{{ section.id }} {
    --padding-top: {{ section.settings.padding_top }}px;
    --padding-bottom: {{ section.settings.padding_bottom }}px;
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
    background-color: var(--bg-color);
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      --padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      --padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }

  .hp19-founder-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    align-items: center;
    gap: {{ section.settings.gap }}px;
    flex-direction: {% if section.settings.layout == 'image_right' %}row-reverse{% else %}row{% endif %};
  }

  @media screen and (max-width: 992px) {
    .hp19-founder-wrapper {
      flex-direction: column;
      gap: 40px;
    }
  }

  .hp19-founder__image-block {
    flex: 1;
    position: relative;
    width: 100%;
  }

  .hp19-founder__image-container {
    position: relative;
    border-radius: {{ section.settings.image_radius }}px;
    overflow: hidden;
    aspect-ratio: {{ section.settings.aspect_ratio }};
    box-shadow: 0 20px 40px rgba(0,0,0,0.1);
  }

  .hp19-founder__image-container img {
    width: 100%; height: 100%;
    object-fit: cover;
  }

  {% if section.settings.show_badge %}
  .hp19-founder__badge {
    position: absolute;
    bottom: -20px;
    right: -20px;
    width: 120px; height: 120px;
    background: var(--accent-color);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--bg-color);
    font-family: 'Inter', sans-serif;
    font-weight: 700;
    font-size: 14px;
    text-transform: uppercase;
    text-align: center;
    line-height: 1.2;
    z-index: 2;
    animation: rotateText 20s linear infinite;
  }
  
  @keyframes rotateText {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }
  {% endif %}

  .hp19-founder__content-block {
    flex: 1.2;
    padding: {{ section.settings.content_padding }}px;
    background: {{ section.settings.content_bg }};
    border-radius: {{ section.settings.content_radius }}px;
  }
  
  @media screen and (max-width: 768px) {
    .hp19-founder__content-block {
      padding: 0;
      background: transparent;
    }
  }

  .hp19-founder__title {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--accent-color);
    font-weight: 600;
    margin: 0 0 24px;
  }

  .hp19-founder__text {
    font-family: 'Baskerville', 'Georgia', serif;
    font-size: clamp(20px, 3vw, {{ section.settings.text_size }}px);
    line-height: 1.6;
    color: var(--text-color);
    margin: 0 0 32px;
  }

  .hp19-founder__author {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .hp19-founder__signature {
    font-family: 'Brush Script MT', cursive;
    font-size: 40px;
    color: var(--text-color);
    line-height: 1;
  }

  .hp19-founder__author-meta {
    border-left: 2px solid var(--accent-color);
    padding-left: 16px;
  }
  
  .hp19-founder__name {
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    font-weight: 700;
    color: var(--text-color);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin: 0 0 4px;
  }
  
  .hp19-founder__role {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    color: var(--text-color);
    opacity: 0.7;
    margin: 0;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp19-founder-wrapper" id="HP19Founder-{{ section.id }}">
  <div class="hp19-founder__image-block">
    <div class="hp19-founder__image-container">
      {%- if section.settings.image != blank -%}
        <img height="{{ section.settings.image.height }}" width="{{ section.settings.image.width }}" src="{{ section.settings.image | image_url: width: 800 }}" alt="Founder Image" loading="lazy">
      {%- else -%}
        {{ 'portrait-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>
    
    {%- if section.settings.show_badge -%}
    <div class="hp19-founder__badge">
      Est.<br>2024
    </div>
    {%- endif -%}
  </div>
  
  <div class="hp19-founder__content-block">
    {%- if section.settings.title != blank -%}
      <div class="hp19-founder__title">{{ section.settings.title | escape }}</div>
    {%- endif -%}
    
    {%- if section.settings.text != blank -%}
      <div class="hp19-founder__text">{{ section.settings.text }}</div>
    {%- endif -%}
    
    <div class="hp19-founder__author">
      {%- if section.settings.signature != blank -%}
        <div class="hp19-founder__signature">{{ section.settings.signature | escape }}</div>
      {%- endif -%}
      
      <div class="hp19-founder__author-meta">
        <div class="hp19-founder__name">{{ section.settings.author | escape }}</div>
        <div class="hp19-founder__role">{{ section.settings.role | escape }}</div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "HP19 - Founder Note Pro",
  "class": "section-hp19-founder-note",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Image Placement",
      "options": [
        { "value": "image_left", "label": "Image on Left" },
        { "value": "image_right", "label": "Image on Right" }
      ],
      "default": "image_left"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 800,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1100
    },
    {
      "type": "range",
      "id": "gap",
      "min": 20,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Desktop Gap",
      "default": 80
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Image Aspect Ratio",
      "options": [
        { "value": "1/1", "label": "Square (1:1)" },
        { "value": "3/4", "label": "Portrait (3:4)" },
        { "value": "4/5", "label": "Portrait (4:5)" }
      ],
      "default": "3/4"
    },
    {
      "type": "range",
      "id": "image_radius",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Image Border Radius",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show Decorative Badge",
      "default": true
    },
    {
      "type": "header",
      "content": "Content Block"
    },
    {
      "type": "color",
      "id": "content_bg",
      "label": "Content Box Background (Desktop)",
      "default": "transparent"
    },
    {
      "type": "range",
      "id": "content_padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Content Box Padding (Desktop)",
      "default": 0
    },
    {
      "type": "range",
      "id": "content_radius",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Content Box Radius",
      "default": 0
    },
    {
      "type": "text",
      "id": "title",
      "label": "Tagline",
      "default": "From Our Founder"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Message",
      "default": "<p>I started this journey to bring honest, beautifully crafted products to your home. Every detail is considered, every ingredient purposefully chosen.</p>"
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 16,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Message Font Size",
      "default": 28
    },
    {
      "type": "header",
      "content": "Author Info"
    },
    {
      "type": "text",
      "id": "signature",
      "label": "Signature Text",
      "default": "J. Doe"
    },
    {
      "type": "text",
      "id": "author",
      "label": "Author Name",
      "default": "Jane Doe"
    },
    {
      "type": "text",
      "id": "role",
      "label": "Role",
      "default": "Founder & CEO"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#FFFBEB"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#451A03"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#D97706"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 120
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP19 - Founder Note Pro",
      "category": "Text"
    }
  ]
}
{% endschema %}
