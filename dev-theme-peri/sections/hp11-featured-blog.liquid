{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#FFFFFF'
  assign text_color = section.settings.text_color | default: '#000000'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 100px 20px;
    color: {{ text_color }};
    border-bottom: 3px solid #000;
  }
  
  .hp11-blog-container-{{ section_id }} {
    max-width: 1400px;
    margin: 0 auto;
  }
  
  .hp11-blog-header-{{ section_id }} {
    margin-bottom: 60px;
  }
  
  .hp11-blog-heading-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: clamp(3rem, 6vw, 5rem);
    font-weight: 900;
    text-transform: uppercase;
    margin: 0;
    line-height: 1;
    letter-spacing: -2px;
  }
  
  .hp11-blog-grid-{{ section_id }} {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 40px;
  }
  
  .hp11-blog-card-{{ section_id }} {
    display: flex;
    flex-direction: column;
    border: 4px solid #000;
    background: #FFF;
    box-shadow: 8px 8px 0 #000;
    text-decoration: none;
    color: #000;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  
  .hp11-blog-card-{{ section_id }}:hover {
    transform: translate(-4px, -4px);
    box-shadow: 12px 12px 0 #000;
  }
  
  .hp11-blog-image-wrap-{{ section_id }} {
    position: relative;
    padding-top: 60%;
    border-bottom: 4px solid #000;
    background: #000;
    overflow: hidden;
  }
  
  .hp11-blog-image-{{ section_id }} {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover;
    filter: grayscale(100%);
    transition: filter 0.3s ease;
  }
  
  .hp11-blog-card-{{ section_id }}:hover .hp11-blog-image-{{ section_id }} {
    filter: grayscale(0%);
  }
  
  .hp11-blog-info-{{ section_id }} {
    padding: 30px;
    background: #FFF;
  }
  
  .hp11-blog-title-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: 1.8rem;
    font-weight: 900;
    text-transform: uppercase;
    margin: 0 0 15px 0;
    line-height: 1.1;
  }
  
  .hp11-blog-excerpt-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.5;
    margin: 0 0 20px 0;
  }
  
  .hp11-blog-read-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: 1rem;
    font-weight: 900;
    text-transform: uppercase;
    color: #FF00FF;
    border-bottom: 2px solid #FF00FF;
    display: inline-block;
  }

  @media (max-width: 992px) {
    .hp11-blog-grid-{{ section_id }} {
      grid-template-columns: 1fr;
    }
  }
</style>

<div class="hp11-blog-container-{{ section_id }}">
  <div class="hp11-blog-header-{{ section_id }}">
    <h2 class="hp11-blog-heading-{{ section_id }}">{{ section.settings.heading | default: 'EDITORIAL' }}</h2>
  </div>
  
  <div class="hp11-blog-grid-{{ section_id }}">
    {% assign blog = blogs[section.settings.blog] %}
    {% if blog != blank and blog.articles.size > 0 %}
      {% for article in blog.articles limit: 2 %}
        <a href="{{ article.url }}" class="hp11-blog-card-{{ section_id }}">
          <div class="hp11-blog-image-wrap-{{ section_id }}">
            {% if article.image %}
              <img height="{{ article.image.height }}" width="{{ article.image.width }}" src="{{ article.image | image_url: width: 800 }}" class="hp11-blog-image-{{ section_id }}" alt="{{ article.title }}">
            {% else %}
              <div class="hp11-blog-image-{{ section_id }}" style="background: #333;"></div>
            {% endif %}
          </div>
          <div class="hp11-blog-info-{{ section_id }}">
            <h3 class="hp11-blog-title-{{ section_id }}">{{ article.title }}</h3>
            <div class="hp11-blog-excerpt-{{ section_id }}">
              {{ article.excerpt_or_content | strip_html | truncate: 120 }}
            </div>
            <span class="hp11-blog-read-{{ section_id }}">READ MORE</span>
          </div>
        </a>
      {% endfor %}
    {% else %}
      {% for i in (1..2) %}
        <a href="#" class="hp11-blog-card-{{ section_id }}">
          <div class="hp11-blog-image-wrap-{{ section_id }}">
            <div class="hp11-blog-image-{{ section_id }}" style="background: #CCC;"></div>
          </div>
          <div class="hp11-blog-info-{{ section_id }}">
            <h3 class="hp11-blog-title-{{ section_id }}">THE DESIGN PROCESS</h3>
            <div class="hp11-blog-excerpt-{{ section_id }}">
              A look inside how we build our heavy garments from scratch.
            </div>
            <span class="hp11-blog-read-{{ section_id }}">READ MORE</span>
          </div>
        </a>
      {% endfor %}
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "HP11 Featured Blog",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "EDITORIAL"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    }
  ],
  "presets": [
    {
      "name": "HP11 Featured Blog"
    }
  ]
}
{% endschema %}
