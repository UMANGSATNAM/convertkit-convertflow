{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#F9F6F0'
  assign text_color = section.settings.text_color | default: '#2A3B2C'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 120px 20px;
    color: {{ text_color }};
  }
  
  .hp10-bs-container-{{ section_id }} {
    max-width: 1000px;
    margin: 0 auto;
    text-align: center;
  }
  
  .hp10-bs-icon-{{ section_id }} {
    width: 80px;
    height: 80px;
    margin: 0 auto 30px;
    color: #8A9A86;
  }
  
  .hp10-bs-icon-{{ section_id }} svg {
    width: 100%;
    height: 100%;
    fill: currentColor;
  }
  
  .hp10-bs-heading-{{ section_id }} {
    font-family: 'Lora', serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 400;
    line-height: 1.3;
    margin: 0 0 30px 0;
  }
  
  .hp10-bs-text-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: 1.1rem;
    line-height: 1.7;
    color: rgba(42, 59, 44, 0.8);
    margin: 0 auto 40px;
    max-width: 700px;
  }
  
  .hp10-bs-signature-{{ section_id }} {
    font-family: 'Lora', serif;
    font-size: 1.5rem;
    font-style: italic;
    color: #D4A373;
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 80px 20px;
    }
  }
</style>

<div class="hp10-bs-container-{{ section_id }}">
  <div class="hp10-bs-icon-{{ section_id }}">
    <svg viewBox="0 0 24 24"><path d="M12 2L9 9l-7 1 5 5-1.5 7L12 18l6.5 4L17 15l5-5-7-1L12 2z"/></svg>
  </div>
  
  <h2 class="hp10-bs-heading-{{ section_id }}">
    {{ section.settings.heading | default: 'We believe that beauty is an expression of health.' }}
  </h2>
  
  <div class="hp10-bs-text-{{ section_id }}">
    {{ section.settings.text | default: '<p>Our journey started in a small kitchen, experimenting with raw, unrefined ingredients. Today, our mission remains the same: to create products that honor the earth and nourish your skin.</p>' }}
  </div>
  
  <div class="hp10-bs-signature-{{ section_id }}">
    {{ section.settings.signature | default: 'Founder, Emma' }}
  </div>
</div>

{% schema %}
{
  "name": "HP10 Brand Story",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F9F6F0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2A3B2C"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "We believe that beauty is an expression of health."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Our journey started in a small kitchen, experimenting with raw, unrefined ingredients.</p>"
    },
    {
      "type": "text",
      "id": "signature",
      "label": "Signature",
      "default": "Founder, Emma"
    }
  ],
  "presets": [
    {
      "name": "HP10 Brand Story"
    }
  ]
}
{% endschema %}
