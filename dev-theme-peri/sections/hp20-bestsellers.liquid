{%- style -%}
  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --border-color: {{ section.settings.border_color }};
    --border-thickness: {{ section.settings.border_thickness }}px;
    --shadow-color: {{ section.settings.shadow_color }};
    --shadow-offset: {{ section.settings.shadow_offset }}px;
    --accent-color: {{ section.settings.accent_color }};
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    border-top: var(--border-thickness) solid var(--border-color);
    border-bottom: var(--border-thickness) solid var(--border-color);
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }

  .hp20-bestsellers-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp20-bestsellers__header {
    text-align: center;
    margin-bottom: {{ section.settings.header_margin }}px;
  }

  .hp20-bestsellers__title {
    font-family: 'Inter', sans-serif;
    font-weight: 900;
    font-size: clamp(36px, 6vw, {{ section.settings.title_size }}px);
    color: var(--text-color);
    text-transform: uppercase;
    letter-spacing: -2px;
    margin: 0;
    display: inline-block;
    padding: 12px 24px;
    background: var(--accent-color);
    border: var(--border-thickness) solid var(--border-color);
    box-shadow: calc(var(--shadow-offset) / 2) calc(var(--shadow-offset) / 2) 0px var(--shadow-color);
    transform: rotate(-2deg);
  }

  .hp20-bestsellers__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.desktop_columns }}, 1fr);
    gap: {{ section.settings.grid_gap }}px;
  }

  @media screen and (max-width: 992px) {
    .hp20-bestsellers__grid {
      grid-template-columns: repeat({{ section.settings.tablet_columns }}, 1fr);
    }
  }

  @media screen and (max-width: 768px) {
    .hp20-bestsellers__grid {
      grid-template-columns: repeat({{ section.settings.mobile_columns }}, 1fr);
      gap: {{ section.settings.mobile_grid_gap }}px;
    }
  }

  .hp20-bestsellers__rank {
    position: absolute;
    top: -16px;
    left: -16px;
    width: 48px;
    height: 48px;
    background: var(--accent-color);
    color: var(--text-color);
    border: var(--border-thickness) solid var(--border-color);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Inter', sans-serif;
    font-weight: 900;
    font-size: 24px;
    z-index: 2;
    box-shadow: 4px 4px 0px var(--shadow-color);
  }

  /* Adjustments for the product card */
  .hp20-bestsellers__grid .card-v20 {
    position: relative; /* for rank absolute positioning */
  }

  .hp20-bestsellers__view-all-wrapper {
    margin-top: 48px;
    text-align: center;
  }

  .hp20-bestsellers__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 40px;
    background: var(--text-color);
    color: var(--bg-color);
    font-family: 'Inter', sans-serif;
    font-weight: 800;
    font-size: 16px;
    text-transform: uppercase;
    letter-spacing: 2px;
    text-decoration: none;
    border: var(--border-thickness) solid var(--border-color);
    box-shadow: var(--shadow-offset) var(--shadow-offset) 0px var(--shadow-color);
    transition: all 0.1s ease;
  }
  
  .hp20-bestsellers__btn:hover {
    background: var(--accent-color);
    color: var(--text-color);
    transform: translate(2px, 2px);
    box-shadow: calc(var(--shadow-offset) - 2px) calc(var(--shadow-offset) - 2px) 0px var(--shadow-color);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp20-bestsellers-wrapper" id="HP20Bestsellers-{{ section.id }}">
  
  <div class="hp20-bestsellers__header">
    {%- if section.settings.title != blank -%}
      <h2 class="hp20-bestsellers__title">{{ section.settings.title | escape }}</h2>
    {%- endif -%}
  </div>

  <div class="hp20-bestsellers__grid">
    {%- assign target_coll = collections[section.settings.collection] -%}
    {%- assign product_limit = section.settings.product_limit -%}
    
    {%- if target_coll != blank and target_coll.products.size > 0 -%}
      {%- for product in target_coll.products limit: product_limit -%}
        <div style="position: relative;">
          {% if section.settings.show_rank %}
            <div class="hp20-bestsellers__rank">#{{ forloop.index }}</div>
          {% endif %}
          {%- render 'card-v20', product: product, show_secondary_image: section.settings.show_secondary_image, show_vendor: section.settings.show_vendor -%}
        </div>
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..product_limit) -%}
        <div style="position: relative;">
          {% if section.settings.show_rank %}
            <div class="hp20-bestsellers__rank">#{{ i }}</div>
          {% endif %}
          <div style="background: #fff; border: var(--border-thickness) dashed var(--border-color); aspect-ratio: 3/4; display:flex; align-items:center; justify-content:center; font-family:'Inter',sans-serif; font-weight:800; color:var(--text-color); opacity: 0.5;">
            BESTSELLER {{ i }}
          </div>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>

  {%- if section.settings.show_view_all and target_coll != blank -%}
    <div class="hp20-bestsellers__view-all-wrapper">
      <a href="{{ target_coll.url }}" class="hp20-bestsellers__btn">
        SHOP ALL BESTSELLERS
      </a>
    </div>
  {%- endif -%}

</div>

{% schema %}
{
  "name": "HP20 Brutalist Sellers",
  "class": "section-hp20-bestsellers",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "THE TOP TIER"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Bestsellers Collection"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'SHOP ALL' Button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_rank",
      "label": "Show Rank Badge (#1, #2, etc.)",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1400
    },
    {
      "type": "range",
      "id": "product_limit",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Product Limit",
      "default": 4
    },
    {
      "type": "range",
      "id": "desktop_columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Desktop Columns",
      "default": 4
    },
    {
      "type": "range",
      "id": "tablet_columns",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Tablet Columns",
      "default": 2
    },
    {
      "type": "range",
      "id": "mobile_columns",
      "min": 1,
      "max": 2,
      "step": 1,
      "label": "Mobile Columns",
      "default": 1
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Grid Gap (Desktop)",
      "default": 32
    },
    {
      "type": "range",
      "id": "mobile_grid_gap",
      "min": 10,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Grid Gap (Mobile)",
      "default": 40
    },
    {
      "type": "range",
      "id": "header_margin",
      "min": 20,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "Margin Below Header",
      "default": 60
    },
    {
      "type": "header",
      "content": "Card Settings"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "label": "Show secondary image on hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": true
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 64
    },
    {
      "type": "header",
      "content": "Brutalist Styling"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#F4F4F0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text & Border Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#E2FF00"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "border_thickness",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "Border Thickness",
      "default": 3
    },
    {
      "type": "color",
      "id": "shadow_color",
      "label": "Hard Shadow Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "shadow_offset",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Hard Shadow Offset",
      "default": 8
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP20 Brutalist Sellers",
      "category": "Collection"
    }
  ]
}
{% endschema %}
