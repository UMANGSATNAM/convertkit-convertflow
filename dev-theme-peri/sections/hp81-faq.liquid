{%- style -%}#shopify-section-{{ section.id }}{background:#fff;padding:60px 24px}.hp81-faq{max-width:760px;margin:0 auto}.hp81-faq h2{text-align:center;font-family:Syne,sans-serif;font-size:28px;font-weight:800;margin:0 0 24px}.hp81-faq details{border:1px solid rgba(0,0,0,.08);border-radius:10px;padding:16px;margin-bottom:10px;background:#fff}.hp81-faq summary{font-weight:700;cursor:pointer;list-style:none} {%- endstyle -%}<div class="hp81-faq"><h2>{{ section.settings.heading | default: 'FAQs' }}</h2>{% for block in section.blocks %}<details><summary>{{ block.settings.q }}</summary><p style="opacity:.7;margin:10px 0 0">{{ block.settings.a }}</p></details>{% else %}<details><summary>What is delivery time?</summary><p style="opacity:.7;margin:10px 0 0">3-5 days pan India.</p></details><details><summary>Return policy?</summary><p style="opacity:.7;margin:10px 0 0">7 days easy returns.</p></details>{% endfor %}</div>{% schema %}{"name":"HP81 FAQ","settings":[{"type":"text","id":"heading","label":"Heading","default":"FAQs"}],"blocks":[{"type":"qa","name":"QA","settings":[{"type":"text","id":"q","label":"Q","default":"What is delivery time?"},{"type":"textarea","id":"a","label":"A","default":"3-5 days."}]}]}{% endschema %}