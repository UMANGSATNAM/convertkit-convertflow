{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp44-offer-bg: {{ section.settings.bg_gradient | default: 'linear-gradient(135deg, #143D2B 0%, #2D6A4F 100%)' }};
    --hp44-offer-text: {{ section.settings.text_color | default: '#FFFFFF' }};
    
    background: var(--hp44-offer-bg);
    color: var(--hp44-offer-text);
    padding-top: {{ section.settings.padding_top | default: 75 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 75 }}px;
    position: relative;
    overflow: hidden;
  }

  .hp44-offer__box {
    max-width: {{ section.settings.container_width | default: 860 }}px;
    margin: 0 auto;
    padding: 0 24px;
    text-align: center;
  }

  .hp44-offer__pill {
    display: inline-block;
    padding: 6px 18px;
    background: rgba(255, 255, 255, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 50px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1px;
    margin-bottom: 20px;
  }

  .hp44-offer__title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(32px, 5vw, 52px);
    font-weight: 700;
    line-height: 1.15;
    margin: 0 0 16px;
  }

  .hp44-offer__desc {
    font-size: 16px;
    line-height: 1.7;
    color: #D8E8DC;
    margin: 0 auto 30px;
    max-width: 580px;
  }

  .hp44-offer__code-wrap {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background: rgba(255, 255, 255, 0.1);
    padding: 8px 10px 8px 24px;
    border-radius: 50px;
    border: 1px dashed rgba(255, 255, 255, 0.4);
    margin-bottom: 30px;
  }

  .hp44-offer__code {
    font-family: monospace;
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 2px;
  }

  .hp44-offer__btn {
    display: inline-flex;
    padding: 16px 36px;
    background: #FFFFFF;
    color: #143D2B;
    font-family: 'Outfit', sans-serif;
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
    border-radius: 50px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    transition: all 0.25s ease;
  }

  .hp44-offer__btn:hover {
    background: #EDF4EE;
    transform: translateY(-2px);
  }
{%- endstyle -%}

<div class="hp44-offer__box">
  {%- if section.settings.badge != blank -%}
    <span class="hp44-offer__pill">{{ section.settings.badge }}</span>
  {%- endif -%}

  <h2 class="hp44-offer__title">{{ section.settings.heading | default: 'BOTANICAL PRIVILEGE: 20% OFF FIRST RITUAL' }}</h2>
  <p class="hp44-offer__desc">
    {{ section.settings.description | default: 'Experience the restorative power of cold-pressed Nordic Clary Sage. Enjoy an exclusive 20% privilege code on orders over $50.' }}
  </p>

  <div class="hp44-offer__code-wrap">
    <span class="hp44-offer__code">{{ section.settings.promo_code | default: 'SAGE20' }}</span>
  </div>

  <div>
    <a href="{{ section.settings.btn_url | default: '/collections/all' }}" class="hp44-offer__btn">
      {{ section.settings.btn_text | default: 'Claim Botanical Code &rarr;' }}
    </a>
  </div>
</div>

{% schema %}
{
  "name": "HP44 - Sage Offer",
  "class": "section-hp44-offer",
  "settings": [
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#FFFFFF" },
    { "type": "text", "id": "bg_gradient", "label": "Background Gradient", "default": "linear-gradient(135deg, #143D2B 0%, #2D6A4F 100%)" },
    { "type": "text", "id": "badge", "label": "Badge Label", "default": "LIMITED TIME DROP" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "BOTANICAL PRIVILEGE: 20% OFF FIRST RITUAL" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Experience the restorative power of cold-pressed Nordic Clary Sage. Enjoy an exclusive 20% privilege code on orders over $50." },
    { "type": "text", "id": "promo_code", "label": "Promo Code", "default": "SAGE20" },
    { "type": "text", "id": "btn_text", "label": "Button Text", "default": "Claim Botanical Code →" },
    { "type": "url", "id": "btn_url", "label": "Button URL" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 5, "unit": "px", "label": "Padding Top", "default": 75 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 5, "unit": "px", "label": "Padding Bottom", "default": 75 },
    { "type": "range", "id": "container_width", "min": 600, "max": 1200, "step": 20, "unit": "px", "label": "Container Width", "default": 860 }
  ],
  "presets": [
    { "name": "HP44 - Sage Offer" }
  ]
}
{% endschema %}
