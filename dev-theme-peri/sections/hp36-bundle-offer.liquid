{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400;1,600&family=Oswald:wght@300;400;500&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --border-color: {{ section.settings.border_color }};
    
    --font-serif: 'Playfair Display', serif;
    --font-sans: 'Oswald', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    border-bottom: 1px solid var(--border-color);
  }

  .hp36-bundle-wrapper {
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    border: 1px solid var(--border-color);
    background: var(--bg-color);
  }

  @media screen and (max-width: 992px) {
    .hp36-bundle-wrapper {
      flex-direction: column;
    }
  }
  @media screen and (max-width: 768px) {
    .hp36-bundle-wrapper {
      padding: 0;
      border: none;
    }
  }

  .hp36-bundle__image-col {
    flex: 1.5;
    position: relative;
    border-right: 1px solid var(--border-color);
  }

  @media screen and (max-width: 992px) {
    .hp36-bundle__image-col {
      border-right: none;
      border-bottom: 1px solid var(--border-color);
    }
  }

  .hp36-bundle__image-wrap {
    aspect-ratio: 4/5;
    background: #f4f4f4;
    position: relative;
    overflow: hidden;
  }

  .hp36-bundle__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%);
  }

  .hp36-bundle__badge {
    position: absolute;
    top: 30px; left: 30px;
    background: var(--text-color);
    color: var(--bg-color);
    font-family: var(--font-sans);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    padding: 8px 12px;
  }

  .hp36-bundle__content-col {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .hp36-bundle__header {
    padding: 40px;
    border-bottom: 1px solid var(--border-color);
  }

  .hp36-bundle__subtitle {
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--text-color);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    margin-bottom: 20px;
  }

  .hp36-bundle__title {
    font-family: var(--font-serif);
    font-size: clamp(32px, 4vw, {{ section.settings.title_size }}px);
    line-height: 1.1;
    color: var(--text-color);
    margin: 0;
    text-transform: uppercase;
  }

  .hp36-bundle__list {
    list-style: none;
    padding: 0;
    margin: 0;
    flex-grow: 1;
  }

  .hp36-bundle__list li {
    padding: 30px 40px;
    border-bottom: 1px solid var(--border-color);
    font-family: var(--font-sans);
    font-size: 16px;
    color: var(--text-color);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    display: flex;
    justify-content: space-between;
  }

  .hp36-bundle__list li span {
    font-family: var(--font-serif);
    font-size: 14px;
    font-style: italic;
    text-transform: none;
    opacity: 0.6;
  }

  .hp36-bundle__footer {
    padding: 40px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .hp36-bundle__price-wrap {
    display: flex;
    align-items: center;
    gap: 15px;
  }

  .hp36-bundle__price {
    font-family: var(--font-sans);
    font-size: 24px;
    color: var(--text-color);
  }

  .hp36-bundle__btn {
    font-family: var(--font-sans);
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    text-decoration: none;
    padding: 20px 40px;
    border: 1px solid var(--text-color);
    background-color: var(--text-color);
    color: var(--bg-color);
    transition: all 0.3s ease;
  }

  .hp36-bundle__btn:hover {
    background-color: transparent;
    color: var(--text-color);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp36-bundle-wrapper" id="HP36Bundle-{{ section.id }}">
  <div class="hp36-bundle__image-col">
    <div class="hp36-bundle__image-wrap">
      {%- if section.settings.badge_text != blank -%}
        <div class="hp36-bundle__badge">{{ section.settings.badge_text }}</div>
      {%- endif -%}
      {%- if section.settings.image != blank -%}
        <img height="{{ section.settings.image.height }}" width="{{ section.settings.image.width }}" src="{{ section.settings.image | image_url: width: 1000 }}" alt="{{ section.settings.title | escape }}" class="hp36-bundle__image" loading="lazy">
      {%- else -%}
        {{ 'collection-1' | placeholder_svg_tag: 'hp36-bundle__image' }}
      {%- endif -%}
    </div>
  </div>

  <div class="hp36-bundle__content-col">
    <div class="hp36-bundle__header">
      {%- if section.settings.subtitle != blank -%}
        <div class="hp36-bundle__subtitle">{{ section.settings.subtitle }}</div>
      {%- endif -%}
      <h2 class="hp36-bundle__title">{{ section.settings.title }}</h2>
    </div>
    
    <ul class="hp36-bundle__list">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}>
          {{ block.settings.item_name }}
          <span>{{ block.settings.item_desc }}</span>
        </li>
      {%- endfor -%}
    </ul>
    
    <div class="hp36-bundle__footer">
      <div class="hp36-bundle__price-wrap">
        <span class="hp36-bundle__price">{{ section.settings.price }}</span>
      </div>
      {%- if section.settings.btn_label != blank -%}
        <a href="{{ section.settings.btn_link | default: '#' }}" class="hp36-bundle__btn">
          {{ section.settings.btn_label }}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "HP36 - Editorial Bundle",
  "class": "section-hp36-bundle-offer",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Bundle Image"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "THE CAPSULE"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "LOOK 01"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Heading",
      "default": "The Monolith Silhouette"
    },
    {
      "type": "text",
      "id": "price",
      "label": "Price",
      "default": "$1,250"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "Shop the Look"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 48
    },
    {
      "type": "header",
      "content": "Editorial Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Bundle Item",
      "settings": [
        {
          "type": "text",
          "id": "item_name",
          "label": "Item Name",
          "default": "Wool Overcoat"
        },
        {
          "type": "text",
          "id": "item_desc",
          "label": "Item Detail",
          "default": "Italian Virgin Wool"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP36 - Editorial Bundle",
      "blocks": [
        { "type": "item", "settings": { "item_name": "Wool Overcoat", "item_desc": "Italian Virgin Wool" } },
        { "type": "item", "settings": { "item_name": "Silk Blouse", "item_desc": "100% Mulberry Silk" } },
        { "type": "item", "settings": { "item_name": "Tailored Trousers", "item_desc": "High Waisted" } }
      ]
    }
  ]
}
{% endschema %}
