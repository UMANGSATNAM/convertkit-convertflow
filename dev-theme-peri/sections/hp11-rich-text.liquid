{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#000000'
  assign text_color = section.settings.text_color | default: '#CCFF00'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 120px 20px;
    color: {{ text_color }};
    border-bottom: 3px solid #000;
  }
  
  .hp11-rich-text-container-{{ section_id }} {
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
  }
  
  .hp11-rich-text-heading-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: clamp(3rem, 6vw, 5rem);
    font-weight: 900;
    text-transform: uppercase;
    margin: 0 0 30px 0;
    line-height: 1;
    letter-spacing: -2px;
  }
  
  .hp11-rich-text-content-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.4;
    color: #FFF;
  }
</style>

<div class="hp11-rich-text-container-{{ section_id }}">
  <h2 class="hp11-rich-text-heading-{{ section_id }}">{{ section.settings.heading | default: 'NO COMPROMISE' }}</h2>
  <div class="hp11-rich-text-content-{{ section_id }}">
    {{ section.settings.text | default: '<p>Every piece is constructed to last. Heavyweight blanks, brutalist cuts, uncompromising quality.</p>' }}
  </div>
</div>

{% schema %}
{
  "name": "HP11 Rich Text",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Heading Color",
      "default": "#CCFF00"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "NO COMPROMISE"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Every piece is constructed to last. Heavyweight blanks, brutalist cuts, uncompromising quality.</p>"
    }
  ],
  "presets": [
    {
      "name": "HP11 Rich Text"
    }
  ]
}
{% endschema %}
