{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --font-heading: 'Cormorant Garamond', serif;
    --font-body: 'Inter', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.8 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.8 | round }}px;
    }
  }

  .hp26-feat-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp26-feat-wrapper {
      padding: 0 20px;
    }
  }

  .hp26-feat__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: {{ section.settings.header_margin }}px;
  }

  @media screen and (max-width: 768px) {
    .hp26-feat__header {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }
  }

  .hp26-feat__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    font-weight: 400;
    color: var(--text-color);
    margin: 0;
    line-height: 1.1;
  }

  .hp26-feat__title em {
    font-style: italic;
    font-weight: 300;
  }

  .hp26-feat__view-all {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-color);
    text-decoration: none;
    position: relative;
    padding-bottom: 4px;
  }

  .hp26-feat__view-all::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 1px;
    background-color: var(--text-color);
    opacity: 0.3;
    transition: opacity 0.3s ease;
  }

  .hp26-feat__view-all:hover::after {
    opacity: 1;
  }

  .hp26-feat__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
  }

  @media screen and (max-width: 992px) {
    .hp26-feat__grid {
      grid-template-columns: 1fr;
    }
  }

  /* Left Side: Large Feature Image */
  .hp26-feat__main-col {
    position: relative;
    border-radius: 4px;
    overflow: hidden;
    aspect-ratio: 4/5;
  }

  .hp26-feat__main-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.5s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .hp26-feat__main-col:hover .hp26-feat__main-img {
    transform: scale(1.05);
  }

  .hp26-feat__main-overlay {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background: linear-gradient(to top, rgba(0,0,0,0.3) 0%, transparent 40%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 40px;
    pointer-events: none;
  }

  @media screen and (max-width: 768px) {
    .hp26-feat__main-overlay {
      padding: 30px 20px;
    }
  }

  .hp26-feat__main-title {
    font-family: var(--font-heading);
    font-size: 36px;
    font-weight: 400;
    font-style: italic;
    color: #fff;
    margin: 0;
  }

  /* Right Side: Products Grid */
  .hp26-feat__products-col {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 30px;
    align-content: space-between;
  }

  @media screen and (max-width: 600px) {
    .hp26-feat__products-col {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }

  .hp26-feat__product {
    text-decoration: none;
    display: block;
    group;
  }

  .hp26-feat__product-img-wrap {
    position: relative;
    aspect-ratio: 3/4;
    overflow: hidden;
    margin-bottom: 20px;
    background-color: #EAE6DF;
    border-radius: 4px;
  }

  .hp26-feat__product-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s ease, filter 0.8s ease;
  }

  .hp26-feat__product:hover .hp26-feat__product-img {
    transform: scale(1.03);
    filter: brightness(0.95);
  }

  .hp26-feat__product-info {
    text-align: left;
  }

  .hp26-feat__product-title {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 500;
    color: var(--text-color);
    margin: 0 0 5px;
    letter-spacing: 0.05em;
  }

  .hp26-feat__product-price {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 300;
    color: var(--text-color);
    opacity: 0.7;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp26-feat-wrapper" id="HP26Featured-{{ section.id }}">
  <div class="hp26-feat__header">
    {%- if section.settings.title != blank -%}
      <h2 class="hp26-feat__title">{{ section.settings.title }}</h2>
    {%- endif -%}

    {%- if section.settings.btn_text != blank -%}
      <a href="{{ section.settings.btn_link | default: '#' }}" class="hp26-feat__view-all">
        {{ section.settings.btn_text }}
      </a>
    {%- endif -%}
  </div>

  <div class="hp26-feat__grid">
    
    <div class="hp26-feat__main-col">
      <a href="{{ section.settings.main_link | default: '#' }}" style="display:block;width:100%;height:100%;">
        {%- if section.settings.main_image != blank -%}
          <img height="{{ section.settings.main_image.height }}" width="{{ section.settings.main_image.width }}" src="{{ section.settings.main_image | image_url: width: 1000 }}" alt="{{ section.settings.main_title | escape }}" class="hp26-feat__main-img" loading="lazy">
        {%- else -%}
          <div style="width:100%;height:100%;background:var(--accent-color);display:flex;align-items:center;justify-content:center;color:#fff;">EDITORIAL IMAGE</div>
        {%- endif -%}
        
        <div class="hp26-feat__main-overlay">
          {%- if section.settings.main_title != blank -%}
            <h3 class="hp26-feat__main-title">{{ section.settings.main_title }}</h3>
          {%- endif -%}
        </div>
      </a>
    </div>

    <div class="hp26-feat__products-col">
      {%- for block in section.blocks -%}
        {%- assign prod = block.settings.product -%}
        <a href="{{ prod.url | default: '#' }}" class="hp26-feat__product" {{ block.shopify_attributes }}>
          <div class="hp26-feat__product-img-wrap">
            {%- if prod != blank and prod.featured_image != blank -%}
              <img height="{{ prod.featured_image.height }}" width="{{ prod.featured_image.width }}" src="{{ prod.featured_image | image_url: width: 600 }}" alt="{{ prod.title | escape }}" class="hp26-feat__product-img" loading="lazy">
            {%- else -%}
              <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:var(--text-color);font-family:var(--font-body);font-size:12px;opacity:0.5;">PRODUCT</div>
            {%- endif -%}
          </div>
          <div class="hp26-feat__product-info">
            <div class="hp26-feat__product-title">{{ prod.title | default: 'Minimalist Item' }}</div>
            <div class="hp26-feat__product-price">{{ prod.price | default: 8500 | money }}</div>
          </div>
        </a>
      {%- endfor -%}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "HP26 - Japandi Featured",
  "class": "section-hp26-featured-collection",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Curated <em>Edits</em>"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "View All Text",
      "default": "EXPLORE ALL"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "View All Link"
    },
    {
      "type": "range",
      "id": "header_margin",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Margin Below Header",
      "default": 60
    },
    {
      "type": "header",
      "content": "Editorial Column (Left)"
    },
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Editorial Image"
    },
    {
      "type": "text",
      "id": "main_title",
      "label": "Editorial Title",
      "default": "New Arrivals"
    },
    {
      "type": "url",
      "id": "main_link",
      "label": "Editorial Link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1400
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 32,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 48
    },
    {
      "type": "header",
      "content": "Japandi Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#F5F2EB"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2C2A28"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#8B9582"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "limit": 4,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP26 - Japandi Featured",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
