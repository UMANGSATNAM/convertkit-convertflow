{%- liquid
  assign bg_color = section.settings.bg_color | default: '#050505'
  assign text_color = section.settings.text_color | default: '#ffffff'
  assign overlay_color = section.settings.overlay_color | default: '#000000'
  
  assign padding_top_desktop = section.settings.padding_top_desktop
  assign padding_bottom_desktop = section.settings.padding_bottom_desktop
  assign padding_top_mobile = section.settings.padding_top_mobile
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile
-%}

<style>
  #shopify-section-{{ section.id }} {
    --hp6-tiles-bg: {{ bg_color }};
    --hp6-tiles-text: {{ text_color }};
    --hp6-tiles-overlay: {{ overlay_color }};
    
    --hp6-tiles-pt-desk: {{ padding_top_desktop }}px;
    --hp6-tiles-pb-desk: {{ padding_bottom_desktop }}px;
    --hp6-tiles-pt-mob: {{ padding_top_mobile }}px;
    --hp6-tiles-pb-mob: {{ padding_bottom_mobile }}px;
  }

  .hp6-sports-tiles-{{ section.id }} {
    padding-top: var(--hp6-tiles-pt-desk);
    padding-bottom: var(--hp6-tiles-pb-desk);
    background-color: var(--hp6-tiles-bg);
  }

  .hp6-tiles-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .hp6-tiles-header {
    text-align: center;
    margin-bottom: 50px;
  }

  .hp6-tiles-title {
    font-family: 'Oswald', sans-serif;
    font-size: clamp(36px, 5vw, 64px);
    font-weight: 700;
    text-transform: uppercase;
    color: var(--hp6-tiles-text);
    margin: 0;
    letter-spacing: -1px;
  }
  .hp6-tiles-title span {
    color: transparent;
    -webkit-text-stroke: 1.5px var(--hp6-tiles-text);
  }

  /* Grid Masonry-ish */
  .hp6-tiles-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: 350px;
    gap: 20px;
  }

  .hp6-tile-item {
    position: relative;
    display: block;
    overflow: hidden;
    background: #1a1a1a;
    text-decoration: none;
    clip-path: polygon(5% 0, 100% 0, 95% 100%, 0% 100%);
  }

  /* Size variations based on block setting or index */
  .hp6-tile-item.size-large {
    grid-column: span 2;
    grid-row: span 2;
  }
  .hp6-tile-item.size-wide {
    grid-column: span 2;
  }
  .hp6-tile-item.size-tall {
    grid-row: span 2;
  }

  .hp6-tile-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .hp6-tile-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.8) 0%, rgba(0,0,0,0.2) 50%, transparent 100%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 40px;
    z-index: 2;
  }

  .hp6-tile-title {
    font-family: 'Oswald', sans-serif;
    font-size: 32px;
    font-weight: 700;
    text-transform: uppercase;
    color: #fff;
    margin: 0 0 10px 0;
    transform: translateY(20px);
    transition: transform 0.4s ease;
  }

  .hp6-tile-link {
    font-family: 'Oswald', sans-serif;
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: #ff4500;
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.4s ease;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .hp6-tile-link svg { width: 16px; height: 16px; fill: currentColor; }

  .hp6-tile-item:hover .hp6-tile-img {
    transform: scale(1.05);
  }
  .hp6-tile-item:hover .hp6-tile-title,
  .hp6-tile-item:hover .hp6-tile-link {
    transform: translateY(0);
  }
  .hp6-tile-item:hover .hp6-tile-link {
    opacity: 1;
  }

  @media screen and (max-width: 1024px) {
    .hp6-tiles-grid {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 300px;
    }
    .hp6-tile-item.size-large { grid-column: span 2; }
    .hp6-tile-item.size-wide { grid-column: span 2; }
    .hp6-tile-item.size-tall { grid-row: span 1; grid-column: span 1; }
  }

  @media screen and (max-width: 768px) {
    .hp6-sports-tiles-{{ section.id }} {
      padding-top: var(--hp6-tiles-pt-mob);
      padding-bottom: var(--hp6-tiles-pb-mob);
    }
    .hp6-tiles-inner {
      padding: 0 20px;
    }
    .hp6-tiles-grid {
      grid-template-columns: 1fr;
      grid-auto-rows: 250px;
      gap: 15px;
    }
    .hp6-tile-item {
      grid-column: span 1 !important;
      grid-row: span 1 !important;
      clip-path: none;
      border-radius: 8px;
    }
    .hp6-tile-overlay {
      padding: 25px;
    }
    .hp6-tile-title {
      font-size: 24px;
      transform: translateY(0);
    }
    .hp6-tile-link {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<section class="hp6-sports-tiles-{{ section.id }}" aria-label="Collections Grid">
  <div class="hp6-tiles-inner">
    
    {%- if section.settings.heading != blank -%}
      <div class="hp6-tiles-header">
        <h2 class="hp6-tiles-title">{{ section.settings.heading | replace: 'HOLLOW WORD', '<span>HOLLOW WORD</span>' }}</h2>
      </div>
    {%- endif -%}

    <div class="hp6-tiles-grid">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link }}" class="hp6-tile-item size-{{ block.settings.size }}" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 1200 }}" class="hp6-tile-img" loading="lazy" alt="{{ block.settings.title }}">
          {%- else -%}
            {%- capture current -%}{% cycle 1, 2, 3, 4, 5, 6 %}{%- endcapture -%}
            {{ 'collection-' | append: current | placeholder_svg_tag: 'hp6-tile-img placeholder-svg' }}
          {%- endif -%}
          
          <div class="hp6-tile-overlay">
            <h3 class="hp6-tile-title">{{ block.settings.title }}</h3>
            <span class="hp6-tile-link">Explore <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="square" fill="none"/></svg></span>
          </div>
        </a>
      {%- endfor -%}

      {%- if section.blocks.size == 0 -%}
        <a href="#" class="hp6-tile-item size-large">
          {{ 'collection-1' | placeholder_svg_tag: 'hp6-tile-img placeholder-svg' }}
          <div class="hp6-tile-overlay"><h3 class="hp6-tile-title">MEN'S APPAREL</h3><span class="hp6-tile-link">Explore <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="square" fill="none"/></svg></span></div>
        </a>
        <a href="#" class="hp6-tile-item size-normal">
          {{ 'collection-2' | placeholder_svg_tag: 'hp6-tile-img placeholder-svg' }}
          <div class="hp6-tile-overlay"><h3 class="hp6-tile-title">FOOTWEAR</h3><span class="hp6-tile-link">Explore</span></div>
        </a>
        <a href="#" class="hp6-tile-item size-normal">
          {{ 'collection-3' | placeholder_svg_tag: 'hp6-tile-img placeholder-svg' }}
          <div class="hp6-tile-overlay"><h3 class="hp6-tile-title">ACCESSORIES</h3><span class="hp6-tile-link">Explore</span></div>
        </a>
        <a href="#" class="hp6-tile-item size-wide">
          {{ 'collection-4' | placeholder_svg_tag: 'hp6-tile-img placeholder-svg' }}
          <div class="hp6-tile-overlay"><h3 class="hp6-tile-title">WOMEN'S APPAREL</h3><span class="hp6-tile-link">Explore</span></div>
        </a>
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "HP6 Sports Grid",
  "tag": "section",
  "class": "section-hp6-category-tiles",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "CHOOSE YOUR <span>ARENA</span>",
      "info": "Use <span> to apply the hollow outline style."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#050505"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Top (Desktop)", "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Bottom (Desktop)", "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Top (Mobile)", "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Bottom (Mobile)", "default": 50
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection Block",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Collection Name"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "size",
          "label": "Tile Size",
          "options": [
            { "value": "normal", "label": "Normal (1x1)" },
            { "value": "large", "label": "Large (2x2)" },
            { "value": "wide", "label": "Wide (2x1)" },
            { "value": "tall", "label": "Tall (1x2)" }
          ],
          "default": "normal"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP6 Sports Grid",
      "category": "Collection",
      "blocks": [
        { "type": "collection", "settings": { "title": "MEN'S", "size": "large" } },
        { "type": "collection", "settings": { "title": "SHOES", "size": "normal" } },
        { "type": "collection", "settings": { "title": "GEAR", "size": "normal" } },
        { "type": "collection", "settings": { "title": "WOMEN'S", "size": "wide" } }
      ]
    }
  ]
}
{% endschema %}
