{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp46-test-bg: {{ section.settings.bg_color | default: '#0B0F19' }};
    
    background-color: var(--hp46-test-bg);
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
  }

  .hp46-test__wrap {
    max-width: {{ section.settings.container_width | default: 1240 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp46-test__header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 50px;
  }

  .hp46-test__heading {
    font-family: 'Syne', sans-serif;
    font-size: clamp(28px, 4vw, 42px);
    font-weight: 800;
    color: #FFFFFF;
    margin: 0 0 8px;
  }

  .hp46-test__heading span {
    background: linear-gradient(135deg, #38BDF8, #F472B6);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hp46-test__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: 3 }}, 1fr);
    gap: 24px;
  }

  .hp46-test__card {
    background: rgba(15, 23, 42, 0.65);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(56, 189, 248, 0.2);
    border-radius: 24px;
    padding: 36px 28px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
    transition: all 0.3s ease;
  }

  .hp46-test__card:hover {
    border-color: #F472B6;
    box-shadow: 0 15px 40px rgba(244, 114, 182, 0.2);
  }

  .hp46-test__stars {
    color: #38BDF8;
    font-size: 18px;
    margin-bottom: 16px;
    letter-spacing: 2px;
  }

  .hp46-test__quote {
    font-size: 15px;
    line-height: 1.7;
    color: #E2E8F0;
    margin: 0 0 24px;
    font-style: italic;
  }

  .hp46-test__author-row {
    border-top: 1px solid rgba(56, 189, 248, 0.15);
    padding-top: 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .hp46-test__author {
    font-family: 'Syne', sans-serif;
    font-size: 14px;
    font-weight: 700;
    color: #FFFFFF;
  }

  .hp46-test__tag {
    font-size: 11px;
    font-weight: 700;
    color: #F472B6;
  }

  @media screen and (max-width: 992px) {
    .hp46-test__grid { grid-template-columns: 1fr; max-width: 500px; margin: 0 auto; }
  }
{%- endstyle -%}

<div class="hp46-test__wrap">
  <div class="hp46-test__header">
    <h2 class="hp46-test__heading">VERIFIED <span>CYBER REVIEWS</span></h2>
    <p style="font-size:14px; color:#94A3B8;">{{ section.settings.subheading | default: 'Patrons worldwide experiencing quantum bioluminescent results.' }}</p>
  </div>

  <div class="hp46-test__grid">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <div class="hp46-test__card" {{ block.shopify_attributes }}>
          <div>
            <div class="hp46-test__stars">★★★★★</div>
            <p class="hp46-test__quote">"{{ block.settings.quote }}"</p>
          </div>
          <div class="hp46-test__author-row">
            <span class="hp46-test__author">{{ block.settings.author }}</span>
            <span class="hp46-test__tag">⚡ VERIFIED BUYER</span>
          </div>
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="hp46-test__card">
        <div>
          <div class="hp46-test__stars">★★★★★</div>
          <p class="hp46-test__quote">"The holographic enzyme serum gave me an unreal, glass-skin reflection in under one week. Incredible."</p>
        </div>
        <div class="hp46-test__author-row">
          <span class="hp46-test__author">KAI TAKAHASHI</span>
          <span class="hp46-test__tag">⚡ VERIFIED BUYER</span>
        </div>
      </div>
      <div class="hp46-test__card">
        <div>
          <div class="hp46-test__stars">★★★★★</div>
          <p class="hp46-test__quote">"Neon peptide glaze balm keeps my face hydrated through 12-hour studio computer screen marathons."</p>
        </div>
        <div class="hp46-test__author-row">
          <span class="hp46-test__author">MAYA LINDEN</span>
          <span class="hp46-test__tag">⚡ VERIFIED BUYER</span>
        </div>
      </div>
      <div class="hp46-test__card">
        <div>
          <div class="hp46-test__stars">★★★★★</div>
          <p class="hp46-test__quote">"Express air delivery took just 48 hours to London with all taxes fully pre-paid. Top tier experience."</p>
        </div>
        <div class="hp46-test__author-row">
          <span class="hp46-test__author">CHLOE DUBOIS</span>
          <span class="hp46-test__tag">⚡ VERIFIED BUYER</span>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP46 - Cyber Test",
  "class": "section-hp46-testimonials",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#0B0F19" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Patrons worldwide experiencing quantum bioluminescent results." },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "label": "Desktop Columns", "default": 3 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 80 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1240 }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review Item",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "The holographic enzyme serum gave me an unreal, glass-skin reflection." },
        { "type": "text", "id": "author", "label": "Author Name", "default": "KAI TAKAHASHI" }
      ]
    }
  ],
  "presets": [
    { "name": "HP46 - Cyber Test" }
  ]
}
{% endschema %}
