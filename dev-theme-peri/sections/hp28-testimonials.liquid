{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Chakra+Petch:ital,wght@0,300;0,400;0,600;0,700;1,400&family=Press+Start+2P&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --cyan: {{ section.settings.cyan_color }};
    --magenta: {{ section.settings.magenta_color }};
    --green: {{ section.settings.green_color }};
    --win-bg: #c0c0c0;
    --win-dark: #000000;
    --win-light: #ffffff;
    --win-border-light: #dfdfdf;
    --win-border-dark: #808080;
    --win-title-bg: #000080;
    
    --font-heading: 'Press Start 2P', cursive;
    --font-body: 'Chakra Petch', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    position: relative;
    overflow: hidden;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.8 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.8 | round }}px;
    }
  }

  /* Scanline BG for section */
  #shopify-section-{{ section.id }}::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: repeating-linear-gradient(
      transparent,
      transparent 2px,
      rgba(0, 255, 255, 0.03) 2px,
      rgba(0, 255, 255, 0.03) 4px
    );
    pointer-events: none;
    z-index: 0;
  }

  .hp28-test-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
    position: relative;
    z-index: 1;
  }

  @media screen and (max-width: 768px) {
    .hp28-test-wrapper {
      padding: 0 20px;
    }
  }

  .hp28-test__header {
    text-align: center;
    margin-bottom: 60px;
  }

  .hp28-test__title {
    font-family: var(--font-heading);
    font-size: clamp(20px, 3.5vw, {{ section.settings.title_size }}px);
    color: var(--cyan);
    text-shadow: 3px 3px 0 var(--magenta);
    margin: 0;
    text-transform: uppercase;
  }

  .hp28-test__subtitle {
    font-family: var(--font-body);
    font-size: 16px;
    color: var(--text-color);
    margin: 15px 0 0;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  /* Grid layout for "bulletin board" */
  .hp28-test__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: 40px;
  }

  @media screen and (max-width: 992px) {
    .hp28-test__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 768px) {
    .hp28-test__grid {
      grid-template-columns: 1fr;
      gap: 30px;
    }
  }

  /* Style items as Terminal / IRC windows */
  .hp28-test__item {
    background: #000;
    border: 2px solid var(--green);
    position: relative;
    padding-top: 25px; /* space for title bar */
    box-shadow: 6px 6px 0 var(--cyan);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  /* Stagger items slightly for chaos */
  .hp28-test__item:nth-child(even) {
    transform: translateY(20px);
  }
  @media screen and (max-width: 768px) {
    .hp28-test__item:nth-child(even) {
      transform: none;
    }
  }

  .hp28-test__item:hover {
    transform: translateY(-5px);
    box-shadow: 10px 10px 0 var(--magenta);
    border-color: var(--magenta);
  }
  .hp28-test__item:nth-child(even):hover {
    transform: translateY(15px);
  }
  @media screen and (max-width: 768px) {
    .hp28-test__item:nth-child(even):hover {
      transform: translateY(-5px);
    }
  }

  .hp28-test__titlebar {
    position: absolute;
    top: 0; left: 0; width: 100%;
    background: var(--green);
    color: #000;
    padding: 4px 10px;
    font-family: var(--font-heading);
    font-size: 10px;
    display: flex;
    justify-content: space-between;
    transition: background 0.2s ease;
  }

  .hp28-test__item:hover .hp28-test__titlebar {
    background: var(--magenta);
    color: #fff;
  }

  .hp28-test__content {
    padding: 20px;
  }

  .hp28-test__rating {
    color: var(--cyan);
    font-family: var(--font-heading);
    font-size: 12px;
    margin-bottom: 15px;
    letter-spacing: 2px;
  }

  .hp28-test__item:hover .hp28-test__rating {
    color: var(--green);
  }

  .hp28-test__text {
    font-family: var(--font-body);
    font-size: 16px;
    color: var(--text-color);
    line-height: 1.6;
    margin: 0 0 20px;
  }

  /* Typwriter cursor effect on text */
  .hp28-test__item:hover .hp28-test__text::after {
    content: '_';
    animation: blinkCursor 1s infinite;
  }

  @keyframes blinkCursor {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  .hp28-test__author {
    font-family: var(--font-heading);
    font-size: 12px;
    color: var(--magenta);
    margin: 0;
  }

  .hp28-test__author::before {
    content: 'usr: ';
    color: var(--text-color);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp28-test-wrapper" id="HP28Testimonials-{{ section.id }}">
  <div class="hp28-test__header">
    {%- if section.settings.title != blank -%}
      <h2 class="hp28-test__title">{{ section.settings.title }}</h2>
    {%- endif -%}
    {%- if section.settings.subtitle != blank -%}
      <p class="hp28-test__subtitle">{{ section.settings.subtitle }}</p>
    {%- endif -%}
  </div>

  <div class="hp28-test__grid">
    {%- for block in section.blocks -%}
      <div class="hp28-test__item" {{ block.shopify_attributes }}>
        <div class="hp28-test__titlebar">
          <span>MSG_{{ forloop.index | prepend: '0' }}</span>
          <span>_ [] X</span>
        </div>
        <div class="hp28-test__content">
          {%- if block.settings.rating > 0 -%}
            <div class="hp28-test__rating">
              {%- for i in (1..block.settings.rating) -%}★{%- endfor -%}
            </div>
          {%- endif -%}
          
          <div class="hp28-test__text">"{{ block.settings.text }}"</div>
          
          <div class="hp28-test__author">{{ block.settings.author }}</div>
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "HP28 - Y2K Testimonials",
  "class": "section-hp28-testimonials",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "USER FEEDBACK"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "VERIFIED TRANSMISSIONS"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1400
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns (Desktop)",
      "default": 3
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 20,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 48
    },
    {
      "type": "header",
      "content": "Y2K Cyber Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (Deep Purple)",
      "default": "#1C0B2B"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Base Text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "cyan_color",
      "label": "Cyan Accent",
      "default": "#00FFFF"
    },
    {
      "type": "color",
      "id": "magenta_color",
      "label": "Magenta Accent",
      "default": "#FF00FF"
    },
    {
      "type": "color",
      "id": "green_color",
      "label": "Acid Green Accent",
      "default": "#39FF14"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 100
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Rating",
          "default": 5
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Hardware installed successfully. Performance increased by 400%. Highly recommended."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "neo_1999"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP28 - Y2K Testimonials",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" }
      ]
    }
  ]
}
{% endschema %}
