{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#0B0F19' }};
    padding: {{ section.settings.padding_vertical | default: 35 }}px 0;
  }
  .hp58-pills__container { max-width: 1280px; margin: 0 auto; padding: 0 24px; }
  .hp58-pills__scroll { display: flex; gap: 12px; overflow-x: auto; scrollbar-width: none; justify-content: center; flex-wrap: wrap; }
  .hp58-pills__scroll::-webkit-scrollbar { display: none; }
  .hp58-pills__pill {
    display: inline-flex; align-items: center; gap: 8px; padding: 10px 22px;
    background: {{ section.settings.pill_bg | default: '#111827' }};
    border: 1px solid rgba(6, 182, 212, 0.25); border-radius: 4px;
    font-family: 'Space Grotesk', sans-serif; font-size: 13px; font-weight: 600;
    color: {{ section.settings.pill_text | default: '#F8FAFC' }};
    text-decoration: none; white-space: nowrap; transition: all 0.3s ease;
  }
  .hp58-pills__pill:hover { background: #06B6D4; color: #0B0F19; border-color: #06B6D4; box-shadow: 0 0 15px rgba(6, 182, 212, 0.5); }
  @media screen and (max-width: 768px) { .hp58-pills__scroll { justify-content: flex-start; flex-wrap: nowrap; } }
{%- endstyle -%}
<div class="hp58-pills__container">
  <div class="hp58-pills__scroll">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.url | default: '#' }}" class="hp58-pills__pill" {{ block.shopify_attributes }}>
        {%- if block.settings.icon != blank -%}<span>{{ block.settings.icon }}</span>{%- endif -%}
        <span>{{ block.settings.label | default: 'Category' }}</span>
      </a>
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "HP58 Categories",
  "class": "section-hp58-pills",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#0B0F19" },
    { "type": "color", "id": "pill_bg", "label": "Pill BG", "default": "#111827" },
    { "type": "color", "id": "pill_text", "label": "Pill Text", "default": "#F8FAFC" },
    { "type": "range", "id": "padding_vertical", "min": 10, "max": 60, "step": 5, "unit": "px", "label": "Padding", "default": 35 }
  ],
  "blocks": [{ "type": "pill", "name": "Category", "settings": [
    { "type": "text", "id": "icon", "label": "Icon", "default": "⚡" },
    { "type": "text", "id": "label", "label": "Label", "default": "Quantum Serums" },
    { "type": "url", "id": "url", "label": "URL" }
  ]}],
  "presets": [{ "name": "HP58 Categories", "blocks": [
    { "type": "pill", "settings": { "icon": "🧬", "label": "Quantum Serums" } },
    { "type": "pill", "settings": { "icon": "⚡", "label": "Cyber-Algae" } },
    { "type": "pill", "settings": { "icon": "🛡️", "label": "HEV Shields" } },
    { "type": "pill", "settings": { "icon": "🧪", "label": "Peptide 7X" } },
    { "type": "pill", "settings": { "icon": "💎", "label": "Laser Mists" } }
  ]}]
}
{% endschema %}
