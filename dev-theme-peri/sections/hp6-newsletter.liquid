{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#ff2a5f'
  assign text_color = section.settings.text_color | default: '#ffffff'
  assign button_bg = section.settings.button_bg | default: '#000000'
  assign button_text = section.settings.button_text | default: '#ffffff'
  assign heading = section.settings.heading | default: 'UNLOCK EXCLUSIVE DROPS'
  assign subtext = section.settings.subtext | default: 'Join the squad. Get early access to new gear, training plans, and VIP events.'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    color: {{ text_color }};
    position: relative;
    overflow: hidden;
    padding: 120px 0;
  }
  
  /* Diagonal animated stripes background */
  .hp6-news-bg-{{ section_id }} {
    position: absolute;
    top: 0;
    left: -50%;
    width: 200%;
    height: 100%;
    background: repeating-linear-gradient(
      -45deg,
      rgba(0, 0, 0, 0) 0,
      rgba(0, 0, 0, 0) 20px,
      rgba(0, 0, 0, 0.05) 20px,
      rgba(0, 0, 0, 0.05) 40px
    );
    z-index: 1;
    animation: hp6NewsScroll 20s linear infinite;
  }
  
  @keyframes hp6NewsScroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(50px); }
  }
  
  .hp6-news-container-{{ section_id }} {
    max-width: 800px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 0 20px;
  }
  
  .hp6-news-heading-{{ section_id }} {
    font-size: clamp(3rem, 6vw, 5rem);
    font-family: 'Impact', 'Arial Black', sans-serif;
    text-transform: uppercase;
    font-weight: 900;
    margin: 0 0 20px 0;
    line-height: 0.9;
    letter-spacing: -0.02em;
    text-shadow: 4px 4px 0 rgba(0,0,0,0.15);
  }
  
  .hp6-news-subtext-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0 0 40px 0;
    opacity: 0.9;
  }
  
  .hp6-news-form-{{ section_id }} {
    display: flex;
    max-width: 600px;
    margin: 0 auto;
    position: relative;
    transform: skewX(-5deg);
    box-shadow: 10px 10px 0 rgba(0,0,0,0.2);
  }
  
  .hp6-news-input-{{ section_id }} {
    flex-grow: 1;
    background: #fff;
    border: none;
    padding: 20px 25px;
    font-family: 'Inter', sans-serif;
    font-size: 1.1rem;
    font-weight: 600;
    color: #000;
    outline: none;
    transform: skewX(5deg); /* Undo skew for text readability */
    /* apply skew inside by wrapping if needed, but modern way: */
  }
  
  .hp6-news-input-wrapper-{{ section_id }} {
    flex-grow: 1;
    background: #fff;
    display: flex;
    align-items: center;
  }
  
  .hp6-news-input-wrapper-{{ section_id }} input {
    width: 100%;
    background: transparent;
    border: none;
    padding: 20px 25px;
    font-family: 'Inter', sans-serif;
    font-size: 1.1rem;
    font-weight: 600;
    color: #000;
    outline: none;
    transform: skewX(5deg);
  }
  
  .hp6-news-input-wrapper-{{ section_id }} input::placeholder {
    color: #999;
    font-style: italic;
  }
  
  .hp6-news-btn-{{ section_id }} {
    background: {{ button_bg }};
    color: {{ button_text }};
    border: none;
    padding: 0 40px;
    font-family: 'Impact', sans-serif;
    font-size: 1.5rem;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .hp6-news-btn-{{ section_id }} span {
    transform: skewX(5deg);
  }
  
  .hp6-news-btn-{{ section_id }}:hover {
    background: #ffffff;
    color: #000000;
  }
  
  /* Success/Error Message states */
  .hp6-news-message-{{ section_id }} {
    margin-top: 20px;
    font-family: 'Inter', sans-serif;
    font-weight: 700;
    font-size: 1.1rem;
    background: #000;
    color: #fff;
    padding: 10px 20px;
    display: inline-block;
    transform: skewX(-5deg);
  }
  
  .hp6-news-message-{{ section_id }} span {
    display: block;
    transform: skewX(5deg);
  }

  @media (max-width: 600px) {
    .hp6-news-form-{{ section_id }} {
      flex-direction: column;
      transform: none;
      box-shadow: 5px 5px 0 rgba(0,0,0,0.2);
    }
    .hp6-news-input-wrapper-{{ section_id }} input,
    .hp6-news-btn-{{ section_id }} span {
      transform: none;
    }
    .hp6-news-btn-{{ section_id }} {
      padding: 20px;
    }
  }
</style>

<div class="hp6-news-bg-{{ section_id }}"></div>

<div class="hp6-news-container-{{ section_id }}">
  <h2 class="hp6-news-heading-{{ section_id }}">{{ heading }}</h2>
  <p class="hp6-news-subtext-{{ section_id }}">{{ subtext }}</p>
  
  {% form 'customer', class: 'hp6-news-form-wrapper' %}
    <input type="hidden" name="contact[tags]" value="newsletter">
    
    <div class="hp6-news-form-{{ section_id }}">
      <div class="hp6-news-input-wrapper-{{ section_id }}">
        <input 
          type="email" 
          name="contact[email]" 
          id="hp6-newsletter-email-{{ section_id }}" 
          placeholder="ENTER YOUR EMAIL" 
          required
        >
      </div>
      <button type="submit" class="hp6-news-btn-{{ section_id }}">
        <span>JOIN</span>
      </button>
    </div>
    
    {% if form.posted_successfully? %}
      <div class="hp6-news-message-{{ section_id }}">
        <span>Welcome to the squad. Keep an eye on your inbox.</span>
      </div>
    {% endif %}
    {% if form.errors %}
      <div class="hp6-news-message-{{ section_id }}" style="background: #ff0000;">
        <span>{{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}</span>
      </div>
    {% endif %}
  {% endform %}
</div>

{% schema %}
{
  "name": "HP6 Newsletter Banner",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ff2a5f"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button Background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Button Text",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "UNLOCK EXCLUSIVE DROPS"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Join the squad. Get early access to new gear, training plans, and VIP events."
    }
  ],
  "presets": [
    {
      "name": "HP6 Newsletter Banner"
    }
  ]
}
{% endschema %}
