{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=Syne:wght@700;800&display=swap');

  #shopify-section-{{ section.id }} {
    --hp64-bg: {{ section.settings.bg_color | default: '#090D16' }};
    --hp64-text: {{ section.settings.text_color | default: '#FFFFFF' }};
    --hp64-mint: {{ section.settings.accent_mint | default: '#10B981' }};
    --hp64-cyan: {{ section.settings.accent_cyan | default: '#06B6D4' }};
    --hp64-btn-bg: {{ section.settings.btn_bg | default: '#06B6D4' }};
    --hp64-btn-text: {{ section.settings.btn_text_color | default: '#030712' }};

    background: radial-gradient(circle at 80% 20%, #083344 0%, var(--hp64-bg) 60%, #022c22 100%);
    color: var(--hp64-text);
    font-family: 'Space Grotesk', sans-serif;
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
    position: relative;
    overflow: hidden;
  }

  .hp64-hero__container {
    max-width: {{ section.settings.container_width | default: 1280 }}px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 70px;
    align-items: center;
  }

  .hp64-hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 18px;
    background: rgba(6, 182, 212, 0.1);
    border: 1px solid rgba(6, 182, 212, 0.35);
    border-radius: 4px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--hp64-cyan);
    margin-bottom: 24px;
    box-shadow: 0 0 15px rgba(6, 182, 212, 0.2);
  }

  .hp64-hero__title {
    font-family: 'Syne', sans-serif;
    font-size: clamp(38px, 5.2vw, 64px);
    font-weight: 800;
    line-height: 1.05;
    color: #FFFFFF;
    margin: 0 0 24px;
    letter-spacing: -0.5px;
  }

  .hp64-hero__title span {
    background: linear-gradient(135deg, #06B6D4 0%, #10B981 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    text-shadow: 0 0 30px rgba(6, 182, 212, 0.3);
  }

  .hp64-hero__desc {
    font-size: 16px;
    line-height: 1.8;
    color: #94A3B8;
    margin: 0 0 36px;
    max-width: 520px;
  }

  .hp64-hero__actions {
    display: flex;
    gap: 16px;
    align-items: center;
    flex-wrap: wrap;
  }

  .hp64-hero__btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 36px;
    background: var(--hp64-btn-bg);
    color: var(--hp64-btn-text);
    font-family: 'Space Grotesk', sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 4px;
    transition: all 0.35s ease;
    box-shadow: 0 0 25px rgba(6, 182, 212, 0.4);
  }

  .hp64-hero__btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 40px rgba(6, 182, 212, 0.7);
  }

  .hp64-hero__media {
    position: relative;
  }

  .hp64-hero__img-wrap {
    position: relative;
    border-radius: 8px;
    overflow: hidden;
    height: 520px;
    border: 1px solid rgba(6, 182, 212, 0.3);
    box-shadow: 0 25px 60px rgba(6, 182, 212, 0.15);
  }

  .hp64-hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
    filter: brightness(0.95) contrast(1.1);
  }

  .hp64-hero__img-wrap:hover .hp64-hero__img {
    transform: scale(1.04);
  }

  .hp64-hero__float-card {
    position: absolute;
    bottom: -16px;
    left: -16px;
    background: rgba(9, 13, 22, 0.92);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(6, 182, 212, 0.4);
    border-radius: 6px;
    padding: 16px 22px;
    display: flex;
    align-items: center;
    gap: 14px;
    box-shadow: 0 10px 30px rgba(6, 182, 212, 0.2);
  }

  .hp64-hero__float-icon {
    width: 42px;
    height: 42px;
    background: linear-gradient(135deg, #083344, #06B6D4);
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #FFFFFF;
    font-size: 18px;
    box-shadow: 0 0 15px rgba(6, 182, 212, 0.4);
  }

  .hp64-hero__float-label {
    font-family: 'Syne', sans-serif;
    font-size: 17px;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0;
  }

  .hp64-hero__float-sub {
    font-size: 11px;
    color: #06B6D4;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin: 2px 0 0;
  }

  @media screen and (max-width: 992px) {
    .hp64-hero__container { grid-template-columns: 1fr; text-align: center; gap: 40px; }
    .hp64-hero__desc { margin-left: auto; margin-right: auto; }
    .hp64-hero__actions { justify-content: center; }
    .hp64-hero__img-wrap { height: 380px; }
    .hp64-hero__float-card { left: 50%; transform: translateX(-50%); bottom: -16px; }
  }

  @media screen and (max-width: 480px) {
    .hp64-hero__img-wrap { height: 300px; }
  }
{%- endstyle -%}

<div class="hp64-hero__container">
  <div>
    <div class="hp64-hero__badge">
      <span>🧬</span>
      <span>{{ section.settings.badge | default: 'DEEP ABYSS BIOTECH v64' }}</span>
    </div>

    <h1 class="hp64-hero__title">
      Bio-Luminescent Spectrum & <span>Deep Sea Micro-Algae</span>
    </h1>

    <p class="hp64-hero__desc">
      {{ section.settings.description | default: 'Synthesized from benthic hydrothermal vents and photoluminescent oceanic dinoflagellates, activating mitochondrial cell energy and instant epidermal illumination.' }}
    </p>

    <div class="hp64-hero__actions">
      <a href="{{ section.settings.btn_url | default: '/collections/all' }}" class="hp64-hero__btn">
        <span>{{ section.settings.btn_text | default: 'Discover Deep Spectrum' }}</span>
        <span>&rarr;</span>
      </a>
    </div>
  </div>

  <div class="hp64-hero__media">
    <div class="hp64-hero__img-wrap">
      {%- if section.settings.image != blank -%}
        <img height="{{ section.settings.image.height }}" width="{{ section.settings.image.width }}" src="{{ section.settings.image | image_url: width: 1000 }}" class="hp64-hero__img" alt="{{ section.settings.heading }}" loading="eager">
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'hp64-hero__img' }}
      {%- endif -%}

      <div class="hp64-hero__float-card">
        <div class="hp64-hero__float-icon">🧬</div>
        <div>
          <p class="hp64-hero__float-label">Luciferin Complex 8X</p>
          <p class="hp64-hero__float-sub">Mitochondrial Bioluminescence</p>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "HP64 Hero",
  "class": "section-hp64-hero",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#090D16" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#FFFFFF" },
    { "type": "color", "id": "accent_mint", "label": "Mint Accent", "default": "#10B981" },
    { "type": "color", "id": "accent_cyan", "label": "Cyan Accent", "default": "#06B6D4" },
    { "type": "color", "id": "btn_bg", "label": "Button Background", "default": "#06B6D4" },
    { "type": "color", "id": "btn_text_color", "label": "Button Text Color", "default": "#030712" },
    { "type": "text", "id": "badge", "label": "Badge", "default": "DEEP ABYSS BIOTECH v64" },
    { "type": "textarea", "id": "heading", "label": "Heading (HTML allowed)", "default": "Bio-Luminescent Spectrum & <span>Deep Sea Micro-Algae</span>" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Synthesized from benthic hydrothermal vents and photoluminescent oceanic dinoflagellates." },
    { "type": "text", "id": "btn_text", "label": "Button Text", "default": "Discover Deep Spectrum" },
    { "type": "url", "id": "btn_url", "label": "Button URL" },
    { "type": "image_picker", "id": "image", "label": "Hero Image" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "presets": [{ "name": "HP64 Hero" }]
}
{% endschema %}
