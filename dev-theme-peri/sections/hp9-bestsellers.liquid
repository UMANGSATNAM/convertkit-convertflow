{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#050505'
  assign text_color = section.settings.text_color | default: '#ffffff'
  assign accent_color = section.settings.accent_color | default: '#00ff88'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 100px 20px;
    color: {{ text_color }};
    position: relative;
  }
  
  .hp9-bestsellers-container-{{ section_id }} {
    max-width: 1400px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }
  
  .hp9-bestsellers-header-{{ section_id }} {
    margin-bottom: 60px;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    border-bottom: 1px solid rgba(0, 255, 136, 0.2);
    padding-bottom: 20px;
  }
  
  .hp9-bestsellers-title-wrap-{{ section_id }} {
    max-width: 600px;
  }
  
  .hp9-bestsellers-subheading-{{ section_id }} {
    font-family: 'Space Mono', monospace;
    font-size: 0.9rem;
    font-weight: 700;
    color: {{ accent_color }};
    margin: 0 0 10px 0;
    letter-spacing: 2px;
    text-transform: uppercase;
  }
  
  .hp9-bestsellers-heading-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 900;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: -1px;
    line-height: 1.1;
  }
  
  .hp9-bestsellers-view-all-{{ section_id }} {
    font-family: 'Space Mono', monospace;
    font-size: 0.9rem;
    color: {{ text_color }};
    text-decoration: none;
    text-transform: uppercase;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 10px;
    transition: color 0.3s ease;
  }
  
  .hp9-bestsellers-view-all-{{ section_id }}:hover {
    color: {{ accent_color }};
  }
  
  .hp9-bestsellers-grid-{{ section_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 30px;
  }
  
  .hp9-product-card-{{ section_id }} {
    background: #0a0a0a;
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 4px;
    overflow: hidden;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    position: relative;
  }
  
  .hp9-product-card-{{ section_id }}:hover {
    border-color: {{ accent_color }};
    box-shadow: 0 0 20px rgba(0, 255, 136, 0.1);
    transform: translateY(-5px);
  }
  
  /* Glitch effect on hover */
  .hp9-product-card-{{ section_id }}::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 50%;
    height: 100%;
    background: linear-gradient(to right, transparent, rgba(0, 255, 136, 0.1), transparent);
    transform: skewX(-20deg);
    transition: all 0.5s ease;
    z-index: 10;
    pointer-events: none;
  }
  
  .hp9-product-card-{{ section_id }}:hover::before {
    left: 200%;
  }
  
  .hp9-product-image-wrap-{{ section_id }} {
    position: relative;
    padding-top: 100%; /* 1:1 Aspect Ratio */
    background: #111;
    overflow: hidden;
  }
  
  .hp9-product-image-{{ section_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(20%) contrast(1.2);
    transition: all 0.5s ease;
  }
  
  .hp9-product-card-{{ section_id }}:hover .hp9-product-image-{{ section_id }} {
    filter: grayscale(0%) contrast(1.1);
    transform: scale(1.05);
  }
  
  .hp9-product-badge-{{ section_id }} {
    position: absolute;
    top: 15px;
    left: 15px;
    background: {{ accent_color }};
    color: #000;
    font-family: 'Space Mono', monospace;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 5px 10px;
    text-transform: uppercase;
    z-index: 2;
  }
  
  .hp9-product-info-{{ section_id }} {
    padding: 20px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    position: relative;
    z-index: 2;
    background: #0a0a0a;
  }
  
  .hp9-product-title-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: 1.1rem;
    font-weight: 800;
    margin: 0 0 10px 0;
    text-transform: uppercase;
    line-height: 1.3;
  }
  
  .hp9-product-price-{{ section_id }} {
    font-family: 'Space Mono', monospace;
    font-size: 1.2rem;
    color: {{ accent_color }};
    font-weight: 700;
    margin-bottom: 20px;
  }
  
  .hp9-product-add-{{ section_id }} {
    margin-top: auto;
    background: transparent;
    border: 1px solid {{ accent_color }};
    color: {{ accent_color }};
    font-family: 'Space Mono', monospace;
    font-size: 0.8rem;
    font-weight: 700;
    padding: 12px;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.3s ease;
    text-align: center;
    text-decoration: none;
    display: block;
  }
  
  .hp9-product-add-{{ section_id }}:hover {
    background: {{ accent_color }};
    color: #000;
    box-shadow: 0 0 15px rgba(0, 255, 136, 0.4);
  }

  @media (max-width: 1024px) {
    .hp9-bestsellers-grid-{{ section_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  @media (max-width: 768px) {
    .hp9-bestsellers-header-{{ section_id }} {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }
    .hp9-bestsellers-grid-{{ section_id }} {
      gap: 15px;
    }
  }
  
  @media (max-width: 480px) {
    .hp9-bestsellers-grid-{{ section_id }} {
      grid-template-columns: 1fr;
    }
  }
</style>

<div class="hp9-bestsellers-container-{{ section_id }}">
  <div class="hp9-bestsellers-header-{{ section_id }}">
    <div class="hp9-bestsellers-title-wrap-{{ section_id }}">
      <p class="hp9-bestsellers-subheading-{{ section_id }}">{{ section.settings.subheading | default: '/// TOP_RATED_TECH' }}</p>
      <h2 class="hp9-bestsellers-heading-{{ section_id }}">{{ section.settings.heading | default: 'SYSTEM BESTSELLERS' }}</h2>
    </div>
    {% if section.settings.collection != blank %}
      <a href="{{ collections[section.settings.collection].url }}" class="hp9-bestsellers-view-all-{{ section_id }}">
        VIEW_ALL_DATA <span>_></span>
      </a>
    {% endif %}
  </div>
  
  <div class="hp9-bestsellers-grid-{{ section_id }}">
    {% assign collection = collections[section.settings.collection] %}
    {% if collection != blank %}
      {% for product in collection.products limit: section.settings.product_limit %}
        <div class="hp9-product-card-{{ section_id }}">
          {% if product.tags contains 'bestseller' or forloop.index <= 2 %}
            <div class="hp9-product-badge-{{ section_id }}">TOP_TIER</div>
          {% endif %}
          
          <a href="{{ product.url }}" class="hp9-product-image-wrap-{{ section_id }}">
            <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title }}" class="hp9-product-image-{{ section_id }}" loading="lazy">
          </a>
          
          <div class="hp9-product-info-{{ section_id }}">
            <a href="{{ product.url }}" style="text-decoration:none; color:inherit;">
              <h3 class="hp9-product-title-{{ section_id }}">{{ product.title }}</h3>
            </a>
            <div class="hp9-product-price-{{ section_id }}">
              {{ product.price | money }}
            </div>
            
            <a href="{{ product.url }}" class="hp9-product-add-{{ section_id }}">
              INITIATE_UPGRADE
            </a>
          </div>
        </div>
      {% endfor %}
    {% else %}
      {% for i in (1..4) %}
        <div class="hp9-product-card-{{ section_id }}">
          <div class="hp9-product-badge-{{ section_id }}">PROTOTYPE</div>
          <div class="hp9-product-image-wrap-{{ section_id }}">
            <div class="hp9-product-image-{{ section_id }}" style="background: #222; display:flex; align-items:center; justify-content:center; color:#555; font-family:monospace;">IMG_DATA_MISSING</div>
          </div>
          <div class="hp9-product-info-{{ section_id }}">
            <h3 class="hp9-product-title-{{ section_id }}">Neural Interface v{{ i }}.0</h3>
            <div class="hp9-product-price-{{ section_id }}">Rs. 4,999</div>
            <div class="hp9-product-add-{{ section_id }}">INITIATE_UPGRADE</div>
          </div>
        </div>
      {% endfor %}
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "HP9 Bestsellers",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#050505"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#00ff88"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "/// TOP_RATED_TECH"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "SYSTEM BESTSELLERS"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "product_limit",
      "min": 4,
      "max": 12,
      "step": 4,
      "label": "Product Limit",
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "HP9 Bestsellers"
    }
  ]
}
{% endschema %}
