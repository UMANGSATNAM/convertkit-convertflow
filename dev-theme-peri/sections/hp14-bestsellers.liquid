{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#ffe8d6'
  assign text_color = section.settings.text_color | default: '#6b705c'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 100px 40px;
  }
  
  .hp14-bestsellers-container-{{ section_id }} {
    max-width: 1400px;
    margin: 0 auto;
  }
  
  .hp14-bestsellers-header-{{ section_id }} {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 50px;
  }
  
  .hp14-bestsellers-heading-{{ section_id }} {
    font-family: 'Georgia', serif;
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: normal;
    color: {{ text_color }};
    margin: 0;
  }
  
  .hp14-bestsellers-heading-{{ section_id }} span {
    font-style: italic;
    color: #cb997e;
  }
  
  .hp14-bestsellers-link-{{ section_id }} {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #cb997e;
    text-decoration: none;
    border-bottom: 1px solid #cb997e;
    padding-bottom: 2px;
  }
  
  .hp14-bestsellers-grid-{{ section_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 40px;
  }
  
  .hp14-product-card-{{ section_id }} {
    display: block;
    text-decoration: none;
    text-align: center;
  }
  
  .hp14-product-image-wrap-{{ section_id }} {
    position: relative;
    padding-top: 120%;
    border-radius: 20px 20px 0 0;
    overflow: hidden;
    margin-bottom: 20px;
    background: #f4f1de;
  }
  
  .hp14-product-image-{{ section_id }} {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  
  .hp14-product-card-{{ section_id }}:hover .hp14-product-image-{{ section_id }} {
    transform: scale(1.05);
  }
  
  .hp14-product-badge-{{ section_id }} {
    position: absolute;
    top: 15px; left: 15px;
    background: #fff;
    color: #cb997e;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 5px 12px;
    border-radius: 20px;
  }
  
  .hp14-product-title-{{ section_id }} {
    font-family: 'Georgia', serif;
    font-size: 1.2rem;
    color: {{ text_color }};
    margin: 0 0 10px 0;
  }
  
  .hp14-product-price-{{ section_id }} {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 1rem;
    color: #a5a58d;
  }
  
  .hp14-product-btn-{{ section_id }} {
    display: inline-block;
    margin-top: 15px;
    padding: 10px 25px;
    border: 1px solid {{ text_color }};
    color: {{ text_color }};
    border-radius: 50px;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: all 0.3s ease;
  }
  
  .hp14-product-card-{{ section_id }}:hover .hp14-product-btn-{{ section_id }} {
    background: {{ text_color }};
    color: #fff;
  }

  @media (max-width: 992px) {
    .hp14-bestsellers-grid-{{ section_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: 30px;
    }
  }
  
  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 60px 20px;
    }
    .hp14-bestsellers-header-{{ section_id }} {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }
    .hp14-bestsellers-grid-{{ section_id }} {
      grid-template-columns: 1fr 1fr;
      gap: 15px;
    }
  }
</style>

<div class="hp14-bestsellers-container-{{ section_id }}">
  <div class="hp14-bestsellers-header-{{ section_id }}">
    <h2 class="hp14-bestsellers-heading-{{ section_id }}">Daily <span>Rituals</span></h2>
    <a href="{{ collections[section.settings.collection].url | default: '#' }}" class="hp14-bestsellers-link-{{ section_id }}">Shop All</a>
  </div>
  
  <div class="hp14-bestsellers-grid-{{ section_id }}">
    {% assign collection = collections[section.settings.collection] %}
    {% if collection != blank %}
      {% for product in collection.products limit: 4 %}
        <a href="{{ product.url }}" class="hp14-product-card-{{ section_id }}">
          <div class="hp14-product-image-wrap-{{ section_id }}">
            <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" width="600" height="600" class="hp14-product-image-{{ section_id }}" loading="lazy">
            {% if product.tags contains 'bestseller' or forloop.first %}
              <div class="hp14-product-badge-{{ section_id }}">Best Seller</div>
            {% endif %}
          </div>
          <h3 class="hp14-product-title-{{ section_id }}">{{ product.title }}</h3>
          <div class="hp14-product-price-{{ section_id }}">{{ product.price | money }}</div>
          <div class="hp14-product-btn-{{ section_id }}">Add to Cart</div>
        </a>
      {% endfor %}
    {% else %}
      {% for i in (1..4) %}
        <a href="#" class="hp14-product-card-{{ section_id }}">
          <div class="hp14-product-image-wrap-{{ section_id }}">
            <div class="hp14-product-image-{{ section_id }}" style="background: #e2e2e2;"></div>
            {% if i == 1 %}
              <div class="hp14-product-badge-{{ section_id }}">Best Seller</div>
            {% endif %}
          </div>
          <h3 class="hp14-product-title-{{ section_id }}">Botanical Serum</h3>
          <div class="hp14-product-price-{{ section_id }}">$48.00</div>
          <div class="hp14-product-btn-{{ section_id }}">Add to Cart</div>
        </a>
      {% endfor %}
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "HP14 Bestsellers",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffe8d6"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#6b705c"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    }
  ],
  "presets": [
    {
      "name": "HP14 Bestsellers"
    }
  ]
}
{% endschema %}
