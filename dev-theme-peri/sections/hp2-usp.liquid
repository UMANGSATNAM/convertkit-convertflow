{%- liquid
  assign bg_color = section.settings.bg_color | default: '#000000'
  assign text_color = section.settings.text_color | default: '#ffffff'
  assign border_color = section.settings.border_color | default: '#333333'
  assign speed = section.settings.animation_speed | default: 25
  assign direction = section.settings.animation_direction
  assign is_paused_on_hover = section.settings.pause_on_hover
  
  assign font_size_desktop = section.settings.font_size_desktop
  assign font_size_mobile = section.settings.font_size_mobile
  assign padding_y = section.settings.padding_y
  
  assign show_border_top = section.settings.show_border_top
  assign show_border_bottom = section.settings.show_border_bottom
-%}

<style>
  #shopify-section-{{ section.id }} {
    --hp2-usp-bg: {{ bg_color }};
    --hp2-usp-text: {{ text_color }};
    --hp2-usp-border: {{ border_color }};
    --hp2-usp-speed: {{ speed }}s;
    --hp2-usp-font-desk: {{ font_size_desktop }}px;
    --hp2-usp-font-mob: {{ font_size_mobile }}px;
    --hp2-usp-padding: {{ padding_y }}px;
  }

  .hp2-fashion-usp-{{ section.id }} {
    position: relative;
    background-color: var(--hp2-usp-bg);
    color: var(--hp2-usp-text);
    padding: var(--hp2-usp-padding) 0;
    overflow: hidden;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    width: 100%;
    {% if show_border_top %}border-top: 1px solid var(--hp2-usp-border);{% endif %}
    {% if show_border_bottom %}border-bottom: 1px solid var(--hp2-usp-border);{% endif %}
  }

  /* Screen Reader Only text for accessibility */
  .hp2-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }

  .hp2-usp-track-wrapper {
    display: flex;
    width: 100%;
    overflow: hidden;
    position: relative;
  }

  .hp2-usp-track {
    display: flex;
    white-space: nowrap;
    will-change: transform;
    {% if direction == 'left' %}
      animation: hp2UspMarqueeLeft var(--hp2-usp-speed) linear infinite;
    {% else %}
      animation: hp2UspMarqueeRight var(--hp2-usp-speed) linear infinite;
    {% endif %}
  }

  {% if is_paused_on_hover %}
    .hp2-fashion-usp-{{ section.id }}:hover .hp2-usp-track {
      animation-play-state: paused;
    }
  {% endif %}

  .hp2-usp-content {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    padding-right: 50px;
  }

  .hp2-usp-item {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-right: 60px;
    font-size: var(--hp2-usp-font-desk);
    font-weight: 700;
    letter-spacing: 2px;
    transition: opacity 0.3s ease;
  }

  .hp2-usp-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2em;
    line-height: 1;
  }

  .hp2-usp-text {
    line-height: 1;
    position: relative;
    top: 1px;
  }

  @keyframes hp2UspMarqueeLeft {
    0% { transform: translateX(0); }
    100% { transform: translateX(-100%); }
  }

  @keyframes hp2UspMarqueeRight {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(0); }
  }

  /* Responsive Adjustments */
  @media screen and (max-width: 768px) {
    .hp2-usp-item {
      font-size: var(--hp2-usp-font-mob);
      margin-right: 40px;
      letter-spacing: 1px;
    }
    .hp2-usp-content {
      padding-right: 30px;
    }
  }

  /* Accessibility respect */
  @media (prefers-reduced-motion: reduce) {
    .hp2-usp-track {
      animation: none !important;
      transform: none !important;
      flex-wrap: wrap;
      justify-content: center;
    }
    .hp2-usp-track-wrapper {
      overflow: visible;
      white-space: normal;
    }
    .hp2-usp-content {
      flex-wrap: wrap;
      justify-content: center;
      padding-right: 0;
    }
    .hp2-usp-content:not(:first-child) {
      display: none;
    }
    .hp2-usp-item {
      margin: 10px 20px;
    }
  }
</style>

<section class="hp2-fashion-usp-{{ section.id }}" aria-label="Store unique selling points">
  <span class="hp2-sr-only">Store unique selling points ticker</span>
  <div class="hp2-usp-track-wrapper">
    
    {%- capture usp_content -%}
      <div class="hp2-usp-content" aria-hidden="true">
        {%- for block in section.blocks -%}
          <div class="hp2-usp-item" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != blank -%}
              <span class="hp2-usp-icon">{{ block.settings.icon }}</span>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <span class="hp2-usp-text">{{ block.settings.text }}</span>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endcapture -%}

    {%- comment -%} Render the content multiple times to ensure seamless scrolling {%- endcomment -%}
    <div class="hp2-usp-track">
      {{ usp_content }}
      {{ usp_content }}
      {{ usp_content }}
      {{ usp_content }}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "HP2 USP Ticker (Advanced)",
  "tag": "section",
  "class": "section-hp2-usp",
  "settings": [
    {
      "type": "header",
      "content": "Design & Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#333333"
    },
    {
      "type": "checkbox",
      "id": "show_border_top",
      "label": "Show Top Border",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_border_bottom",
      "label": "Show Bottom Border",
      "default": true
    },
    {
      "type": "header",
      "content": "Typography & Spacing"
    },
    {
      "type": "range",
      "id": "font_size_desktop",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Desktop Font Size",
      "default": 13
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Mobile Font Size",
      "default": 11
    },
    {
      "type": "range",
      "id": "padding_y",
      "min": 5,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Vertical Padding",
      "default": 16
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "range",
      "id": "animation_speed",
      "min": 10,
      "max": 60,
      "step": 1,
      "unit": "sec",
      "label": "Scroll Speed",
      "info": "Lower is faster.",
      "default": 25
    },
    {
      "type": "select",
      "id": "animation_direction",
      "label": "Scroll Direction",
      "options": [
        { "value": "left", "label": "Right to Left" },
        { "value": "right", "label": "Left to Right" }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "usp",
      "name": "USP Item",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (Emoji or Text)",
          "default": "⚡",
          "info": "You can paste an emoji here or leave it blank."
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "FREE SHIPPING WORLDWIDE"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP2 USP Ticker (Advanced)",
      "blocks": [
        { "type": "usp", "settings": { "text": "FREE SHIPPING ON ORDERS $150+", "icon": "⚡" } },
        { "type": "usp", "settings": { "text": "EASY 30-DAY RETURNS", "icon": "↺" } },
        { "type": "usp", "settings": { "text": "MADE WITH SUSTAINABLE FABRICS", "icon": "♻" } },
        { "type": "usp", "settings": { "text": "SAME DAY DISPATCH BEFORE 2PM", "icon": "📦" } }
      ]
    }
  ]
}
{% endschema %}
