{% comment %} CL V62 — Hiking / Outdoors (Forest/Topographical) {% endcomment %}
{{ 'component-facets.css' | asset_url | stylesheet_tag }}
<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
<style>
  .clv62 { background: {{ section.settings.bg_color | default: '#F2F4F0' }}; color: {{ section.settings.text_color | default: '#2E3B32' }}; padding: 40px 20px; font-family: 'Oswald', 'Helvetica', sans-serif; text-transform: uppercase; }
  .clv62-hero { text-align: center; margin-bottom: 40px; padding: 70px 20px; background: #2E3B32; color: #FFF; position: relative; overflow: hidden; }
  .clv62-hero::before { content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 100%; background-image: radial-gradient(#475C4D 1px, transparent 1px); background-size: 20px 20px; opacity: 0.3; }
  .clv62-hero h1 { font-size: 56px; font-weight: 700; margin-bottom: 10px; position: relative; z-index: 1; letter-spacing: 2px; }
  .clv62-hero p { font-size: 16px; color: #A4B8A9; max-width: 600px; margin: 0 auto; position: relative; z-index: 1; font-family: 'Helvetica', sans-serif; text-transform: none; }
  .clv62-chips { display: flex; gap: 15px; justify-content: center; margin-bottom: 40px; flex-wrap: wrap; }
  .clv62-chips a { padding: 12px 25px; background: transparent; color: #2E3B32; text-decoration: none; font-size: 14px; font-weight: 700; border: 2px solid #2E3B32; transition: 0.3s; }
  .clv62-chips a:hover, .clv62-chips a.active { background: #2E3B32; color: #FFF; }
  .clv62-toolbar { background: transparent; border-top: 2px solid #2E3B32; border-bottom: 2px solid #2E3B32; padding: 15px 0; margin-bottom: 40px; display: flex; justify-content: space-between; align-items: center; }
  .clv62-grid { display: grid; grid-template-columns: repeat({{ section.settings.cols_desktop | default: 4 }}, 1fr); gap: 25px; }
  .clv62-promo { grid-column: span 1; background: #C5533B; color: #FFF; padding: 40px; text-align: center; display: flex; flex-direction: column; justify-content: center; align-items: center; position: relative; }
  .clv62-promo::after { content: '▲'; position: absolute; font-size: 150px; opacity: 0.1; bottom: -40px; right: -20px; }
  .clv62-promo h3 { font-size: 32px; font-weight: 700; margin-bottom: 20px; z-index: 1; line-height: 1.2; }
  .clv62-promo a { display: inline-block; padding: 10px 25px; background: #FFF; color: #C5533B; text-decoration: none; font-weight: 700; font-size: 14px; z-index: 1; }
  .clv62-promo a:hover { background: #2E3B32; color: #FFF; }
  .clv62-seo { margin-top: 60px; background: #2E3B32; color: #FFF; padding: 50px; text-align: center; }
  @media (max-width: 768px) { .clv62-grid { grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr); gap: 15px; } .clv62-hero h1 { font-size: 42px; } }
</style>
<div class="clv62" style="max-width: 1300px; margin: 0 auto;">
  <div class="clv62-hero">
    <h1>{% if collection.title != blank %}{{ collection.title | escape }}{% else %}BASE CAMP{% endif %}</h1>
    <p>{% if collection.description != blank %}{{ collection.description }}{% else %}Gear up for the summit. Rugged, reliable, and ready.{% endif %}</p>
  </div>
  {% if section.settings.sub_collections != blank %}
    <div class="clv62-chips">
      {% for link in section.settings.sub_collections.links %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% endfor %}
    </div>
  {% endif %}
  <div class="clv62-toolbar">
    <facet-filters-form style="width: 100%;">
      <form id="FacetFiltersForm" style="display: flex; justify-content: space-between; align-items: center; width: 100%; flex-wrap: wrap; gap: 20px;">
        <div style="display: flex; gap: 30px;">
          {%- for filter in collection.filters -%}
            <details style="position: relative;">
              <summary style="cursor: pointer; font-size: 16px; font-weight: 700; color: #2E3B32; letter-spacing: 1px;">{{ filter.label }} +</summary>
              <div style="position: absolute; background: #F2F4F0; border: 2px solid #2E3B32; padding: 20px; z-index: 10; margin-top: 15px; min-width: 220px; box-shadow: 6px 6px 0 #2E3B32;">
                {%- for value in filter.values -%}
                  <label style="display: block; margin-bottom: 12px; cursor: pointer; font-size: 14px; color: #2E3B32; font-family: 'Helvetica', sans-serif; text-transform: none;">
                    <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} style="accent-color: #2E3B32;">
                    {{ value.label }} ({{ value.count }})
                  </label>
                {%- endfor -%}
              </div>
            </details>
          {%- endfor -%}
        </div>
        <select name="sort_by" onchange="this.form.submit()" style="background: transparent; border: none; font-family: 'Oswald', sans-serif; font-size: 16px; font-weight: 700; color: #2E3B32; cursor: pointer; outline: none; text-transform: uppercase;">
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>
          {%- endfor -%}
        </select>
      </form>
    </facet-filters-form>
  </div>
  {% assign limit_num = section.settings.products_per_page | default: 16 %}
  {% paginate collection.products by limit_num %}
    <div class="clv62-grid">
      {% for product in collection.products %}
        {% render 'card-v62', product: product %}
        {% if forloop.index == 8 and section.settings.show_promo_tile %}
          <div class="clv62-promo">
            <h3>TRAIL<br>TESTED</h3>
            <a href="/pages/about-us">OUR STORY</a>
          </div>
        {% endif %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v62', product: nil %}
        {% endfor %}
      {% endfor %}
    </div>
    <div style="margin-top: 50px; text-align: center; font-size: 24px; font-weight: 700; color: #2E3B32;">{{ paginate | default_pagination }}</div>
  {% endpaginate %}
  {% if section.settings.show_seo_block %}
    <div class="clv62-seo">
      <h2 style="font-size: 32px; font-weight: 700; margin-bottom: 15px; letter-spacing: 2px;">{{ section.settings.seo_title | default: 'BUILT FOR THE WILD' }}</h2>
      <p style="font-size: 16px; font-family: 'Helvetica', sans-serif; color: #A4B8A9; max-width: 700px; margin: 0 auto; line-height: 1.6; text-transform: none;">{{ section.settings.seo_text | default: 'Tested in extreme conditions to guarantee durability. Our gear is designed to outlast the elements so you can push further.' }}</p>
    </div>
  {% endif %}
</div>
{% schema %}
{
  "name": "CL V62 — Outdoors", "settings": [
    {"type": "range", "id": "products_per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 16},
    {"type": "range", "id": "cols_desktop", "label": "Desktop Columns", "min": 2, "max": 5, "default": 4},
    {"type": "select", "id": "cols_mobile", "label": "Mobile Columns", "options": [{"value": "1", "label": "1"}, {"value": "2", "label": "2"}], "default": "2"},
    {"type": "link_list", "id": "sub_collections", "label": "Sub-Collection Menu"},
    {"type": "checkbox", "id": "show_promo_tile", "label": "Show Promo Card", "default": true},
    {"type": "checkbox", "id": "show_seo_block", "label": "Show SEO Block", "default": true},
    {"type": "color", "id": "bg_color", "label": "Background Color", "default": "#F2F4F0"},
    {"type": "color", "id": "text_color", "label": "Text Color", "default": "#2E3B32"}
  ], "presets": [{"name": "CL V62 — Outdoors"}]
}
{% endschema %}
