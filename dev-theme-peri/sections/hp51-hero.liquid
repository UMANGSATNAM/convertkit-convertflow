{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Noto+Serif+JP:wght@400;600;700;900&display=swap');

  #shopify-section-{{ section.id }} {
    --hp51-bg: {{ section.settings.bg_color | default: '#F2EFE9' }};
    --hp51-text: {{ section.settings.text_color | default: '#1E3A2B' }};
    --hp51-matcha: {{ section.settings.accent_matcha | default: '#2D5A3D' }};
    --hp51-card-bg: {{ section.settings.card_bg | default: '#FAF8F5' }};
    --hp51-btn-bg: {{ section.settings.btn_bg | default: '#1E3A2B' }};
    --hp51-btn-text-color: {{ section.settings.btn_text_color | default: '#FAF8F5' }};
    
    background-color: var(--hp51-bg);
    color: var(--hp51-text);
    font-family: 'DM Sans', sans-serif;
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
    position: relative;
    overflow: hidden;
  }

  .hp51-hero__container {
    max-width: {{ section.settings.container_width | default: 1280 }}px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 60px;
    align-items: center;
  }

  .hp51-hero__zen-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 20px;
    background: #E3DDD3;
    border-radius: 50px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--hp51-text);
    margin-bottom: 24px;
  }

  .hp51-hero__title {
    font-family: 'Noto Serif JP', serif;
    font-size: clamp(38px, 5.5vw, 62px);
    font-weight: 700;
    line-height: 1.12;
    color: var(--hp51-text);
    margin: 0 0 22px;
  }

  .hp51-hero__title em {
    font-style: normal;
    color: var(--hp51-matcha);
    border-bottom: 2px solid var(--hp51-matcha);
  }

  .hp51-hero__desc {
    font-size: 16px;
    line-height: 1.8;
    color: #4A5B50;
    margin: 0 0 36px;
    max-width: 520px;
  }

  .hp51-hero__actions {
    display: flex;
    gap: 16px;
    align-items: center;
    flex-wrap: wrap;
  }

  .hp51-hero__btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 36px;
    background: var(--hp51-btn-bg);
    color: var(--hp51-btn-text-color);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 50px;
    box-shadow: 0 10px 25px rgba(30, 58, 43, 0.15);
    transition: all 0.3s ease;
  }

  .hp51-hero__btn-primary:hover {
    background: var(--hp51-matcha);
    transform: translateY(-2px);
  }

  .hp51-hero__media-frame {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    background: #E3DDD3;
    box-shadow: 0 25px 60px rgba(30, 58, 43, 0.1);
    height: 520px;
    border: 1px solid rgba(30, 58, 43, 0.15);
  }

  .hp51-hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hp51-hero__floating-card {
    position: absolute;
    bottom: 24px;
    left: 24px;
    right: 24px;
    background: rgba(250, 248, 245, 0.94);
    backdrop-filter: blur(12px);
    border-radius: 16px;
    padding: 16px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border: 1px solid rgba(30, 58, 43, 0.1);
  }

  .hp51-hero__float-title {
    font-family: 'Noto Serif JP', serif;
    font-size: 16px;
    font-weight: 700;
    color: var(--hp51-text);
    margin: 0;
  }

  .hp51-hero__float-sub {
    font-size: 11px;
    color: var(--hp51-matcha);
    margin: 0;
  }

  @media screen and (max-width: 992px) {
    .hp51-hero__container { grid-template-columns: 1fr; text-align: center; }
    .hp51-hero__desc { margin-left: auto; margin-right: auto; }
    .hp51-hero__actions { justify-content: center; }
    .hp51-hero__media-frame { height: 380px; }
  }
{%- endstyle -%}

<div class="hp51-hero__container">
  <div>
    <div class="hp51-hero__zen-tag">
      <span>🍵</span>
      <span>{{ section.settings.badge | default: 'KYOTO MATCHA ZEN ATELIER v51' }}</span>
    </div>

    <h1 class="hp51-hero__title">
      {{ section.settings.heading | default: 'Ceremonial Matcha & <em>Bamboo Water</em> Serenity' }}
    </h1>

    <p class="hp51-hero__desc">
      {{ section.settings.description | default: 'Shade-grown Uji ceremonial matcha rich in epigallocatechin gallate (EGCG) combined with soothing Japanese bamboo sap to calm inflammation.' }}
    </p>

    <div class="hp51-hero__actions">
      <a href="{{ section.settings.btn_url | default: '/collections/all' }}" class="hp51-hero__btn-primary">
        <span>{{ section.settings.btn_text | default: 'Discover Zen Collection' }}</span>
        <span>&rarr;</span>
      </a>
    </div>
  </div>

  <div class="hp51-hero__media-frame">
    {%- if section.settings.image != blank -%}
      <img height="{{ section.settings.image.height }}" width="{{ section.settings.image.width }}" src="{{ section.settings.image | image_url: width: 1000 }}" class="hp51-hero__img" alt="{{ section.settings.heading }}" loading="eager">
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'hp51-hero__img' }}
    {%- endif -%}

    <div class="hp51-hero__floating-card">
      <div>
        <p class="hp51-hero__float-title">Uji Ceremonial Matcha &amp; Bamboo</p>
        <p class="hp51-hero__float-sub">Kyoto Shade-Grown Harvest</p>
      </div>
      <span>🍵</span>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "HP51 - Zen Hero",
  "class": "section-hp51-hero",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#F2EFE9" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#1E3A2B" },
    { "type": "color", "id": "accent_matcha", "label": "Matcha Accent", "default": "#2D5A3D" },
    { "type": "color", "id": "btn_bg", "label": "Button Background", "default": "#1E3A2B" },
    { "type": "color", "id": "btn_text_color", "label": "Button Text Color", "default": "#FAF8F5" },
    { "type": "text", "id": "badge", "label": "Badge", "default": "KYOTO MATCHA ZEN ATELIER v51" },
    { "type": "textarea", "id": "heading", "label": "Heading (HTML allowed)", "default": "Ceremonial Matcha & <em>Bamboo Water</em> Serenity" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Shade-grown Uji ceremonial matcha rich in EGCG combined with soothing Japanese bamboo sap." },
    { "type": "text", "id": "btn_text", "label": "Button Text", "default": "Discover Zen Collection" },
    { "type": "url", "id": "btn_url", "label": "Button URL" },
    { "type": "image_picker", "id": "image", "label": "Hero Image" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "presets": [
    { "name": "HP51 - Zen Hero" }
  ]
}
{% endschema %}
