{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Montserrat:wght@300;400;500&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --gold-color: {{ section.settings.gold_color }};
    
    --font-heading: 'Playfair Display', serif;
    --font-body: 'Montserrat', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    border-bottom: 1px solid rgba(212, 175, 55, 0.2);
  }

  .hp33-insta-wrapper {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp33-insta-wrapper {
      padding: 0 20px;
    }
  }

  .hp33-insta__header {
    text-align: center;
    margin-bottom: 50px;
  }

  .hp33-insta__subtitle {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    color: var(--gold-color);
    text-transform: uppercase;
    letter-spacing: 4px;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 15px;
  }

  .hp33-insta__subtitle::before,
  .hp33-insta__subtitle::after {
    content: '';
    height: 1px;
    width: 30px;
    background: var(--gold-color);
  }

  .hp33-insta__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    line-height: 1.1;
    color: var(--text-color);
    margin: 0;
    font-weight: 400;
  }

  .hp33-insta__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: 20px;
  }

  @media screen and (max-width: 992px) {
    .hp33-insta__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media screen and (max-width: 768px) {
    .hp33-insta__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }
  }

  .hp33-insta__item {
    position: relative;
    aspect-ratio: 1/1;
    overflow: hidden;
    display: block;
    group: card;
  }

  .hp33-insta__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s ease;
  }

  .hp33-insta__overlay {
    position: absolute;
    top: 10px; left: 10px; right: 10px; bottom: 10px;
    background: rgba(14, 26, 20, 0.8);
    border: 1px solid var(--gold-color);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: all 0.4s ease;
    transform: scale(0.95);
  }

  .hp33-insta__item:hover .hp33-insta__image {
    transform: scale(1.1);
  }

  .hp33-insta__item:hover .hp33-insta__overlay {
    opacity: 1;
    transform: scale(1);
  }

  .hp33-insta__icon {
    width: 30px;
    height: 30px;
    fill: var(--gold-color);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp33-insta-wrapper" id="HP33Insta-{{ section.id }}">
  <div class="hp33-insta__header">
    {%- if section.settings.subtitle != blank -%}
      <div class="hp33-insta__subtitle">{{ section.settings.subtitle }}</div>
    {%- endif -%}
    <h2 class="hp33-insta__title">{{ section.settings.title }}</h2>
  </div>

  <div class="hp33-insta__grid">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.link | default: '#' }}" class="hp33-insta__item" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          <img height="{{ block.settings.image.height }}" width="{{ block.settings.image.width }}" src="{{ block.settings.image | image_url: width: 600 }}" alt="Instagram image" class="hp33-insta__image" loading="lazy">
        {%- else -%}
          {%- assign placeholder = 'collection-' | append: forloop.index -%}
          {%- if forloop.index > 6 -%}{%- assign placeholder = 'collection-1' -%}{%- endif -%}
          {{ placeholder | placeholder_svg_tag: 'hp33-insta__image' }}
        {%- endif -%}
        
        <div class="hp33-insta__overlay">
          <svg class="hp33-insta__icon" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
          </svg>
        </div>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "HP33 - Deco Instagram",
  "class": "section-hp33-instagram",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "THE SOCIAL DIARY"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Follow Our Journey"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 3,
      "max": 6,
      "step": 1,
      "label": "Columns (Desktop)",
      "default": 4
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 48
    },
    {
      "type": "header",
      "content": "Deco Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (e.g. Deep Emerald)",
      "default": "#0e1a14"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "gold_color",
      "label": "Gold Accent",
      "default": "#d4af37"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Instagram Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Post Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP33 - Deco Instagram",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
