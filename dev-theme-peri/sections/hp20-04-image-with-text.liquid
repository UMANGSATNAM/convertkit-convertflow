{%- liquid
  assign sec_id = section.id
-%}

<style>
  #shopify-section-{{ sec_id }} {
    background-color: {{ section.settings.bg_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px 0;
  }

  .hp20-iwt-{{ sec_id }} {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    flex-direction: {% if section.settings.layout == 'image_first' %}row{% else %}row-reverse{% endif %};
    align-items: center;
    gap: 0;
  }

  .hp20-iwt-{{ sec_id }}__media {
    width: 60%;
    position: relative;
    z-index: 1;
  }

  .hp20-iwt-{{ sec_id }}__img-wrapper {
    position: relative;
    padding-top: 130%;
    overflow: hidden;
  }

  .hp20-iwt-{{ sec_id }}__img {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover;
  }

  .hp20-iwt-{{ sec_id }}__content {
    width: 50%;
    background-color: {{ section.settings.content_bg }};
    padding: 80px 60px;
    position: relative;
    z-index: 2;
    {% if section.settings.layout == 'image_first' %}
      margin-left: -10%;
    {% else %}
      margin-right: -10%;
    {% endif %}
    box-shadow: 0 30px 60px rgba(0,0,0,0.05);
  }

  .hp20-iwt-{{ sec_id }}__label {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: {{ section.settings.text_color }};
    margin-bottom: 24px;
    display: block;
    opacity: 0.6;
  }

  .hp20-iwt-{{ sec_id }}__title {
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-size: clamp(32px, 4vw, 56px);
    font-weight: 300;
    line-height: 1.1;
    color: {{ section.settings.text_color }};
    margin: 0 0 32px 0;
    letter-spacing: -0.02em;
  }

  .hp20-iwt-{{ sec_id }}__text {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 16px;
    line-height: 1.7;
    color: {{ section.settings.text_color }};
    opacity: 0.8;
    margin: 0 0 40px 0;
  }

  .hp20-iwt-{{ sec_id }}__btn {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: {{ section.settings.text_color }};
    text-decoration: none;
    padding-bottom: 8px;
    border-bottom: 1px solid {{ section.settings.text_color }};
    display: inline-block;
    transition: opacity 0.3s ease;
  }

  .hp20-iwt-{{ sec_id }}__btn:hover {
    opacity: 0.6;
  }

  @media screen and (max-width: 990px) {
    .hp20-iwt-{{ sec_id }} {
      flex-direction: column;
      gap: 40px;
    }
    .hp20-iwt-{{ sec_id }}__media,
    .hp20-iwt-{{ sec_id }}__content {
      width: 100%;
      margin: 0;
    }
    .hp20-iwt-{{ sec_id }}__content {
      padding: 40px;
      box-shadow: none;
      background-color: transparent;
    }
    .hp20-iwt-{{ sec_id }}__img-wrapper {
      padding-top: 100%;
    }
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ sec_id }} {
      padding: {{ section.settings.padding_top_mobile }}px 0 {{ section.settings.padding_bottom_mobile }}px 0;
    }
    .hp20-iwt-{{ sec_id }}__content {
      padding: 0;
    }
  }
</style>

<section class="hp20-iwt-{{ sec_id }}">
  <div class="hp20-iwt-{{ sec_id }}__media">
    <div class="hp20-iwt-{{ sec_id }}__img-wrapper">
      {% if section.settings.image != blank %}
        <img height="{{ section.settings.image.height }}" width="{{ section.settings.image.width }}" src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.title | escape }}" class="hp20-iwt-{{ sec_id }}__img" loading="lazy">
      {% else %}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'hp20-iwt-sec_id__img' | replace: 'hp20-iwt-sec_id__img', 'hp20-iwt-' | append: sec_id | append: '__img' }}
      {% endif %}
    </div>
  </div>
  
  <div class="hp20-iwt-{{ sec_id }}__content">
    {% if section.settings.label != blank %}
      <span class="hp20-iwt-{{ sec_id }}__label">{{ section.settings.label }}</span>
    {% endif %}
    
    {% if section.settings.title != blank %}
      <h2 class="hp20-iwt-{{ sec_id }}__title">{{ section.settings.title }}</h2>
    {% endif %}
    
    {% if section.settings.text != blank %}
      <div class="hp20-iwt-{{ sec_id }}__text">{{ section.settings.text }}</div>
    {% endif %}
    
    {% if section.settings.btn_label != blank and section.settings.btn_link != blank %}
      <a href="{{ section.settings.btn_link }}" class="hp20-iwt-{{ sec_id }}__btn">{{ section.settings.btn_label }}</a>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "HP20 Overlap Text",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Desktop Layout",
      "options": [
        { "value": "image_first", "label": "Image First" },
        { "value": "text_first", "label": "Text First" }
      ],
      "default": "image_first"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "content_bg",
      "label": "Content Box Background",
      "default": "#f4f4f4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1a1a1a"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Craftsmanship"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Redefining Form & Function"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Every detail is considered. Every line serves a purpose. We strip away the unnecessary to reveal the essential."
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "Discover Our Process"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link",
      "default": "/pages/about"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0, "max": 160, "step": 10, "unit": "px",
      "label": "Desktop Top Padding", "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0, "max": 160, "step": 10, "unit": "px",
      "label": "Desktop Bottom Padding", "default": 120
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0, "max": 100, "step": 10, "unit": "px",
      "label": "Mobile Top Padding", "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0, "max": 100, "step": 10, "unit": "px",
      "label": "Mobile Bottom Padding", "default": 60
    }
  ],
  "presets": [
    {
      "name": "HP20 Overlap Text"
    }
  ]
}
{% endschema %}
