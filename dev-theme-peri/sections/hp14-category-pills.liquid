{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#ffe8d6'
  assign text_color = section.settings.text_color | default: '#6b705c'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 80px 40px;
  }
  
  .hp14-pills-container-{{ section_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }
  
  .hp14-pills-heading-{{ section_id }} {
    font-family: 'Georgia', serif;
    font-size: 2.5rem;
    font-weight: normal;
    text-align: center;
    color: {{ text_color }};
    margin: 0 0 40px 0;
  }
  
  .hp14-pills-grid-{{ section_id }} {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 20px;
  }
  
  .hp14-pill-{{ section_id }} {
    display: flex;
    align-items: center;
    gap: 15px;
    padding: 10px 30px 10px 10px;
    background: #fff;
    border-radius: 50px;
    text-decoration: none;
    box-shadow: 0 5px 15px rgba(0,0,0,0.05);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  
  .hp14-pill-{{ section_id }}:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 25px rgba(0,0,0,0.08);
  }
  
  .hp14-pill-image-{{ section_id }} {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    object-fit: cover;
  }
  
  .hp14-pill-title-{{ section_id }} {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 1rem;
    color: {{ text_color }};
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 60px 20px;
    }
  }
</style>

<div class="hp14-pills-container-{{ section_id }}">
  {% if section.settings.heading != blank %}
    <h2 class="hp14-pills-heading-{{ section_id }}">{{ section.settings.heading }}</h2>
  {% endif %}
  
  <div class="hp14-pills-grid-{{ section_id }}">
    {% for block in section.blocks %}
      <a href="{{ block.settings.link | default: '#' }}" class="hp14-pill-{{ section_id }}" {{ block.shopify_attributes }}>
        {% if block.settings.image != blank %}
          <img src="{{ block.settings.image | image_url: width: 100, height: 100, crop: 'center' }}" alt="{{ block.settings.title | default: block.settings.image.alt | escape }}" width="100" height="100" loading="lazy" class="hp14-pill-image-{{ section_id }}">
        {% else %}
          <div class="hp14-pill-image-{{ section_id }}" style="background: #e2e2e2;"></div>
        {% endif %}
        <span class="hp14-pill-title-{{ section_id }}">{{ block.settings.title | default: 'Category' }}</span>
      </a>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "HP14 Category Pills",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffe8d6"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#6b705c"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by category"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Category"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP14 Category Pills",
      "blocks": [
        { "type": "category", "settings": { "title": "Skincare" } },
        { "type": "category", "settings": { "title": "Bodycare" } },
        { "type": "category", "settings": { "title": "Haircare" } },
        { "type": "category", "settings": { "title": "Wellness" } }
      ]
    }
  ]
}
{% endschema %}
