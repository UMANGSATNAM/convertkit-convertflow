{%- style -%}
@import url('https://fonts.googleapis.com/css2?family=Anton&family=Space+Mono&display=swap');
#shopify-section-{{ section.id }}{border-top:6px solid #E11D48;border-bottom:6px solid #111}
.hp62-grid{max-width:1280px;margin:0 auto;display:grid;grid-template-columns:1.1fr .9fr;min-height:520px}
.hp62-left{padding:40px 24px;border-right:6px solid #111}
.hp62-h{font-family:'Anton',sans-serif;font-size:clamp(42px,6vw,74px);text-transform:uppercase}
.hp62-h span{color:#E11D48}
@media(max-width:900px){.hp62-grid{grid-template-columns:1fr}}
{%- endstyle -%}
<div class="hp62-grid"><div class="hp62-left"><h1 class="hp62-h">{{section.settings.heading|default:'RAW <span>STREETWEAR</span>'}}</h1><p>{{section.settings.description|default:'Heavyweight cotton, utility cuts'}}</p><a href="{{section.settings.btn_url|default:'/collections/all'}}" style="background:#E11D48;padding:12px 20px;text-decoration:none;font-weight:700">{{section.settings.btn_text|default:'Shop'}}</a></div><div>{% if section.settings.image != blank %}<img src="{{section.settings.image|image_url:width:1000}}" style="width:100%;height:520px;object-fit:cover">{% else %}{{'product-1'|placeholder_svg_tag}}{% endif %}</div></div>
{% schema %}{"name":"HP62 Hero Brutalist","settings":[{"type":"textarea","id":"heading","label":"Heading","default":"RAW streetwear"},{"type":"textarea","id":"description","label":"Desc","default":"Heavyweight cotton, utility cuts"},{"type":"text","id":"btn_text","label":"CTA","default":"Shop"},{"type":"url","id":"btn_url","label":"Link"},{"type":"image_picker","id":"image","label":"Image"}],"presets":[{"name":"HP62 Hero Brutalist"}]}{% endschema %}