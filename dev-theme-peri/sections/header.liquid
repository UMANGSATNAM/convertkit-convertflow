<style>
@media screen and (max-width: 768px) {
  .header {
    padding-left: 16px !important;
    padding-right: 16px !important;
    box-sizing: border-box !important;
  }
  img {
    max-width: 100% !important;
    height: auto !important;
  }
}
</style>
<header class="sf-header" style="padding: 1rem; text-align: center; border-bottom: 1px solid #000;">
  <h1>{{ shop.name }}</h1>
  <nav>
    {% for link in linklists.main-menu.links %}
      <a href="{{ link.url }}" style="margin: 0 0.5rem;">{{ link.title }}</a>
    {% endfor %}
    {% render 'search-bar', compact: true %}
    {% render 'wishlist-icon' %}
    <a href="{{ routes.cart_url }}" data-cart-open style="margin: 0 0.5rem;">Cart ({{ cart.item_count }})</a>
  </nav>
</header>

{% schema %}
{
  "name": "Header",
  "settings": []
}
{% endschema %}
