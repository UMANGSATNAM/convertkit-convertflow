{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;700&family=JetBrains+Mono:wght@400;700&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --grid-color: rgba(255, 255, 255, 0.1);
    
    --font-heading: 'Inter', sans-serif;
    --font-body: 'JetBrains Mono', monospace;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    border-bottom: 1px solid var(--grid-color);
  }

  .hp34-testi-wrapper {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp34-testi-wrapper {
      padding: 0 20px;
    }
  }

  .hp34-testi__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 40px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--grid-color);
  }

  .hp34-testi__subtitle {
    font-family: var(--font-body);
    font-size: 11px;
    color: var(--accent-color);
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 10px;
  }

  .hp34-testi__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    line-height: 1;
    color: var(--text-color);
    margin: 0;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }

  .hp34-testi__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--grid-color);
    border: 1px solid var(--grid-color);
  }

  @media screen and (max-width: 992px) {
    .hp34-testi__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 576px) {
    .hp34-testi__grid {
      grid-template-columns: 1fr;
    }
  }

  .hp34-testi__item {
    background: var(--bg-color);
    padding: 40px;
    font-family: var(--font-body);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .hp34-testi__meta {
    font-size: 10px;
    color: var(--accent-color);
    margin-bottom: 20px;
    display: flex;
    justify-content: space-between;
  }

  .hp34-testi__content {
    font-family: var(--font-heading);
    font-size: 18px;
    line-height: 1.5;
    color: var(--text-color);
    margin-bottom: 30px;
    font-weight: 400;
  }

  .hp34-testi__author {
    font-size: 12px;
    color: var(--text-color);
    border-top: 1px dashed var(--grid-color);
    padding-top: 15px;
    opacity: 0.8;
  }

  .hp34-testi__author span {
    color: var(--accent-color);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp34-testi-wrapper" id="HP34Testi-{{ section.id }}">
  <div class="hp34-testi__header">
    <div>
      {%- if section.settings.subtitle != blank -%}
        <div class="hp34-testi__subtitle">{{ section.settings.subtitle }}</div>
      {%- endif -%}
      <h2 class="hp34-testi__title">{{ section.settings.title }}</h2>
    </div>
  </div>

  <div class="hp34-testi__grid">
    {%- for block in section.blocks -%}
      <div class="hp34-testi__item" {{ block.shopify_attributes }}>
        <div class="hp34-testi__meta">
          <span>LOG: 00{{ forloop.index }}</span>
          <span>{{ block.settings.rating | default: 'RATING: 5/5' }}</span>
        </div>
        <div class="hp34-testi__content">
          "{{ block.settings.text }}"
        </div>
        <div class="hp34-testi__author">
          USR: <span>{{ block.settings.author }}</span>
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "HP34 - Tech Testimonials",
  "class": "section-hp34-testimonials",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "DATA.FEEDBACK"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "User Logs"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 40
    },
    {
      "type": "header",
      "content": "Tech Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (e.g. Black)",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#FF4500"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "The modularity of the system is unparalleled. Adapts to any environment immediately."
        },
        {
          "type": "text",
          "id": "rating",
          "label": "Rating label",
          "default": "RATING: 5/5"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "J. DOE"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP34 - Tech Testimonials",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" }
      ]
    }
  ]
}
{% endschema %}
