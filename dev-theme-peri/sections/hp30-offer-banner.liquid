{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Oswald:wght@700&family=Space+Grotesk:wght@400;700&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --border-color: {{ section.settings.border_color }};
    
    --font-heading: 'Oswald', sans-serif;
    --font-body: 'Space Grotesk', sans-serif;
    
    background-color: var(--bg-color);
    border-bottom: 4px solid var(--border-color);
  }

  .hp30-offer-wrapper {
    max-width: 1800px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr auto;
    border-left: 4px solid var(--border-color);
    border-right: 4px solid var(--border-color);
  }

  @media screen and (max-width: 992px) {
    .hp30-offer-wrapper {
      grid-template-columns: 1fr;
    }
  }

  .hp30-offer__content {
    padding: 60px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    border-right: 4px solid var(--border-color);
  }

  @media screen and (max-width: 992px) {
    .hp30-offer__content {
      padding: 40px 20px;
      border-right: none;
      border-bottom: 4px solid var(--border-color);
    }
  }

  .hp30-offer__sys-code {
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--text-color);
    background: var(--border-color);
    color: var(--bg-color);
    padding: 5px 10px;
    display: inline-block;
    align-self: flex-start;
    margin-bottom: 20px;
  }

  .hp30-offer__title {
    font-family: var(--font-heading);
    font-size: clamp(60px, 12vw, {{ section.settings.title_size }}px);
    line-height: 0.9;
    text-transform: uppercase;
    color: var(--text-color);
    margin: 0 0 10px;
    letter-spacing: -0.02em;
    word-break: break-word;
  }

  .hp30-offer__subtitle {
    font-family: var(--font-body);
    font-size: clamp(18px, 3vw, 24px);
    font-weight: 700;
    text-transform: uppercase;
    color: var(--text-color);
    margin: 0;
  }

  .hp30-offer__action {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 60px;
    background: var(--text-color);
    transition: background-color 0s;
  }

  @media screen and (max-width: 992px) {
    .hp30-offer__action {
      padding: 40px;
    }
  }

  .hp30-offer__action:hover {
    background: var(--bg-color);
  }

  .hp30-offer__action:hover .hp30-offer__btn {
    color: var(--text-color);
    border-color: var(--text-color);
  }

  .hp30-offer__btn {
    font-family: var(--font-heading);
    font-size: clamp(30px, 5vw, 60px);
    line-height: 1;
    text-transform: uppercase;
    color: var(--bg-color);
    text-decoration: none;
    border: 4px solid transparent;
    padding: 20px 40px;
    transition: color 0s, border-color 0s;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp30-offer-wrapper" id="HP30Offer-{{ section.id }}">
  <div class="hp30-offer__content">
    {%- if section.settings.code != blank -%}
      <div class="hp30-offer__sys-code">CODE: {{ section.settings.code }}</div>
    {%- endif -%}

    {%- if section.settings.title != blank -%}
      <h2 class="hp30-offer__title">{{ section.settings.title }}</h2>
    {%- endif -%}

    {%- if section.settings.subtitle != blank -%}
      <p class="hp30-offer__subtitle">{{ section.settings.subtitle }}</p>
    {%- endif -%}
  </div>
  
  <a href="{{ section.settings.link | default: '#' }}" class="hp30-offer__action">
    <div class="hp30-offer__btn">{{ section.settings.btn_label }}</div>
  </a>
</div>

{% schema %}
{
  "name": "HP30 - Brutalist Offer",
  "class": "section-hp30-offer-banner",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "code",
      "label": "Promo Code",
      "default": "FW_FINAL"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Heading",
      "default": "FINAL CLEARANCE"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "UP TO 70% OFF ARCHIVE PIECES"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "ACCESS"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Banner Link"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 60,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "Heading Size",
      "default": 120
    },
    {
      "type": "header",
      "content": "Brutalist Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (Red)",
      "default": "#FF0000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text (Black)",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Borders",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP30 - Brutalist Offer"
    }
  ]
}
{% endschema %}
