{%- liquid
  assign section_id = section.id
  assign layout = section.settings.layout | default: 'full'
  assign columns_desktop = section.settings.columns_desktop | default: 5
  assign columns_mobile = section.settings.columns_mobile | default: 2
  assign spacing = section.settings.spacing | default: 0
  
  assign bg_color = section.settings.bg_color | default: '#FFFFFF'
  assign text_color = section.settings.text_color | default: '#2D3748'
  assign overlay_color = section.settings.overlay_color | default: 'rgba(0, 0, 0, 0.4)'
  assign overlay_text = section.settings.overlay_text | default: '#FFFFFF'
  
  assign padding_top = section.settings.padding_top | default: 60
  assign padding_bottom = section.settings.padding_bottom | default: 60
  assign padding_top_mobile = section.settings.padding_top_mobile | default: 40
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile | default: 40
-%}

<style>
  #shopify-section-{{ section_id }} {
    --bg-color: {{ bg_color }};
    --text-color: {{ text_color }};
    --overlay-color: {{ overlay_color }};
    --overlay-text: {{ overlay_text }};
    --padding-top: {{ padding_top }}px;
    --padding-bottom: {{ padding_bottom }}px;
    --padding-top-mobile: {{ padding_top_mobile }}px;
    --padding-bottom-mobile: {{ padding_bottom_mobile }}px;
    --cols-desktop: {{ columns_desktop }};
    --cols-mobile: {{ columns_mobile }};
    --grid-spacing: {{ spacing }}px;
    
    background-color: var(--bg-color);
    color: var(--text-color);
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
  }

  .hpv6-social-{{ section_id }} {
    width: 100%;
    margin: 0 auto;
    {%- if layout == 'boxed' -%}
      max-width: var(--page-width, 1440px);
      padding-left: 5vw;
      padding-right: 5vw;
    {%- endif -%}
  }

  .hpv6-social__header {
    text-align: center;
    margin-bottom: 3rem;
    padding: 0 5vw;
  }

  .hpv6-social__profile {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .hpv6-social__avatar {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    object-fit: cover;
    background-color: #E2E8F0;
  }

  .hpv6-social__title {
    font-family: 'Playfair Display', 'Georgia', serif;
    font-size: clamp(2rem, 3vw, 3rem);
    font-weight: 400;
    margin: 0;
    line-height: 1.2;
  }

  .hpv6-social__subtitle {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    letter-spacing: 2px;
    text-transform: uppercase;
    opacity: 0.7;
    margin: 0;
  }

  .hpv6-social__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 24px;
    background-color: var(--text-color);
    color: var(--bg-color);
    text-decoration: none;
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    border-radius: 4px;
    transition: opacity 0.3s ease;
    margin-top: 1rem;
  }

  .hpv6-social__btn:hover {
    opacity: 0.8;
  }

  /* Grid Layout */
  .hpv6-social__grid {
    display: grid;
    grid-template-columns: repeat(var(--cols-desktop), 1fr);
    gap: var(--grid-spacing);
  }

  /* Items */
  .hpv6-social__item {
    position: relative;
    aspect-ratio: 1;
    background-color: #E2E8F0;
    overflow: hidden;
    display: block;
    text-decoration: none;
  }

  .hpv6-social__image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .hpv6-social__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: var(--overlay-color);
    color: var(--overlay-text);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: 1;
  }

  .hpv6-social__icon {
    width: 32px;
    height: 32px;
    fill: currentColor;
    transform: translateY(10px);
    transition: transform 0.3s ease;
  }

  .hpv6-social__item:hover .hpv6-social__image {
    transform: scale(1.08);
  }

  .hpv6-social__item:hover .hpv6-social__overlay {
    opacity: 1;
  }

  .hpv6-social__item:hover .hpv6-social__icon {
    transform: translateY(0);
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding-top: var(--padding-top-mobile);
      padding-bottom: var(--padding-bottom-mobile);
    }
    .hpv6-social__grid {
      grid-template-columns: repeat(var(--cols-mobile), 1fr);
    }
    .hpv6-social__header {
      margin-bottom: 2rem;
    }
  }
</style>

<div class="hpv6-social-{{ section_id }}">
  
  <div class="hpv6-social__header">
    {%- if section.settings.show_profile -%}
      <div class="hpv6-social__profile">
        {%- if section.settings.avatar != blank -%}
          {{ section.settings.avatar | image_url: width: 160 | image_tag: 
             loading: 'lazy',
             class: 'hpv6-social__avatar',
             alt: section.settings.title | escape
          }}
        {%- endif -%}
        
        {%- if section.settings.title != blank -%}
          <h2 class="hpv6-social__title">{{ section.settings.title | escape }}</h2>
        {%- endif -%}
        
        {%- if section.settings.subtitle != blank -%}
          <p class="hpv6-social__subtitle">{{ section.settings.subtitle | escape }}</p>
        {%- endif -%}
        
        {%- if section.settings.btn_label != blank -%}
          <a href="{{ section.settings.btn_link | default: '#' }}" class="hpv6-social__btn" target="_blank" rel="noopener">
            {{ section.settings.btn_label | escape }}
          </a>
        {%- endif -%}
      </div>
    {%- else -%}
      {%- if section.settings.subtitle != blank -%}
        <p class="hpv6-social__subtitle">{{ section.settings.subtitle | escape }}</p>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 class="hpv6-social__title">{{ section.settings.title | escape }}</h2>
      {%- endif -%}
    {%- endif -%}
  </div>

  <div class="hpv6-social__grid">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.link | default: '#' }}" class="hpv6-social__item" target="_blank" rel="noopener" aria-label="View post on social media" {{ block.shopify_attributes }}>
        
        {%- if block.settings.image != blank -%}
          {{ block.settings.image | image_url: width: 800 | image_tag: 
             loading: 'lazy',
             class: 'hpv6-social__image',
             alt: block.settings.image.alt | default: 'Social Media Feed Image'
          }}
        {%- else -%}
          {{ 'collection-' | append: forloop.index | placeholder_svg_tag: 'hpv6-social__image placeholder-svg' }}
        {%- endif -%}

        <div class="hpv6-social__overlay" aria-hidden="true">
          <svg class="hpv6-social__icon" viewBox="0 0 24 24">
            <path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.22.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.05.41 2.22.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.22-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.05.36-2.22.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.22-.41-.56-.22-.96-.48-1.38-.9-.42-.42-.68-.82-.9-1.38-.16-.42-.36-1.05-.41-2.22C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.22.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.05-.36 2.22-.41 1.27-.06 1.65-.07 4.85-.07M12 0C8.74 0 8.33.01 7.05.07c-1.27.06-2.13.26-2.89.56-.78.3-1.44.73-2.1 1.39-.66.66-1.09 1.32-1.39 2.1-.3.76-.5 1.62-.56 2.89C.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.06 1.27.26 2.13.56 2.89.3.78.73 1.44 1.39 2.1.66.66 1.32 1.09 2.1 1.39.76.3 1.62.5 2.89.56 1.28.06 1.69.07 4.95.07s3.67-.01 4.95-.07c1.27-.06 2.13-.26 2.89-.56.78-.3 1.44-.73 2.1-1.39.66-.66 1.09-1.32 1.39-2.1.3-.76.5-1.62.56-2.89.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.06-1.27-.26-2.13-.56-2.89-.3-.78-.73-1.44-1.39-2.1-.66-.66-1.32-1.09-2.1-1.39-.76-.3-1.62-.5-2.89-.56C15.67.01 15.26 0 12 0zm0 5.84A6.16 6.16 0 1018.16 12 6.16 6.16 0 0012 5.84zm0 10.16A4 4 0 1116 12a4 4 0 01-4 4zm6.4-9.44a1.44 1.44 0 11-2.88 0 1.44 1.44 0 012.88 0z"/>
          </svg>
        </div>
      </a>
    {%- endfor -%}
  </div>

</div>

{% schema %}
{
  "name": "HPV6 Instagram Feed",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Profile / Heading"
    },
    {
      "type": "checkbox",
      "id": "show_profile",
      "label": "Show as Profile Header",
      "default": false,
      "info": "Centers the avatar and text like an Instagram profile header."
    },
    {
      "type": "image_picker",
      "id": "avatar",
      "label": "Avatar Image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading / Handle",
      "default": "@YOURBRAND"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle / Bio",
      "default": "Follow us on Instagram for latest updates."
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "Follow"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Section Layout",
      "options": [
        { "value": "full", "label": "Full Width (Edge to Edge)" },
        { "value": "boxed", "label": "Boxed" }
      ],
      "default": "full"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 3,
      "max": 8,
      "step": 1,
      "label": "Columns on Desktop",
      "default": 5
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on Mobile",
      "options": [
        { "value": "2", "label": "2 Columns" },
        { "value": "3", "label": "3 Columns" }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "spacing",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Grid Spacing",
      "default": 0
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2D3748"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Image Hover Overlay Color",
      "default": "rgba(0, 0, 0, 0.4)"
    },
    {
      "type": "color",
      "id": "overlay_text",
      "label": "Image Hover Icon Color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Desktop Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Desktop Padding Bottom",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "social_image",
      "name": "Social Post",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link to Post"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HPV6 Instagram Feed",
      "blocks": [
        { "type": "social_image" },
        { "type": "social_image" },
        { "type": "social_image" },
        { "type": "social_image" },
        { "type": "social_image" }
      ]
    }
  ]
}
{% endschema %}
