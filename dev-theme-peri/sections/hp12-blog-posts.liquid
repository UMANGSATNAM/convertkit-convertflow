{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#FAFAFA'
  assign text_color = section.settings.text_color | default: '#333333'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 120px 40px;
    border-bottom: 1px solid #E5E5E5;
  }
  
  .hp12-blog-container-{{ section_id }} {
    max-width: 1400px;
    margin: 0 auto;
  }
  
  .hp12-blog-header-{{ section_id }} {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 60px;
  }
  
  .hp12-blog-heading-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 300;
    margin: 0;
    color: {{ text_color }};
    letter-spacing: 1px;
    line-height: 1.2;
  }
  
  .hp12-blog-view-all-{{ section_id }} {
    color: {{ text_color }};
    font-family: 'Inter', sans-serif;
    font-weight: 400;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    text-decoration: none;
    border-bottom: 1px solid {{ text_color }};
    padding-bottom: 5px;
    transition: opacity 0.3s ease;
  }
  
  .hp12-blog-view-all-{{ section_id }}:hover {
    opacity: 0.5;
  }
  
  .hp12-blog-grid-{{ section_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
  }
  
  .hp12-blog-card-{{ section_id }} {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: {{ text_color }};
  }
  
  .hp12-blog-image-wrap-{{ section_id }} {
    position: relative;
    padding-top: 66%; 
    background: #E5E5E5;
    margin-bottom: 25px;
    overflow: hidden;
  }
  
  .hp12-blog-image-{{ section_id }} {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  
  .hp12-blog-card-{{ section_id }}:hover .hp12-blog-image-{{ section_id }} {
    transform: scale(1.03);
  }
  
  .hp12-blog-meta-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: 0.8rem;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 1px;
    opacity: 0.5;
    margin-bottom: 10px;
  }
  
  .hp12-blog-title-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: 1.2rem;
    font-weight: 300;
    line-height: 1.4;
    margin: 0;
  }

  @media (max-width: 992px) {
    .hp12-blog-grid-{{ section_id }} {
      grid-template-columns: 1fr;
      gap: 50px;
    }
  }
  
  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 60px 20px;
    }
    .hp12-blog-header-{{ section_id }} {
      flex-direction: column;
      align-items: flex-start;
      gap: 15px;
    }
  }
</style>

<div class="hp12-blog-container-{{ section_id }}">
  <div class="hp12-blog-header-{{ section_id }}">
    <h2 class="hp12-blog-heading-{{ section_id }}">{{ section.settings.heading | default: 'Journal.' }}</h2>
    {% if section.settings.blog != blank %}
      <a href="{{ blogs[section.settings.blog].url }}" class="hp12-blog-view-all-{{ section_id }}">Read all</a>
    {% endif %}
  </div>
  
  <div class="hp12-blog-grid-{{ section_id }}">
    {% assign blog = blogs[section.settings.blog] %}
    {% if blog != blank and blog.articles_count > 0 %}
      {% for article in blog.articles limit: 3 %}
        <a href="{{ article.url }}" class="hp12-blog-card-{{ section_id }}">
          <div class="hp12-blog-image-wrap-{{ section_id }}">
            {% if article.image %}
              <img height="{{ article.image.height }}" width="{{ article.image.width }}" src="{{ article.image | image_url: width: 600 }}" class="hp12-blog-image-{{ section_id }}" loading="lazy" alt="{{ article.title }}">
            {% else %}
              <div class="hp12-blog-image-{{ section_id }}"></div>
            {% endif %}
          </div>
          <div class="hp12-blog-meta-{{ section_id }}">{{ article.published_at | date: "%B %d, %Y" }}</div>
          <h3 class="hp12-blog-title-{{ section_id }}">{{ article.title }}</h3>
        </a>
      {% endfor %}
    {% else %}
      {% for i in (1..3) %}
        <a href="#" class="hp12-blog-card-{{ section_id }}">
          <div class="hp12-blog-image-wrap-{{ section_id }}">
            <div class="hp12-blog-image-{{ section_id }}" style="background: repeating-linear-gradient(45deg, #EFEFEF, #EFEFEF 12px, #E6E6E6 12px, #E6E6E6 24px);"></div>
          </div>
          <div class="hp12-blog-meta-{{ section_id }}">OCTOBER 12, 2023</div>
          <h3 class="hp12-blog-title-{{ section_id }}">The philosophy of empty space.</h3>
        </a>
      {% endfor %}
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "HP12 Blog Posts",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FAFAFA"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#333333"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Journal."
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    }
  ],
  "presets": [
    {
      "name": "HP12 Blog Posts"
    }
  ]
}
{% endschema %}
