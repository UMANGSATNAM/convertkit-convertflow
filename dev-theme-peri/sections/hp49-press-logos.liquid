<style>
@media screen and (max-width: 768px) {
  .hp49-press-logos {
    padding-left: 16px !important;
    padding-right: 16px !important;
    box-sizing: border-box !important;
  }
  img {
    max-width: 100% !important;
    height: auto !important;
  }
}
</style>
{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp49-press-bg: {{ section.settings.bg_color | default: '#F5F3FF' }};
    
    background-color: var(--hp49-press-bg);
    padding: {{ section.settings.padding_vertical | default: 30 }}px 0;
    border-top: 1px solid rgba(124, 58, 237, 0.15);
    border-bottom: 1px solid rgba(124, 58, 237, 0.15);
  }

  .hp49-press__wrap {
    max-width: {{ section.settings.container_width | default: 1100 }}px;
    margin: 0 auto;
    padding: 0 20px;
    display: flex;
    justify-content: space-around;
    align-items: center;
    flex-wrap: wrap;
    gap: 30px;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 17px;
    font-weight: 800;
    letter-spacing: 1px;
    color: #4C1D95;
    opacity: 0.85;
  }
{%- endstyle -%}

<div class="hp49-press__wrap">
  {%- if section.blocks.size > 0 -%}
    {%- for block in section.blocks -%}
      <span {{ block.shopify_attributes }}>{{ block.settings.title }}</span>
    {%- endfor -%}
  {%- else -%}
    <span>VOGUE BEAUTY</span>
    <span>ELLE FRANCE</span>
    <span>GLAMOUR CALM</span>
    <span>MARIE CLAIRE</span>
    <span>BYRDIE WELLNESS</span>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "HP49 - Lavender Press",
  "class": "section-hp49-press",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#F5F3FF" },
    { "type": "range", "id": "padding_vertical", "min": 15, "max": 60, "step": 5, "unit": "px", "label": "Vertical Padding", "default": 30 },
    { "type": "range", "id": "container_width", "min": 800, "max": 1400, "step": 20, "unit": "px", "label": "Container Width", "default": 1100 }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Press Item",
      "settings": [
        { "type": "text", "id": "title", "label": "Publication Name", "default": "VOGUE BEAUTY" }
      ]
    }
  ],
  "presets": [
    { "name": "HP49 - Lavender Press" }
  ]
}
{% endschema %}
