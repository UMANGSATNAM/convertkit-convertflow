{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600&family=Syncopate:wght@400;700&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --font-heading: 'Syncopate', sans-serif;
    --font-body: 'Space Grotesk', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.8 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.8 | round }}px;
    }
  }

  .hp27-offer-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp27-offer-wrapper {
      padding: 0 20px;
    }
  }

  .hp27-offer__container {
    background-color: #111;
    border: 1px solid rgba(226, 226, 226, 0.2);
    position: relative;
    overflow: hidden;
    padding: 80px 40px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    transition: border-color 0.4s ease;
  }

  @media screen and (max-width: 768px) {
    .hp27-offer__container {
      padding: 60px 20px;
    }
  }

  .hp27-offer__container:hover {
    border-color: var(--accent-color);
  }

  /* Engineered Grid Background */
  .hp27-offer__grid {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-image: 
      linear-gradient(rgba(226, 226, 226, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(226, 226, 226, 0.05) 1px, transparent 1px);
    background-size: 40px 40px;
    background-position: center center;
    opacity: 0.5;
    z-index: 1;
    pointer-events: none;
  }

  /* Scanning line animation */
  .hp27-offer__scanline {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 2px;
    background: var(--accent-color);
    box-shadow: 0 0 10px var(--accent-color);
    z-index: 2;
    opacity: 0.5;
    animation: scanline 4s linear infinite;
    pointer-events: none;
  }

  @keyframes scanline {
    0% { top: 0; opacity: 0; }
    10% { opacity: 0.5; }
    90% { opacity: 0.5; }
    100% { top: 100%; opacity: 0; }
  }

  .hp27-offer__content {
    position: relative;
    z-index: 3;
    max-width: 800px;
  }

  .hp27-offer__code {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.2em;
    color: var(--bg-color);
    background: var(--text-color);
    padding: 6px 12px;
    margin-bottom: 30px;
    text-transform: uppercase;
  }

  .hp27-offer__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    font-weight: 700;
    line-height: 1.1;
    color: var(--text-color);
    margin: 0 0 20px;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }

  .hp27-offer__title span {
    color: var(--accent-color);
  }

  .hp27-offer__text {
    font-family: var(--font-body);
    font-size: clamp(14px, 1.5vw, {{ section.settings.text_size }}px);
    font-weight: 300;
    line-height: 1.6;
    color: var(--text-color);
    opacity: 0.7;
    margin: 0 0 40px;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .hp27-offer__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 32px;
    background: transparent;
    color: var(--text-color);
    border: 1px solid var(--text-color);
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .hp27-offer__btn:hover {
    background: var(--accent-color);
    border-color: var(--accent-color);
    color: #fff;
    box-shadow: 0 0 20px rgba(255, 42, 42, 0.4);
  }

  .hp27-offer__btn::before {
    content: '[ ';
    margin-right: 8px;
    opacity: 0.5;
    transition: opacity 0.3s ease;
  }

  .hp27-offer__btn::after {
    content: ' ]';
    margin-left: 8px;
    opacity: 0.5;
    transition: opacity 0.3s ease;
  }

  .hp27-offer__btn:hover::before,
  .hp27-offer__btn:hover::after {
    opacity: 1;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp27-offer-wrapper" id="HP27Offer-{{ section.id }}">
  <div class="hp27-offer__container">
    <div class="hp27-offer__grid"></div>
    <div class="hp27-offer__scanline"></div>
    
    <div class="hp27-offer__content">
      {%- if section.settings.code != blank -%}
        <div class="hp27-offer__code">{{ section.settings.code }}</div>
      {%- endif -%}

      {%- if section.settings.title != blank -%}
        <h2 class="hp27-offer__title">{{ section.settings.title }}</h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="hp27-offer__text">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if section.settings.btn_text != blank -%}
        <a href="{{ section.settings.btn_link | default: '#' }}" class="hp27-offer__btn">
          {{ section.settings.btn_text }}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "HP27 - Eng Offer Banner",
  "class": "section-hp27-offer-banner",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "code",
      "label": "Small Badge/Code",
      "default": "AUTH_CODE: SYS20"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Heading",
      "default": "SYSTEM <span>OVERRIDE</span>"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Unlock 20% off all core modules and expansions for a limited time. Apply authorization code at checkout."
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "INITIATE SEQUENCE"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 800,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1200
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 32,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 56
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Text Size",
      "default": 16
    },
    {
      "type": "header",
      "content": "Dark Engineered Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#0A0A0A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#E2E2E2"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#FF2A2A"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP27 - Eng Offer Banner"
    }
  ]
}
{% endschema %}
