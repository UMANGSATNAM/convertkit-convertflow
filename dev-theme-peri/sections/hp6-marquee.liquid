{%- liquid
  assign bg_color = section.settings.bg_color | default: '#ff4500'
  assign text_color = section.settings.text_color | default: '#ffffff'
  assign speed = section.settings.scroll_speed | default: 15
-%}

<style>
  #shopify-section-{{ section.id }} {
    --hp6-mq-bg: {{ bg_color }};
    --hp6-mq-text: {{ text_color }};
    --hp6-mq-speed: {{ speed }}s;
    background-color: var(--hp6-mq-bg);
    overflow: hidden;
    padding: 15px 0;
    border-top: 1px solid rgba(255,255,255,0.1);
    border-bottom: 1px solid rgba(255,255,255,0.1);
  }

  .hp6-marquee-container {
    display: flex;
    white-space: nowrap;
    width: 100vw;
    position: relative;
    transform: rotate({{ section.settings.rotation }}deg);
  }

  .hp6-marquee-track {
    display: flex;
    align-items: center;
    animation: hp6Marquee var(--hp6-mq-speed) linear infinite;
    will-change: transform;
  }

  {%- if section.settings.direction == 'right' -%}
    .hp6-marquee-track {
      animation-direction: reverse;
    }
  {%- endif -%}

  .hp6-marquee-item {
    display: inline-flex;
    align-items: center;
    padding: 0 40px;
    color: var(--hp6-mq-text);
    font-family: 'Oswald', sans-serif;
    font-size: clamp(20px, 3vw, 36px);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
  }

  .hp6-marquee-icon {
    margin-right: 20px;
    display: inline-flex;
    align-items: center;
  }

  .hp6-marquee-icon svg {
    width: 24px;
    height: 24px;
    fill: var(--hp6-mq-text);
  }

  /* Handle hollow text style */
  .hp6-marquee-item.style-hollow {
    color: transparent;
    -webkit-text-stroke: 1.5px var(--hp6-mq-text);
  }

  @keyframes hp6Marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  @media screen and (max-width: 768px) {
    .hp6-marquee-item {
      font-size: 20px;
      padding: 0 25px;
    }
    .hp6-marquee-icon svg {
      width: 18px; height: 18px;
    }
  }
</style>

<section class="hp6-sports-marquee-{{ section.id }}" aria-label="Announcement Marquee">
  <div class="hp6-marquee-container">
    <div class="hp6-marquee-track">
      {%- for i in (1..3) -%}
        {%- for block in section.blocks -%}
          <div class="hp6-marquee-item {% if block.settings.hollow %}style-hollow{% endif %}" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != 'none' -%}
              <span class="hp6-marquee-icon">
                {%- case block.settings.icon -%}
                  {%- when 'bolt' -%}
                    <svg viewBox="0 0 24 24"><path d="M11 21.6V13H7l8-11.6v8.6h4L11 21.6z"/></svg>
                  {%- when 'fire' -%}
                    <svg viewBox="0 0 24 24"><path d="M12 2c0 0-4 4-4 9 0 2.21 1.79 4 4 4s4-1.79 4-4c0-5-4-9-4-9zm0 11c-1.1 0-2-.9-2-2 0-1.5 2-3 2-3s2 1.5 2 3c0 1.1-.9 2-2 2z"/></svg>
                  {%- when 'star' -%}
                    <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                  {%- when 'circle' -%}
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"/></svg>
                {%- endcase -%}
              </span>
            {%- endif -%}
            {{ block.settings.text }}
          </div>
        {%- endfor -%}
      {%- endfor -%}

      {%- if section.blocks.size == 0 -%}
        {%- for i in (1..6) -%}
          <div class="hp6-marquee-item">
            <span class="hp6-marquee-icon"><svg viewBox="0 0 24 24"><path d="M11 21.6V13H7l8-11.6v8.6h4L11 21.6z"/></svg></span>
            UNLEASH YOUR POTENTIAL
          </div>
          <div class="hp6-marquee-item style-hollow">
            <span class="hp6-marquee-icon"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"/></svg></span>
            FREE SHIPPING OVER $100
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "HP6 Sports Marquee",
  "tag": "section",
  "class": "section-hp6-marquee",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ff4500"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "scroll_speed",
      "min": 5,
      "max": 50,
      "step": 1,
      "unit": "s",
      "label": "Scroll Speed",
      "default": 15
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Scroll Direction",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "rotation",
      "min": -5,
      "max": 5,
      "step": 1,
      "unit": "deg",
      "label": "Rotation",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Marquee Text",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "UNLEASH YOUR POTENTIAL"
        },
        {
          "type": "checkbox",
          "id": "hollow",
          "label": "Use Hollow/Outline Style",
          "default": false
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "bolt", "label": "Lightning Bolt" },
            { "value": "fire", "label": "Fire" },
            { "value": "star", "label": "Star" },
            { "value": "circle", "label": "Circle" }
          ],
          "default": "bolt"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP6 Sports Marquee",
      "category": "Promotional",
      "blocks": [
        { "type": "text", "settings": { "text": "UNLEASH YOUR POTENTIAL", "hollow": false, "icon": "bolt" } },
        { "type": "text", "settings": { "text": "FREE SHIPPING ON $100+", "hollow": true, "icon": "circle" } },
        { "type": "text", "settings": { "text": "ENGINEERED FOR CHAMPIONS", "hollow": false, "icon": "bolt" } }
      ]
    }
  ]
}
{% endschema %}
