{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@1,700&family=Inter:wght@300&display=swap');

  #shopify-section-{{ section.id }} {
    --bg: {{ section.settings.bg_color }};
    --text: {{ section.settings.text_color }};
    --gold: {{ section.settings.accent_color }};
    --speed: {{ section.settings.speed }}s;
    --serif: 'Playfair Display', serif;
  }

  .hp42-marquee {
    background: var(--bg);
    padding: 25px 0;
    overflow: hidden;
    white-space: nowrap;
    border-top: 1px solid rgba(201,169,110,0.2);
    border-bottom: 1px solid rgba(201,169,110,0.2);
  }

  .hp42-marquee__track {
    display: inline-block;
    animation: hp42Scroll var(--speed) linear infinite;
  }
  .hp42-marquee__track:hover { animation-play-state: paused; }

  @keyframes hp42Scroll {
    100% { transform: translateX(-50%); }
  }

  .hp42-marquee__list {
    display: inline-flex;
    align-items: center;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .hp42-marquee__item {
    padding: 0 50px;
    font-family: var(--serif);
    font-size: clamp(24px, 4vw, {{ section.settings.text_size }}px);
    font-weight: 700;
    font-style: italic;
    color: var(--text);
    opacity: 0.5;
  }

  .hp42-marquee__dot {
    width: 6px; height: 6px;
    background: var(--gold);
    border-radius: 50%;
    display: inline-block;
    margin: 0 50px;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp42-marquee" id="HP42Marquee-{{ section.id }}">
  <div class="hp42-marquee__track">
    <ul class="hp42-marquee__list">
      {%- for block in section.blocks -%}
        <li class="hp42-marquee__item" {{ block.shopify_attributes }}>{{ block.settings.text }}<span class="hp42-marquee__dot"></span></li>
      {%- endfor -%}
      {%- for block in section.blocks -%}
        <li class="hp42-marquee__item" aria-hidden="true">{{ block.settings.text }}<span class="hp42-marquee__dot"></span></li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "HP42 - Noir Marquee",
  "class": "section-hp42-marquee",
  "settings": [
    { "type": "range", "id": "speed", "min": 10, "max": 60, "step": 2, "unit": "s", "label": "Speed", "default": 24 },
    { "type": "range", "id": "text_size", "min": 24, "max": 80, "step": 2, "unit": "px", "label": "Text Size", "default": 48 },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#0A0A0A" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#F5F0EB" },
    { "type": "color", "id": "accent_color", "label": "Gold Dot", "default": "#C9A96E" },
    { "type": "html", "id": "custom_css", "label": "Custom CSS" }
  ],
  "blocks": [
    { "type": "text_block", "name": "Item", "settings": [
      { "type": "text", "id": "text", "label": "Text", "default": "Effortless Luxury" }
    ]}
  ],
  "presets": [{ "name": "HP42 - Noir Marquee", "blocks": [
    { "type": "text_block", "settings": { "text": "Timeless Elegance" } },
    { "type": "text_block", "settings": { "text": "Refined Detail" } },
    { "type": "text_block", "settings": { "text": "Dark Opulence" } }
  ]}]
}
{% endschema %}
