{%- style -%}#shopify-section-{{ section.id }}{background:{{ section.settings.bg_color | default: '#ffffff' }};padding-top:{{ section.settings.padding_top | default: 60 }}px;padding-bottom:{{ section.settings.padding_bottom | default: 60 }}px}.hp94-featured-collection__wrap{max-width:1280px;margin:0 auto;padding:0 24px}.hp94-featured-collection__head{display:flex;justify-content:space-between;align-items:end;margin-bottom:28px;gap:16px;flex-wrap:wrap}.hp94-featured-collection__h{font-family:'Syne',sans-serif;font-size:28px;font-weight:800;margin:0}.hp94-featured-collection__sub{opacity:.6;margin:6px 0 0}.hp94-featured-collection__grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}@media(max-width:992px){.hp94-featured-collection__grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:480px){.hp94-featured-collection__grid{grid-template-columns:1fr 1fr;gap:12px}}.hp94-card{background:#fff;border:1px solid rgba(0,0,0,.06);border-radius:12px;overflow:hidden;text-decoration:none;color:inherit;display:block}.hp94-card__img{aspect-ratio:1;overflow:hidden;background:#f6f6f6}.hp94-card__img img{width:100%;height:100%;object-fit:cover}.hp94-card__body{padding:12px}.hp94-card__title{font-size:14px;font-weight:600;margin:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.hp94-card__price{font-weight:700;margin:6px 0 0;color:#F97316}{%- endstyle -%}<div class="hp94-featured-collection__wrap"><div class="hp94-featured-collection__head"><div><h2 class="hp94-featured-collection__h">{{ section.settings.heading | default: 'Featured Collection' }}</h2><p class="hp94-featured-collection__sub">{{ section.settings.subheading }}</p></div><a href="{{ section.settings.link | default: '/collections/all' }}" style="font-size:13px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:#F97316;text-decoration:none">{{ section.settings.link_text | default: 'View All →' }}</a></div><div class="hp94-featured-collection__grid">{% for product in collections[section.settings.collection].products limit: section.settings.limit %}<a href="{{ product.url }}" class="hp94-card"><div class="hp94-card__img">{% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 500 }}" alt="{{ product.title | escape }}" loading="lazy">{% else %}{{ 'product-1' | placeholder_svg_tag }} {% endif %}</div><div class="hp94-card__body"><p class="hp94-card__title">{{ product.title }}</p><p class="hp94-card__price">{{ product.price | money }} {% if product.compare_at_price > product.price %}<span style="opacity:.5;font-weight:400;text-decoration:line-through;margin-left:6px">{{ product.compare_at_price | money }}</span>{% endif %}</p></div></a>{% else %}{% for i in (1..4) %}<div class="hp94-card"><div class="hp94-card__img">{{ 'product-1' | placeholder_svg_tag }}</div><div class="hp94-card__body"><p class="hp94-card__title">Sample KIDS WORLD Product</p><p class="hp94-card__price">₹1,999</p></div></div>{% endfor %}{% endfor %}</div></div>{% schema %}{"name":"HP94 Featured Collection","settings":[{"type":"text","id":"heading","label":"Heading","default":"Featured Collection"},{"type":"text","id":"subheading","label":"Subheading","default":"Curated for kids"},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"limit","min":2,"max":8,"step":1,"label":"Limit","default":4},{"type":"color","id":"bg_color","label":"BG","default":"#ffffff"},{"type":"url","id":"link","label":"Link"},{"type":"text","id":"link_text","label":"Link Text","default":"View All →"},{"type":"range","id":"padding_top","min":20,"max":120,"step":10,"unit":"px","label":"Pad Top","default":60},{"type":"range","id":"padding_bottom","min":20,"max":120,"step":10,"unit":"px","label":"Pad Bottom","default":60}],"presets":[{"name":"HP94 Featured Collection"}]}{% endschema %}