{%- liquid
  assign section_id = section.id
  assign height = section.settings.height | default: '100vh'
  assign mobile_height = section.settings.mobile_height | default: '90vh'
  assign bg_color = section.settings.bg_color | default: '#050505'
  assign text_color = section.settings.text_color | default: '#F4F4F0'
  assign overlay_opacity = section.settings.overlay_opacity | default: 30
  assign text_alignment = section.settings.text_alignment | default: 'bottom-left'
-%}

<style>
  #shopify-section-{{ section_id }} {
    --bg-color: {{ bg_color }};
    --text-color: {{ text_color }};
    --overlay-opacity: {{ overlay_opacity | divided_by: 100.0 }};
    --hero-height: {{ height }};
    --mobile-height: {{ mobile_height }};
    
    background-color: var(--bg-color);
  }

  .hp7-hero-{{ section_id }} {
    position: relative;
    width: 100%;
    height: var(--hero-height);
    min-height: 500px;
    overflow: hidden;
    display: flex;
    {%- if text_alignment contains 'top' -%}
      align-items: flex-start;
    {%- elsif text_alignment contains 'bottom' -%}
      align-items: flex-end;
    {%- else -%}
      align-items: center;
    {%- endif -%}

    {%- if text_alignment contains 'left' -%}
      justify-content: flex-start;
    {%- elsif text_alignment contains 'right' -%}
      justify-content: flex-end;
    {%- else -%}
      justify-content: center;
    {%- endif -%}
  }

  .hp7-hero__media {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .hp7-hero__image,
  .hp7-hero__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  
  .hp7-hero__video {
    pointer-events: none;
  }

  .hp7-hero__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #000000;
    opacity: var(--overlay-opacity);
    z-index: 2;
  }

  .hp7-hero__content {
    position: relative;
    z-index: 3;
    color: var(--text-color);
    padding: 6vw;
    max-width: 1400px;
    width: 100%;
    {%- if text_alignment contains 'center' -%}
      text-align: center;
    {%- elsif text_alignment contains 'right' -%}
      text-align: right;
    {%- endif -%}
  }

  .hp7-hero__subtitle {
    font-family: 'Inter', sans-serif;
    font-size: clamp(12px, 1.5vw, 14px);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    margin-bottom: 2rem;
    font-weight: 600;
    display: block;
  }

  .hp7-hero__title {
    font-family: 'Playfair Display', 'Georgia', serif;
    /* Brutalist extreme sizing */
    font-size: clamp(4rem, 12vw, 10rem);
    font-weight: 400;
    line-height: 0.85;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    word-break: break-word;
  }

  .hp7-hero__title em {
    font-style: italic;
    opacity: 0.8;
  }

  .hp7-hero__actions {
    margin-top: 4rem;
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
    {%- if text_alignment contains 'center' -%}
      justify-content: center;
    {%- elsif text_alignment contains 'right' -%}
      justify-content: flex-end;
    {%- endif -%}
  }

  .hp7-hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 20px 48px;
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    position: relative;
    overflow: hidden;
  }

  /* Primary Button - Brutalist style (sharp, stark contrast) */
  .hp7-hero__btn--primary {
    background-color: var(--text-color);
    color: var(--bg-color);
    border: 1px solid var(--text-color);
  }

  .hp7-hero__btn--primary:hover {
    background-color: transparent;
    color: var(--text-color);
  }

  /* Secondary Button - Ghost style */
  .hp7-hero__btn--secondary {
    background-color: transparent;
    color: var(--text-color);
    border: 1px solid var(--text-color);
  }

  .hp7-hero__btn--secondary:hover {
    background-color: var(--text-color);
    color: var(--bg-color);
  }

  @media screen and (max-width: 768px) {
    .hp7-hero-{{ section_id }} {
      height: var(--mobile-height);
    }
    
    .hp7-hero__content {
      padding: 8vw 5vw;
    }
    
    .hp7-hero__actions {
      margin-top: 3rem;
      gap: 1rem;
      flex-direction: column;
    }
    
    .hp7-hero__btn {
      width: 100%;
    }
  }
</style>

<section class="hp7-hero-{{ section_id }}">
  
  <div class="hp7-hero__media">
    {%- if section.settings.video != blank -%}
      {{ section.settings.video | video_tag: 
         autoplay: true, 
         loop: true, 
         muted: true, 
         controls: false,
         class: 'hp7-hero__video'
      }}
    {%- elsif section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag: 
         loading: 'eager',
         fetchpriority: 'high',
         class: 'hp7-hero__image',
         alt: section.settings.image.alt | default: 'Hero image'
      }}
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'hp7-hero__image placeholder-svg' }}
    {%- endif -%}
  </div>

  <div class="hp7-hero__overlay"></div>

  <div class="hp7-hero__content">
    {%- if section.settings.subtitle != blank -%}
      <span class="hp7-hero__subtitle">{{ section.settings.subtitle | escape }}</span>
    {%- endif -%}

    {%- if section.settings.title != blank -%}
      <h1 class="hp7-hero__title">{{ section.settings.title }}</h1>
    {%- endif -%}

    {%- if section.settings.btn1_label != blank or section.settings.btn2_label != blank -%}
      <div class="hp7-hero__actions">
        {%- if section.settings.btn1_label != blank -%}
          <a href="{{ section.settings.btn1_link | default: '#' }}" class="hp7-hero__btn hp7-hero__btn--primary">
            {{ section.settings.btn1_label | escape }}
          </a>
        {%- endif -%}
        
        {%- if section.settings.btn2_label != blank -%}
          <a href="{{ section.settings.btn2_link | default: '#' }}" class="hp7-hero__btn hp7-hero__btn--secondary">
            {{ section.settings.btn2_label | escape }}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

</section>

{% schema %}
{
  "name": "HP7 Editorial Hero",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Aesthetic: Editorial Brutalism",
      "info": "This hero uses oversized typography and high-contrast imagery typical of high-fashion editorials."
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Background Video",
      "info": "Takes precedence over the image if both are provided."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Overlay Opacity",
      "default": 30
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "FW26 // ARCHIVE"
    },
    {
      "type": "html",
      "id": "title",
      "label": "Title (HTML)",
      "default": "FORM<br><em>&</em> VOID",
      "info": "Use <br> for line breaks and <em> for italicized contrasting text."
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        { "value": "top-left", "label": "Top Left" },
        { "value": "top-center", "label": "Top Center" },
        { "value": "top-right", "label": "Top Right" },
        { "value": "center-left", "label": "Middle Left" },
        { "value": "center-center", "label": "Middle Center" },
        { "value": "center-right", "label": "Middle Right" },
        { "value": "bottom-left", "label": "Bottom Left" },
        { "value": "bottom-center", "label": "Bottom Center" },
        { "value": "bottom-right", "label": "Bottom Right" }
      ],
      "default": "center-center"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "btn1_label",
      "label": "Primary Button Label",
      "default": "Explore Collection"
    },
    {
      "type": "url",
      "id": "btn1_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "btn2_label",
      "label": "Secondary Button Label",
      "default": "Watch Film"
    },
    {
      "type": "url",
      "id": "btn2_link",
      "label": "Secondary Button Link"
    },
    {
      "type": "header",
      "content": "Layout & Colors"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Desktop Height",
      "options": [
        { "value": "100vh", "label": "Full Screen (100vh)" },
        { "value": "80vh", "label": "Large (80vh)" },
        { "value": "60vh", "label": "Medium (60vh)" }
      ],
      "default": "100vh"
    },
    {
      "type": "select",
      "id": "mobile_height",
      "label": "Mobile Height",
      "options": [
        { "value": "100vh", "label": "Full Screen (100vh)" },
        { "value": "80vh", "label": "Large (80vh)" },
        { "value": "60vh", "label": "Medium (60vh)" }
      ],
      "default": "80vh"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color (if no media)",
      "default": "#050505"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#F4F4F0"
    }
  ],
  "presets": [
    {
      "name": "HP7 Editorial Hero"
    }
  ]
}
{% endschema %}
