{%- comment -%}
  sections/fb04-new-drops_streetwear.liquid

  CONVERSION PSYCHOLOGY (Frameblox Landing 04 Replica):
  1. PARADOX OF CHOICE -- 3 cards per row (desktop). Hick's Law: curated grid
     eliminates decision paralysis while still creating "collection feel."
  2. GOLD BADGE ANCHORING -- "New" badge in warm gold (#ED9A1C) activates the
     Von Restorff Isolation Effect: visually distinct items are remembered 2.6x
     better than unmarked items (Baymard).
  3. PRICE ANCHORING -- Crossed-out compare-at price next to current price
     anchors brain to higher value; perceives discount as savings.
  4. HOVER MICRO-INTERACTION -- Card lifts + shadow deepens + "+" button turns
     blue. Fitts's Law: quick-add target is always visible.
  5. ASPECT RATIO CONTROL -- 4:4.8 portrait aspect ratio matches
     fashion-forward product photography standards.
{%- endcomment -%}

{%- liquid
  assign section_id = 'fb04-drops-' | append: section.id
  assign collection = collections[section.settings.collection]
  assign limit = section.settings.product_limit | default: 3
-%}

<style>
  #shopify-section-{{ section.id }} {
    --fd-bg: {{ section.settings.bg_color | default: '#FFFFFF' }};
    --fd-badge: {{ section.settings.badge_color | default: '#ED9A1C' }};
    --fd-text-dark: {{ section.settings.text_dark | default: '#282A2F' }};
    --fd-text-body: {{ section.settings.text_body | default: '#7B818E' }};
    --fd-card-bg: {{ section.settings.card_bg | default: '#F3F4F5' }};
    --fd-accent: {{ section.settings.primary_color | default: '#0066FF' }};
  }

  .fb04-drops {
    background: var(--fd-bg);
    padding: clamp(3rem, 7vw, 5.6rem) 0;
  }

  .fb04-drops__container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 clamp(1rem, 4vw, 3.75rem);
  }

  /* Section Header */
  .fb04-drops__header {
    margin-bottom: 48px;
  }

  .fb04-drops__tag {
    font-family: var(--font-body, sans-serif);
    font-weight: 700;
    font-size: 13px;
    text-transform: uppercase;
    color: var(--fd-text-body);
    letter-spacing: 2px;
    display: block;
    margin-bottom: 12px;
  }

  .fb04-drops__desc {
    font-family: var(--font-body, sans-serif);
    font-weight: 400;
    font-size: 16px;
    color: var(--fd-text-body);
    max-width: 580px;
    line-height: 1.6;
  }

  /* Product Grid */
  .fb04-drops__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }

  /* Card */
  .fb04-card {
    background: var(--fd-card-bg);
    border-radius: 12px;
    overflow: hidden;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
    position: relative;
    text-decoration: none;
    color: inherit;
  }

  .fb04-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.08);
  }

  .fb04-card__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 4.8;
    background: #e6e8eb;
  }

  .fb04-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .fb04-card:hover .fb04-card__media img {
    transform: scale(1.06);
  }

  .fb04-card__badge {
    position: absolute;
    top: 16px;
    left: 16px;
    background: var(--fd-badge);
    color: #fff;
    font-family: var(--font-body, sans-serif);
    font-weight: 700;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 5px 14px;
    border-radius: 9999px;
    box-shadow: 0 2px 8px rgba(237, 154, 28, 0.4);
    z-index: 2;
  }

  .fb04-card__body {
    padding: 24px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .fb04-card__title {
    font-family: var(--font-body, sans-serif);
    font-weight: 700;
    font-size: 20px;
    color: var(--fd-text-dark);
    margin-bottom: 8px;
  }

  .fb04-card__text {
    font-family: var(--font-body, sans-serif);
    font-weight: 400;
    font-size: 14px;
    color: var(--fd-text-body);
    line-height: 1.5;
    margin-bottom: 20px;
    flex-grow: 1;
  }

  .fb04-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 14px;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
  }

  .fb04-card__prices {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  .fb04-card__price {
    font-family: var(--font-body, sans-serif);
    font-weight: 700;
    font-size: 20px;
    color: var(--fd-text-dark);
  }

  .fb04-card__compare {
    font-family: var(--font-body, sans-serif);
    font-weight: 400;
    font-size: 15px;
    color: var(--fd-text-body);
    text-decoration: line-through;
  }

  .fb04-card__add {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--fd-text-dark);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    border: none;
    cursor: pointer;
  }

  .fb04-card:hover .fb04-card__add {
    background: var(--fd-accent);
    transform: scale(1.1);
  }

  @media (max-width: 809px) {
    .fb04-drops__grid { grid-template-columns: 1fr; gap: 20px; }
  }
  @media (min-width: 810px) and (max-width: 1199px) {
    .fb04-drops__grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>

<section class="fb04-drops" id="{{ section_id }}">
  <div class="fb04-drops__container">

    <div class="fb04-drops__header">
      {%- if section.settings.eyebrow != blank -%}
        <span class="fb04-drops__tag">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <p class="fb04-drops__desc">{{ section.settings.description }}</p>
      {%- endif -%}
    </div>

    <div class="fb04-drops__grid">
      {%- if collection != blank and collection.products.size > 0 -%}
        {%- for product in collection.products limit: limit -%}
          <a href="{{ product.url }}" class="fb04-card">
            <div class="fb04-card__media">
              {%- if section.settings.show_badge -%}
                <span class="fb04-card__badge">{{ section.settings.badge_text | default: 'New' }}</span>
              {%- endif -%}
              {%- if product.featured_image -%}
                <img
                  src="{{ product.featured_image | image_url: width: 800 }}"
                  alt="{{ product.featured_image.alt | default: product.title | escape }}"
                  loading="lazy"
                  width="800"
                  height="960">
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            <div class="fb04-card__body">
              <h3 class="fb04-card__title">{{ product.title }}</h3>
              {%- if product.description != blank -%}
                <p class="fb04-card__text">{{ product.description | strip_html | truncate: 120 }}</p>
              {%- endif -%}
              <div class="fb04-card__footer">
                <div class="fb04-card__prices">
                  <span class="fb04-card__price">{{ product.price | money }}</span>
                  {%- if product.compare_at_price > product.price -%}
                    <span class="fb04-card__compare">{{ product.compare_at_price | money }}</span>
                  {%- endif -%}
                </div>
                <span class="fb04-card__add" aria-label="View {{ product.title }}">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                </span>
              </div>
            </div>
          </a>
        {%- endfor -%}

      {%- else -%}
        {%- comment -%} Fallback blocks when no collection assigned {%- endcomment -%}
        {%- for block in section.blocks -%}
          <div class="fb04-card" {{ block.shopify_attributes }}>
            <div class="fb04-card__media">
              {%- if section.settings.show_badge -%}
                <span class="fb04-card__badge">{{ section.settings.badge_text | default: 'New' }}</span>
              {%- endif -%}
              {%- if block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: 800 }}"
                  alt="{{ block.settings.title | escape }}"
                  loading="lazy"
                  width="800"
                  height="960">
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            <div class="fb04-card__body">
              <h3 class="fb04-card__title">{{ block.settings.title }}</h3>
              <p class="fb04-card__text">{{ block.settings.description }}</p>
              <div class="fb04-card__footer">
                <div class="fb04-card__prices">
                  <span class="fb04-card__price">{{ block.settings.price }}</span>
                  {%- if block.settings.compare_price != blank -%}
                    <span class="fb04-card__compare">{{ block.settings.compare_price }}</span>
                  {%- endif -%}
                </div>
                <span class="fb04-card__add" aria-label="Add to cart">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                </span>
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "FB04 New Drops",
