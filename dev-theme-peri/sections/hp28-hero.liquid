{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Chakra+Petch:ital,wght@0,300;0,400;0,600;0,700;1,400&family=Press+Start+2P&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --cyan: {{ section.settings.cyan_color }};
    --magenta: {{ section.settings.magenta_color }};
    --green: {{ section.settings.green_color }};
    --font-heading: 'Press Start 2P', cursive;
    --font-body: 'Chakra Petch', sans-serif;
    
    background-color: var(--bg-color);
    position: relative;
    overflow: hidden;
    /* Grid background */
    background-image: 
      linear-gradient(rgba(0, 255, 255, 0.1) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 255, 255, 0.1) 1px, transparent 1px);
    background-size: 40px 40px;
    background-position: center bottom;
  }

  /* Scanline overlay */
  #shopify-section-{{ section.id }}::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: linear-gradient(
      to bottom,
      transparent 50%,
      rgba(0, 0, 0, 0.25) 51%
    );
    background-size: 100% 4px;
    z-index: 2;
    pointer-events: none;
  }

  .hp28-hero {
    position: relative;
    width: 100%;
    height: {{ section.settings.desktop_height }}vh;
    min-height: 600px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 40px;
    z-index: 3;
  }

  @media screen and (max-width: 768px) {
    .hp28-hero {
      height: {{ section.settings.mobile_height }}vh;
      min-height: 500px;
      padding: 0 20px;
    }
  }

  /* Decorative Sun/Grid effect if we want true vaporwave */
  .hp28-hero__sun {
    position: absolute;
    bottom: -10%;
    left: 50%;
    transform: translateX(-50%);
    width: 600px;
    height: 600px;
    background: linear-gradient(to bottom, var(--magenta), #ff8a00);
    border-radius: 50%;
    z-index: 1;
    filter: blur(5px);
    opacity: 0.6;
    box-shadow: 0 0 100px var(--magenta);
    clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%);
  }

  /* Slice the sun */
  .hp28-hero__sun::after {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: repeating-linear-gradient(
      transparent,
      transparent 20px,
      var(--bg-color) 20px,
      var(--bg-color) 24px
    );
  }

  .hp28-hero__content-box {
    position: relative;
    z-index: 4;
    background: rgba(28, 11, 43, 0.85);
    border: 3px solid var(--cyan);
    box-shadow: 
      8px 8px 0 var(--magenta),
      inset 0 0 20px rgba(0, 255, 255, 0.2);
    padding: 60px 40px;
    text-align: center;
    max-width: 800px;
    width: 100%;
    backdrop-filter: blur(10px);
  }

  @media screen and (max-width: 768px) {
    .hp28-hero__content-box {
      padding: 40px 20px;
      border-width: 2px;
      box-shadow: 4px 4px 0 var(--magenta);
    }
  }

  /* Glitch effect on title */
  .hp28-hero__title {
    font-family: var(--font-heading);
    font-size: clamp(24px, 4vw, {{ section.settings.title_size }}px);
    color: #FFF;
    text-shadow: 
      2px 2px 0 var(--cyan),
      -2px -2px 0 var(--magenta);
    line-height: 1.3;
    margin: 0 0 20px;
    position: relative;
    display: inline-block;
  }

  /* Simple CSS Glitch Animation */
  .hp28-hero__title::before,
  .hp28-hero__title::after {
    content: attr(data-text);
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    background: transparent;
  }

  .hp28-hero__title::before {
    left: 2px;
    text-shadow: -2px 0 var(--magenta);
    clip: rect(24px, 550px, 90px, 0);
    animation: glitch-anim 3s infinite linear alternate-reverse;
  }

  .hp28-hero__title::after {
    left: -2px;
    text-shadow: -2px 0 var(--cyan);
    clip: rect(85px, 550px, 140px, 0);
    animation: glitch-anim 2.5s infinite linear alternate-reverse;
  }

  @keyframes glitch-anim {
    0% { clip: rect(22px, 9999px, 83px, 0); }
    5% { clip: rect(64px, 9999px, 34px, 0); }
    10% { clip: rect(78px, 9999px, 49px, 0); }
    15% { clip: rect(27px, 9999px, 54px, 0); }
    20% { clip: rect(48px, 9999px, 10px, 0); }
    25% { clip: rect(98px, 9999px, 83px, 0); }
    30% { clip: rect(10px, 9999px, 12px, 0); }
    35% { clip: rect(54px, 9999px, 98px, 0); }
    40% { clip: rect(72px, 9999px, 41px, 0); }
    45% { clip: rect(31px, 9999px, 66px, 0); }
    50% { clip: rect(89px, 9999px, 25px, 0); }
    55% { clip: rect(15px, 9999px, 77px, 0); }
    60% { clip: rect(56px, 9999px, 19px, 0); }
    65% { clip: rect(38px, 9999px, 92px, 0); }
    70% { clip: rect(91px, 9999px, 43px, 0); }
    75% { clip: rect(24px, 9999px, 68px, 0); }
    80% { clip: rect(83px, 9999px, 14px, 0); }
    85% { clip: rect(42px, 9999px, 87px, 0); }
    90% { clip: rect(69px, 9999px, 35px, 0); }
    95% { clip: rect(11px, 9999px, 59px, 0); }
    100% { clip: rect(95px, 9999px, 21px, 0); }
  }

  .hp28-hero__subtitle {
    font-family: var(--font-body);
    font-size: clamp(16px, 2vw, 20px);
    font-weight: 600;
    color: var(--green);
    letter-spacing: 0.1em;
    margin: 0 0 40px;
    text-transform: uppercase;
  }

  .hp28-hero__btn {
    display: inline-block;
    background: var(--cyan);
    color: #000;
    font-family: var(--font-heading);
    font-size: 14px;
    text-decoration: none;
    padding: 20px 40px;
    border: 2px solid #FFF;
    box-shadow: 4px 4px 0 var(--magenta);
    transition: all 0.2s ease;
    text-transform: uppercase;
  }

  .hp28-hero__btn:hover {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0 var(--magenta);
    background: var(--magenta);
    color: #FFF;
  }

  .hp28-hero__btn:active {
    transform: translate(4px, 4px);
    box-shadow: 0 0 0 var(--magenta);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp28-hero">
  <div class="hp28-hero__sun"></div>
  
  <div class="hp28-hero__content-box">
    {%- if section.settings.title != blank -%}
      <!-- data-text for glitch effect -->
      <h1 class="hp28-hero__title" data-text="{{ section.settings.title | escape | replace: '\n', ' ' }}">{{ section.settings.title | newline_to_br }}</h1>
    {%- endif -%}

    {%- if section.settings.subtitle != blank -%}
      <div class="hp28-hero__subtitle">{{ section.settings.subtitle }}</div>
    {%- endif -%}

    {%- if section.settings.button_text != blank -%}
      <a href="{{ section.settings.button_link | default: '#' }}" class="hp28-hero__btn">
        {{ section.settings.button_text }}
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP28 - Y2K Hero",
  "class": "section-hp28-hero",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Heading",
      "default": "CYBERNETIC\nSYSTEMS"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "WELCOME TO THE GRID"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "ENTER_MAINFRAME"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_height",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Desktop Height",
      "default": 90
    },
    {
      "type": "range",
      "id": "mobile_height",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Mobile Height",
      "default": 80
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 30,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Heading Size (Desktop)",
      "default": 64
    },
    {
      "type": "header",
      "content": "Y2K Cyber Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (Deep Purple)",
      "default": "#1C0B2B"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Base Text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "cyan_color",
      "label": "Cyan Accent",
      "default": "#00FFFF"
    },
    {
      "type": "color",
      "id": "magenta_color",
      "label": "Magenta Accent",
      "default": "#FF00FF"
    },
    {
      "type": "color",
      "id": "green_color",
      "label": "Acid Green Accent",
      "default": "#39FF14"
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP28 - Y2K Hero"
    }
  ]
}
{% endschema %}
