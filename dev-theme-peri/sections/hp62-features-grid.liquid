{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#ECFDF5' }};
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }
  .hp62-feat__container { max-width: {{ section.settings.container_width | default: 1280 }}px; margin: 0 auto; padding: 0 24px; }
  .hp62-feat__header { text-align: center; margin-bottom: 50px; }
  .hp62-feat__eyebrow { font-family: 'Outfit', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: {{ section.settings.accent_color | default: '#059669' }}; margin: 0 0 12px; }
  .hp62-feat__heading { font-family: 'Italiana', serif; font-size: clamp(28px, 3.5vw, 42px); font-weight: 700; color: #064E3B; margin: 0; }
  .hp62-feat__grid { display: grid; grid-template-columns: repeat({{ section.settings.columns | default: 3 }}, 1fr); gap: 24px; }
  .hp62-feat__card {
    background: {{ section.settings.card_bg | default: '#FFFFFF' }};
    border: 1px solid rgba(6, 78, 59, 0.15); border-radius: 16px; padding: 28px 24px;
    box-shadow: 0 4px 20px rgba(6, 78, 59, 0.05);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .hp62-feat__card:hover { transform: translateY(-4px); box-shadow: 0 10px 30px rgba(6, 78, 59, 0.12); }
  .hp62-feat__card-icon {
    width: 48px; height: 48px; background: linear-gradient(135deg, #ECFDF5, #A7F3D0);
    border-radius: 50%; display: flex; align-items: center; justify-content: center;
    font-size: 20px; color: #064E3B; margin-bottom: 18px;
    border: 1px solid rgba(6, 78, 59, 0.2);
  }
  .hp62-feat__card-title { font-family: 'Italiana', serif; font-size: 19px; font-weight: 700; color: #064E3B; margin: 0 0 8px; }
  .hp62-feat__card-desc { font-size: 13px; line-height: 1.6; color: #475569; margin: 0; font-family: 'Outfit', sans-serif; }
  @media screen and (max-width: 992px) { .hp62-feat__grid { grid-template-columns: repeat(2, 1fr); } }
  @media screen and (max-width: 480px) { .hp62-feat__grid { grid-template-columns: 1fr; } }
{%- endstyle -%}
<div class="hp62-feat__container">
  <div class="hp62-feat__header">
    {%- if section.settings.eyebrow != blank -%}<p class="hp62-feat__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="hp62-feat__heading">{{ section.settings.heading | default: 'The Alpine Science Matrix' }}</h2>
  </div>
  <div class="hp62-feat__grid">
    {%- for block in section.blocks -%}
      <div class="hp62-feat__card" {{ block.shopify_attributes }}>
        <div class="hp62-feat__card-icon">{{ block.settings.icon | default: '🏔️' }}</div>
        <h3 class="hp62-feat__card-title">{{ block.settings.title | default: 'Edelweiss' }}</h3>
        <p class="hp62-feat__card-desc">{{ block.settings.description | default: 'High altitude bio-actives.' }}</p>
      </div>
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "HP62 Features",
  "class": "section-hp62-feat",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ECFDF5" },
    { "type": "color", "id": "card_bg", "label": "Card BG", "default": "#FFFFFF" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#059669" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "🏔️ ALPINE SCIENCE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Alpine Science Matrix" },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "label": "Columns", "default": 3 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "blocks": [{
    "type": "feature", "name": "Feature",
    "settings": [
      { "type": "text", "id": "icon", "label": "Icon", "default": "🏔️" },
      { "type": "text", "id": "title", "label": "Title", "default": "Edelweiss" },
      { "type": "textarea", "id": "description", "label": "Description", "default": "High altitude bio-actives." }
    ]
  }],
  "presets": [{
    "name": "HP62 Features",
    "blocks": [
      { "type": "feature", "settings": { "icon": "🏔️", "title": "Alpine Leontopodic Acid", "description": "High-altitude antioxidant protecting dermal cells against oxidative damage and blue light." } },
      { "type": "feature", "settings": { "icon": "❄️", "title": "Zermatt Matterhorn Glacial Dew", "description": "Filtered through Swiss granite rock layers for pristine mineral balance and hydration." } },
      { "type": "feature", "settings": { "icon": "🌿", "title": "Alpine Rose Stem Cells", "description": "Boosts epidermal renewal and protects skin stem cells from environmental climate stress." } },
      { "type": "feature", "settings": { "icon": "💧", "title": "Swiss Moss Cell Longevity", "description": "Strengthens cellular nuclei adaptability in changing humidity and altitude conditions." } },
      { "type": "feature", "settings": { "icon": "🧪", "title": "Glacial Oxygen Complex", "description": "Delivers dissolved micro-oxygen bubbles deep into tired pores for instant radiance." } },
      { "type": "feature", "settings": { "icon": "🛡️", "title": "Bio-Suisse Certified Clean", "description": "Sustainably hand-harvested without harming fragile mountain alpine ecosystems." } }
    ]
  }]
}
{% endschema %}
