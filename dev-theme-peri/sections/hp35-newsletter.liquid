{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;1,400&family=Nunito:wght@300;400;600&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --button-bg: {{ section.settings.button_bg }};
    --button-text: {{ section.settings.button_text }};
    
    --font-heading: 'Lora', serif;
    --font-body: 'Nunito', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .hp35-news-wrapper {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 40px;
    text-align: center;
  }

  @media screen and (max-width: 768px) {
    .hp35-news-wrapper {
      padding: 0 20px;
    }
  }

  .hp35-news__icon {
    margin-bottom: 20px;
    color: var(--button-bg);
  }
  
  .hp35-news__icon svg {
    width: 40px; height: 40px;
    fill: currentColor;
  }

  .hp35-news__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    line-height: 1.2;
    color: var(--text-color);
    margin: 0 0 15px;
    font-weight: 400;
  }
  
  .hp35-news__title em {
    font-style: italic;
  }

  .hp35-news__text {
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.6;
    color: var(--text-color);
    opacity: 0.8;
    margin: 0 auto 40px;
    max-width: 500px;
  }

  .hp35-news__form {
    display: flex;
    max-width: 500px;
    margin: 0 auto;
    position: relative;
  }

  .hp35-news__input {
    flex: 1;
    background: transparent;
    border: none;
    border-bottom: 1px solid rgba(0,0,0,0.2);
    padding: 15px 0;
    font-family: var(--font-body);
    font-size: 16px;
    color: var(--text-color);
    outline: none;
    transition: border-color 0.3s ease;
  }

  .hp35-news__input::placeholder {
    color: var(--text-color);
    opacity: 0.4;
    text-transform: uppercase;
    font-size: 12px;
    letter-spacing: 0.1em;
  }

  .hp35-news__input:focus {
    border-bottom-color: var(--text-color);
  }

  .hp35-news__submit {
    background: transparent;
    border: none;
    font-family: var(--font-body);
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 600;
    color: var(--button-bg);
    cursor: pointer;
    padding: 0 20px;
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    transition: color 0.3s ease;
  }

  .hp35-news__submit:hover {
    color: var(--text-color);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp35-news-wrapper" id="HP35Newsletter-{{ section.id }}">
  <div class="hp35-news__icon">
    <svg viewBox="0 0 24 24"><path d="M22 6c0-1.1-.9-2-2-2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6zm-2 0l-8 5-8-5h16zm0 12H4V8l8 5 8-5v10z"/></svg>
  </div>
  
  <h2 class="hp35-news__title">{{ section.settings.title | replace: 'notes', '<em>notes</em>' }}</h2>
  
  {%- if section.settings.text != blank -%}
    <p class="hp35-news__text">{{ section.settings.text }}</p>
  {%- endif -%}

  {% form 'customer', class: 'hp35-news__form' %}
    <input type="hidden" name="contact[tags]" value="newsletter">
    <input type="email"
      name="contact[email]"
      class="hp35-news__input"
      value="{% if customer %}{{ customer.email }}{% endif %}"
      placeholder="Your email address"
      required>
    <button type="submit" class="hp35-news__submit">Subscribe</button>
  {% endform %}
</div>

{% schema %}
{
  "name": "HP35 - Organic Newsletter",
  "class": "section-hp35-newsletter",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Gentle notes to your inbox"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Join our community for mindful inspiration, early access to new collections, and a welcome gift of 10% off."
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 40
    },
    {
      "type": "header",
      "content": "Organic Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (e.g. Sage or Sand)",
      "default": "#E9E5DE"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2C422F"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Accent Color",
      "default": "#CC7B5E"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 100
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP35 - Organic Newsletter"
    }
  ]
}
{% endschema %}
