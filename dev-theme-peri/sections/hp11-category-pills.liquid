{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#FFFFFF'
  assign text_color = section.settings.text_color | default: '#000000'
  assign hover_bg = section.settings.hover_bg | default: '#0000FF'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 60px 20px;
    border-bottom: 3px solid #000;
  }
  
  .hp11-pills-container-{{ section_id }} {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 15px;
  }
  
  .hp11-pill-{{ section_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 15px 35px;
    background: #FFF;
    border: 3px solid #000;
    box-shadow: 4px 4px 0 #000;
    color: {{ text_color }};
    font-family: 'Inter', sans-serif;
    font-size: 1.1rem;
    font-weight: 900;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  
  .hp11-pill-{{ section_id }}:hover {
    background-color: {{ hover_bg }};
    color: #FFF;
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 #000;
  }
  
  .hp11-pill-{{ section_id }}:active {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0 #000;
  }

  @media (max-width: 768px) {
    .hp11-pills-container-{{ section_id }} {
      justify-content: flex-start;
      overflow-x: auto;
      flex-wrap: nowrap;
      padding-bottom: 15px;
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
    .hp11-pills-container-{{ section_id }}::-webkit-scrollbar {
      display: none;
    }
    .hp11-pill-{{ section_id }} {
      flex: 0 0 auto;
      white-space: nowrap;
    }
  }
</style>

<div class="hp11-pills-container-{{ section_id }}">
  {% for block in section.blocks %}
    <a href="{{ block.settings.link | default: '#' }}" class="hp11-pill-{{ section_id }}" {{ block.shopify_attributes }}>
      {{ block.settings.title | default: 'CATEGORY' }}
    </a>
  {% endfor %}
</div>

{% schema %}
{
  "name": "HP11 Category Pills",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "hover_bg",
      "label": "Hover Background Color",
      "default": "#0000FF"
    }
  ],
  "blocks": [
    {
      "type": "pill",
      "name": "Category Pill",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "CATEGORY"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP11 Category Pills",
      "blocks": [
        { "type": "pill", "settings": { "title": "HOODIES" } },
        { "type": "pill", "settings": { "title": "TEES" } },
        { "type": "pill", "settings": { "title": "BOTTOMS" } },
        { "type": "pill", "settings": { "title": "ACCESSORIES" } },
        { "type": "pill", "settings": { "title": "SALE" } }
      ]
    }
  ]
}
{% endschema %}
