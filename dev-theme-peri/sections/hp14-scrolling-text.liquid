{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#cb997e'
  assign text_color = section.settings.text_color | default: '#ffffff'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 30px 0;
    overflow: hidden;
  }
  
  .hp14-scrolling-text-container-{{ section_id }} {
    display: flex;
    white-space: nowrap;
    overflow: hidden;
  }
  
  .hp14-scrolling-text-content-{{ section_id }} {
    display: flex;
    animation: hp14-scroll-text-{{ section_id }} 15s linear infinite;
  }
  
  .hp14-scrolling-text-item-{{ section_id }} {
    font-family: 'Georgia', serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: normal;
    font-style: italic;
    color: {{ text_color }};
    display: flex;
    align-items: center;
    padding: 0 40px;
  }
  
  .hp14-scrolling-text-item-{{ section_id }} svg {
    width: 30px;
    height: 30px;
    margin: 0 40px;
    opacity: 0.7;
  }

  @keyframes hp14-scroll-text-{{ section_id }} {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
</style>

<div class="hp14-scrolling-text-container-{{ section_id }}">
  <div class="hp14-scrolling-text-content-{{ section_id }}">
    {% for i in (1..4) %}
      <div class="hp14-scrolling-text-item-{{ section_id }}">
        {{ section.settings.text | default: 'Pure Botanical Goodness' }} 
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22c4.97-4.97 8-9.97 8-14 0-4.42-3.58-8-8-8s-8 3.58-8 8c0 4.03 3.03 9.03 8 14z"></path></svg>
      </div>
    {% endfor %}
    {% for i in (1..4) %}
      <div class="hp14-scrolling-text-item-{{ section_id }}">
        {{ section.settings.text | default: 'Pure Botanical Goodness' }} 
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22c4.97-4.97 8-9.97 8-14 0-4.42-3.58-8-8-8s-8 3.58-8 8c0 4.03 3.03 9.03 8 14z"></path></svg>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "HP14 Scrolling Text",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#cb997e"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Pure Botanical Goodness"
    }
  ],
  "presets": [
    {
      "name": "HP14 Scrolling Text"
    }
  ]
}
{% endschema %}
