{% comment %} CL V32 — Groceries / Fresh {% endcomment %}
{{ 'component-facets.css' | asset_url | stylesheet_tag }}
<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
<style>
  .clv32 { background: {{ section.settings.bg_color | default: '#F2FCE2' }}; color: {{ section.settings.text_color | default: '#3F6212' }}; padding: 50px 20px; font-family: 'Nunito', sans-serif; }
  .clv32-hero { text-align: center; margin-bottom: 40px; }
  .clv32-hero h1 { font-size: 42px; font-weight: 800; color: #14532D; margin-bottom: 15px; }
  .clv32-hero p { font-size: 16px; font-weight: 600; color: #4D7C0F; max-width: 600px; margin: 0 auto; line-height: 1.5; }
  .clv32-chips { display: flex; gap: 12px; justify-content: center; margin-bottom: 30px; flex-wrap: wrap; }
  .clv32-chips a { padding: 10px 20px; background: #FFF; color: #14532D; text-decoration: none; font-size: 14px; font-weight: 700; border-radius: 12px; border: 2px solid #84CC16; transition: 0.2s; }
  .clv32-chips a:hover, .clv32-chips a.active { background: #84CC16; color: #FFF; }
  .clv32-toolbar { background: #FFF; padding: 15px 25px; border-radius: 12px; margin-bottom: 30px; border: 2px solid #D9F99D; box-shadow: 0 4px 10px rgba(132,204,22,0.1); }
  .clv32-grid { display: grid; grid-template-columns: repeat({{ section.settings.cols_desktop | default: 4 }}, 1fr); gap: 20px; }
  .clv32-promo { grid-column: span 1; background: #14532D; color: #FFF; border-radius: 12px; padding: 40px; text-align: center; display: flex; flex-direction: column; justify-content: center; }
  .clv32-promo h3 { font-size: 26px; font-weight: 800; margin-bottom: 15px; }
  .clv32-promo a { display: inline-block; padding: 12px 24px; background: #84CC16; color: #FFF; text-decoration: none; font-weight: 800; border-radius: 8px; font-size: 14px; }
  .clv32-seo { margin-top: 50px; text-align: center; padding: 40px; background: #FFF; border-radius: 12px; border: 2px solid #D9F99D; }
  @media (max-width: 768px) { .clv32-grid { grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr); gap: 15px; } .clv32-hero h1 { font-size: 32px; } }
</style>
<div class="clv32" style="max-width: 1200px; margin: 0 auto;">
  <div class="clv32-hero">
    <h1>{% if collection.title != blank %}{{ collection.title | escape }}{% else %}Farm Fresh Market{% endif %}</h1>
    <p>{% if collection.description != blank %}{{ collection.description }}{% else %}Organic, locally-sourced produce delivered straight to your door.{% endif %}</p>
  </div>
  {% if section.settings.sub_collections != blank %}
    <div class="clv32-chips">
      {% for link in section.settings.sub_collections.links %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% endfor %}
    </div>
  {% endif %}
  <div class="clv32-toolbar">
    <facet-filters-form style="width: 100%;">
      <form id="FacetFiltersForm" style="display: flex; justify-content: space-between; align-items: center; width: 100%; flex-wrap: wrap; gap: 20px;">
        <div style="display: flex; gap: 15px;">
          {%- for filter in collection.filters -%}
            <details style="position: relative;">
              <summary style="cursor: pointer; font-size: 14px; font-weight: 700; color: #14532D;">{{ filter.label }} 🥕</summary>
              <div style="position: absolute; background: #FFF; padding: 20px; border-radius: 12px; border: 2px solid #84CC16; z-index: 10; margin-top: 15px; min-width: 200px; box-shadow: 0 10px 20px rgba(20,83,45,0.1);">
                {%- for value in filter.values -%}
                  <label style="display: block; margin-bottom: 12px; cursor: pointer; font-size: 14px; color: #3F6212; font-weight: 600;">
                    <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %}>
                    {{ value.label }} ({{ value.count }})
                  </label>
                {%- endfor -%}
              </div>
            </details>
          {%- endfor -%}
        </div>
        <select name="sort_by" onchange="this.form.submit()" style="background: #F2FCE2; border: 2px solid #84CC16; color: #14532D; padding: 10px 15px; border-radius: 8px; font-size: 14px; font-weight: 700; cursor: pointer;">
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>Sort by: {{ option.name }}</option>
          {%- endfor -%}
        </select>
      </form>
    </facet-filters-form>
  </div>
  {% assign limit_num = section.settings.products_per_page | default: 16 %}
  {% paginate collection.products by limit_num %}
    <div class="clv32-grid">
      {% for product in collection.products %}
        {% render 'card-v32', product: product %}
        {% if forloop.index == 8 and section.settings.show_promo_tile %}
          <div class="clv32-promo">
            <h3>Weekly<br>Harvest Box</h3>
            <a href="/products/box">Subscribe</a>
          </div>
        {% endif %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v32', product: nil %}
        {% endfor %}
      {% endfor %}
    </div>
    <div style="margin-top: 40px; text-align: center; font-weight: 800;">{{ paginate | default_pagination }}</div>
  {% endpaginate %}
  {% if section.settings.show_seo_block %}
    <div class="clv32-seo">
      <h2 style="font-size: 24px; font-weight: 800; color: #14532D; margin-bottom: 10px;">{{ section.settings.seo_title | default: 'Know Your Farmer' }}</h2>
      <p style="font-size: 14px; color: #4D7C0F; font-weight: 600; max-width: 600px; margin: 0 auto; line-height: 1.6;">{{ section.settings.seo_text | default: 'We partner with over 50 local farms to ensure you get the absolute freshest produce, harvested at the peak of ripeness.' }}</p>
    </div>
  {% endif %}
</div>
{% schema %}
{
  "name": "CL V32 — Groceries", "settings": [
    {"type": "range", "id": "products_per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 16},
    {"type": "range", "id": "cols_desktop", "label": "Desktop Columns", "min": 2, "max": 5, "default": 4},
    {"type": "select", "id": "cols_mobile", "label": "Mobile Columns", "options": [{"value": "1", "label": "1"}, {"value": "2", "label": "2"}], "default": "2"},
    {"type": "link_list", "id": "sub_collections", "label": "Sub-Collection Menu"},
    {"type": "checkbox", "id": "show_promo_tile", "label": "Show Promo Card", "default": true},
    {"type": "checkbox", "id": "show_seo_block", "label": "Show SEO Block", "default": true},
    {"type": "color", "id": "bg_color", "label": "Background Color", "default": "#F2FCE2"},
    {"type": "color", "id": "text_color", "label": "Text Color", "default": "#3F6212"}
  ], "presets": [{"name": "CL V32 — Groceries"}]
}
{% endschema %}
