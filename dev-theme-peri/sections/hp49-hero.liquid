{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,500;0,600;0,700;0,800;1,400&family=Urbanist:wght@400;500;600;700;800&display=swap');

  #shopify-section-{{ section.id }} {
    --hp49-bg: {{ section.settings.bg_color | default: '#F5F3FF' }};
    --hp49-text: {{ section.settings.text_color | default: '#2E1065' }};
    --hp49-accent: {{ section.settings.accent_color | default: '#7C3AED' }};
    --hp49-card-bg: {{ section.settings.card_bg | default: '#FFFFFF' }};
    --hp49-btn-bg: {{ section.settings.btn_bg | default: '#7C3AED' }};
    --hp49-btn-text-color: {{ section.settings.btn_text_color | default: '#FFFFFF' }};
    
    background-color: var(--hp49-bg);
    color: var(--hp49-text);
    font-family: 'Urbanist', sans-serif;
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
    position: relative;
    overflow: hidden;
  }

  .hp49-hero__container {
    max-width: {{ section.settings.container_width | default: 1280 }}px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  .hp49-hero__bubble-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 22px;
    background: rgba(124, 58, 237, 0.1);
    border: 1px solid rgba(124, 58, 237, 0.25);
    border-radius: 50px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--hp49-accent);
    margin-bottom: 24px;
  }

  .hp49-hero__title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: clamp(38px, 5.5vw, 62px);
    font-weight: 800;
    line-height: 1.1;
    color: var(--hp49-text);
    margin: 0 0 20px;
    letter-spacing: -0.5px;
  }

  .hp49-hero__title span {
    background: linear-gradient(135deg, #7C3AED, #EC4899);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hp49-hero__desc {
    font-size: 16px;
    line-height: 1.75;
    color: #5B21B6;
    margin: 0 0 36px;
    max-width: 520px;
    opacity: 0.85;
  }

  .hp49-hero__actions {
    display: flex;
    gap: 16px;
    align-items: center;
    flex-wrap: wrap;
  }

  .hp49-hero__btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 36px;
    background: var(--hp49-btn-bg);
    color: var(--hp49-btn-text-color);
    font-size: 14px;
    font-weight: 800;
    text-decoration: none;
    border-radius: 50px;
    box-shadow: 0 12px 30px rgba(124, 58, 237, 0.3);
    transition: all 0.3s ease;
  }

  .hp49-hero__btn-primary:hover {
    background: #6D28D9;
    transform: translateY(-2px);
    box-shadow: 0 16px 40px rgba(124, 58, 237, 0.4);
  }

  .hp49-hero__media-bubble {
    position: relative;
    border-radius: 40px;
    overflow: hidden;
    background: #EDE9FE;
    box-shadow: 0 25px 60px rgba(124, 58, 237, 0.15);
    height: 520px;
  }

  .hp49-hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hp49-hero__floating-card {
    position: absolute;
    bottom: 24px;
    left: 24px;
    right: 24px;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(124, 58, 237, 0.2);
    border-radius: 24px;
    padding: 16px 22px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .hp49-hero__float-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 16px;
    font-weight: 800;
    color: var(--hp49-text);
    margin: 0;
  }

  .hp49-hero__float-sub {
    font-size: 12px;
    color: var(--hp49-accent);
    margin: 0;
  }

  @media screen and (max-width: 992px) {
    .hp49-hero__container { grid-template-columns: 1fr; text-align: center; }
    .hp49-hero__desc { margin-left: auto; margin-right: auto; }
    .hp49-hero__actions { justify-content: center; }
    .hp49-hero__media-bubble { height: 380px; }
  }
{%- endstyle -%}

<div class="hp49-hero__container">
  <div>
    <div class="hp49-hero__bubble-tag">
      <span>🌸</span>
      <span>{{ section.settings.badge | default: 'LAVENDER BLOSSOM DREAM v49' }}</span>
    </div>

    <h1 class="hp49-hero__title">
      {{ section.settings.heading | default: 'Dreamy Lavender & <span>Pastel Blossom</span> Radiance' }}
    </h1>

    <p class="hp49-hero__desc">
      {{ section.settings.description | default: 'Gentle French Alpine lavender hydrosols and cherry blossom peptides that envelop your complexion in comforting cloud-soft hydration.' }}
    </p>

    <div class="hp49-hero__actions">
      <a href="{{ section.settings.btn_url | default: '/collections/all' }}" class="hp49-hero__btn-primary">
        <span>{{ section.settings.btn_text | default: 'Explore Dream Collection' }}</span>
        <span>&rarr;</span>
      </a>
    </div>
  </div>

  <div class="hp49-hero__media-bubble">
    {%- if section.settings.image != blank -%}
      <img height="{{ section.settings.image.height }}" width="{{ section.settings.image.width }}" src="{{ section.settings.image | image_url: width: 1000 }}" class="hp49-hero__img" alt="{{ section.settings.heading }}" loading="eager">
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'hp49-hero__img' }}
    {%- endif -%}

    <div class="hp49-hero__floating-card">
      <div>
        <p class="hp49-hero__float-title">Alpine Lavender &amp; Peptides</p>
        <p class="hp49-hero__float-sub">Cloud Moisture &amp; Calming Barrier</p>
      </div>
      <span>🌸</span>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "HP49 - Lavender Hero",
  "class": "section-hp49-hero",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#F5F3FF" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#2E1065" },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#7C3AED" },
    { "type": "color", "id": "btn_bg", "label": "Button Background", "default": "#7C3AED" },
    { "type": "color", "id": "btn_text_color", "label": "Button Text Color", "default": "#FFFFFF" },
    { "type": "text", "id": "badge", "label": "Badge", "default": "LAVENDER BLOSSOM DREAM v49" },
    { "type": "textarea", "id": "heading", "label": "Heading (HTML allowed)", "default": "Dreamy Lavender & <span>Pastel Blossom</span> Radiance" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Gentle French Alpine lavender hydrosols and cherry blossom peptides." },
    { "type": "text", "id": "btn_text", "label": "Button Text", "default": "Explore Dream Collection" },
    { "type": "url", "id": "btn_url", "label": "Button URL" },
    { "type": "image_picker", "id": "image", "label": "Hero Image" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "presets": [
    { "name": "HP49 - Lavender Hero" }
  ]
}
{% endschema %}
