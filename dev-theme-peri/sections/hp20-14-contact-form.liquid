{%- liquid
  assign sec_id = section.id
-%}

<style>
  #shopify-section-{{ sec_id }} {
    background-color: {{ section.settings.bg_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px 0;
  }

  .hp20-contact-{{ sec_id }} {
    max-width: 600px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp20-contact-{{ sec_id }}__header {
    text-align: center;
    margin-bottom: 60px;
  }

  .hp20-contact-{{ sec_id }}__title {
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 300;
    color: {{ section.settings.text_color }};
    margin: 0 0 16px 0;
    letter-spacing: -0.02em;
  }

  .hp20-contact-{{ sec_id }}__text {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 15px;
    color: {{ section.settings.text_color }};
    opacity: 0.7;
    margin: 0;
  }

  .hp20-contact-form {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .hp20-contact-field {
    position: relative;
  }

  .hp20-contact-input {
    width: 100%;
    background: transparent;
    border: none;
    border-bottom: 1px solid {{ section.settings.text_color | color_modify: 'alpha', 0.2 }};
    padding: 8px 0;
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-size: 16px;
    color: {{ section.settings.text_color }};
    outline: none;
    transition: border-color 0.3s ease;
  }

  .hp20-contact-input:focus {
    border-color: {{ section.settings.text_color }};
  }

  .hp20-contact-label {
    position: absolute;
    top: 8px;
    left: 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: {{ section.settings.text_color }};
    opacity: 0.5;
    pointer-events: none;
    transition: all 0.3s ease;
  }

  .hp20-contact-input:focus ~ .hp20-contact-label,
  .hp20-contact-input:not(:placeholder-shown) ~ .hp20-contact-label {
    top: -16px;
    font-size: 9px;
    opacity: 0.8;
  }

  .hp20-contact-textarea {
    resize: vertical;
    min-height: 100px;
  }

  .hp20-contact-submit {
    align-self: flex-start;
    padding: 16px 40px;
    background-color: {{ section.settings.text_color }};
    color: {{ section.settings.bg_color }};
    border: none;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    cursor: pointer;
    transition: opacity 0.3s ease;
  }

  .hp20-contact-submit:hover {
    opacity: 0.8;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ sec_id }} {
      padding: {{ section.settings.padding_top_mobile }}px 0 {{ section.settings.padding_bottom_mobile }}px 0;
    }
    .hp20-contact-submit {
      width: 100%;
    }
  }
</style>

<section class="hp20-contact-{{ sec_id }}">
  <div class="hp20-contact-{{ sec_id }}__header">
    <h2 class="hp20-contact-{{ sec_id }}__title">{{ section.settings.title }}</h2>
    {% if section.settings.text != blank %}
      <p class="hp20-contact-{{ sec_id }}__text">{{ section.settings.text }}</p>
    {% endif %}
  </div>

  {% form 'contact', class: 'hp20-contact-form' %}
    {% if form.posted_successfully? %}
      <div style="color: #10B981; font-size: 14px; text-align: center; margin-bottom: 24px;">Thanks for reaching out. We'll be in touch soon.</div>
    {% elsif form.errors %}
      <div style="color: #EF4444; font-size: 14px; text-align: center; margin-bottom: 24px;">Please check your input and try again.</div>
    {% endif %}

    <div style="display: flex; gap: 24px;">
      <div class="hp20-contact-field" style="flex: 1;">
        <input type="text" id="ContactFormName" name="contact[name]" class="hp20-contact-input" placeholder=" ">
        <label for="ContactFormName" class="hp20-contact-label">Name</label>
      </div>
      <div class="hp20-contact-field" style="flex: 1;">
        <input type="email" id="ContactFormEmail" name="contact[email]" class="hp20-contact-input" placeholder=" " required>
        <label for="ContactFormEmail" class="hp20-contact-label">Email</label>
      </div>
    </div>

    <div class="hp20-contact-field">
      <input type="tel" id="ContactFormPhone" name="contact[phone]" class="hp20-contact-input" placeholder=" ">
      <label for="ContactFormPhone" class="hp20-contact-label">Phone</label>
    </div>

    <div class="hp20-contact-field">
      <textarea id="ContactFormMessage" name="contact[body]" class="hp20-contact-input hp20-contact-textarea" placeholder=" " required></textarea>
      <label for="ContactFormMessage" class="hp20-contact-label">Message</label>
    </div>

    <button type="submit" class="hp20-contact-submit">{{ section.settings.btn_label }}</button>
  {% endform %}
</section>

{% schema %}
{
  "name": "HP20 Contact Form",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Get in Touch"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "We would love to hear from you."
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "Send Message"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1a1a1a"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0, "max": 160, "step": 10, "unit": "px",
      "label": "Desktop Top Padding", "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0, "max": 160, "step": 10, "unit": "px",
      "label": "Desktop Bottom Padding", "default": 120
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0, "max": 100, "step": 10, "unit": "px",
      "label": "Mobile Top Padding", "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0, "max": 100, "step": 10, "unit": "px",
      "label": "Mobile Bottom Padding", "default": 60
    }
  ],
  "presets": [
    {
      "name": "HP20 Contact Form"
    }
  ]
}
{% endschema %}
