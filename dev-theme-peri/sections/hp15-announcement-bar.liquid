{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#000000'
  assign text_color = section.settings.text_color | default: '#ffffff'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    color: {{ text_color }};
    padding: 10px 20px;
    text-align: center;
    position: relative;
    z-index: 100;
  }
  
  .hp15-announcement-{{ section_id }} {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.75rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    font-weight: 400;
    margin: 0;
  }
  
  .hp15-announcement-{{ section_id }} a {
    color: {{ text_color }};
    text-decoration: none;
    border-bottom: 1px solid {{ text_color }};
    padding-bottom: 2px;
    transition: opacity 0.3s ease;
  }
  
  .hp15-announcement-{{ section_id }} a:hover {
    opacity: 0.7;
  }

@media screen and (max-width: 768px) {
  .hp15-announcement-bar {
    padding-left: 16px !important;
    padding-right: 16px !important;
    box-sizing: border-box !important;
  }
  img {
    max-width: 100% !important;
    height: auto !important;
  }
}

</style>

<div class="hp15-announcement-{{ section_id }}">
  {{ section.settings.text | default: 'COMPLIMENTARY SHIPPING ON ORDERS OVER $200. <a href="#">SHOP NOW</a>' }}
</div>

{% schema %}
{
  "name": "HP15 Announcement Bar",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "html",
      "id": "text",
      "label": "Announcement Text",
      "default": "COMPLIMENTARY SHIPPING ON ORDERS OVER $200. <a href=\"#\">SHOP NOW</a>"
    }
  ],
  "presets": [
    {
      "name": "HP15 Announcement Bar"
    }
  ]
}
{% endschema %}
