{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,500&family=Inter:wght@300;400;500;600&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --font-heading: 'Cormorant Garamond', serif;
    --font-body: 'Inter', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.8 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.8 | round }}px;
    }
  }

  .hp26-founder-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    align-items: center;
    gap: 100px;
  }

  @media screen and (max-width: 1024px) {
    .hp26-founder-wrapper {
      gap: 60px;
    }
  }

  @media screen and (max-width: 768px) {
    .hp26-founder-wrapper {
      flex-direction: column;
      padding: 0 20px;
      gap: 50px;
    }
  }

  /* Image Column */
  .hp26-founder__image-col {
    flex: 1;
    position: relative;
    max-width: 450px;
  }

  .hp26-founder__image-wrapper {
    position: relative;
    aspect-ratio: 3/4;
    border-radius: 200px 200px 4px 4px; /* Arch shape */
    overflow: hidden;
    background-color: #EAE6DF;
    box-shadow: 0 20px 40px rgba(0,0,0,0.05);
  }

  .hp26-founder__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: sepia(0.2) contrast(0.9); /* Adds a slightly nostalgic/warm tone */
  }

  /* Decorative accent near image */
  .hp26-founder__accent {
    position: absolute;
    bottom: -20px;
    right: -20px;
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background-color: var(--accent-color);
    z-index: -1;
  }

  /* Content Column */
  .hp26-founder__content-col {
    flex: 1.2;
  }

  @media screen and (max-width: 768px) {
    .hp26-founder__content-col {
      text-align: center;
    }
  }

  .hp26-founder__greeting {
    font-family: var(--font-heading);
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    font-weight: 300;
    font-style: italic;
    color: var(--text-color);
    margin: 0 0 30px;
    line-height: 1.2;
  }

  .hp26-founder__body {
    font-family: var(--font-body);
    font-size: clamp(14px, 1.5vw, {{ section.settings.text_size }}px);
    line-height: 1.8;
    color: var(--text-color);
    opacity: 0.8;
    margin: 0 0 30px;
  }

  .hp26-founder__body p {
    margin: 0 0 20px;
  }

  .hp26-founder__body p:last-child {
    margin-bottom: 0;
  }

  .hp26-founder__signature {
    font-family: var(--font-heading);
    font-size: clamp(40px, 6vw, 60px);
    font-weight: 400;
    font-style: italic;
    color: var(--text-color);
    margin: 0 0 10px;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .hp26-founder__name-title {
    font-family: var(--font-body);
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-color);
    opacity: 0.6;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp26-founder-wrapper" id="HP26Founder-{{ section.id }}">
  <div class="hp26-founder__image-col">
    <div class="hp26-founder__image-wrapper">
      {%- if section.settings.image != blank -%}
        <img height="{{ section.settings.image.height }}" width="{{ section.settings.image.width }}" src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.name | escape }}" class="hp26-founder__image" loading="lazy">
      {%- else -%}
        <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:#2C2A28;font-family:var(--font-heading);">FOUNDER PORTRAIT</div>
      {%- endif -%}
    </div>
    <div class="hp26-founder__accent"></div>
  </div>

  <div class="hp26-founder__content-col">
    {%- if section.settings.greeting != blank -%}
      <h2 class="hp26-founder__greeting">{{ section.settings.greeting }}</h2>
    {%- endif -%}

    {%- if section.settings.body != blank -%}
      <div class="hp26-founder__body">{{ section.settings.body }}</div>
    {%- endif -%}

    {%- if section.settings.signature != blank -%}
      <div class="hp26-founder__signature">{{ section.settings.signature }}</div>
    {%- endif -%}

    <div class="hp26-founder__name-title">
      {{ section.settings.name }} {%- if section.settings.title != blank -%}&nbsp;|&nbsp; {{ section.settings.title }}{%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "HP26 - Japandi Founder",
  "class": "section-hp26-founder-note",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "greeting",
      "label": "Greeting",
      "default": "Dear kindred spirit,"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body Text",
      "default": "<p>When I started this journey, I sought to create pieces that force us to slow down, to breathe, and to appreciate the subtle beauty in our everyday rituals. This collection is a reflection of that desire—an invitation to live simply and intentionally.</p><p>Thank you for welcoming our craft into your sanctuary.</p>"
    },
    {
      "type": "text",
      "id": "signature",
      "label": "Signature Text (Stylized)",
      "default": "Elena"
    },
    {
      "type": "text",
      "id": "name",
      "label": "Founder Name",
      "default": "ELENA MARKS"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Founder Title",
      "default": "FOUNDER & DESIGNER"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Portrait Image"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 800,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1200
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Greeting Size",
      "default": 42
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Text Size",
      "default": 16
    },
    {
      "type": "header",
      "content": "Japandi Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#F5F2EB"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2C2A28"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#8B9582"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 100
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP26 - Japandi Founder"
    }
  ]
}
{% endschema %}
