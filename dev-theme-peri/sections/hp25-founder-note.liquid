{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,100..900;1,9..144,100..900&family=Outfit:wght@300;400;600;800&family=Caveat:wght@700&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-orange: {{ section.settings.accent_orange }};
    --accent-yellow: {{ section.settings.accent_yellow }};
    --font-heading: 'Fraunces', serif;
    --font-body: 'Outfit', sans-serif;
    --font-hand: 'Caveat', cursive;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    position: relative;
    /* Subtle grainy texture */
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.03'/%3E%3C/svg%3E");
    overflow: hidden;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }

  .hp25-founder-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
    position: relative;
    z-index: 1;
  }

  @media screen and (max-width: 768px) {
    .hp25-founder-wrapper {
      padding: 0 20px;
    }
  }

  .hp25-founder__container {
    display: flex;
    align-items: center;
    gap: 60px;
    background: var(--bg-color);
    border: 5px solid var(--text-color);
    border-radius: 60px 20px 60px 20px;
    padding: 60px;
    box-shadow: 15px 15px 0 var(--accent-orange);
  }

  @media screen and (max-width: 992px) {
    .hp25-founder__container {
      flex-direction: column;
      padding: 40px 30px;
      text-align: center;
      border-radius: 40px 15px 40px 15px;
      gap: 40px;
    }
  }

  /* Image Column */
  .hp25-founder__image-col {
    flex: 0 0 40%;
    position: relative;
  }

  .hp25-founder__image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 4/5;
    border: 4px solid var(--text-color);
    border-radius: 50% 50% 10% 10% / 30% 30% 10% 10%; /* Arch shape */
    overflow: hidden;
    background: var(--accent-yellow);
    z-index: 2;
  }

  .hp25-founder__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: sepia(0.3) contrast(1.1);
  }

  /* Decorative blob behind image */
  .hp25-founder__image-bg {
    position: absolute;
    top: -20px;
    right: -20px;
    width: 100%;
    height: 100%;
    background: var(--accent-yellow);
    border-radius: 40% 60% 70% 30% / 40% 50% 60% 50%;
    z-index: 1;
    border: 3px dashed var(--text-color);
  }

  @media screen and (max-width: 992px) {
    .hp25-founder__image-col {
      width: 70%;
      margin: 0 auto;
    }
  }

  /* Content Column */
  .hp25-founder__content-col {
    flex: 1;
  }

  .hp25-founder__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    font-weight: 900;
    font-style: italic;
    color: var(--text-color);
    margin: 0 0 20px;
    line-height: 1.1;
    text-shadow: 2px 2px 0 var(--accent-yellow);
  }

  .hp25-founder__text {
    font-family: var(--font-body);
    font-size: clamp(16px, 2vw, {{ section.settings.text_size }}px);
    color: var(--text-color);
    line-height: 1.6;
    font-weight: 600;
    margin: 0 0 30px;
  }

  .hp25-founder__signature {
    font-family: var(--font-hand);
    font-size: 42px;
    color: var(--accent-orange);
    transform: rotate(-5deg);
    display: inline-block;
    line-height: 1;
  }

  .hp25-founder__name {
    display: block;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 800;
    text-transform: uppercase;
    color: var(--text-color);
    margin-top: 10px;
    letter-spacing: 2px;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp25-founder-wrapper" id="HP25Founder-{{ section.id }}">
  <div class="hp25-founder__container">
    
    <div class="hp25-founder__image-col">
      <div class="hp25-founder__image-bg"></div>
      <div class="hp25-founder__image-wrapper">
        {%- if section.settings.image != blank -%}
          <img height="{{ section.settings.image.height }}" width="{{ section.settings.image.width }}" src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.title | escape }}" class="hp25-founder__image" loading="lazy">
        {%- else -%}
          <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-family:var(--font-heading);font-style:italic;font-size:24px;color:var(--text-color);">PHOTO</div>
        {%- endif -%}
      </div>
    </div>

    <div class="hp25-founder__content-col">
      {%- if section.settings.title != blank -%}
        <h2 class="hp25-founder__title">{{ section.settings.title }}</h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="hp25-founder__text">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if section.settings.signature != blank -%}
        <div class="hp25-founder__signature">{{ section.settings.signature }}</div>
      {%- endif -%}

      {%- if section.settings.name != blank -%}
        <div class="hp25-founder__name">{{ section.settings.name }}</div>
      {%- endif -%}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "HP25 - Retro Founder",
  "class": "section-hp25-founder-note",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Behind the Vibes"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>We started this journey to bring back the good times. Peace, love, and quality threads. Stay groovy.</p>"
    },
    {
      "type": "text",
      "id": "signature",
      "label": "Signature Text",
      "default": "Peace out,"
    },
    {
      "type": "text",
      "id": "name",
      "label": "Name & Title",
      "default": "JANE DOE, FOUNDER"
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Founder Image"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 800,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1200
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 48
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Text Size",
      "default": 18
    },
    {
      "type": "header",
      "content": "Retro 70s Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#E2B144"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text / Border (Dark Brown)",
      "default": "#3E2723"
    },
    {
      "type": "color",
      "id": "accent_orange",
      "label": "Accent (Burnt Orange)",
      "default": "#D15F3C"
    },
    {
      "type": "color",
      "id": "accent_yellow",
      "label": "Accent (Mustard)",
      "default": "#F5E6D3"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP25 - Retro Founder"
    }
  ]
}
{% endschema %}
