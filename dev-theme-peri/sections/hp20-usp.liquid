{%- style -%}
  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --border-color: {{ section.settings.border_color }};
    --border-thickness: {{ section.settings.border_thickness }}px;
    --shadow-color: {{ section.settings.shadow_color }};
    --shadow-offset: {{ section.settings.shadow_offset }}px;
    --card-bg: {{ section.settings.card_bg }};
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }

  .hp20-usp-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  {% if section.settings.title != blank %}
  .hp20-usp__header {
    text-align: {{ section.settings.header_alignment }};
    margin-bottom: {{ section.settings.header_margin }}px;
    border-bottom: var(--border-thickness) solid var(--border-color);
    padding-bottom: 24px;
  }

  .hp20-usp__title {
    font-family: 'Inter', sans-serif;
    font-weight: 900;
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    color: var(--text-color);
    text-transform: uppercase;
    letter-spacing: -1px;
    margin: 0;
  }
  {% endif %}

  .hp20-usp__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.desktop_columns }}, 1fr);
    gap: {{ section.settings.grid_gap }}px;
  }

  @media screen and (max-width: 992px) {
    .hp20-usp__grid {
      grid-template-columns: repeat({{ section.settings.tablet_columns }}, 1fr);
    }
  }

  @media screen and (max-width: 768px) {
    .hp20-usp__grid {
      grid-template-columns: repeat({{ section.settings.mobile_columns }}, 1fr);
      gap: {{ section.settings.mobile_grid_gap }}px;
    }
  }

  .hp20-usp__card {
    background: var(--card-bg);
    border: var(--border-thickness) solid var(--border-color);
    padding: {{ section.settings.card_padding }}px;
    text-align: {{ section.settings.card_alignment }};
    box-shadow: var(--shadow-offset) var(--shadow-offset) 0px var(--shadow-color);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    display: flex;
    flex-direction: column;
    align-items: {% if section.settings.card_alignment == 'center' %}center{% elsif section.settings.card_alignment == 'right' %}flex-end{% else %}flex-start{% endif %};
  }

  {% if section.settings.enable_hover_fx %}
  .hp20-usp__card:hover {
    transform: translate(calc(var(--shadow-offset) * -0.5), calc(var(--shadow-offset) * -0.5));
    box-shadow: calc(var(--shadow-offset) * 1.5) calc(var(--shadow-offset) * 1.5) 0px var(--shadow-color);
  }
  {% endif %}

  .hp20-usp__icon {
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;
    margin-bottom: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .hp20-usp__icon svg,
  .hp20-usp__icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .hp20-usp__card-title {
    font-family: 'Inter', sans-serif;
    font-weight: 800;
    font-size: {{ section.settings.card_title_size }}px;
    color: var(--text-color);
    text-transform: uppercase;
    margin: 0 0 12px;
  }

  .hp20-usp__card-text {
    font-family: 'Inter', sans-serif;
    font-size: {{ section.settings.card_text_size }}px;
    font-weight: 500;
    color: var(--text-color);
    line-height: 1.5;
    margin: 0;
    opacity: 0.9;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp20-usp-wrapper" id="HP20USP-{{ section.id }}">
  
  {% if section.settings.title != blank %}
  <div class="hp20-usp__header">
    <h2 class="hp20-usp__title">{{ section.settings.title | escape }}</h2>
  </div>
  {% endif %}

  <div class="hp20-usp__grid">
    {%- for block in section.blocks -%}
      <div class="hp20-usp__card" {{ block.shopify_attributes }}>
        
        <div class="hp20-usp__icon" style="color: {{ block.settings.icon_color | default: section.settings.text_color }}">
          {%- if block.settings.custom_image != blank -%}
            <img height="{{ block.settings.custom_image.height }}" width="{{ block.settings.custom_image.width }}" src="{{ block.settings.custom_image | image_url: width: 200 }}" alt="" loading="lazy">
          {%- elsif block.settings.svg_code != blank -%}
            {{ block.settings.svg_code }}
          {%- else -%}
            <!-- Fallback built-in icon -->
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
            </svg>
          {%- endif -%}
        </div>

        {%- if block.settings.title != blank -%}
          <h3 class="hp20-usp__card-title">{{ block.settings.title | escape }}</h3>
        {%- endif -%}

        {%- if block.settings.text != blank -%}
          <p class="hp20-usp__card-text">{{ block.settings.text | escape }}</p>
        {%- endif -%}
        
      </div>
    {%- endfor -%}
  </div>

</div>

{% schema %}
{
  "name": "HP20 - Brutalist USP",
  "class": "section-hp20-usp",
  "max_blocks": 6,
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "NO EXCUSES. JUST FACTS."
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 48
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "header_margin",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Margin Below Header",
      "default": 40
    },
    {
      "type": "header",
      "content": "Grid Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 800,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1400
    },
    {
      "type": "range",
      "id": "desktop_columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Desktop Columns",
      "default": 3
    },
    {
      "type": "range",
      "id": "tablet_columns",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Tablet Columns",
      "default": 2
    },
    {
      "type": "range",
      "id": "mobile_columns",
      "min": 1,
      "max": 2,
      "step": 1,
      "label": "Mobile Columns",
      "default": 1
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 10,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Grid Gap (Desktop)",
      "default": 32
    },
    {
      "type": "range",
      "id": "mobile_grid_gap",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Grid Gap (Mobile)",
      "default": 24
    },
    {
      "type": "header",
      "content": "Card Styling"
    },
    {
      "type": "select",
      "id": "card_alignment",
      "label": "Card Content Alignment",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "flex-start"
    },
    {
      "type": "range",
      "id": "card_padding",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Card Padding",
      "default": 30
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 20,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Icon Size",
      "default": 48
    },
    {
      "type": "range",
      "id": "card_title_size",
      "min": 14,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Card Title Size",
      "default": 20
    },
    {
      "type": "range",
      "id": "card_text_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Card Text Size",
      "default": 15
    },
    {
      "type": "header",
      "content": "Brutalist Styling"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Outer Background",
      "default": "#F4F4F0"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "border_thickness",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "Border Thickness",
      "default": 3
    },
    {
      "type": "color",
      "id": "shadow_color",
      "label": "Hard Shadow Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "shadow_offset",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Hard Shadow Offset",
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "enable_hover_fx",
      "label": "Enable Card Hover Jump",
      "default": true
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "usp_card",
      "name": "USP Block",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "FAST SHIPPING"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Next day delivery available on all orders."
        },
        {
          "type": "html",
          "id": "svg_code",
          "label": "Custom SVG Code",
          "info": "Paste raw SVG code here for the icon"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom Image Icon (Overrides SVG)"
        },
        {
          "type": "color",
          "id": "icon_color",
          "label": "Icon Color (if SVG)",
          "default": "#E2FF00"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP20 - Brutalist USP",
      "blocks": [
        { "type": "usp_card", "settings": { "title": "DURABLE" } },
        { "type": "usp_card", "settings": { "title": "BOLD" } },
        { "type": "usp_card", "settings": { "title": "GUARANTEED" } }
      ]
    }
  ]
}
{% endschema %}
