{%- comment -%}
  PC V30 — POP ART VIBRANT COLLAGE PRODUCT GRID
  Design: Lemon Yellow (#FEF08A), Cobalt Blue (#2563EB) & Hot Pink (#EC4899) accents, Fredoka & Space Grotesk typography
  Card Shape: 14px corners, 3px black borders, 6px hard pop drop shadows
{%- endcomment -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Fredoka:wght@600;700&family=Space+Grotesk:wght@600;700;800&display=swap');

  .pcv30 {
    --bg: {{ section.settings.bg_color | default: '#FEF08A' }};
    --card-bg: {{ section.settings.card_bg | default: '#FFFFFF' }};
    --text: {{ section.settings.text_color | default: '#0F172A' }};
    --muted: {{ section.settings.muted_color | default: '#2563EB' }};
    --accent: {{ section.settings.accent_color | default: '#2563EB' }};
    --accent-hover: {{ section.settings.accent_hover | default: '#1D4ED8' }};
    --border: {{ section.settings.border_color | default: '#000000' }};
    --badge-sale-bg: #EC4899;
    --badge-sale-text: #FFFFFF;
    --f-heading: 'Fredoka', cursive;
    --f-body: 'Space Grotesk', sans-serif;
    --r-card: 14px;
    --ease: all 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    background-color: var(--bg);
    color: var(--text);
    font-family: var(--f-body);
    padding: {{ section.settings.padding_top | default: 56 }}px 0 {{ section.settings.padding_bottom | default: 56 }}px 0;
    line-height: 1.4;
    -webkit-font-smoothing: antialiased;
  }

  .pcv30 *, .pcv30 *::before, .pcv30 *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .pcv30 a { color: inherit; text-decoration: none; }
  .pcv30 button { font-family: inherit; cursor: pointer; border: none; background: none; }
  .pcv30 img { max-width: 100%; display: block; }

  .pcv30__wrap { max-width: 1280px; margin: 0 auto; padding: 0 20px; }

  /* HEADER */
  .pcv30__head { display: flex; flex-direction: column; gap: 8px; margin-bottom: 36px; text-align: {{ section.settings.header_align | default: 'center' }}; }
  @media (min-width: 768px) {
    .pcv30__head { display: flex; flex-direction: row; justify-content: space-between; align-items: flex-end; }
  }
  .pcv30__title { font-family: var(--f-heading); font-size: 32px; font-weight: 700; color: var(--text); letter-spacing: -0.01em; }
  @media (min-width: 768px) { .pcv30__title { font-size: 42px; } }
  .pcv30__sub { font-size: 16px; color: var(--muted); font-weight: 600; }
  .pcv30__viewall { display: inline-flex; align-items: center; gap: 8px; font-weight: 700; font-size: 13px; font-family: var(--f-heading); text-transform: uppercase; color: #FFFFFF; background: var(--accent); padding: 10px 22px; border-radius: 20px; border: 3px solid var(--border); box-shadow: 4px 4px 0 var(--border); transition: var(--ease); }
  .pcv30__viewall:hover { background: #EC4899; transform: translate(-2px, -2px); box-shadow: 6px 6px 0 var(--border); }

  /* GRID */
  .pcv30__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr);
    gap: 18px;
  }
  @media (min-width: 640px) {
    .pcv30__grid { grid-template-columns: repeat({{ section.settings.cols_tablet | default: 3 }}, 1fr); gap: 24px; }
  }
  @media (min-width: 1024px) {
    .pcv30__grid { grid-template-columns: repeat({{ section.settings.cols_desktop | default: 4 }}, 1fr); gap: 28px; }
  }

  /* CARD */
  .pcv30__card {
    background: var(--card-bg);
    border: 3px solid var(--border);
    border-radius: var(--r-card);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    position: relative;
    box-shadow: 6px 6px 0 var(--border);
    transition: var(--ease);
  }
  .pcv30__card:hover {
    transform: translate(-3px, -3px) rotate(1deg);
    box-shadow: 10px 10px 0 var(--border);
  }

  /* IMAGE CONTAINER */
  .pcv30__img-box {
    position: relative;
    width: 100%;
    aspect-ratio: {{ section.settings.img_ratio | default: '1/1' }};
    background: #E2E8F0;
    overflow: hidden;
    border-bottom: 3px solid var(--border);
  }
  .pcv30__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .pcv30__img--sec {
    position: absolute;
    top: 0; left: 0;
    opacity: 0;
  }
  .pcv30__card:hover .pcv30__img--pri {
    {% if section.settings.enable_sec_img %}
      opacity: 0;
    {% else %}
      transform: scale(1.06);
    {% endif %}
  }
  .pcv30__card:hover .pcv30__img--sec { opacity: 1; transform: scale(1.06); }

  /* BADGES */
  .pcv30__badges { position: absolute; top: 12px; left: 12px; display: flex; flex-direction: column; gap: 6px; z-index: 2; pointer-events: none; }
  .pcv30__badge { font-size: 11px; font-weight: 700; text-transform: uppercase; padding: 4px 10px; border-radius: 12px; border: 2px solid var(--border); letter-spacing: 0.05em; font-family: var(--f-heading); }
  .pcv30__badge--sale { background: var(--badge-sale-bg); color: var(--badge-sale-text); }
  .pcv30__badge--tag { background: #FEF08A; color: #000000; }
  .pcv30__badge--sold { background: #64748B; color: #FFFFFF; }

  /* WISHLIST BUTTON */
  .pcv30__wish {
    position: absolute;
    top: 12px; right: 12px;
    width: 38px; height: 38px;
    border-radius: 50%;
    background: #FFFFFF;
    border: 2.5px solid var(--border);
    box-shadow: 3px 3px 0 var(--border);
    display: flex; align-items: center; justify-content: center;
    color: #EC4899;
    z-index: 3;
    transition: var(--ease);
  }
  .pcv30__wish:hover { background: #EC4899; color: #FFFFFF; transform: scale(1.1); }
  .pcv30__wish.active { background: #EC4899; color: #FFFFFF; }

  /* QUICK ADD BUTTON */
  .pcv30__quick-box { padding: 12px; background: var(--card-bg); }
  .pcv30__quick-btn {
    width: 100%;
    padding: 10px 16px;
    background: var(--accent);
    color: #FFFFFF;
    font-size: 13px; font-weight: 700; font-family: var(--f-heading);
    border-radius: 20px;
    border: 2px solid var(--border);
    box-shadow: 3px 3px 0 var(--border);
    display: flex; align-items: center; justify-content: center; gap: 8px;
    transition: var(--ease);
  }
  .pcv30__quick-btn:hover { background: var(--accent-hover); transform: translate(-2px, -2px); box-shadow: 5px 5px 0 var(--border); }
  .pcv30__quick-btn:disabled { background: #CBD5E1; color: #64748B; cursor: not-allowed; box-shadow: none; }

  /* CARD CONTENT */
  .pcv30__content { padding: 14px; display: flex; flex-direction: column; gap: 6px; flex-grow: 1; text-align: center; }

  .pcv30__vendor { font-size: 11px; text-transform: uppercase; color: var(--accent); font-weight: 700; letter-spacing: 0.08em; }
  .pcv30__item-title { font-family: var(--f-heading); font-size: 17px; font-weight: 700; color: var(--text); line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  /* RATING */
  .pcv30__rating { display: flex; align-items: center; justify-content: center; gap: 4px; font-size: 13px; color: #EAB308; font-weight: 700; }
  .pcv30__stars { letter-spacing: 1px; }
  .pcv20__rev-cnt { color: var(--muted); font-size: 11px; font-weight: 600; }

  /* PRICE */
  .pcv30__price-row { display: flex; align-items: baseline; justify-content: center; gap: 8px; margin-top: auto; padding-top: 4px; }
  .pcv30__price { font-size: 18px; font-weight: 700; color: var(--text); font-family: var(--f-heading); }
  .pcv30__cmp-price { font-size: 13px; color: var(--muted); text-decoration: line-through; }

  /* SWATCHES */
  .pcv30__swatches { display: flex; gap: 6px; align-items: center; justify-content: center; margin-top: 4px; }
  .pcv30__swatch { width: 14px; height: 14px; border-radius: 50%; border: 2px solid var(--border); cursor: pointer; transition: var(--ease); }
  .pcv30__swatch:hover, .pcv30__swatch.active { transform: scale(1.25); border-color: var(--accent); }

  /* URGENCY MICRO */
  .pcv30__urgency { font-size: 11px; color: #EC4899; font-weight: 700; font-family: var(--f-heading); display: flex; align-items: center; justify-content: center; gap: 4px; margin-top: 2px; }

  /* TOAST */
  .pcv30__toast {
    position: fixed; bottom: 20px; right: 20px;
    background: var(--accent); color: #FFFFFF;
    border: 3px solid var(--border); padding: 12px 22px; border-radius: 20px;
    font-size: 13px; font-weight: 700; font-family: var(--f-heading);
    z-index: 9999;
    transform: translateY(100px); opacity: 0;
    transition: all 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    box-shadow: 4px 4px 0 var(--border);
  }
  .pcv30__toast.show { transform: translateY(0); opacity: 1; }
</style>

<div class="pcv30">
  <div class="pcv30__wrap">
    
    {% if section.settings.title != blank or section.settings.subheading != blank %}
      <div class="pcv30__head">
        <div>
          {% if section.settings.title != blank %}
            <h2 class="pcv30__title">{{ section.settings.title | escape }}</h2>
          {% endif %}
          {% if section.settings.subheading != blank %}
            <p class="pcv30__sub">{{ section.settings.subheading | escape }}</p>
          {% endif %}
        </div>
        {% if section.settings.show_view_all and section.settings.collection != blank %}
          <a href="{{ collections[section.settings.collection].url }}" class="pcv30__viewall">
            {{ section.settings.view_all_label | default: 'Shop Pop Collage' }} ⚡ &rarr;
          </a>
        {% endif %}
      </div>
    {% endif %}

    <div class="pcv30__grid">
      {% assign target_coll = collections[section.settings.collection] %}
      {% assign limit_num = section.settings.products_per_page | default: 8 %}

      {% if target_coll != blank and target_coll.products.size > 0 %}
        {% for product in target_coll.products limit: limit_num %}
          {% assign current_variant = product.selected_or_first_available_variant %}
          
          {% render 'card-v30', product: product, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v30', product: nil, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% endif %}
    </div>

  </div>
</div>

<div class="pcv30__toast" id="pcv30-toast">POP ITEM ADDED!</div>

<script>
(function(){
  // Wishlist is handled globally by assets/wishlist.js (shared store: cf_wishlist_items).
  // Buttons are rendered by snippets/wishlist-button.liquid — no per-section storage.


  document.querySelectorAll('[data-pcv30-add]').forEach(function(btn){
    btn.addEventListener('click', function(e){
      e.preventDefault(); e.stopPropagation();
      var id = btn.dataset.pcv30Add, orig = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = 'GRABBING...';

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: id, quantity: 1 })
      })
      .then(function(r){ return r.json(); })
      .then(function(){
        btn.innerHTML = '✓ GRABBED';
        showT('POP ITEM ADDED!');
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      })
      .catch(function(){
        btn.innerHTML = 'ERROR';
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      });
    });
  });

  function showT(msg){
    var t = document.getElementById('pcv30-toast');
    if(!t) return;
    t.textContent = msg;
    t.classList.add('show');
    setTimeout(function(){ t.classList.remove('show'); }, 3000);
  }
})();
</script>

