{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#f4f1de'
  assign text_color = section.settings.text_color | default: '#6b705c'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 80px 40px;
    border-bottom: 1px solid rgba(107, 112, 92, 0.1);
  }
  
  .hp14-usp-container-{{ section_id }} {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 40px;
    text-align: center;
  }
  
  .hp14-usp-item-{{ section_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  
  .hp14-usp-icon-{{ section_id }} {
    width: 60px;
    height: 60px;
    background: #ffe8d6;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
    color: {{ text_color }};
  }
  
  .hp14-usp-icon-{{ section_id }} svg {
    width: 30px;
    height: 30px;
  }
  
  .hp14-usp-title-{{ section_id }} {
    font-family: 'Georgia', serif;
    font-size: 1.2rem;
    color: {{ text_color }};
    margin: 0 0 10px 0;
  }
  
  .hp14-usp-text-{{ section_id }} {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.9rem;
    color: #6b705c;
    line-height: 1.5;
    margin: 0;
  }

  @media (max-width: 992px) {
    .hp14-usp-container-{{ section_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 60px 20px;
    }
    .hp14-usp-container-{{ section_id }} {
      grid-template-columns: 1fr;
    }
  }
</style>

<div class="hp14-usp-container-{{ section_id }}">
  {% for block in section.blocks limit: 4 %}
    <div class="hp14-usp-item-{{ section_id }}" {{ block.shopify_attributes }}>
      <div class="hp14-usp-icon-{{ section_id }}">
        {% if block.settings.icon == 'leaf' %}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22c4.97-4.97 8-9.97 8-14 0-4.42-3.58-8-8-8s-8 3.58-8 8c0 4.03 3.03 9.03 8 14z"></path></svg>
        {% elsif block.settings.icon == 'heart' %}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
        {% elsif block.settings.icon == 'shield' %}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
        {% else %}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><path d="M12 8v4l3 3"></path></svg>
        {% endif %}
      </div>
      <h3 class="hp14-usp-title-{{ section_id }}">{{ block.settings.title }}</h3>
      <p class="hp14-usp-text-{{ section_id }}">{{ block.settings.text }}</p>
    </div>
  {% endfor %}
</div>

{% schema %}
{
  "name": "HP14 USP",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f4f1de"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#6b705c"
    }
  ],
  "blocks": [
    {
      "type": "usp",
      "name": "USP Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "leaf", "label": "Leaf" },
            { "value": "heart", "label": "Heart" },
            { "value": "shield", "label": "Shield" },
            { "value": "clock", "label": "Clock" }
          ],
          "default": "leaf"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "100% Organic"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Sourced directly from earth's finest botanicals."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP14 USP",
      "blocks": [
        { "type": "usp", "settings": { "icon": "leaf", "title": "100% Organic", "text": "Sourced directly from earth's finest botanicals." } },
        { "type": "usp", "settings": { "icon": "heart", "title": "Cruelty-Free", "text": "We never test on animals, only willing humans." } },
        { "type": "usp", "settings": { "icon": "shield", "title": "Dermatologist Tested", "text": "Safe and gentle for all skin types." } },
        { "type": "usp", "settings": { "icon": "clock", "title": "Sustainable Packaging", "text": "Our bottles are made from 100% recycled materials." } }
      ]
    }
  ]
}
{% endschema %}
