{%- liquid
  assign bg_color = section.settings.bg_color | default: '#0a0a0a'
  assign text_color = section.settings.text_color | default: '#ffffff'
  assign accent_color = section.settings.accent_color | default: '#00ffcc'
  
  assign padding_top_desktop = section.settings.padding_top_desktop
  assign padding_bottom_desktop = section.settings.padding_bottom_desktop
  assign padding_top_mobile = section.settings.padding_top_mobile
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile
-%}

<style>
  #shopify-section-{{ section.id }} {
    --hp3-story-bg: {{ bg_color }};
    --hp3-story-text: {{ text_color }};
    --hp3-story-accent: {{ accent_color }};
    
    --hp3-story-pt-desk: {{ padding_top_desktop }}px;
    --hp3-story-pb-desk: {{ padding_bottom_desktop }}px;
    --hp3-story-pt-mob: {{ padding_top_mobile }}px;
    --hp3-story-pb-mob: {{ padding_bottom_mobile }}px;
  }

  .hp3-tech-story-{{ section.id }} {
    padding-top: var(--hp3-story-pt-desk);
    padding-bottom: var(--hp3-story-pb-desk);
    background-color: var(--hp3-story-bg);
    color: var(--hp3-story-text);
    font-family: 'Inter', sans-serif;
    position: relative;
    overflow: hidden;
  }

  /* Techy Grid Background */
  .hp3-tech-story-{{ section.id }}::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-image: 
      linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
    background-size: 40px 40px;
    z-index: 1;
  }

  .hp3-story-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 60px;
  }

  /* Reversed Layout */
  .hp3-story-inner.layout-right {
    flex-direction: row-reverse;
  }

  /* Media Side */
  .hp3-story-media-wrapper {
    flex: 1;
    position: relative;
  }

  .hp3-story-media {
    width: 100%;
    aspect-ratio: 4/5;
    background: #111;
    border-radius: 12px;
    overflow: hidden;
    position: relative;
    box-shadow: 0 30px 60px rgba(0,0,0,0.5);
    border: 1px solid rgba(255,255,255,0.05);
  }

  .hp3-story-img, .hp3-story-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  /* Floating UI element over media */
  .hp3-story-hud {
    position: absolute;
    bottom: 30px;
    right: -30px;
    background: rgba(0,0,0,0.8);
    backdrop-filter: blur(10px);
    border: 1px solid var(--hp3-story-accent);
    padding: 20px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    gap: 15px;
    z-index: 3;
    animation: hp3StoryFloat 4s ease-in-out infinite;
  }
  .hp3-story-inner.layout-right .hp3-story-hud {
    right: auto;
    left: -30px;
  }

  .hp3-story-hud-icon {
    width: 40px; height: 40px;
    background: rgba(var(--hp3-story-accent-rgb, 0,255,204), 0.1);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--hp3-story-accent);
  }
  .hp3-story-hud-icon svg { width: 20px; height: 20px; }

  .hp3-story-hud-text {
    display: flex;
    flex-direction: column;
  }
  .hp3-story-hud-val { font-size: 20px; font-weight: 800; color: var(--hp3-story-accent); }
  .hp3-story-hud-lbl { font-size: 10px; text-transform: uppercase; letter-spacing: 1px; color: #fff; opacity: 0.7; }

  @keyframes hp3StoryFloat {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }

  /* Content Side */
  .hp3-story-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .hp3-story-badge {
    display: inline-block;
    padding: 6px 12px;
    background: rgba(var(--hp3-story-accent-rgb, 0,255,204), 0.1);
    color: var(--hp3-story-accent);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    border-radius: 4px;
    margin-bottom: 20px;
    align-self: flex-start;
  }

  .hp3-story-title {
    font-size: clamp(32px, 5vw, 56px);
    font-weight: 900;
    line-height: 1.1;
    margin: 0 0 30px 0;
    letter-spacing: -1px;
    text-transform: uppercase;
  }
  .hp3-story-title span {
    color: var(--hp3-story-accent);
  }

  .hp3-story-desc {
    font-size: 18px;
    line-height: 1.6;
    color: rgba(255,255,255,0.7);
    margin-bottom: 40px;
  }

  /* Features List */
  .hp3-story-features {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-bottom: 40px;
  }
  .hp3-story-feature {
    display: flex;
    align-items: flex-start;
    gap: 15px;
  }
  .hp3-story-feature-icon {
    width: 24px;
    height: 24px;
    color: var(--hp3-story-accent);
    flex-shrink: 0;
    margin-top: 2px;
  }
  .hp3-story-feature-text h4 {
    margin: 0 0 5px 0;
    font-size: 16px;
    font-weight: 700;
    text-transform: uppercase;
  }
  .hp3-story-feature-text p {
    margin: 0;
    font-size: 14px;
    color: rgba(255,255,255,0.6);
    line-height: 1.4;
  }

  .hp3-story-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 32px;
    background: transparent;
    color: var(--hp3-story-text);
    border: 2px solid var(--hp3-story-accent);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 4px;
    position: relative;
    overflow: hidden;
    transition: all 0.3s ease;
    align-self: flex-start;
  }
  .hp3-story-btn::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: var(--hp3-story-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s ease;
    z-index: -1;
  }
  .hp3-story-btn:hover {
    color: #000;
  }
  .hp3-story-btn:hover::before {
    transform: scaleX(1);
  }

  @media screen and (max-width: 1024px) {
    .hp3-story-inner {
      flex-direction: column !important;
      gap: 50px;
    }
    .hp3-story-media-wrapper, .hp3-story-content {
      width: 100%;
    }
    .hp3-story-hud {
      right: 20px;
      left: auto !important;
    }
  }

  @media screen and (max-width: 768px) {
    .hp3-tech-story-{{ section.id }} {
      padding-top: var(--hp3-story-pt-mob);
      padding-bottom: var(--hp3-story-pb-mob);
    }
    .hp3-story-inner {
      padding: 0 20px;
    }
    .hp3-story-hud {
      display: none; /* Hide on mobile to save space */
    }
    .hp3-story-desc {
      font-size: 16px;
    }
    .hp3-story-btn {
      width: 100%;
    }
  }
</style>

<section class="hp3-tech-story-{{ section.id }}" aria-label="Brand Story">
  <div class="hp3-story-inner layout-{{ section.settings.layout }}">
    
    <div class="hp3-story-media-wrapper">
      <div class="hp3-story-media">
        {%- if section.settings.video != blank -%}
          {{ section.settings.video | video_tag: class: 'hp3-story-video', autoplay: true, loop: true, muted: true, playsinline: true }}
        {%- elsif section.settings.image != blank -%}
          <img height="{{ section.settings.image.height }}" width="{{ section.settings.image.width }}" src="{{ section.settings.image | image_url: width: 1000 }}" 
               class="hp3-story-img" 
               loading="lazy" 
               alt="Brand Story">
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'hp3-story-img placeholder-svg' }}
        {%- endif -%}
      </div>
      
      <div class="hp3-story-hud">
        <div class="hp3-story-hud-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12h4l3-9 5 18 3-9h5"/></svg>
        </div>
        <div class="hp3-story-hud-text">
          <span class="hp3-story-hud-val">{{ section.settings.stat_value | default: '99.9%' }}</span>
          <span class="hp3-story-hud-lbl">{{ section.settings.stat_label | default: 'RELIABILITY' }}</span>
        </div>
      </div>
    </div>

    <div class="hp3-story-content">
      {%- if section.settings.badge != blank -%}
        <div class="hp3-story-badge">{{ section.settings.badge }}</div>
      {%- endif -%}
      
      {%- if section.settings.heading != blank -%}
        <h2 class="hp3-story-title">{{ section.settings.heading }}</h2>
      {%- endif -%}
      
      {%- if section.settings.description != blank -%}
        <div class="hp3-story-desc">{{ section.settings.description }}</div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="hp3-story-features">
          {%- for block in section.blocks -%}
            <div class="hp3-story-feature" {{ block.shopify_attributes }}>
              <svg class="hp3-story-feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <div class="hp3-story-feature-text">
                <h4>{{ block.settings.title }}</h4>
                <p>{{ block.settings.text }}</p>
              </div>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.btn_text != blank and section.settings.btn_link != blank -%}
        <a href="{{ section.settings.btn_link }}" class="hp3-story-btn">{{ section.settings.btn_text }}</a>
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "HP3 Brand Story",
  "tag": "section",
  "class": "section-hp3-story",
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video (Overrides Image)"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Media Position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "HUD Stats"
    },
    {
      "type": "text",
      "id": "stat_value",
      "label": "Statistic Value",
      "default": "100K+"
    },
    {
      "type": "text",
      "id": "stat_label",
      "label": "Statistic Label",
      "default": "USERS WORLDWIDE"
    },
    {
      "type": "header",
      "content": "Text Content"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "default": "OUR MISSION"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "BUILT FOR THE <span>FUTURE.</span>",
      "info": "Use <span> for accent color"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>We bridge the gap between high-end performance and everyday usability. Our hardware is designed to empower creators, gamers, and professionals alike.</p>"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "DISCOVER OUR TECH"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#0a0a0a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#00ffcc"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Top (Desktop)", "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Bottom (Desktop)", "default": 100
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Top (Mobile)", "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Bottom (Mobile)", "default": 60
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Bullet",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Premium Materials"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Aerospace-grade aluminum chassis."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP3 Brand Story (Adv)",
      "category": "About",
      "blocks": [
        { "type": "feature", "settings": { "title": "CUSTOM ARCHITECTURE", "text": "Proprietary chips for maximum output." } },
        { "type": "feature", "settings": { "title": "THERMAL COOLING", "text": "Advanced vapor chamber technology." } }
      ]
    }
  ]
}
{% endschema %}
