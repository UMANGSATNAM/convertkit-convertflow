{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Chakra+Petch:ital,wght@0,300;0,400;0,600;0,700;1,400&family=Press+Start+2P&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --cyan: {{ section.settings.cyan_color }};
    --magenta: {{ section.settings.magenta_color }};
    --font-heading: 'Press Start 2P', cursive;
    --font-body: 'Chakra Petch', sans-serif;
    
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: #1C0B2B; /* Base background behind the banner */
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.8 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.8 | round }}px;
    }
  }

  .hp28-offer-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp28-offer-wrapper {
      padding: 0 20px;
    }
  }

  .hp28-offer__banner {
    position: relative;
    background-color: var(--bg-color);
    border: 4px dashed var(--text-color);
    padding: 60px 40px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    box-shadow: 15px 15px 0 var(--magenta);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    text-decoration: none;
    overflow: hidden;
  }

  /* Animated scanline specific to banner */
  .hp28-offer__banner::before {
    content: '';
    position: absolute;
    top: -100%; left: 0; width: 100%; height: 50%;
    background: linear-gradient(to bottom, transparent, rgba(255, 255, 255, 0.4), transparent);
    animation: hp28Scan 4s infinite linear;
    pointer-events: none;
  }

  @keyframes hp28Scan {
    0% { top: -100%; }
    100% { top: 200%; }
  }

  .hp28-offer__banner:hover {
    transform: translate(-4px, -4px);
    box-shadow: 23px 23px 0 var(--cyan);
  }

  .hp28-offer__label {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 700;
    color: var(--text-color);
    background: #000;
    padding: 6px 12px;
    margin-bottom: 25px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    border: 2px solid var(--text-color);
    {%- if section.settings.enable_pulse -%}
      animation: hp28Pulse 2s infinite;
    {%- endif -%}
  }

  @keyframes hp28Pulse {
    0% { opacity: 1; }
    50% { opacity: 0.4; }
    100% { opacity: 1; }
  }

  .hp28-offer__title {
    font-family: var(--font-heading);
    font-size: clamp(24px, 4vw, {{ section.settings.title_size }}px);
    color: var(--text-color);
    margin: 0 0 20px;
    line-height: 1.3;
    text-transform: uppercase;
    text-shadow: 3px 3px 0 #000;
  }

  .hp28-offer__text {
    font-family: var(--font-body);
    font-size: clamp(16px, 2vw, 20px);
    font-weight: 600;
    color: var(--text-color);
    margin: 0 0 30px;
    max-width: 600px;
  }

  .hp28-offer__code {
    display: inline-block;
    background: #000;
    color: var(--cyan);
    font-family: var(--font-heading);
    font-size: 18px;
    padding: 15px 30px;
    border: 2px solid var(--cyan);
    box-shadow: 4px 4px 0 var(--magenta);
    text-transform: uppercase;
  }

  .hp28-offer__banner:hover .hp28-offer__code {
    color: var(--magenta);
    border-color: var(--magenta);
    box-shadow: 4px 4px 0 var(--cyan);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp28-offer-wrapper" id="HP28Offer-{{ section.id }}">
  <a href="{{ section.settings.link_url | default: '#' }}" class="hp28-offer__banner">
    
    {%- if section.settings.label != blank -%}
      <div class="hp28-offer__label">{{ section.settings.label }}</div>
    {%- endif -%}

    {%- if section.settings.title != blank -%}
      <h2 class="hp28-offer__title">{{ section.settings.title }}</h2>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <p class="hp28-offer__text">{{ section.settings.text }}</p>
    {%- endif -%}

    {%- if section.settings.code != blank -%}
      <div class="hp28-offer__code">USE CODE: {{ section.settings.code }}</div>
    {%- endif -%}

  </a>
</div>

{% schema %}
{
  "name": "HP28 - Y2K Offer Banner",
  "class": "section-hp28-offer-banner",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Small Label",
      "default": "SYSTEM ALERT"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Heading",
      "default": "CRITICAL UPDATE\nAVAILABLE NOW"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Upgrade your hardware array with a 20% discount on all active units."
    },
    {
      "type": "text",
      "id": "code",
      "label": "Promo Code",
      "default": "CYBER20"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Banner Link"
    },
    {
      "type": "checkbox",
      "id": "enable_pulse",
      "label": "Enable Pulse Animation on Label",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 800,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1200
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 48
    },
    {
      "type": "header",
      "content": "Y2K Cyber Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Banner Background (Acid Green)",
      "default": "#39FF14"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text/Border Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "cyan_color",
      "label": "Cyan Accent",
      "default": "#00FFFF"
    },
    {
      "type": "color",
      "id": "magenta_color",
      "label": "Magenta Accent",
      "default": "#FF00FF"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP28 - Y2K Offer Banner"
    }
  ]
}
{% endschema %}
