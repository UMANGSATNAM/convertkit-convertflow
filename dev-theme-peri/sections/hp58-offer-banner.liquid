{%- style -%}
  #shopify-section-{{ section.id }} {
    background: radial-gradient(circle at 20% 50%, #1E1B4B 0%, #0B0F19 100%);
    color: #FFFFFF;
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
    border-top: 1px solid rgba(6, 182, 212, 0.2);
    border-bottom: 1px solid rgba(139, 92, 246, 0.2);
  }
  .hp58-offer__container { max-width: {{ section.settings.container_width | default: 1280 }}px; margin: 0 auto; padding: 0 24px; display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; }
  .hp58-offer__eyebrow { font-family: 'Space Grotesk', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: #06B6D4; margin: 0 0 16px; }
  .hp58-offer__heading { font-family: 'Syne', sans-serif; font-size: clamp(28px, 4vw, 48px); font-weight: 800; color: #FFFFFF; margin: 0 0 18px; line-height: 1.1; }
  .hp58-offer__desc { font-size: 15px; line-height: 1.7; color: #94A3B8; margin: 0 0 30px; }
  .hp58-offer__btn {
    display: inline-flex; align-items: center; gap: 10px; padding: 16px 36px;
    background: #06B6D4; color: #0B0F19; font-family: 'Space Grotesk', sans-serif;
    font-size: 13px; font-weight: 700; text-decoration: none; border-radius: 4px;
    box-shadow: 0 0 25px rgba(6, 182, 212, 0.4); transition: all 0.3s ease;
  }
  .hp58-offer__btn:hover { box-shadow: 0 0 35px rgba(6, 182, 212, 0.7); transform: translateY(-2px); }
  .hp58-offer__img-wrap { border-radius: 12px; overflow: hidden; height: 400px; border: 1px solid rgba(6, 182, 212, 0.3); box-shadow: 0 0 30px rgba(6, 182, 212, 0.15); }
  .hp58-offer__img { width: 100%; height: 100%; object-fit: cover; }
  @media screen and (max-width: 992px) { .hp58-offer__container { grid-template-columns: 1fr; text-align: center; } .hp58-offer__img-wrap { height: 300px; } }
{%- endstyle -%}
<div class="hp58-offer__container">
  <div>
    <p class="hp58-offer__eyebrow">{{ section.settings.eyebrow | default: '⚡ SPECIAL PROTOCOL' }}</p>
    <h2 class="hp58-offer__heading">{{ section.settings.heading | default: 'The Quantum Matrix Kit' }}</h2>
    <p class="hp58-offer__desc">{{ section.settings.description | default: 'Equip your skin with our full 3-step cellular synthesis system — Peptide 7X, Cyber-Algae Elixir, and Photoshield Mist at 30% savings.' }}</p>
    <a href="{{ section.settings.btn_url | default: '/collections/all' }}" class="hp58-offer__btn">{{ section.settings.btn_label | default: 'Initiate Protocol' }} &rarr;</a>
  </div>
  <div class="hp58-offer__img-wrap">
    {%- if section.settings.image != blank -%}<img height="{{ section.settings.image.height }}" width="{{ section.settings.image.width }}" src="{{ section.settings.image | image_url: width: 800 }}" class="hp58-offer__img" alt="{{ section.settings.heading }}" loading="lazy">
    {%- else -%}{{ 'product-1' | placeholder_svg_tag: 'hp58-offer__img' }}{%- endif -%}
  </div>
</div>
{% schema %}
{
  "name": "HP58 Offer",
  "class": "section-hp58-offer",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "⚡ SPECIAL PROTOCOL" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Quantum Matrix Kit" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Equip your skin with our full 3-step cellular synthesis system." },
    { "type": "text", "id": "btn_label", "label": "Button Label", "default": "Initiate Protocol" },
    { "type": "url", "id": "btn_url", "label": "Button URL" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 80 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "presets": [{ "name": "HP58 Offer" }]
}
{% endschema %}
