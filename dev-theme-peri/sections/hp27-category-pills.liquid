{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600&family=Syncopate:wght@400;700&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --font-heading: 'Syncopate', sans-serif;
    --font-body: 'Space Grotesk', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    border-bottom: 1px solid rgba(226, 226, 226, 0.1);
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.8 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.8 | round }}px;
    }
  }

  .hp27-cat-pills-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  @media screen and (max-width: 768px) {
    .hp27-cat-pills-wrapper {
      padding: 0 20px;
    }
  }

  .hp27-cat-pills__title {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-color);
    margin: 0 0 30px;
    opacity: 0.5;
  }

  .hp27-cat-pills__container {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 15px;
  }

  .hp27-cat-pills__item {
    display: inline-flex;
    align-items: center;
    padding: 12px 24px;
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--text-color);
    background: transparent;
    border: 1px solid rgba(226, 226, 226, 0.2);
    position: relative;
    overflow: hidden;
    transition: all 0.3s ease;
  }

  .hp27-cat-pills__item::before {
    content: '';
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background: var(--accent-color);
    transform: translateY(100%);
    transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
    z-index: 0;
  }

  .hp27-cat-pills__item span {
    position: relative;
    z-index: 1;
    transition: color 0.3s ease;
  }

  .hp27-cat-pills__item:hover {
    border-color: var(--accent-color);
  }

  .hp27-cat-pills__item:hover::before {
    transform: translateY(0);
  }

  .hp27-cat-pills__item:hover span {
    color: #fff;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp27-cat-pills-wrapper" id="HP27CatPills-{{ section.id }}">
  {%- if section.settings.title != blank -%}
    <div class="hp27-cat-pills__title">{{ section.settings.title }}</div>
  {%- endif -%}

  <div class="hp27-cat-pills__container">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.link | default: '#' }}" class="hp27-cat-pills__item" {{ block.shopify_attributes }}>
        <span>{{ block.settings.title }}</span>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "HP27 - Eng Cat Pills",
  "class": "section-hp27-category-pills",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "SYSTEM DIRECTORY"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 800,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1200
    },
    {
      "type": "header",
      "content": "Dark Engineered Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#0A0A0A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#E2E2E2"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#FF2A2A"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 50
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Button",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "CATEGORY_01"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP27 - Eng Cat Pills",
      "blocks": [
        { "type": "category", "settings": { "title": "ALL SYSTEMS" } },
        { "type": "category", "settings": { "title": "CORE MODULES" } },
        { "type": "category", "settings": { "title": "EXPANSIONS" } },
        { "type": "category", "settings": { "title": "PROTOTYPES" } },
        { "type": "category", "settings": { "title": "ARCHIVE" } }
      ]
    }
  ]
}
{% endschema %}
