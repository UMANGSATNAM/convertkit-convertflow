{%- liquid
  assign bg_color = section.settings.bg_color | default: '#2c2c2c'
  assign text_color = section.settings.text_color | default: '#f9f6f0'
  
  assign padding_top_desktop = section.settings.padding_top_desktop
  assign padding_bottom_desktop = section.settings.padding_bottom_desktop
  assign padding_top_mobile = section.settings.padding_top_mobile
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile
-%}

<style>
  #shopify-section-{{ section.id }} {
    --hp4-story-bg: {{ bg_color }};
    --hp4-story-text: {{ text_color }};
    
    --hp4-story-pt-desk: {{ padding_top_desktop }}px;
    --hp4-story-pb-desk: {{ padding_bottom_desktop }}px;
    --hp4-story-pt-mob: {{ padding_top_mobile }}px;
    --hp4-story-pb-mob: {{ padding_bottom_mobile }}px;
  }

  .hp4-decor-story-{{ section.id }} {
    padding-top: var(--hp4-story-pt-desk);
    padding-bottom: var(--hp4-story-pb-desk);
    background-color: var(--hp4-story-bg);
    color: var(--hp4-story-text);
    font-family: 'Inter', sans-serif;
  }

  .hp4-story-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    align-items: center;
    gap: 80px;
  }

  /* Reversed Layout */
  .hp4-story-inner.layout-right {
    flex-direction: row-reverse;
  }

  /* Image Layout - Artistic Collage */
  .hp4-story-media {
    flex: 1;
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 600px;
  }

  .hp4-story-img-main {
    width: 70%;
    aspect-ratio: 3/4;
    background: #e8e3d8;
    position: relative;
    z-index: 1;
  }
  .hp4-story-img-main img {
    width: 100%; height: 100%; object-fit: cover;
  }

  .hp4-story-img-offset {
    width: 45%;
    aspect-ratio: 1/1;
    background: #dcd7cb;
    position: absolute;
    bottom: 50px;
    right: 0;
    z-index: 2;
    border: 10px solid var(--hp4-story-bg);
  }
  .hp4-story-inner.layout-right .hp4-story-img-offset {
    right: auto;
    left: 0;
  }
  .hp4-story-img-offset img {
    width: 100%; height: 100%; object-fit: cover;
  }

  /* Content */
  .hp4-story-content {
    flex: 1;
    max-width: 500px;
  }

  .hp4-story-badge {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: rgba(249,246,240,0.6);
    margin-bottom: 20px;
    display: block;
  }

  .hp4-story-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(36px, 5vw, 56px);
    font-weight: 400;
    margin: 0 0 30px 0;
    line-height: 1.1;
  }
  .hp4-story-title em {
    font-style: italic;
    color: rgba(249,246,240,0.7);
  }

  .hp4-story-desc {
    font-size: 16px;
    line-height: 1.8;
    color: rgba(249,246,240,0.8);
    margin-bottom: 40px;
    font-weight: 300;
  }
  .hp4-story-desc p {
    margin-bottom: 15px;
  }

  .hp4-story-btn {
    display: inline-flex;
    padding-bottom: 5px;
    color: var(--hp4-story-text);
    border-bottom: 1px solid var(--hp4-story-text);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.3s ease;
  }
  .hp4-story-btn:hover {
    color: rgba(249,246,240,0.6);
    border-color: rgba(249,246,240,0.6);
  }

  @media screen and (max-width: 1024px) {
    .hp4-story-inner {
      flex-direction: column !important;
      gap: 60px;
    }
    .hp4-story-media, .hp4-story-content {
      width: 100%;
      max-width: 100%;
    }
    .hp4-story-img-main {
      width: 80%;
    }
  }

  @media screen and (max-width: 768px) {
    .hp4-decor-story-{{ section.id }} {
      padding-top: var(--hp4-story-pt-mob);
      padding-bottom: var(--hp4-story-pb-mob);
    }
    .hp4-story-inner {
      padding: 0 20px;
    }
    .hp4-story-media {
      min-height: 400px;
    }
    .hp4-story-img-main {
      width: 90%;
    }
    .hp4-story-img-offset {
      width: 50%;
      bottom: 20px;
      border-width: 5px;
    }
  }
</style>

<section class="hp4-decor-story-{{ section.id }}" aria-label="Brand Story">
  <div class="hp4-story-inner layout-{{ section.settings.layout }}">
    
    <div class="hp4-story-media">
      <div class="hp4-story-img-main">
        {%- if section.settings.image_1 != blank -%}
          <img height="{{ section.settings.image_1.height }}" width="{{ section.settings.image_1.width }}" src="{{ section.settings.image_1 | image_url: width: 800 }}" loading="lazy" alt="Brand Story Main">
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
      
      <div class="hp4-story-img-offset">
        {%- if section.settings.image_2 != blank -%}
          <img height="{{ section.settings.image_2.height }}" width="{{ section.settings.image_2.width }}" src="{{ section.settings.image_2 | image_url: width: 400 }}" loading="lazy" alt="Brand Story Detail">
        {%- else -%}
          {{ 'product-3' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
    </div>

    <div class="hp4-story-content">
      {%- if section.settings.badge != blank -%}
        <span class="hp4-story-badge">{{ section.settings.badge }}</span>
      {%- endif -%}
      
      {%- if section.settings.heading != blank -%}
        <h2 class="hp4-story-title">{{ section.settings.heading }}</h2>
      {%- endif -%}
      
      {%- if section.settings.description != blank -%}
        <div class="hp4-story-desc">{{ section.settings.description }}</div>
      {%- endif -%}
      
      {%- if section.settings.btn_text != blank and section.settings.btn_link != blank -%}
        <a href="{{ section.settings.btn_link }}" class="hp4-story-btn">{{ section.settings.btn_text }}</a>
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "HP4 Decor Brand Story",
  "tag": "section",
  "class": "section-hp4-story",
  "settings": [
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Main Large Image"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Offset Small Image"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Image Position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "default": "OUR PHILOSOPHY"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Design rooted in <em>intention</em>."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>We believe your home should be a reflection of who you are. Every piece in our collection is thoughtfully designed and ethically sourced to bring lasting beauty into your space.</p>"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "LEARN MORE ABOUT US"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#2c2c2c"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#f9f6f0"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Top (Desktop)", "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Bottom (Desktop)", "default": 120
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Top (Mobile)", "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Bottom (Mobile)", "default": 60
    }
  ],
  "presets": [
    {
      "name": "HP4 Decor Brand Story",
      "category": "About"
    }
  ]
}
{% endschema %}
