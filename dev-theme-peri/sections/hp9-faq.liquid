{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#050505'
  assign text_color = section.settings.text_color | default: '#ffffff'
  assign accent_color = section.settings.accent_color | default: '#00ff88'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 100px 20px;
    color: {{ text_color }};
    position: relative;
  }
  
  .hp9-faq-container-{{ section_id }} {
    max-width: 1000px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }
  
  .hp9-faq-header-{{ section_id }} {
    text-align: center;
    margin-bottom: 60px;
  }
  
  .hp9-faq-subheading-{{ section_id }} {
    font-family: 'Space Mono', monospace;
    font-size: 0.9rem;
    font-weight: 700;
    color: {{ accent_color }};
    margin: 0 0 10px 0;
    letter-spacing: 2px;
    text-transform: uppercase;
  }
  
  .hp9-faq-heading-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 900;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: -1px;
  }
  
  .hp9-faq-accordion-{{ section_id }} {
    border-top: 1px solid rgba(0, 255, 136, 0.2);
  }
  
  .hp9-faq-item-{{ section_id }} {
    border-bottom: 1px solid rgba(0, 255, 136, 0.2);
    overflow: hidden;
  }
  
  .hp9-faq-question-{{ section_id }} {
    width: 100%;
    text-align: left;
    background: transparent;
    border: none;
    color: {{ text_color }};
    font-family: 'Inter', sans-serif;
    font-size: 1.2rem;
    font-weight: 700;
    padding: 25px 0;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: all 0.3s ease;
  }
  
  .hp9-faq-question-{{ section_id }}:hover {
    color: {{ accent_color }};
    padding-left: 10px;
  }
  
  .hp9-faq-icon-{{ section_id }} {
    font-family: 'Space Mono', monospace;
    color: {{ accent_color }};
    font-size: 1.5rem;
    font-weight: 400;
    transition: transform 0.3s ease;
  }
  
  .hp9-faq-item-{{ section_id }}.active .hp9-faq-icon-{{ section_id }} {
    transform: rotate(45deg);
  }
  
  .hp9-faq-answer-{{ section_id }} {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease-out, padding 0.3s ease;
    padding: 0;
    font-family: 'Space Mono', monospace;
    font-size: 0.95rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.7);
    border-left: 2px solid transparent;
  }
  
  .hp9-faq-item-{{ section_id }}.active .hp9-faq-answer-{{ section_id }} {
    padding: 0 0 25px 15px;
    border-left-color: {{ accent_color }};
  }

  /* Glitch decoration */
  .hp9-faq-container-{{ section_id }}::before {
    content: '[ SYS_QUERY ]';
    position: absolute;
    top: -50px;
    left: 0;
    font-family: 'Space Mono', monospace;
    font-size: 4rem;
    font-weight: 900;
    color: rgba(255,255,255,0.02);
    pointer-events: none;
    z-index: -1;
  }
  
  @media (max-width: 768px) {
    .hp9-faq-question-{{ section_id }} {
      font-size: 1.1rem;
    }
    .hp9-faq-container-{{ section_id }}::before {
      font-size: 2.5rem;
      top: -30px;
    }
  }
</style>

<div class="hp9-faq-container-{{ section_id }}">
  <div class="hp9-faq-header-{{ section_id }}">
    <p class="hp9-faq-subheading-{{ section_id }}">{{ section.settings.subheading | default: '/// KNOWLEDGE_BASE' }}</p>
    <h2 class="hp9-faq-heading-{{ section_id }}">{{ section.settings.heading | default: 'FREQUENT QUERIES' }}</h2>
  </div>
  
  <div class="hp9-faq-accordion-{{ section_id }}">
    {% for block in section.blocks %}
      <div class="hp9-faq-item-{{ section_id }}" {{ block.shopify_attributes }}>
        <button class="hp9-faq-question-{{ section_id }}" aria-expanded="false">
          {{ block.settings.question | default: 'How do I initialize the system?' }}
          <span class="hp9-faq-icon-{{ section_id }}">+</span>
        </button>
        <div class="hp9-faq-answer-{{ section_id }}">
          <div style="padding-right: 20px;">
            {{ block.settings.answer | default: '<p>Connect the primary interface cable to your port. Wait for the green light, then run the initialization script provided in your manual.</p>' }}
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const items = document.querySelectorAll('.hp9-faq-item-{{ section_id }}');
    
    items.forEach(item => {
      const button = item.querySelector('.hp9-faq-question-{{ section_id }}');
      const answer = item.querySelector('.hp9-faq-answer-{{ section_id }}');
      
      button.addEventListener('click', () => {
        const isActive = item.classList.contains('active');
        
        // Close all
        items.forEach(otherItem => {
          otherItem.classList.remove('active');
          otherItem.querySelector('.hp9-faq-answer-{{ section_id }}').style.maxHeight = null;
          otherItem.querySelector('.hp9-faq-question-{{ section_id }}').setAttribute('aria-expanded', 'false');
        });
        
        // Open if wasn't active
        if (!isActive) {
          item.classList.add('active');
          answer.style.maxHeight = answer.scrollHeight + 50 + "px";
          button.setAttribute('aria-expanded', 'true');
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "HP9 FAQ",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#050505"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#00ff88"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "/// KNOWLEDGE_BASE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FREQUENT QUERIES"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How do I initialize the system?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Connect the primary interface cable to your port. Wait for the green light, then run the initialization script provided in your manual.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP9 FAQ",
      "blocks": [
        { "type": "faq" },
        { "type": "faq" },
        { "type": "faq" },
        { "type": "faq" }
      ]
    }
  ]
}
{% endschema %}
