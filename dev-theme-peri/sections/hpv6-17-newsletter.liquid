{%- liquid
  assign section_id = section.id
  assign layout = section.settings.layout | default: 'centered'
  
  assign bg_color = section.settings.bg_color | default: '#F7FAFC'
  assign text_color = section.settings.text_color | default: '#2D3748'
  assign input_border = section.settings.input_border | default: 'rgba(45, 55, 72, 0.4)'
  assign btn_bg = section.settings.btn_bg | default: '#2D3748'
  assign btn_text = section.settings.btn_text | default: '#FFFFFF'
  
  assign padding_top = section.settings.padding_top | default: 100
  assign padding_bottom = section.settings.padding_bottom | default: 100
  assign padding_top_mobile = section.settings.padding_top_mobile | default: 60
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile | default: 60
-%}

<style>
  #shopify-section-{{ section_id }} {
    --bg-color: {{ bg_color }};
    --text-color: {{ text_color }};
    --input-border: {{ input_border }};
    --btn-bg: {{ btn_bg }};
    --btn-text: {{ btn_text }};
    --padding-top: {{ padding_top }}px;
    --padding-bottom: {{ padding_bottom }}px;
    --padding-top-mobile: {{ padding_top_mobile }}px;
    --padding-bottom-mobile: {{ padding_bottom_mobile }}px;
    
    background-color: var(--bg-color);
    color: var(--text-color);
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
  }

  .hpv6-newsletter-{{ section_id }} {
    max-width: var(--page-width, 1440px);
    margin: 0 auto;
    padding: 0 5vw;
    {%- if layout == 'split' -%}
      display: flex;
      align-items: center;
      gap: 5vw;
    {%- endif -%}
  }

  .hpv6-newsletter__image-col {
    {%- if layout == 'split' -%}
      flex: 1 1 50%;
    {%- else -%}
      display: none;
    {%- endif -%}
  }

  .hpv6-newsletter__image-wrap {
    aspect-ratio: 4/3;
    background-color: #E2E8F0;
    overflow: hidden;
    position: relative;
    border-radius: 4px;
  }

  .hpv6-newsletter__image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hpv6-newsletter__content-col {
    {%- if layout == 'split' -%}
      flex: 1 1 50%;
    {%- else -%}
      max-width: 650px;
      margin: 0 auto;
      text-align: center;
    {%- endif -%}
  }

  .hpv6-newsletter__title {
    font-family: 'Playfair Display', 'Georgia', serif;
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    font-weight: 400;
    margin: 0 0 1.5rem 0;
    line-height: 1.2;
  }

  .hpv6-newsletter__text {
    font-family: 'Inter', sans-serif;
    font-size: 1rem;
    line-height: 1.6;
    margin-bottom: 3rem;
    opacity: 0.8;
  }

  /* Form Styles */
  .hpv6-newsletter__form {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    position: relative;
    max-width: 500px;
    {%- if layout == 'centered' -%}
      margin: 0 auto;
    {%- endif -%}
  }

  .hpv6-newsletter__input-group {
    flex: 1 1 250px;
    position: relative;
  }

  .hpv6-newsletter__input {
    width: 100%;
    padding: 16px 0;
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--input-border);
    color: var(--text-color);
    font-family: 'Inter', sans-serif;
    font-size: 1rem;
    outline: none;
    border-radius: 0;
    transition: border-color 0.3s ease;
  }

  .hpv6-newsletter__input::placeholder {
    color: var(--text-color);
    opacity: 0.5;
  }

  .hpv6-newsletter__input:focus {
    border-bottom-color: var(--text-color);
  }

  .hpv6-newsletter__btn {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 32px;
    background-color: var(--btn-bg);
    color: var(--btn-text);
    border: 1px solid var(--btn-bg);
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    letter-spacing: 1px;
    text-transform: uppercase;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .hpv6-newsletter__btn:hover,
  .hpv6-newsletter__btn:focus-visible {
    background-color: transparent;
    color: var(--text-color);
    border-color: var(--text-color);
    outline: none;
  }

  .hpv6-newsletter__message {
    width: 100%;
    margin-top: 1rem;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    text-align: left;
    {%- if layout == 'centered' -%}
      text-align: center;
    {%- endif -%}
  }

  .hpv6-newsletter__message--success {
    color: #276749; /* Green tone */
  }

  .hpv6-newsletter__message--error {
    color: #C53030; /* Red tone */
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding-top: var(--padding-top-mobile);
      padding-bottom: var(--padding-bottom-mobile);
    }
    
    .hpv6-newsletter-{{ section_id }} {
      flex-direction: column;
      gap: 3rem;
    }

    .hpv6-newsletter__image-col {
      width: 100%;
    }

    .hpv6-newsletter__content-col {
      width: 100%;
    }

    .hpv6-newsletter__form {
      flex-direction: column;
      max-width: 100%;
    }

    .hpv6-newsletter__btn {
      width: 100%;
    }
  }
</style>

<section class="hpv6-newsletter-{{ section_id }}">
  
  {%- if layout == 'split' -%}
    <div class="hpv6-newsletter__image-col">
      <div class="hpv6-newsletter__image-wrap">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 800 | image_tag: 
             loading: 'lazy',
             class: 'hpv6-newsletter__image',
             alt: section.settings.title | escape
          }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'hpv6-newsletter__image placeholder-svg' }}
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  <div class="hpv6-newsletter__content-col">
    {%- if section.settings.title != blank -%}
      <h2 class="hpv6-newsletter__title">{{ section.settings.title | escape }}</h2>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="hpv6-newsletter__text">{{ section.settings.text }}</div>
    {%- endif -%}
    
    {%- form 'customer', class: 'hpv6-newsletter__form', id: 'hpv6-newsletter-form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      
      <div class="hpv6-newsletter__input-group">
        <label for="NewsletterEmail-{{ section_id }}" class="visually-hidden">Email</label>
        <input type="email"
               id="NewsletterEmail-{{ section_id }}"
               name="contact[email]"
               class="hpv6-newsletter__input"
               value="{{ form.email }}"
               placeholder="{{ section.settings.placeholder_text | escape }}"
               aria-required="true"
               autocorrect="off"
               autocapitalize="off"
               {% if form.errors %}
                 aria-invalid="true"
                 aria-describedby="Newsletter-error-{{ section_id }}"
               {% elsif form.posted_successfully? %}
                 aria-describedby="Newsletter-success-{{ section_id }}"
               {% endif %}
               required>
      </div>

      <button type="submit" class="hpv6-newsletter__btn" name="commit">
        {{ section.settings.btn_label | escape }}
      </button>

      {%- if form.errors -%}
        <div class="hpv6-newsletter__message hpv6-newsletter__message--error" id="Newsletter-error-{{ section_id }}">
          {{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}
        </div>
      {%- endif -%}

      {%- if form.posted_successfully? -%}
        <div class="hpv6-newsletter__message hpv6-newsletter__message--success" id="Newsletter-success-{{ section_id }}" tabindex="-1" autofocus>
          Thanks for subscribing! Check your email to confirm.
        </div>
      {%- endif -%}
    {%- endform -%}
  </div>

</section>

{% schema %}
{
  "name": "HPV6 Newsletter",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Join the Inner Circle"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Subscribe to receive early access to new collections, exclusive event invitations, and thoughtfully curated design stories.</p>"
    },
    {
      "type": "text",
      "id": "placeholder_text",
      "label": "Input Placeholder",
      "default": "Enter your email address"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "Subscribe"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Section Layout",
      "options": [
        { "value": "centered", "label": "Centered" },
        { "value": "split", "label": "Image + Form (Split)" }
      ],
      "default": "centered"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Only used if 'Image + Form' layout is selected."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F7FAFC"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2D3748"
    },
    {
      "type": "color",
      "id": "input_border",
      "label": "Input Bottom Border",
      "default": "rgba(45, 55, 72, 0.4)"
    },
    {
      "type": "color",
      "id": "btn_bg",
      "label": "Button Background",
      "default": "#2D3748"
    },
    {
      "type": "color",
      "id": "btn_text",
      "label": "Button Text",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Desktop Padding Top",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Desktop Padding Bottom",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "HPV6 Newsletter"
    }
  ]
}
{% endschema %}
