{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Oswald:wght@700&family=Space+Grotesk:wght@400;700&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --border-color: {{ section.settings.border_color }};
    --accent-color: {{ section.settings.accent_color }};
    
    --font-heading: 'Oswald', sans-serif;
    --font-body: 'Space Grotesk', sans-serif;
    
    background-color: var(--bg-color);
    border-bottom: 4px solid var(--border-color);
  }

  .hp30-ugc-wrapper {
    max-width: 1800px;
    margin: 0 auto;
    border-left: 4px solid var(--border-color);
    border-right: 4px solid var(--border-color);
  }

  .hp30-ugc__header {
    padding: 40px;
    border-bottom: 4px solid var(--border-color);
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
  }

  @media screen and (max-width: 768px) {
    .hp30-ugc__header {
      flex-direction: column;
      align-items: flex-start;
      padding: 20px;
      gap: 20px;
    }
  }

  .hp30-ugc__title {
    font-family: var(--font-heading);
    font-size: clamp(40px, 8vw, {{ section.settings.title_size }}px);
    line-height: 1;
    text-transform: uppercase;
    color: var(--text-color);
    margin: 0;
    letter-spacing: -0.02em;
  }

  .hp30-ugc__tag {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--accent-color);
    border: 2px solid var(--accent-color);
    padding: 5px 15px;
  }

  .hp30-ugc__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
  }

  @media screen and (max-width: 992px) {
    .hp30-ugc__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media screen and (max-width: 768px) {
    .hp30-ugc__grid {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }
    .hp30-ugc__grid::-webkit-scrollbar {
      display: none;
    }
  }

  .hp30-ugc__item {
    position: relative;
    aspect-ratio: 9/16;
    border-right: 4px solid var(--border-color);
    background: #111;
    overflow: hidden;
    display: block;
    cursor: pointer;
  }

  @media screen and (min-width: 769px) {
    .hp30-ugc__item:nth-child({{ section.settings.columns_desktop }}n) {
      border-right: none;
    }
  }

  @media screen and (max-width: 768px) {
    .hp30-ugc__item {
      flex: 0 0 80%;
      scroll-snap-align: center;
      border-right: 4px solid var(--border-color);
    }
  }

  .hp30-ugc__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: contrast(130%) grayscale(60%);
    transition: filter 0s;
  }

  .hp30-ugc__item:hover .hp30-ugc__video {
    filter: contrast(100%) grayscale(0%);
  }

  .hp30-ugc__overlay {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    padding: 20px;
    background: linear-gradient(to top, rgba(0,0,0,0.9), transparent);
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
  }

  .hp30-ugc__handle {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 700;
    color: #fff;
    margin: 0;
    text-transform: uppercase;
  }

  .hp30-ugc__play {
    width: 30px;
    height: 30px;
    background: var(--accent-color);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hp30-ugc__play::after {
    content: '';
    width: 0;
    height: 0;
    border-top: 6px solid transparent;
    border-bottom: 6px solid transparent;
    border-left: 10px solid #fff;
    margin-left: 3px;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp30-ugc-wrapper" id="HP30UGC-{{ section.id }}">
  <div class="hp30-ugc__header">
    <h2 class="hp30-ugc__title">{{ section.settings.title }}</h2>
    <div class="hp30-ugc__tag">COMMUNITY SURVEILLANCE</div>
  </div>

  <div class="hp30-ugc__grid">
    {%- for block in section.blocks -%}
      <div class="hp30-ugc__item" {{ block.shopify_attributes }}>
        {%- if block.settings.video_url != blank -%}
          <video class="hp30-ugc__video" autoplay loop muted playsinline>
            <source src="{{ block.settings.video_url }}" type="video/mp4">
          </video>
        {%- else -%}
          {%- assign placeholder = 'collection-' | append: forloop.index -%}
          {%- if forloop.index > 6 -%}{%- assign placeholder = 'collection-1' -%}{%- endif -%}
          {{ placeholder | placeholder_svg_tag: 'hp30-ugc__video' }}
        {%- endif -%}

        <div class="hp30-ugc__overlay">
          <p class="hp30-ugc__handle">{{ block.settings.handle }}</p>
          <div class="hp30-ugc__play"></div>
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "HP30 - Brutalist UGC",
  "class": "section-hp30-ugc-reels",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "THE NETWORK"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 3,
      "max": 6,
      "step": 1,
      "label": "Columns (Desktop)",
      "default": 5
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 40,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "Heading Size",
      "default": 80
    },
    {
      "type": "header",
      "content": "Brutalist Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (Black)",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text (White)",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Borders (White)",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent (Red)",
      "default": "#FF0000"
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "UGC Video",
      "settings": [
        {
          "type": "text",
          "id": "video_url",
          "label": "MP4 Video URL"
        },
        {
          "type": "text",
          "id": "handle",
          "label": "User Handle",
          "default": "@USER_ID"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP30 - Brutalist UGC",
      "blocks": [
        { "type": "video" },
        { "type": "video" },
        { "type": "video" },
        { "type": "video" },
        { "type": "video" }
      ]
    }
  ]
}
{% endschema %}
