{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Space+Mono:ital,wght@0,400;0,700;1,400;1,700&family=Inter:wght@400;600;800&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    
    --font-heading: 'Space Mono', monospace;
    --font-body: 'Inter', sans-serif;
    
    background-color: var(--bg-color);
    border-bottom: 2px solid var(--text-color);
    /* Strict grid approach: the wrapper will handle borders internally */
  }

  .hp38-usp-wrapper {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    /* The trick for inner borders: grid gap + background color */
    background-color: var(--text-color);
    gap: 2px;
  }

  .hp38-usp__item {
    background-color: var(--bg-color);
    padding: 60px 40px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  @media screen and (max-width: 768px) {
    .hp38-usp__item {
      padding: 40px 20px;
    }
  }

  .hp38-usp__meta {
    font-family: var(--font-heading);
    font-size: 12px;
    font-weight: 700;
    color: var(--text-color);
    border: 1px solid var(--text-color);
    padding: 4px 8px;
    margin-bottom: 30px;
  }

  .hp38-usp__icon {
    width: 48px;
    height: 48px;
    margin-bottom: 20px;
    color: var(--accent-color);
  }
  .hp38-usp__icon svg {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
  }

  .hp38-usp__title {
    font-family: var(--font-heading);
    font-size: 24px;
    text-transform: uppercase;
    color: var(--text-color);
    margin: 0 0 15px;
  }

  .hp38-usp__text {
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.5;
    color: var(--text-color);
    margin: 0;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp38-usp-wrapper" id="HP38Usp-{{ section.id }}">
  {%- for block in section.blocks -%}
    <div class="hp38-usp__item" {{ block.shopify_attributes }}>
      <div class="hp38-usp__meta">IDX:0{{ forloop.index }}</div>
      
      {%- if block.settings.icon_svg != blank -%}
        <div class="hp38-usp__icon">{{ block.settings.icon_svg }}</div>
      {%- else -%}
        <div class="hp38-usp__icon">
          <!-- Fallback stark square -->
          <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" /></svg>
        </div>
      {%- endif -%}
      
      <h3 class="hp38-usp__title">{{ block.settings.title }}</h3>
      <p class="hp38-usp__text">{{ block.settings.text }}</p>
    </div>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "HP38 - Brutalist USP",
  "class": "section-hp38-usp",
  "settings": [
    {
      "type": "header",
      "content": "Brutalist Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text & Grid Lines",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#0000FF"
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "usp",
      "name": "USP Item",
      "settings": [
        {
          "type": "html",
          "id": "icon_svg",
          "label": "Icon SVG",
          "info": "Raw SVG code"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "RAPID DELIVERY"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Global logistics networks activated for 48hr delivery."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP38 - Brutalist USP",
      "blocks": [
        { "type": "usp", "settings": { "title": "RAPID DELIVERY" } },
        { "type": "usp", "settings": { "title": "SECURE PROTOCOL" } },
        { "type": "usp", "settings": { "title": "DATA ENCRYPTED" } }
      ]
    }
  ]
}
{% endschema %}
