{%- style -%}
  #shopify-section-{{ section.id }} {
    background: radial-gradient(circle at 50% 50%, #881337 0%, #1C1917 100%);
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
    border-top: 1px solid rgba(217, 119, 6, 0.3);
  }
  .hp63-news__container { max-width: {{ section.settings.container_width | default: 700 }}px; margin: 0 auto; padding: 0 24px; text-align: center; }
  .hp63-news__eyebrow { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: #F59E0B; margin: 0 0 16px; }
  .hp63-news__heading { font-family: 'Playfair Display', serif; font-size: clamp(28px, 4vw, 44px); font-weight: 700; color: #FFFFFF; margin: 0 0 16px; }
  .hp63-news__desc { font-size: 15px; line-height: 1.7; color: #E7E5E4; margin: 0 0 32px; }
  .hp63-news__form { display: flex; gap: 12px; max-width: 480px; margin: 0 auto; }
  .hp63-news__input {
    flex: 1; padding: 15px 22px; background: #FFFFFF; border: 1px solid rgba(217, 119, 6, 0.4);
    border-radius: 4px; color: #1C1917; font-family: 'Plus Jakarta Sans', sans-serif; font-size: 14px;
  }
  .hp63-news__input::placeholder { color: #A8A29E; }
  .hp63-news__btn {
    padding: 15px 32px; background: {{ section.settings.btn_bg | default: '#D97706' }};
    color: #FFFFFF; border: none; border-radius: 4px; font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 13px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase;
    cursor: pointer; transition: all 0.3s ease; box-shadow: 0 8px 25px rgba(217, 119, 6, 0.3);
  }
  .hp63-news__btn:hover { transform: translateY(-2px); box-shadow: 0 12px 35px rgba(217, 119, 6, 0.5); }
  @media screen and (max-width: 480px) { .hp63-news__form { flex-direction: column; } }
{%- endstyle -%}
<div class="hp63-news__container">
  {%- if section.settings.eyebrow != blank -%}<p class="hp63-news__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
  <h2 class="hp63-news__heading">{{ section.settings.heading | default: 'The Rose Guild Society' }}</h2>
  <p class="hp63-news__desc">{{ section.settings.description | default: 'Subscribe to receive private invitations to our seasonal Dades Valley rose harvest, amber distillation releases, and exclusive boutique privileges.' }}</p>
  {%- form 'customer', id: 'hp63-newsletter' -%}
    <input type="hidden" name="contact[tags]" value="newsletter">
    <div class="hp63-news__form">
      <input type="email" name="contact[email]" class="hp63-news__input" placeholder="{{ section.settings.placeholder | default: 'Your email address' }}" required>
      <button type="submit" class="hp63-news__btn">{{ section.settings.btn_label | default: 'Join Guild' }}</button>
    </div>
  {%- endform -%}
</div>
{% schema %}
{
  "name": "HP63 Newsletter",
  "class": "section-hp63-news",
  "settings": [
    { "type": "color", "id": "btn_bg", "label": "Button BG", "default": "#D97706" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "🌹 ROSE GUILD ACCESS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Rose Guild Society" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Subscribe to receive private invitations to our seasonal rose harvest." },
    { "type": "text", "id": "placeholder", "label": "Placeholder", "default": "Your email address" },
    { "type": "text", "id": "btn_label", "label": "Button Label", "default": "Join Guild" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 500, "max": 900, "step": 20, "unit": "px", "label": "Container Width", "default": 700 }
  ],
  "presets": [{ "name": "HP63 Newsletter" }]
}
{% endschema %}
