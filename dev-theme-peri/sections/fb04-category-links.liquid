{% comment %}
  FB04 Category Links — 2-column image blocks with text overlay
{% endcomment %}

<style>
  .fb04-cats {
    padding: 100px 60px;
    background: #fff;
  }
  .fb04-cats__inner {
    max-width: 1200px;
    margin: 0 auto;
  }
  .fb04-cats__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }
  .fb04-cats__card {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    aspect-ratio: 3 / 4;
    cursor: pointer;
  }
  .fb04-cats__card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .fb04-cats__card:hover img {
    transform: scale(1.05);
  }
  .fb04-cats__card .placeholder-cat {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #282A2F, #3D4047);
  }
  .fb04-cats__overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 40px 32px;
    background: linear-gradient(to top, rgba(0,0,0,0.6) 0%, transparent 100%);
    transition: background 0.3s ease;
  }
  .fb04-cats__card:hover .fb04-cats__overlay {
    background: linear-gradient(to top, rgba(0,0,0,0.75) 0%, transparent 100%);
  }
  .fb04-cats__label {
    font-family: 'Big Shoulders Display', sans-serif;
    font-weight: 700;
    font-size: 28px;
    color: #fff;
    text-transform: uppercase;
    letter-spacing: 2px;
  }

  @media (max-width: 809px) {
    .fb04-cats {
      padding: 60px 24px;
    }
    .fb04-cats__grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .fb04-cats__label {
      font-size: 22px;
    }
  }
  @media (min-width: 810px) and (max-width: 1199px) {
    .fb04-cats {
      padding: 80px 40px;
    }
  }
</style>

<section class="fb04-cats">
  <div class="fb04-cats__inner">
    <div class="fb04-cats__grid">
      {% for block in section.blocks %}
        <a href="{{ block.settings.link | default: '#' }}" class="fb04-cats__card" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            <img src="{{ block.settings.image | image_url: width: 800 }}"
                 alt="{{ block.settings.label }}" loading="lazy" width="800" height="1067">
          {% else %}
            <div class="placeholder-cat"></div>
          {% endif %}
          <div class="fb04-cats__overlay">
            <span class="fb04-cats__label">{{ block.settings.label }}</span>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FB04 Category Links",
  "tag": "section",
  "settings": [],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Category Image" },
        { "type": "text", "id": "label", "label": "Label", "default": "Women" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FB04 Category Links",
      "blocks": [
        { "type": "category", "settings": { "label": "Women" } },
        { "type": "category", "settings": { "label": "Men" } }
      ]
    }
  ]
}
{% endschema %}
