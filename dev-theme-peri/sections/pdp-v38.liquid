{%- comment -%}
  PDP V38 — INDUSTRIAL RAW CONCRETE HEAVY
  Design: Heavy industrial raw concrete brutalist aesthetic, Space Mono + Syne display body
  Concrete Gray (#64748B), Steel Dark (#1E293B), Warning Orange (#F97316), Off-White Concrete (#F8FAFC)
{%- endcomment -%}

{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign inv_qty = current_variant.inventory_quantity | default: 15 -%}
{%- if inv_qty <= 0 -%}{%- assign inv_qty = 10 -%}{%- endif -%}
{%- assign viewer_count = inv_qty | times: 8 | modulo: 50 | plus: 30 -%}
{%- assign sold_count = inv_qty | times: 15 | modulo: 400 | plus: 200 -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Space+Mono:wght@700&family=Syne:wght@600;700;800&display=swap');

  .pdpv38 {
    --bg: #F8FAFC; --surface: #FFFFFF; --border: #CBD5E1; --border-dark: #1E293B;
    --text: #0F172A; --muted: #64748B; --accent: #F97316; --accent-hover: #EA580C;
    --steel: #1E293B; --danger: #EF4444;
    --f-head: 'Space Mono', monospace; --f-body: 'Syne', sans-serif;
    --r: 2px; --r-pill: 9999px; --ease: all 0.2s ease;
    background: var(--bg); color: var(--text); font-family: var(--f-body); font-size: 16px; line-height: 1.4; -webkit-font-smoothing: antialiased;
  }
  .pdpv38 *, .pdpv38 *::before, .pdpv38 *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .pdpv38 img { max-width: 100%; display: block; }
  .pdpv38 button { font-family: inherit; cursor: pointer; }
  .pdpv38__wrap { max-width: 1280px; margin: 0 auto; padding: 0 20px; }

  /* OFFER BAR */
  .pdpv38__offer { background: var(--steel); color: var(--accent); padding: 12px; text-align: center; font-family: var(--f-head); font-size: 14px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; border-bottom: 3px solid var(--accent); }

  /* GRID */
  .pdpv38__grid { display: grid; grid-template-columns: 1fr; gap: 36px; padding: 36px 0; }
  @media (min-width: 992px) { .pdpv38__grid { grid-template-columns: 1.1fr 1fr; gap: 48px; padding: 48px 0; } }

  /* GALLERY */
  .pdpv38__gal { display: flex; flex-direction: column; gap: 12px; }
  .pdpv38__hero { width: 100%; aspect-ratio: 1; border-radius: var(--r); overflow: hidden; background: var(--surface); border: 3px solid var(--steel); display: flex; align-items: center; justify-content: center; box-shadow: 6px 6px 0px var(--steel); position: relative; }
  .pdpv38__hero img { width: 100%; height: 100%; object-fit: contain; }
  .pdpv38__raw-tag { position: absolute; top: 14px; left: 14px; background: var(--accent); color: #FFF; font-family: var(--f-head); font-size: 11px; font-weight: 700; padding: 4px 12px; border: 2px solid var(--steel); }

  .pdpv38__thumbs { display: flex; gap: 10px; overflow-x: auto; }
  .pdpv38__th { width: 64px; height: 64px; flex-shrink: 0; border: 2px solid var(--border); border-radius: 2px; overflow: hidden; cursor: pointer; background: var(--surface); transition: var(--ease); }
  .pdpv38__th:hover, .pdpv38__th.on { border-color: var(--accent); box-shadow: 3px 3px 0px var(--steel); }
  .pdpv38__th img { width: 100%; height: 100%; object-fit: cover; }

  /* INFO PANEL */
  .pdpv38__info { display: flex; flex-direction: column; gap: 18px; }
  .pdpv38__crumb { font-family: var(--f-head); font-size: 13px; letter-spacing: 2px; color: var(--accent); font-weight: 700; text-transform: uppercase; }
  .pdpv38__title { font-family: var(--f-body); font-size: 36px; font-weight: 800; line-height: 1.1; color: var(--text); text-transform: uppercase; }
  @media (min-width: 992px) { .pdpv38__title { font-size: 46px; } }

  .pdpv38__rating { display: flex; align-items: center; gap: 8px; font-size: 15px; color: var(--muted); font-weight: 700; }
  .pdpv38__stars { color: var(--accent); }

  /* PRICE CARD */
  .pdpv38__price-card { background: var(--surface); border: 3px solid var(--steel); border-radius: var(--r); padding: 16px 20px; display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 10px; box-shadow: 4px 4px 0px var(--steel); }
  .pdpv38__price { font-family: var(--f-head); font-size: 38px; font-weight: 700; color: var(--accent); }
  .pdpv38__cmp { font-size: 22px; color: var(--muted); text-decoration: line-through; }
  .pdpv38__badge { background: var(--steel); color: var(--accent); font-family: var(--f-head); font-weight: 700; font-size: 13px; padding: 4px 12px; border-radius: 2px; }

  /* VARIANTS */
  .pdpv38__vlabel { font-family: var(--f-head); font-size: 13px; font-weight: 700; text-transform: uppercase; color: var(--steel); margin-bottom: 8px; }
  .pdpv38__vopts { display: flex; flex-wrap: wrap; gap: 10px; }
  .pdpv38__vr { display: none; }
  .pdpv38__vbtn { padding: 10px 22px; border: 2px solid var(--steel); border-radius: var(--r); background: var(--surface); color: var(--text); font-family: var(--f-body); font-size: 15px; font-weight: 700; transition: var(--ease); cursor: pointer; }
  .pdpv38__vbtn:hover { border-color: var(--accent); }
  .pdpv38__vr:checked + .pdpv38__vbtn { border-color: var(--steel); background: var(--steel); color: var(--accent); }

  /* PROMO */
  .pdpv38__promo { background: var(--surface); border: 2px dashed var(--steel); border-radius: var(--r); padding: 14px 18px; display: flex; align-items: center; justify-content: space-between; font-family: var(--f-head); font-size: 13px; font-weight: 700; color: var(--text); }
  .pdpv38__promo-code { background: var(--accent); color: #FFF; padding: 4px 12px; border-radius: 2px; }

  /* URGENCY */
  .pdpv38__urg { background: var(--surface); border-left: 5px solid var(--accent); border-radius: 0 var(--r) var(--r) 0; padding: 16px; display: flex; flex-direction: column; gap: 8px; font-family: var(--f-body); font-size: 15px; font-weight: 700; border: 2px solid var(--border); border-left-width: 5px; }
  .pdpv38__pulse { display: inline-block; width: 10px; height: 10px; background: var(--accent); border-radius: 50%; margin-right: 6px; animation: pdpv38p 1.5s infinite; }
  @keyframes pdpv38p { 0%,100% { opacity: 1; } 50% { opacity: 0.3; } }
  .pdpv38__bar { height: 8px; background: var(--border); border-radius: 4px; overflow: hidden; margin-top: 4px; }
  .pdpv38__fill { height: 100%; background: var(--accent); border-radius: 4px; }

  /* QTY & CTA */
  .pdpv38__qty-row { display: flex; align-items: center; gap: 14px; }
  .pdpv38__qty { display: flex; border: 2px solid var(--steel); border-radius: var(--r); overflow: hidden; background: var(--surface); }
  .pdpv38__qty button { width: 44px; height: 50px; border: none; background: transparent; font-size: 20px; font-weight: 700; color: var(--text); }
  .pdpv38__qty input { width: 44px; height: 50px; border: none; border-left: 2px solid var(--steel); border-right: 2px solid var(--steel); text-align: center; font-size: 16px; font-weight: 700; background: transparent; color: var(--text); }

  .pdpv38__atc { width: 100%; padding: 18px; border: 3px solid var(--steel); border-radius: var(--r); background: var(--accent); color: #FFF; font-family: var(--f-head); font-size: 18px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; transition: var(--ease); box-shadow: 4px 4px 0px var(--steel); }
  .pdpv38__atc:hover { background: var(--accent-hover); transform: translate(-2px, -2px); box-shadow: 6px 6px 0px var(--steel); }
  .pdpv38__atc:disabled { opacity: 0.4; cursor: not-allowed; box-shadow: none; }
  .pdpv38__buynow .shopify-payment-button__button { border-radius: var(--r) !important; }

  /* TRUST */
  .pdpv38__trust { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; text-align: center; padding: 18px 0; border-top: 2px solid var(--steel); border-bottom: 2px solid var(--steel); }
  .pdpv38__trust-item { font-family: var(--f-head); font-size: 11px; font-weight: 700; text-transform: uppercase; color: var(--muted); }
  .pdpv38__trust-icon { font-size: 20px; margin-bottom: 3px; color: var(--accent); }
  @media (max-width: 480px) { .pdpv38__trust { grid-template-columns: repeat(2, 1fr); } }

  /* ACCORDION */
  .pdpv38__acc { border-top: 2px solid var(--steel); margin-top: 48px; }
  .pdpv38__acc-item { border-bottom: 2px solid var(--steel); }
  .pdpv38__acc-btn { width: 100%; padding: 18px 0; border: none; background: transparent; display: flex; justify-content: space-between; align-items: center; font-family: var(--f-head); font-size: 17px; font-weight: 700; text-transform: uppercase; color: var(--text); }
  .pdpv38__acc-btn::after { content: '+'; font-size: 22px; color: var(--accent); }
  .pdpv38__acc-item.open .pdpv38__acc-btn::after { content: '−'; }
  .pdpv38__acc-body { max-height: 0; overflow: hidden; transition: max-height 0.35s ease; }
  .pdpv38__acc-item.open .pdpv38__acc-body { max-height: 500px; }
  .pdpv38__acc-inner { padding: 0 0 18px; font-size: 15px; line-height: 1.7; color: var(--muted); }

  /* SECTION TITLE */
  .pdpv38__sh { font-family: var(--f-head); font-size: 28px; font-weight: 700; text-transform: uppercase; text-align: center; margin: 48px 0 20px; color: var(--text); }

  /* REELS */
  .pdpv38__reels { display: flex; gap: 14px; overflow-x: auto; padding-bottom: 12px; }
  .pdpv38__reel { min-width: 180px; width: 180px; aspect-ratio: 9/16; background: var(--steel); border: 2px solid var(--steel); border-radius: var(--r); overflow: hidden; flex-shrink: 0; position: relative; }
  .pdpv38__reel video { width: 100%; height: 100%; object-fit: cover; }
  .pdpv38__reel-cap { position: absolute; bottom: 0; left: 0; right: 0; padding: 10px; background: rgba(15,23,42,0.9); color: var(--accent); font-family: var(--f-head); font-size: 11px; }
  .pdpv38__reel-ph { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: var(--accent); font-size: 36px; }

  /* CARDS */
  .pdpv38__pgrid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
  @media (min-width: 768px) { .pdpv38__pgrid { grid-template-columns: repeat(4, 1fr); } }
  .pdpv38__pcard { background: var(--surface); border-radius: var(--r); border: 2px solid var(--steel); overflow: hidden; transition: var(--ease); text-decoration: none; color: inherit; display: block; box-shadow: 3px 3px 0px var(--steel); }
  .pdpv38__pcard:hover { border-color: var(--accent); transform: translate(-2px, -2px); box-shadow: 5px 5px 0px var(--steel); }
  .pdpv38__pcard img { width: 100%; aspect-ratio: 1; object-fit: cover; }
  .pdpv38__pcard-info { padding: 14px; }
  .pdpv38__pcard-title { font-family: var(--f-body); font-size: 15px; font-weight: 800; margin-bottom: 4px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; text-transform: uppercase; }
  .pdpv38__pcard-price { font-family: var(--f-head); font-size: 16px; font-weight: 700; color: var(--accent); }

  /* REVIEWS */
  .pdpv38__revgrid { display: grid; grid-template-columns: 1fr; gap: 14px; }
  @media (min-width: 768px) { .pdpv38__revgrid { grid-template-columns: repeat(3, 1fr); } }
  .pdpv38__revcard { background: var(--surface); border-radius: var(--r); border: 2px solid var(--steel); padding: 20px; box-shadow: 3px 3px 0px var(--steel); }
  .pdpv38__rev-stars { color: var(--accent); font-size: 14px; margin-bottom: 8px; }
  .pdpv38__rev-txt { font-size: 14px; line-height: 1.6; color: var(--muted); font-style: italic; margin-bottom: 12px; }
  .pdpv38__rev-auth { font-family: var(--f-body); font-size: 15px; font-weight: 800; text-transform: uppercase; }
  .pdpv38__rev-vf { font-family: var(--f-head); font-size: 11px; color: var(--accent); font-weight: 700; }

  /* RECENTLY VIEWED */
  #pdpv38-rv { display: none; }
  #pdpv38-rv.has { display: block; }

  /* STICKY ATC */
  .pdpv38__sticky { position: fixed; bottom: -80px; left: 0; width: 100%; background: var(--surface); border-top: 3px solid var(--steel); padding: 12px 24px; display: flex; justify-content: space-between; align-items: center; z-index: 9999; transition: bottom 0.3s ease; box-shadow: 0 -4px 20px rgba(0,0,0,0.1); }
  .pdpv38__sticky.show { bottom: 0; }
  .pdpv38__sticky-l { display: flex; align-items: center; gap: 14px; }
  .pdpv38__sticky-img { width: 42px; height: 42px; border-radius: 4px; border: 1px solid var(--steel); object-fit: cover; }
  .pdpv38__sticky-t { font-family: var(--f-body); font-size: 15px; font-weight: 800; max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; text-transform: uppercase; }
  .pdpv38__sticky-p { font-family: var(--f-head); font-size: 16px; font-weight: 700; color: var(--accent); }
  .pdpv38__sticky-btn { background: var(--accent); color: #FFF; border: 2px solid var(--steel); padding: 12px 26px; border-radius: var(--r); font-family: var(--f-head); font-weight: 700; font-size: 14px; text-transform: uppercase; transition: var(--ease); box-shadow: 2px 2px 0px var(--steel); }
  .pdpv38__sticky-btn:hover { background: var(--accent-hover); }
  @media (max-width: 600px) { .pdpv38__sticky-l { display: none; } .pdpv38__sticky-btn { width: 100%; padding: 15px; } }

  .pdpv38__toast { position: fixed; top: 20px; right: 20px; background: var(--accent); color: #FFF; border: 2px solid var(--steel); padding: 12px 24px; font-family: var(--f-head); font-size: 14px; font-weight: 700; z-index: 10000; transform: translateX(130%); transition: transform 0.3s ease; box-shadow: 4px 4px 0px var(--steel); }
  .pdpv38__toast.show { transform: translateX(0); }
</style>

<div class="pdpv38">
  {% if section.settings.show_offer %}<div class="pdpv38__offer">{{ section.settings.offer_text }}</div>{% endif %}

  <div class="pdpv38__wrap">
    <div class="pdpv38__grid">

      <!-- GALLERY -->
      <div class="pdpv38__gal">
        <div class="pdpv38__hero" id="pdpv38-hero">
          <span class="pdpv38__raw-tag">🛠️ RAW CONCRETE</span>
          {% if product.featured_media %}<img height="{{ product.featured_media.height }}" width="{{ product.featured_media.width }}" src="{{ product.featured_media | image_url: width: 900 }}" alt="{{ product.title | escape }}" id="pdpv38-himg">{% else %}{{ 'product-1' | placeholder_svg_tag }}{% endif %}
        </div>
        <div class="pdpv38__thumbs">
          {% for media in product.media limit: 6 %}
            <div class="pdpv38__th {% if forloop.first %}on{% endif %}">
              <img height="{{ media.height }}" width="{{ media.width }}" src="{{ media | image_url: width: 150 }}" alt="{{ media.alt | escape }}" loading="lazy">
            </div>
          {% endfor %}
        </div>
      </div>

      <!-- INFO -->
      <div class="pdpv38__info">
        <div class="pdpv38__crumb">🛠️ {% if product.collections.size > 0 %}{{ product.collections.first.title }}{% else %}Industrial Raw{% endif %}</div>
        <h1 class="pdpv38__title">{{ product.title }}</h1>

        {% if section.settings.show_rating %}
          <div class="pdpv38__rating">
            <span class="pdpv38__stars">★★★★★</span>
            <span>{{ section.settings.rating_val }} · {{ section.settings.rev_count }} Heavy Duty Reviews</span>
          </div>
        {% endif %}

        <div class="pdpv38__price-card">
          <span class="pdpv38__price" id="pdpv38-price">{{ current_variant.price | money }}</span>
          {% if current_variant.compare_at_price > current_variant.price %}
            <span class="pdpv38__cmp">{{ current_variant.compare_at_price | money }}</span>
            {%- assign sv = current_variant.compare_at_price | minus: current_variant.price | times: 100.0 | divided_by: current_variant.compare_at_price | round -%}
            <span class="pdpv38__badge">SAVE {{ sv }}%</span>
          {% endif %}
        </div>

        {% if product.variants.size > 1 %}
          {% for option in product.options_with_values %}
            <div>
              <div class="pdpv38__vlabel">Select {{ option.name }}</div>
              <div class="pdpv38__vopts">
                {% for value in option.values %}
                  <label>
                    <input type="radio" name="pdpv38-o-{{ option.position }}" value="{{ value | escape }}" class="pdpv38__vr" data-pos="{{ option.position }}" {% if option.selected_value == value %}checked{% endif %}>
                    <span class="pdpv38__vbtn">{{ value }}</span>
                  </label>
                {% endfor %}
              </div>
            </div>
          {% endfor %}
        {% endif %}

        {% if section.settings.show_promo %}
          <div class="pdpv38__promo">
            <span>Heavy Pass: Apply {{ section.settings.promo_code }}</span>
            <span class="pdpv38__promo-code">Save {{ section.settings.promo_disc }}</span>
          </div>
        {% endif %}

        {% if section.settings.show_urgency %}
          <div class="pdpv38__urg">
            <div><span class="pdpv38__pulse"></span><strong>{{ viewer_count }}</strong> industrial buyers online</div>
            <div>🛠️ <strong>{{ sold_count }}</strong> heavy units shipped today</div>
            <div>Inventory Status: Only <strong>{{ inv_qty }}</strong> remaining
              <div class="pdpv38__bar">
                {%- assign sp = inv_qty | times: 100 | divided_by: 45 -%}
                {%- if sp > 100 -%}{%- assign sp = 100 -%}{%- endif -%}
                <div class="pdpv38__fill" style="width:{{ sp }}%"></div>
              </div>
            </div>
            {% if section.settings.show_countdown %}
              <div>⏳ Shift Ends In: <strong id="pdpv38-cd" style="color:var(--accent)">{{ section.settings.cd_hrs }}h 00m 00s</strong></div>
            {% endif %}
          </div>
        {% endif %}

        <div class="pdpv38__qty-row">
          <div class="pdpv38__qty">
            <button type="button" id="pdpv38-qm">−</button>
            <input type="number" id="pdpv38-qi" value="1" min="1" max="10" readonly>
            <button type="button" id="pdpv38-qp">+</button>
          </div>
          {% form 'product', product, id: 'pdpv38-form', style: 'flex:1' %}
            <input type="hidden" name="id" id="pdpv38-vid" value="{{ current_variant.id }}">
            <input type="hidden" name="quantity" id="pdpv38-fq" value="1">
            <button type="submit" name="add" class="pdpv38__atc" id="pdpv38-atc" {% unless current_variant.available %}disabled{% endunless %}>
              {% if current_variant.available %}ADD TO CART — {{ current_variant.price | money }}{% else %}SOLD OUT{% endif %}
            </button>
            <div class="pdpv38__buynow" style="margin-top:10px">{{ form | payment_button }}</div>
          {% endform %}
        </div>

        <div class="pdpv38__trust">
          <div class="pdpv38__trust-item"><div class="pdpv38__trust-icon">🔒</div>Secure</div>
          <div class="pdpv38__trust-item"><div class="pdpv38__trust-icon">🛠️</div>Heavy Duty</div>
          <div class="pdpv38__trust-item"><div class="pdpv38__trust-icon">↩️</div>Easy Returns</div>
          <div class="pdpv38__trust-item"><div class="pdpv38__trust-icon">⚙️</div>Reinforced</div>
        </div>
      </div>
    </div>

    <!-- ACCORDION -->
    <div class="pdpv38__acc">
      <div class="pdpv38__acc-item open">
        <button class="pdpv38__acc-btn" type="button">Raw Concrete Specifications & Build</button>
        <div class="pdpv38__acc-body"><div class="pdpv38__acc-inner">{{ product.description }}</div></div>
      </div>
      {% if section.settings.raw_specs != blank %}
        <div class="pdpv38__acc-item">
          <button class="pdpv38__acc-btn" type="button">Structural Integrity & Testing</button>
          <div class="pdpv38__acc-body"><div class="pdpv38__acc-inner">{{ section.settings.raw_specs }}</div></div>
        </div>
      {% endif %}
    </div>

    <!-- FBT -->
    {% if section.settings.fbt_coll != blank %}
      {%- assign fbt = collections[section.settings.fbt_coll] -%}
      {% if fbt.products.size > 0 %}
        <div class="pdpv38__sh">Industrial Equipment Pairings</div>
        <div class="pdpv38__pgrid">
          {% for item in fbt.products limit: 4 %}
            <a href="{{ item.url }}" class="pdpv38__pcard">
              <img height="{{ item.featured_image.height }}" width="{{ item.featured_image.width }}" src="{{ item.featured_image | image_url: width: 400 }}" alt="{{ item.title | escape }}" loading="lazy">
              <div class="pdpv38__pcard-info">
                <div class="pdpv38__pcard-title">{{ item.title }}</div>
                <div class="pdpv38__pcard-price">{{ item.price | money }}</div>
              </div>
            </a>
          {% endfor %}
        </div>
      {% endif %}
    {% endif %}

    <!-- REELS -->
    {% if section.settings.show_reels %}
      <div class="pdpv38__sh">Field Footage</div>
      <div class="pdpv38__reels">
        {% if section.settings.r1 != blank %}<div class="pdpv38__reel"><video src="{{ section.settings.r1 }}" muted playsinline loop></video><div class="pdpv38__reel-cap">🛠️ Load Test</div></div>{% else %}<div class="pdpv38__reel"><div class="pdpv38__reel-ph">▶</div></div>{% endif %}
        {% if section.settings.r2 != blank %}<div class="pdpv38__reel"><video src="{{ section.settings.r2 }}" muted playsinline loop></video><div class="pdpv38__reel-cap">🛠️ Stress Test</div></div>{% else %}<div class="pdpv38__reel"><div class="pdpv38__reel-ph">▶</div></div>{% endif %}
        {% if section.settings.r3 != blank %}<div class="pdpv38__reel"><video src="{{ section.settings.r3 }}" muted playsinline loop></video><div class="pdpv38__reel-cap">🛠️ Heavy Duty</div></div>{% else %}<div class="pdpv38__reel"><div class="pdpv38__reel-ph">▶</div></div>{% endif %}
      </div>
    {% endif %}

    <!-- REVIEWS -->
    {% if section.settings.show_reviews %}
      <div class="pdpv38__sh" id="reviews">Contractor Reviews</div>
      <div class="pdpv38__revgrid">
        {% if section.settings.rv1 != blank %}<div class="pdpv38__revcard"><div class="pdpv38__rev-stars">★★★★★</div><div class="pdpv38__rev-txt">"{{ section.settings.rv1 }}"</div><div class="pdpv38__rev-auth">{{ section.settings.rv1n }}</div><div class="pdpv38__rev-vf">✓ Verified Contractor</div></div>{% endif %}
        {% if section.settings.rv2 != blank %}<div class="pdpv38__revcard"><div class="pdpv38__rev-stars">★★★★★</div><div class="pdpv38__rev-txt">"{{ section.settings.rv2 }}"</div><div class="pdpv38__rev-auth">{{ section.settings.rv2n }}</div><div class="pdpv38__rev-vf">✓ Verified Contractor</div></div>{% endif %}
        {% if section.settings.rv3 != blank %}<div class="pdpv38__revcard"><div class="pdpv38__rev-stars">★★★★★</div><div class="pdpv38__rev-txt">"{{ section.settings.rv3 }}"</div><div class="pdpv38__rev-auth">{{ section.settings.rv3n }}</div><div class="pdpv38__rev-vf">✓ Verified Contractor</div></div>{% endif %}
      </div>
    {% endif %}

    <!-- FEATURED -->
    {% if section.settings.feat_coll != blank %}
      {%- assign fc = collections[section.settings.feat_coll] -%}
      {% if fc.products.size > 0 %}
        <div class="pdpv38__sh">Recommended Heavy Equipment</div>
        <div class="pdpv38__pgrid">
          {% for item in fc.products limit: 4 %}
            {% if item.handle != product.handle %}
              <a href="{{ item.url }}" class="pdpv38__pcard">
                <img height="{{ item.featured_image.height }}" width="{{ item.featured_image.width }}" src="{{ item.featured_image | image_url: width: 400 }}" alt="{{ item.title | escape }}" loading="lazy">
                <div class="pdpv38__pcard-info">
                  <div class="pdpv38__pcard-title">{{ item.title }}</div>
                  <div class="pdpv38__pcard-price">{{ item.price | money }}</div>
                </div>
              </a>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    {% endif %}

    <!-- RECENTLY VIEWED -->
    <div id="pdpv38-rv">
      <div class="pdpv38__sh">Recently Viewed</div>
      <div class="pdpv38__pgrid" id="pdpv38-rvg"></div>
    </div>
  </div>
</div>

<!-- STICKY ATC -->
<div class="pdpv38__sticky" id="pdpv38-sticky">
  <div class="pdpv38__sticky-l">
    {% if product.featured_media %}<img height="{{ product.featured_media.height }}" width="{{ product.featured_media.width }}" src="{{ product.featured_media | image_url: width: 80 }}" class="pdpv38__sticky-img" alt="{{ product.title | escape }}">{% endif %}
    <div>
      <div class="pdpv38__sticky-t">{{ product.title }}</div>
      <div class="pdpv38__sticky-p" id="pdpv38-sp">{{ current_variant.price | money }}</div>
    </div>
  </div>
  
      <!-- D2C SCARCITY & NOTIFY -->
      {% if product.available %}
        <div style="background:#FFF3E0; border:1px solid #FFCC80; padding:10px; border-radius:8px; margin-bottom:12px; display:flex; align-items:center; gap:12px;">
          <svg style="width:24px; height:24px; color:#E65100; flex-shrink:0;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          <div style="font-size:13px; color:#E65100;">
            <div style="font-weight:700;">Limited Time Offer Ends In:</div>
            <div style="font-size:16px; font-weight:700; margin-top:2px;"><b>{% render 'countdown-timer', product: product %}</b></div>
          </div>
        </div>
      {% endif %}

      {% render 'back-in-stock', product: product %}

      {% if product.available %}
      <button type="button" class="pdpv38__sticky-btn" id="pdpv38-sbtn">Add to Cart</button>
      {% else %}
      <button class="pdpv38__sticky-btn" disabled style="opacity:0.5; cursor:not-allowed;">SOLD OUT</button>
      {% endif %}
</div>

<div class="pdpv38__toast" id="pdpv38-toast">🛠️ Added to cart!</div>

<script>
(function(){
  var PJ={{ product | json }}, cid={{ current_variant.id }};
  function getO(){ var o=[]; document.querySelectorAll('.pdpv38__vr:checked').forEach(function(r){ o.push({p:parseInt(r.dataset.pos),v:r.value}); }); o.sort(function(a,b){return a.p-b.p}); return o.map(function(x){return x.v}); }
  function findV(o){ for(var i=0;i<PJ.variants.length;i++){ var v=PJ.variants[i],ok=true; for(var j=0;j<o.length;j++){ if(v.options[j]!==o[j]){ ok=false; break; } } if(ok) return v; } return null; }
  function upd(){
    var o=getO(); if(!o.length) return; var v=findV(o); if(!v) return; cid=v.id;
    document.getElementById('pdpv38-vid').value=v.id;
    var pf=(v.price/100).toLocaleString('en-US',{style:'currency',currency:PJ.currency||'USD'});
    var pe=document.getElementById('pdpv38-price'); if(pe) pe.textContent=pf;
    var sp=document.getElementById('pdpv38-sp'); if(sp) sp.textContent=pf;
    var ab=document.getElementById('pdpv38-atc');
    if(ab){ ab.disabled=!v.available; ab.textContent=v.available?'ADD TO CART — '+pf:'SOLD OUT'; }
    var u=new URL(window.location); u.searchParams.set('variant',v.id); history.replaceState({},'',u);
  }
  document.querySelectorAll('.pdpv38__vr').forEach(function(r){ r.addEventListener('change',upd); });

  var fm=document.getElementById('pdpv38-form');
  if(fm) fm.addEventListener('submit',function(e){
    e.preventDefault(); var b=document.getElementById('pdpv38-atc'), ot=b.textContent;
    b.disabled=true; b.textContent='ADDING...';
    var q=parseInt(document.getElementById('pdpv38-qi').value)||1;
    document.getElementById('pdpv38-fq').value=q;
    fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:cid,quantity:q})})
    .then(function(r){return r.json();})
    .then(function(){ b.textContent='✓ ADDED!'; toast38(); setTimeout(function(){ b.disabled=false; b.textContent=ot; },2000); })
    .catch(function(){ b.textContent='ERROR'; setTimeout(function(){ b.disabled=false; b.textContent=ot; },2000); });
  });

  function toast38(){ var t=document.getElementById('pdpv38-toast'); t.classList.add('show'); setTimeout(function(){ t.classList.remove('show'); },3000); }

  var qi=document.getElementById('pdpv38-qi');
  document.getElementById('pdpv38-qm').addEventListener('click',function(){ var v=parseInt(qi.value); if(v>1) qi.value=v-1; });
  document.getElementById('pdpv38-qp').addEventListener('click',function(){ var v=parseInt(qi.value); if(v<10) qi.value=v+1; });

  document.querySelectorAll('.pdpv38__th').forEach(function(th){
    th.addEventListener('click',function(){
      document.querySelectorAll('.pdpv38__th').forEach(function(t){ t.classList.remove('on'); });
      th.classList.add('on');
      var hi=document.getElementById('pdpv38-himg'), ti=th.querySelector('img');
      if(hi&&ti) hi.src=ti.src.replace(/width=\d+/,'width=900');
    });
  });

  var sb=document.getElementById('pdpv38-sticky'), ab=document.getElementById('pdpv38-atc');
  if(sb&&ab) window.addEventListener('scroll',function(){ sb.classList.toggle('show', ab.getBoundingClientRect().top<-50); });
  var sbn=document.getElementById('pdpv38-sbtn');
  if(sbn) sbn.addEventListener('click',function(){ document.getElementById('pdpv38-atc').click(); });

  document.querySelectorAll('.pdpv38__acc-btn').forEach(function(b){ b.addEventListener('click',function(){ b.closest('.pdpv38__acc-item').classList.toggle('open'); }); });

  var ce=document.getElementById('pdpv38-cd');
  if(ce){
    var hrs=parseInt('{{ section.settings.cd_hrs | default: 6 }}')||6, ts=hrs*3600;
    var sk=sessionStorage.getItem('pdpv38_cd'); if(sk) ts=parseInt(sk);
    setInterval(function(){ ts--; if(ts<=0){ ce.textContent='EXPIRED'; return; } var h=Math.floor(ts/3600), m=Math.floor((ts%3600)/60), s=ts%60; ce.textContent=h+'h '+(m<10?'0':'')+m+'m '+(s<10?'0':'')+s+'s'; sessionStorage.setItem('pdpv38_cd',ts); },1000);
  }

  if('IntersectionObserver' in window){
    var ro=new IntersectionObserver(function(es){ es.forEach(function(e){ var v=e.target.querySelector('video'); if(v){ e.isIntersecting?v.play():v.pause(); } }); },{threshold:0.5});
    document.querySelectorAll('.pdpv38__reel').forEach(function(r){ ro.observe(r); });
  }

  var RK='pdpv38_rv', cp={handle:'{{ product.handle }}',title:'{{ product.title | escape }}',price:'{{ product.price | money }}',image:'{{ product.featured_image | image_url: width: 400 }}',url:'{{ product.url }}'};
  try{ var its=JSON.parse(localStorage.getItem(RK)||'[]'); its=its.filter(function(i){ return i.handle!==cp.handle; }); its.unshift(cp); if(its.length>8) its=its.slice(0,8); localStorage.setItem(RK,JSON.stringify(its)); }catch(e){}
  try{
    var its2=JSON.parse(localStorage.getItem(RK)||'[]').filter(function(i){ return i.handle!==cp.handle; });
    var c=document.getElementById('pdpv38-rv'), g=document.getElementById('pdpv38-rvg');
    if(g&&its2.length>0){ c.classList.add('has'); var h=''; its2.slice(0,4).forEach(function(i){ h+='<a href="'+i.url+'" class="pdpv38__pcard"><img src="'+i.image+'" alt="'+i.title+'" loading="lazy"><div class="pdpv38__pcard-info"><div class="pdpv38__pcard-title">'+i.title+'</div><div class="pdpv38__pcard-price">'+i.price+'</div></div></a>'; }); g.innerHTML=h; }
  }catch(e){}
})();
</script>

{% schema %}
{
  "name": "PDP V38 — Industrial Raw",
  "tag": "section",
  "class": "pdpv38-section",
  "settings": [
    { "type": "header", "content": "Rating" },
    { "type": "checkbox", "id": "show_rating", "label": "Show rating", "default": true },
    { "type": "text", "id": "rating_val", "label": "Rating score", "default": "4.97" },
    { "type": "text", "id": "rev_count", "label": "Total reviews", "default": "1,950" },
    { "type": "header", "content": "Offer Banner" },
    { "type": "checkbox", "id": "show_offer", "label": "Show offer", "default": true },
    { "type": "text", "id": "offer_text", "label": "Offer text", "default": "🛠️ INDUSTRIAL RAW: ENJOY 20% DISCOUNT WITH CODE 'RAW20'" },
    { "type": "header", "content": "Promo" },
    { "type": "checkbox", "id": "show_promo", "label": "Show promo", "default": true },
    { "type": "text", "id": "promo_code", "label": "Code", "default": "RAW20" },
    { "type": "text", "id": "promo_disc", "label": "Discount", "default": "20%" },
    { "type": "header", "content": "Urgency" },
    { "type": "checkbox", "id": "show_urgency", "label": "Show urgency", "default": true },
    { "type": "checkbox", "id": "show_countdown", "label": "Show countdown", "default": true },
    { "type": "range", "id": "cd_hrs", "label": "Countdown hours", "min": 1, "max": 48, "default": 6 },
    { "type": "header", "content": "Accordion" },
    { "type": "richtext", "id": "raw_specs", "label": "Structural integrity & testing" },
    { "type": "header", "content": "FBT" },
    { "type": "collection", "id": "fbt_coll", "label": "FBT collection" },
    { "type": "header", "content": "Reels" },
    { "type": "checkbox", "id": "show_reels", "label": "Show reels", "default": true },
    { "type": "url", "id": "r1", "label": "Reel 1 URL" },
    { "type": "url", "id": "r2", "label": "Reel 2 URL" },
    { "type": "url", "id": "r3", "label": "Reel 3 URL" },
    { "type": "header", "content": "Reviews" },
    { "type": "checkbox", "id": "show_reviews", "label": "Show reviews", "default": true },
    { "type": "text", "id": "rv1", "label": "Review 1", "default": "Rock solid build quality. Concrete tough!" },
    { "type": "text", "id": "rv1n", "label": "Author 1", "default": "Hank M." },
    { "type": "text", "id": "rv2", "label": "Review 2", "default": "Industrial aesthetic looks super premium on site." },
    { "type": "text", "id": "rv2n", "label": "Author 2", "default": "Brody K." },
    { "type": "text", "id": "rv3", "label": "Review 3", "default": "Unmatched durability." },
    { "type": "text", "id": "rv3n", "label": "Author 3", "default": "Damon S." },
    { "type": "header", "content": "Featured" },
    { "type": "collection", "id": "feat_coll", "label": "Featured collection" }
  ],
  "presets": [{ "name": "PDP V38 — Industrial Raw" }]
}
{% endschema %}