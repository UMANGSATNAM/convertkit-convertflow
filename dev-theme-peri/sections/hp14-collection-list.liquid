{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#f4f1de'
  assign text_color = section.settings.text_color | default: '#6b705c'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 100px 40px;
  }
  
  .hp14-collections-container-{{ section_id }} {
    max-width: 1400px;
    margin: 0 auto;
  }
  
  .hp14-collections-heading-{{ section_id }} {
    font-family: 'Georgia', serif;
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: normal;
    text-align: center;
    color: {{ text_color }};
    margin: 0 0 60px 0;
  }
  
  .hp14-collections-heading-{{ section_id }} span {
    font-style: italic;
    color: #cb997e;
  }
  
  .hp14-collections-grid-{{ section_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
  }
  
  .hp14-collection-card-{{ section_id }} {
    display: block;
    text-decoration: none;
    text-align: center;
  }
  
  .hp14-collection-image-wrap-{{ section_id }} {
    position: relative;
    padding-top: 130%;
    border-radius: 100px 100px 0 0;
    overflow: hidden;
    margin-bottom: 25px;
  }
  
  .hp14-collection-image-{{ section_id }} {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  
  .hp14-collection-card-{{ section_id }}:hover .hp14-collection-image-{{ section_id }} {
    transform: scale(1.05);
  }
  
  .hp14-collection-title-{{ section_id }} {
    font-family: 'Georgia', serif;
    font-size: 1.5rem;
    color: {{ text_color }};
    margin: 0;
  }

  @media (max-width: 992px) {
    .hp14-collections-grid-{{ section_id }} {
      grid-template-columns: 1fr;
    }
    .hp14-collection-image-wrap-{{ section_id }} {
      padding-top: 80%;
      border-radius: 50px 50px 0 0;
    }
  }
  
  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 60px 20px;
    }
  }
</style>

<div class="hp14-collections-container-{{ section_id }}">
  <h2 class="hp14-collections-heading-{{ section_id }}">Curated <span>Collections</span></h2>
  
  <div class="hp14-collections-grid-{{ section_id }}">
    {% for block in section.blocks limit: 3 %}
      <a href="{{ block.settings.link | default: '#' }}" class="hp14-collection-card-{{ section_id }}" {{ block.shopify_attributes }}>
        <div class="hp14-collection-image-wrap-{{ section_id }}">
          {% if block.settings.image != blank %}
            <img height="{{ block.settings.image.height }}" width="{{ block.settings.image.width }}" src="{{ block.settings.image | image_url: width: 800 }}" class="hp14-collection-image-{{ section_id }}" alt="Collection">
          {% else %}
            <div class="hp14-collection-image-{{ section_id }}" style="background: repeating-linear-gradient(45deg, #EFEFEF, #EFEFEF 12px, #E6E6E6 12px, #E6E6E6 24px);"></div>
          {% endif %}
        </div>
        <h3 class="hp14-collection-title-{{ section_id }}">{{ block.settings.title | default: 'Collection' }}</h3>
      </a>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "HP14 Collection List",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f4f1de"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#6b705c"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Face Care"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP14 Collection List",
      "blocks": [
        { "type": "collection", "settings": { "title": "Face Care" } },
        { "type": "collection", "settings": { "title": "Body Care" } },
        { "type": "collection", "settings": { "title": "Wellness" } }
      ]
    }
  ]
}
{% endschema %}
