{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#FAFAFA'
  assign text_color = section.settings.text_color | default: '#333333'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 120px 40px;
    border-bottom: 1px solid #E5E5E5;
    color: {{ text_color }};
  }
  
  .hp12-faq-container-{{ section_id }} {
    max-width: 800px;
    margin: 0 auto;
  }
  
  .hp12-faq-heading-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 300;
    margin: 0 0 60px 0;
    text-align: center;
    letter-spacing: 1px;
  }
  
  .hp12-faq-item-{{ section_id }} {
    border-bottom: 1px solid #E5E5E5;
  }
  
  .hp12-faq-question-{{ section_id }} {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 25px 0;
    background: transparent;
    border: none;
    color: {{ text_color }};
    font-family: 'Inter', sans-serif;
    font-size: 1rem;
    font-weight: 400;
    cursor: pointer;
    text-align: left;
    outline: none;
  }
  
  .hp12-faq-icon-{{ section_id }} {
    width: 16px;
    height: 16px;
    position: relative;
    transition: transform 0.3s ease;
  }
  
  .hp12-faq-icon-{{ section_id }}::before,
  .hp12-faq-icon-{{ section_id }}::after {
    content: '';
    position: absolute;
    background-color: currentColor;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
  }
  
  .hp12-faq-icon-{{ section_id }}::before { width: 100%; height: 1px; }
  .hp12-faq-icon-{{ section_id }}::after { width: 1px; height: 100%; transition: transform 0.3s ease; }
  
  .hp12-faq-item-{{ section_id }}.is-active .hp12-faq-icon-{{ section_id }}::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }
  
  .hp12-faq-answer-{{ section_id }} {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease, padding 0.3s ease;
    font-family: 'Inter', sans-serif;
    font-size: 0.95rem;
    font-weight: 300;
    line-height: 1.6;
    opacity: 0.7;
    padding: 0;
  }
  
  .hp12-faq-item-{{ section_id }}.is-active .hp12-faq-answer-{{ section_id }} {
    max-height: 500px;
    padding: 0 0 30px 0;
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 60px 20px;
    }
  }
</style>

<div class="hp12-faq-container-{{ section_id }}">
  <h2 class="hp12-faq-heading-{{ section_id }}">{{ section.settings.heading | default: 'Inquiries.' }}</h2>
  
  <div class="hp12-faq-list-{{ section_id }}">
    {% for block in section.blocks %}
      <div class="hp12-faq-item-{{ section_id }}" {{ block.shopify_attributes }}>
        <button class="hp12-faq-question-{{ section_id }}" onclick="this.parentElement.classList.toggle('is-active')">
          {{ block.settings.question | default: 'Question?' }}
          <span class="hp12-faq-icon-{{ section_id }}"></span>
        </button>
        <div class="hp12-faq-answer-{{ section_id }}">
          {{ block.settings.answer | default: 'Detailed answer goes here.' }}
        </div>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "HP12 FAQ",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FAFAFA"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#333333"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Inquiries."
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Where are your materials sourced?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "We work exclusively with certified sustainable forests in Northern Europe for our oak, and natural linen weavers in Belgium."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP12 FAQ",
      "blocks": [
        { "type": "faq", "settings": { "question": "Where are your materials sourced?" } },
        { "type": "faq", "settings": { "question": "Do you offer international shipping?" } },
        { "type": "faq", "settings": { "question": "What is the lead time for made-to-order pieces?" } }
      ]
    }
  ]
}
{% endschema %}
