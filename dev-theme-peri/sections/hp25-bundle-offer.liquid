{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,100..900;1,9..144,100..900&family=Outfit:wght@300;400;600;800&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-orange: {{ section.settings.accent_orange }};
    --accent-yellow: {{ section.settings.accent_yellow }};
    --font-heading: 'Fraunces', serif;
    --font-body: 'Outfit', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    position: relative;
    /* Subtle grainy texture */
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.03'/%3E%3C/svg%3E");
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }

  .hp25-bundle-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
    position: relative;
    z-index: 1;
  }

  @media screen and (max-width: 768px) {
    .hp25-bundle-wrapper {
      padding: 0 20px;
    }
  }

  /* The wavy container */
  .hp25-bundle__container {
    display: flex;
    align-items: stretch;
    background-color: var(--accent-yellow);
    border: 5px solid var(--text-color);
    /* Groovy rounded corners */
    border-radius: 80px 20px 80px 20px;
    box-shadow: 12px 12px 0 var(--accent-orange);
    overflow: hidden;
  }

  @media screen and (max-width: 992px) {
    .hp25-bundle__container {
      flex-direction: column;
      border-radius: 40px 20px 40px 20px;
    }
  }

  .hp25-bundle__image-col {
    flex: 1;
    position: relative;
    min-height: 400px;
  }

  @media screen and (max-width: 992px) {
    .hp25-bundle__image-col {
      min-height: 300px;
    }
  }

  .hp25-bundle__image {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: sepia(0.2) contrast(1.1);
  }

  /* Sticker graphic */
  .hp25-bundle__sticker {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 100px;
    height: 100px;
    background-color: var(--accent-orange);
    border: 3px solid var(--text-color);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: var(--bg-color);
    font-family: var(--font-heading);
    font-weight: 900;
    font-style: italic;
    font-size: 24px;
    line-height: 1;
    transform: rotate(15deg);
    z-index: 2;
    box-shadow: 4px 4px 0 var(--text-color);
  }

  .hp25-bundle__content-col {
    flex: 1;
    padding: 60px 50px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    border-left: 5px solid var(--text-color);
  }

  @media screen and (max-width: 992px) {
    .hp25-bundle__content-col {
      border-left: none;
      border-top: 5px solid var(--text-color);
      padding: 40px 30px;
      text-align: center;
      align-items: center;
    }
  }

  .hp25-bundle__badge {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--text-color);
    margin-bottom: 20px;
    border: 2px solid var(--text-color);
    padding: 5px 15px;
    border-radius: 50px;
  }

  .hp25-bundle__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    font-weight: 900;
    font-style: italic;
    color: var(--text-color);
    line-height: 1.1;
    margin: 0 0 20px;
    text-shadow: 2px 2px 0 var(--bg-color);
  }

  .hp25-bundle__text {
    font-family: var(--font-body);
    font-size: clamp(16px, 2vw, {{ section.settings.text_size }}px);
    color: var(--text-color);
    margin: 0 0 30px;
    line-height: 1.5;
    font-weight: 600;
  }

  .hp25-bundle__products {
    display: flex;
    flex-direction: column;
    gap: 15px;
    margin-bottom: 30px;
    width: 100%;
  }

  .hp25-bundle__product-item {
    display: flex;
    align-items: center;
    background: var(--bg-color);
    border: 3px solid var(--text-color);
    border-radius: 15px;
    padding: 10px;
    box-shadow: 4px 4px 0 var(--accent-orange);
  }

  .hp25-bundle__product-img {
    width: 60px;
    height: 60px;
    object-fit: cover;
    border: 2px solid var(--text-color);
    border-radius: 10px;
    margin-right: 15px;
    background: var(--accent-orange);
  }

  .hp25-bundle__product-info {
    flex: 1;
    text-align: left;
  }

  .hp25-bundle__product-title {
    font-family: var(--font-heading);
    font-size: 18px;
    font-weight: 800;
    color: var(--text-color);
    margin: 0 0 5px;
  }

  .hp25-bundle__product-price {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 600;
    color: var(--text-color);
  }

  .hp25-bundle__btn {
    display: inline-block;
    padding: 16px 40px;
    background-color: var(--accent-orange);
    color: var(--bg-color);
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 800;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 50px;
    border: 3px solid var(--text-color);
    box-shadow: 5px 5px 0 var(--text-color);
    transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
  }

  .hp25-bundle__btn:hover {
    transform: translate(2px, 2px);
    box-shadow: 3px 3px 0 var(--text-color);
    background-color: var(--bg-color);
    color: var(--text-color);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp25-bundle-wrapper" id="HP25Bundle-{{ section.id }}">
  <div class="hp25-bundle__container">
    
    <div class="hp25-bundle__image-col">
      {%- if section.settings.image != blank -%}
        <img height="{{ section.settings.image.height }}" width="{{ section.settings.image.width }}" src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.title | escape }}" class="hp25-bundle__image" loading="lazy">
      {%- else -%}
        <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:var(--accent-orange);color:var(--bg-color);font-family:var(--font-heading);font-style:italic;font-size:24px;">IMAGE</div>
      {%- endif -%}
      
      {%- if section.settings.sticker_text != blank -%}
        <div class="hp25-bundle__sticker">
          {{ section.settings.sticker_text | newline_to_br }}
        </div>
      {%- endif -%}
    </div>

    <div class="hp25-bundle__content-col">
      {%- if section.settings.badge_text != blank -%}
        <div class="hp25-bundle__badge">{{ section.settings.badge_text }}</div>
      {%- endif -%}

      {%- if section.settings.title != blank -%}
        <h2 class="hp25-bundle__title">{{ section.settings.title }}</h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="hp25-bundle__text">{{ section.settings.text }}</div>
      {%- endif -%}

      <div class="hp25-bundle__products">
        {%- for block in section.blocks -%}
          {%- assign prod = block.settings.product -%}
          <div class="hp25-bundle__product-item" {{ block.shopify_attributes }}>
            {%- if prod != blank -%}
              <img height="{{ prod.featured_image.height }}" width="{{ prod.featured_image.width }}" src="{{ prod.featured_image | image_url: width: 120 }}" alt="{{ prod.title | escape }}" class="hp25-bundle__product-img" loading="lazy">
              <div class="hp25-bundle__product-info">
                <h4 class="hp25-bundle__product-title">{{ prod.title }}</h4>
                <div class="hp25-bundle__product-price">{{ prod.price | money }}</div>
              </div>
            {%- else -%}
              <div class="hp25-bundle__product-img"></div>
              <div class="hp25-bundle__product-info">
                <h4 class="hp25-bundle__product-title">Retro Item {{ forloop.index }}</h4>
                <div class="hp25-bundle__product-price">$30.00</div>
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

      {%- if section.settings.btn_text != blank -%}
        <div>
          <a href="{{ section.settings.btn_link | default: '#' }}" class="hp25-bundle__btn">
            {{ section.settings.btn_text }}
          </a>
        </div>
      {%- endif -%}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "HP25 - Retro Bundle",
  "class": "section-hp25-bundle-offer",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "BUNDLE & SAVE"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "The Groovy Set"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Grab the full look and get a far out discount. Perfectly paired for maximum vibes.</p>"
    },
    {
      "type": "textarea",
      "id": "sticker_text",
      "label": "Sticker Text",
      "default": "20%\nOFF"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "ADD BUNDLE TO BAG"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Bundle Image"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 800,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1200
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 48
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Text Size",
      "default": 18
    },
    {
      "type": "header",
      "content": "Retro 70s Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#F5E6D3"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text / Border (Dark Brown)",
      "default": "#3E2723"
    },
    {
      "type": "color",
      "id": "accent_orange",
      "label": "Accent (Burnt Orange)",
      "default": "#D15F3C"
    },
    {
      "type": "color",
      "id": "accent_yellow",
      "label": "Accent (Mustard)",
      "default": "#E2B144"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "limit": 3,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP25 - Retro Bundle",
      "blocks": [
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
