{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#FAFAFA'
  assign text_color = section.settings.text_color | default: '#333333'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 120px 40px;
    border-bottom: 1px solid #E5E5E5;
  }
  
  .hp12-collections-container-{{ section_id }} {
    max-width: 1400px;
    margin: 0 auto;
  }
  
  .hp12-collections-header-{{ section_id }} {
    margin-bottom: 60px;
    text-align: left;
  }
  
  .hp12-collections-heading-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 300;
    margin: 0;
    line-height: 1.2;
    letter-spacing: 1px;
    color: {{ text_color }};
  }
  
  .hp12-collections-grid-{{ section_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
  }
  
  .hp12-collection-card-{{ section_id }} {
    position: relative;
    display: block;
    text-decoration: none;
    overflow: hidden;
    background: #E5E5E5;
  }
  
  .hp12-collection-card-{{ section_id }}::before {
    content: '';
    display: block;
    padding-top: 140%;
  }
  
  .hp12-collection-image-{{ section_id }} {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 0.8s ease;
  }
  
  .hp12-collection-card-{{ section_id }}:hover .hp12-collection-image-{{ section_id }} {
    transform: scale(1.05);
  }
  
  .hp12-collection-info-{{ section_id }} {
    position: absolute;
    bottom: 0; left: 0; width: 100%;
    padding: 40px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: linear-gradient(to top, rgba(0,0,0,0.5) 0%, rgba(0,0,0,0) 100%);
  }
  
  .hp12-collection-title-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: 1.2rem;
    font-weight: 300;
    color: #FFF;
    margin: 0;
    letter-spacing: 2px;
    text-transform: uppercase;
  }
  
  .hp12-collection-arrow-{{ section_id }} {
    color: #FFF;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transform: translateX(-10px);
    transition: all 0.3s ease;
  }
  
  .hp12-collection-card-{{ section_id }}:hover .hp12-collection-arrow-{{ section_id }} {
    opacity: 1;
    transform: translateX(0);
  }
  
  .hp12-collection-arrow-{{ section_id }} svg {
    width: 24px;
    height: 24px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1;
  }

  @media (max-width: 992px) {
    .hp12-collections-grid-{{ section_id }} {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }
  
  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 60px 20px;
    }
    .hp12-collection-info-{{ section_id }} {
      padding: 20px;
    }
  }
</style>

<div class="hp12-collections-container-{{ section_id }}">
  <div class="hp12-collections-header-{{ section_id }}">
    <h2 class="hp12-collections-heading-{{ section_id }}">{{ section.settings.heading | default: 'Spaces' }}</h2>
  </div>
  
  <div class="hp12-collections-grid-{{ section_id }}">
    {% for block in section.blocks limit: 3 %}
      <a href="{{ block.settings.link | default: '#' }}" class="hp12-collection-card-{{ section_id }}" {{ block.shopify_attributes }}>
        {% if block.settings.image != blank %}
          <img src="{{ block.settings.image | image_url: width: 800 }}" class="hp12-collection-image-{{ section_id }}" alt="Collection">
        {% else %}
          <div class="hp12-collection-image-{{ section_id }}" style="background: repeating-linear-gradient(45deg, #EFEFEF, #EFEFEF 12px, #E6E6E6 12px, #E6E6E6 24px);"></div>
        {% endif %}
        <div class="hp12-collection-info-{{ section_id }}">
          <h3 class="hp12-collection-title-{{ section_id }}">{{ block.settings.title | default: 'COLLECTION' }}</h3>
          <div class="hp12-collection-arrow-{{ section_id }}">
            <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
        </div>
      </a>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "HP12 Collection List",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FAFAFA"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#333333"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Spaces"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "LIVING"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP12 Collection List",
      "blocks": [
        { "type": "collection", "settings": { "title": "LIVING" } },
        { "type": "collection", "settings": { "title": "DINING" } },
        { "type": "collection", "settings": { "title": "OFFICE" } }
      ]
    }
  ]
}
{% endschema %}
