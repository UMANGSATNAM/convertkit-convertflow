{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#09090B' }};
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }
  .hp61-feat__container { max-width: {{ section.settings.container_width | default: 1280 }}px; margin: 0 auto; padding: 0 24px; }
  .hp61-feat__header { text-align: center; margin-bottom: 50px; }
  .hp61-feat__eyebrow { font-family: 'Space Grotesk', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: {{ section.settings.accent_color | default: '#EF4444' }}; margin: 0 0 12px; }
  .hp61-feat__heading { font-family: 'Syne', sans-serif; font-size: clamp(28px, 3.5vw, 42px); font-weight: 800; color: #FFFFFF; margin: 0; }
  .hp61-feat__grid { display: grid; grid-template-columns: repeat({{ section.settings.columns | default: 3 }}, 1fr); gap: 24px; }
  .hp61-feat__card {
    background: {{ section.settings.card_bg | default: '#18181B' }};
    border: 1px solid rgba(239, 68, 68, 0.2); border-radius: 6px; padding: 28px 24px;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .hp61-feat__card:hover { transform: translateY(-4px); border-color: #EF4444; box-shadow: 0 0 25px rgba(239, 68, 68, 0.25); }
  .hp61-feat__card-icon {
    width: 48px; height: 48px; background: linear-gradient(135deg, #450A0A, #18181B);
    border-radius: 4px; display: flex; align-items: center; justify-content: center;
    font-size: 20px; color: #EF4444; margin-bottom: 18px;
    border: 1px solid rgba(239, 68, 68, 0.35);
  }
  .hp61-feat__card-title { font-family: 'Syne', sans-serif; font-size: 17px; font-weight: 700; color: #FFFFFF; margin: 0 0 8px; }
  .hp61-feat__card-desc { font-size: 13px; line-height: 1.6; color: #A1A1AA; margin: 0; font-family: 'Space Grotesk', sans-serif; }
  @media screen and (max-width: 992px) { .hp61-feat__grid { grid-template-columns: repeat(2, 1fr); } }
  @media screen and (max-width: 480px) { .hp61-feat__grid { grid-template-columns: 1fr; } }
{%- endstyle -%}
<div class="hp61-feat__container">
  <div class="hp61-feat__header">
    {%- if section.settings.eyebrow != blank -%}<p class="hp61-feat__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="hp61-feat__heading">{{ section.settings.heading | default: 'The Geothermal Mineral Forge' }}</h2>
  </div>
  <div class="hp61-feat__grid">
    {%- for block in section.blocks -%}
      <div class="hp61-feat__card" {{ block.shopify_attributes }}>
        <div class="hp61-feat__card-icon">{{ block.settings.icon | default: '🌋' }}</div>
        <h3 class="hp61-feat__card-title">{{ block.settings.title | default: 'Basalt Lava' }}</h3>
        <p class="hp61-feat__card-desc">{{ block.settings.description | default: 'Thermal mineral energy.' }}</p>
      </div>
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "HP61 Features",
  "class": "section-hp61-feat",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#09090B" },
    { "type": "color", "id": "card_bg", "label": "Card BG", "default": "#18181B" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#EF4444" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "🌋 MINERAL FORGE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Geothermal Mineral Forge" },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "label": "Columns", "default": 3 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "blocks": [{
    "type": "feature", "name": "Feature",
    "settings": [
      { "type": "text", "id": "icon", "label": "Icon", "default": "🌋" },
      { "type": "text", "id": "title", "label": "Title", "default": "Basalt Lava" },
      { "type": "textarea", "id": "description", "label": "Description", "default": "Thermal mineral energy." }
    ]
  }],
  "presets": [{
    "name": "HP61 Features",
    "blocks": [
      { "type": "feature", "settings": { "icon": "🌋", "title": "Icelandic Basalt Ash", "description": "Micronized black mineral particles that draw out heavy pollutants with natural negative ionic charge." } },
      { "type": "feature", "settings": { "icon": "⚡", "title": "Bioactive Thermal Silica", "description": "Strengthens cellular matrix and rebuilds collagen fibers from inner dermal layers." } },
      { "type": "feature", "settings": { "icon": "🔥", "title": "Elemental Magma Sulfur", "description": "Regulates sebaceous over-production and clears stubborn bacterial pore congestion." } },
      { "type": "feature", "settings": { "icon": "💎", "title": "Obsidian Crystal Powder", "description": "Subtle mineral polishing delivering exceptional light reflection and smooth skin finish." } },
      { "type": "feature", "settings": { "icon": "💧", "title": "Geothermal Spring Water", "description": "Naturally enriched with 14 bio-assimilable trace electrolytes for skin repair." } },
      { "type": "feature", "settings": { "icon": "🛡️", "title": "Zero Chemical Sulfates", "description": "Pure volcanic formulation without SLS, phthalates, synthetic fragrance, or artificial dyes." } }
    ]
  }]
}
{% endschema %}
