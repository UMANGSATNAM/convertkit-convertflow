{% comment %}
  Main List Collections — all collections grid
{% endcomment %}
{%- assign s = section.settings -%}
<style>
  .mlc {
    padding: {{ s.padding_top }}px 20px {{ s.padding_bottom }}px;
    background: {{ s.bg_color }};
    color: {{ s.text_color }};
  }
  .mlc__inner { max-width: 1280px; margin: 0 auto; }
  .mlc__head { text-align: center; margin-bottom: 32px; }
  .mlc__title { font-size: 34px; margin: 0 0 8px; line-height: 1.15; }
  .mlc__sub { margin: 0; opacity: 0.75; font-size: 15px; }
  .mlc__grid {
    display: grid;
    grid-template-columns: repeat({{ s.columns }}, minmax(0, 1fr));
    gap: {{ s.gap }}px;
  }
  .mlc__card { display: block; text-decoration: none; color: inherit; }
  .mlc__media {
    position: relative; width: 100%; aspect-ratio: {{ s.image_ratio }};
    overflow: hidden; border-radius: {{ s.radius }}px; background: {{ s.card_bg }};
  }
  .mlc__media img,
  .mlc__media svg { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.5s ease; }
  .mlc__card:hover .mlc__media img { transform: scale(1.05); }
  .mlc__name { margin: 12px 0 2px; font-size: 16px; font-weight: 700; }
  .mlc__count { margin: 0; font-size: 13px; opacity: 0.65; }
  .mlc__empty { text-align: center; padding: 48px 0; opacity: 0.7; }

  @media screen and (max-width: 989px) {
    .mlc__grid { grid-template-columns: repeat({{ s.columns_tablet }}, minmax(0, 1fr)); }
  }
  @media screen and (max-width: 749px) {
    .mlc { padding-left: 16px; padding-right: 16px; }
    .mlc__title { font-size: 26px; }
    .mlc__grid { grid-template-columns: repeat({{ s.columns_mobile }}, minmax(0, 1fr)); gap: {{ s.gap | minus: 4 }}px; }
    .mlc__name { font-size: 14px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .mlc__media img { transition: none; }
  }
</style>

<div class="mlc">
  <div class="mlc__inner">
    {%- if s.title != blank or s.subtitle != blank -%}
      <div class="mlc__head">
        {%- if s.title != blank -%}<h1 class="mlc__title">{{ s.title }}</h1>{%- endif -%}
        {%- if s.subtitle != blank -%}<p class="mlc__sub">{{ s.subtitle }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    {%- liquid
      if s.collection_list != blank
        assign list = s.collection_list
      else
        assign list = collections
      endif
    -%}

    {%- if list.size > 0 -%}
      <div class="mlc__grid">
        {%- for collection in list -%}
          {%- if collection.handle != 'frontpage' -%}
            <a class="mlc__card" href="{{ collection.url }}">
              <div class="mlc__media">
                {%- if collection.featured_image -%}
                  <img
                    src="{{ collection.featured_image | image_url: width: 800 }}"
                    srcset="{{ collection.featured_image | image_url: width: 400 }} 400w,
                            {{ collection.featured_image | image_url: width: 800 }} 800w"
                    sizes="(max-width: 749px) 50vw, {{ 100 | divided_by: s.columns }}vw"
                    alt="{{ collection.title | escape }}"
                    width="800" height="800"
                    loading="lazy">
                {%- else -%}
                  {{ 'collection-1' | placeholder_svg_tag }}
                {%- endif -%}
              </div>
              <p class="mlc__name">{{ collection.title }}</p>
              {%- if s.show_count -%}
                <p class="mlc__count">{{ collection.all_products_count }} products</p>
              {%- endif -%}
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="mlc__empty">{{ s.empty_text }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "All Collections",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Shop by category" },
    { "type": "text", "id": "subtitle", "label": "Subheading", "default": "Browse every collection in the store" },
    { "type": "collection_list", "id": "collection_list", "label": "Collections (leave empty to show all)", "limit": 30 },
    { "type": "checkbox", "id": "show_count", "label": "Show product count", "default": true },
    { "type": "text", "id": "empty_text", "label": "Empty state text", "default": "No collections yet. Add collections in the Shopify admin." },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "columns", "min": 2, "max": 6, "step": 1, "label": "Columns (desktop)", "default": 4 },
    { "type": "range", "id": "columns_tablet", "min": 2, "max": 4, "step": 1, "label": "Columns (tablet)", "default": 3 },
    { "type": "range", "id": "columns_mobile", "min": 1, "max": 3, "step": 1, "label": "Columns (mobile)", "default": 2 },
    { "type": "range", "id": "gap", "min": 8, "max": 40, "step": 2, "unit": "px", "label": "Grid gap", "default": 20 },
    {
      "type": "select", "id": "image_ratio", "label": "Image ratio", "default": "1 / 1",
      "options": [
        { "value": "1 / 1", "label": "Square" },
        { "value": "4 / 5", "label": "Portrait" },
        { "value": "3 / 2", "label": "Landscape" }
      ]
    },
    { "type": "range", "id": "radius", "min": 0, "max": 32, "step": 2, "unit": "px", "label": "Corner radius", "default": 12 },
    { "type": "header", "content": "Colors & spacing" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#111111" },
    { "type": "color", "id": "card_bg", "label": "Image placeholder background", "default": "#F2F2F2" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding top", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom", "default": 64 }
  ],
  "presets": [{ "name": "All Collections" }]
}
{% endschema %}
