{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;700;900&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --border-color: #000000;
    --font-heading: 'Space Grotesk', sans-serif;
    --font-body: 'Space Grotesk', sans-serif;
    background-color: var(--bg-color);
    padding: 100px 20px;
  }

  .hp41-news-wrapper {
    max-width: 700px;
    margin: 0 auto;
    background: #D7FF43;
    border: 4px solid var(--border-color);
    border-radius: 24px;
    padding: 60px 40px;
    box-shadow: 16px 16px 0px var(--border-color);
    text-align: center;
    transform: rotate(-1deg);
    transition: transform 0.3s ease;
  }

  .hp41-news-wrapper:hover {
    transform: rotate(0);
  }

  .hp41-news__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 6vw, {{ section.settings.title_size }}px);
    font-weight: 900;
    color: var(--border-color);
    margin: 0 0 15px;
    text-transform: uppercase;
  }

  .hp41-news__text {
    font-family: var(--font-body);
    font-size: 20px;
    font-weight: 700;
    color: var(--border-color);
    margin: 0 0 40px;
  }

  .hp41-news__form {
    display: flex;
    gap: 15px;
    max-width: 500px;
    margin: 0 auto;
  }

  @media screen and (max-width: 600px) {
    .hp41-news__form {
      flex-direction: column;
    }
  }

  .hp41-news__input {
    flex: 1;
    padding: 15px 20px;
    border: 4px solid var(--border-color);
    border-radius: 12px;
    background: #FFF;
    font-family: var(--font-heading);
    font-size: 18px;
    font-weight: 700;
    color: var(--border-color);
    outline: none;
    box-shadow: 4px 4px 0px var(--border-color);
  }

  .hp41-news__input::placeholder {
    color: #999;
  }

  .hp41-news__btn {
    padding: 15px 30px;
    background: #FF4911;
    color: #FFF;
    border: 4px solid var(--border-color);
    border-radius: 12px;
    font-family: var(--font-heading);
    font-size: 18px;
    font-weight: 900;
    text-transform: uppercase;
    cursor: pointer;
    box-shadow: 6px 6px 0px var(--border-color);
    transition: all 0.1s ease;
  }

  .hp41-news__btn:hover {
    transform: translate(2px, 2px);
    box-shadow: 4px 4px 0px var(--border-color);
  }

  .hp41-news__btn:active {
    transform: translate(6px, 6px);
    box-shadow: 0px 0px 0px var(--border-color);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp41-news-wrapper" id="HP41News-{{ section.id }}">
  <h2 class="hp41-news__title">{{ section.settings.title }}</h2>
  {%- if section.settings.text != blank -%}
    <p class="hp41-news__text">{{ section.settings.text }}</p>
  {%- endif -%}

  {%- form 'customer', class: 'hp41-news__form' -%}
    <input type="hidden" name="contact[tags]" value="newsletter">
    <input type="email" name="contact[email]" class="hp41-news__input" placeholder="{{ section.settings.placeholder }}" required>
    <button type="submit" class="hp41-news__btn">{{ section.settings.btn_label }}</button>
  {%- endform -%}
</div>

{% schema %}
{
  "name": "HP41 - Neo Newsletter",
  "class": "section-hp41-newsletter",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "JOIN THE GANG" },
    { "type": "text", "id": "text", "label": "Text", "default": "Get the inside scoop. New drops, secret sales, weird stuff." },
    { "type": "text", "id": "placeholder", "label": "Placeholder", "default": "YOUR EMAIL..." },
    { "type": "text", "id": "btn_label", "label": "Button", "default": "LET'S GO" },
    { "type": "range", "id": "title_size", "min": 24, "max": 80, "step": 2, "unit": "px", "label": "Heading Size", "default": 48 },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FDF0D5" },
    { "type": "html", "id": "custom_css", "label": "Custom CSS" }
  ],
  "presets": [{ "name": "HP41 - Neo Newsletter" }]
}
{% endschema %}
