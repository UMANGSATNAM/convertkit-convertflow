{%- liquid
  assign bg_color = section.settings.bg_color | default: '#f9f6f0'
  assign text_color = section.settings.text_color | default: '#2c2c2c'
  assign accent_color = section.settings.accent_color | default: '#d4af37'
  
  assign padding_top_desktop = section.settings.padding_top_desktop
  assign padding_bottom_desktop = section.settings.padding_bottom_desktop
  assign padding_top_mobile = section.settings.padding_top_mobile
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile
-%}

<style>
  #shopify-section-{{ section.id }} {
    --hp4-cpills-bg: {{ bg_color }};
    --hp4-cpills-text: {{ text_color }};
    --hp4-cpills-accent: {{ accent_color }};
    
    --hp4-cpills-pt-desk: {{ padding_top_desktop }}px;
    --hp4-cpills-pb-desk: {{ padding_bottom_desktop }}px;
    --hp4-cpills-pt-mob: {{ padding_top_mobile }}px;
    --hp4-cpills-pb-mob: {{ padding_bottom_mobile }}px;
  }

  .hp4-decor-cpills-{{ section.id }} {
    padding-top: var(--hp4-cpills-pt-desk);
    padding-bottom: var(--hp4-cpills-pb-desk);
    background-color: var(--hp4-cpills-bg);
    font-family: 'Inter', sans-serif;
  }

  .hp4-cpills-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hp4-cpills-title {
    font-family: 'Playfair Display', serif;
    font-size: 24px;
    color: var(--hp4-cpills-text);
    margin: 0 0 30px 0;
    font-style: italic;
    font-weight: 400;
  }

  .hp4-cpills-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 15px;
  }

  /* Pill Design - Elegant Outline */
  .hp4-cpills-item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 30px;
    border: 1px solid rgba(44,44,44,0.15);
    border-radius: 50px;
    background: transparent;
    color: var(--hp4-cpills-text);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 1px;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
  }

  .hp4-cpills-item:hover {
    background: var(--hp4-cpills-text);
    color: var(--hp4-cpills-bg);
    border-color: var(--hp4-cpills-text);
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgba(0,0,0,0.05);
  }

  @media screen and (max-width: 768px) {
    .hp4-decor-cpills-{{ section.id }} {
      padding-top: var(--hp4-cpills-pt-mob);
      padding-bottom: var(--hp4-cpills-pb-mob);
    }
    .hp4-cpills-inner {
      padding: 0 20px;
      align-items: flex-start;
    }
    .hp4-cpills-title {
      font-size: 20px;
      margin-bottom: 20px;
    }
    /* Horizontal scroll on mobile */
    .hp4-cpills-list {
      flex-wrap: nowrap;
      overflow-x: auto;
      justify-content: flex-start;
      width: 100%;
      padding-bottom: 10px; /* space for scrollbar */
      scrollbar-width: none;
    }
    .hp4-cpills-list::-webkit-scrollbar { display: none; }
    .hp4-cpills-item {
      flex-shrink: 0;
    }
  }
</style>

<section class="hp4-decor-cpills-{{ section.id }}" aria-label="Category Links">
  <div class="hp4-cpills-inner">
    
    {%- if section.settings.heading != blank -%}
      <h3 class="hp4-cpills-title">{{ section.settings.heading }}</h3>
    {%- endif -%}

    <div class="hp4-cpills-list">
      {%- for block in section.blocks -%}
        {%- assign coll = collections[block.settings.collection] -%}
        {%- assign title = block.settings.title | default: coll.title | default: 'Category' -%}
        {%- assign link = block.settings.link | default: coll.url | default: '#' -%}
        
        <a href="{{ link }}" class="hp4-cpills-item" {{ block.shopify_attributes }}>
          {{ title }}
        </a>
      {%- endfor -%}

      {%- if section.blocks.size == 0 -%}
        <a href="#" class="hp4-cpills-item">Living Room</a>
        <a href="#" class="hp4-cpills-item">Bedroom</a>
        <a href="#" class="hp4-cpills-item">Dining</a>
        <a href="#" class="hp4-cpills-item">Lighting</a>
        <a href="#" class="hp4-cpills-item">Accessories</a>
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "HP4 Decor Category Pills",
  "tag": "section",
  "class": "section-hp4-cpills",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Room"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f9f6f0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2c2c2c"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Top (Desktop)", "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Bottom (Desktop)", "default": 60
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Top (Mobile)", "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Bottom (Mobile)", "default": 30
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection (Optional)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom Label (Overrides collection name)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom Link (Overrides collection url)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP4 Decor Category Pills",
      "category": "Collection",
      "blocks": [
        { "type": "category", "settings": { "title": "Living" } },
        { "type": "category", "settings": { "title": "Dining" } },
        { "type": "category", "settings": { "title": "Lighting" } },
        { "type": "category", "settings": { "title": "Decor" } }
      ]
    }
  ]
}
{% endschema %}
