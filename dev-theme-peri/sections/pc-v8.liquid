{%- comment -%}
  PC V8 — HERITAGE VINTAGE AMERICANA PRODUCT GRID
  Design: Parchment Beige (#F4EFEA), Forest Green (#1E3A2B) & Crimson (#8B0000) accents
  Card Shape: 0px corners, dashed vintage borders, Cinzel & Courier Prime typography
{%- endcomment -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700;800&family=Courier+Prime:ital,wght@0,400;0,700;1,400&display=swap');

  .pcv8 {
    --bg: {{ section.settings.bg_color | default: '#F4EFEA' }};
    --card-bg: {{ section.settings.card_bg | default: '#FFFDF9' }};
    --text: {{ section.settings.text_color | default: '#2B2621' }};
    --muted: {{ section.settings.muted_color | default: '#7C7368' }};
    --accent: {{ section.settings.accent_color | default: '#1E3A2B' }};
    --accent-hover: {{ section.settings.accent_hover | default: '#12251B' }};
    --border: {{ section.settings.border_color | default: '#D4C8B8' }};
    --badge-sale-bg: #8B0000;
    --badge-sale-text: #FFFFFF;
    --f-serif: 'Cinzel', serif;
    --f-mono: 'Courier Prime', monospace;
    --ease: all 0.3s ease;
    background-color: var(--bg);
    color: var(--text);
    font-family: var(--f-mono);
    padding: {{ section.settings.padding_top | default: 60 }}px 0 {{ section.settings.padding_bottom | default: 60 }}px 0;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }

  .pcv8 *, .pcv8 *::before, .pcv8 *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .pcv8 a { color: inherit; text-decoration: none; }
  .pcv8 button { font-family: inherit; cursor: pointer; border: none; background: none; }
  .pcv8 img { max-width: 100%; display: block; }

  .pcv8__wrap { max-width: 1280px; margin: 0 auto; padding: 0 24px; }

  /* HEADER */
  .pcv8__head { display: flex; flex-direction: column; gap: 10px; margin-bottom: 40px; text-align: {{ section.settings.header_align | default: 'center' }}; border-bottom: 2px dashed var(--border); padding-bottom: 24px; }
  @media (min-width: 768px) {
    .pcv8__head { display: flex; flex-direction: row; justify-content: space-between; align-items: flex-end; }
  }
  .pcv8__title { font-family: var(--f-serif); font-size: 30px; font-weight: 700; color: var(--text); letter-spacing: 0.05em; text-transform: uppercase; }
  @media (min-width: 768px) { .pcv8__title { font-size: 38px; } }
  .pcv8__sub { font-size: 14px; color: var(--muted); font-style: italic; }
  .pcv8__viewall { display: inline-flex; align-items: center; gap: 8px; font-weight: 700; font-size: 12px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent); border: 1px solid var(--accent); padding: 8px 16px; transition: var(--ease); }
  .pcv8__viewall:hover { background: var(--accent); color: #FFFDF9; }

  /* GRID */
  .pcv8__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr);
    gap: 20px;
  }
  @media (min-width: 640px) {
    .pcv8__grid { grid-template-columns: repeat({{ section.settings.cols_tablet | default: 3 }}, 1fr); gap: 28px; }
  }
  @media (min-width: 1024px) {
    .pcv8__grid { grid-template-columns: repeat({{ section.settings.cols_desktop | default: 4 }}, 1fr); gap: 32px; }
  }

  /* CARD */
  .pcv8__card {
    background: var(--card-bg);
    border: 1px dashed var(--border);
    border-radius: 0px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    position: relative;
    transition: var(--ease);
  }
  .pcv8__card:hover {
    border-style: solid;
    border-color: var(--accent);
    box-shadow: 0 10px 25px -5px rgba(30, 58, 43, 0.12);
  }

  /* IMAGE BOX */
  .pcv8__img-box {
    position: relative;
    width: 100%;
    aspect-ratio: {{ section.settings.img_ratio | default: '4/5' }};
    background: #EAE3D8;
    overflow: hidden;
    border-bottom: 1px dashed var(--border);
  }
  .pcv8__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: sepia(20%);
    transition: transform 0.5s ease, filter 0.5s ease;
  }
  .pcv8__img--sec {
    position: absolute;
    top: 0; left: 0;
    opacity: 0;
  }
  .pcv8__card:hover .pcv8__img { filter: sepia(0%); }
  .pcv8__card:hover .pcv8__img--pri {
    {% if section.settings.enable_sec_img %}
      opacity: 0;
    {% else %}
      transform: scale(1.05);
    {% endif %}
  }
  .pcv8__card:hover .pcv8__img--sec { opacity: 1; transform: scale(1.05); }

  /* BADGES */
  .pcv8__badges { position: absolute; top: 12px; left: 12px; display: flex; flex-direction: column; gap: 6px; z-index: 2; pointer-events: none; }
  .pcv8__badge { font-size: 10px; font-weight: 700; text-transform: uppercase; padding: 4px 8px; border: 1px solid currentColor; letter-spacing: 0.08em; font-family: var(--f-serif); }
  .pcv8__badge--sale { background: var(--badge-sale-bg); color: var(--badge-sale-text); border-color: #550000; }
  .pcv8__badge--tag { background: var(--accent); color: #FFFDF9; border-color: #12251B; }
  .pcv8__badge--sold { background: #7C7368; color: #FFFDF9; border-color: #555555; }

  /* WISHLIST BUTTON */
  .pcv8__wish {
    position: absolute;
    top: 12px; right: 12px;
    width: 36px; height: 36px;
    background: #FFFDF9;
    border: 1px solid var(--border);
    display: flex; align-items: center; justify-content: center;
    color: var(--muted);
    z-index: 3;
    transition: var(--ease);
  }
  .pcv8__wish:hover { background: var(--accent); color: #FFFDF9; border-color: var(--accent); }
  .pcv8__wish.active { color: #8B0000; border-color: #8B0000; }

  /* QUICK ADD HOVER */
  .pcv8__quick-box { padding: 12px; background: var(--card-bg); border-top: 1px dashed var(--border); }
  .pcv8__quick-btn {
    width: 100%;
    padding: 10px 14px;
    background: var(--accent);
    color: #FFFDF9;
    font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em;
    font-family: var(--f-serif);
    border: 1px solid var(--accent);
    display: flex; align-items: center; justify-content: center; gap: 8px;
    transition: var(--ease);
  }
  .pcv8__quick-btn:hover { background: var(--accent-hover); border-color: var(--accent-hover); }
  .pcv8__quick-btn:disabled { background: #D4C8B8; color: #7C7368; border-color: #D4C8B8; cursor: not-allowed; }

  /* CARD CONTENT */
  .pcv8__content { padding: 16px; display: flex; flex-direction: column; gap: 6px; flex-grow: 1; text-align: center; }

  .pcv8__vendor { font-size: 10px; text-transform: uppercase; color: var(--accent); font-weight: 700; letter-spacing: 0.1em; font-family: var(--f-serif); }
  .pcv8__item-title { font-family: var(--f-serif); font-size: 16px; font-weight: 600; color: var(--text); line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  /* RATING */
  .pcv8__rating { display: flex; align-items: center; justify-content: center; gap: 6px; font-size: 11px; color: var(--accent); font-weight: 700; }
  .pcv8__stars { letter-spacing: 2px; }
  .pcv8__rev-cnt { color: var(--muted); font-size: 11px; }

  /* PRICE */
  .pcv8__price-row { display: flex; align-items: baseline; justify-content: center; gap: 8px; margin-top: auto; padding-top: 4px; }
  .pcv8__price { font-size: 16px; font-weight: 700; color: var(--text); font-family: var(--f-serif); }
  .pcv8__cmp-price { font-size: 13px; color: var(--muted); text-decoration: line-through; }

  /* SWATCHES */
  .pcv8__swatches { display: flex; gap: 6px; align-items: center; justify-content: center; margin-top: 4px; }
  .pcv8__swatch { width: 13px; height: 13px; border-radius: 50%; border: 1px solid var(--border); cursor: pointer; transition: var(--ease); }
  .pcv8__swatch:hover, .pcv8__swatch.active { transform: scale(1.25); border-color: var(--accent); }

  /* URGENCY MICRO */
  .pcv8__urgency { font-size: 11px; color: #8B0000; font-style: italic; display: flex; align-items: center; justify-content: center; gap: 4px; margin-top: 2px; }

  /* TOAST */
  .pcv8__toast {
    position: fixed; bottom: 20px; right: 20px;
    background: var(--accent); color: #FFFDF9;
    border: 1px solid #12251B; padding: 12px 24px;
    font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em;
    font-family: var(--f-serif);
    z-index: 9999;
    transform: translateY(100px); opacity: 0;
    transition: all 0.3s ease;
  }
  .pcv8__toast.show { transform: translateY(0); opacity: 1; }
</style>

<div class="pcv8">
  <div class="pcv8__wrap">
    
    {% if section.settings.title != blank or section.settings.subheading != blank %}
      <div class="pcv8__head">
        <div>
          {% if section.settings.title != blank %}
            <h2 class="pcv8__title">{{ section.settings.title | escape }}</h2>
          {% endif %}
          {% if section.settings.subheading != blank %}
            <p class="pcv8__sub">{{ section.settings.subheading | escape }}</p>
          {% endif %}
        </div>
        {% if section.settings.show_view_all and section.settings.collection != blank %}
          <a href="{{ collections[section.settings.collection].url }}" class="pcv8__viewall">
            {{ section.settings.view_all_label | default: 'View Archive' }} &rarr;
          </a>
        {% endif %}
      </div>
    {% endif %}

    <div class="pcv8__grid">
      {% assign target_coll = collections[section.settings.collection] %}
      {% assign limit_num = section.settings.products_per_page | default: 8 %}

      {% if target_coll != blank and target_coll.products.size > 0 %}
        {% for product in target_coll.products limit: limit_num %}
          {% assign current_variant = product.selected_or_first_available_variant %}
          
          {% render 'card-v8', product: product, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v8', product: nil, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% endif %}
    </div>

  </div>
</div>

<div class="pcv8__toast" id="pcv8-toast">PIECE ORDERED</div>

<script>
(function(){
  // Wishlist is handled globally by assets/wishlist.js (shared store: cf_wishlist_items).
  // Buttons are rendered by snippets/wishlist-button.liquid — no per-section storage.


  document.querySelectorAll('[data-pcv8-add]').forEach(function(btn){
    btn.addEventListener('click', function(e){
      e.preventDefault(); e.stopPropagation();
      var id = btn.dataset.pcv8Add, orig = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = 'PROCESSING...';

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: id, quantity: 1 })
      })
      .then(function(r){ return r.json(); })
      .then(function(){
        btn.innerHTML = '✓ ORDERED';
        showT('PIECE ORDERED');
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      })
      .catch(function(){
        btn.innerHTML = 'ERROR';
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      });
    });
  });

  function showT(msg){
    var t = document.getElementById('pcv8-toast');
    if(!t) return;
    t.textContent = msg;
    t.classList.add('show');
    setTimeout(function(){ t.classList.remove('show'); }, 3000);
  }
})();
</script>

