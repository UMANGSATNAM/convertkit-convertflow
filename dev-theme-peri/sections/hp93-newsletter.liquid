{%- style -%}#shopify-section-{{ section.id }}{background:#FEFCE8;padding:50px 24px;text-align:center}.hp93-nl{max-width:520px;margin:0 auto}.hp93-nl input{flex:1;padding:12px;border:1px solid rgba(0,0,0,.15);border-radius:8px}.hp93-nl button{padding:12px 20px;background:#CA8A04;color:#fff;border:none;border-radius:8px;font-weight:700}{%- endstyle -%}<div class="hp93-nl"><h2 style="font-size:24px;font-weight:800;margin:0">{{section.settings.heading|default:'Join JEWELLERY'}}</h2><p style="opacity:.6">{{section.settings.sub|default:'Get 10% off'}}</p><form method="post" action="/contact#contact_form" style="display:flex;gap:8px;margin-top:12px"><input type="email" name="contact[email]" placeholder="you@email.com" required><button type="submit">{{section.settings.btn|default:'Subscribe'}}</button></form></div>{% schema %}{"name":"HP93 Newsletter","settings":[{"type":"text","id":"heading","label":"Heading","default":"Join JEWELLERY"},{"type":"text","id":"sub","label":"Sub","default":"Get 10% off"},{"type":"text","id":"btn","label":"Btn","default":"Subscribe"}],"presets":[{"name":"HP93 Newsletter"}]}{% endschema %}