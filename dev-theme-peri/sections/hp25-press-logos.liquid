{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,100..900;1,9..144,100..900&family=Outfit:wght@300;400;600;800&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-orange: {{ section.settings.accent_orange }};
    --accent-yellow: {{ section.settings.accent_yellow }};
    --font-heading: 'Fraunces', serif;
    --font-body: 'Outfit', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    position: relative;
    /* Subtle grainy texture */
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.03'/%3E%3C/svg%3E");
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }

  .hp25-press-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
    position: relative;
    z-index: 1;
  }

  @media screen and (max-width: 768px) {
    .hp25-press-wrapper {
      padding: 0 20px;
    }
  }

  .hp25-press__container {
    background: var(--accent-yellow);
    border: 4px solid var(--text-color);
    border-radius: 50px;
    padding: 40px 60px;
    box-shadow: 10px 10px 0 var(--accent-orange);
    text-align: center;
  }

  @media screen and (max-width: 768px) {
    .hp25-press__container {
      padding: 30px 20px;
      border-radius: 30px;
      box-shadow: 6px 6px 0 var(--accent-orange);
    }
  }

  .hp25-press__title {
    font-family: var(--font-heading);
    font-size: clamp(24px, 4vw, {{ section.settings.title_size }}px);
    font-weight: 800;
    font-style: italic;
    color: var(--text-color);
    margin: 0 0 30px;
    position: relative;
    display: inline-block;
  }

  /* Little stars next to title */
  .hp25-press__title::before,
  .hp25-press__title::after {
    content: '✦';
    color: var(--accent-orange);
    font-style: normal;
    font-size: 0.8em;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
  }

  .hp25-press__title::before { left: -30px; }
  .hp25-press__title::after { right: -30px; }

  .hp25-press__grid {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 40px 60px;
  }

  @media screen and (max-width: 768px) {
    .hp25-press__grid {
      gap: 30px;
    }
  }

  .hp25-press__logo {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hp25-press__logo img {
    max-width: 150px;
    max-height: 50px;
    object-fit: contain;
    /* Vintage filter */
    filter: sepia(1) hue-rotate(340deg) saturate(3) opacity(0.8) contrast(1.2);
    mix-blend-mode: multiply;
    transition: all 0.3s ease;
  }

  .hp25-press__logo:hover img {
    filter: sepia(1) hue-rotate(340deg) saturate(3) opacity(1) contrast(1.5);
    transform: scale(1.05);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp25-press-wrapper" id="HP25Press-{{ section.id }}">
  <div class="hp25-press__container">
    {%- if section.settings.title != blank -%}
      <h2 class="hp25-press__title">{{ section.settings.title }}</h2>
    {%- endif -%}

    <div class="hp25-press__grid">
      {%- for block in section.blocks -%}
        <div class="hp25-press__logo" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img height="{{ block.settings.image.height }}" width="{{ block.settings.image.width }}" src="{{ block.settings.image | image_url: width: 300 }}" alt="Press Logo" loading="lazy">
          {%- else -%}
            <div style="font-family:var(--font-heading);font-style:italic;font-weight:900;font-size:24px;color:var(--text-color);opacity:0.8;">LOGO</div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "HP25 - Retro Press",
  "class": "section-hp25-press-logos",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "MAKING WAVES"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 800,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1200
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 32
    },
    {
      "type": "header",
      "content": "Retro 70s Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#F5E6D3"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text / Border (Dark Brown)",
      "default": "#3E2723"
    },
    {
      "type": "color",
      "id": "accent_orange",
      "label": "Accent (Burnt Orange)",
      "default": "#D15F3C"
    },
    {
      "type": "color",
      "id": "accent_yellow",
      "label": "Accent (Mustard)",
      "default": "#E2B144"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 40
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP25 - Retro Press",
      "blocks": [
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" }
      ]
    }
  ]
}
{% endschema %}
