{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Montserrat:wght@300;400;500&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --gold-color: {{ section.settings.gold_color }};
    
    --font-heading: 'Playfair Display', serif;
    --font-body: 'Montserrat', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    border-bottom: 1px solid rgba(212, 175, 55, 0.2);
    overflow: hidden;
  }

  .hp33-ugc-wrapper {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp33-ugc-wrapper {
      padding: 0 20px;
    }
  }

  .hp33-ugc__header {
    text-align: center;
    margin-bottom: 50px;
  }

  .hp33-ugc__subtitle {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    color: var(--gold-color);
    text-transform: uppercase;
    letter-spacing: 4px;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 15px;
  }

  .hp33-ugc__subtitle::before,
  .hp33-ugc__subtitle::after {
    content: '';
    height: 1px;
    width: 30px;
    background: var(--gold-color);
  }

  .hp33-ugc__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    line-height: 1.1;
    color: var(--text-color);
    margin: 0;
    font-weight: 400;
  }

  .hp33-ugc__slider {
    display: flex;
    gap: 40px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding-bottom: 20px;
  }

  .hp33-ugc__slider::-webkit-scrollbar {
    display: none;
  }

  .hp33-ugc__item {
    flex: 0 0 calc(100% / {{ section.settings.columns_desktop }} - 40px + (40px / {{ section.settings.columns_desktop }}));
    scroll-snap-align: start;
    position: relative;
    aspect-ratio: 9/16;
    cursor: pointer;
    group: card;
  }

  @media screen and (max-width: 992px) {
    .hp33-ugc__item {
      flex: 0 0 calc(33.333% - 27px);
    }
  }

  @media screen and (max-width: 768px) {
    .hp33-ugc__item {
      flex: 0 0 calc(50% - 20px);
    }
  }

  @media screen and (max-width: 480px) {
    .hp33-ugc__item {
      flex: 0 0 calc(85% - 20px);
    }
  }

  .hp33-ugc__frame {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    border: 1px solid var(--gold-color);
    z-index: 2;
    pointer-events: none;
  }

  .hp33-ugc__frame::after {
    content: '';
    position: absolute;
    top: 5px; left: 5px; right: 5px; bottom: 5px;
    border: 1px solid rgba(212, 175, 55, 0.3);
  }

  .hp33-ugc__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: sepia(30%) brightness(0.9);
    transition: filter 0.4s ease;
  }

  .hp33-ugc__item:hover .hp33-ugc__video {
    filter: sepia(0%) brightness(1);
  }

  .hp33-ugc__play {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%) scale(0.9);
    width: 60px; height: 60px;
    border-radius: 50%;
    border: 1px solid var(--gold-color);
    background: rgba(0,0,0,0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 3;
    opacity: 0.8;
    transition: all 0.4s ease;
  }

  .hp33-ugc__play::before {
    content: '';
    position: absolute;
    top: 3px; left: 3px; right: 3px; bottom: 3px;
    border: 1px solid rgba(212, 175, 55, 0.4);
    border-radius: 50%;
  }

  .hp33-ugc__play-icon {
    width: 0;
    height: 0;
    border-top: 8px solid transparent;
    border-bottom: 8px solid transparent;
    border-left: 12px solid var(--gold-color);
    margin-left: 4px;
  }

  .hp33-ugc__item:hover .hp33-ugc__play {
    transform: translate(-50%, -50%) scale(1.1);
    opacity: 1;
    background: rgba(212, 175, 55, 0.2);
  }

  .hp33-ugc__handle {
    position: absolute;
    bottom: 20px;
    left: 0; right: 0;
    text-align: center;
    font-family: var(--font-body);
    font-size: 13px;
    color: #fff;
    z-index: 3;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp33-ugc-wrapper" id="HP33Ugc-{{ section.id }}">
  <div class="hp33-ugc__header">
    {%- if section.settings.subtitle != blank -%}
      <div class="hp33-ugc__subtitle">{{ section.settings.subtitle }}</div>
    {%- endif -%}
    <h2 class="hp33-ugc__title">{{ section.settings.title }}</h2>
  </div>

  <div class="hp33-ugc__slider">
    {%- for block in section.blocks -%}
      <div class="hp33-ugc__item" {{ block.shopify_attributes }}>
        <div class="hp33-ugc__frame"></div>
        {%- if block.settings.video_url != blank -%}
          <video class="hp33-ugc__video" autoplay loop muted playsinline>
            <source src="{{ block.settings.video_url }}" type="video/mp4">
          </video>
        {%- else -%}
          {%- assign placeholder = 'collection-' | append: forloop.index -%}
          {%- if forloop.index > 6 -%}{%- assign placeholder = 'collection-1' -%}{%- endif -%}
          {{ placeholder | placeholder_svg_tag: 'hp33-ugc__video' }}
        {%- endif -%}
        
        <div class="hp33-ugc__play">
          <div class="hp33-ugc__play-icon"></div>
        </div>
        
        <div class="hp33-ugc__handle">{{ block.settings.handle }}</div>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "HP33 - Deco UGC",
  "class": "section-hp33-ugc-reels",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "SOCIETY PORTRAITS"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "The Discerning Few"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 3,
      "max": 6,
      "step": 1,
      "label": "Columns (Desktop)",
      "default": 4
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 48
    },
    {
      "type": "header",
      "content": "Deco Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (e.g. Deep Emerald)",
      "default": "#0e1a14"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "gold_color",
      "label": "Gold Accent",
      "default": "#d4af37"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "UGC Video",
      "settings": [
        {
          "type": "text",
          "id": "video_url",
          "label": "MP4 Video URL"
        },
        {
          "type": "text",
          "id": "handle",
          "label": "User Handle",
          "default": "PATRON"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP33 - Deco UGC",
      "blocks": [
        { "type": "video" },
        { "type": "video" },
        { "type": "video" },
        { "type": "video" },
        { "type": "video" }
      ]
    }
  ]
}
{% endschema %}
