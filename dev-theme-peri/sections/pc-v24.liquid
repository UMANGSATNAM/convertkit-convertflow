{%- comment -%}
  PC V24 — EDITORIAL NEWSPAPER PRODUCT GRID
  Design: Off-White Newsprint (#F9F8F6), Ink Black (#111111) accents, Playfair Display & Courier Prime typography
  Card Shape: 0px corners, double rule borders, vintage newsprint layout
{%- endcomment -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Courier+Prime:ital,wght@0,400;0,700;1,400&family=Playfair+Display:ital,wght@0,600;0,700;1,400&display=swap');

  .pcv24 {
    --bg: {{ section.settings.bg_color | default: '#F9F8F6' }};
    --card-bg: {{ section.settings.card_bg | default: '#FFFFFF' }};
    --text: {{ section.settings.text_color | default: '#111111' }};
    --muted: {{ section.settings.muted_color | default: '#555555' }};
    --accent: {{ section.settings.accent_color | default: '#111111' }};
    --accent-hover: {{ section.settings.accent_hover | default: '#333333' }};
    --border: {{ section.settings.border_color | default: '#111111' }};
    --badge-sale-bg: #111111;
    --badge-sale-text: #F9F8F6;
    --f-serif: 'Playfair Display', serif;
    --f-mono: 'Courier Prime', monospace;
    --ease: all 0.25s ease;
    background-color: var(--bg);
    color: var(--text);
    font-family: var(--f-mono);
    padding: {{ section.settings.padding_top | default: 60 }}px 0 {{ section.settings.padding_bottom | default: 60 }}px 0;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }

  .pcv24 *, .pcv24 *::before, .pcv24 *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .pcv24 a { color: inherit; text-decoration: none; }
  .pcv24 button { font-family: inherit; cursor: pointer; border: none; background: none; }
  .pcv24 img { max-width: 100%; display: block; }

  .pcv24__wrap { max-width: 1280px; margin: 0 auto; padding: 0 20px; }

  /* HEADER */
  .pcv24__head { display: flex; flex-direction: column; gap: 8px; margin-bottom: 40px; border-bottom: 4px double var(--border); padding-bottom: 20px; text-align: {{ section.settings.header_align | default: 'center' }}; }
  @media (min-width: 768px) {
    .pcv24__head { display: flex; flex-direction: row; justify-content: space-between; align-items: flex-end; }
  }
  .pcv24__title { font-family: var(--f-serif); font-size: 32px; font-weight: 700; color: var(--text); letter-spacing: -0.01em; }
  @media (min-width: 768px) { .pcv24__title { font-size: 44px; } }
  .pcv24__sub { font-size: 14px; color: var(--muted); font-style: italic; }
  .pcv24__viewall { display: inline-flex; align-items: center; gap: 8px; font-weight: 700; font-size: 12px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text); border-bottom: 2px solid var(--text); padding-bottom: 2px; transition: var(--ease); }
  .pcv24__viewall:hover { opacity: 0.6; }

  /* GRID */
  .pcv24__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr);
    gap: 20px;
  }
  @media (min-width: 640px) {
    .pcv24__grid { grid-template-columns: repeat({{ section.settings.cols_tablet | default: 3 }}, 1fr); gap: 28px; }
  }
  @media (min-width: 1024px) {
    .pcv24__grid { grid-template-columns: repeat({{ section.settings.cols_desktop | default: 4 }}, 1fr); gap: 32px; }
  }

  /* CARD */
  .pcv24__card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 0px;
    display: flex;
    flex-direction: column;
    position: relative;
    transition: var(--ease);
  }
  .pcv24__card:hover {
    background: #F4F2EB;
    box-shadow: 0 10px 25px -5px rgba(17, 17, 17, 0.1);
  }

  /* IMAGE BOX */
  .pcv24__img-box {
    position: relative;
    width: 100%;
    aspect-ratio: {{ section.settings.img_ratio | default: '4/5' }};
    background: #EAE8E2;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
  }
  .pcv24__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: contrast(1.05);
    transition: opacity 0.3s ease, transform 0.4s ease;
  }
  .pcv24__img--sec {
    position: absolute;
    top: 0; left: 0;
    opacity: 0;
  }
  .pcv24__card:hover .pcv24__img--pri {
    {% if section.settings.enable_sec_img %}
      opacity: 0;
    {% else %}
      transform: scale(1.04);
    {% endif %}
  }
  .pcv24__card:hover .pcv24__img--sec { opacity: 1; transform: scale(1.04); }

  /* BADGES */
  .pcv24__badges { position: absolute; top: 12px; left: 12px; display: flex; flex-direction: column; gap: 6px; z-index: 2; pointer-events: none; }
  .pcv24__badge { font-size: 10px; font-weight: 700; text-transform: uppercase; padding: 3px 8px; border: 1px solid var(--border); letter-spacing: 0.1em; font-family: var(--f-mono); }
  .pcv24__badge--sale { background: var(--badge-sale-bg); color: var(--badge-sale-text); }
  .pcv24__badge--tag { background: #FFFFFF; color: #111111; }
  .pcv24__badge--sold { background: #555555; color: #FFFFFF; }

  /* WISHLIST BUTTON */
  .pcv24__wish {
    position: absolute;
    top: 12px; right: 12px;
    width: 36px; height: 36px;
    background: #FFFFFF;
    border: 1px solid var(--border);
    display: flex; align-items: center; justify-content: center;
    color: var(--text);
    z-index: 3;
    transition: var(--ease);
  }
  .pcv24__wish:hover { background: var(--accent); color: #F9F8F6; }
  .pcv24__wish.active { background: var(--accent); color: #F9F8F6; }

  /* QUICK ADD BUTTON */
  .pcv24__quick-box { padding: 12px; background: transparent; border-top: 1px solid var(--border); }
  .pcv24__quick-btn {
    width: 100%;
    padding: 10px 14px;
    background: var(--text);
    color: #F9F8F6;
    font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em;
    font-family: var(--f-mono);
    border: none;
    display: flex; align-items: center; justify-content: center; gap: 8px;
    transition: var(--ease);
  }
  .pcv24__quick-btn:hover { background: #333333; }
  .pcv24__quick-btn:disabled { background: #888888; color: #CCCCCC; cursor: not-allowed; }

  /* CARD CONTENT */
  .pcv24__content { padding: 16px; display: flex; flex-direction: column; gap: 6px; flex-grow: 1; text-align: center; }

  .pcv24__vendor { font-size: 10px; text-transform: uppercase; color: var(--muted); font-weight: 700; letter-spacing: 0.15em; }
  .pcv24__item-title { font-family: var(--f-serif); font-size: 17px; font-weight: 600; color: var(--text); line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  /* RATING */
  .pcv24__rating { display: flex; align-items: center; justify-content: center; gap: 6px; font-size: 11px; color: var(--text); }
  .pcv24__stars { letter-spacing: 2px; }
  .pcv24__rev-cnt { color: var(--muted); font-size: 11px; }

  /* PRICE */
  .pcv24__price-row { display: flex; align-items: baseline; justify-content: center; gap: 8px; margin-top: auto; padding-top: 4px; }
  .pcv24__price { font-size: 16px; font-weight: 700; color: var(--text); font-family: var(--f-mono); }
  .pcv24__cmp-price { font-size: 13px; color: var(--muted); text-decoration: line-through; }

  /* SWATCHES */
  .pcv24__swatches { display: flex; gap: 6px; align-items: center; justify-content: center; margin-top: 4px; }
  .pcv24__swatch { width: 12px; height: 12px; border-radius: 50%; border: 1px solid var(--border); cursor: pointer; transition: var(--ease); }
  .pcv24__swatch:hover, .pcv24__swatch.active { transform: scale(1.25); background: var(--text); }

  /* URGENCY MICRO */
  .pcv24__urgency { font-size: 11px; color: var(--text); font-style: italic; display: flex; align-items: center; justify-content: center; gap: 4px; margin-top: 2px; }

  /* TOAST */
  .pcv24__toast {
    position: fixed; bottom: 20px; right: 20px;
    background: var(--text); color: #F9F8F6;
    border: 1px solid var(--border); padding: 12px 22px;
    font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em;
    font-family: var(--f-mono);
    z-index: 9999;
    transform: translateY(100px); opacity: 0;
    transition: all 0.25s ease;
  }
  .pcv24__toast.show { transform: translateY(0); opacity: 1; }
</style>

<div class="pcv24">
  <div class="pcv24__wrap">
    
    {% if section.settings.title != blank or section.settings.subheading != blank %}
      <div class="pcv24__head">
        <div>
          {% if section.settings.title != blank %}
            <h2 class="pcv24__title">{{ section.settings.title | escape }}</h2>
          {% endif %}
          {% if section.settings.subheading != blank %}
            <p class="pcv24__sub">{{ section.settings.subheading | escape }}</p>
          {% endif %}
        </div>
        {% if section.settings.show_view_all and section.settings.collection != blank %}
          <a href="{{ collections[section.settings.collection].url }}" class="pcv24__viewall">
            {{ section.settings.view_all_label | default: 'Read Entire Issue' }} &rarr;
          </a>
        {% endif %}
      </div>
    {% endif %}

    <div class="pcv24__grid">
      {% assign target_coll = collections[section.settings.collection] %}
      {% assign limit_num = section.settings.products_per_page | default: 8 %}

      {% if target_coll != blank and target_coll.products.size > 0 %}
        {% for product in target_coll.products limit: limit_num %}
          {% assign current_variant = product.selected_or_first_available_variant %}
          
          {% render 'card-v24', product: product, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v24', product: nil, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% endif %}
    </div>

  </div>
</div>

<div class="pcv24__toast" id="pcv24-toast">EDITION ORDERED</div>

<script>
(function(){
  // Wishlist is handled globally by assets/wishlist.js (shared store: cf_wishlist_items).
  // Buttons are rendered by snippets/wishlist-button.liquid — no per-section storage.


  document.querySelectorAll('[data-pcv24-add]').forEach(function(btn){
    btn.addEventListener('click', function(e){
      e.preventDefault(); e.stopPropagation();
      var id = btn.dataset.pcv24Add, orig = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = 'ORDERING...';

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: id, quantity: 1 })
      })
      .then(function(r){ return r.json(); })
      .then(function(){
        btn.innerHTML = '✓ ORDERED';
        showT('EDITION ORDERED');
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      })
      .catch(function(){
        btn.innerHTML = 'ERROR';
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      });
    });
  });

  function showT(msg){
    var t = document.getElementById('pcv24-toast');
    if(!t) return;
    t.textContent = msg;
    t.classList.add('show');
    setTimeout(function(){ t.classList.remove('show'); }, 3000);
  }
})();
</script>

