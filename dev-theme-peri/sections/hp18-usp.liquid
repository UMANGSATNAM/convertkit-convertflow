{%- liquid
  assign sec_id = section.id
  assign bg_color = section.settings.bg_color
  assign text_color = section.settings.text_color
  assign box_bg_color = section.settings.box_bg_color
  assign border_color = section.settings.border_color
  assign shadow_color = section.settings.shadow_color
  assign border_width = section.settings.border_width
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
  assign title = section.settings.title
-%}

<style>
  .hp18-usp-{{ sec_id }} {
    background-color: {{ bg_color }};
    padding-top: {{ padding_top }}px;
    padding-bottom: {{ padding_bottom }}px;
    border-bottom: {{ border_width }}px solid {{ border_color }};
  }

  .hp18-usp-{{ sec_id }}__container {
    max-width: var(--page-width, 1440px);
    margin: 0 auto;
    padding: 0 40px;
  }

  .hp18-usp-{{ sec_id }}__header {
    text-align: center;
    margin-bottom: 50px;
  }

  .hp18-usp-{{ sec_id }}__title {
    font-family: 'Arial Black', Impact, sans-serif;
    font-size: clamp(32px, 5vw, 56px);
    color: {{ text_color }};
    text-transform: uppercase;
    margin: 0;
    text-shadow: 3px 3px 0px {{ shadow_color }};
    letter-spacing: -1px;
  }

  .hp18-usp-{{ sec_id }}__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 40px;
  }

  .hp18-usp-{{ sec_id }}__item {
    background-color: {{ box_bg_color }};
    border: {{ border_width }}px solid {{ border_color }};
    padding: 50px 30px;
    text-align: center;
    box-shadow: 10px 10px 0px {{ shadow_color }};
    transition: transform 0.2s cubic-bezier(0.25, 1, 0.5, 1), box-shadow 0.2s ease;
    position: relative;
    overflow: hidden;
  }

  /* Decorative tape element in brutalist style */
  .hp18-usp-{{ sec_id }}__item::before {
    content: '';
    position: absolute;
    top: 15px;
    left: -20px;
    width: 100px;
    height: 15px;
    background-color: {{ shadow_color }};
    transform: rotate(-45deg);
    opacity: 0.2;
    z-index: 1;
  }

  .hp18-usp-{{ sec_id }}__item:hover {
    transform: translate(-5px, -5px);
    box-shadow: 15px 15px 0px {{ shadow_color }};
  }

  .hp18-usp-{{ sec_id }}__icon-wrapper {
    width: 80px;
    height: 80px;
    background-color: {{ text_color }};
    color: {{ box_bg_color }};
    border: {{ border_width }}px solid {{ border_color }};
    display: inline-flex;
    justify-content: center;
    align-items: center;
    font-size: 36px;
    margin-bottom: 30px;
    box-shadow: 4px 4px 0px {{ shadow_color }};
    border-radius: {{ section.settings.icon_radius }}%;
    position: relative;
    z-index: 2;
    transition: transform 0.3s ease;
  }

  .hp18-usp-{{ sec_id }}__item:hover .hp18-usp-{{ sec_id }}__icon-wrapper {
    transform: rotate(10deg) scale(1.1);
  }

  .hp18-usp-{{ sec_id }}__item-title {
    font-family: 'Arial Black', sans-serif;
    font-size: 22px;
    text-transform: uppercase;
    color: {{ text_color }};
    margin: 0 0 15px 0;
    position: relative;
    z-index: 2;
  }

  .hp18-usp-{{ sec_id }}__item-text {
    font-family: 'Courier New', monospace;
    font-weight: bold;
    font-size: 16px;
    line-height: 1.5;
    color: {{ text_color }};
    margin: 0;
    opacity: 0.9;
    position: relative;
    z-index: 2;
  }

  @media screen and (max-width: 992px) {
    .hp18-usp-{{ sec_id }}__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 30px;
    }
  }

  @media screen and (max-width: 768px) {
    .hp18-usp-{{ sec_id }}__container {
      padding: 0 20px;
    }
    .hp18-usp-{{ sec_id }}__grid {
      grid-template-columns: 1fr;
      gap: 25px;
    }
    .hp18-usp-{{ sec_id }}__item {
      padding: 30px 20px;
      box-shadow: 6px 6px 0px {{ shadow_color }};
    }
    .hp18-usp-{{ sec_id }}__item:hover {
      transform: translate(-3px, -3px);
      box-shadow: 9px 9px 0px {{ shadow_color }};
    }
    .hp18-usp-{{ sec_id }}__icon-wrapper {
      width: 60px;
      height: 60px;
      font-size: 28px;
      margin-bottom: 20px;
    }
  }
</style>

<section class="hp18-usp-{{ sec_id }}">
  <div class="hp18-usp-{{ sec_id }}__container">
    
    {% if title != blank %}
    <div class="hp18-usp-{{ sec_id }}__header">
      <h2 class="hp18-usp-{{ sec_id }}__title">{{ title }}</h2>
    </div>
    {% endif %}

    <div class="hp18-usp-{{ sec_id }}__grid">
      {% for block in section.blocks %}
        <div class="hp18-usp-{{ sec_id }}__item" {{ block.shopify_attributes }}>
          <div class="hp18-usp-{{ sec_id }}__icon-wrapper">
            {% if block.settings.custom_icon != blank %}
              <img height="{{ block.settings.custom_icon.height }}" width="{{ block.settings.custom_icon.width }}" src="{{ block.settings.custom_icon | image_url: width: 100 }}" alt="" style="width: 50%; height: 50%; object-fit: contain;">
            {% else %}
              {{ block.settings.icon }}
            {% endif %}
          </div>
          <h3 class="hp18-usp-{{ sec_id }}__item-title">{{ block.settings.title }}</h3>
          <p class="hp18-usp-{{ sec_id }}__item-text">{{ block.settings.text }}</p>
        </div>
      {% else %}
        {% for i in (1..4) %}
        <div class="hp18-usp-{{ sec_id }}__item">
          <div class="hp18-usp-{{ sec_id }}__icon-wrapper">📦</div>
          <h3 class="hp18-usp-{{ sec_id }}__item-title">FREE SHIPPING</h3>
          <p class="hp18-usp-{{ sec_id }}__item-text">On all orders over $100 globally.</p>
        </div>
        {% endfor %}
      {% endfor %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "HP18 Advanced USP",
  "max_blocks": 4,
  "settings": [
    {
      "type": "header",
      "content": "Color Settings"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#CCFF00"
    },
    {
      "type": "color",
      "id": "box_bg_color",
      "label": "Card Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "shadow_color",
      "label": "Shadow Color",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Heading",
      "default": "THE DIFFERENCE"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "Border Width",
      "default": 3
    },
    {
      "type": "range",
      "id": "icon_radius",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "%",
      "label": "Icon Border Radius",
      "default": 0,
      "info": "0% for square, 50% for circle"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 10,
      "unit": "px",
      "label": "Padding Top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 10,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "usp",
      "name": "Selling Point",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Emoji Icon",
          "default": "📦"
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Custom Icon Image (Overrides Emoji)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "FREE SHIPPING"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "On all orders over $100 globally."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP18 Advanced USP",
      "blocks": [
        { "type": "usp", "settings": { "icon": "📦", "title": "FREE SHIPPING", "text": "On all orders over $100 globally." } },
        { "type": "usp", "settings": { "icon": "♻️", "title": "SUSTAINABLE", "text": "Made from recycled materials." } },
        { "type": "usp", "settings": { "icon": "💎", "title": "PREMIUM QUALITY", "text": "Built to outlast the hype." } },
        { "type": "usp", "settings": { "icon": "🔙", "title": "EASY RETURNS", "text": "30-day money back guarantee." } }
      ]
    }
  ]
}
{% endschema %}
