{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Montserrat:wght@300;400;500&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --gold-color: {{ section.settings.gold_color }};
    
    --font-heading: 'Playfair Display', serif;
    --font-body: 'Montserrat', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .hp33-offer-wrapper {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp33-offer-wrapper {
      padding: 0 20px;
    }
  }

  .hp33-offer__container {
    background: var(--bg-color);
    border: 1px solid var(--gold-color);
    padding: 60px 40px;
    text-align: center;
    position: relative;
  }

  /* Inner thin line */
  .hp33-offer__container::after {
    content: '';
    position: absolute;
    top: 6px; left: 6px; right: 6px; bottom: 6px;
    border: 1px solid rgba(212, 175, 55, 0.3);
    pointer-events: none;
  }

  /* Corner accents */
  .hp33-offer__corner {
    position: absolute;
    width: 20px; height: 20px;
    border: 1px solid var(--gold-color);
    z-index: 2;
  }

  .hp33-offer__corner--tl { top: -4px; left: -4px; border-right: none; border-bottom: none; }
  .hp33-offer__corner--tr { top: -4px; right: -4px; border-left: none; border-bottom: none; }
  .hp33-offer__corner--bl { bottom: -4px; left: -4px; border-right: none; border-top: none; }
  .hp33-offer__corner--br { bottom: -4px; right: -4px; border-left: none; border-top: none; }

  .hp33-offer__subtitle {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    color: var(--gold-color);
    text-transform: uppercase;
    letter-spacing: 4px;
    margin-bottom: 20px;
    display: inline-block;
  }

  .hp33-offer__title {
    font-family: var(--font-heading);
    font-size: clamp(36px, 5vw, {{ section.settings.title_size }}px);
    line-height: 1.1;
    color: var(--text-color);
    margin: 0 0 20px;
    font-weight: 400;
  }

  .hp33-offer__text {
    font-family: var(--font-body);
    font-size: 16px;
    color: var(--text-color);
    margin: 0 0 30px;
    font-weight: 300;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .hp33-offer__code-wrap {
    margin-bottom: 30px;
  }

  .hp33-offer__code {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 20px;
    font-weight: 500;
    color: var(--gold-color);
    border: 1px dashed var(--gold-color);
    padding: 10px 25px;
    letter-spacing: 2px;
  }

  .hp33-offer__btn {
    display: inline-table;
    background: transparent;
    color: var(--text-color);
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    text-transform: uppercase;
    text-decoration: none;
    letter-spacing: 2px;
    padding: 15px 40px;
    border: 1px solid var(--gold-color);
    position: relative;
    overflow: hidden;
    transition: all 0.4s ease;
  }

  .hp33-offer__btn::before {
    content: '';
    position: absolute;
    top: 3px; left: 3px; right: 3px; bottom: 3px;
    border: 1px solid rgba(212, 175, 55, 0.3);
    transition: all 0.4s ease;
  }

  .hp33-offer__btn:hover {
    background: var(--gold-color);
    color: #000;
  }

  .hp33-offer__btn:hover::before {
    border-color: #000;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp33-offer-wrapper" id="HP33Offer-{{ section.id }}">
  <div class="hp33-offer__container">
    <div class="hp33-offer__corner hp33-offer__corner--tl"></div>
    <div class="hp33-offer__corner hp33-offer__corner--tr"></div>
    <div class="hp33-offer__corner hp33-offer__corner--bl"></div>
    <div class="hp33-offer__corner hp33-offer__corner--br"></div>

    {%- if section.settings.subtitle != blank -%}
      <div class="hp33-offer__subtitle">{{ section.settings.subtitle }}</div>
    {%- endif -%}
    
    <h2 class="hp33-offer__title">{{ section.settings.title }}</h2>
    
    <p class="hp33-offer__text">{{ section.settings.text }}</p>
    
    {%- if section.settings.code != blank -%}
      <div class="hp33-offer__code-wrap">
        <div class="hp33-offer__code">{{ section.settings.code }}</div>
      </div>
    {%- endif -%}
    
    {%- if section.settings.btn_label != blank -%}
      <a href="{{ section.settings.btn_link | default: '#' }}" class="hp33-offer__btn">
        {{ section.settings.btn_label }}
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP33 - Deco Offer",
  "class": "section-hp33-offer-banner",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "PRIVATE INVITATION"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Heading",
      "default": "The Vernal Equinox Event"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "For a limited time, esteemed patrons may enjoy an exclusive adjustment on select acquisitions."
    },
    {
      "type": "text",
      "id": "code",
      "label": "Discount Code",
      "default": "EQUINOX20"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "ACCESS THE EVENT"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 56
    },
    {
      "type": "header",
      "content": "Deco Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (e.g. Deep Emerald)",
      "default": "#0e1a14"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "gold_color",
      "label": "Gold Accent",
      "default": "#d4af37"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 100
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP33 - Deco Offer"
    }
  ]
}
{% endschema %}
