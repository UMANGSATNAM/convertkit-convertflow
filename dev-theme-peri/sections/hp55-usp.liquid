{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#1F0B18' }};
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
  }
  .hp55-usp__container { max-width: {{ section.settings.container_width | default: 1280 }}px; margin: 0 auto; padding: 0 24px; }
  .hp55-usp__grid { display: grid; grid-template-columns: repeat({{ section.settings.columns | default: 4 }}, 1fr); gap: 20px; }
  .hp55-usp__card {
    background: {{ section.settings.card_bg | default: '#2A0E22' }};
    border: 1px solid rgba(233, 213, 255, 0.15);
    border-radius: 16px; padding: 32px 22px; text-align: center;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .hp55-usp__card:hover {
    transform: translateY(-4px);
    border-color: rgba(192, 132, 252, 0.45);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.4);
  }
  .hp55-usp__icon {
    width: 52px; height: 52px;
    background: linear-gradient(135deg, #3B1230, #C084FC);
    border-radius: 50%; display: flex; align-items: center; justify-content: center;
    margin: 0 auto 16px; font-size: 22px; color: #FFFFFF;
    border: 1px solid rgba(233, 213, 255, 0.3);
  }
  .hp55-usp__title {
    font-family: 'Playfair Display', serif; font-size: 17px; font-weight: 700; color: #FFFFFF; margin: 0 0 8px;
  }
  .hp55-usp__desc { font-size: 13px; line-height: 1.6; color: #E9D5FF; margin: 0; opacity: 0.85; }
  @media screen and (max-width: 992px) { .hp55-usp__grid { grid-template-columns: repeat(2, 1fr); } }
  @media screen and (max-width: 480px) { .hp55-usp__grid { grid-template-columns: 1fr; } }
{%- endstyle -%}
<div class="hp55-usp__container">
  <div class="hp55-usp__grid">
    {%- for block in section.blocks -%}
      <div class="hp55-usp__card" {{ block.shopify_attributes }}>
        <div class="hp55-usp__icon">{{ block.settings.icon | default: '✦' }}</div>
        <h3 class="hp55-usp__title">{{ block.settings.title | default: 'Royal Formulation' }}</h3>
        <p class="hp55-usp__desc">{{ block.settings.description | default: 'Crushed South Sea pearl nacre.' }}</p>
      </div>
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "HP55 Pillars",
  "class": "section-hp55-usp",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#1F0B18" },
    { "type": "color", "id": "card_bg", "label": "Card BG", "default": "#2A0E22" },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "label": "Columns", "default": 4 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 80 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "blocks": [{ "type": "pillar", "name": "Pillar", "settings": [
    { "type": "text", "id": "icon", "label": "Icon", "default": "✦" },
    { "type": "text", "id": "title", "label": "Title", "default": "Royal Formulation" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Crushed South Sea pearl nacre." }
  ]}],
  "presets": [{ "name": "HP55 Pillars", "blocks": [
    { "type": "pillar", "settings": { "icon": "👑", "title": "Royal Bio-Lipids", "description": "Wild plum extract restores lipid barrier." } },
    { "type": "pillar", "settings": { "icon": "🦪", "title": "South Sea Pearl", "description": "Micro-milled nacre for ethereal radiance." } },
    { "type": "pillar", "settings": { "icon": "🌸", "title": "Black Orchid", "description": "Rare botanical antioxidant shield." } },
    { "type": "pillar", "settings": { "icon": "✨", "title": "24K Rose Gold", "description": "Cellular revitalization catalyst." } }
  ]}]
}
{% endschema %}
