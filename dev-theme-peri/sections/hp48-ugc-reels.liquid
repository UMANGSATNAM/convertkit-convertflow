{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp48-ugc-bg: {{ section.settings.bg_color | default: '#FAF8F5' }};
    --hp48-gold: {{ section.settings.accent_gold | default: '#C59B27' }};
    
    background-color: var(--hp48-ugc-bg);
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
  }

  .hp48-ugc__wrap {
    max-width: {{ section.settings.container_width | default: 1240 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp48-ugc__header {
    text-align: center;
    margin-bottom: 40px;
  }

  .hp48-ugc__heading {
    font-family: 'Cinzel', serif;
    font-size: clamp(28px, 4vw, 38px);
    font-weight: 700;
    color: #1A1715;
    margin: 0;
  }

  .hp48-ugc__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: 4 }}, 1fr);
    gap: 18px;
  }

  .hp48-ugc__card {
    aspect-ratio: 9/16;
    border-radius: 8px;
    overflow: hidden;
    position: relative;
    border: 1px solid rgba(197, 155, 39, 0.3);
    background: #EAE6DF;
    box-shadow: 0 10px 30px rgba(26, 23, 21, 0.08);
  }

  .hp48-ugc__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .hp48-ugc__card:hover .hp48-ugc__img { transform: scale(1.05); }

  .hp48-ugc__overlay {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    padding: 18px;
    background: linear-gradient(to top, rgba(26, 23, 21, 0.9), transparent);
    color: #FAF8F5;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
  }

  .hp48-ugc__handle {
    font-family: 'Montserrat', sans-serif;
    font-size: 12px;
    font-weight: 700;
    margin: 0 0 2px;
    color: var(--hp48-gold);
  }

  .hp48-ugc__tag {
    font-size: 11px;
    color: #FAF8F5;
    margin: 0;
  }

  @media screen and (max-width: 992px) {
    .hp48-ugc__grid { grid-template-columns: repeat(2, 1fr); }
  }
{%- endstyle -%}

<div class="hp48-ugc__wrap">
  <div class="hp48-ugc__header">
    <h2 class="hp48-ugc__heading">{{ section.settings.heading | default: 'The Royal Sovereign Society' }}</h2>
  </div>

  <div class="hp48-ugc__grid">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <div class="hp48-ugc__card" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img height="{{ block.settings.image.height }}" width="{{ block.settings.image.width }}" src="{{ block.settings.image | image_url: width: 600 }}" class="hp48-ugc__img" alt="{{ block.settings.handle }}" loading="lazy">
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'hp48-ugc__img' }}
          {%- endif -%}
          <div class="hp48-ugc__overlay">
            <div>
              <p class="hp48-ugc__handle">{{ block.settings.handle | default: '@royal_hauteglow' }}</p>
              <p class="hp48-ugc__tag">{{ block.settings.tag | default: '#24KGoldRitual' }}</p>
            </div>
            <span style="color:var(--hp48-gold);">▶</span>
          </div>
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="hp48-ugc__card">
        {{ 'lifestyle-2' | placeholder_svg_tag: 'hp48-ugc__img' }}
        <div class="hp48-ugc__overlay">
          <div><p class="hp48-ugc__handle">@geneva_couture</p><p class="hp48-ugc__tag">#24KNectar</p></div>
          <span style="color:#C59B27;">▶</span>
        </div>
      </div>
      <div class="hp48-ugc__card">
        {{ 'lifestyle-2' | placeholder_svg_tag: 'hp48-ugc__img' }}
        <div class="hp48-ugc__overlay">
          <div><p class="hp48-ugc__handle">@london_society</p><p class="hp48-ugc__tag">#WhiteTruffle</p></div>
          <span style="color:#C59B27;">▶</span>
        </div>
      </div>
      <div class="hp48-ugc__card">
        {{ 'lifestyle-2' | placeholder_svg_tag: 'hp48-ugc__img' }}
        <div class="hp48-ugc__overlay">
          <div><p class="hp48-ugc__handle">@dubai_royals</p><p class="hp48-ugc__tag">#PearlOil</p></div>
          <span style="color:#C59B27;">▶</span>
        </div>
      </div>
      <div class="hp48-ugc__card">
        {{ 'lifestyle-2' | placeholder_svg_tag: 'hp48-ugc__img' }}
        <div class="hp48-ugc__overlay">
          <div><p class="hp48-ugc__handle">@monaco_glow</p><p class="hp48-ugc__tag">#GoldFoilMask</p></div>
          <span style="color:#C59B27;">▶</span>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP48 - Royal UGC",
  "class": "section-hp48-ugc",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#FAF8F5" },
    { "type": "color", "id": "accent_gold", "label": "Gold Accent", "default": "#C59B27" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Royal Sovereign Society" },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "label": "Desktop Columns", "default": 4 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 80 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1240 }
  ],
  "blocks": [
    {
      "type": "reel",
      "name": "Reel Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "handle", "label": "Handle", "default": "@royal_hauteglow" },
        { "type": "text", "id": "tag", "label": "Tag", "default": "#24KGoldRitual" }
      ]
    }
  ],
  "presets": [
    { "name": "HP48 - Royal UGC" }
  ]
}
{% endschema %}
