{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#FAFAFA'
  assign text_color = section.settings.text_color | default: '#333333'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    color: {{ text_color }};
    border-bottom: 1px solid #E5E5E5;
  }
  
  .hp12-announcement-container-{{ section_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 10px 20px;
    min-height: 38px;
    text-align: center;
  }
  
  .hp12-announcement-text-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: 0.75rem;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin: 0;
  }
  
  .hp12-announcement-text-{{ section_id }} a {
    color: {{ text_color }};
    text-decoration: none;
    border-bottom: 1px solid transparent;
    margin-left: 10px;
    transition: border-color 0.3s ease;
  }
  
  .hp12-announcement-text-{{ section_id }} a:hover {
    border-color: {{ text_color }};
  }

@media screen and (max-width: 768px) {
  .hp12-announcement-bar {
    padding-left: 16px !important;
    padding-right: 16px !important;
    box-sizing: border-box !important;
  }
  img {
    max-width: 100% !important;
    height: auto !important;
  }
}

</style>

<div class="hp12-announcement-container-{{ section_id }}">
  <p class="hp12-announcement-text-{{ section_id }}">
    {{ section.settings.text | default: 'Complimentary shipping on all orders.' }}
    {% if section.settings.link != blank %}
      <a href="{{ section.settings.link }}">Discover</a>
    {% endif %}
  </p>
</div>

{% schema %}
{
  "name": "HP12 Announcement Bar",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FAFAFA"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#333333"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Announcement Text",
      "default": "Complimentary shipping on all orders."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link (Optional)"
    }
  ],
  "presets": [
    {
      "name": "HP12 Announcement Bar"
    }
  ]
}
{% endschema %}
