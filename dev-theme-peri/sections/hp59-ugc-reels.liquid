{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#FFFBEB' }};
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
  }
  .hp59-ugc__container { max-width: {{ section.settings.container_width | default: 1280 }}px; margin: 0 auto; padding: 0 24px; }
  .hp59-ugc__header { text-align: center; margin-bottom: 40px; }
  .hp59-ugc__eyebrow { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: {{ section.settings.accent_color | default: '#F97316' }}; margin: 0 0 12px; }
  .hp59-ugc__heading { font-family: 'Cormorant Garamond', serif; font-size: clamp(28px, 3.5vw, 42px); font-weight: 700; color: #042F2E; margin: 0; }
  .hp59-ugc__grid { display: grid; grid-template-columns: repeat({{ section.settings.columns | default: 4 }}, 1fr); gap: 16px; }
  .hp59-ugc__item {
    aspect-ratio: 9/16; border-radius: 16px; overflow: hidden; position: relative;
    background: #FEF3C7; border: 1px solid rgba(249, 115, 22, 0.25);
  }
  .hp59-ugc__item img { width: 100%; height: 100%; object-fit: cover; }
  .hp59-ugc__overlay {
    position: absolute; bottom: 0; left: 0; right: 0; padding: 16px;
    background: linear-gradient(transparent, rgba(4, 47, 46, 0.85));
  }
  .hp59-ugc__handle { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 12px; font-weight: 600; color: #FFFBEB; margin: 0; }
  @media screen and (max-width: 992px) { .hp59-ugc__grid { grid-template-columns: repeat(2, 1fr); } }
  @media screen and (max-width: 480px) { .hp59-ugc__grid { grid-template-columns: repeat(2, 1fr); gap: 10px; } }
{%- endstyle -%}
<div class="hp59-ugc__container">
  <div class="hp59-ugc__header">
    {%- if section.settings.eyebrow != blank -%}<p class="hp59-ugc__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="hp59-ugc__heading">{{ section.settings.heading | default: 'Golden Hour Community' }}</h2>
  </div>
  <div class="hp59-ugc__grid">
    {%- for block in section.blocks -%}
      <div class="hp59-ugc__item" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          <img height="{{ block.settings.image.height }}" width="{{ block.settings.image.width }}" src="{{ block.settings.image | image_url: width: 400 }}" alt="{{ block.settings.handle }}" loading="lazy">
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag }}
        {%- endif -%}
        <div class="hp59-ugc__overlay">
          <p class="hp59-ugc__handle">{{ block.settings.handle | default: '@coral_radiance' }}</p>
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "HP59 UGC",
  "class": "section-hp59-ugc",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FFFBEB" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#F97316" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "🪸 COMMUNITY REELS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Golden Hour Community" },
    { "type": "range", "id": "columns", "min": 2, "max": 6, "step": 1, "label": "Columns", "default": 4 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 80 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "blocks": [{
    "type": "reel", "name": "Reel",
    "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "handle", "label": "Handle", "default": "@coral_radiance" }
    ]
  }],
  "presets": [{ "name": "HP59 UGC", "blocks": [
    { "type": "reel" },
    { "type": "reel", "settings": { "handle": "@marine_glow" } },
    { "type": "reel", "settings": { "handle": "@kelp_ritual" } },
    { "type": "reel", "settings": { "handle": "@sunset_sunscreen" } }
  ]}]
}
{% endschema %}
