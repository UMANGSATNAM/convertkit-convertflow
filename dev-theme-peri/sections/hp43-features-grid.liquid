{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: "#080B10" }};
    padding: 90px 20px;
  }

  .hp43-feat__title {
    font-family: 'Orbitron', sans-serif;
    font-size: 32px;
    font-weight: 800;
    color: #F1F5F9;
    text-align: center;
    margin: 0 0 50px;
    text-transform: uppercase;
  }

  .hp43-feat__grid {
    max-width: 1320px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .hp43-feat__card {
    background: #101622;
    border: 1px solid #1E293B;
    border-radius: 6px;
    padding: 32px 24px;
    position: relative;
    box-shadow: 0 10px 30px rgba(0,0,0,0.5);
  }

  .hp43-feat__num {
    font-family: 'Orbitron', sans-serif;
    font-size: 30px;
    font-weight: 900;
    color: #00F0FF;
    margin-bottom: 14px;
  }

  .hp43-feat__h3 {
    font-family: 'Orbitron', sans-serif;
    font-size: 18px;
    font-weight: 700;
    color: #F1F5F9;
    margin: 0 0 10px;
    text-transform: uppercase;
  }

  .hp43-feat__p {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    color: #64748B;
    line-height: 1.6;
    margin: 0;
  }

  @media screen and (max-width: 900px) {
    .hp43-feat__grid { grid-template-columns: 1fr; }
  }
{%- endstyle -%}

<div class="hp43-feat__title">HARDWARE ARCHITECTURE</div>
<div class="hp43-feat__grid">
  <div class="hp43-feat__card">
    <div class="hp43-feat__num">01 //</div>
    <h3 class="hp43-feat__h3">HALL-EFFECT SENSORS</h3>
    <p class="hp43-feat__p">Rapid trigger actuation adjustable down to 0.1mm sensitivity for frame-perfect execution.</p>
  </div>
  <div class="hp43-feat__card">
    <div class="hp43-feat__num">02 //</div>
    <h3 class="hp43-feat__h3">GASKET MOUNTED</h3>
    <p class="hp43-feat__p">Multi-layer silicone acoustic dampening eliminates unwanted resonant chatter.</p>
  </div>
  <div class="hp43-feat__card">
    <div class="hp43-feat__num">03 //</div>
    <h3 class="hp43-feat__h3">DUAL WIRELESS</h3>
    <p class="hp43-feat__p">Seamless 2.4GHz low-latency wireless plus Bluetooth 5.3 multi-device pairing.</p>
  </div>
</div>

{% schema %}
{
  "name": "HP43 - Cyber Features",
  "class": "section-hp43-features",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#080B10"
    }
  ],
  "presets": [
    {
      "name": "HP43 - Cyber Features"
    }
  ]
}
{% endschema %}
