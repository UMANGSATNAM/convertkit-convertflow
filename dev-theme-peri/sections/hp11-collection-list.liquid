{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#CCFF00'
  assign text_color = section.settings.text_color | default: '#000000'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 100px 20px;
    border-bottom: 3px solid #000;
  }
  
  .hp11-collections-container-{{ section_id }} {
    max-width: 1400px;
    margin: 0 auto;
  }
  
  .hp11-collections-header-{{ section_id }} {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 60px;
    border-bottom: 4px solid #000;
    padding-bottom: 20px;
  }
  
  .hp11-collections-heading-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: clamp(3rem, 6vw, 5rem);
    font-weight: 900;
    text-transform: uppercase;
    margin: 0;
    line-height: 1;
    letter-spacing: -2px;
    color: {{ text_color }};
  }
  
  .hp11-collections-grid-{{ section_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
  }
  
  .hp11-collection-card-{{ section_id }} {
    position: relative;
    border: 4px solid #000;
    box-shadow: 8px 8px 0 #000;
    background: #000;
    display: block;
    text-decoration: none;
    overflow: hidden;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  
  .hp11-collection-card-{{ section_id }}::before {
    content: '';
    display: block;
    padding-top: 120%;
  }
  
  .hp11-collection-card-{{ section_id }}:hover {
    transform: translate(-4px, -4px);
    box-shadow: 12px 12px 0 #000;
  }
  
  .hp11-collection-image-{{ section_id }} {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover;
    opacity: 0.8;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  
  .hp11-collection-card-{{ section_id }}:hover .hp11-collection-image-{{ section_id }} {
    opacity: 0.5;
    transform: scale(1.05);
  }
  
  .hp11-collection-info-{{ section_id }} {
    position: absolute;
    bottom: 0; left: 0; width: 100%;
    padding: 30px;
    background: linear-gradient(to top, rgba(0,0,0,0.8) 0%, rgba(0,0,0,0) 100%);
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
  }
  
  .hp11-collection-title-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: 2rem;
    font-weight: 900;
    text-transform: uppercase;
    color: #FFF;
    margin: 0;
    letter-spacing: -1px;
    -webkit-text-stroke: 1px #000;
  }
  
  .hp11-collection-arrow-{{ section_id }} {
    width: 50px;
    height: 50px;
    background: #FF00FF;
    border: 2px solid #000;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 3px 3px 0 #000;
  }
  
  .hp11-collection-arrow-{{ section_id }} svg {
    width: 24px;
    height: 24px;
    fill: none;
    stroke: #000;
    stroke-width: 3;
  }

  @media (max-width: 992px) {
    .hp11-collections-grid-{{ section_id }} {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .hp11-collections-header-{{ section_id }} {
      flex-direction: column;
      align-items: flex-start;
      border-bottom: none;
    }
  }
</style>

<div class="hp11-collections-container-{{ section_id }}">
  <div class="hp11-collections-header-{{ section_id }}">
    <h2 class="hp11-collections-heading-{{ section_id }}">{{ section.settings.heading | default: 'CATEGORIES' }}</h2>
  </div>
  
  <div class="hp11-collections-grid-{{ section_id }}">
    {% for block in section.blocks limit: 3 %}
      <a href="{{ block.settings.link | default: '#' }}" class="hp11-collection-card-{{ section_id }}" {{ block.shopify_attributes }}>
        {% if block.settings.image != blank %}
          <img height="{{ block.settings.image.height }}" width="{{ block.settings.image.width }}" src="{{ block.settings.image | image_url: width: 800 }}" class="hp11-collection-image-{{ section_id }}" alt="Collection">
        {% else %}
          <div class="hp11-collection-image-{{ section_id }}" style="background: repeating-linear-gradient(45deg, #EFEFEF, #EFEFEF 12px, #E6E6E6 12px, #E6E6E6 24px);"></div>
        {% endif %}
        <div class="hp11-collection-info-{{ section_id }}">
          <h3 class="hp11-collection-title-{{ section_id }}">{{ block.settings.title | default: 'COLLECTION' }}</h3>
          <div class="hp11-collection-arrow-{{ section_id }}">
            <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
        </div>
      </a>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "HP11 Collection List",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#CCFF00"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "CATEGORIES"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "HOODIES"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP11 Collection List",
      "blocks": [
        { "type": "collection", "settings": { "title": "OUTERWEAR" } },
        { "type": "collection", "settings": { "title": "BOTTOMS" } },
        { "type": "collection", "settings": { "title": "ACCESSORIES" } }
      ]
    }
  ]
}
{% endschema %}
