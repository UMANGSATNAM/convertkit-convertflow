{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --font-heading: 'Press Start 2P', cursive;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    position: relative;
    overflow: hidden;
    /* Optional chunky border */
    border-top: 4px solid #000;
    border-bottom: 4px solid #000;
  }

  .hp28-marquee-wrapper {
    display: flex;
    white-space: nowrap;
    overflow: hidden;
    position: relative;
    /* Inset shadow for 3D retro feel */
    box-shadow: inset 0 3px 0 rgba(255,255,255,0.2), inset 0 -3px 0 rgba(0,0,0,0.3);
  }

  .hp28-marquee__track {
    display: flex;
    align-items: center;
    white-space: nowrap;
    animation: hp28Marquee {{ section.settings.speed }}s linear infinite;
  }

  /* Pause on hover if setting enabled */
  {%- if section.settings.pause_on_hover -%}
    .hp28-marquee-wrapper:hover .hp28-marquee__track {
      animation-play-state: paused;
    }
  {%- endif -%}

  /* Duplicate track for seamless loop */
  .hp28-marquee__track.is-duplicate {
    position: absolute;
    top: 0; left: 100%;
  }

  @keyframes hp28Marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-100%); }
  }

  .hp28-marquee__item {
    display: inline-flex;
    align-items: center;
    padding: 0 40px;
    font-family: var(--font-heading);
    font-size: clamp(16px, 2vw, {{ section.settings.text_size }}px);
    color: var(--text-color);
    text-transform: uppercase;
    text-shadow: 2px 2px 0 #000;
    line-height: 1;
  }

  .hp28-marquee__icon {
    margin-right: 20px;
    font-size: 1.2em;
    color: var(--text-color);
    text-shadow: 2px 2px 0 #000;
  }

  /* Optionally add a blink effect to some items */
  .hp28-marquee__item--blink {
    animation: retroBlink 1s step-end infinite;
  }

  @keyframes retroBlink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp28-marquee-wrapper" id="HP28Marquee-{{ section.id }}" role="marquee">
  
  <div class="hp28-marquee__track" aria-hidden="true">
    {%- for i in (1..6) -%}
      {%- for block in section.blocks -%}
        <div class="hp28-marquee__item {% if block.settings.blink %}hp28-marquee__item--blink{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != 'none' -%}
            <span class="hp28-marquee__icon">
              {%- case block.settings.icon -%}
                {%- when 'star' -%}★
                {%- when 'diamond' -%}✦
                {%- when 'triangle' -%}▲
                {%- when 'square' -%}■
                {%- when 'skull' -%}☠
                {%- when 'heart' -%}♥
              {%- endcase -%}
            </span>
          {%- endif -%}
          {{ block.settings.text }}
        </div>
      {%- endfor -%}
    {%- endfor -%}
  </div>

  <div class="hp28-marquee__track is-duplicate" aria-hidden="true">
    {%- for i in (1..6) -%}
      {%- for block in section.blocks -%}
        <div class="hp28-marquee__item {% if block.settings.blink %}hp28-marquee__item--blink{% endif %}">
          {%- if block.settings.icon != 'none' -%}
            <span class="hp28-marquee__icon">
              {%- case block.settings.icon -%}
                {%- when 'star' -%}★
                {%- when 'diamond' -%}✦
                {%- when 'triangle' -%}▲
                {%- when 'square' -%}■
                {%- when 'skull' -%}☠
                {%- when 'heart' -%}♥
              {%- endcase -%}
            </span>
          {%- endif -%}
          {{ block.settings.text }}
        </div>
      {%- endfor -%}
    {%- endfor -%}
  </div>
  
</div>

{% schema %}
{
  "name": "HP28 - Y2K Marquee",
  "class": "section-hp28-marquee",
  "settings": [
    {
      "type": "header",
      "content": "Behavior"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "s",
      "label": "Scroll Speed",
      "default": 30
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on Hover",
      "default": true
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 12,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Text Size",
      "default": 24
    },
    {
      "type": "header",
      "content": "Y2K Cyber Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (Magenta/Cyan)",
      "default": "#FF00FF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#00FFFF"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Top Padding",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 16
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text Block",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "SYSTEM OVERRIDE"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Retro Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "star", "label": "Star ★" },
            { "value": "diamond", "label": "Diamond ✦" },
            { "value": "triangle", "label": "Triangle ▲" },
            { "value": "square", "label": "Square ■" },
            { "value": "skull", "label": "Skull ☠" },
            { "value": "heart", "label": "Heart ♥" }
          ],
          "default": "star"
        },
        {
          "type": "checkbox",
          "id": "blink",
          "label": "Enable Blink Effect",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP28 - Y2K Marquee",
      "blocks": [
        { "type": "text", "settings": { "text": "FREE SHIPPING ON SECTOR 7", "icon": "star" } },
        { "type": "text", "settings": { "text": "ACCESS GRANTED", "icon": "diamond", "blink": true } },
        { "type": "text", "settings": { "text": "NEW HARDWARE DROP", "icon": "triangle" } }
      ]
    }
  ]
}
{% endschema %}
