{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Montserrat:wght@300;400;500&family=Pinyon+Script&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --gold-color: {{ section.settings.gold_color }};
    
    --font-heading: 'Playfair Display', serif;
    --font-body: 'Montserrat', sans-serif;
    --font-sig: 'Pinyon Script', cursive;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    border-bottom: 1px solid rgba(212, 175, 55, 0.2);
  }

  .hp33-story-wrapper {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    align-items: center;
    gap: 80px;
  }

  @media screen and (max-width: 992px) {
    .hp33-story-wrapper {
      flex-direction: column;
      gap: 40px;
      padding: 0 20px;
    }
  }

  .hp33-story__image-col {
    flex: 1;
    position: relative;
  }

  .hp33-story__image-wrap {
    position: relative;
    padding: 20px;
  }

  /* Ornate frame */
  .hp33-story__image-wrap::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    border: 1px solid var(--gold-color);
    z-index: 1;
  }

  .hp33-story__image-wrap::after {
    content: '';
    position: absolute;
    top: 6px; left: 6px; right: 6px; bottom: 6px;
    border: 1px solid rgba(212, 175, 55, 0.3);
    z-index: 1;
  }

  /* Corner accents */
  .hp33-story__corner {
    position: absolute;
    width: 30px; height: 30px;
    border: 2px solid var(--gold-color);
    z-index: 2;
    background: var(--bg-color);
  }

  .hp33-story__corner--tl { top: -2px; left: -2px; border-right: none; border-bottom: none; }
  .hp33-story__corner--tr { top: -2px; right: -2px; border-left: none; border-bottom: none; }
  .hp33-story__corner--bl { bottom: -2px; left: -2px; border-right: none; border-top: none; }
  .hp33-story__corner--br { bottom: -2px; right: -2px; border-left: none; border-top: none; }

  .hp33-story__image {
    width: 100%;
    height: auto;
    display: block;
    position: relative;
    z-index: 2;
  }

  .hp33-story__content-col {
    flex: 1;
    padding-right: 40px;
  }

  @media screen and (max-width: 992px) {
    .hp33-story__content-col {
      padding-right: 0;
      text-align: center;
    }
  }

  .hp33-story__subtitle {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    color: var(--gold-color);
    text-transform: uppercase;
    letter-spacing: 4px;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 15px;
  }

  @media screen and (max-width: 992px) {
    .hp33-story__subtitle {
      justify-content: center;
    }
  }

  .hp33-story__subtitle::before,
  .hp33-story__subtitle::after {
    content: '';
    height: 1px;
    width: 30px;
    background: var(--gold-color);
  }

  .hp33-story__title {
    font-family: var(--font-heading);
    font-size: clamp(36px, 5vw, {{ section.settings.title_size }}px);
    line-height: 1.1;
    color: var(--text-color);
    margin: 0 0 30px;
    font-weight: 400;
  }

  .hp33-story__text {
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.8;
    color: var(--text-color);
    margin: 0 0 30px;
    font-weight: 300;
  }

  /* Drop cap */
  .hp33-story__text > p:first-child::first-letter {
    float: left;
    font-family: var(--font-heading);
    font-size: 80px;
    line-height: 60px;
    padding-top: 4px;
    padding-right: 15px;
    padding-left: 0;
    color: var(--gold-color);
  }

  .hp33-story__signature {
    margin-top: 40px;
  }

  .hp33-story__sig-name {
    font-family: var(--font-sig);
    font-size: 42px;
    color: var(--gold-color);
    line-height: 1;
    margin: 0 0 5px;
  }

  .hp33-story__sig-title {
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 500;
    color: var(--text-color);
    text-transform: uppercase;
    letter-spacing: 2px;
    opacity: 0.6;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp33-story-wrapper" id="HP33Story-{{ section.id }}">
  <div class="hp33-story__image-col">
    <div class="hp33-story__image-wrap">
      <div class="hp33-story__corner hp33-story__corner--tl"></div>
      <div class="hp33-story__corner hp33-story__corner--tr"></div>
      <div class="hp33-story__corner hp33-story__corner--bl"></div>
      <div class="hp33-story__corner hp33-story__corner--br"></div>
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.title | escape }}" class="hp33-story__image" loading="lazy">
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'hp33-story__image' }}
      {%- endif -%}
    </div>
  </div>

  <div class="hp33-story__content-col">
    {%- if section.settings.subtitle != blank -%}
      <div class="hp33-story__subtitle">{{ section.settings.subtitle }}</div>
    {%- endif -%}
    
    <h2 class="hp33-story__title">{{ section.settings.title }}</h2>
    
    <div class="hp33-story__text">
      {{ section.settings.text }}
    </div>

    <div class="hp33-story__signature">
      <div class="hp33-story__sig-name">{{ section.settings.sig_name }}</div>
      <div class="hp33-story__sig-title">{{ section.settings.sig_title }}</div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "HP33 - Deco Story",
  "class": "section-hp33-brand-story",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "OUR LEGACY"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Heading",
      "default": "A Century of Elegance"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Since our founding, we have been committed to the pursuit of perfection. Every piece that bears our name is a testament to the dedication of our master artisans, who pour their passion into creating objects of enduring beauty.</p><p>We believe that true luxury lies not in excess, but in the meticulous attention to detail and the uncompromising quality of materials.</p>"
    },
    {
      "type": "text",
      "id": "sig_name",
      "label": "Signature Name",
      "default": "Arthur Pendelton"
    },
    {
      "type": "text",
      "id": "sig_title",
      "label": "Signature Title",
      "default": "FOUNDER & MASTER ARTISAN"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 30,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 56
    },
    {
      "type": "header",
      "content": "Deco Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (e.g. Deep Emerald)",
      "default": "#0e1a14"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "gold_color",
      "label": "Gold Accent",
      "default": "#d4af37"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 100
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP33 - Deco Story"
    }
  ]
}
{% endschema %}
