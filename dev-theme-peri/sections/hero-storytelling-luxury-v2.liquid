{%- comment -%}
  Component: hero-storytelling-luxury-v2 -> Refactored to Fresh Commerce
  Family: Fresh | Style: fresh
  Archetypes: fresh, commerce, light
  v2.0 — StoreForge Component Library
{%- endcomment -%}

<section class="hero-fresh page-width">
  <div class="hero-fresh-content">
    <h2 class="hero-fresh-heading">
      {{ section.settings.heading }}
    </h2>
    
    <div class="hero-fresh-text">
      {{ section.settings.text }}
    </div>

    <div class="hero-fresh-actions">
      {%- if section.settings.button_label_1 != blank -%}
        <a href="{{ section.settings.button_link_1 }}" class="hero-btn-primary">
          {{ section.settings.button_label_1 | escape }}
        </a>
      {%- endif -%}
      {%- if section.settings.button_label_2 != blank -%}
        <a href="{{ section.settings.button_link_2 }}" class="hero-btn-secondary">
          {{ section.settings.button_label_2 | escape }}
        </a>
      {%- endif -%}
    </div>
  </div>

  <div class="hero-fresh-media">
    {%- if section.settings.image != blank -%}
      <img src="{{ section.settings.image | image_url: width: 1000 }}" 
           alt="{{ section.settings.image.alt | escape }}" 
           loading="eager"
           class="hero-fresh-img">
    {%- else -%}
      <div class="hero-fresh-placeholder"></div>
    {%- endif -%}
  </div>
</section>

<style>
.hero-fresh {
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  gap: var(--space-48);
  min-height: 85vh;
  padding-top: var(--space-48);
  padding-bottom: var(--space-48);
  background-color: var(--bg-base);
  color: var(--text-main);
  font-family: var(--font-family);
}
.hero-fresh-content {
  display: flex;
  flex-direction: column;
  justify-content: center;
  max-width: 600px;
}
.hero-fresh-heading {
  font-family: var(--font-heading-family);
  font-size: var(--text-48);
  font-weight: 700;
  color: var(--primary);
  margin-bottom: var(--space-24);
  line-height: 1.1;
  letter-spacing: -1px;
}
.hero-fresh-text {
  font-family: var(--font-body-family);
  font-size: var(--text-18);
  font-weight: 400;
  color: var(--text-muted);
  margin-bottom: var(--space-48);
  line-height: 1.6;
}
.hero-fresh-text p {
  margin: 0;
}
.hero-fresh-actions {
  display: flex;
  gap: var(--space-16);
  flex-wrap: wrap;
}
.hero-btn-primary {
  background-color: var(--primary);
  color: var(--surface);
  border: none;
  padding: 16px var(--space-32);
  border-radius: var(--radius-pill);
  font-size: var(--text-16);
  font-weight: 600;
  text-decoration: none;
  transition: background-color 0.2s;
}
.hero-btn-primary:hover {
  background-color: var(--primary-hover);
}
.hero-btn-secondary {
  background-color: transparent;
  color: var(--primary);
  border: 2px solid var(--primary);
  padding: 14px var(--space-32);
  border-radius: var(--radius-pill);
  font-size: var(--text-16);
  font-weight: 600;
  text-decoration: none;
  transition: all 0.2s;
}
.hero-btn-secondary:hover {
  background-color: var(--primary);
  color: var(--surface);
}
.hero-fresh-media {
  width: 100%;
  height: 100%;
  min-height: 400px;
  border-radius: var(--radius-card);
  overflow: hidden;
}
.hero-fresh-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.hero-fresh-placeholder {
  width: 100%;
  height: 100%;
  background-color: var(--tint-green);
}
@media (max-width: 749px) {
  .hero-fresh {
    grid-template-columns: 1fr;
    min-height: auto;
    gap: var(--space-32);
  }
  .hero-fresh-content {
    text-align: center;
    margin: 0 auto;
    order: 2;
  }
  .hero-fresh-actions {
    justify-content: center;
  }
  .hero-fresh-heading {
    font-size: var(--text-32);
  }
  .hero-fresh-media {
    order: 1;
    min-height: 300px;
  }
}
</style>

{% schema %}
{
  "name": "Storytelling Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Mindful Indian Beauty & Skincare"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Story Text",
      "default": "<p>Explore our curated selection of premium products.</p>"
    },
    {
      "type": "text",
      "id": "button_label_1",
      "label": "Primary Button Label",
      "default": "Explore Skincare"
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Secondary Button Label",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Secondary Button Link"
    }
  ],
  "presets": [
    {
      "name": "Storytelling Hero",
      "category": "Hero"
    }
  ]
}
{% endschema %}
