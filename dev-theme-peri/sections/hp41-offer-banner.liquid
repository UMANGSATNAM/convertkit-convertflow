{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;700;900&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --border-color: #000000;
    
    --font-heading: 'Space Grotesk', sans-serif;
    
    background-color: var(--bg-color);
    padding: 120px 0;
    border-bottom: 4px solid var(--border-color);
    overflow: hidden;
    position: relative;
  }

  .hp41-offer-wrapper {
    width: 100%;
    position: relative;
  }

  /* We'll make a massive tilted scrolling ticker for the offer */
  .hp41-offer__ticker {
    background: #FF4911; /* Bright Orange */
    border-top: 4px solid var(--border-color);
    border-bottom: 4px solid var(--border-color);
    padding: 20px 0;
    transform: rotate(-3deg);
    width: 110%;
    margin-left: -5%;
    white-space: nowrap;
    overflow: hidden;
    display: flex;
    align-items: center;
    box-shadow: 0 15px 0px rgba(0,0,0,0.1);
  }

  .hp41-offer__track {
    display: inline-block;
    animation: hp41-offer-scroll 20s linear infinite;
  }

  @keyframes hp41-offer-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  .hp41-offer__content {
    display: inline-flex;
    align-items: center;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .hp41-offer__item {
    display: inline-flex;
    align-items: center;
    padding: 0 40px;
    font-family: var(--font-heading);
    font-size: clamp(40px, 8vw, {{ section.settings.title_size }}px);
    font-weight: 900;
    color: #FFF;
    text-transform: uppercase;
    text-shadow: 4px 4px 0px var(--border-color);
  }

  .hp41-offer__btn-container {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 2;
  }

  .hp41-offer__btn {
    display: inline-block;
    padding: 20px 50px;
    background: #D7FF43; /* Lime */
    color: var(--border-color);
    font-family: var(--font-heading);
    font-size: 24px;
    font-weight: 900;
    text-transform: uppercase;
    text-decoration: none;
    border: 4px solid var(--border-color);
    border-radius: 16px;
    box-shadow: 12px 12px 0px var(--border-color);
    transition: all 0.1s ease;
  }

  .hp41-offer__btn:hover {
    transform: translate(4px, 4px);
    box-shadow: 8px 8px 0px var(--border-color);
  }
  
  .hp41-offer__btn:active {
    transform: translate(12px, 12px);
    box-shadow: 0px 0px 0px var(--border-color);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp41-offer-wrapper" id="HP41Offer-{{ section.id }}">
  <div class="hp41-offer__ticker">
    <div class="hp41-offer__track">
      <ul class="hp41-offer__content">
        <!-- We'll just repeat the title multiple times -->
        {%- for i in (1..6) -%}
          <li class="hp41-offer__item">{{ section.settings.title }}</li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
  
  {%- if section.settings.btn_label != blank -%}
    <div class="hp41-offer__btn-container">
      <a href="{{ section.settings.btn_link | default: '#' }}" class="hp41-offer__btn">
        {{ section.settings.btn_label }}
      </a>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "HP41 - Neo Offer",
  "class": "section-hp41-offer-banner",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Ticker Text",
      "default": "HUGE SALE EVENT ✦"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "GRAB A DEAL"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 40,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Ticker Size",
      "default": 100
    },
    {
      "type": "header",
      "content": "Neo Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#FDF0D5"
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP41 - Neo Offer"
    }
  ]
}
{% endschema %}
