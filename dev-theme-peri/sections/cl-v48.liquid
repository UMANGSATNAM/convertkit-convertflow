{% comment %} CL V48 — Record Store (Structured, Black/Red) {% endcomment %}
{{ 'component-facets.css' | asset_url | stylesheet_tag }}
<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
<style>
  .clv48 { background: {{ section.settings.bg_color | default: '#F8F9FA' }}; color: {{ section.settings.text_color | default: '#212529' }}; padding: 40px 20px; font-family: 'Helvetica Neue', Arial, sans-serif; }
  .clv48-hero { display: flex; flex-direction: column; align-items: flex-start; justify-content: center; margin-bottom: 40px; padding: 50px; background: #000; color: #FFF; border-left: 10px solid #E63946; }
  .clv48-hero h1 { font-size: 50px; font-weight: 900; margin-bottom: 15px; text-transform: uppercase; letter-spacing: -1px; }
  .clv48-hero p { font-size: 16px; font-weight: 500; color: #ADB5BD; max-width: 600px; margin: 0; line-height: 1.5; }
  .clv48-chips { display: flex; gap: 10px; margin-bottom: 30px; flex-wrap: wrap; }
  .clv48-chips a { padding: 10px 20px; background: transparent; color: #000; text-decoration: none; font-size: 14px; font-weight: 700; text-transform: uppercase; border: 2px solid #000; transition: 0.2s; }
  .clv48-chips a:hover, .clv48-chips a.active { background: #E63946; color: #FFF; border-color: #E63946; }
  .clv48-toolbar { display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #000; padding-bottom: 15px; margin-bottom: 40px; font-weight: 700; text-transform: uppercase; }
  .clv48-grid { display: grid; grid-template-columns: repeat({{ section.settings.cols_desktop | default: 4 }}, 1fr); gap: 20px; }
  .clv48-promo { grid-column: span 1; background: #E63946; color: #FFF; padding: 30px; display: flex; flex-direction: column; justify-content: center; }
  .clv48-promo h3 { font-size: 24px; font-weight: 900; margin-bottom: 15px; text-transform: uppercase; }
  .clv48-promo a { display: inline-block; padding: 10px 0; border-bottom: 2px solid #FFF; color: #FFF; text-decoration: none; font-size: 13px; font-weight: 700; text-transform: uppercase; align-self: flex-start; }
  .clv48-promo a:hover { opacity: 0.8; }
  .clv48-seo { margin-top: 60px; padding: 40px; background: #E9ECEF; border-top: 4px solid #000; }
  @media (max-width: 768px) { .clv48-grid { grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr); gap: 15px; } .clv48-hero h1 { font-size: 38px; } }
</style>
<div class="clv48" style="max-width: 1400px; margin: 0 auto;">
  <div class="clv48-hero">
    <h1>{% if collection.title != blank %}{{ collection.title | escape }}{% else %}NEW RELEASES{% endif %}</h1>
    <p>{% if collection.description != blank %}{{ collection.description }}{% else %}Fresh wax arriving weekly. Build your collection.{% endif %}</p>
  </div>
  {% if section.settings.sub_collections != blank %}
    <div class="clv48-chips">
      {% for link in section.settings.sub_collections.links %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% endfor %}
    </div>
  {% endif %}
  <div class="clv48-toolbar">
    <facet-filters-form style="width: 100%;">
      <form id="FacetFiltersForm" style="display: flex; justify-content: space-between; align-items: center; width: 100%; flex-wrap: wrap; gap: 20px;">
        <div style="display: flex; gap: 25px;">
          {%- for filter in collection.filters -%}
            <details style="position: relative;">
              <summary style="cursor: pointer; font-size: 13px; font-weight: 900; letter-spacing: 1px;">{{ filter.label }} +</summary>
              <div style="position: absolute; background: #FFF; border: 2px solid #000; padding: 20px; z-index: 10; margin-top: 15px; min-width: 200px; box-shadow: 4px 4px 0 rgba(0,0,0,0.1);">
                {%- for value in filter.values -%}
                  <label style="display: block; margin-bottom: 12px; cursor: pointer; font-size: 13px; font-weight: 500; text-transform: none;">
                    <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %}>
                    {{ value.label }} <span style="color: #6C757D;">({{ value.count }})</span>
                  </label>
                {%- endfor -%}
              </div>
            </details>
          {%- endfor -%}
        </div>
        <select name="sort_by" onchange="this.form.submit()" style="background: transparent; border: none; font-family: inherit; font-size: 13px; font-weight: 900; text-transform: uppercase; letter-spacing: 1px; cursor: pointer; outline: none;">
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>
          {%- endfor -%}
        </select>
      </form>
    </facet-filters-form>
  </div>
  {% assign limit_num = section.settings.products_per_page | default: 16 %}
  {% paginate collection.products by limit_num %}
    <div class="clv48-grid">
      {% for product in collection.products %}
        {% render 'card-v48', product: product %}
        {% if forloop.index == 8 and section.settings.show_promo_tile %}
          <div class="clv48-promo">
            <h3>TURNTABLES<br>& AUDIO</h3>
            <a href="/collections/hardware">UPGRADE SETUP</a>
          </div>
        {% endif %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v48', product: nil %}
        {% endfor %}
      {% endfor %}
    </div>
    <div style="margin-top: 50px; text-align: left; font-weight: 900;">{{ paginate | default_pagination }}</div>
  {% endpaginate %}
  {% if section.settings.show_seo_block %}
    <div class="clv48-seo">
      <h2 style="font-size: 20px; font-weight: 900; margin-bottom: 10px; text-transform: uppercase;">{{ section.settings.seo_title | default: '180 GRAM AUDIOPHILE PRESSINGS' }}</h2>
      <p style="font-size: 14px; color: #495057; max-width: 800px; line-height: 1.6;">{{ section.settings.seo_text | default: 'Experience music the way it was meant to be heard. We stock imported pressings, limited edition colored vinyl, and essential catalog titles.' }}</p>
    </div>
  {% endif %}
</div>
{% schema %}
{
  "name": "CL V48 — Record Store", "settings": [
    {"type": "range", "id": "products_per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 16},
    {"type": "range", "id": "cols_desktop", "label": "Desktop Columns", "min": 2, "max": 5, "default": 4},
    {"type": "select", "id": "cols_mobile", "label": "Mobile Columns", "options": [{"value": "1", "label": "1"}, {"value": "2", "label": "2"}], "default": "2"},
    {"type": "link_list", "id": "sub_collections", "label": "Sub-Collection Menu"},
    {"type": "checkbox", "id": "show_promo_tile", "label": "Show Promo Card", "default": true},
    {"type": "checkbox", "id": "show_seo_block", "label": "Show SEO Block", "default": true},
    {"type": "color", "id": "bg_color", "label": "Background Color", "default": "#F8F9FA"},
    {"type": "color", "id": "text_color", "label": "Text Color", "default": "#212529"}
  ], "presets": [{"name": "CL V48 — Record Store"}]
}
{% endschema %}
