{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#1B4332' }};
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }
  .hp57-comp__container { max-width: {{ section.settings.container_width | default: 1000 }}px; margin: 0 auto; padding: 0 24px; }
  .hp57-comp__header { text-align: center; margin-bottom: 50px; }
  .hp57-comp__eyebrow { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: {{ section.settings.accent_color | default: '#D97706' }}; margin: 0 0 12px; }
  .hp57-comp__heading { font-family: 'Cormorant Garamond', serif; font-size: clamp(28px, 3.5vw, 42px); font-weight: 700; color: #FFFFFF; margin: 0; }
  .hp57-comp__table {
    width: 100%; border-collapse: collapse; background: {{ section.settings.card_bg | default: '#0F291E' }};
    border-radius: 12px; overflow: hidden; border: 1px solid rgba(167, 243, 208, 0.2);
  }
  .hp57-comp__table th {
    background: #0A1C14; color: #D97706; font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 12px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase;
    padding: 18px 20px; text-align: left; border-bottom: 1px solid rgba(167, 243, 208, 0.2);
  }
  .hp57-comp__table td {
    padding: 16px 20px; font-size: 14px; color: #F4F6F0;
    border-bottom: 1px solid rgba(167, 243, 208, 0.1);
  }
  .hp57-comp__table tr:last-child td { border-bottom: none; }
  .hp57-comp__check { color: #A7F3D0; font-weight: 700; }
  @media screen and (max-width: 768px) {
    .hp57-comp__table { font-size: 13px; }
    .hp57-comp__table th, .hp57-comp__table td { padding: 12px 14px; }
  }
{%- endstyle -%}
<div class="hp57-comp__container">
  <div class="hp57-comp__header">
    {%- if section.settings.eyebrow != blank -%}<p class="hp57-comp__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="hp57-comp__heading">{{ section.settings.heading | default: 'The Herbal Benchmark' }}</h2>
  </div>
  <table class="hp57-comp__table">
    <thead>
      <tr>
        <th>{{ section.settings.col1_head | default: 'Standard' }}</th>
        <th>{{ section.settings.col2_head | default: 'Botanical Herbalist' }}</th>
        <th>{{ section.settings.col3_head | default: 'Commercial Brands' }}</th>
      </tr>
    </thead>
    <tbody>
      {%- for block in section.blocks -%}
        <tr {{ block.shopify_attributes }}>
          <td>{{ block.settings.feature | default: 'Extraction' }}</td>
          <td class="hp57-comp__check">{{ block.settings.us | default: '🌿 6-Week Cold Maceration' }}</td>
          <td style="color:#64748B;">{{ block.settings.them | default: 'High-Heat Distillation' }}</td>
        </tr>
      {%- endfor -%}
    </tbody>
  </table>
</div>
{% schema %}
{
  "name": "HP57 Compare",
  "class": "section-hp57-comp",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#1B4332" },
    { "type": "color", "id": "card_bg", "label": "Table BG", "default": "#0F291E" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#D97706" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "🌿 BENCHMARK" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Herbal Benchmark" },
    { "type": "text", "id": "col1_head", "label": "Column 1", "default": "Standard" },
    { "type": "text", "id": "col2_head", "label": "Column 2", "default": "Botanical Herbalist" },
    { "type": "text", "id": "col3_head", "label": "Column 3", "default": "Commercial Brands" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 700, "max": 1200, "step": 20, "unit": "px", "label": "Container Width", "default": 1000 }
  ],
  "blocks": [{
    "type": "row", "name": "Row",
    "settings": [
      { "type": "text", "id": "feature", "label": "Feature", "default": "Extraction" },
      { "type": "text", "id": "us", "label": "Us", "default": "🌿 6-Week Cold Maceration" },
      { "type": "text", "id": "them", "label": "Others", "default": "High-Heat Distillation" }
    ]
  }],
  "presets": [{
    "name": "HP57 Compare",
    "blocks": [
      { "type": "row", "settings": { "feature": "Extraction Craft", "us": "🌿 6-Week Cold Maceration", "them": "High-Heat Distillation" } },
      { "type": "row", "settings": { "feature": "Packaging Glass", "us": "🌿 Pharmaceutical Amber Glass", "them": "Clear Plastic Bottles" } },
      { "type": "row", "settings": { "feature": "Carrier Oil Quality", "us": "🌿 100% Cold-Pressed Jojoba", "them": "Mineral Oil / Petroleum" } },
      { "type": "row", "settings": { "feature": "Preservative System", "us": "🌿 Organic Rosemary Phyto-Extract", "them": "Synthetic Parabens" } }
    ]
  }]
}
{% endschema %}
