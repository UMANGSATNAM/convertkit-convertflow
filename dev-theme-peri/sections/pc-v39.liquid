{%- comment -%}
  PC V39 — MODERNIST ARCHITECTURE MONOGRAPH PRODUCT GRID
  Design: Concrete Off-White (#FAFAFA), Dark Graphite (#111111) accents, Space Grotesk & Archivo typography
  Card Shape: 0px sharp corners, 1px thin grid dividers, architectural monograph aesthetic
{%- endcomment -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700&family=Space+Grotesk:wght@600;700&display=swap');

  .pcv39 {
    --bg: {{ section.settings.bg_color | default: '#FAFAFA' }};
    --card-bg: {{ section.settings.card_bg | default: '#FFFFFF' }};
    --text: {{ section.settings.text_color | default: '#111111' }};
    --muted: {{ section.settings.muted_color | default: '#777777' }};
    --accent: {{ section.settings.accent_color | default: '#111111' }};
    --accent-hover: {{ section.settings.accent_hover | default: '#333333' }};
    --border: {{ section.settings.border_color | default: '#E5E5E5' }};
    --badge-sale-bg: #111111;
    --badge-sale-text: #FAFAFA;
    --f-heading: 'Space Grotesk', sans-serif;
    --f-body: 'Archivo', sans-serif;
    --ease: all 0.25s ease;
    background-color: var(--bg);
    color: var(--text);
    font-family: var(--f-body);
    padding: {{ section.settings.padding_top | default: 64 }}px 0 {{ section.settings.padding_bottom | default: 64 }}px 0;
    line-height: 1.4;
    -webkit-font-smoothing: antialiased;
  }

  .pcv39 *, .pcv39 *::before, .pcv39 *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .pcv39 a { color: inherit; text-decoration: none; }
  .pcv39 button { font-family: inherit; cursor: pointer; border: none; background: none; }
  .pcv39 img { max-width: 100%; display: block; }

  .pcv39__wrap { max-width: 1280px; margin: 0 auto; padding: 0 20px; }

  /* HEADER */
  .pcv39__head { display: flex; flex-direction: column; gap: 8px; margin-bottom: 40px; border-bottom: 2px solid var(--text); padding-bottom: 20px; text-align: {{ section.settings.header_align | default: 'left' }}; }
  @media (min-width: 768px) {
    .pcv39__head { display: flex; flex-direction: row; justify-content: space-between; align-items: flex-end; }
  }
  .pcv39__title { font-family: var(--f-heading); font-size: 32px; font-weight: 700; color: var(--text); letter-spacing: -0.02em; text-transform: uppercase; }
  @media (min-width: 768px) { .pcv39__title { font-size: 42px; } }
  .pcv39__sub { font-size: 14px; color: var(--muted); letter-spacing: 0.05em; }
  .pcv39__viewall { display: inline-flex; align-items: center; gap: 8px; font-weight: 700; font-size: 12px; font-family: var(--f-heading); text-transform: uppercase; letter-spacing: 0.1em; color: var(--text); border: 1px solid var(--text); padding: 8px 18px; transition: var(--ease); }
  .pcv39__viewall:hover { background: var(--text); color: #FAFAFA; }

  /* GRID */
  .pcv39__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr);
    gap: 20px;
  }
  @media (min-width: 640px) {
    .pcv39__grid { grid-template-columns: repeat({{ section.settings.cols_tablet | default: 3 }}, 1fr); gap: 28px; }
  }
  @media (min-width: 1024px) {
    .pcv39__grid { grid-template-columns: repeat({{ section.settings.cols_desktop | default: 4 }}, 1fr); gap: 32px; }
  }

  /* CARD */
  .pcv39__card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 0px;
    display: flex;
    flex-direction: column;
    position: relative;
    transition: var(--ease);
  }
  .pcv39__card:hover {
    border-color: var(--text);
    box-shadow: 0 10px 25px -5px rgba(17, 17, 17, 0.08);
  }

  /* IMAGE CONTAINER */
  .pcv39__img-box {
    position: relative;
    width: 100%;
    aspect-ratio: {{ section.settings.img_ratio | default: '4/5' }};
    background: #EFEFEF;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
  }
  .pcv39__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .pcv39__img--sec {
    position: absolute;
    top: 0; left: 0;
    opacity: 0;
  }
  .pcv39__card:hover .pcv39__img--pri {
    {% if section.settings.enable_sec_img %}
      opacity: 0;
    {% else %}
      transform: scale(1.04);
    {% endif %}
  }
  .pcv39__card:hover .pcv39__img--sec { opacity: 1; transform: scale(1.04); }

  /* BADGES */
  .pcv39__badges { position: absolute; top: 12px; left: 12px; display: flex; flex-direction: column; gap: 6px; z-index: 2; pointer-events: none; }
  .pcv39__badge { font-size: 10px; font-weight: 700; text-transform: uppercase; padding: 4px 8px; border: 1px solid var(--text); letter-spacing: 0.1em; font-family: var(--f-heading); }
  .pcv39__badge--sale { background: var(--badge-sale-bg); color: var(--badge-sale-text); }
  .pcv39__badge--tag { background: #FFFFFF; color: #111111; }
  .pcv39__badge--sold { background: #777777; color: #FFFFFF; }

  /* WISHLIST BUTTON */
  .pcv39__wish {
    position: absolute;
    top: 12px; right: 12px;
    width: 36px; height: 36px;
    background: #FFFFFF;
    border: 1px solid var(--border);
    display: flex; align-items: center; justify-content: center;
    color: var(--text);
    z-index: 3;
    transition: var(--ease);
  }
  .pcv39__wish:hover { background: var(--text); color: #FAFAFA; border-color: var(--text); }
  .pcv39__wish.active { background: var(--text); color: #FAFAFA; border-color: var(--text); }

  /* QUICK ADD BUTTON */
  .pcv39__quick-box { padding: 12px; background: transparent; border-top: 1px solid var(--border); }
  .pcv39__quick-btn {
    width: 100%;
    padding: 10px 14px;
    background: var(--text);
    color: #FAFAFA;
    font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em;
    font-family: var(--f-heading);
    border: 1px solid var(--text);
    display: flex; align-items: center; justify-content: center; gap: 8px;
    transition: var(--ease);
  }
  .pcv39__quick-btn:hover { background: #333333; }
  .pcv39__quick-btn:disabled { background: #E5E5E5; color: #777777; cursor: not-allowed; border-color: #E5E5E5; }

  /* CARD CONTENT */
  .pcv39__content { padding: 16px; display: flex; flex-direction: column; gap: 6px; flex-grow: 1; text-align: center; }

  .pcv39__vendor { font-size: 10px; text-transform: uppercase; color: var(--muted); font-weight: 700; letter-spacing: 0.15em; font-family: var(--f-heading); }
  .pcv39__item-title { font-family: var(--f-heading); font-size: 16px; font-weight: 600; color: var(--text); line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; letter-spacing: 0.02em; }

  /* RATING */
  .pcv39__rating { display: flex; align-items: center; justify-content: center; gap: 6px; font-size: 11px; color: var(--text); }
  .pcv39__stars { letter-spacing: 2px; }
  .pcv39__rev-cnt { color: var(--muted); font-size: 11px; }

  /* PRICE */
  .pcv39__price-row { display: flex; align-items: baseline; justify-content: center; gap: 8px; margin-top: auto; padding-top: 4px; }
  .pcv39__price { font-size: 16px; font-weight: 700; color: var(--text); font-family: var(--f-heading); }
  .pcv39__cmp-price { font-size: 13px; color: var(--muted); text-decoration: line-through; }

  /* SWATCHES */
  .pcv39__swatches { display: flex; gap: 6px; align-items: center; justify-content: center; margin-top: 4px; }
  .pcv39__swatch { width: 12px; height: 12px; border-radius: 50%; border: 1px solid var(--border); cursor: pointer; transition: var(--ease); }
  .pcv39__swatch:hover, .pcv39__swatch.active { transform: scale(1.25); background: var(--text); }

  /* URGENCY MICRO */
  .pcv39__urgency { font-size: 11px; color: var(--text); font-weight: 700; font-family: var(--f-heading); text-transform: uppercase; display: flex; align-items: center; justify-content: center; gap: 4px; margin-top: 2px; }

  /* TOAST */
  .pcv39__toast {
    position: fixed; bottom: 20px; right: 20px;
    background: var(--text); color: #FAFAFA;
    border: 1px solid var(--text); padding: 12px 22px;
    font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em;
    font-family: var(--f-heading);
    z-index: 9999;
    transform: translateY(100px); opacity: 0;
    transition: all 0.25s ease;
  }
  .pcv39__toast.show { transform: translateY(0); opacity: 1; }
</style>

<div class="pcv39">
  <div class="pcv39__wrap">
    
    {% if section.settings.title != blank or section.settings.subheading != blank %}
      <div class="pcv39__head">
        <div>
          {% if section.settings.title != blank %}
            <h2 class="pcv39__title">{{ section.settings.title | escape }}</h2>
          {% endif %}
          {% if section.settings.subheading != blank %}
            <p class="pcv39__sub">{{ section.settings.subheading | escape }}</p>
          {% endif %}
        </div>
        {% if section.settings.show_view_all and section.settings.collection != blank %}
          <a href="{{ collections[section.settings.collection].url }}" class="pcv39__viewall">
            {{ section.settings.view_all_label | default: 'View Architectural Index' }} &rarr;
          </a>
        {% endif %}
      </div>
    {% endif %}

    <div class="pcv39__grid">
      {% assign target_coll = collections[section.settings.collection] %}
      {% assign limit_num = section.settings.products_per_page | default: 8 %}

      {% if target_coll != blank and target_coll.products.size > 0 %}
        {% for product in target_coll.products limit: limit_num %}
          {% assign current_variant = product.selected_or_first_available_variant %}
          
          {% render 'card-v39', product: product, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v39', product: nil, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% endif %}
    </div>

  </div>
</div>

<div class="pcv39__toast" id="pcv39-toast">SPECIMEN SELECTED</div>

<script>
(function(){
  // Wishlist is handled globally by assets/wishlist.js (shared store: cf_wishlist_items).
  // Buttons are rendered by snippets/wishlist-button.liquid — no per-section storage.


  document.querySelectorAll('[data-pcv39-add]').forEach(function(btn){
    btn.addEventListener('click', function(e){
      e.preventDefault(); e.stopPropagation();
      var id = btn.dataset.pcv39Add, orig = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = 'SELECTING...';

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: id, quantity: 1 })
      })
      .then(function(r){ return r.json(); })
      .then(function(){
        btn.innerHTML = '✓ SELECTED';
        showT('SPECIMEN SELECTED');
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      })
      .catch(function(){
        btn.innerHTML = 'ERROR';
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      });
    });
  });

  function showT(msg){
    var t = document.getElementById('pcv39-toast');
    if(!t) return;
    t.textContent = msg;
    t.classList.add('show');
    setTimeout(function(){ t.classList.remove('show'); }, 3000);
  }
})();
</script>

