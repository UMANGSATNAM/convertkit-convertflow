{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#050505'
  assign text_color = section.settings.text_color | default: '#00FFA3'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 0;
    border-bottom: 1px solid #333;
  }
  
  .hp13-lookbook-container-{{ section_id }} {
    position: relative;
    width: 100%;
    height: 100vh;
    min-height: 700px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #111;
    overflow: hidden;
  }
  
  .hp13-lookbook-bg-{{ section_id }} {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover;
    filter: grayscale(80%) contrast(120%);
    opacity: 0.6;
  }
  
  .hp13-lookbook-ui-{{ section_id }} {
    position: absolute;
    top: 20px; right: 20px;
    color: {{ text_color }};
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.8rem;
    font-weight: bold;
    text-align: right;
    z-index: 1;
  }
  
  .hp13-lookbook-hotspot-{{ section_id }} {
    position: absolute;
    width: 24px;
    height: 24px;
    background: transparent;
    border: 2px solid {{ text_color }};
    cursor: pointer;
    transition: transform 0.3s ease;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .hp13-lookbook-hotspot-{{ section_id }}::before {
    content: '';
    width: 8px; height: 8px;
    background: {{ text_color }};
  }
  
  .hp13-lookbook-hotspot-{{ section_id }}:hover {
    transform: scale(1.2) rotate(45deg);
  }
  
  .hp13-lookbook-tooltip-{{ section_id }} {
    position: absolute;
    top: 35px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(5, 5, 5, 0.9);
    border: 1px solid {{ text_color }};
    padding: 15px;
    min-width: 220px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
    backdrop-filter: blur(5px);
  }
  
  .hp13-lookbook-hotspot-{{ section_id }}:hover .hp13-lookbook-tooltip-{{ section_id }} {
    opacity: 1;
    pointer-events: auto;
    transform: translateX(-50%) rotate(-45deg); /* Counteract parent rotation */
  }
  
  .hp13-lookbook-product-title-{{ section_id }} {
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.85rem;
    font-weight: bold;
    color: #FFF;
    text-transform: uppercase;
    margin: 0 0 5px 0;
  }
  
  .hp13-lookbook-product-price-{{ section_id }} {
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.85rem;
    font-weight: bold;
    color: {{ text_color }};
    margin-bottom: 10px;
  }
  
  .hp13-lookbook-btn-{{ section_id }} {
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.75rem;
    font-weight: bold;
    color: #050505;
    background: {{ text_color }};
    text-decoration: none;
    text-transform: uppercase;
    padding: 5px 10px;
    display: inline-block;
  }

  @media (max-width: 768px) {
    .hp13-lookbook-container-{{ section_id }} {
      height: 70vh;
      min-height: 500px;
    }
  }
</style>

<div class="hp13-lookbook-container-{{ section_id }}">
  <div class="hp13-lookbook-ui-{{ section_id }}">
    SCANNING...<br>
    TARGETS IDENTIFIED
  </div>
  
  {% if section.settings.image != blank %}
    <img height="{{ section.settings.image.height }}" width="{{ section.settings.image.width }}" src="{{ section.settings.image | image_url: width: 2000 }}" class="hp13-lookbook-bg-{{ section_id }}" alt="Lookbook">
  {% else %}
    <div class="hp13-lookbook-bg-{{ section_id }}" style="background: repeating-linear-gradient(45deg, #EFEFEF, #EFEFEF 12px, #E6E6E6 12px, #E6E6E6 24px);"></div>
  {% endif %}
  
  {% for block in section.blocks %}
    <div class="hp13-lookbook-hotspot-{{ section_id }}" style="top: {{ block.settings.top }}%; left: {{ block.settings.left }}%;" {{ block.shopify_attributes }}>
      <div class="hp13-lookbook-tooltip-{{ section_id }}">
        {% assign product = all_products[block.settings.product] %}
        {% if product != blank %}
          <h4 class="hp13-lookbook-product-title-{{ section_id }}">{{ product.title }}</h4>
          <div class="hp13-lookbook-product-price-{{ section_id }}">{{ product.price | money }}</div>
          <a href="{{ product.url }}" class="hp13-lookbook-btn-{{ section_id }}">INSPECT</a>
        {% else %}
          <h4 class="hp13-lookbook-product-title-{{ section_id }}">MODULE_ID: 994</h4>
          <div class="hp13-lookbook-product-price-{{ section_id }}">$250.00</div>
          <a href="#" class="hp13-lookbook-btn-{{ section_id }}">INSPECT</a>
        {% endif %}
      </div>
    </div>
  {% endfor %}
</div>

{% schema %}
{
  "name": "HP13 Lookbook",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#050505"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Highlight Color",
      "default": "#00FFA3"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Lookbook Image"
    }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "Hotspot",
      "settings": [
        {
          "type": "range",
          "id": "top",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Top Position",
          "default": 50
        },
        {
          "type": "range",
          "id": "left",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Left Position",
          "default": 50
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP13 Lookbook",
      "blocks": [
        { "type": "hotspot", "settings": { "top": 30, "left": 40 } },
        { "type": "hotspot", "settings": { "top": 60, "left": 60 } }
      ]
    }
  ]
}
{% endschema %}
