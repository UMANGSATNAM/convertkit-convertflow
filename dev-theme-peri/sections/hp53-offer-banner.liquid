{%- style -%}
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.bg_color | default: '#5C3D2E' }};
    color: #FFFFFF;
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
  }

  .hp53-offer__container {
    max-width: {{ section.settings.container_width | default: 1280 }}px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  .hp53-offer__eyebrow {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: {{ section.settings.accent_color | default: '#E8D5C0' }};
    margin: 0 0 16px;
  }

  .hp53-offer__heading {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(28px, 4vw, 48px);
    font-weight: 700;
    color: #FFFFFF;
    margin: 0 0 18px;
    line-height: 1.1;
  }

  .hp53-offer__desc {
    font-size: 15px;
    line-height: 1.7;
    color: {{ section.settings.accent_color | default: '#E8D5C0' }};
    margin: 0 0 30px;
    max-width: 480px;
  }

  .hp53-offer__btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 30px;
    background: {{ section.settings.btn_bg | default: '#C2703E' }};
    color: {{ section.settings.btn_text | default: '#FFFFFF' }};
    font-family: 'Space Grotesk', sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 4px;
    border: 2px solid {{ section.settings.btn_bg | default: '#C2703E' }};
    transition: all 0.3s ease;
  }

  .hp53-offer__btn:hover {
    background: transparent;
  }

  .hp53-offer__img-wrap {
    border-radius: 12px;
    overflow: hidden;
    height: 400px;
    border: 2px solid rgba(232, 213, 192, 0.3);
  }

  .hp53-offer__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media screen and (max-width: 992px) {
    .hp53-offer__container { grid-template-columns: 1fr; text-align: center; }
    .hp53-offer__desc { margin-left: auto; margin-right: auto; }
    .hp53-offer__img-wrap { height: 300px; }
  }
{%- endstyle -%}

<div class="hp53-offer__container">
  <div>
    <p class="hp53-offer__eyebrow">{{ section.settings.eyebrow | default: '◈ LIMITED OFFER' }}</p>
    <h2 class="hp53-offer__heading">{{ section.settings.heading | default: 'Desert Glow Bundle' }}</h2>
    <p class="hp53-offer__desc">{{ section.settings.description | default: 'Save 30% on our curated Saharan ritual set — argan serum, clay mask, and prickly pear moisturizer in one luxurious bundle.' }}</p>
    <a href="{{ section.settings.btn_url | default: '/collections/all' }}" class="hp53-offer__btn">
      {{ section.settings.btn_label | default: 'Shop Bundle' }} &rarr;
    </a>
  </div>
  <div class="hp53-offer__img-wrap">
    {%- if section.settings.image != blank -%}
      <img height="{{ section.settings.image.height }}" width="{{ section.settings.image.width }}" src="{{ section.settings.image | image_url: width: 800 }}" class="hp53-offer__img" alt="{{ section.settings.heading }}" loading="lazy">
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'hp53-offer__img' }}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP53 - Dune Offer",
  "class": "section-hp53-offer",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#5C3D2E" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#E8D5C0" },
    { "type": "color", "id": "btn_bg", "label": "Button BG", "default": "#C2703E" },
    { "type": "color", "id": "btn_text", "label": "Button Text", "default": "#FFFFFF" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "◈ LIMITED OFFER" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Desert Glow Bundle" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Save 30% on our curated Saharan ritual set." },
    { "type": "text", "id": "btn_label", "label": "Button Label", "default": "Shop Bundle" },
    { "type": "url", "id": "btn_url", "label": "Button URL" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 80 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "presets": [{ "name": "HP53 - Dune Offer" }]
}
{% endschema %}
