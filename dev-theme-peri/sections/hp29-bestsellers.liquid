{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@300;400;500&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    
    --font-heading: 'Lora', serif;
    --font-body: 'Inter', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    position: relative;
    overflow: hidden;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.8 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.8 | round }}px;
    }
  }

  .hp29-best-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp29-best-wrapper {
      padding: 0 20px;
    }
  }

  .hp29-best__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 40px;
  }

  @media screen and (max-width: 768px) {
    .hp29-best__header {
      flex-direction: column;
      align-items: flex-start;
      gap: 15px;
    }
  }

  .hp29-best__title {
    font-family: var(--font-heading);
    font-size: clamp(28px, 4vw, {{ section.settings.title_size }}px);
    font-weight: 400;
    color: var(--text-color);
    margin: 0;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  
  .hp29-best__title em {
    font-style: italic;
    color: var(--accent-color);
  }

  .hp29-best__nav {
    display: flex;
    gap: 15px;
  }

  .hp29-best__nav-btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid rgba(0,0,0,0.1);
    background: transparent;
    color: var(--text-color);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .hp29-best__nav-btn svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }

  .hp29-best__nav-btn:hover {
    background: var(--text-color);
    color: var(--bg-color);
    border-color: var(--text-color);
  }

  /* Slider */
  .hp29-best__slider-container {
    margin: 0 -40px;
    padding: 0 40px;
    overflow: hidden;
  }
  
  @media screen and (max-width: 768px) {
    .hp29-best__slider-container {
      margin: 0 -20px;
      padding: 0 20px;
    }
  }

  .hp29-best__slider {
    display: flex;
    gap: 30px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding-bottom: 20px;
    scroll-behavior: smooth;
  }

  .hp29-best__slider::-webkit-scrollbar {
    display: none;
  }

  .hp29-best__item {
    flex: 0 0 calc(100% / {{ section.settings.columns_desktop }} - (30px * ({{ section.settings.columns_desktop }} - 1) / {{ section.settings.columns_desktop }}));
    scroll-snap-align: start;
    text-decoration: none;
    display: flex;
    flex-direction: column;
  }

  @media screen and (max-width: 1024px) {
    .hp29-best__item {
      flex: 0 0 calc(100% / 3 - 20px);
    }
  }

  @media screen and (max-width: 768px) {
    .hp29-best__item {
      flex: 0 0 calc(100% / 2 - 15px);
    }
  }

  @media screen and (max-width: 480px) {
    .hp29-best__item {
      flex: 0 0 calc(100% - 40px);
    }
  }

  .hp29-best__image-wrapper {
    position: relative;
    aspect-ratio: 4/5;
    border-radius: 200px 200px 10px 10px; /* Arched top */
    overflow: hidden;
    margin-bottom: 20px;
    background: rgba(0,0,0,0.03);
  }

  .hp29-best__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .hp29-best__item:hover .hp29-best__image {
    transform: scale(1.03);
  }

  .hp29-best__content {
    text-align: center;
    padding: 0 10px;
  }

  .hp29-best__product-title {
    font-family: var(--font-heading);
    font-size: 18px;
    font-weight: 400;
    color: var(--text-color);
    margin: 0 0 8px;
  }

  .hp29-best__product-price {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 400;
    color: var(--text-color);
    opacity: 0.7;
    margin: 0;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp29-best-wrapper" id="HP29Best-{{ section.id }}">
  
  <div class="hp29-best__header">
    {%- if section.settings.title != blank -%}
      <h2 class="hp29-best__title">{{ section.settings.title }}</h2>
    {%- endif -%}
    
    <div class="hp29-best__nav">
      <button class="hp29-best__nav-btn" id="hp29-prev-{{ section.id }}" aria-label="Previous">
        <svg viewBox="0 0 24 24"><path d="M15 18l-6-6 6-6"/></svg>
      </button>
      <button class="hp29-best__nav-btn" id="hp29-next-{{ section.id }}" aria-label="Next">
        <svg viewBox="0 0 24 24"><path d="M9 18l6-6-6-6"/></svg>
      </button>
    </div>
  </div>

  <div class="hp29-best__slider-container">
    <div class="hp29-best__slider" id="hp29-slider-{{ section.id }}">
      {%- if section.settings.collection != blank and section.settings.collection.products_count > 0 -%}
        {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
          <a href="{{ product.url }}" class="hp29-best__item">
            <div class="hp29-best__image-wrapper">
              <img src="{{ product.featured_image | image_url: width: 500 }}" alt="{{ product.title | escape }}" class="hp29-best__image" loading="lazy">
            </div>
            <div class="hp29-best__content">
              <h3 class="hp29-best__product-title">{{ product.title }}</h3>
              <div class="hp29-best__product-price">{{ product.price | money }}</div>
            </div>
          </a>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..8) -%}
          <a href="#" class="hp29-best__item">
            <div class="hp29-best__image-wrapper">
              {%- assign placeholder = 'product-' | append: i -%}
              {%- if i > 6 -%}{%- assign placeholder = 'product-1' -%}{%- endif -%}
              {{ placeholder | placeholder_svg_tag: 'hp29-best__image' }}
            </div>
            <div class="hp29-best__content">
              <h3 class="hp29-best__product-title">Earthy Ceramic Mug {{ i }}</h3>
              <div class="hp29-best__product-price">$24.00</div>
            </div>
          </a>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>

</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const slider = document.getElementById('hp29-slider-{{ section.id }}');
    const prevBtn = document.getElementById('hp29-prev-{{ section.id }}');
    const nextBtn = document.getElementById('hp29-next-{{ section.id }}');

    if(slider && prevBtn && nextBtn) {
      const scrollAmount = () => slider.offsetWidth * 0.8;

      prevBtn.addEventListener('click', () => {
        slider.scrollBy({ left: -scrollAmount(), behavior: 'smooth' });
      });

      nextBtn.addEventListener('click', () => {
        slider.scrollBy({ left: scrollAmount(), behavior: 'smooth' });
      });
    }
  });
</script>

{% schema %}
{
  "name": "HP29 - Boho Bestsellers",
  "class": "section-hp29-bestsellers",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Heading",
      "default": "Community <em>Favorites</em>"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 12,
      "step": 1,
      "label": "Products to Show",
      "default": 8
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1400
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 3,
      "max": 6,
      "step": 1,
      "label": "Visible Columns (Desktop)",
      "default": 4
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 40
    },
    {
      "type": "header",
      "content": "Earthy Boho Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (Beige)",
      "default": "#F4F1DE"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text (Charcoal)",
      "default": "#3D405B"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent (Terracotta)",
      "default": "#E07A5F"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP29 - Boho Bestsellers"
    }
  ]
}
{% endschema %}
