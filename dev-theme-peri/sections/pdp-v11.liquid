  <!-- BUILT-IN STICKY ATC -->
  <div class="pdp-v11-sticky" id="v11-sticky">
    <div class="pdp-v11-sticky__info">
      {% if product.featured_media %}
        <img src="{{ product.featured_media | image_url: width: 100 }}" class="pdp-v11-sticky__img">
      {% else %}
        <div class="pdp-v11-sticky__img">{{ 'product-1' | placeholder_svg_tag }}</div>
      {% endif %}
      <div>
        <div class="pdp-v11-sticky__title">{{ product.title | default: "Advanced Hydration Serum" }}</div>
        <div class="pdp-v11-sticky__price">{{ current_variant.price | money }}</div>
      </div>
    </div>
    <button class="pdp-v11-sticky__btn" onclick="window.scrollTo({top: 0, behavior: 'smooth'})">ADD TO CART</button>
  </div>

  <script>
    document.addEventListener("DOMContentLoaded", function() {
      // Accordion
      const accBtns = document.querySelectorAll('.pdp-v11__acc-btn');
      accBtns.forEach(btn => {
        btn.addEventListener('click', function() {
          const content = this.nextElementSibling;
          if (content.style.display === "none" || content.style.display === "") {
            content.style.display = "block";
            this.querySelector('span').innerText = "-";
          } else {
            content.style.display = "none";
            this.querySelector('span').innerText = "+";
          }
        });
      });

      // Sticky ATC
      const stickyBar = document.getElementById('v11-sticky');
      const mainAtc = document.getElementById('v11-atc');
      if(stickyBar && mainAtc) {
        window.addEventListener('scroll', function() {
          const mainAtcRect = mainAtc.getBoundingClientRect();
          if (mainAtcRect.top < 0) {
            stickyBar.classList.add('visible');
          } else {
            stickyBar.classList.remove('visible');
          }
        });
      }
    });
  </script>

</div>

