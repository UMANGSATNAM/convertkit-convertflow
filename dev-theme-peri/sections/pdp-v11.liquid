      <h2 style="font-family: var(--v11-font); font-size: 24px; font-weight: 600; margin-bottom: 20px; color: var(--v11-text);">Featured Favorites</h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px;">
        <div style="background: var(--v11-surface); padding: 16px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.03);">
