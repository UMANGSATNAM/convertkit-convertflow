{%- comment -%}
  PDP V11: K-BEAUTY / CLINICAL SKINCARE
  Aesthetic: Soft Pastels, Clinical, High-Trust.
  CRO: Ticket-style offer banner, Routine Builder, Sticky ATC.
{%- endcomment -%}

{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign random_bought = 'now' | date: '%s' | modulo: 500 | plus: 120 -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap');

  :root {
    --v11-bg: #FAFAFA;
    --v11-surface: #FFFFFF;
    --v11-text: #2C3539;
    --v11-text-light: #838996;
    --v11-primary: #A3C1AD; /* Soft Sage Green */
    --v11-accent: #F4C2C2; /* Soft Pink */
    --v11-border: #E8E9EB;
    --v11-font: 'Outfit', sans-serif;
  }

  .pdp-v11 {
    background-color: var(--v11-bg);
    color: var(--v11-text);
    font-family: var(--v11-font);
    line-height: 1.6;
  }

  .pdp-v11__container {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
  }
  @media (min-width: 992px) {
    .pdp-v11__container { grid-template-columns: 1fr 480px; }
  }

  /* --- GALLERY --- */
  .pdp-v11__gallery {
    padding: 20px;
    background: #F0F2F0;
  }
  @media (min-width: 992px) {
    .pdp-v11__gallery { padding: 40px; height: calc(100vh - 40px); position: sticky; top: 0; display: flex; flex-direction: column; gap: 20px; overflow-y: auto; scroll-snap-type: y mandatory; }
  }
  .pdp-v11__gallery img, .pdp-v11__gallery svg {
    width: 100%;
    aspect-ratio: 4/5;
    object-fit: cover;
    border-radius: 16px;
    margin-bottom: 20px;
    background: #FFF;
    scroll-snap-align: start;
    box-shadow: 0 4px 20px rgba(0,0,0,0.03);
  }

  /* --- INFO BOX --- */
  .pdp-v11__info {
    padding: 32px 20px;
    background: var(--v11-surface);
  }
  @media (min-width: 992px) {
    .pdp-v11__info { padding: 60px 40px; min-height: 100vh; }
  }

  /* --- TICKET BANNER --- */
  .pdp-v11__ticket {
    background: var(--v11-accent);
    color: #FFF;
    border-radius: 8px;
    padding: 12px 20px;
    margin-bottom: 24px;
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: center;
    box-shadow: 0 4px 12px rgba(244, 194, 194, 0.4);
  }
  .pdp-v11__ticket::before, .pdp-v11__ticket::after {
    content: ''; position: absolute; width: 16px; height: 16px; background: var(--v11-surface); border-radius: 50%; top: 50%; transform: translateY(-50%);
  }
  .pdp-v11__ticket::before { left: -8px; }
  .pdp-v11__ticket::after { right: -8px; }
  .pdp-v11__t-text { font-weight: 700; font-size: 14px; letter-spacing: 1px; }
  .pdp-v11__t-code { border: 1px dashed #FFF; padding: 4px 12px; border-radius: 4px; font-weight: 700; font-size: 13px; }

  /* --- PRODUCT HEAD --- */
  .pdp-v11__badge { font-size: 11px; text-transform: uppercase; letter-spacing: 2px; color: var(--v11-primary); font-weight: 700; margin-bottom: 12px; }
  .pdp-v11__title { font-size: 32px; font-weight: 600; line-height: 1.2; margin: 0 0 16px 0; }
  .pdp-v11__reviews { display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--v11-text-light); margin-bottom: 24px; }
  .pdp-v11__stars { color: #FFC107; display: flex; }
  .pdp-v11__stars svg { width: 16px; height: 16px; fill: currentColor; }
  
  .pdp-v11__price-wrap { display: flex; align-items: baseline; gap: 12px; margin-bottom: 32px; }
  .pdp-v11__price { font-size: 28px; font-weight: 700; }
  .pdp-v11__compare { font-size: 16px; color: var(--v11-text-light); text-decoration: line-through; }

  /* --- CLINICAL TRUST --- */
  .pdp-v11__trust-row {
    display: flex; justify-content: space-between; border-top: 1px solid var(--v11-border); border-bottom: 1px solid var(--v11-border); padding: 16px 0; margin-bottom: 32px;
  }
  .pdp-v11__t-icon { text-align: center; font-size: 11px; font-weight: 600; color: var(--v11-text-light); }
  .pdp-v11__t-icon svg { width: 24px; height: 24px; margin-bottom: 4px; color: var(--v11-primary); }

  /* --- ROUTINE BUILDER (FBT) --- */
  .pdp-v11__routine {
    background: var(--v11-bg);
    border-radius: 12px;
    padding: 20px;
    margin-bottom: 32px;
  }
  .pdp-v11__r-title { font-size: 14px; font-weight: 700; margin-bottom: 16px; text-transform: uppercase; letter-spacing: 1px; }
  .pdp-v11__r-item {
    display: flex; align-items: center; gap: 12px; margin-bottom: 12px;
  }
  .pdp-v11__r-img { width: 60px; height: 60px; object-fit: cover; border-radius: 8px; background: #FFF; }
  .pdp-v11__r-info { flex: 1; }
  .pdp-v11__r-name { font-size: 13px; font-weight: 600; margin-bottom: 4px; }
  .pdp-v11__r-price { font-size: 13px; font-weight: 700; color: var(--v11-primary); }
  .pdp-v11__r-check {
    appearance: none; width: 20px; height: 20px; border: 2px solid var(--v11-border); border-radius: 4px; cursor: pointer; position: relative;
  }
  .pdp-v11__r-check:checked { background: var(--v11-primary); border-color: var(--v11-primary); }
  .pdp-v11__r-check:checked::after {
    content: 'âœ“'; position: absolute; color: #FFF; font-size: 12px; font-weight: bold; top: 50%; left: 50%; transform: translate(-50%, -50%);
  }

  /* --- ATC --- */
  .pdp-v11__atc {
    width: 100%;
    background: var(--v11-text);
    color: #FFF;
    border: none;
    padding: 18px;
    font-size: 16px;
    font-weight: 600;
    border-radius: 30px;
    cursor: pointer;
    margin-bottom: 12px;
    transition: opacity 0.3s;
  }
  .pdp-v11__atc:hover { opacity: 0.8; }
  .pdp-v11__bought { text-align: center; font-size: 12px; color: var(--v11-primary); font-weight: 600; margin-bottom: 32px; }

  /* --- ACCORDIONS --- */
  .pdp-v11__acc { border-top: 1px solid var(--v11-border); }
  .pdp-v11__acc:last-child { border-bottom: 1px solid var(--v11-border); }
  .pdp-v11__acc-btn {
    width: 100%; text-align: left; background: none; border: none;
    padding: 20px 0; font-size: 15px; font-weight: 600;
    display: flex; justify-content: space-between; cursor: pointer;
  }
  .pdp-v11__acc-content { padding-bottom: 20px; font-size: 14px; color: var(--v11-text-light); }
  
  /* --- STICKY ATC --- */
  .pdp-v11-sticky {
    position: fixed; bottom: -100px; left: 0; width: 100%; background: #FFF; box-shadow: 0 -10px 30px rgba(0,0,0,0.05);
    z-index: 999; padding: 12px 20px; display: flex; justify-content: space-between; align-items: center;
    transition: bottom 0.3s cubic-bezier(0.4, 0, 0.2, 1); border-radius: 20px 20px 0 0;
  }
  .pdp-v11-sticky.visible { bottom: 0; }
  .pdp-v11-sticky__info { display: flex; align-items: center; gap: 16px; }
  .pdp-v11-sticky__img { width: 48px; height: 48px; object-fit: cover; border-radius: 8px; }
  .pdp-v11-sticky__title { font-weight: 600; font-size: 14px; color: var(--v11-text); }
  .pdp-v11-sticky__price { font-weight: 700; color: var(--v11-primary); font-size: 14px; }
  .pdp-v11-sticky__btn { background: var(--v11-text); color: #FFF; border: none; padding: 12px 32px; font-weight: 600; cursor: pointer; border-radius: 30px; }
  @media (max-width: 768px) {
    .pdp-v11-sticky__info { display: none; }
    .pdp-v11-sticky__btn { width: 100%; padding: 16px; font-size: 16px; }
  }

</style>

<div class="pdp-v11" data-section="{{ section.id }}">
  
  <div class="pdp-v11__container">
    
    <!-- GALLERY -->
    <div class="pdp-v11__gallery">
