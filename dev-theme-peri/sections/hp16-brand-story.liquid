{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#00FFFF'
  assign text_color = section.settings.text_color | default: '#000000'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 100px 40px;
    border-bottom: 4px solid #000;
  }
  
  .hp16-brand-story-container-{{ section_id }} {
    max-width: 1000px;
    margin: 0 auto;
    text-align: center;
    background: #FFF;
    border: 4px solid #000;
    border-radius: 40px;
    padding: 80px 40px;
    box-shadow: 15px 15px 0 #FF00FF;
    position: relative;
  }
  
  .hp16-brand-story-sticker-{{ section_id }} {
    position: absolute;
    top: -40px;
    right: -20px;
    width: 120px;
    height: 120px;
    background: #FFFF00;
    border: 4px solid #000;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Comic Sans MS', cursive;
    font-weight: bold;
    font-size: 1.2rem;
    transform: rotate(15deg);
    box-shadow: 5px 5px 0 #000;
  }
  
  .hp16-brand-story-title-{{ section_id }} {
    font-family: 'Arial Black', Impact, sans-serif;
    font-size: clamp(2.5rem, 4vw, 4rem);
    text-transform: uppercase;
    color: #FF00FF;
    -webkit-text-stroke: 1px #000;
    text-shadow: 3px 3px 0 #000;
    margin: 0 0 30px 0;
  }
  
  .hp16-brand-story-text-{{ section_id }} {
    font-family: 'Comic Sans MS', cursive;
    font-size: 1.2rem;
    line-height: 1.6;
    color: {{ text_color }};
    margin: 0 0 40px 0;
    font-weight: bold;
  }
  
  .hp16-brand-story-btn-{{ section_id }} {
    font-family: 'Arial Black', sans-serif;
    font-size: 1.2rem;
    text-transform: uppercase;
    color: #FFF;
    background: #000;
    text-decoration: none;
    padding: 15px 40px;
    border: 4px solid #000;
    border-radius: 30px;
    display: inline-block;
    box-shadow: 5px 5px 0 #00FFFF;
    transition: all 0.2s ease;
  }
  
  .hp16-brand-story-btn-{{ section_id }}:hover {
    transform: translate(2px, 2px);
    box-shadow: 3px 3px 0 #00FFFF;
    color: #00FFFF;
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 60px 20px;
    }
    .hp16-brand-story-container-{{ section_id }} {
      padding: 60px 20px;
      box-shadow: 8px 8px 0 #FF00FF;
    }
    .hp16-brand-story-sticker-{{ section_id }} {
      width: 80px; height: 80px; font-size: 0.9rem;
      top: -20px; right: -10px;
    }
  }
</style>

<div class="hp16-brand-story-container-{{ section_id }}">
  <div class="hp16-brand-story-sticker-{{ section_id }}">SINCE 2002</div>
  <h2 class="hp16-brand-story-title-{{ section_id }}">{{ section.settings.title | default: 'ABOUT US (DUH!)' }}</h2>
  <div class="hp16-brand-story-text-{{ section_id }}">{{ section.settings.text | default: '<p>We are just a bunch of girls who miss the early 2000s. We decided to bring back all the iconic looks you loved (and maybe some you forgot). Low rise, baby tees, and so much glitter. Welcome to the club.</p>' }}</div>
  <a href="{{ section.settings.btn_link | default: '#' }}" class="hp16-brand-story-btn-{{ section_id }}">{{ section.settings.btn_text | default: 'READ OUR DIARY' }}</a>
</div>

{% schema %}
{
  "name": "HP16 Brand Story",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#00FFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "ABOUT US (DUH!)"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>We are just a bunch of girls who miss the early 2000s. We decided to bring back all the iconic looks you loved (and maybe some you forgot). Low rise, baby tees, and so much glitter. Welcome to the club.</p>"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "READ OUR DIARY"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "HP16 Brand Story"
    }
  ]
}
{% endschema %}
