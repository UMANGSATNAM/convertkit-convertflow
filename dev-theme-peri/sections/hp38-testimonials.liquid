{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Space+Mono:ital,wght@0,400;0,700;1,400;1,700&family=Inter:wght@400;600;800&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    
    --font-heading: 'Space Mono', monospace;
    --font-body: 'Inter', sans-serif;
    
    background-color: var(--text-color);
    border-bottom: 2px solid var(--text-color);
  }

  .hp38-testi-wrapper {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
  }

  @media screen and (max-width: 992px) {
    .hp38-testi-wrapper {
      grid-template-columns: 1fr;
    }
  }

  .hp38-testi__card {
    background: var(--bg-color);
    padding: 60px 40px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: background 0.3s ease, color 0.3s ease;
  }

  @media screen and (max-width: 768px) {
    .hp38-testi__card {
      padding: 40px 20px;
    }
  }

  .hp38-testi__card:hover {
    background: var(--text-color);
    color: var(--bg-color);
  }

  /* Target child elements on hover to invert colors */
  .hp38-testi__card:hover .hp38-testi__meta,
  .hp38-testi__card:hover .hp38-testi__quote,
  .hp38-testi__card:hover .hp38-testi__author,
  .hp38-testi__card:hover .hp38-testi__star {
    color: var(--bg-color);
  }

  .hp38-testi__card:hover .hp38-testi__meta {
    border-color: var(--bg-color);
  }

  .hp38-testi__meta {
    font-family: var(--font-heading);
    font-size: 12px;
    color: var(--accent-color);
    border: 1px solid var(--accent-color);
    padding: 4px 8px;
    align-self: flex-start;
    margin-bottom: 40px;
    transition: color 0.3s ease, border-color 0.3s ease;
  }

  .hp38-testi__quote {
    font-family: var(--font-heading);
    font-size: clamp(18px, 2vw, {{ section.settings.quote_size }}px);
    line-height: 1.5;
    color: var(--text-color);
    margin: 0 0 40px;
    text-transform: uppercase;
    transition: color 0.3s ease;
  }

  .hp38-testi__footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .hp38-testi__author {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 700;
    color: var(--text-color);
    text-transform: uppercase;
    transition: color 0.3s ease;
  }

  .hp38-testi__star {
    color: var(--text-color);
    font-size: 16px;
    transition: color 0.3s ease;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp38-testi-wrapper" id="HP38Testimonials-{{ section.id }}">
  {%- for block in section.blocks limit: 3 -%}
    <div class="hp38-testi__card" {{ block.shopify_attributes }}>
      <div class="hp38-testi__meta">LOG // 0{{ forloop.index }}</div>
      <div class="hp38-testi__quote">"{{ block.settings.quote }}"</div>
      
      <div class="hp38-testi__footer">
        <div class="hp38-testi__author">{{ block.settings.author }}</div>
        <div class="hp38-testi__star">★★★</div>
      </div>
    </div>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "HP38 - Brutalist Quotes",
  "class": "section-hp38-testimonials",
  "settings": [
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "quote_size",
      "min": 16,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Quote Size",
      "default": 20
    },
    {
      "type": "header",
      "content": "Brutalist Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text & Grid Lines",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#0000FF"
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Quote",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "Optimal performance. Zero redundancy. Highly recommended."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "USR_994"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP38 - Brutalist Quotes",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial", "settings": { "quote": "Exceeded all specifications. Flawless execution.", "author": "SYS_ADMIN" } },
        { "type": "testimonial", "settings": { "quote": "Built like a tank. Exactly what was required.", "author": "OP_02" } }
      ]
    }
  ]
}
{% endschema %}
