{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#FEF3C7' }};
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }
  .hp63-bs__container { max-width: {{ section.settings.container_width | default: 1280 }}px; margin: 0 auto; padding: 0 24px; }
  .hp63-bs__header { text-align: center; margin-bottom: 50px; }
  .hp63-bs__eyebrow { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: #881337; margin: 0 0 12px; }
  .hp63-bs__heading { font-family: 'Playfair Display', serif; font-size: clamp(28px, 3.5vw, 42px); font-weight: 700; color: #1C1917; margin: 0; }
  .hp63-bs__grid { display: grid; grid-template-columns: repeat({{ section.settings.columns | default: 4 }}, 1fr); gap: 20px; }
  .hp63-bs__card {
    background: #FFFFFF; border: 1px solid rgba(217, 119, 6, 0.25);
    border-radius: 6px; overflow: hidden; box-shadow: 0 4px 20px rgba(136, 19, 55, 0.05);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .hp63-bs__card:hover { transform: translateY(-6px); box-shadow: 0 12px 35px rgba(136, 19, 55, 0.12); }
  .hp63-bs__img-wrap { aspect-ratio: 3/4; overflow: hidden; background: #FFFBEB; }
  .hp63-bs__img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
  .hp63-bs__card:hover .hp63-bs__img { transform: scale(1.06); }
  .hp63-bs__info { padding: 18px 16px; }
  .hp63-bs__name { font-family: 'Playfair Display', serif; font-size: 17px; font-weight: 700; color: #1C1917; margin: 0 0 6px; text-decoration: none; display: block; }
  .hp63-bs__price { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 15px; font-weight: 700; color: #881337; margin: 0; }
  @media screen and (max-width: 992px) { .hp63-bs__grid { grid-template-columns: repeat(2, 1fr); } }
  @media screen and (max-width: 480px) { .hp63-bs__grid { grid-template-columns: repeat(2, 1fr); gap: 12px; } }
{%- endstyle -%}
<div class="hp63-bs__container">
  <div class="hp63-bs__header">
    {%- if section.settings.eyebrow != blank -%}<p class="hp63-bs__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="hp63-bs__heading">{{ section.settings.heading | default: 'Marrakech Souk Treasures' }}</h2>
  </div>
  {%- assign collection = collections[section.settings.collection] -%}
  <div class="hp63-bs__grid">
    {%- for product in collection.products limit: section.settings.products_to_show -%}
      <div class="hp63-bs__card">
        <a href="{{ product.url }}" class="hp63-bs__img-wrap">{%- if product.featured_image != blank -%}<img height="{{ product.featured_image.height }}" width="{{ product.featured_image.width }}" src="{{ product.featured_image | image_url: width: 600 }}" class="hp63-bs__img" alt="{{ product.title }}" loading="lazy">{%- endif -%}</a>
        <div class="hp63-bs__info"><a href="{{ product.url }}" class="hp63-bs__name">{{ product.title }}</a><p class="hp63-bs__price">{{ product.price | money }}</p></div>
      </div>
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "HP63 Bestsellers",
  "class": "section-hp63-bs",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FEF3C7" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "🌹 SOUK ICONS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Marrakech Souk Treasures" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 12, "step": 1, "label": "Products", "default": 4 },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "label": "Columns", "default": 4 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "presets": [{ "name": "HP63 Bestsellers" }]
}
{% endschema %}
