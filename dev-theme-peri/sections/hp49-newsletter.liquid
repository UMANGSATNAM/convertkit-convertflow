{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp49-news-bg: {{ section.settings.bg_color | default: '#F5F3FF' }};
    --hp49-accent: {{ section.settings.accent_color | default: '#7C3AED' }};
    
    background-color: var(--hp49-news-bg);
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
  }

  .hp49-news__box {
    max-width: {{ section.settings.container_width | default: 760 }}px;
    margin: 0 auto;
    padding: 50px 40px;
    background: #FFFFFF;
    border: 1px solid rgba(124, 58, 237, 0.2);
    border-radius: 36px;
    text-align: center;
    box-shadow: 0 15px 40px rgba(124, 58, 237, 0.08);
  }

  .hp49-news__title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: clamp(28px, 4vw, 38px);
    font-weight: 800;
    color: #2E1065;
    margin: 0 0 12px;
  }

  .hp49-news__desc {
    font-size: 15px;
    line-height: 1.7;
    color: #5B21B6;
    opacity: 0.85;
    margin: 0 0 32px;
  }

  .hp49-news__form {
    display: flex;
    gap: 12px;
    max-width: 500px;
    margin: 0 auto;
  }

  .hp49-news__input {
    flex: 1;
    padding: 15px 22px;
    background: #F5F3FF;
    border: 1px solid rgba(124, 58, 237, 0.25);
    border-radius: 50px;
    color: #2E1065;
    font-size: 14px;
    outline: none;
    font-family: 'Urbanist', sans-serif;
  }

  .hp49-news__input:focus { border-color: var(--hp49-accent); }

  .hp49-news__btn {
    padding: 15px 32px;
    background: #7C3AED;
    color: #FFFFFF;
    border: none;
    border-radius: 50px;
    font-family: 'Urbanist', sans-serif;
    font-weight: 800;
    font-size: 14px;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .hp49-news__btn:hover { background: #6D28D9; }

  @media screen and (max-width: 600px) {
    .hp49-news__box { padding: 36px 20px; }
    .hp49-news__form { flex-direction: column; }
  }
{%- endstyle -%}

<div class="hp49-news__box">
  <h2 class="hp49-news__title">{{ section.settings.heading | default: 'Join The Lavender Cloud Club' }}</h2>
  <p class="hp49-news__desc">{{ section.settings.description | default: 'Receive gentle wellness updates, seasonal alpine harvest drops, and an instant 15% VIP welcome voucher.' }}</p>
  <form class="hp49-news__form" onsubmit="event.preventDefault(); alert('Subscribed to Lavender Cloud Club.');">
    <input type="email" class="hp49-news__input" placeholder="{{ section.settings.placeholder | default: 'Enter your email address' }}" required>
    <button type="submit" class="hp49-news__btn">{{ section.settings.btn_text | default: 'Subscribe' }}</button>
  </form>
</div>

{% schema %}
{
  "name": "HP49 - Lavender News",
  "class": "section-hp49-news",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#F5F3FF" },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#7C3AED" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join The Lavender Cloud Club" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Receive gentle wellness updates and an instant 15% VIP welcome voucher." },
    { "type": "text", "id": "placeholder", "label": "Placeholder", "default": "Enter your email address" },
    { "type": "text", "id": "btn_text", "label": "Button Text", "default": "Subscribe" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 80 },
    { "type": "range", "id": "container_width", "min": 500, "max": 1000, "step": 20, "unit": "px", "label": "Container Width", "default": 760 }
  ],
  "presets": [
    { "name": "HP49 - Lavender News" }
  ]
}
{% endschema %}
