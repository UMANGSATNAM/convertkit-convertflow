{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#09090B' }};
    padding: {{ section.settings.padding_vertical | default: 35 }}px 0;
  }
  .hp61-pills__container { max-width: 1280px; margin: 0 auto; padding: 0 24px; }
  .hp61-pills__scroll { display: flex; gap: 12px; overflow-x: auto; scrollbar-width: none; justify-content: center; flex-wrap: wrap; }
  .hp61-pills__scroll::-webkit-scrollbar { display: none; }
  .hp61-pills__pill {
    display: inline-flex; align-items: center; gap: 8px; padding: 10px 22px;
    background: {{ section.settings.pill_bg | default: '#18181B' }};
    border: 1px solid rgba(239, 68, 68, 0.25); border-radius: 4px;
    font-family: 'Space Grotesk', sans-serif; font-size: 13px; font-weight: 600;
    color: {{ section.settings.pill_text | default: '#F4F4F5' }};
    text-decoration: none; white-space: nowrap; transition: all 0.3s ease;
  }
  .hp61-pills__pill:hover { background: #EF4444; color: #FFFFFF; border-color: #EF4444; box-shadow: 0 0 15px rgba(239, 68, 68, 0.5); }
  @media screen and (max-width: 768px) { .hp61-pills__scroll { justify-content: flex-start; flex-wrap: nowrap; } }
{%- endstyle -%}
<div class="hp61-pills__container">
  <div class="hp61-pills__scroll">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.url | default: '#' }}" class="hp61-pills__pill" {{ block.shopify_attributes }}>
        {%- if block.settings.icon != blank -%}<span>{{ block.settings.icon }}</span>{%- endif -%}
        <span>{{ block.settings.label | default: 'Category' }}</span>
      </a>
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "HP61 Categories",
  "class": "section-hp61-pills",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#09090B" },
    { "type": "color", "id": "pill_bg", "label": "Pill BG", "default": "#18181B" },
    { "type": "color", "id": "pill_text", "label": "Pill Text", "default": "#F4F4F5" },
    { "type": "range", "id": "padding_vertical", "min": 10, "max": 60, "step": 5, "unit": "px", "label": "Padding", "default": 35 }
  ],
  "blocks": [{ "type": "pill", "name": "Category", "settings": [
    { "type": "text", "id": "icon", "label": "Icon", "default": "🌋" },
    { "type": "text", "id": "label", "label": "Label", "default": "Basalt Masques" },
    { "type": "url", "id": "url", "label": "URL" }
  ]}],
  "presets": [{ "name": "HP61 Categories", "blocks": [
    { "type": "pill", "settings": { "icon": "🌋", "label": "Basalt Masques" } },
    { "type": "pill", "settings": { "icon": "⚡", "label": "Silica Peptides" } },
    { "type": "pill", "settings": { "icon": "🔥", "label": "Geothermal Cleansers" } },
    { "type": "pill", "settings": { "icon": "💎", "label": "Obsidian Balms" } },
    { "type": "pill", "settings": { "icon": "💨", "label": "Thermal Mists" } }
  ]}]
}
{% endschema %}
