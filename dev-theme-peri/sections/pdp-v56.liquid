{%- comment -%}
  PDP V56 — CYBERPUNK MATRIX AMBER TERMINAL
  Design: Sci-fi amber matrix HUD telemetry aesthetic, Orbitron header + Fira Code body
  Cyber Dark (#18181B), Amber Cyber (#D97706), Neon Amber (#F59E0B), Deep Bronze (#78350F)
{%- endcomment -%}

{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign inv_qty = current_variant.inventory_quantity | default: 15 -%}
{%- if inv_qty <= 0 -%}{%- assign inv_qty = 8 -%}{%- endif -%}
{%- assign viewer_count = inv_qty | times: 7 | modulo: 50 | plus: 26 -%}
{%- assign sold_count = inv_qty | times: 17 | modulo: 430 | plus: 220 -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Fira+Code:wght@500;600;700&family=Orbitron:wght@600;700;800&display=swap');

  .pdpv56 {
    --bg: #18181B; --surface: #27272A; --border: #3F3F46; --border-dark: #F59E0B;
    --text: #FAFAFA; --muted: #FBBF24; --accent: #F59E0B; --accent-hover: #D97706;
    --amber: #D97706; --danger: #EF4444;
    --f-head: 'Orbitron', sans-serif; --f-body: 'Fira Code', monospace;
    --r: 6px; --r-pill: 9999px; --ease: all 0.2s ease;
    background: var(--bg); color: var(--text); font-family: var(--f-body); font-size: 14px; line-height: 1.5; -webkit-font-smoothing: antialiased;
  }
  .pdpv56 *, .pdpv56 *::before, .pdpv56 *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .pdpv56 img { max-width: 100%; display: block; }
  .pdpv56 button { font-family: inherit; cursor: pointer; }
  .pdpv56__wrap { max-width: 1280px; margin: 0 auto; padding: 0 20px; }

  /* OFFER BAR */
  .pdpv56__offer { background: var(--accent); color: #000; padding: 10px; text-align: center; font-family: var(--f-head); font-size: 13px; font-weight: 800; letter-spacing: 2px; text-transform: uppercase; border-bottom: 2px solid var(--amber); }

  /* GRID */
  .pdpv56__grid { display: grid; grid-template-columns: 1fr; gap: 36px; padding: 36px 0; }
  @media (min-width: 992px) { .pdpv56__grid { grid-template-columns: 1.1fr 1fr; gap: 48px; padding: 48px 0; } }

  /* GALLERY */
  .pdpv56__gal { display: flex; flex-direction: column; gap: 12px; }
  .pdpv56__hero { width: 100%; aspect-ratio: 1; border-radius: var(--r); overflow: hidden; background: var(--surface); border: 2px solid var(--border-dark); display: flex; align-items: center; justify-content: center; box-shadow: 0 0 24px rgba(245,158,11,0.25); position: relative; }
  .pdpv56__hero img { width: 100%; height: 100%; object-fit: contain; }
  .pdpv56__amb-tag { position: absolute; top: 14px; left: 14px; background: rgba(24,24,27,0.9); border: 1px solid var(--accent); color: var(--accent); font-family: var(--f-head); font-size: 11px; font-weight: 700; padding: 4px 10px; border-radius: var(--r); }

  .pdpv56__thumbs { display: flex; gap: 10px; overflow-x: auto; }
  .pdpv56__th { width: 64px; height: 64px; flex-shrink: 0; border: 1px solid var(--border); border-radius: 6px; overflow: hidden; cursor: pointer; background: var(--surface); transition: var(--ease); }
  .pdpv56__th:hover, .pdpv56__th.on { border-color: var(--accent); box-shadow: 0 0 10px rgba(245,158,11,0.4); }
  .pdpv56__th img { width: 100%; height: 100%; object-fit: cover; }

  /* INFO PANEL */
  .pdpv56__info { display: flex; flex-direction: column; gap: 18px; }
  .pdpv56__crumb { font-family: var(--f-head); font-size: 12px; letter-spacing: 2px; color: var(--accent); font-weight: 700; text-transform: uppercase; }
  .pdpv56__title { font-family: var(--f-head); font-size: 30px; font-weight: 800; line-height: 1.15; color: var(--text); letter-spacing: 1px; }
  @media (min-width: 992px) { .pdpv56__title { font-size: 38px; } }

  .pdpv56__rating { display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--muted); font-weight: 600; }
  .pdpv56__stars { color: var(--accent); }

  /* PRICE CARD */
  .pdpv56__price-card { background: var(--surface); border: 1px solid var(--border-dark); border-radius: var(--r); padding: 16px 20px; display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 10px; box-shadow: 0 0 16px rgba(245,158,11,0.15); }
  .pdpv56__price { font-family: var(--f-head); font-size: 34px; font-weight: 800; color: var(--accent); }
  .pdpv56__cmp { font-size: 18px; color: var(--muted); text-decoration: line-through; }
  .pdpv56__badge { background: var(--accent); color: #000; font-family: var(--f-head); font-weight: 800; font-size: 11px; padding: 4px 10px; border-radius: 4px; }

  /* VARIANTS */
  .pdpv56__vlabel { font-family: var(--f-head); font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: var(--accent); margin-bottom: 8px; }
  .pdpv56__vopts { display: flex; flex-wrap: wrap; gap: 10px; }
  .pdpv56__vr { display: none; }
  .pdpv56__vbtn { padding: 10px 22px; border: 1px solid var(--border); border-radius: var(--r); background: var(--surface); color: var(--text); font-family: var(--f-body); font-size: 13px; font-weight: 700; transition: var(--ease); cursor: pointer; }
  .pdpv56__vbtn:hover { border-color: var(--accent); color: var(--accent); }
  .pdpv56__vr:checked + .pdpv56__vbtn { border-color: var(--accent); background: var(--accent); color: #000; }

  /* PROMO */
  .pdpv56__promo { background: var(--surface); border: 1px dashed var(--accent); border-radius: var(--r); padding: 14px 18px; display: flex; align-items: center; justify-content: space-between; font-size: 13px; font-weight: 700; color: var(--text); }
  .pdpv56__promo-code { background: var(--accent); color: #000; font-family: var(--f-head); padding: 4px 10px; border-radius: 4px; }

  /* URGENCY */
  .pdpv56__urg { background: var(--surface); border-left: 4px solid var(--accent); border-radius: 0 var(--r) var(--r) 0; padding: 16px; display: flex; flex-direction: column; gap: 8px; font-size: 13px; font-weight: 700; }
  .pdpv56__pulse { display: inline-block; width: 8px; height: 8px; background: var(--accent); border-radius: 50%; margin-right: 6px; animation: pdpv56p 1.5s infinite; }
  @keyframes pdpv56p { 0%,100% { opacity: 1; } 50% { opacity: 0.3; } }
  .pdpv56__bar { height: 6px; background: var(--border); border-radius: 3px; overflow: hidden; margin-top: 4px; }
  .pdpv56__fill { height: 100%; background: var(--accent); border-radius: 3px; }

  /* QTY & CTA */
  .pdpv56__qty-row { display: flex; align-items: center; gap: 14px; }
  .pdpv56__qty { display: flex; border: 1px solid var(--border); border-radius: var(--r); overflow: hidden; background: var(--surface); }
  .pdpv56__qty button { width: 44px; height: 48px; border: none; background: transparent; font-size: 18px; font-weight: 700; color: var(--text); }
  .pdpv56__qty input { width: 44px; height: 48px; border: none; border-left: 1px solid var(--border); border-right: 1px solid var(--border); text-align: center; font-size: 15px; font-weight: 700; background: transparent; color: var(--text); }

  .pdpv56__atc { width: 100%; padding: 18px; border: none; border-radius: var(--r); background: var(--accent); color: #000; font-family: var(--f-head); font-size: 16px; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; transition: var(--ease); box-shadow: 0 0 20px rgba(245,158,11,0.3); }
  .pdpv56__atc:hover { background: var(--accent-hover); color: #FFF; transform: translateY(-1px); }
  .pdpv56__atc:disabled { opacity: 0.4; cursor: not-allowed; box-shadow: none; }
  .pdpv56__buynow .shopify-payment-button__button { border-radius: var(--r) !important; }

  /* TRUST */
  .pdpv56__trust { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; text-align: center; padding: 18px 0; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .pdpv56__trust-item { font-family: var(--f-head); font-size: 10px; font-weight: 700; text-transform: uppercase; color: var(--muted); }
  .pdpv56__trust-icon { font-size: 20px; margin-bottom: 3px; color: var(--accent); }
  @media (max-width: 480px) { .pdpv56__trust { grid-template-columns: repeat(2, 1fr); } }

  /* ACCORDION */
  .pdpv56__acc { border-top: 1px solid var(--border); margin-top: 48px; }
  .pdpv56__acc-item { border-bottom: 1px solid var(--border); }
  .pdpv56__acc-btn { width: 100%; padding: 18px 0; border: none; background: transparent; display: flex; justify-content: space-between; align-items: center; font-family: var(--f-head); font-size: 15px; font-weight: 700; text-transform: uppercase; color: var(--text); }
  .pdpv56__acc-btn::after { content: '>'; font-size: 16px; color: var(--accent); }
  .pdpv56__acc-item.open .pdpv56__acc-btn::after { content: 'v'; }
  .pdpv56__acc-body { max-height: 0; overflow: hidden; transition: max-height 0.35s ease; }
  .pdpv56__acc-item.open .pdpv56__acc-body { max-height: 500px; }
  .pdpv56__acc-inner { padding: 0 0 18px; font-size: 14px; line-height: 1.7; color: var(--muted); }

  /* SECTION TITLE */
  .pdpv56__sh { font-family: var(--f-head); font-size: 24px; font-weight: 800; text-transform: uppercase; text-align: center; margin: 48px 0 20px; color: var(--text); letter-spacing: 1px; }

  /* REELS */
  .pdpv56__reels { display: flex; gap: 14px; overflow-x: auto; padding-bottom: 12px; }
  .pdpv56__reel { min-width: 180px; width: 180px; aspect-ratio: 9/16; background: #18181B; border: 1px solid var(--accent); border-radius: var(--r); overflow: hidden; flex-shrink: 0; position: relative; }
  .pdpv56__reel video { width: 100%; height: 100%; object-fit: cover; }
  .pdpv56__reel-cap { position: absolute; bottom: 0; left: 0; right: 0; padding: 10px; background: rgba(24,24,27,0.9); color: var(--accent); font-family: var(--f-head); font-size: 10px; }
  .pdpv56__reel-ph { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: var(--accent); font-size: 36px; }

  /* CARDS */
  .pdpv56__pgrid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
  @media (min-width: 768px) { .pdpv56__pgrid { grid-template-columns: repeat(4, 1fr); } }
  .pdpv56__pcard { background: var(--surface); border-radius: var(--r); border: 1px solid var(--border); overflow: hidden; transition: var(--ease); text-decoration: none; color: inherit; display: block; }
  .pdpv56__pcard:hover { border-color: var(--accent); transform: translateY(-2px); box-shadow: 0 0 16px rgba(245,158,11,0.2); }
  .pdpv56__pcard img { width: 100%; aspect-ratio: 1; object-fit: cover; }
  .pdpv56__pcard-info { padding: 14px; }
  .pdpv56__pcard-title { font-family: var(--f-head); font-size: 13px; font-weight: 700; margin-bottom: 4px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .pdpv56__pcard-price { font-family: var(--f-head); font-size: 15px; font-weight: 700; color: var(--accent); }

  /* REVIEWS */
  .pdpv56__revgrid { display: grid; grid-template-columns: 1fr; gap: 14px; }
  @media (min-width: 768px) { .pdpv56__revgrid { grid-template-columns: repeat(3, 1fr); } }
  .pdpv56__revcard { background: var(--surface); border-radius: var(--r); border: 1px solid var(--border); padding: 20px; }
  .pdpv56__rev-stars { color: var(--accent); font-size: 14px; margin-bottom: 8px; }
  .pdpv56__rev-txt { font-size: 13px; line-height: 1.6; color: var(--muted); font-style: italic; margin-bottom: 12px; }
  .pdpv56__rev-auth { font-family: var(--f-head); font-size: 12px; font-weight: 700; }
  .pdpv56__rev-vf { font-family: var(--f-head); font-size: 10px; color: var(--accent); font-weight: 700; }

  /* RECENTLY VIEWED */
  #pdpv56-rv { display: none; }
  #pdpv56-rv.has { display: block; }

  /* STICKY ATC */
  .pdpv56__sticky { position: fixed; bottom: -80px; left: 0; width: 100%; background: var(--surface); border-top: 1px solid var(--accent); padding: 12px 24px; display: flex; justify-content: space-between; align-items: center; z-index: 9999; transition: bottom 0.3s ease; box-shadow: 0 -4px 20px rgba(0,0,0,0.5); }
  .pdpv56__sticky.show { bottom: 0; }
  .pdpv56__sticky-l { display: flex; align-items: center; gap: 14px; }
  .pdpv56__sticky-img { width: 42px; height: 42px; border-radius: 4px; border: 1px solid var(--border); object-fit: cover; }
  .pdpv56__sticky-t { font-family: var(--f-head); font-size: 13px; font-weight: 700; max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .pdpv56__sticky-p { font-family: var(--f-head); font-size: 15px; font-weight: 700; color: var(--accent); }
  .pdpv56__sticky-btn { background: var(--accent); color: #000; border: none; padding: 12px 26px; border-radius: var(--r); font-family: var(--f-head); font-weight: 800; font-size: 13px; text-transform: uppercase; transition: var(--ease); }
  .pdpv56__sticky-btn:hover { background: var(--accent-hover); color: #FFF; }
  @media (max-width: 600px) { .pdpv56__sticky-l { display: none; } .pdpv56__sticky-btn { width: 100%; padding: 15px; } }

  .pdpv56__toast { position: fixed; top: 20px; right: 20px; background: var(--accent); color: #000; border-radius: var(--r); padding: 12px 24px; font-family: var(--f-head); font-size: 13px; font-weight: 700; z-index: 10000; transform: translateX(130%); transition: transform 0.3s ease; box-shadow: 0 0 16px rgba(245,158,11,0.4); }
  .pdpv56__toast.show { transform: translateX(0); }
</style>

<div class="pdpv56">
  {% if section.settings.show_offer %}<div class="pdpv56__offer">{{ section.settings.offer_text }}</div>{% endif %}

  <div class="pdpv56__wrap">
    <div class="pdpv56__grid">

      <!-- GALLERY -->
      <div class="pdpv56__gal">
        <div class="pdpv56__hero" id="pdpv56-hero">
          <span class="pdpv56__amb-tag">AMBER_OS // V56</span>
          {% if product.featured_media %}<img src="{{ product.featured_media | image_url: width: 900 }}" alt="{{ product.title | escape }}" id="pdpv56-himg">{% else %}{{ 'product-1' | placeholder_svg_tag }}{% endif %}
        </div>
        <div class="pdpv56__thumbs">
          {% for media in product.media limit: 6 %}
            <div class="pdpv56__th {% if forloop.first %}on{% endif %}">
              <img src="{{ media | image_url: width: 150 }}" alt="{{ media.alt | escape }}" loading="lazy">
            </div>
          {% endfor %}
        </div>
      </div>

      <!-- INFO -->
      <div class="pdpv56__info">
        <div class="pdpv56__crumb">[SYS] {% if product.collections.size > 0 %}{{ product.collections.first.title }}{% else %}Amber Terminal{% endif %}</div>
        <h1 class="pdpv56__title">{{ product.title }}</h1>

        {% if section.settings.show_rating %}
          <div class="pdpv56__rating">
            <span class="pdpv56__stars">★★★★★</span>
            <span>{{ section.settings.rating_val }} · {{ section.settings.rev_count }} Amber Logs</span>
          </div>
        {% endif %}

        <div class="pdpv56__price-card">
          <span class="pdpv56__price" id="pdpv56-price">{{ current_variant.price | money }}</span>
          {% if current_variant.compare_at_price > current_variant.price %}
            <span class="pdpv56__cmp">{{ current_variant.compare_at_price | money }}</span>
            {%- assign sv = current_variant.compare_at_price | minus: current_variant.price | times: 100.0 | divided_by: current_variant.compare_at_price | round -%}
            <span class="pdpv56__badge">SAVE {{ sv }}%</span>
          {% endif %}
        </div>

        {% if product.variants.size > 1 %}
          {% for option in product.options_with_values %}
            <div>
              <div class="pdpv56__vlabel">[SELECT_{{ option.name | upcase }}]</div>
              <div class="pdpv56__vopts">
                {% for value in option.values %}
                  <label>
                    <input type="radio" name="pdpv56-o-{{ option.position }}" value="{{ value | escape }}" class="pdpv56__vr" data-pos="{{ option.position }}" {% if option.selected_value == value %}checked{% endif %}>
                    <span class="pdpv56__vbtn">{{ value }}</span>
                  </label>
                {% endfor %}
              </div>
            </div>
          {% endfor %}
        {% endif %}

        {% if section.settings.show_promo %}
          <div class="pdpv56__promo">
            <span>Amber Pass: Apply {{ section.settings.promo_code }}</span>
            <span class="pdpv56__promo-code">Save {{ section.settings.promo_disc }}</span>
          </div>
        {% endif %}

        {% if section.settings.show_urgency %}
          <div class="pdpv56__urg">
            <div><span class="pdpv56__pulse"></span><strong>{{ viewer_count }}</strong> amber nodes active</div>
            <div>[SYS] <strong>{{ sold_count }}</strong> cyber orders completed today</div>
            <div>Buffer: Only <strong>{{ inv_qty }}</strong> remaining
              <div class="pdpv56__bar">
                {%- assign sp = inv_qty | times: 100 | divided_by: 45 -%}
                {%- if sp > 100 -%}{%- assign sp = 100 -%}{%- endif -%}
                <div class="pdpv56__fill" style="width:{{ sp }}%"></div>
              </div>
            </div>
            {% if section.settings.show_countdown %}
              <div>⏳ Amber Timeout In: <strong id="pdpv56-cd" style="color:var(--accent)">{{ section.settings.cd_hrs }}h 00m 00s</strong></div>
            {% endif %}
          </div>
        {% endif %}

        <div class="pdpv56__qty-row">
          <div class="pdpv56__qty">
            <button type="button" id="pdpv56-qm">−</button>
            <input type="number" id="pdpv56-qi" value="1" min="1" max="10" readonly>
            <button type="button" id="pdpv56-qp">+</button>
          </div>
          {% form 'product', product, id: 'pdpv56-form', style: 'flex:1' %}
            <input type="hidden" name="id" id="pdpv56-vid" value="{{ current_variant.id }}">
            <input type="hidden" name="quantity" id="pdpv56-fq" value="1">
            <button type="submit" name="add" class="pdpv56__atc" id="pdpv56-atc" {% unless current_variant.available %}disabled{% endunless %}>
              {% if current_variant.available %}ADD TO CART — {{ current_variant.price | money }}{% else %}SOLD OUT{% endif %}
            </button>
            <div class="pdpv56__buynow" style="margin-top:10px">{{ form | payment_button }}</div>
          {% endform %}
        </div>

        <div class="pdpv56__trust">
          <div class="pdpv56__trust-item"><div class="pdpv56__trust-icon">🔒</div>SSL 256-BIT</div>
          <div class="pdpv56__trust-item"><div class="pdpv56__trust-icon">⚡</div>AMBER NODE</div>
          <div class="pdpv56__trust-item"><div class="pdpv56__trust-icon">↩️</div>EASY RETURNS</div>
          <div class="pdpv56__trust-item"><div class="pdpv56__trust-icon">✓</div>VERIFIED GRID</div>
        </div>
      </div>
    </div>

    <!-- ACCORDION -->
    <div class="pdpv56__acc">
      <div class="pdpv56__acc-item open">
        <button class="pdpv56__acc-btn" type="button">Amber Architecture & Spec</button>
        <div class="pdpv56__acc-body"><div class="pdpv56__acc-inner">{{ product.description }}</div></div>
      </div>
      {% if section.settings.amb_specs != blank %}
        <div class="pdpv56__acc-item">
          <button class="pdpv56__acc-btn" type="button">Technical Telemetry & Protocol</button>
          <div class="pdpv56__acc-body"><div class="pdpv56__acc-inner">{{ section.settings.amb_specs }}</div></div>
        </div>
      {% endif %}
    </div>

    <!-- FBT -->
    {% if section.settings.fbt_coll != blank %}
      {%- assign fbt = collections[section.settings.fbt_coll] -%}
      {% if fbt.products.size > 0 %}
        <div class="pdpv56__sh">Amber Terminal Modules</div>
        <div class="pdpv56__pgrid">
          {% for item in fbt.products limit: 4 %}
            <a href="{{ item.url }}" class="pdpv56__pcard">
              <img src="{{ item.featured_image | image_url: width: 400 }}" alt="{{ item.title | escape }}" loading="lazy">
              <div class="pdpv56__pcard-info">
                <div class="pdpv56__pcard-title">{{ item.title }}</div>
                <div class="pdpv56__pcard-price">{{ item.price | money }}</div>
              </div>
            </a>
          {% endfor %}
        </div>
      {% endif %}
    {% endif %}

    <!-- REELS -->
    {% if section.settings.show_reels %}
      <div class="pdpv56__sh">Amber Telemetry</div>
      <div class="pdpv56__reels">
        {% if section.settings.r1 != blank %}<div class="pdpv56__reel"><video src="{{ section.settings.r1 }}" muted playsinline loop></video><div class="pdpv56__reel-cap">[AMBER_STREAM_1]</div></div>{% else %}<div class="pdpv56__reel"><div class="pdpv56__reel-ph">▶</div></div>{% endif %}
        {% if section.settings.r2 != blank %}<div class="pdpv56__reel"><video src="{{ section.settings.r2 }}" muted playsinline loop></video><div class="pdpv56__reel-cap">[AMBER_STREAM_2]</div></div>{% else %}<div class="pdpv56__reel"><div class="pdpv56__reel-ph">▶</div></div>{% endif %}
        {% if section.settings.r3 != blank %}<div class="pdpv56__reel"><video src="{{ section.settings.r3 }}" muted playsinline loop></video><div class="pdpv56__reel-cap">[AMBER_STREAM_3]</div></div>{% else %}<div class="pdpv56__reel"><div class="pdpv56__reel-ph">▶</div></div>{% endif %}
      </div>
    {% endif %}

    <!-- REVIEWS -->
    {% if section.settings.show_reviews %}
      <div class="pdpv56__sh" id="reviews">System Operator Logs</div>
      <div class="pdpv56__revgrid">
        {% if section.settings.rv1 != blank %}<div class="pdpv56__revcard"><div class="pdpv56__rev-stars">★★★★★</div><div class="pdpv56__rev-txt">"{{ section.settings.rv1 }}"</div><div class="pdpv56__rev-auth">{{ section.settings.rv1n }}</div><div class="pdpv56__rev-vf">✓ Verified Operator</div></div>{% endif %}
        {% if section.settings.rv2 != blank %}<div class="pdpv56__revcard"><div class="pdpv56__rev-stars">★★★★★</div><div class="pdpv56__rev-txt">"{{ section.settings.rv2 }}"</div><div class="pdpv56__rev-auth">{{ section.settings.rv2n }}</div><div class="pdpv56__rev-vf">✓ Verified Operator</div></div>{% endif %}
        {% if section.settings.rv3 != blank %}<div class="pdpv56__revcard"><div class="pdpv56__rev-stars">★★★★★</div><div class="pdpv56__rev-txt">"{{ section.settings.rv3 }}"</div><div class="pdpv56__rev-auth">{{ section.settings.rv3n }}</div><div class="pdpv56__rev-vf">✓ Verified Operator</div></div>{% endif %}
      </div>
    {% endif %}

    <!-- FEATURED -->
    {% if section.settings.feat_coll != blank %}
      {%- assign fc = collections[section.settings.feat_coll] -%}
      {% if fc.products.size > 0 %}
        <div class="pdpv56__sh">Recommended Amber Nodes</div>
        <div class="pdpv56__pgrid">
          {% for item in fc.products limit: 4 %}
            {% if item.handle != product.handle %}
              <a href="{{ item.url }}" class="pdpv56__pcard">
                <img src="{{ item.featured_image | image_url: width: 400 }}" alt="{{ item.title | escape }}" loading="lazy">
                <div class="pdpv56__pcard-info">
                  <div class="pdpv56__pcard-title">{{ item.title }}</div>
                  <div class="pdpv56__pcard-price">{{ item.price | money }}</div>
                </div>
              </a>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    {% endif %}

    <!-- RECENTLY VIEWED -->
    <div id="pdpv56-rv">
      <div class="pdpv56__sh">Recently Viewed</div>
      <div class="pdpv56__pgrid" id="pdpv56-rvg"></div>
    </div>
  </div>
</div>

<!-- STICKY ATC -->
<div class="pdpv56__sticky" id="pdpv56-sticky">
  <div class="pdpv56__sticky-l">
    {% if product.featured_media %}<img src="{{ product.featured_media | image_url: width: 80 }}" class="pdpv56__sticky-img" alt="{{ product.title | escape }}">{% endif %}
    <div>
      <div class="pdpv56__sticky-t">{{ product.title }}</div>
      <div class="pdpv56__sticky-p" id="pdpv56-sp">{{ current_variant.price | money }}</div>
    </div>
  </div>
  
      <!-- D2C SCARCITY & NOTIFY -->
      {% if product.available %}
        <div style="background:#FFF3E0; border:1px solid #FFCC80; padding:10px; border-radius:8px; margin-bottom:12px; display:flex; align-items:center; gap:12px;">
          <svg style="width:24px; height:24px; color:#E65100; flex-shrink:0;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          <div style="font-size:13px; color:#E65100;">
            <div style="font-weight:700;">Limited Time Offer Ends In:</div>
            <div style="font-size:16px; font-weight:700; margin-top:2px;"><b>{% render 'countdown-timer', product: product %}</b></div>
          </div>
        </div>
      {% endif %}

      {% render 'back-in-stock', product: product %}

      {% if product.available %}
      <button type="button" class="pdpv56__sticky-btn" id="pdpv56-sbtn">Add to Cart</button>
      {% else %}
      <button class="pdpv56__sticky-btn" disabled style="opacity:0.5; cursor:not-allowed;">SOLD OUT</button>
      {% endif %}
</div>

<div class="pdpv56__toast" id="pdpv56-toast">System: Added to cart!</div>

<script>
(function(){
  var PJ={{ product | json }}, cid={{ current_variant.id }};
  function getO(){ var o=[]; document.querySelectorAll('.pdpv56__vr:checked').forEach(function(r){ o.push({p:parseInt(r.dataset.pos),v:r.value}); }); o.sort(function(a,b){return a.p-b.p}); return o.map(function(x){return x.v}); }
  function findV(o){ for(var i=0;i<PJ.variants.length;i++){ var v=PJ.variants[i],ok=true; for(var j=0;j<o.length;j++){ if(v.options[j]!==o[j]){ ok=false; break; } } if(ok) return v; } return null; }
  function upd(){
    var o=getO(); if(!o.length) return; var v=findV(o); if(!v) return; cid=v.id;
    document.getElementById('pdpv56-vid').value=v.id;
    var pf=(v.price/100).toLocaleString('en-US',{style:'currency',currency:PJ.currency||'USD'});
    var pe=document.getElementById('pdpv56-price'); if(pe) pe.textContent=pf;
    var sp=document.getElementById('pdpv56-sp'); if(sp) sp.textContent=pf;
    var ab=document.getElementById('pdpv56-atc');
    if(ab){ ab.disabled=!v.available; ab.textContent=v.available?'ADD TO CART — '+pf:'SOLD OUT'; }
    var u=new URL(window.location); u.searchParams.set('variant',v.id); history.replaceState({},'',u);
  }
  document.querySelectorAll('.pdpv56__vr').forEach(function(r){ r.addEventListener('change',upd); });

  var fm=document.getElementById('pdpv56-form');
  if(fm) fm.addEventListener('submit',function(e){
    e.preventDefault(); var b=document.getElementById('pdpv56-atc'), ot=b.textContent;
    b.disabled=true; b.textContent='ADDING...';
    var q=parseInt(document.getElementById('pdpv56-qi').value)||1;
    document.getElementById('pdpv56-fq').value=q;
    fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:cid,quantity:q})})
    .then(function(r){return r.json();})
    .then(function(){ b.textContent='✓ ADDED!'; toast56(); setTimeout(function(){ b.disabled=false; b.textContent=ot; },2000); })
    .catch(function(){ b.textContent='ERROR'; setTimeout(function(){ b.disabled=false; b.textContent=ot; },2000); });
  });

  function toast56(){ var t=document.getElementById('pdpv56-toast'); t.classList.add('show'); setTimeout(function(){ t.classList.remove('show'); },3000); }

  var qi=document.getElementById('pdpv56-qi');
  document.getElementById('pdpv56-qm').addEventListener('click',function(){ var v=parseInt(qi.value); if(v>1) qi.value=v-1; });
  document.getElementById('pdpv56-qp').addEventListener('click',function(){ var v=parseInt(qi.value); if(v<10) qi.value=v+1; });

  document.querySelectorAll('.pdpv56__th').forEach(function(th){
    th.addEventListener('click',function(){
      document.querySelectorAll('.pdpv56__th').forEach(function(t){ t.classList.remove('on'); });
      th.classList.add('on');
      var hi=document.getElementById('pdpv56-himg'), ti=th.querySelector('img');
      if(hi&&ti) hi.src=ti.src.replace(/width=\d+/,'width=900');
    });
  });

  var sb=document.getElementById('pdpv56-sticky'), ab=document.getElementById('pdpv56-atc');
  if(sb&&ab) window.addEventListener('scroll',function(){ sb.classList.toggle('show', ab.getBoundingClientRect().top<-50); });
  var sbn=document.getElementById('pdpv56-sbtn');
  if(sbn) sbn.addEventListener('click',function(){ document.getElementById('pdpv56-atc').click(); });

  document.querySelectorAll('.pdpv56__acc-btn').forEach(function(b){ b.addEventListener('click',function(){ b.closest('.pdpv56__acc-item').classList.toggle('open'); }); });

  var ce=document.getElementById('pdpv56-cd');
  if(ce){
    var hrs=parseInt('{{ section.settings.cd_hrs | default: 6 }}')||6, ts=hrs*3600;
    var sk=sessionStorage.getItem('pdpv56_cd'); if(sk) ts=parseInt(sk);
    setInterval(function(){ ts--; if(ts<=0){ ce.textContent='EXPIRED'; return; } var h=Math.floor(ts/3600), m=Math.floor((ts%3600)/60), s=ts%60; ce.textContent=h+'h '+(m<10?'0':'')+m+'m '+(s<10?'0':'')+s+'s'; sessionStorage.setItem('pdpv56_cd',ts); },1000);
  }

  if('IntersectionObserver' in window){
    var ro=new IntersectionObserver(function(es){ es.forEach(function(e){ var v=e.target.querySelector('video'); if(v){ e.isIntersecting?v.play():v.pause(); } }); },{threshold:0.5});
    document.querySelectorAll('.pdpv56__reel').forEach(function(r){ ro.observe(r); });
  }

  var RK='pdpv56_rv', cp={handle:'{{ product.handle }}',title:'{{ product.title | escape }}',price:'{{ product.price | money }}',image:'{{ product.featured_image | image_url: width: 400 }}',url:'{{ product.url }}'};
  try{ var its=JSON.parse(localStorage.getItem(RK)||'[]'); its=its.filter(function(i){ return i.handle!==cp.handle; }); its.unshift(cp); if(its.length>8) its=its.slice(0,8); localStorage.setItem(RK,JSON.stringify(its)); }catch(e){}
  try{
    var its2=JSON.parse(localStorage.getItem(RK)||'[]').filter(function(i){ return i.handle!==cp.handle; });
    var c=document.getElementById('pdpv56-rv'), g=document.getElementById('pdpv56-rvg');
    if(g&&its2.length>0){ c.classList.add('has'); var h=''; its2.slice(0,4).forEach(function(i){ h+='<a href="'+i.url+'" class="pdpv56__pcard"><img src="'+i.image+'" alt="'+i.title+'" loading="lazy"><div class="pdpv56__pcard-info"><div class="pdpv56__pcard-title">'+i.title+'</div><div class="pdpv56__pcard-price">'+i.price+'</div></div></a>'; }); g.innerHTML=h; }
  }catch(e){}
})();
</script>

{% schema %}
{
  "name": "PDP V56 — Amber Cyber",
  "tag": "section",
  "class": "pdpv56-section",
  "settings": [
    { "type": "header", "content": "Rating" },
    { "type": "checkbox", "id": "show_rating", "label": "Show rating", "default": true },
    { "type": "text", "id": "rating_val", "label": "Rating score", "default": "4.98" },
    { "type": "text", "id": "rev_count", "label": "Total reviews", "default": "2,150" },
    { "type": "header", "content": "Offer Banner" },
    { "type": "checkbox", "id": "show_offer", "label": "Show offer", "default": true },
    { "type": "text", "id": "offer_text", "label": "Offer text", "default": "[SYS] AMBER TERMINAL: ENJOY 20% DISCOUNT WITH CODE 'AMBER20'" },
    { "type": "header", "content": "Promo" },
    { "type": "checkbox", "id": "show_promo", "label": "Show promo", "default": true },
    { "type": "text", "id": "promo_code", "label": "Code", "default": "AMBER20" },
    { "type": "text", "id": "promo_disc", "label": "Discount", "default": "20%" },
    { "type": "header", "content": "Urgency" },
    { "type": "checkbox", "id": "show_urgency", "label": "Show urgency", "default": true },
    { "type": "checkbox", "id": "show_countdown", "label": "Show countdown", "default": true },
    { "type": "range", "id": "cd_hrs", "label": "Countdown hours", "min": 1, "max": 48, "default": 6 },
    { "type": "header", "content": "Accordion" },
    { "type": "richtext", "id": "amb_specs", "label": "Technical telemetry & protocol" },
    { "type": "header", "content": "FBT" },
    { "type": "collection", "id": "fbt_coll", "label": "FBT collection" },
    { "type": "header", "content": "Reels" },
    { "type": "checkbox", "id": "show_reels", "label": "Show reels", "default": true },
    { "type": "url", "id": "r1", "label": "Reel 1 URL" },
    { "type": "url", "id": "r2", "label": "Reel 2 URL" },
    { "type": "url", "id": "r3", "label": "Reel 3 URL" },
    { "type": "header", "content": "Reviews" },
    { "type": "checkbox", "id": "show_reviews", "label": "Show reviews", "default": true },
    { "type": "text", "id": "rv1", "label": "Review 1", "default": "Amber terminal grid is super cool!" },
    { "type": "text", "id": "rv1n", "label": "Author 1", "default": "Jaxon T." },
    { "type": "text", "id": "rv2", "label": "Review 2", "default": "High-contrast dark theme with glowing amber." },
    { "type": "text", "id": "rv2n", "label": "Author 2", "default": "Ryder S." },
    { "type": "text", "id": "rv3", "label": "Review 3", "default": "100% cyberpunk excellence." },
    { "type": "text", "id": "rv3n", "label": "Author 3", "default": "Knox P." },
    { "type": "header", "content": "Featured" },
    { "type": "collection", "id": "feat_coll", "label": "Featured collection" }
  ],
  "presets": [{ "name": "PDP V56 — Amber Cyber" }]
}
{% endschema %}
