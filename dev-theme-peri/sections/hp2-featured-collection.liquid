{%- liquid
  assign bg_color = section.settings.bg_color | default: '#ffffff'
  assign text_color = section.settings.text_color | default: '#000000'
  assign card_bg = section.settings.card_bg | default: '#f4f4f4'
  
  assign padding_top_desktop = section.settings.padding_top_desktop
  assign padding_bottom_desktop = section.settings.padding_bottom_desktop
  assign padding_top_mobile = section.settings.padding_top_mobile
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile
  
  assign columns_desktop = section.settings.columns_desktop
  assign columns_tablet = section.settings.columns_tablet
  assign columns_mobile = section.settings.columns_mobile
  
  assign heading = section.settings.heading
  assign collection = collections[section.settings.collection]
  assign product_limit = section.settings.limit
-%}

<style>
  #shopify-section-{{ section.id }} {
    --hp2-feat-bg: {{ bg_color }};
    --hp2-feat-text: {{ text_color }};
    --hp2-feat-card-bg: {{ card_bg }};
    --hp2-feat-pt-desk: {{ padding_top_desktop }}px;
    --hp2-feat-pb-desk: {{ padding_bottom_desktop }}px;
    --hp2-feat-pt-mob: {{ padding_top_mobile }}px;
    --hp2-feat-pb-mob: {{ padding_bottom_mobile }}px;
    
    --hp2-grid-cols-desk: {{ columns_desktop }};
    --hp2-grid-cols-tab: {{ columns_tablet }};
    --hp2-grid-cols-mob: {{ columns_mobile }};
  }

  .hp2-fashion-featured-{{ section.id }} {
    padding-top: var(--hp2-feat-pt-desk);
    padding-bottom: var(--hp2-feat-pb-desk);
    background-color: var(--hp2-feat-bg);
    color: var(--hp2-feat-text);
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
  }

  .hp2-feat-inner {
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 40px;
  }

  /* Header Styles */
  .hp2-feat-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 50px;
    border-bottom: 2px solid var(--hp2-feat-text);
    padding-bottom: 15px;
  }

  .hp2-feat-title {
    font-size: clamp(28px, 4vw, 42px);
    font-weight: 800;
    text-transform: uppercase;
    margin: 0;
    line-height: 1.1;
    letter-spacing: -1px;
  }

  .hp2-feat-link {
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    color: var(--hp2-feat-text);
    letter-spacing: 1px;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 8px;
    transition: opacity 0.3s ease;
  }
  .hp2-feat-link:hover {
    opacity: 0.6;
  }

  /* Grid Layout */
  .hp2-feat-grid {
    display: grid;
    grid-template-columns: repeat(var(--hp2-grid-cols-desk), 1fr);
    gap: 30px;
  }

  /* Product Card */
  .hp2-feat-card {
    display: flex;
    flex-direction: column;
    group;
    text-decoration: none;
    color: var(--hp2-feat-text);
  }

  .hp2-feat-img-wrap {
    position: relative;
    aspect-ratio: 3/4;
    overflow: hidden;
    background-color: var(--hp2-feat-card-bg);
    margin-bottom: 20px;
    display: block;
  }

  .hp2-feat-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  .hp2-feat-card:hover .hp2-feat-img {
    transform: scale(1.05);
  }

  /* Quick Add Badge */
  .hp2-quick-add {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: var(--hp2-feat-text);
    color: var(--hp2-feat-bg);
    padding: 16px;
    text-align: center;
    font-weight: 800;
    font-size: 12px;
    letter-spacing: 1px;
    text-transform: uppercase;
    transform: translateY(100%);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 2;
  }
  .hp2-feat-card:hover .hp2-quick-add {
    transform: translateY(0);
  }
  .hp2-quick-add:hover {
    background: #333; /* Slightly lighter assuming dark theme primary */
  }

  /* Secondary Image Hover */
  .hp2-feat-img-hover {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.5s ease, transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    transform: scale(1.02);
  }
  .hp2-feat-card:hover .hp2-feat-img-hover {
    opacity: 1;
    transform: scale(1.05);
  }

  /* Badges */
  .hp2-badge {
    position: absolute;
    top: 15px;
    left: 15px;
    background: var(--hp2-feat-text);
    color: var(--hp2-feat-bg);
    padding: 6px 12px;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    z-index: 3;
  }
  .hp2-badge.sale {
    background: #e32636;
    color: #fff;
  }

  /* Info */
  .hp2-feat-info {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 15px;
  }

  .hp2-feat-title-wrap {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .hp2-feat-name {
    font-size: 15px;
    font-weight: 700;
    text-transform: uppercase;
    margin: 0;
    letter-spacing: 0.5px;
  }

  .hp2-feat-vendor {
    font-size: 11px;
    font-weight: 500;
    color: #888;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .hp2-feat-price-wrap {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4px;
  }

  .hp2-feat-price {
    font-size: 15px;
    font-weight: 700;
  }

  .hp2-feat-compare {
    font-size: 12px;
    text-decoration: line-through;
    color: #999;
  }

  /* Responsive styling */
  @media screen and (max-width: 1024px) {
    .hp2-feat-grid {
      grid-template-columns: repeat(var(--hp2-grid-cols-tab), 1fr);
      gap: 20px;
    }
  }

  @media screen and (max-width: 768px) {
    .hp2-fashion-featured-{{ section.id }} {
      padding-top: var(--hp2-feat-pt-mob);
      padding-bottom: var(--hp2-feat-pb-mob);
    }
    .hp2-feat-inner {
      padding: 0 20px;
    }
    .hp2-feat-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 15px;
      margin-bottom: 30px;
    }
    .hp2-feat-grid {
      grid-template-columns: repeat(var(--hp2-grid-cols-mob), 1fr);
      gap: 15px;
    }
    /* On mobile, usually no hover, so we can keep quick add visible or hidden */
    .hp2-quick-add {
      display: none; /* Often hidden on mobile to rely on clicking the card */
    }
  }
</style>

<section class="hp2-fashion-featured-{{ section.id }}" aria-label="Featured Collection">
  <div class="hp2-feat-inner">
    
    <div class="hp2-feat-header">
      {%- if heading != blank -%}
        <h2 class="hp2-feat-title">{{ heading }}</h2>
      {%- endif -%}
      
      {%- if section.settings.show_view_all and collection != blank -%}
        <a href="{{ collection.url }}" class="hp2-feat-link" aria-label="View all products in {{ collection.title }}">
          {{ section.settings.view_all_text | default: 'VIEW ALL' }}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14"></path>
            <path d="M12 5l7 7-7 7"></path>
          </svg>
        </a>
      {%- endif -%}
    </div>

    <div class="hp2-feat-grid">
      {%- if collection != blank and collection.products_count > 0 -%}
        
        {%- for product in collection.products limit: product_limit -%}
          <a href="{{ product.url }}" class="hp2-feat-card" aria-label="{{ product.title | escape }}">
            
            <div class="hp2-feat-img-wrap">
              {%- if product.featured_image != blank -%}
                <img height="{{ product.featured_image.height }}" width="{{ product.featured_image.width }}" src="{{ product.featured_image | image_url: width: 600 }}" 
                     srcset="{{ product.featured_image | image_url: width: 400 }} 400w, 
                             {{ product.featured_image | image_url: width: 600 }} 600w, 
                             {{ product.featured_image | image_url: width: 800 }} 800w"
                     sizes="(max-width: 768px) 50vw, 25vw"
                     class="hp2-feat-img" 
                     loading="lazy" 
                     alt="{{ product.featured_image.alt | default: product.title | escape }}">
                
                {%- if product.images[1] != blank and section.settings.show_secondary_image -%}
                  <img height="{{ product.images[1].height }}" width="{{ product.images[1].width }}" src="{{ product.images[1] | image_url: width: 600 }}" 
                       class="hp2-feat-img-hover" 
                       loading="lazy" 
                       alt="">
                {%- endif -%}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'hp2-feat-img placeholder-svg' }}
              {%- endif -%}

              {%- if product.compare_at_price > product.price -%}
                <span class="hp2-badge sale">SALE</span>
              {%- elsif product.available == false -%}
                <span class="hp2-badge">SOLD OUT</span>
              {%- else -%}
                {%- for tag in product.tags -%}
                  {%- if tag contains 'new' or tag contains 'New' -%}
                    <span class="hp2-badge">NEW</span>
                    {%- break -%}
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}

              {%- if section.settings.enable_quick_add and product.available -%}
                <div class="hp2-quick-add">ADD TO BAG +</div>
              {%- endif -%}
            </div>

            <div class="hp2-feat-info">
              <div class="hp2-feat-title-wrap">
                <h3 class="hp2-feat-name">{{ product.title }}</h3>
                {%- if section.settings.show_vendor -%}
                  <span class="hp2-feat-vendor">{{ product.vendor }}</span>
                {%- endif -%}
              </div>
              <div class="hp2-feat-price-wrap">
                <span class="hp2-feat-price">{{ product.price | money }}</span>
                {%- if product.compare_at_price > product.price -%}
                  <span class="hp2-feat-compare">{{ product.compare_at_price | money }}</span>
                {%- endif -%}
              </div>
            </div>

          </a>
        {%- endfor -%}

      {%- else -%}
        
        {%- comment -%} Placeholder state {%- endcomment -%}
        {%- for i in (1..product_limit) -%}
          <div class="hp2-feat-card">
            <div class="hp2-feat-img-wrap">
              {%- capture current -%}{% cycle 1, 2, 3, 4, 5, 6 %}{%- endcapture -%}
              {{ 'product-' | append: current | placeholder_svg_tag: 'hp2-feat-img placeholder-svg' }}
              {%- if section.settings.enable_quick_add -%}
                <div class="hp2-quick-add">ADD TO BAG +</div>
              {%- endif -%}
            </div>
            <div class="hp2-feat-info">
              <div class="hp2-feat-title-wrap">
                <h3 class="hp2-feat-name">Studio Collection Piece</h3>
                {%- if section.settings.show_vendor -%}
                  <span class="hp2-feat-vendor">Brand Name</span>
                {%- endif -%}
              </div>
              <div class="hp2-feat-price-wrap">
                <span class="hp2-feat-price">$120.00</span>
              </div>
            </div>
          </div>
        {%- endfor -%}

      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "HP2 Featured Collection",
  "tag": "section",
  "class": "section-hp2-featured",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "THE EDIT"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    },
    {
      "type": "header",
      "content": "Grid Settings"
    },
    {
      "type": "range",
      "id": "limit",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Maximum Products to Show",
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Columns (Desktop)",
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns (Tablet)",
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns (Mobile)",
      "options": [
        { "value": "1", "label": "1 Column" },
        { "value": "2", "label": "2 Columns" }
      ],
      "default": "2"
    },
    {
      "type": "header",
      "content": "Product Card Settings"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "label": "Show second image on hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show Vendor Name",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_quick_add",
      "label": "Enable 'Add to Bag' Hover Button",
      "default": true,
      "info": "Displays a quick add button on desktop hover."
    },
    {
      "type": "header",
      "content": "View All Link"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View All' link",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "Link Text",
      "default": "VIEW ALL"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text/Border Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Product Image Background",
      "default": "#f4f4f4"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Top (Desktop)", "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Bottom (Desktop)", "default": 100
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Top (Mobile)", "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Bottom (Mobile)", "default": 60
    }
  ],
  "presets": [
    {
      "name": "HP2 Featured Collection",
      "category": "Collection"
    }
  ]
}
{% endschema %}
