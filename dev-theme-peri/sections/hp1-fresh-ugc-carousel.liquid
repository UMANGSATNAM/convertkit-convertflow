{%- liquid
  assign bg_color = section.settings.bg_color | default: '#FAF6F0'
  assign text_color = section.settings.text_color | default: '#1C1917'
-%}

<section class="hp1-fresh-ugc" style="--bg: {{ bg_color }}; --text: {{ text_color }};">
  <div class="hp1-fresh-ugc__container">
    
    <!-- Section Header -->
    <div class="hp1-fresh-ugc__header">
      <span class="hp1-fresh-ugc__tag">Real Results From Real People</span>
      <h2 class="hp1-fresh-ugc__title">As Seen On TikTok & Instagram</h2>
      <p class="hp1-fresh-ugc__subtitle">Tap any video reel below to watch real customers share their 14-day skin glow transformation.</p>
    </div>

    <!-- Reels Grid -->
    <div class="hp1-fresh-ugc__grid">
      
      <!-- Reel 1 -->
      <div class="hp1-fresh-reel">
        <img src="https://images.unsplash.com/photo-1544005313-94ddf0286df2?q=80&w=600&auto=format&fit=crop" alt="UGC Reel 1" class="hp1-fresh-reel__img">
        <div class="hp1-fresh-reel__overlay">
          <div class="hp1-fresh-reel__play-btn">▶</div>
          <div class="hp1-fresh-reel__user">
            <strong>@sophia_glows</strong>
            <span>Verified Buyer</span>
          </div>
        </div>
        <div class="hp1-fresh-reel__product-tag">
          <img src="https://images.unsplash.com/photo-1620916566398-39f1143ab7be?q=80&w=100&auto=format&fit=crop" alt="Product Thumb" class="hp1-fresh-reel__thumb">
          <div class="hp1-fresh-reel__tag-info">
            <strong>Glow Barrier Serum</strong>
            <span>$42.00</span>
          </div>
          <button class="hp1-fresh-reel__shop-btn">Shop</button>
        </div>
      </div>

      <!-- Reel 2 -->
      <div class="hp1-fresh-reel">
        <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?q=80&w=600&auto=format&fit=crop" alt="UGC Reel 2" class="hp1-fresh-reel__img">
        <div class="hp1-fresh-reel__overlay">
          <div class="hp1-fresh-reel__play-btn">▶</div>
          <div class="hp1-fresh-reel__user">
            <strong>@claire.skin</strong>
            <span>Verified Buyer</span>
          </div>
        </div>
        <div class="hp1-fresh-reel__product-tag">
          <img src="https://images.unsplash.com/photo-1556228720-195a672e8a03?q=80&w=100&auto=format&fit=crop" alt="Product Thumb" class="hp1-fresh-reel__thumb">
          <div class="hp1-fresh-reel__tag-info">
            <strong>Dewy Rose Cream</strong>
            <span>$48.00</span>
          </div>
          <button class="hp1-fresh-reel__shop-btn">Shop</button>
        </div>
      </div>

      <!-- Reel 3 -->
      <div class="hp1-fresh-reel">
        <img src="https://images.unsplash.com/photo-1517841905240-472988babdf9?q=80&w=600&auto=format&fit=crop" alt="UGC Reel 3" class="hp1-fresh-reel__img">
        <div class="hp1-fresh-reel__overlay">
          <div class="hp1-fresh-reel__play-btn">▶</div>
          <div class="hp1-fresh-reel__user">
            <strong>@beautyby_maya</strong>
            <span>Verified Buyer</span>
          </div>
        </div>
        <div class="hp1-fresh-reel__product-tag">
          <img src="https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?q=80&w=100&auto=format&fit=crop" alt="Product Thumb" class="hp1-fresh-reel__thumb">
          <div class="hp1-fresh-reel__tag-info">
            <strong>Velvet Oil Cleanser</strong>
            <span>$36.00</span>
          </div>
          <button class="hp1-fresh-reel__shop-btn">Shop</button>
        </div>
      </div>

      <!-- Reel 4 -->
      <div class="hp1-fresh-reel">
        <img src="https://images.unsplash.com/photo-1524504388940-b1c1722653e1?q=80&w=600&auto=format&fit=crop" alt="UGC Reel 4" class="hp1-fresh-reel__img">
        <div class="hp1-fresh-reel__overlay">
          <div class="hp1-fresh-reel__play-btn">▶</div>
          <div class="hp1-fresh-reel__user">
            <strong>@emma.routine</strong>
            <span>Verified Buyer</span>
          </div>
        </div>
        <div class="hp1-fresh-reel__product-tag">
          <img src="https://images.unsplash.com/photo-1617897903246-719242758050?q=80&w=100&auto=format&fit=crop" alt="Product Thumb" class="hp1-fresh-reel__thumb">
          <div class="hp1-fresh-reel__tag-info">
            <strong>Overnight Mask</strong>
            <span>$54.00</span>
          </div>
          <button class="hp1-fresh-reel__shop-btn">Shop</button>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .hp1-fresh-ugc {
    background-color: var(--bg);
    color: var(--text);
    padding: 96px 24px;
    font-family: 'Plus Jakarta Sans', sans-serif;
  }
  .hp1-fresh-ugc__container {
    max-width: 1280px;
    margin: 0 auto;
  }

  .hp1-fresh-ugc__header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 48px;
  }
  .hp1-fresh-ugc__tag {
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #D97706;
    display: block;
    margin-bottom: 8px;
  }
  .hp1-fresh-ugc__title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(28px, 3.5vw, 40px);
    font-weight: 700;
    margin: 0 0 12px 0;
  }
  .hp1-fresh-ugc__subtitle {
    font-size: 15px;
    color: rgba(28, 25, 23, 0.7);
    margin: 0;
  }

  .hp1-fresh-ugc__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }
  @media (max-width: 991px) {
    .hp1-fresh-ugc__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 576px) {
    .hp1-fresh-ugc__grid { grid-template-columns: 1fr; }
  }

  .hp1-fresh-reel {
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    aspect-ratio: 9 / 16;
    box-shadow: 0 15px 35px rgba(0,0,0,0.1);
    cursor: pointer;
  }
  .hp1-fresh-reel__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .hp1-fresh-reel:hover .hp1-fresh-reel__img {
    transform: scale(1.05);
  }

  .hp1-fresh-reel__overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0.2) 0%, rgba(0,0,0,0.7) 100%);
    padding: 20px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .hp1-fresh-reel__play-btn {
    width: 48px;
    height: 48px;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(8px);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #1C1917;
    font-size: 16px;
    margin: auto auto;
    transition: transform 0.2s ease;
  }
  .hp1-fresh-reel:hover .hp1-fresh-reel__play-btn {
    transform: scale(1.15);
    background: #FFF;
  }

  .hp1-fresh-reel__user {
    color: #FFF;
    margin-bottom: 60px;
  }
  .hp1-fresh-reel__user strong {
    display: block;
    font-size: 14px;
  }
  .hp1-fresh-reel__user span {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.7);
  }

  .hp1-fresh-reel__product-tag {
    position: absolute;
    bottom: 12px;
    left: 12px;
    right: 12px;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(12px);
    border-radius: 14px;
    padding: 8px 12px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .hp1-fresh-reel__thumb {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    object-fit: cover;
  }
  .hp1-fresh-reel__tag-info strong {
    display: block;
    font-size: 12px;
    color: #1C1917;
  }
  .hp1-fresh-reel__tag-info span {
    font-size: 11px;
    color: rgba(28, 25, 23, 0.6);
  }
  .hp1-fresh-reel__shop-btn {
    margin-left: auto;
    background: #1C1917;
    color: #FFF;
    border: none;
    padding: 6px 12px;
    border-radius: 100px;
    font-size: 11px;
    font-weight: 600;
    cursor: pointer;
  }
</style>

{% schema %}
{
  "name": "HP1 Fresh - UGC Reels",
  "tag": "section",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#FAF6F0" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#1C1917" }
  ],
  "presets": [
    { "name": "HP1 Fresh - UGC Reels" }
  ]
}
{% endschema %}
