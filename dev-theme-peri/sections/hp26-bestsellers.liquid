{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --card-bg: {{ section.settings.card_bg }};
    --font-heading: 'Cormorant Garamond', serif;
    --font-body: 'Inter', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.8 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.8 | round }}px;
    }
  }

  .hp26-bestsellers-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
    position: relative;
  }

  @media screen and (max-width: 768px) {
    .hp26-bestsellers-wrapper {
      padding: 0 20px;
    }
  }

  .hp26-bs__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: {{ section.settings.header_margin }}px;
    border-bottom: 1px solid rgba(44, 42, 40, 0.1);
    padding-bottom: 20px;
  }

  @media screen and (max-width: 768px) {
    .hp26-bs__header {
      flex-direction: column;
      align-items: flex-start;
      gap: 15px;
    }
  }

  .hp26-bs__title-group {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .hp26-bs__subtitle {
    font-family: var(--font-body);
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-color);
    opacity: 0.6;
  }

  .hp26-bs__title {
    font-family: var(--font-heading);
    font-size: clamp(28px, 4vw, {{ section.settings.title_size }}px);
    font-weight: 400;
    color: var(--text-color);
    margin: 0;
    line-height: 1.1;
  }

  .hp26-bs__title em {
    font-style: italic;
    font-weight: 300;
  }

  .hp26-bs__nav {
    display: flex;
    gap: 15px;
  }

  @media screen and (max-width: 768px) {
    .hp26-bs__nav {
      display: none; /* Hide custom nav on mobile, use native scroll */
    }
  }

  .hp26-bs__nav-btn {
    width: 40px;
    height: 40px;
    border: 1px solid rgba(44, 42, 40, 0.2);
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }

  .hp26-bs__nav-btn:hover {
    border-color: var(--text-color);
    background: var(--text-color);
  }

  .hp26-bs__nav-btn svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: var(--text-color);
    stroke-width: 1.5;
    transition: stroke 0.3s ease;
  }

  .hp26-bs__nav-btn:hover svg {
    stroke: var(--bg-color);
  }

  .hp26-bs__slider {
    display: flex;
    gap: 30px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 20px; /* shadow space */
  }

  .hp26-bs__slider::-webkit-scrollbar {
    display: none;
  }

  .hp26-bs__item {
    flex: 0 0 calc(100% / {{ section.settings.columns_desktop }} - (30px * ({{ section.settings.columns_desktop }} - 1) / {{ section.settings.columns_desktop }}));
    scroll-snap-align: start;
    text-decoration: none;
    display: block;
    group;
  }

  @media screen and (max-width: 992px) {
    .hp26-bs__item {
      flex: 0 0 calc(50% - 15px);
    }
  }

  @media screen and (max-width: 600px) {
    .hp26-bs__item {
      flex: 0 0 75%;
    }
  }

  .hp26-bs__image-wrap {
    background-color: var(--card-bg);
    border-radius: 4px;
    aspect-ratio: 3/4;
    overflow: hidden;
    margin-bottom: 20px;
    position: relative;
  }

  .hp26-bs__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s ease, filter 0.8s ease;
  }

  .hp26-bs__item:hover .hp26-bs__image {
    transform: scale(1.05);
    filter: brightness(0.95);
  }

  .hp26-bs__badge {
    position: absolute;
    top: 15px;
    left: 15px;
    background: var(--text-color);
    color: var(--bg-color);
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 2px;
  }

  .hp26-bs__info {
    text-align: left;
  }

  .hp26-bs__title-prod {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 500;
    color: var(--text-color);
    margin: 0 0 5px;
    letter-spacing: 0.05em;
  }

  .hp26-bs__price {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 400;
    color: var(--text-color);
    opacity: 0.7;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp26-bestsellers-wrapper" id="HP26Bestsellers-{{ section.id }}">
  <div class="hp26-bs__header">
    <div class="hp26-bs__title-group">
      {%- if section.settings.subtitle != blank -%}
        <div class="hp26-bs__subtitle">{{ section.settings.subtitle }}</div>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 class="hp26-bs__title">{{ section.settings.title }}</h2>
      {%- endif -%}
    </div>
    
    <div class="hp26-bs__nav">
      <button class="hp26-bs__nav-btn hp26-bs__prev" aria-label="Previous">
        <svg viewBox="0 0 24 24"><path d="M15 18l-6-6 6-6"/></svg>
      </button>
      <button class="hp26-bs__nav-btn hp26-bs__next" aria-label="Next">
        <svg viewBox="0 0 24 24"><path d="M9 18l6-6-6-6"/></svg>
      </button>
    </div>
  </div>

  <div class="hp26-bs__slider">
    {%- for block in section.blocks -%}
      {%- assign prod = block.settings.product -%}
      <a href="{{ prod.url | default: '#' }}" class="hp26-bs__item" {{ block.shopify_attributes }}>
        <div class="hp26-bs__image-wrap">
          {%- if block.settings.badge_text != blank -%}
            <div class="hp26-bs__badge">{{ block.settings.badge_text }}</div>
          {%- endif -%}
          
          {%- if prod != blank and prod.featured_image != blank -%}
            <img src="{{ prod.featured_image | image_url: width: 600 }}" alt="{{ prod.title | escape }}" class="hp26-bs__image" loading="lazy">
          {%- else -%}
            <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:var(--text-color);font-family:var(--font-body);font-size:12px;opacity:0.3;">PRODUCT</div>
          {%- endif -%}
        </div>
        <div class="hp26-bs__info">
          <div class="hp26-bs__title-prod">{{ prod.title | default: 'Minimalist Essential' }}</div>
          <div class="hp26-bs__price">{{ prod.price | default: 12000 | money }}</div>
        </div>
      </a>
    {%- endfor -%}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const slider = document.querySelector('#HP26Bestsellers-{{ section.id }} .hp26-bs__slider');
    const prev = document.querySelector('#HP26Bestsellers-{{ section.id }} .hp26-bs__prev');
    const next = document.querySelector('#HP26Bestsellers-{{ section.id }} .hp26-bs__next');
    
    if(!slider || !prev || !next) return;

    const scrollAmt = 300;

    prev.addEventListener('click', () => {
      slider.scrollBy({ left: -scrollAmt, behavior: 'smooth' });
    });

    next.addEventListener('click', () => {
      slider.scrollBy({ left: scrollAmt, behavior: 'smooth' });
    });
  });
</script>

{% schema %}
{
  "name": "HP26 - Japandi Bestsell",
  "class": "section-hp26-bestsellers",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "SIGNATURE PIECES"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "The <em>Essentials</em>"
    },
    {
      "type": "range",
      "id": "header_margin",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Margin Below Header",
      "default": 40
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1400
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 3,
      "max": 6,
      "step": 1,
      "label": "Columns (Desktop)",
      "default": 4
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 42
    },
    {
      "type": "header",
      "content": "Japandi Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#F5F2EB"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Product Image Background",
      "default": "#EAE6DF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2C2A28"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "badge_text",
          "label": "Badge Text (e.g. Bestseller)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP26 - Japandi Bestsell",
      "blocks": [
        { "type": "product", "settings": { "badge_text": "Iconic" } },
        { "type": "product" },
        { "type": "product" },
        { "type": "product", "settings": { "badge_text": "New" } },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
