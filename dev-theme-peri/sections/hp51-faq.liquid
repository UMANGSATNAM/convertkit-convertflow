{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp51-faq-bg: {{ section.settings.bg_color | default: '#F2EFE9' }};
    --hp51-matcha: {{ section.settings.accent_matcha | default: '#2D5A3D' }};
    
    background-color: var(--hp51-faq-bg);
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }

  .hp51-faq__wrap {
    max-width: {{ section.settings.container_width | default: 860 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp51-faq__header {
    text-align: center;
    margin-bottom: 45px;
  }

  .hp51-faq__heading {
    font-family: 'Noto Serif JP', serif;
    font-size: clamp(32px, 4.5vw, 44px);
    font-weight: 700;
    color: #1E3A2B;
    margin: 0 0 8px;
  }

  .hp51-faq__item {
    background: #FAF8F5;
    border: 1px solid rgba(30, 58, 43, 0.12);
    border-radius: 16px;
    padding: 24px 28px;
    margin-bottom: 16px;
    box-shadow: 0 4px 16px rgba(30, 58, 43, 0.03);
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .hp51-faq__item:hover { border-color: var(--hp51-matcha); }

  .hp51-faq__q {
    font-family: 'DM Sans', sans-serif;
    font-size: 16px;
    font-weight: 700;
    color: #1E3A2B;
    margin: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .hp51-faq__a {
    font-size: 15px;
    line-height: 1.8;
    color: #4A5B50;
    margin: 14px 0 0;
    padding-top: 14px;
    border-top: 1px solid rgba(30, 58, 43, 0.1);
  }
{%- endstyle -%}

<div class="hp51-faq__wrap">
  <div class="hp51-faq__header">
    <h2 class="hp51-faq__heading">{{ section.settings.heading | default: 'Tea Master Inquiries' }}</h2>
    <p style="font-size:14px; color:#4A5B50;">{{ section.settings.subheading | default: 'Everything you need to know about our Kyoto harvest, EGCG potency, and shipping.' }}</p>
  </div>

  {%- if section.blocks.size > 0 -%}
    {%- for block in section.blocks -%}
      <div class="hp51-faq__item" {{ block.shopify_attributes }}>
        <h3 class="hp51-faq__q">
          <span>{{ block.settings.question }}</span>
          <span>+</span>
        </h3>
        <p class="hp51-faq__a">{{ block.settings.answer }}</p>
      </div>
    {%- endfor -%}
  {%- else -%}
    <div class="hp51-faq__item">
      <h3 class="hp51-faq__q"><span>Why is ceremonial grade matcha better for skincare?</span><span>+</span></h3>
      <p class="hp51-faq__a">Ceremonial grade matcha is shade-grown and harvested from the youngest spring tea leaves, containing over 137x the antioxidant concentration of standard green tea extract.</p>
    </div>
    <div class="hp51-faq__item">
      <h3 class="hp51-faq__q"><span>Is the formula suitable for sensitive or rosacea-prone skin?</span><span>+</span></h3>
      <p class="hp51-faq__a">Yes, the high concentration of natural L-theanine and organic bamboo silica actively cools and calms facial redness and barrier reactivity.</p>
    </div>
    <div class="hp51-faq__item">
      <h3 class="hp51-faq__q"><span>How quickly are international orders dispatched?</span><span>+</span></h3>
      <p class="hp51-faq__a">Orders are dispatched within 24 hours via express courier with 100% pre-paid customs clearance and zero hidden doorstep tariffs.</p>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "HP51 - Zen FAQ",
  "class": "section-hp51-faq",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#F2EFE9" },
    { "type": "color", "id": "accent_matcha", "label": "Matcha Accent", "default": "#2D5A3D" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Tea Master Inquiries" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Everything you need to know about our Kyoto harvest, EGCG potency, and shipping." },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 600, "max": 1200, "step": 20, "unit": "px", "label": "Container Width", "default": 860 }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Why is ceremonial grade matcha better for skincare?" },
        { "type": "textarea", "id": "answer", "label": "Answer", "default": "Ceremonial grade matcha is shade-grown." }
      ]
    }
  ],
  "presets": [
    { "name": "HP51 - Zen FAQ" }
  ]
}
{% endschema %}
