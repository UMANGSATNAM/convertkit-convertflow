{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp46-fc-bg: {{ section.settings.bg_color | default: '#0B0F19' }};
    
    background-color: var(--hp46-fc-bg);
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
  }

  .hp46-fc__wrapper {
    max-width: {{ section.settings.container_width | default: 1280 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp46-fc__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 40px;
  }

  .hp46-fc__heading {
    font-family: 'Syne', sans-serif;
    font-size: clamp(28px, 4vw, 42px);
    font-weight: 800;
    color: #FFFFFF;
    margin: 0;
  }

  .hp46-fc__heading span {
    background: linear-gradient(135deg, #38BDF8 0%, #F472B6 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hp46-fc__view-all {
    color: #38BDF8;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .hp46-fc__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: 4 }}, 1fr);
    gap: 24px;
  }

  .hp46-card {
    background: rgba(15, 23, 42, 0.65);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(56, 189, 248, 0.2);
    border-radius: 24px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
    transition: all 0.3s ease;
  }

  .hp46-card:hover {
    border-color: #F472B6;
    transform: translateY(-6px);
    box-shadow: 0 18px 40px rgba(244, 114, 182, 0.2);
  }

  .hp46-card__media {
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    position: relative;
    background: #0F172A;
  }

  .hp46-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .hp46-card:hover .hp46-card__img { transform: scale(1.05); }

  .hp46-card__badge {
    position: absolute;
    top: 12px; left: 12px;
    background: linear-gradient(135deg, #38BDF8, #F472B6);
    color: #0B0F19;
    font-size: 11px;
    font-weight: 800;
    padding: 4px 10px;
    border-radius: 50px;
  }

  .hp46-card__body {
    padding: 22px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .hp46-card__tag {
    font-size: 11px;
    font-weight: 700;
    color: #38BDF8;
    text-transform: uppercase;
    margin: 0 0 6px;
  }

  .hp46-card__title {
    font-family: 'Syne', sans-serif;
    font-size: 17px;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0 0 10px;
  }

  .hp46-card__price {
    font-size: 16px;
    font-weight: 700;
    color: #F472B6;
    margin-bottom: 16px;
  }

  .hp46-card__btn {
    width: 100%;
    margin-top: auto;
    padding: 13px;
    background: linear-gradient(135deg, #38BDF8 0%, #F472B6 100%);
    color: #0B0F19;
    border: none;
    border-radius: 50px;
    font-family: 'Syne', sans-serif;
    font-size: 13px;
    font-weight: 800;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .hp46-card__btn:hover {
    box-shadow: 0 0 20px rgba(56, 189, 248, 0.6);
  }

  @media screen and (max-width: 992px) {
    .hp46-fc__grid { grid-template-columns: repeat(2, 1fr); gap: 16px; }
  }
{%- endstyle -%}

<div class="hp46-fc__wrapper">
  <div class="hp46-fc__header">
    <h2 class="hp46-fc__heading">{{ section.settings.heading | default: 'HOLOGRAPHIC <span>BIO-DROPS</span>' }}</h2>
    <a href="{{ section.settings.view_all_url | default: '/collections/all' }}" class="hp46-fc__view-all">
      {{ section.settings.view_all_text | default: 'Explore All Formulas &rarr;' }}
    </a>
  </div>

  <div class="hp46-fc__grid">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <div class="hp46-card" {{ block.shopify_attributes }}>
          <div class="hp46-card__media">
            {%- if block.settings.badge != blank -%}
              <span class="hp46-card__badge">{{ block.settings.badge }}</span>
            {%- endif -%}
            {%- if block.settings.image != blank -%}
              <img height="{{ block.settings.image.height }}" width="{{ block.settings.image.width }}" src="{{ block.settings.image | image_url: width: 600 }}" class="hp46-card__img" alt="{{ block.settings.title }}" loading="lazy">
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'hp46-card__img' }}
            {%- endif -%}
          </div>
          <div class="hp46-card__body">
            <span class="hp46-card__tag">{{ block.settings.tag | default: 'CYBER-ACTIVE' }}</span>
            <h3 class="hp46-card__title">{{ block.settings.title }}</h3>
            <div class="hp46-card__price">{{ block.settings.price | default: '$68.00 USD' }}</div>
            <button class="hp46-card__btn">{{ block.settings.btn_text | default: 'ACQUIRE DROP' }}</button>
          </div>
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="hp46-card">
        <div class="hp46-card__media">
          <span class="hp46-card__badge">TOP DROP</span>
          {{ 'product-1' | placeholder_svg_tag: 'hp46-card__img' }}
        </div>
        <div class="hp46-card__body">
          <span class="hp46-card__tag">LUMINESCENCE</span>
          <h3 class="hp46-card__title">HOLOGRAPHIC ENZYME SERUM</h3>
          <div class="hp46-card__price">$68.00 USD</div>
          <button class="hp46-card__btn">ACQUIRE DROP</button>
        </div>
      </div>
      <div class="hp46-card">
        <div class="hp46-card__media">
          <span class="hp46-card__badge">NEW FORMULA</span>
          {{ 'product-1' | placeholder_svg_tag: 'hp46-card__img' }}
        </div>
        <div class="hp46-card__body">
          <span class="hp46-card__tag">BARRIER DEFENSE</span>
          <h3 class="hp46-card__title">NEON PEPTIDE GLAZE BALM</h3>
          <div class="hp46-card__price">$54.00 USD</div>
          <button class="hp46-card__btn">ACQUIRE DROP</button>
        </div>
      </div>
      <div class="hp46-card">
        <div class="hp46-card__media">
          {{ 'product-1' | placeholder_svg_tag: 'hp46-card__img' }}
        </div>
        <div class="hp46-card__body">
          <span class="hp46-card__tag">HYDRATION LOCK</span>
          <h3 class="hp46-card__title">CYBER SHIELD ESSENCE MIST</h3>
          <div class="hp46-card__price">$42.00 USD</div>
          <button class="hp46-card__btn">ACQUIRE DROP</button>
        </div>
      </div>
      <div class="hp46-card">
        <div class="hp46-card__media">
          <span class="hp46-card__badge">VIRAL HIT</span>
          {{ 'product-1' | placeholder_svg_tag: 'hp46-card__img' }}
        </div>
        <div class="hp46-card__body">
          <span class="hp46-card__tag">CRYOGENIC GLOW</span>
          <h3 class="hp46-card__title">BIO-LUMINESCENT JELLY MASK</h3>
          <div class="hp46-card__price">$60.00 USD</div>
          <button class="hp46-card__btn">ACQUIRE DROP</button>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP46 - Cyber Grid",
  "class": "section-hp46-grid",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#0B0F19" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "HOLOGRAPHIC BIO-DROPS" },
    { "type": "text", "id": "view_all_text", "label": "View All Text", "default": "Explore All Formulas →" },
    { "type": "url", "id": "view_all_url", "label": "View All URL" },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "label": "Desktop Columns", "default": 4 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 80 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "badge", "label": "Badge", "default": "TOP DROP" },
        { "type": "text", "id": "tag", "label": "Tag", "default": "LUMINESCENCE" },
        { "type": "text", "id": "title", "label": "Title", "default": "HOLOGRAPHIC ENZYME SERUM" },
        { "type": "text", "id": "price", "label": "Price", "default": "$68.00 USD" },
        { "type": "text", "id": "btn_text", "label": "Button Text", "default": "ACQUIRE DROP" },
        { "type": "url", "id": "url", "label": "Link URL" }
      ]
    }
  ],
  "presets": [
    { "name": "HP46 - Cyber Grid" }
  ]
}
{% endschema %}
