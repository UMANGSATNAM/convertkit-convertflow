{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@300;400;500&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --font-heading: 'Lora', serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    overflow: hidden;
    position: relative;
    border-top: 1px solid rgba(0,0,0,0.05);
    border-bottom: 1px solid rgba(0,0,0,0.05);
  }

  .hp29-marquee-wrapper {
    display: flex;
    white-space: nowrap;
    width: 100vw;
  }

  .hp29-marquee__content {
    display: flex;
    align-items: center;
    gap: 40px;
    padding-right: 40px;
    animation: hp29MarqueeScroll {{ section.settings.scroll_speed }}s linear infinite;
  }

  @keyframes hp29MarqueeScroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-100%); }
  }

  .hp29-marquee__item {
    display: flex;
    align-items: center;
    gap: 40px;
  }

  .hp29-marquee__text {
    font-family: var(--font-heading);
    font-size: clamp(24px, 3vw, {{ section.settings.text_size }}px);
    font-weight: 400;
    font-style: italic;
    color: var(--text-color);
    margin: 0;
    letter-spacing: 0.05em;
  }

  .hp29-marquee__icon {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background-color: var(--text-color);
    opacity: 0.4;
  }

  /* Optional hover pause */
  {%- if section.settings.pause_on_hover -%}
  #shopify-section-{{ section.id }}:hover .hp29-marquee__content {
    animation-play-state: paused;
  }
  {%- endif -%}

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp29-marquee-wrapper" id="HP29Marquee-{{ section.id }}">
  {%- assign loop_count = 6 -%}
  {%- for i in (1..loop_count) -%}
    <div class="hp29-marquee__content" aria-hidden="{% if forloop.index > 1 %}true{% else %}false{% endif %}">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <div class="hp29-marquee__item" {{ block.shopify_attributes }}>
            <span class="hp29-marquee__text">{{ block.settings.text }}</span>
            <div class="hp29-marquee__icon"></div>
          </div>
        {%- endfor -%}
      {%- else -%}
        <div class="hp29-marquee__item">
          <span class="hp29-marquee__text">Ethically Sourced</span>
          <div class="hp29-marquee__icon"></div>
        </div>
        <div class="hp29-marquee__item">
          <span class="hp29-marquee__text">Mindfully Made</span>
          <div class="hp29-marquee__icon"></div>
        </div>
        <div class="hp29-marquee__item">
          <span class="hp29-marquee__text">Designed for Life</span>
          <div class="hp29-marquee__icon"></div>
        </div>
      {%- endif -%}
    </div>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "HP29 - Boho Marquee",
  "class": "section-hp29-marquee",
  "settings": [
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 16,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Text Size",
      "default": 32
    },
    {
      "type": "header",
      "content": "Earthy Boho Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (Sage Green)",
      "default": "#81B29A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text (Beige/Sand)",
      "default": "#F4F1DE"
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "range",
      "id": "scroll_speed",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "s",
      "label": "Scroll Speed",
      "default": 30
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on Hover",
      "default": true
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 30
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text Block",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Ethically Sourced"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP29 - Boho Marquee",
      "blocks": [
        { "type": "text", "settings": { "text": "Sustainable Materials" } },
        { "type": "text", "settings": { "text": "Conscious Design" } },
        { "type": "text", "settings": { "text": "Timeless Silhouettes" } }
      ]
    }
  ]
}
{% endschema %}
