{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Shrikhand&family=DM+Sans:wght@400;500;700&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --pill-bg: {{ section.settings.pill_bg }};
    --accent-color: {{ section.settings.accent_color }};
    
    --font-heading: 'Shrikhand', cursive;
    --font-body: 'DM Sans', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .hp37-pills-wrapper {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 20px;
  }

  @media screen and (max-width: 768px) {
    .hp37-pills-wrapper {
      padding: 0 20px;
      gap: 15px;
    }
  }

  .hp37-pill {
    display: inline-flex;
    align-items: center;
    padding: 15px 30px;
    background: var(--pill-bg);
    border: 3px solid var(--text-color);
    border-radius: 50px;
    text-decoration: none;
    box-shadow: 4px 4px 0px var(--text-color);
    transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.3s ease;
  }

  .hp37-pill:hover {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0px var(--text-color);
    background: var(--accent-color);
  }

  .hp37-pill__text {
    font-family: var(--font-heading);
    font-size: 20px;
    color: var(--text-color);
    margin-right: 15px;
  }

  .hp37-pill__icon {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: 2px solid var(--text-color);
    overflow: hidden;
    background: #fff;
  }
  
  .hp37-pill__icon img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    mix-blend-mode: multiply;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp37-pills-wrapper" id="HP37Pills-{{ section.id }}">
  {%- for block in section.blocks -%}
    <a href="{{ block.settings.link | default: '#' }}" class="hp37-pill" {{ block.shopify_attributes }}>
      <span class="hp37-pill__text">{{ block.settings.title }}</span>
      {%- if block.settings.image != blank -%}
        <div class="hp37-pill__icon">
          <img height="{{ block.settings.image.height }}" width="{{ block.settings.image.width }}" src="{{ block.settings.image | image_url: width: 60 }}" alt="{{ block.settings.title | escape }}" loading="lazy">
        </div>
      {%- endif -%}
    </a>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "HP37 - Retro Pills",
  "class": "section-hp37-category-pills",
  "settings": [
    {
      "type": "header",
      "content": "Retro Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#F4E3C5"
    },
    {
      "type": "color",
      "id": "pill_bg",
      "label": "Pill Background",
      "default": "#798A58"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#4A3219"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Hover Accent Color",
      "default": "#D96C4A"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 40
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Pill",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Tops"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Small Icon Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP37 - Retro Pills",
      "blocks": [
        { "type": "category", "settings": { "title": "Tops" } },
        { "type": "category", "settings": { "title": "Bottoms" } },
        { "type": "category", "settings": { "title": "Accessories" } },
        { "type": "category", "settings": { "title": "Surf" } },
        { "type": "category", "settings": { "title": "Sale" } }
      ]
    }
  ]
}
{% endschema %}
