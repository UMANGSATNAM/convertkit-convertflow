{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@300;400;500&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    
    --font-heading: 'Lora', serif;
    --font-body: 'Inter', sans-serif;
    
    background-color: var(--bg-color); /* Usually same as page BG */
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.8 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.8 | round }}px;
    }
  }

  .hp29-offer-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp29-offer-wrapper {
      padding: 0 20px;
    }
  }

  .hp29-offer__container {
    background-color: var(--accent-color);
    border-radius: 40px 100px 40px 100px;
    padding: 80px 40px;
    text-align: center;
    position: relative;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(224, 122, 95, 0.15); /* Terracotta soft shadow */
  }

  @media screen and (max-width: 768px) {
    .hp29-offer__container {
      padding: 60px 20px;
      border-radius: 30px 60px 30px 60px;
    }
  }

  /* Decorative organic SVG in BG */
  .hp29-offer__bg-shape {
    position: absolute;
    top: -20%; right: -10%;
    width: 60%; height: 140%;
    opacity: 0.05;
    pointer-events: none;
    z-index: 1;
    transform: rotate(15deg);
  }
  .hp29-offer__bg-shape svg {
    width: 100%; height: 100%;
    fill: var(--text-color);
  }

  .hp29-offer__content {
    position: relative;
    z-index: 2;
    max-width: 700px;
    margin: 0 auto;
  }

  .hp29-offer__badge {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-color);
    margin-bottom: 20px;
    border-bottom: 1px solid var(--text-color);
    padding-bottom: 4px;
    opacity: 0.9;
  }

  .hp29-offer__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    font-weight: 400;
    line-height: 1.2;
    color: var(--text-color);
    margin: 0 0 20px;
  }
  
  .hp29-offer__title em {
    font-style: italic;
  }

  .hp29-offer__text {
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 300;
    line-height: 1.6;
    color: var(--text-color);
    opacity: 0.85;
    margin: 0 0 40px;
  }

  .hp29-offer__btn {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    padding: 16px 40px;
    border-radius: 30px;
    background: var(--text-color);
    color: var(--accent-color);
    transition: transform 0.4s cubic-bezier(0.25, 1, 0.5, 1), box-shadow 0.4s ease;
  }

  .hp29-offer__btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 20px rgba(0,0,0,0.1);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp29-offer-wrapper" id="HP29Offer-{{ section.id }}">
  <div class="hp29-offer__container">
    
    <div class="hp29-offer__bg-shape">
      <!-- Simple organic blob SVG -->
      <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
        <path d="M44.7,-76.4C58.9,-69.2,71.8,-59.1,79.6,-45.8C87.4,-32.6,90.1,-16.3,89.1,-0.6C88.1,15.1,83.4,30.2,74.5,42.5C65.5,54.8,52.3,64.4,37.8,71.4C23.3,78.4,7.5,82.8,-7.7,82.4C-23,82,-37.6,76.8,-51.1,68.9C-64.6,61,-76.9,50.3,-84.3,36.5C-91.8,22.6,-94.3,5.6,-91.3,-10.5C-88.3,-26.5,-79.8,-41.7,-68.2,-53.4C-56.5,-65.2,-41.8,-73.4,-27.1,-77.2C-12.4,-81,2.8,-80.4,17.4,-77C32.1,-73.6,30.5,-83.5,44.7,-76.4Z" transform="translate(100 100)" />
      </svg>
    </div>

    <div class="hp29-offer__content">
      {%- if section.settings.badge != blank -%}
        <div class="hp29-offer__badge">{{ section.settings.badge }}</div>
      {%- endif -%}

      {%- if section.settings.title != blank -%}
        <h2 class="hp29-offer__title">{{ section.settings.title }}</h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="hp29-offer__text">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if section.settings.btn_text != blank -%}
        <a href="{{ section.settings.btn_link | default: '#' }}" class="hp29-offer__btn">
          {{ section.settings.btn_text }}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "HP29 - Boho Offer Banner",
  "class": "section-hp29-offer-banner",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "default": "LIMITED TIME"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Heading",
      "default": "Enjoy 15% off your <em>first</em> mindful purchase."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Sign up to our journal to receive exclusive offers, new arrivals, and mindful living inspiration directly to your inbox.</p>"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "Claim Offer"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 800,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1200
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 72,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 48
    },
    {
      "type": "header",
      "content": "Earthy Boho Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Page Background",
      "default": "#F4F1DE"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Banner Background (Terracotta)",
      "default": "#E07A5F"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text & Button — must contrast the Banner Background",
      "info": "This text sits on the Banner Background (terracotta), not on the Page Background. Keep it light if the banner is dark.",
      "default": "#F4F1DE"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP29 - Boho Offer Banner"
    }
  ]
}
{% endschema %}
