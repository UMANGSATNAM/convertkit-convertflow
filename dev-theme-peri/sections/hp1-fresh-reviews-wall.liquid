{%- liquid
  assign bg_color = section.settings.bg_color | default: '#FFFFFF'
  assign text_color = section.settings.text_color | default: '#1C1917'
-%}

<section class="hp1-fresh-reviews" style="--bg: {{ bg_color }}; --text: {{ text_color }};">
  <div class="hp1-fresh-reviews__container">
    
    <!-- Section Header -->
    <div class="hp1-fresh-reviews__header">
      <div class="hp1-fresh-reviews__score-badge">
        <span class="hp1-fresh-reviews__score">4.9 / 5.0</span>
        <div class="hp1-fresh-reviews__stars">★★★★★</div>
        <span class="hp1-fresh-reviews__count">Based on 14,200+ Verified Customer Reviews</span>
      </div>
      <h2 class="hp1-fresh-reviews__title">Read Real Customer Experiences</h2>
    </div>

    <!-- Review Grid -->
    <div class="hp1-fresh-reviews__grid">
      
      <!-- Review 1 -->
      <div class="hp1-fresh-review-card">
        <div class="hp1-fresh-review-card__header">
          <div class="hp1-fresh-review-card__user">
            <div class="hp1-fresh-review-card__avatar">SM</div>
            <div>
              <strong>Sarah Jenkins</strong>
              <span class="hp1-fresh-review-card__verified">✓ Verified Buyer</span>
            </div>
          </div>
          <span class="hp1-fresh-review-card__stars">★★★★★</span>
        </div>
        <h3 class="hp1-fresh-review-card__heading">"Completely saved my compromised skin barrier!"</h3>
        <p class="hp1-fresh-review-card__body">
          I had severe redness and flaking after over-exfoliating. After using the Barrier Glow Serum for just 5 days, my skin felt completely calm, hydrated, and dewy. I will never be without this product.
        </p>
        <span class="hp1-fresh-review-card__product-name">Purchased: Barrier Glow Serum</span>
      </div>

      <!-- Review 2 -->
      <div class="hp1-fresh-review-card">
        <div class="hp1-fresh-review-card__header">
          <div class="hp1-fresh-review-card__user">
            <div class="hp1-fresh-review-card__avatar">MD</div>
            <div>
              <strong>Michelle D.</strong>
              <span class="hp1-fresh-review-card__verified">✓ Verified Buyer</span>
            </div>
          </div>
          <span class="hp1-fresh-review-card__stars">★★★★★</span>
        </div>
        <h3 class="hp1-fresh-review-card__heading">"Best oil cleanser I have ever tried."</h3>
        <p class="hp1-fresh-review-card__body">
          Melts off all my waterproof mascara without stinging my eyes or leaving a greasy film. My face feels clean yet soft and moisturized. 10/10 recommendation!
        </p>
        <span class="hp1-fresh-review-card__product-name">Purchased: Velvet Oil Cleanser</span>
      </div>

      <!-- Review 3 -->
      <div class="hp1-fresh-review-card">
        <div class="hp1-fresh-review-card__header">
          <div class="hp1-fresh-review-card__user">
            <div class="hp1-fresh-review-card__avatar">AL</div>
            <div>
              <strong>Amanda Lee</strong>
              <span class="hp1-fresh-review-card__verified">✓ Verified Buyer</span>
            </div>
          </div>
          <span class="hp1-fresh-review-card__stars">★★★★★</span>
        </div>
        <h3 class="hp1-fresh-review-card__heading">"The 3-Step Routine is a total game changer."</h3>
        <p class="hp1-fresh-review-card__body">
          Getting the 3-step bundle was the best decision. My skin has an effortless glass-like glow without feeling heavy under makeup. Plus the free Rose Quartz roller was such a lovely bonus!
        </p>
        <span class="hp1-fresh-review-card__product-name">Purchased: 3-Step Routine Bundle</span>
      </div>

    </div>
  </div>
</section>

<style>
  .hp1-fresh-reviews {
    background-color: var(--bg);
    color: var(--text);
    padding: 96px 24px;
    font-family: 'Plus Jakarta Sans', sans-serif;
  }
  .hp1-fresh-reviews__container {
    max-width: 1280px;
    margin: 0 auto;
  }

  .hp1-fresh-reviews__header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 56px;
  }
  .hp1-fresh-reviews__score-badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    margin-bottom: 16px;
  }
  .hp1-fresh-reviews__score {
    font-size: 32px;
    font-weight: 800;
    font-family: 'Playfair Display', serif;
  }
  .hp1-fresh-reviews__stars {
    color: #F59E0B;
    font-size: 20px;
    letter-spacing: 3px;
  }
  .hp1-fresh-reviews__count {
    font-size: 13px;
    color: rgba(28, 25, 23, 0.6);
  }
  .hp1-fresh-reviews__title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(28px, 3.5vw, 36px);
    font-weight: 700;
    margin: 0;
  }

  .hp1-fresh-reviews__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }
  @media (max-width: 991px) {
    .hp1-fresh-reviews__grid { grid-template-columns: 1fr; }
  }

  .hp1-fresh-review-card {
    background: #FAF9F6;
    border-radius: 24px;
    padding: 32px;
    border: 1px solid rgba(28, 25, 23, 0.08);
    display: flex;
    flex-direction: column;
  }
  .hp1-fresh-review-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
  }
  .hp1-fresh-review-card__user {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .hp1-fresh-review-card__avatar {
    width: 40px;
    height: 40px;
    background: #D97706;
    color: #FFF;
    font-weight: 700;
    font-size: 14px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .hp1-fresh-review-card__user strong {
    display: block;
    font-size: 14px;
    color: #1C1917;
  }
  .hp1-fresh-review-card__verified {
    font-size: 11px;
    color: #059669;
    font-weight: 600;
  }
  .hp1-fresh-review-card__stars {
    color: #F59E0B;
    font-size: 14px;
    letter-spacing: 1px;
  }

  .hp1-fresh-review-card__heading {
    font-family: 'Playfair Display', serif;
    font-size: 18px;
    font-weight: 600;
    margin: 0 0 12px 0;
    line-height: 1.3;
  }
  .hp1-fresh-review-card__body {
    font-size: 14px;
    line-height: 1.6;
    color: rgba(28, 25, 23, 0.75);
    margin: 0 0 20px 0;
    flex-grow: 1;
  }
  .hp1-fresh-review-card__product-name {
    font-size: 12px;
    font-weight: 600;
    color: rgba(28, 25, 23, 0.5);
    border-top: 1px solid rgba(28, 25, 23, 0.08);
    padding-top: 12px;
  }
</style>

{% schema %}
{
  "name": "HP1 Fresh - Reviews Wall",
  "tag": "section",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#1C1917" }
  ],
  "presets": [
    { "name": "HP1 Fresh - Reviews Wall" }
  ]
}
{% endschema %}
