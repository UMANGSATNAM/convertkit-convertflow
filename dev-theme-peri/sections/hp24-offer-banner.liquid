{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Orbitron:wght@400;700;900&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-primary: {{ section.settings.accent_primary }};
    --accent-secondary: {{ section.settings.accent_secondary }};
    --font-heading: 'Orbitron', sans-serif;
    --font-body: 'Share Tech Mono', monospace;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    position: relative;
    overflow: hidden;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }

  /* Warning stripe background */
  #shopify-section-{{ section.id }}::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: repeating-linear-gradient(
      -45deg,
      rgba(0,0,0,0.8),
      rgba(0,0,0,0.8) 20px,
      rgba(0,0,0,0.9) 20px,
      rgba(0,0,0,0.9) 40px
    );
    z-index: 0;
  }

  .hp24-offer-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media screen and (max-width: 768px) {
    .hp24-offer-wrapper {
      padding: 0 20px;
    }
  }

  .hp24-offer__box {
    width: 100%;
    background: rgba(0,0,0,0.7);
    border: 2px solid var(--accent-primary);
    box-shadow: 0 0 30px rgba(0, 243, 255, 0.2), inset 0 0 20px rgba(0, 243, 255, 0.1);
    padding: 60px 40px;
    text-align: center;
    position: relative;
    backdrop-filter: blur(10px);
  }
  
  /* Danger cut corners */
  .hp24-offer__box {
    clip-path: polygon(
      30px 0, 
      100% 0, 
      100% calc(100% - 30px), 
      calc(100% - 30px) 100%, 
      0 100%, 
      0 30px
    );
  }

  @media screen and (max-width: 768px) {
    .hp24-offer__box {
      padding: 40px 20px;
    }
  }

  .hp24-offer__alert {
    display: inline-block;
    background: var(--accent-secondary);
    color: var(--bg-color);
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 700;
    padding: 5px 15px;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 20px;
    animation: alertBlink 2s infinite;
  }

  @keyframes alertBlink {
    0%, 49% { background: var(--accent-secondary); color: var(--bg-color); }
    50%, 100% { background: transparent; color: var(--accent-secondary); border: 1px solid var(--accent-secondary); }
  }

  .hp24-offer__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    font-weight: 900;
    color: var(--text-color);
    margin: 0 0 20px;
    text-transform: uppercase;
    letter-spacing: 2px;
    text-shadow: 2px 2px 0 var(--accent-primary), -2px -2px 0 var(--accent-secondary);
  }
  
  .hp24-offer__title:hover {
    animation: textGlitch 0.2s linear infinite;
  }
  
  @keyframes textGlitch {
    0% { transform: translate(0) }
    20% { transform: translate(-2px, 2px) }
    40% { transform: translate(-2px, -2px) }
    60% { transform: translate(2px, 2px) }
    80% { transform: translate(2px, -2px) }
    100% { transform: translate(0) }
  }

  .hp24-offer__text {
    font-family: var(--font-body);
    font-size: clamp(16px, 2vw, 20px);
    font-weight: 700;
    color: var(--text-color);
    margin: 0 0 40px;
    opacity: 0.9;
  }

  .hp24-offer__btn {
    font-family: var(--font-heading);
    display: inline-flex;
    align-items: center;
    padding: 15px 40px;
    background: var(--accent-primary);
    color: var(--bg-color);
    font-size: 18px;
    font-weight: 900;
    text-transform: uppercase;
    text-decoration: none;
    letter-spacing: 2px;
    transition: all 0.3s ease;
    box-shadow: 0 0 20px rgba(0, 243, 255, 0.4);
    position: relative;
    overflow: hidden;
  }

  .hp24-offer__btn:hover {
    background: transparent;
    color: var(--accent-primary);
    border: 1px solid var(--accent-primary);
    box-shadow: 0 0 30px rgba(0, 243, 255, 0.6);
  }

  .hp24-offer__btn::after {
    content: '';
    position: absolute;
    top: 0; left: -100%; width: 100%; height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.5), transparent);
    transition: left 0.5s ease;
  }

  .hp24-offer__btn:hover::after {
    left: 100%;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp24-offer-wrapper" id="HP24Offer-{{ section.id }}">
  <div class="hp24-offer__box">
    
    <div class="hp24-offer__alert">SYSTEM OVERRIDE // DISCOUNT DETECTED</div>

    {%- if section.settings.title != blank -%}
      <h2 class="hp24-offer__title">{{ section.settings.title }}</h2>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="hp24-offer__text">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- if section.settings.btn_text != blank -%}
      <a href="{{ section.settings.btn_link | default: '#' }}" class="hp24-offer__btn">
        {{ section.settings.btn_text | escape }}
      </a>
    {%- endif -%}
    
  </div>
</div>

{% schema %}
{
  "name": "HP24 - Cyber Offer",
  "class": "section-hp24-offer-banner",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "UPGRADE PROTOCOL: 20% OFF"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Body Text",
      "default": "<p>Enter code <strong>CYBER20</strong> at checkout to bypass standard pricing limits.</p>"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "EXECUTE OVERRIDE"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 800,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1200
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 32,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 56
    },
    {
      "type": "header",
      "content": "Cyberpunk Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "accent_primary",
      "label": "Accent Primary (Neon Blue)",
      "default": "#00F3FF"
    },
    {
      "type": "color",
      "id": "accent_secondary",
      "label": "Accent Secondary (Neon Pink)",
      "default": "#FF00E6"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP24 - Cyber Offer"
    }
  ]
}
{% endschema %}
