{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,100..900;1,9..144,100..900&family=Outfit:wght@300;400;600;800&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-orange: {{ section.settings.accent_orange }};
    --accent-yellow: {{ section.settings.accent_yellow }};
    --accent-green: {{ section.settings.accent_green }};
    --font-heading: 'Fraunces', serif;
    --font-body: 'Outfit', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    position: relative;
    /* Subtle grainy texture */
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.03'/%3E%3C/svg%3E");
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }

  .hp25-bestsellers-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
    position: relative;
    z-index: 1;
  }

  @media screen and (max-width: 768px) {
    .hp25-bestsellers-wrapper {
      padding: 0 20px;
    }
  }

  .hp25-bestsellers__header {
    text-align: center;
    margin-bottom: {{ section.settings.header_margin }}px;
  }

  .hp25-bestsellers__title {
    font-family: var(--font-heading);
    font-size: clamp(36px, 5vw, {{ section.settings.title_size }}px);
    font-weight: 900;
    font-style: italic;
    color: var(--text-color);
    margin: 0 0 15px;
    line-height: 1.1;
    letter-spacing: -0.02em;
    /* 3D shadow effect */
    text-shadow: 2px 2px 0 var(--accent-orange), 4px 4px 0 var(--text-color);
  }

  .hp25-bestsellers__desc {
    font-family: var(--font-body);
    font-size: 18px;
    color: var(--text-color);
    max-width: 600px;
    margin: 0 auto;
    font-weight: 600;
  }

  .hp25-bestsellers__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: 30px;
  }

  @media screen and (max-width: 992px) {
    .hp25-bestsellers__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 600px) {
    .hp25-bestsellers__grid {
      display: flex;
      flex-wrap: nowrap;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-bottom: 20px;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .hp25-bestsellers__grid::-webkit-scrollbar {
      display: none;
    }
  }

  .hp25-bestsellers__card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    background: var(--accent-yellow);
    border: 4px solid var(--text-color);
    border-radius: 30px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    box-shadow: 8px 8px 0 var(--accent-orange);
  }

  @media screen and (max-width: 600px) {
    .hp25-bestsellers__card {
      flex: 0 0 85%;
      scroll-snap-align: center;
    }
  }

  .hp25-bestsellers__card:hover {
    transform: translate(2px, 2px);
    box-shadow: 4px 4px 0 var(--text-color);
  }

  .hp25-bestsellers__image-wrapper {
    width: 100%;
    aspect-ratio: {{ section.settings.image_aspect_ratio }};
    position: relative;
    border-bottom: 4px solid var(--text-color);
    overflow: hidden;
    background: #fff;
  }

  .hp25-bestsellers__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
    filter: sepia(0.15) saturate(1.2);
  }

  .hp25-bestsellers__card:hover .hp25-bestsellers__image {
    transform: scale(1.05);
  }

  .hp25-bestsellers__badge {
    position: absolute;
    top: 15px;
    right: -25px;
    background: var(--text-color);
    color: var(--bg-color);
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 800;
    padding: 8px 30px;
    text-transform: uppercase;
    transform: rotate(45deg);
    z-index: 2;
    border: 2px solid var(--accent-yellow);
  }

  .hp25-bestsellers__info {
    padding: 20px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    align-items: center;
    text-align: center;
    background: var(--accent-yellow);
  }

  .hp25-bestsellers__card-title {
    font-family: var(--font-heading);
    font-size: 24px;
    font-weight: 800;
    color: var(--text-color);
    margin: 0 0 10px;
    line-height: 1.2;
  }

  .hp25-bestsellers__price-wrapper {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 20px;
  }

  .hp25-bestsellers__price {
    font-family: var(--font-body);
    font-size: 20px;
    font-weight: 800;
    color: var(--text-color);
  }

  .hp25-bestsellers__compare-price {
    font-size: 16px;
    color: var(--text-color);
    opacity: 0.7;
    text-decoration: line-through;
  }

  .hp25-bestsellers__btn {
    display: block;
    width: 100%;
    padding: 12px;
    background-color: var(--accent-orange);
    color: var(--bg-color);
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 800;
    text-transform: uppercase;
    border: 3px solid var(--text-color);
    border-radius: 50px;
    cursor: pointer;
    box-shadow: 4px 4px 0 var(--text-color);
    transition: all 0.3s ease;
    margin-top: auto;
  }

  .hp25-bestsellers__card:hover .hp25-bestsellers__btn {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0 var(--text-color);
    background-color: var(--bg-color);
    color: var(--text-color);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp25-bestsellers-wrapper" id="HP25Bestsellers-{{ section.id }}">
  
  <div class="hp25-bestsellers__header">
    {%- if section.settings.title != blank -%}
      <h2 class="hp25-bestsellers__title">{{ section.settings.title }}</h2>
    {%- endif -%}
    {%- if section.settings.description != blank -%}
      <p class="hp25-bestsellers__desc">{{ section.settings.description }}</p>
    {%- endif -%}
  </div>

  <div class="hp25-bestsellers__grid">
    {%- assign collection = section.settings.collection -%}
    {%- assign limit = section.settings.limit -%}
    
    {%- if collection != blank and collection.products_count > 0 -%}
      {%- for product in collection.products limit: limit -%}
        <a href="{{ product.url }}" class="hp25-bestsellers__card" {{ block.shopify_attributes }}>
          <div class="hp25-bestsellers__image-wrapper">
            {%- if forloop.index <= 2 -%}
              <div class="hp25-bestsellers__badge">HOT</div>
            {%- endif -%}
            
            <img 
              src="{{ product.featured_image | image_url: width: 600 }}" 
              alt="{{ product.title | escape }}"
              class="hp25-bestsellers__image"
              loading="lazy"
            >
          </div>

          <div class="hp25-bestsellers__info">
            <h3 class="hp25-bestsellers__card-title">{{ product.title }}</h3>
            <div class="hp25-bestsellers__price-wrapper">
              <span class="hp25-bestsellers__price">{{ product.price | money }}</span>
              {%- if product.compare_at_price > product.price -%}
                <span class="hp25-bestsellers__compare-price">{{ product.compare_at_price | money }}</span>
              {%- endif -%}
            </div>
            <button class="hp25-bestsellers__btn" tabindex="-1">ADD TO BAG</button>
          </div>
        </a>
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..limit) -%}
        <a href="#" class="hp25-bestsellers__card">
          <div class="hp25-bestsellers__image-wrapper">
            {%- if forloop.index <= 2 -%}
              <div class="hp25-bestsellers__badge">HOT</div>
            {%- endif -%}
            <div style="width:100%;height:100%;background:var(--accent-green);display:flex;align-items:center;justify-content:center;font-family:var(--font-heading);font-style:italic;color:var(--bg-color);">PRODUCT</div>
          </div>
          <div class="hp25-bestsellers__info">
            <h3 class="hp25-bestsellers__card-title">Groovy Graphic Tee</h3>
            <div class="hp25-bestsellers__price-wrapper">
              <span class="hp25-bestsellers__price">$45.00</span>
            </div>
            <button class="hp25-bestsellers__btn" tabindex="-1">ADD TO BAG</button>
          </div>
        </a>
      {%- endfor -%}
    {%- endif -%}
  </div>

</div>

{% schema %}
{
  "name": "HP25 - Retro Bestsellers",
  "class": "section-hp25-bestsellers",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "THE HOT LIST"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "Our most far out pieces, loved by the community."
    },
    {
      "type": "range",
      "id": "header_margin",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Margin Below Header",
      "default": 60
    },
    {
      "type": "header",
      "content": "Collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Products to Show",
      "default": 3
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1200
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Columns (Desktop)",
      "default": 3
    },
    {
      "type": "select",
      "id": "image_aspect_ratio",
      "label": "Image Aspect Ratio",
      "options": [
        { "value": "1/1", "label": "Square (1:1)" },
        { "value": "3/4", "label": "Portrait (3:4)" },
        { "value": "4/5", "label": "Portrait (4:5)" }
      ],
      "default": "1/1"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 60
    },
    {
      "type": "header",
      "content": "Retro 70s Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#F5E6D3"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text / Border (Dark Brown)",
      "default": "#3E2723"
    },
    {
      "type": "color",
      "id": "accent_orange",
      "label": "Accent (Burnt Orange)",
      "default": "#D15F3C"
    },
    {
      "type": "color",
      "id": "accent_yellow",
      "label": "Accent (Mustard)",
      "default": "#E2B144"
    },
    {
      "type": "color",
      "id": "accent_green",
      "label": "Accent (Avocado Green)",
      "default": "#76834F"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP25 - Retro Bestsellers"
    }
  ]
}
{% endschema %}
