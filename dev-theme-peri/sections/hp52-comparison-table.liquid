{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp52-comp-bg: {{ section.settings.bg_color | default: '#F7EFE6' }};
    --hp52-terra: {{ section.settings.accent_terra | default: '#C2593F' }};
    
    background-color: var(--hp52-comp-bg);
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }

  .hp52-comp__wrap {
    max-width: {{ section.settings.container_width | default: 980 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp52-comp__header {
    text-align: center;
    margin-bottom: 45px;
  }

  .hp52-comp__heading {
    font-family: 'Bodoni Moda', serif;
    font-size: clamp(32px, 4.5vw, 44px);
    font-weight: 700;
    color: #2D3B2D;
    margin: 0 0 8px;
  }

  .hp52-comp__card {
    background: #FFFDF9;
    border: 1px solid rgba(194, 89, 63, 0.15);
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 15px 40px rgba(45, 59, 45, 0.05);
  }

  .hp52-comp__table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }

  .hp52-comp__table th, .hp52-comp__table td {
    padding: 18px 24px;
    text-align: center;
    border-bottom: 1px solid rgba(194, 89, 63, 0.1);
  }

  .hp52-comp__table th {
    font-family: 'Jost', sans-serif;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    background: #EFE4D6;
    color: #2D3B2D;
  }

  .hp52-comp__highlight {
    background: rgba(194, 89, 63, 0.08);
    font-weight: 700;
    color: #2D3B2D !important;
  }

  @media screen and (max-width: 600px) {
    .hp52-comp__table th, .hp52-comp__table td { padding: 12px 10px; font-size: 12px; }
  }
{%- endstyle -%}

<div class="hp52-comp__wrap">
  <div class="hp52-comp__header">
    <h2 class="hp52-comp__heading">The Mediterranean Standard</h2>
    <p style="font-size:14px; color:#5C675B;">{{ section.settings.subheading | default: 'Cold-pressed single-estate Tuscan olive squalane vs refined commercial oils.' }}</p>
  </div>

  <div class="hp52-comp__card">
    <table class="hp52-comp__table">
      <thead>
        <tr>
          <th style="text-align:left;">Lipid Quality</th>
          <th class="hp52-comp__highlight">Peri Tuscany v52</th>
          <th>Commercial Oils</th>
        </tr>
      </thead>
      <tbody>
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <td style="text-align:left; font-weight:700;">{{ block.settings.feature }}</td>
              <td class="hp52-comp__highlight">{{ block.settings.brand_val }}</td>
              <td>{{ block.settings.other_val }}</td>
            </tr>
          {%- endfor -%}
        {%- else -%}
          <tr>
            <td style="text-align:left; font-weight:700;">Extraction Method</td>
            <td class="hp52-comp__highlight">Cold First-Press Artisanal Milling</td>
            <td>High-Heat Hexane Solvent Refining</td>
          </tr>
          <tr>
            <td style="text-align:left; font-weight:700;">Squalene Purity</td>
            <td class="hp52-comp__highlight">Unrefined 99.4% Bio-Identical Squalane</td>
            <td>Synthetic Mineral Mineral Derivatives</td>
          </tr>
          <tr>
            <td style="text-align:left; font-weight:700;">Mineral Clay Base</td>
            <td class="hp52-comp__highlight">Sicilian Sun-Cured Terracotta</td>
            <td>Bleached Industrial Kaolin Clay</td>
          </tr>
          <tr>
            <td style="text-align:left; font-weight:700;">Global DDP Air Delivery</td>
            <td class="hp52-comp__highlight">100% Pre-Paid Border Tariffs</td>
            <td>Unpredictable Import Surcharges</td>
          </tr>
        {%- endif -%}
      </tbody>
    </table>
  </div>
</div>

{% schema %}
{
  "name": "HP52 - Terra Matrix",
  "class": "section-hp52-matrix",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#F7EFE6" },
    { "type": "color", "id": "accent_terra", "label": "Terracotta Accent", "default": "#C2593F" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 700, "max": 1200, "step": 20, "unit": "px", "label": "Container Width", "default": 980 }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Matrix Row",
      "settings": [
        { "type": "text", "id": "feature", "label": "Feature", "default": "Extraction Method" },
        { "type": "text", "id": "brand_val", "label": "Our Value", "default": "Cold First-Press Artisanal" },
        { "type": "text", "id": "other_val", "label": "Commercial Value", "default": "High-Heat Hexane Refining" }
      ]
    }
  ],
  "presets": [
    { "name": "HP52 - Terra Matrix" }
  ]
}
{% endschema %}
