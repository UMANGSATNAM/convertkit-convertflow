{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp52-test-bg: {{ section.settings.bg_color | default: '#F7EFE6' }};
    --hp52-terra: {{ section.settings.accent_terra | default: '#C2593F' }};
    
    background-color: var(--hp52-test-bg);
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }

  .hp52-test__wrap {
    max-width: {{ section.settings.container_width | default: 1240 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp52-test__header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 50px;
  }

  .hp52-test__heading {
    font-family: 'Bodoni Moda', serif;
    font-size: clamp(32px, 4.5vw, 44px);
    font-weight: 700;
    color: #2D3B2D;
    margin: 0 0 8px;
  }

  .hp52-test__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: 3 }}, 1fr);
    gap: 24px;
  }

  .hp52-test__card {
    background: #FFFDF9;
    border: 1px solid rgba(194, 89, 63, 0.15);
    border-radius: 36px 36px 12px 12px;
    padding: 36px 28px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: 0 10px 30px rgba(45, 59, 45, 0.04);
  }

  .hp52-test__stars {
    color: #C2593F;
    font-size: 16px;
    margin-bottom: 16px;
    letter-spacing: 2px;
  }

  .hp52-test__quote {
    font-size: 15px;
    line-height: 1.8;
    color: #2D3B2D;
    margin: 0 0 24px;
    font-style: italic;
  }

  .hp52-test__author-row {
    border-top: 1px solid rgba(194, 89, 63, 0.15);
    padding-top: 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .hp52-test__author {
    font-family: 'Jost', sans-serif;
    font-size: 13px;
    font-weight: 700;
    color: #2D3B2D;
  }

  .hp52-test__verified {
    font-size: 11px;
    color: #C2593F;
  }

  @media screen and (max-width: 992px) {
    .hp52-test__grid { grid-template-columns: 1fr; max-width: 500px; margin: 0 auto; }
  }
{%- endstyle -%}

<div class="hp52-test__wrap">
  <div class="hp52-test__header">
    <h2 class="hp52-test__heading">{{ section.settings.heading | default: 'Tuscan Villa Patron Acclaim' }}</h2>
    <p style="font-size:14px; color:#5C675B;">{{ section.settings.subheading | default: 'Direct testimonials from our Mediterranean skincare community.' }}</p>
  </div>

  <div class="hp52-test__grid">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <div class="hp52-test__card" {{ block.shopify_attributes }}>
          <div>
            <div class="hp52-test__stars">★★★★★</div>
            <p class="hp52-test__quote">"{{ block.settings.quote }}"</p>
          </div>
          <div class="hp52-test__author-row">
            <span class="hp52-test__author">{{ block.settings.author }}</span>
            <span class="hp52-test__verified">✓ Verified Patron</span>
          </div>
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="hp52-test__card">
        <div>
          <div class="hp52-test__stars">★★★★★</div>
          <p class="hp52-test__quote">"The olive squalane face nectar feels like liquid gold from Florence. My dry cheeks have never looked more nourished."</p>
        </div>
        <div class="hp52-test__author-row">
          <span class="hp52-test__author">Giulia Moretti</span>
          <span class="hp52-test__verified">✓ Verified Florence Patron</span>
        </div>
      </div>
      <div class="hp52-test__card">
        <div>
          <div class="hp52-test__stars">★★★★★</div>
          <p class="hp52-test__quote">"The Sicilian terracotta mask purifies deep without cracking or tightening uncomfortably. A Mediterranean spa ritual at home."</p>
        </div>
        <div class="hp52-test__author-row">
          <span class="hp52-test__author">Matteo Conti</span>
          <span class="hp52-test__verified">✓ Verified Rome Patron</span>
        </div>
      </div>
      <div class="hp52-test__card">
        <div>
          <div class="hp52-test__stars">★★★★★</div>
          <p class="hp52-test__quote">"The honey crème leaves a velvety sheen that smells like wild Italian hillsides in early summer."</p>
        </div>
        <div class="hp52-test__author-row">
          <span class="hp52-test__author">Sophia Laurent</span>
          <span class="hp52-test__verified">✓ Verified Patron</span>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP52 - Terra Test",
  "class": "section-hp52-testimonials",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#F7EFE6" },
    { "type": "color", "id": "accent_terra", "label": "Terracotta Accent", "default": "#C2593F" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Tuscan Villa Patron Acclaim" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Direct testimonials from our Mediterranean skincare community." },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "label": "Desktop Columns", "default": 3 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1240 }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review Item",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "The olive squalane face nectar feels like liquid gold." },
        { "type": "text", "id": "author", "label": "Author Name", "default": "Giulia Moretti" }
      ]
    }
  ],
  "presets": [
    { "name": "HP52 - Terra Test" }
  ]
}
{% endschema %}
