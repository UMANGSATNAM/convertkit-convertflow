{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;1,400&family=Nunito:wght@300;400;600&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    
    --font-heading: 'Lora', serif;
    --font-body: 'Nunito', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .hp35-video-wrapper {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp35-video-wrapper {
      padding: 0 20px;
    }
  }

  .hp35-video__container {
    position: relative;
    width: 100%;
    aspect-ratio: 21/9;
    background: #e9e5de;
    overflow: hidden;
    border-radius: 400px; /* extremely pill shaped */
  }

  @media screen and (max-width: 768px) {
    .hp35-video__container {
      aspect-ratio: 1/1;
      border-radius: 20px;
    }
  }

  .hp35-video__media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 10s ease;
  }

  .hp35-video__container:hover .hp35-video__media {
    transform: scale(1.05);
  }

  .hp35-video__overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0,0,0,0.2);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    z-index: 3;
    pointer-events: none;
  }

  .hp35-video__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 6vw, {{ section.settings.title_size }}px);
    color: #fff;
    margin: 0 0 30px;
    font-weight: 400;
    text-align: center;
  }
  
  .hp35-video__title em {
    font-style: italic;
  }

  .hp35-video__play-btn {
    width: 80px; height: 80px;
    border-radius: 50%;
    background: rgba(255,255,255,0.9);
    color: var(--accent-color);
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: auto;
    cursor: pointer;
    border: none;
    transition: all 0.4s ease;
  }
  
  .hp35-video__play-btn svg {
    width: 30px; height: 30px;
    fill: currentColor;
    margin-left: 5px;
  }

  .hp35-video__play-btn:hover {
    transform: scale(1.1);
    background: #fff;
    color: var(--text-color);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp35-video-wrapper" id="HP35Video-{{ section.id }}">
  <div class="hp35-video__container">
    {%- if section.settings.video_url != blank -%}
      {%- if section.settings.video_url.type == 'youtube' -%}
        <iframe class="hp35-video__media" src="https://www.youtube.com/embed/{{ section.settings.video_url.id }}?autoplay=0&controls=0&mute=1&loop=1&playlist={{ section.settings.video_url.id }}" frameborder="0" allow="autoplay; encrypted-media" allowfullscreen></iframe>
      {%- elsif section.settings.video_url.type == 'vimeo' -%}
        <iframe class="hp35-video__media" src="https://player.vimeo.com/video/{{ section.settings.video_url.id }}?background=1" frameborder="0" allow="autoplay; fullscreen" allowfullscreen></iframe>
      {%- endif -%}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'hp35-video__media' }}
    {%- endif -%}

    <div class="hp35-video__overlay">
      {%- if section.settings.title != blank -%}
        <h2 class="hp35-video__title">{{ section.settings.title | replace: 'motion', '<em>motion</em>' }}</h2>
      {%- endif -%}
      <button class="hp35-video__play-btn" aria-label="Play Video">
        <svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
      </button>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "HP35 - Organic Video",
  "class": "section-hp35-video-banner",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Poetry in motion"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "accept": ["youtube", "vimeo"],
      "label": "Video URL"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 64
    },
    {
      "type": "header",
      "content": "Organic Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#FDFBF7"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2C422F"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#CC7B5E"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 100
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP35 - Organic Video"
    }
  ]
}
{% endschema %}
