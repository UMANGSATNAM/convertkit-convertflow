{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp52-news-bg: {{ section.settings.bg_color | default: '#F7EFE6' }};
    --hp52-terra: {{ section.settings.accent_terra | default: '#C2593F' }};
    
    background-color: var(--hp52-news-bg);
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }

  .hp52-news__box {
    max-width: {{ section.settings.container_width | default: 760 }}px;
    margin: 0 auto;
    padding: 50px 40px;
    background: #FFFDF9;
    border: 1px solid rgba(194, 89, 63, 0.15);
    border-radius: 40px 40px 16px 16px;
    text-align: center;
    box-shadow: 0 15px 40px rgba(45, 59, 45, 0.05);
  }

  .hp52-news__title {
    font-family: 'Bodoni Moda', serif;
    font-size: clamp(30px, 4.5vw, 40px);
    font-weight: 700;
    color: #2D3B2D;
    margin: 0 0 12px;
  }

  .hp52-news__desc {
    font-size: 15px;
    line-height: 1.8;
    color: #5C675B;
    margin: 0 0 32px;
  }

  .hp52-news__form {
    display: flex;
    gap: 12px;
    max-width: 500px;
    margin: 0 auto;
  }

  .hp52-news__input {
    flex: 1;
    padding: 15px 24px;
    background: #F7EFE6;
    border: 1px solid rgba(194, 89, 63, 0.2);
    border-radius: 8px;
    color: #2D3B2D;
    font-size: 14px;
    outline: none;
    font-family: 'Jost', sans-serif;
  }

  .hp52-news__input:focus { border-color: var(--hp52-terra); }

  .hp52-news__btn {
    padding: 15px 32px;
    background: #C2593F;
    color: #FFFDF9;
    border: none;
    border-radius: 8px;
    font-family: 'Jost', sans-serif;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 1px;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .hp52-news__btn:hover { background: #A94B34; }

  @media screen and (max-width: 600px) {
    .hp52-news__box { padding: 36px 20px; }
    .hp52-news__form { flex-direction: column; }
  }
{%- endstyle -%}

<div class="hp52-news__box">
  <h2 class="hp52-news__title">{{ section.settings.heading | default: 'The Tuscan Villa Circle' }}</h2>
  <p class="hp52-news__desc">{{ section.settings.description | default: 'Join our patron circle to receive seasonal harvest bulletins and an instant 15% Mediterranean welcome gift.' }}</p>
  <form class="hp52-news__form" onsubmit="event.preventDefault(); alert('Subscribed to Tuscan Villa Circle.');">
    <input type="email" class="hp52-news__input" placeholder="{{ section.settings.placeholder | default: 'Enter your email address' }}" required>
    <button type="submit" class="hp52-news__btn">{{ section.settings.btn_text | default: 'Subscribe' }}</button>
  </form>
</div>

{% schema %}
{
  "name": "HP52 - Terra News",
  "class": "section-hp52-news",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#F7EFE6" },
    { "type": "color", "id": "accent_terra", "label": "Terracotta Accent", "default": "#C2593F" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Tuscan Villa Circle" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Join our patron circle to receive seasonal harvest bulletins." },
    { "type": "text", "id": "placeholder", "label": "Placeholder", "default": "Enter your email address" },
    { "type": "text", "id": "btn_text", "label": "Button Text", "default": "Subscribe" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 500, "max": 1000, "step": 20, "unit": "px", "label": "Container Width", "default": 760 }
  ],
  "presets": [
    { "name": "HP52 - Terra News" }
  ]
}
{% endschema %}
