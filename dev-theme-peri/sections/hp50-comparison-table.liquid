{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp50-comp-bg: {{ section.settings.bg_color | default: '#000000' }};
    
    background-color: var(--hp50-comp-bg);
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }

  .hp50-comp__wrap {
    max-width: {{ section.settings.container_width | default: 980 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp50-comp__header {
    text-align: center;
    margin-bottom: 45px;
  }

  .hp50-comp__heading {
    font-family: 'Italiana', serif;
    font-size: clamp(34px, 4.5vw, 46px);
    font-weight: 400;
    color: #FFFFFF;
    margin: 0 0 8px;
    letter-spacing: 1px;
  }

  .hp50-comp__card {
    background: #111111;
    border: 1px solid rgba(226, 232, 240, 0.25);
    overflow: hidden;
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.8);
  }

  .hp50-comp__table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }

  .hp50-comp__table th, .hp50-comp__table td {
    padding: 18px 24px;
    text-align: center;
    border-bottom: 1px solid rgba(226, 232, 240, 0.15);
    color: #FFFFFF;
  }

  .hp50-comp__table th {
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    background: #18181B;
  }

  .hp50-comp__highlight {
    background: rgba(255, 255, 255, 0.06);
    font-weight: 700;
    color: #FFFFFF !important;
  }

  @media screen and (max-width: 600px) {
    .hp50-comp__table th, .hp50-comp__table td { padding: 12px 10px; font-size: 12px; }
  }
{%- endstyle -%}

<div class="hp50-comp__wrap">
  <div class="hp50-comp__header">
    <h2 class="hp50-comp__heading">The High-Fashion Matrix</h2>
    <p style="font-size:12px; color:#94A3B8; letter-spacing:1.5px; text-transform:uppercase;">{{ section.settings.subheading | default: 'Platinum contour bio-vectors vs standard commercial cosmetic emulsions.' }}</p>
  </div>

  <div class="hp50-comp__card">
    <table class="hp50-comp__table">
      <thead>
        <tr>
          <th style="text-align:left;">Editorial Criteria</th>
          <th class="hp50-comp__highlight">Peri Runway v50</th>
          <th>Commercial Brand</th>
        </tr>
      </thead>
      <tbody>
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <td style="text-align:left; font-weight:700;">{{ block.settings.feature }}</td>
              <td class="hp50-comp__highlight">{{ block.settings.brand_val }}</td>
              <td>{{ block.settings.other_val }}</td>
            </tr>
          {%- endfor -%}
        {%- else -%}
          <tr>
            <td style="text-align:left; font-weight:700;">Contouring Catalyst</td>
            <td class="hp50-comp__highlight">Colloidal Platinum Micro-Peptides</td>
            <td>Synthetic Silicones &amp; Dimethicone</td>
          </tr>
          <tr>
            <td style="text-align:left; font-weight:700;">Camera Light Diffusion</td>
            <td class="hp50-comp__highlight">Obsidian Mineral Flash-Matte</td>
            <td>Talc &amp; Chalky White Cast</td>
          </tr>
          <tr>
            <td style="text-align:left; font-weight:700;">Vessel Architecture</td>
            <td class="hp50-comp__highlight">Pitch Black Heavy Monolith Glass</td>
            <td>Standard Lightweight Plastic</td>
          </tr>
          <tr>
            <td style="text-align:left; font-weight:700;">Global DDP Air Courier</td>
            <td class="hp50-comp__highlight">100% Pre-Paid Border Tariffs</td>
            <td>Postal Customs Clearance Delays</td>
          </tr>
        {%- endif -%}
      </tbody>
    </table>
  </div>
</div>

{% schema %}
{
  "name": "HP50 - Runway Matrix",
  "class": "section-hp50-matrix",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#000000" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 700, "max": 1200, "step": 20, "unit": "px", "label": "Container Width", "default": 980 }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Matrix Row",
      "settings": [
        { "type": "text", "id": "feature", "label": "Feature", "default": "Contouring Catalyst" },
        { "type": "text", "id": "brand_val", "label": "Our Value", "default": "Colloidal Platinum Micro-Peptides" },
        { "type": "text", "id": "other_val", "label": "Commercial Value", "default": "Synthetic Silicones" }
      ]
    }
  ],
  "presets": [
    { "name": "HP50 - Runway Matrix" }
  ]
}
{% endschema %}
