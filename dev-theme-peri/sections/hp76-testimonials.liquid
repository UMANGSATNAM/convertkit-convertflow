{%- style -%}#shopify-section-{{ section.id }}{background:#ECFEFF;padding:60px 24px}.hp76-test{max-width:1280px;margin:0 auto;display:grid;grid-template-columns:repeat(3,1fr);gap:18px}@media(max-width:768px){.hp76-test{grid-template-columns:1fr}}.hp76-t{background:#fff;border:1px solid rgba(0,0,0,.06);border-radius:14px;padding:18px}.hp76-t__stars{color:#06B6D4;letter-spacing:2px}{%- endstyle -%}<div class="hp76-test">{% for block in section.blocks %}<div class="hp76-t"><p class="hp76-t__stars">★★★★★</p><p style="font-weight:600;margin:8px 0">{{ block.settings.text }}</p><p style="opacity:.6;font-size:13px">— {{ block.settings.author }}</p></div>{% else %}<div class="hp76-t"><p class="hp76-t__stars">★★★★★</p><p>Love the activewear quality!</p><p style="opacity:.6">— A. Sharma</p></div><div class="hp76-t"><p class="hp76-t__stars">★★★★★</p><p>Super fast delivery.</p><p style="opacity:.6">— R. Mehta</p></div><div class="hp76-t"><p class="hp76-t__stars">★★★★★</p><p>Will reorder!</p><p style="opacity:.6">— P. Rao</p></div>{% endfor %}</div>{% schema %}{"name":"HP76 Testimonials","blocks":[{"type":"t","name":"Testimonial","settings":[{"type":"textarea","id":"text","label":"Text","default":"Great product!"},{"type":"text","id":"author","label":"Author","default":"A. Sharma"}]}]}{% endschema %}