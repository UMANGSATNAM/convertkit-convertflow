{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Lato:wght@300;400;700&family=Playfair+Display:ital,wght@0,400;0,500;1,400&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    
    --font-heading: 'Playfair Display', serif;
    --font-body: 'Lato', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .hp31-tiles-wrapper {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    gap: 40px;
    align-items: stretch;
  }

  @media screen and (max-width: 992px) {
    .hp31-tiles-wrapper {
      flex-direction: column;
    }
  }

  @media screen and (max-width: 768px) {
    .hp31-tiles-wrapper {
      padding: 0 20px;
      gap: 20px;
    }
  }

  .hp31-tile {
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    display: block;
    text-decoration: none;
    color: inherit;
    background: #E8E2D6;
  }

  .hp31-tile--large {
    flex: 1.5;
    aspect-ratio: 4/5;
  }

  .hp31-tile--small {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  @media screen and (max-width: 992px) {
    .hp31-tile--small {
      gap: 20px;
    }
  }

  .hp31-tile__inner {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 24px;
    overflow: hidden;
    background: #E8E2D6;
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .hp31-tile--small .hp31-tile__inner {
    flex: 1;
    min-height: 300px;
  }

  .hp31-tile__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.5s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .hp31-tile:hover .hp31-tile__image,
  .hp31-tile__inner:hover .hp31-tile__image {
    transform: scale(1.05);
  }

  .hp31-tile__content {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    padding: 40px;
    background: linear-gradient(to top, rgba(0,0,0,0.5), transparent);
    color: #ffffff;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  @media screen and (max-width: 768px) {
    .hp31-tile__content {
      padding: 20px;
    }
  }

  .hp31-tile__title {
    font-family: var(--font-heading);
    font-size: clamp(24px, 3vw, 36px);
    margin: 0 0 10px;
    font-weight: 400;
  }

  .hp31-tile__link {
    font-family: var(--font-body);
    font-size: 13px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding-bottom: 4px;
    border-bottom: 1px solid currentColor;
    opacity: 0.9;
    transition: opacity 0.3s ease;
  }

  .hp31-tile:hover .hp31-tile__link,
  .hp31-tile__inner:hover .hp31-tile__link {
    opacity: 1;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp31-tiles-wrapper" id="HP31Tiles-{{ section.id }}">
  <!-- Block 1: Large Left -->
  {%- if section.blocks.size > 0 -%}
    {%- assign block1 = section.blocks[0] -%}
    <a href="{{ block1.settings.link | default: '#' }}" class="hp31-tile hp31-tile--large" {{ block1.shopify_attributes }}>
      {%- if block1.settings.image != blank -%}
        <img height="{{ block1.settings.image.height }}" width="{{ block1.settings.image.width }}" src="{{ block1.settings.image | image_url: width: 1000 }}" alt="{{ block1.settings.title | escape }}" class="hp31-tile__image" loading="lazy">
      {%- else -%}
        {{ 'collection-1' | placeholder_svg_tag: 'hp31-tile__image' }}
      {%- endif -%}
      <div class="hp31-tile__content">
        <h3 class="hp31-tile__title">{{ block1.settings.title }}</h3>
        <span class="hp31-tile__link">{{ block1.settings.link_label }}</span>
      </div>
    </a>
  {%- endif -%}

  <!-- Block 2 & 3: Stacked Right -->
  <div class="hp31-tile--small">
    {%- if section.blocks.size > 1 -%}
      {%- assign block2 = section.blocks[1] -%}
      <a href="{{ block2.settings.link | default: '#' }}" class="hp31-tile__inner" {{ block2.shopify_attributes }}>
        {%- if block2.settings.image != blank -%}
          <img height="{{ block2.settings.image.height }}" width="{{ block2.settings.image.width }}" src="{{ block2.settings.image | image_url: width: 800 }}" alt="{{ block2.settings.title | escape }}" class="hp31-tile__image" loading="lazy">
        {%- else -%}
          {{ 'collection-2' | placeholder_svg_tag: 'hp31-tile__image' }}
        {%- endif -%}
        <div class="hp31-tile__content">
          <h3 class="hp31-tile__title">{{ block2.settings.title }}</h3>
          <span class="hp31-tile__link">{{ block2.settings.link_label }}</span>
        </div>
      </a>
    {%- endif -%}

    {%- if section.blocks.size > 2 -%}
      {%- assign block3 = section.blocks[2] -%}
      <a href="{{ block3.settings.link | default: '#' }}" class="hp31-tile__inner" {{ block3.shopify_attributes }}>
        {%- if block3.settings.image != blank -%}
          <img height="{{ block3.settings.image.height }}" width="{{ block3.settings.image.width }}" src="{{ block3.settings.image | image_url: width: 800 }}" alt="{{ block3.settings.title | escape }}" class="hp31-tile__image" loading="lazy">
        {%- else -%}
          {{ 'collection-3' | placeholder_svg_tag: 'hp31-tile__image' }}
        {%- endif -%}
        <div class="hp31-tile__content">
          <h3 class="hp31-tile__title">{{ block3.settings.title }}</h3>
          <span class="hp31-tile__link">{{ block3.settings.link_label }}</span>
        </div>
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP31 - Zen Category Tiles",
  "class": "section-hp31-category-tiles",
  "max_blocks": 3,
  "settings": [
    {
      "type": "header",
      "content": "Zen Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (Beige)",
      "default": "#F9F6F0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text (Charcoal)",
      "default": "#2C2C2C"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 100
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Category Tile",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "New Arrivals"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link Label",
          "default": "Explore"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP31 - Zen Category Tiles",
      "blocks": [
        { "type": "tile", "settings": { "title": "Living Spaces" } },
        { "type": "tile", "settings": { "title": "Ceramics" } },
        { "type": "tile", "settings": { "title": "Lighting" } }
      ]
    }
  ]
}
{% endschema %}
