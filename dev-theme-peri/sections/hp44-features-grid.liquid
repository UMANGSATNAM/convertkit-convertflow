{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp44-feat-bg: {{ section.settings.bg_color | default: '#EDF4EE' }};
    --hp44-feat-card: {{ section.settings.card_bg | default: '#FFFFFF' }};
    --hp44-feat-border: {{ section.settings.card_border | default: '#D8E8DC' }};
    --hp44-feat-title: {{ section.settings.title_color | default: '#143D2B' }};
    --hp44-feat-desc: {{ section.settings.desc_color | default: '#406352' }};
    --hp44-feat-accent: {{ section.settings.accent_color | default: '#2D6A4F' }};
    
    background-color: var(--hp44-feat-bg);
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
  }

  .hp44-feat__wrapper {
    max-width: {{ section.settings.container_width | default: 1240 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp44-feat__title-block {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 50px;
  }

  .hp44-feat__heading {
    font-family: 'Playfair Display', serif;
    font-size: clamp(28px, 4vw, 42px);
    font-weight: 700;
    color: var(--hp44-feat-title);
    margin: 0 0 10px;
  }

  .hp44-feat__sub {
    font-size: 15px;
    color: var(--hp44-feat-desc);
    margin: 0;
  }

  .hp44-feat__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: 3 }}, 1fr);
    gap: 24px;
  }

  .hp44-feat__card {
    background: var(--hp44-feat-card);
    border: 1px solid var(--hp44-feat-border);
    border-radius: 24px;
    padding: 36px 28px;
    box-shadow: 0 10px 30px rgba(20, 61, 43, 0.04);
    transition: all 0.3s ease;
  }

  .hp44-feat__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 45px rgba(20, 61, 43, 0.09);
  }

  .hp44-feat__h3 {
    font-family: 'Playfair Display', serif;
    font-size: 20px;
    font-weight: 700;
    color: var(--hp44-feat-accent);
    margin: 0 0 12px;
  }

  .hp44-feat__p {
    font-size: 14px;
    line-height: 1.7;
    color: var(--hp44-feat-desc);
    margin: 0;
  }

  @media screen and (max-width: 992px) {
    .hp44-feat__grid { grid-template-columns: 1fr; }
  }
{%- endstyle -%}

<div class="hp44-feat__wrapper">
  <div class="hp44-feat__title-block">
    <h2 class="hp44-feat__heading">{{ section.settings.heading | default: 'Herbarium Clinical Innovations' }}</h2>
    <p class="hp44-feat__sub">{{ section.settings.subheading | default: 'State-of-the-art bio-extraction meets pure Nordic botanical heritage.' }}</p>
  </div>

  <div class="hp44-feat__grid">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <div class="hp44-feat__card" {{ block.shopify_attributes }}>
          <h3 class="hp44-feat__h3">{{ block.settings.title }}</h3>
          <p class="hp44-feat__p">{{ block.settings.description }}</p>
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="hp44-feat__card">
        <h3 class="hp44-feat__h3">Cold Hydro-Distillation</h3>
        <p class="hp44-feat__p">Zero high-heat processing protects fragile botanical terpenoids and antioxidant vitamins.</p>
      </div>
      <div class="hp44-feat__card">
        <h3 class="hp44-feat__h3">Bio-Identical Lipid Emulsion</h3>
        <p class="hp44-feat__p">Micro-molecular structure matches human stratum corneum for instant, residue-free penetration.</p>
      </div>
      <div class="hp44-feat__card">
        <h3 class="hp44-feat__h3">FSC Certified Nordic Birch</h3>
        <p class="hp44-feat__p">Sustainable wooden caps paired with 100% recyclable frosted European cosmetic glass.</p>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP44 - Sage Feat",
  "class": "section-hp44-features",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#EDF4EE" },
    { "type": "color", "id": "card_bg", "label": "Card Background", "default": "#FFFFFF" },
    { "type": "color", "id": "card_border", "label": "Card Border", "default": "#D8E8DC" },
    { "type": "color", "id": "title_color", "label": "Title Color", "default": "#143D2B" },
    { "type": "color", "id": "desc_color", "label": "Description Color", "default": "#406352" },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#2D6A4F" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Herbarium Clinical Innovations" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "State-of-the-art bio-extraction meets pure Nordic botanical heritage." },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "label": "Desktop Columns", "default": 3 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 80 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1240 }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Card",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Cold Hydro-Distillation" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Zero high-heat processing protects fragile botanical terpenoids." }
      ]
    }
  ],
  "presets": [
    { "name": "HP44 - Sage Feat" }
  ]
}
{% endschema %}
