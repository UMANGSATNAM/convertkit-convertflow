{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#f4f1de'
  assign text_color = section.settings.text_color | default: '#6b705c'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 120px 40px;
    text-align: center;
  }
  
  .hp14-newsletter-container-{{ section_id }} {
    max-width: 700px;
    margin: 0 auto;
  }
  
  .hp14-newsletter-icon-{{ section_id }} {
    color: #cb997e;
    margin-bottom: 20px;
  }
  
  .hp14-newsletter-icon-{{ section_id }} svg {
    width: 40px;
    height: 40px;
  }
  
  .hp14-newsletter-heading-{{ section_id }} {
    font-family: 'Georgia', serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: normal;
    margin: 0 0 20px 0;
    color: {{ text_color }};
  }
  
  .hp14-newsletter-heading-{{ section_id }} span {
    font-style: italic;
    color: #cb997e;
  }
  
  .hp14-newsletter-text-{{ section_id }} {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 1.1rem;
    line-height: 1.6;
    margin: 0 0 40px 0;
    color: #a5a58d;
  }
  
  .hp14-newsletter-form-{{ section_id }} {
    display: flex;
    max-width: 500px;
    margin: 0 auto;
    border-bottom: 1px solid {{ text_color }};
    padding-bottom: 10px;
  }
  
  .hp14-newsletter-input-{{ section_id }} {
    flex: 1;
    background: transparent;
    border: none;
    padding: 10px;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 1rem;
    color: {{ text_color }};
    outline: none;
  }
  
  .hp14-newsletter-input-{{ section_id }}::placeholder {
    color: #a5a58d;
  }
  
  .hp14-newsletter-btn-{{ section_id }} {
    background: transparent;
    border: none;
    color: #cb997e;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    cursor: pointer;
    padding: 10px;
    transition: opacity 0.3s ease;
  }
  
  .hp14-newsletter-btn-{{ section_id }}:hover {
    opacity: 0.7;
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 80px 20px;
    }
  }
</style>

<div class="hp14-newsletter-container-{{ section_id }}">
  <div class="hp14-newsletter-icon-{{ section_id }}">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
  </div>
  <h2 class="hp14-newsletter-heading-{{ section_id }}">{{ section.settings.heading | default: 'Join our <span>community</span>' }}</h2>
  <div class="hp14-newsletter-text-{{ section_id }}">
    {{ section.settings.text | default: 'Subscribe to receive 10% off your first order, early access to new collections, and weekly wellness tips.' }}
  </div>
  
  {% form 'customer', class: 'hp14-newsletter-form-' | append: section_id %}
    <input type="hidden" name="contact[tags]" value="newsletter">
    <input type="email" name="contact[email]" class="hp14-newsletter-input-{{ section_id }}" placeholder="Enter your email address" required>
    <button type="submit" class="hp14-newsletter-btn-{{ section_id }}">Subscribe</button>
  {% endform %}
</div>

{% schema %}
{
  "name": "HP14 Newsletter",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f4f1de"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#6b705c"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join our <span>community</span>"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Subscribe to receive 10% off your first order, early access to new collections, and weekly wellness tips."
    }
  ],
  "presets": [
    {
      "name": "HP14 Newsletter"
    }
  ]
}
{% endschema %}
