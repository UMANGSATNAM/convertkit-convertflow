{%- liquid
  assign sec_id = section.id
  assign bg_color = section.settings.bg_color
  assign border_color = section.settings.border_color
  assign accent_color = section.settings.accent_color
  assign shadow_color = section.settings.shadow_color
  assign border_width = section.settings.border_width
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
  assign cover_image = section.settings.cover_image
  assign video_url = section.settings.video_url
-%}

<style>
  .hp18-video-{{ sec_id }} {
    padding-top: {{ padding_top }}px;
    padding-bottom: {{ padding_bottom }}px;
    background-color: {{ bg_color }};
    border-bottom: {{ border_width }}px solid {{ border_color }};
  }

  .hp18-video-{{ sec_id }}__container {
    max-width: var(--page-width, 1200px);
    margin: 0 auto;
    padding: 0 20px;
  }

  .hp18-video-{{ sec_id }}__wrapper {
    border: {{ border_width | plus: 2 }}px solid {{ border_color }};
    box-shadow: 20px 20px 0px {{ shadow_color }};
    position: relative;
    aspect-ratio: 16/9;
    background-color: #000;
    overflow: hidden;
  }

  .hp18-video-{{ sec_id }}__cover {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover;
    z-index: 1;
    transition: opacity 0.3s ease;
  }

  .hp18-video-{{ sec_id }}__wrapper.is-playing .hp18-video-{{ sec_id }}__cover {
    opacity: 0;
    pointer-events: none;
  }

  .hp18-video-{{ sec_id }}__play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 120px;
    height: 120px;
    background-color: {{ accent_color }};
    border: {{ border_width }}px solid {{ border_color }};
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    cursor: pointer;
    box-shadow: 6px 6px 0px {{ border_color }};
    transition: all 0.2s cubic-bezier(0.25, 1, 0.5, 1);
    z-index: 2;
  }

  .hp18-video-{{ sec_id }}__wrapper.is-playing .hp18-video-{{ sec_id }}__play {
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, -50%) scale(0.5);
  }

  .hp18-video-{{ sec_id }}__play:hover {
    transform: translate(-50%, -50%) scale(1.1);
    box-shadow: 10px 10px 0px {{ border_color }};
  }

  .hp18-video-{{ sec_id }}__play:active {
    transform: translate(calc(-50% + 4px), calc(-50% + 4px)) scale(1.1);
    box-shadow: 0px 0px 0px {{ border_color }};
  }

  .hp18-video-{{ sec_id }}__play::after {
    content: '';
    width: 0;
    height: 0;
    border-top: 20px solid transparent;
    border-bottom: 20px solid transparent;
    border-left: 35px solid {{ border_color }};
    margin-left: 10px;
  }

  .hp18-video-{{ sec_id }}__iframe-wrapper {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    z-index: 0;
  }

  .hp18-video-{{ sec_id }}__iframe-wrapper iframe,
  .hp18-video-{{ sec_id }}__iframe-wrapper video {
    width: 100%;
    height: 100%;
    border: none;
  }

  @media screen and (max-width: 768px) {
    .hp18-video-{{ sec_id }}__play {
      width: 80px;
      height: 80px;
    }
    .hp18-video-{{ sec_id }}__play::after {
      border-top: 15px solid transparent;
      border-bottom: 15px solid transparent;
      border-left: 25px solid {{ border_color }};
    }
    .hp18-video-{{ sec_id }}__wrapper {
      box-shadow: 10px 10px 0px {{ shadow_color }};
    }
  }
</style>

<section class="hp18-video-{{ sec_id }}">
  <div class="hp18-video-{{ sec_id }}__container">
    <div class="hp18-video-{{ sec_id }}__wrapper js-video-wrapper-{{ sec_id }}">
      
      {% if cover_image != blank %}
        <img src="{{ cover_image | image_url: width: 2048 }}" alt="Video Cover" class="hp18-video-{{ sec_id }}__cover">
      {% else %}
        {% capture tmp_class %}hp18-video-{{ sec_id }}__cover{% endcapture %}{{ 'lifestyle-1'  | placeholder_svg_tag: tmp_class }}
      {% endif %}
      
      <div class="hp18-video-{{ sec_id }}__play js-play-btn-{{ sec_id }}"></div>

      <div class="hp18-video-{{ sec_id }}__iframe-wrapper js-iframe-container-{{ sec_id }}">
        <!-- Video injects here via JS -->
      </div>

    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const wrapper = document.querySelector('.js-video-wrapper-{{ sec_id }}');
    const playBtn = document.querySelector('.js-play-btn-{{ sec_id }}');
    const iframeContainer = document.querySelector('.js-iframe-container-{{ sec_id }}');
    const videoUrl = '{{ video_url | default: "https://www.youtube.com/watch?v=_9VUPq31cC8" }}';

    if(playBtn && wrapper && iframeContainer) {
      playBtn.addEventListener('click', function() {
        wrapper.classList.add('is-playing');
        
        let iframeHtml = '';
        if (videoUrl.includes('youtube.com') || videoUrl.includes('youtu.be')) {
          // Extract Youtube ID (naive extraction for demo)
          let videoId = videoUrl.split('v=')[1];
          if(!videoId) videoId = videoUrl.split('/').pop();
          const ampersandPosition = videoId.indexOf('&');
          if(ampersandPosition != -1) {
            videoId = videoId.substring(0, ampersandPosition);
          }
          iframeHtml = `<iframe src="https://www.youtube.com/embed/${videoId}?autoplay=1&mute=0" allow="autoplay; encrypted-media" allowfullscreen></iframe>`;
        } else if (videoUrl.includes('vimeo.com')) {
          const videoId = videoUrl.split('/').pop();
          iframeHtml = `<iframe src="https://player.vimeo.com/video/${videoId}?autoplay=1" allow="autoplay; fullscreen" allowfullscreen></iframe>`;
        } else if (videoUrl.endsWith('.mp4')) {
          iframeHtml = `<video src="${videoUrl}" autoplay controls playsinline></video>`;
        }
        
        iframeContainer.innerHTML = iframeHtml;
      });
    }
  });
</script>

{% schema %}
{
  "name": "HP18 Advanced Video",
  "settings": [
    {
      "type": "header",
      "content": "Color Settings"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f4f4f0"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Play Button Color",
      "default": "#CCFF00"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "shadow_color",
      "label": "Shadow Color",
      "default": "#FF3366"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "Border Width",
      "default": 3
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 10,
      "unit": "px",
      "label": "Padding Top",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 10,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 100
    },
    {
      "type": "header",
      "content": "Video Settings"
    },
    {
      "type": "image_picker",
      "id": "cover_image",
      "label": "Cover Image",
      "info": "Displays before video plays"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Video URL",
      "info": "YouTube, Vimeo, or MP4 link",
      "default": "https://www.youtube.com/watch?v=_9VUPq31cC8"
    }
  ],
  "presets": [
    {
      "name": "HP18 Advanced Video"
    }
  ]
}
{% endschema %}
