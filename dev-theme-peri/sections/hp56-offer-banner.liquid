{%- style -%}
  #shopify-section-{{ section.id }} {
    background: linear-gradient(135deg, #082F49 0%, #0369A1 100%);
    color: #FFFFFF;
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
  }
  .hp56-offer__container { max-width: {{ section.settings.container_width | default: 1280 }}px; margin: 0 auto; padding: 0 24px; display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; }
  .hp56-offer__eyebrow { font-family: 'Outfit', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: #38BDF8; margin: 0 0 16px; }
  .hp56-offer__heading { font-family: 'Syne', sans-serif; font-size: clamp(28px, 4vw, 48px); font-weight: 800; color: #FFFFFF; margin: 0 0 18px; line-height: 1.1; }
  .hp56-offer__desc { font-size: 15px; line-height: 1.7; color: #E0F2FE; margin: 0 0 30px; }
  .hp56-offer__btn {
    display: inline-flex; align-items: center; gap: 10px; padding: 16px 36px;
    background: #F59E0B; color: #082F49; font-family: 'Outfit', sans-serif;
    font-size: 13px; font-weight: 700; text-decoration: none; border-radius: 8px;
    box-shadow: 0 8px 30px rgba(245, 158, 11, 0.35); transition: all 0.3s ease;
  }
  .hp56-offer__btn:hover { box-shadow: 0 12px 40px rgba(245, 158, 11, 0.55); transform: translateY(-2px); }
  .hp56-offer__img-wrap { border-radius: 20px; overflow: hidden; height: 400px; border: 1px solid rgba(255, 255, 255, 0.2); }
  .hp56-offer__img { width: 100%; height: 100%; object-fit: cover; }
  @media screen and (max-width: 992px) { .hp56-offer__container { grid-template-columns: 1fr; text-align: center; } .hp56-offer__img-wrap { height: 300px; } }
{%- endstyle -%}
<div class="hp56-offer__container">
  <div>
    <p class="hp56-offer__eyebrow">{{ section.settings.eyebrow | default: '❄️ ARCTIC RITUAL' }}</p>
    <h2 class="hp56-offer__heading">{{ section.settings.heading | default: 'The Glacial Recovery Trio' }}</h2>
    <p class="hp56-offer__desc">{{ section.settings.description | default: 'Save 30% on our signature Arctic collection — cloudberry bio-serum, birch sap hydrator, and glacial spring mist.' }}</p>
    <a href="{{ section.settings.btn_url | default: '/collections/all' }}" class="hp56-offer__btn">{{ section.settings.btn_label | default: 'Claim Arctic Trio' }} &rarr;</a>
  </div>
  <div class="hp56-offer__img-wrap">
    {%- if section.settings.image != blank -%}<img height="{{ section.settings.image.height }}" width="{{ section.settings.image.width }}" src="{{ section.settings.image | image_url: width: 800 }}" class="hp56-offer__img" alt="{{ section.settings.heading }}" loading="lazy">
    {%- else -%}{{ 'product-1' | placeholder_svg_tag: 'hp56-offer__img' }}{%- endif -%}
  </div>
</div>
{% schema %}
{
  "name": "HP56 Offer",
  "class": "section-hp56-offer",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "❄️ ARCTIC RITUAL" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Glacial Recovery Trio" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Save 30% on our signature Arctic collection." },
    { "type": "text", "id": "btn_label", "label": "Button Label", "default": "Claim Arctic Trio" },
    { "type": "url", "id": "btn_url", "label": "Button URL" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 80 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "presets": [{ "name": "HP56 Offer" }]
}
{% endschema %}
