{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#FFFF00'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 80px 0;
    overflow: hidden;
    border-bottom: 4px solid #000;
  }
  
  .hp16-insta-container-{{ section_id }} {
    max-width: 100vw;
  }
  
  .hp16-insta-header-{{ section_id }} {
    text-align: center;
    margin-bottom: 50px;
  }
  
  .hp16-insta-title-{{ section_id }} {
    font-family: 'Arial Black', Impact, sans-serif;
    font-size: clamp(3rem, 5vw, 5rem);
    text-transform: uppercase;
    color: #FFF;
    -webkit-text-stroke: 2px #000;
    text-shadow: 5px 5px 0 #FF00FF;
    margin: 0;
    transform: rotate(-1deg);
  }
  
  .hp16-insta-scroll-{{ section_id }} {
    display: flex;
    gap: 20px;
    padding: 20px;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .hp16-insta-scroll-{{ section_id }}::-webkit-scrollbar {
    display: none;
  }
  
  .hp16-insta-item-{{ section_id }} {
    flex: 0 0 300px;
    height: 300px;
    background: #00FFFF;
    border: 4px solid #000;
    border-radius: 20px;
    position: relative;
    overflow: hidden;
    box-shadow: 8px 8px 0 #000;
    transform: rotate(calc(-3deg + 6deg * var(--rand)));
    transition: transform 0.3s ease;
  }
  
  .hp16-insta-item-{{ section_id }}:hover {
    transform: scale(1.05) rotate(0deg);
    z-index: 10;
  }
  
  .hp16-insta-image-{{ section_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .hp16-insta-overlay-{{ section_id }} {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(255,0,255,0.8);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  
  .hp16-insta-item-{{ section_id }}:hover .hp16-insta-overlay-{{ section_id }} {
    opacity: 1;
  }
  
  .hp16-insta-overlay-{{ section_id }} svg {
    width: 50px;
    height: 50px;
    color: #FFF;
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 60px 0;
    }
    .hp16-insta-item-{{ section_id }} {
      flex: 0 0 250px;
      height: 250px;
    }
  }
</style>

<div class="hp16-insta-container-{{ section_id }}">
  <div class="hp16-insta-header-{{ section_id }}">
    <h2 class="hp16-insta-title-{{ section_id }}">@{{ section.settings.handle | default: 'Y2KGIRLS' }}</h2>
  </div>
  
  <div class="hp16-insta-scroll-{{ section_id }}">
    {% for i in (1..6) %}
      <a href="#" class="hp16-insta-item-{{ section_id }}" style="--rand: {% cycle 0.2, 0.8, 0.1, 0.9, 0.4, 0.6 %};">
        <div class="hp16-insta-image-{{ section_id }}" style="background: repeating-linear-gradient(45deg, #EFEFEF, #EFEFEF 12px, #E6E6E6 12px, #E6E6E6 24px);"></div>
        <div class="hp16-insta-overlay-{{ section_id }}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
        </div>
      </a>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "HP16 Instagram",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFF00"
    },
    {
      "type": "text",
      "id": "handle",
      "label": "Instagram Handle",
      "default": "Y2KGIRLS"
    }
  ],
  "presets": [
    {
      "name": "HP16 Instagram"
    }
  ]
}
{% endschema %}
