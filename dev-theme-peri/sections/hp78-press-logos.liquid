{%- style -%}#shopify-section-{{ section.id }}{background:#fff;padding:22px 0;border-y:1px solid rgba(0,0,0,.06)}.hp78-press{max-width:1280px;margin:0 auto;padding:0 24px;display:flex;gap:30px;justify-content:center;align-items:center;flex-wrap:wrap;opacity:.5;font-weight:800;letter-spacing:2px;font-size:12px}{%- endstyle -%}<div class="hp78-press">{% for block in section.blocks %}<span>{{ block.settings.text }}</span>{% else %}<span>VOGUE</span><span>GQ</span><span>FORBES</span><span>COSMO</span><span>ELLE</span>{% endfor %}</div>{% schema %}{"name":"HP78 Press","blocks":[{"type":"logo","name":"Logo","settings":[{"type":"text","id":"text","label":"Text","default":"VOGUE"}]}]}{% endschema %}