{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#FF00FF'
  assign text_color = section.settings.text_color | default: '#000000'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 120px 20px;
    color: {{ text_color }};
    border-bottom: 3px solid #000;
    text-align: center;
  }
  
  .hp11-brand-story-container-{{ section_id }} {
    max-width: 1000px;
    margin: 0 auto;
    position: relative;
    padding: 60px;
    border: 4px solid #000;
    background: #FFF;
    box-shadow: 15px 15px 0 #000;
  }
  
  .hp11-brand-story-sticker-{{ section_id }} {
    position: absolute;
    top: -40px;
    left: -40px;
    width: 100px;
    height: 100px;
    background: #0000FF;
    border: 3px solid #000;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #FFF;
    font-family: 'Inter', sans-serif;
    font-weight: 900;
    font-size: 1.2rem;
    transform: rotate(-15deg);
    box-shadow: 4px 4px 0 #000;
  }
  
  .hp11-brand-story-heading-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 900;
    text-transform: uppercase;
    margin: 0 0 30px 0;
    letter-spacing: -1.5px;
  }
  
  .hp11-brand-story-text-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.4;
    margin: 0 0 40px 0;
  }
  
  .hp11-brand-story-signature-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: 1.2rem;
    font-weight: 900;
    text-transform: uppercase;
    color: #0000FF;
  }
  
  .hp11-brand-story-btn-{{ section_id }} {
    display: inline-block;
    padding: 16px 50px;
    background: #CCFF00;
    color: #000;
    border: 3px solid #000;
    font-family: 'Inter', sans-serif;
    font-size: 1.2rem;
    font-weight: 900;
    text-transform: uppercase;
    text-decoration: none;
    box-shadow: 6px 6px 0 #000;
    transition: all 0.2s ease;
    margin-top: 30px;
  }
  
  .hp11-brand-story-btn-{{ section_id }}:hover {
    background: #000;
    color: #CCFF00;
    transform: translate(-4px, -4px);
    box-shadow: 10px 10px 0 #000;
  }

  @media (max-width: 768px) {
    .hp11-brand-story-container-{{ section_id }} {
      padding: 40px 20px;
      box-shadow: 8px 8px 0 #000;
    }
    .hp11-brand-story-sticker-{{ section_id }} {
      top: -20px;
      left: -20px;
      width: 80px;
      height: 80px;
      font-size: 1rem;
    }
    .hp11-brand-story-text-{{ section_id }} {
      font-size: 1.2rem;
    }
  }
</style>

<div class="hp11-brand-story-container-{{ section_id }}">
  <div class="hp11-brand-story-sticker-{{ section_id }}">
    EST. 24
  </div>
  
  <h2 class="hp11-brand-story-heading-{{ section_id }}">{{ section.settings.heading | default: 'WE DONT MISS' }}</h2>
  <div class="hp11-brand-story-text-{{ section_id }}">
    {{ section.settings.text | default: 'Crafted for the streets. We bring high-end materials into everyday brutalist wear. Stop blending in.' }}
  </div>
  <div class="hp11-brand-story-signature-{{ section_id }}">
    {{ section.settings.signature | default: '— THE FOUNDERS' }}
  </div>
  
  {% if section.settings.button_label != blank %}
    <a href="{{ section.settings.button_link | default: '#' }}" class="hp11-brand-story-btn-{{ section_id }}">
      {{ section.settings.button_label }}
    </a>
  {% endif %}
</div>

{% schema %}
{
  "name": "HP11 Brand Story",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Outer Background Color",
      "default": "#FF00FF"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "WE DONT MISS"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Crafted for the streets. We bring high-end materials into everyday brutalist wear. Stop blending in."
    },
    {
      "type": "text",
      "id": "signature",
      "label": "Signature",
      "default": "— THE FOUNDERS"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "OUR MANIFESTO"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "HP11 Brand Story"
    }
  ]
}
{% endschema %}
