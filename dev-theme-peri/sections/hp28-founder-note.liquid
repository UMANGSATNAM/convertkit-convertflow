{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Chakra+Petch:ital,wght@0,300;0,400;0,600;0,700;1,400&family=Press+Start+2P&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --cyan: {{ section.settings.cyan_color }};
    --magenta: {{ section.settings.magenta_color }};
    
    --win-bg: #c0c0c0;
    --win-dark: #000000;
    --win-light: #ffffff;
    --win-border-light: #dfdfdf;
    --win-border-dark: #808080;
    --win-title-bg: #000080;
    
    --font-heading: 'Press Start 2P', cursive;
    --font-body: 'Chakra Petch', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    position: relative;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.8 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.8 | round }}px;
    }
  }

  .hp28-founder-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    align-items: center;
    gap: 60px;
  }

  {% if section.settings.image_position == 'right' %}
    .hp28-founder-wrapper {
      flex-direction: row-reverse;
    }
  {% endif %}

  @media screen and (max-width: 992px) {
    .hp28-founder-wrapper {
      flex-direction: column;
      gap: 40px;
    }
  }

  @media screen and (max-width: 768px) {
    .hp28-founder-wrapper {
      padding: 0 20px;
    }
  }

  .hp28-founder__image-col {
    flex: 1;
    width: 100%;
    position: relative;
  }

  /* Retro Notepad Container */
  .hp28-founder__image-window {
    background: var(--win-bg);
    border-top: 2px solid var(--win-light);
    border-left: 2px solid var(--win-light);
    border-right: 2px solid var(--win-dark);
    border-bottom: 2px solid var(--win-dark);
    padding: 3px;
    box-shadow: 10px 10px 0 var(--magenta);
  }

  .hp28-founder__title-bar {
    background: var(--win-title-bg);
    color: var(--win-light);
    padding: 4px 8px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 700;
  }

  .hp28-founder__title-btns {
    display: flex;
    gap: 4px;
  }
  .hp28-founder__title-btn {
    width: 14px; height: 14px;
    background: var(--win-bg);
    border-top: 1px solid var(--win-light);
    border-left: 1px solid var(--win-light);
    border-right: 1px solid var(--win-dark);
    border-bottom: 1px solid var(--win-dark);
  }

  .hp28-founder__image-inner {
    aspect-ratio: 3/4;
    background: #000;
    border-top: 2px solid var(--win-border-dark);
    border-left: 2px solid var(--win-border-dark);
    border-right: 2px solid var(--win-light);
    border-bottom: 2px solid var(--win-light);
    overflow: hidden;
    position: relative;
  }

  .hp28-founder__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Duotone cyan/magenta look */
    filter: sepia(1) hue-rotate(240deg) saturate(300%) contrast(1.2);
  }

  .hp28-founder__text-col {
    flex: 1.2;
    background: #000;
    border: 2px solid var(--cyan);
    padding: 40px;
    position: relative;
  }
  
  .hp28-founder__text-col::before {
    content: '';
    position: absolute;
    top: 5px; left: 5px; right: -5px; bottom: -5px;
    border: 2px dashed var(--magenta);
    pointer-events: none;
    z-index: 0;
  }

  .hp28-founder__content {
    position: relative;
    z-index: 1;
  }

  .hp28-founder__header {
    margin-bottom: 30px;
    border-bottom: 2px solid var(--cyan);
    padding-bottom: 15px;
  }

  .hp28-founder__title {
    font-family: var(--font-heading);
    font-size: clamp(20px, 2.5vw, {{ section.settings.title_size }}px);
    color: var(--cyan);
    margin: 0 0 10px;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .hp28-founder__subtitle {
    font-family: var(--font-body);
    font-size: 16px;
    color: var(--text-color);
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .hp28-founder__text {
    font-family: var(--font-body);
    font-size: clamp(16px, 1.8vw, 18px);
    color: var(--text-color);
    line-height: 1.6;
    margin: 0 0 40px;
  }

  .hp28-founder__text p {
    margin: 0 0 20px;
  }
  .hp28-founder__text p:last-child {
    margin: 0;
  }

  .hp28-founder__footer {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
  }

  .hp28-founder__signature {
    font-family: var(--font-heading);
    font-size: 14px;
    color: var(--magenta);
    margin: 0;
  }
  .hp28-founder__signature::after {
    content: '█';
    animation: hp28Blink 1s infinite;
  }

  @keyframes hp28Blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  .hp28-founder__date {
    font-family: var(--font-body);
    font-size: 12px;
    color: var(--text-color);
    opacity: 0.7;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp28-founder-wrapper" id="HP28Founder-{{ section.id }}">
  <div class="hp28-founder__image-col">
    <div class="hp28-founder__image-window">
      <div class="hp28-founder__title-bar">
        <span>PROFILE_PIC.BMP</span>
        <div class="hp28-founder__title-btns">
          <div class="hp28-founder__title-btn"></div>
          <div class="hp28-founder__title-btn"></div>
          <div class="hp28-founder__title-btn"></div>
        </div>
      </div>
      <div class="hp28-founder__image-inner">
        {%- if section.settings.image != blank -%}
          <img height="{{ section.settings.image.height }}" width="{{ section.settings.image.width }}" src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.title | escape }}" class="hp28-founder__image" loading="lazy">
        {%- else -%}
          {{ 'portrait-1' | placeholder_svg_tag: 'hp28-founder__image' }}
        {%- endif -%}
      </div>
    </div>
  </div>

  <div class="hp28-founder__text-col">
    <div class="hp28-founder__content">
      <div class="hp28-founder__header">
        {%- if section.settings.title != blank -%}
          <h2 class="hp28-founder__title">{{ section.settings.title }}</h2>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <p class="hp28-founder__subtitle">{{ section.settings.subtitle }}</p>
        {%- endif -%}
      </div>

      {%- if section.settings.text != blank -%}
        <div class="hp28-founder__text">{{ section.settings.text }}</div>
      {%- endif -%}

      <div class="hp28-founder__footer">
        {%- if section.settings.signature != blank -%}
          <div class="hp28-founder__signature">{{ section.settings.signature }}</div>
        {%- endif -%}
        <div class="hp28-founder__date">TIMESTAMP: {{ 'now' | date: '%Y-%m-%d %H:%M' }}</div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "HP28 - Y2K Founder Note",
  "class": "section-hp28-founder-note",
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "INITIALIZATION SEQ"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "MESSAGE FROM THE CREATOR"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>When we first booted up this project, the goal was simple: override the mundane and introduce a new protocol for living. The analog world was too slow.</p><p>We built this infrastructure to empower those who want to move faster, think sharper, and look beyond the horizon. Welcome to the grid.</p>"
    },
    {
      "type": "text",
      "id": "signature",
      "label": "Signature",
      "default": "SYSTEM_ADMIN"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1200
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 20,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 32
    },
    {
      "type": "header",
      "content": "Y2K Cyber Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (Deep Purple)",
      "default": "#1C0B2B"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Base Text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "cyan_color",
      "label": "Cyan Accent",
      "default": "#00FFFF"
    },
    {
      "type": "color",
      "id": "magenta_color",
      "label": "Magenta Accent",
      "default": "#FF00FF"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 100
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP28 - Y2K Founder Note"
    }
  ]
}
{% endschema %}
