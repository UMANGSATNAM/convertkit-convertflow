{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400;1,600&family=Oswald:wght@300;400;500&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --border-color: {{ section.settings.border_color }};
    
    --font-serif: 'Playfair Display', serif;
    --font-sans: 'Oswald', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    border-bottom: 1px solid var(--border-color);
  }

  .hp36-nl-wrapper {
    max-width: 1200px;
    margin: 0 auto;
    padding: 60px 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    border: 1px solid var(--border-color);
    background: var(--bg-color);
  }

  @media screen and (max-width: 768px) {
    .hp36-nl-wrapper {
      padding: 40px 20px;
      border: none;
    }
  }

  .hp36-nl__subtitle {
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--text-color);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    margin-bottom: 20px;
  }

  .hp36-nl__title {
    font-family: var(--font-serif);
    font-size: clamp(40px, 6vw, {{ section.settings.title_size }}px);
    line-height: 1;
    color: var(--text-color);
    margin: 0 0 20px;
    text-transform: uppercase;
  }

  .hp36-nl__title em {
    font-style: italic;
    text-transform: lowercase;
  }

  .hp36-nl__desc {
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--text-color);
    max-width: 500px;
    margin: 0 0 40px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .hp36-nl__form {
    width: 100%;
    max-width: 500px;
    display: flex;
    position: relative;
    border-bottom: 1px solid var(--text-color);
  }

  .hp36-nl__input {
    flex: 1;
    background: transparent;
    border: none;
    padding: 15px 0;
    font-family: var(--font-sans);
    font-size: 16px;
    color: var(--text-color);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    outline: none;
  }
  
  .hp36-nl__input::placeholder {
    color: var(--text-color);
    opacity: 0.5;
  }

  .hp36-nl__btn {
    background: transparent;
    border: none;
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--text-color);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    cursor: pointer;
    padding: 0 10px;
    transition: opacity 0.3s ease;
  }

  .hp36-nl__btn:hover {
    opacity: 0.5;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp36-nl-wrapper" id="HP36Newsletter-{{ section.id }}">
  {%- if section.settings.subtitle != blank -%}
    <div class="hp36-nl__subtitle">{{ section.settings.subtitle }}</div>
  {%- endif -%}
  
  <h2 class="hp36-nl__title">{{ section.settings.title | replace: 'Archive', '<em>Archive</em>' }}</h2>
  
  {%- if section.settings.text != blank -%}
    <div class="hp36-nl__desc">{{ section.settings.text }}</div>
  {%- endif -%}

  {%- form 'customer', class: 'hp36-nl__form' -%}
    <input type="hidden" name="contact[tags]" value="newsletter">
    <input 
      type="email" 
      name="contact[email]" 
      class="hp36-nl__input" 
      placeholder="{{ section.settings.placeholder }}" 
      required
    >
    <button type="submit" class="hp36-nl__btn">{{ section.settings.btn_label }}</button>
  {%- endform -%}
</div>

{% schema %}
{
  "name": "HP36 - Editorial Mail",
  "class": "section-hp36-newsletter",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Join the Archive"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "THE INNER CIRCLE"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Subscribe to receive early access to new collections, exclusive editorials, and invitations to private events."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input Placeholder",
      "default": "EMAIL ADDRESS"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "Subscribe"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 64
    },
    {
      "type": "header",
      "content": "Editorial Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 100
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP36 - Editorial Mail"
    }
  ]
}
{% endschema %}
