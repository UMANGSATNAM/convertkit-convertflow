{%- style -%}
  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --font-heading: 'Playfair Display', serif;
    --font-body: 'Jost', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }

  .hp21-insta-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp21-insta-wrapper {
      padding: 0 20px;
    }
  }

  .hp21-insta__header {
    text-align: center;
    margin-bottom: {{ section.settings.header_margin }}px;
  }

  .hp21-insta__subtitle {
    font-family: var(--font-body);
    font-size: {{ section.settings.subtitle_size }}px;
    font-weight: 300;
    color: var(--accent-color);
    text-transform: uppercase;
    letter-spacing: 4px;
    margin: 0 0 16px;
  }

  .hp21-insta__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    font-weight: 400;
    color: var(--text-color);
    margin: 0;
    line-height: 1.2;
  }
  
  .hp21-insta__title em {
    font-style: italic;
    color: var(--accent-color);
  }

  .hp21-insta__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.desktop_columns }}, 1fr);
    gap: {{ section.settings.gap }}px;
  }

  @media screen and (max-width: 992px) {
    .hp21-insta__grid {
      grid-template-columns: repeat({{ section.settings.tablet_columns }}, 1fr);
    }
  }

  @media screen and (max-width: 768px) {
    .hp21-insta__grid {
      grid-template-columns: repeat({{ section.settings.mobile_columns }}, 1fr);
      gap: {{ section.settings.mobile_gap }}px;
    }
  }

  .hp21-insta__item {
    position: relative;
    aspect-ratio: 1/1;
    overflow: hidden;
    display: block;
    border: 1px solid rgba(255,255,255,0.05);
    background: #111;
  }

  .hp21-insta__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s ease, filter 0.8s ease;
  }

  .hp21-insta__item:hover .hp21-insta__image {
    transform: scale(1.08);
    filter: brightness(0.6);
  }

  .hp21-insta__icon {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    color: #fff;
    opacity: 0;
    transition: all 0.4s ease;
    z-index: 2;
  }

  .hp21-insta__icon svg {
    width: 32px;
    height: 32px;
    fill: currentColor;
  }

  .hp21-insta__item:hover .hp21-insta__icon {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1.1);
  }

  .hp21-insta__footer {
    text-align: center;
    margin-top: 60px;
  }

  .hp21-insta__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 16px 40px;
    background: transparent;
    color: var(--text-color);
    border: 1px solid var(--accent-color);
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 14px;
    letter-spacing: 2px;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.4s ease;
  }

  .hp21-insta__btn svg {
    width: 16px;
    height: 16px;
    fill: currentColor;
  }

  .hp21-insta__btn:hover {
    background: var(--accent-color);
    color: #000;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp21-insta-wrapper" id="HP21Instagram-{{ section.id }}">
  
  <div class="hp21-insta__header">
    {%- if section.settings.subtitle != blank -%}
      <p class="hp21-insta__subtitle">{{ section.settings.subtitle | escape }}</p>
    {%- endif -%}
    {%- if section.settings.title != blank -%}
      <h2 class="hp21-insta__title">{{ section.settings.title }}</h2>
    {%- endif -%}
  </div>

  <div class="hp21-insta__grid">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.link | default: '#' }}" class="hp21-insta__item" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          <img src="{{ block.settings.image | image_url: width: 600 }}" alt="Instagram Image" class="hp21-insta__image" loading="lazy">
        {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'hp21-insta__image' }}
        {%- endif -%}
        
        <div class="hp21-insta__icon">
          <svg viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
        </div>
      </a>
    {%- endfor -%}
  </div>

  {%- if section.settings.btn_text != blank -%}
    <div class="hp21-insta__footer">
      <a href="{{ section.settings.btn_link | default: '#' }}" class="hp21-insta__btn">
        <svg viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
        {{ section.settings.btn_text | escape }}
      </a>
    </div>
  {%- endif -%}

</div>

{% schema %}
{
  "name": "HP21 - Luxury Instagram",
  "class": "section-hp21-instagram",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "SOCIAL DIARY"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Heading",
      "default": "<p>Join the <em>Inner Circle</em></p>"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "FOLLOW @LUXURYBRAND"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1400
    },
    {
      "type": "range",
      "id": "header_margin",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Margin Below Header",
      "default": 60
    },
    {
      "type": "range",
      "id": "desktop_columns",
      "min": 3,
      "max": 6,
      "step": 1,
      "label": "Desktop Columns",
      "default": 5
    },
    {
      "type": "range",
      "id": "tablet_columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Tablet Columns",
      "default": 3
    },
    {
      "type": "range",
      "id": "mobile_columns",
      "min": 1,
      "max": 3,
      "step": 1,
      "label": "Mobile Columns",
      "default": 2
    },
    {
      "type": "range",
      "id": "gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Grid Gap",
      "default": 12
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Mobile Grid Gap",
      "default": 8
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 48
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Subtitle Size",
      "default": 12
    },
    {
      "type": "header",
      "content": "Luxury Styling"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#0A0A0A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#D4AF37"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 100
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Instagram Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Post Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP21 - Luxury Instagram",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
