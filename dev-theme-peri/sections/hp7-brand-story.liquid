{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#2b302a'
  assign text_color = section.settings.text_color | default: '#f7f4ed'
  assign accent_color = section.settings.accent_color | default: '#e8ecd6'
  assign heading = section.settings.heading | default: 'Our Philosophy'
  assign text = section.settings.text | default: 'We believe that great design should not come at the cost of our planet. Every piece we create is a step towards a more sustainable future.'
  assign image = section.settings.image
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    color: {{ text_color }};
    padding: 120px 20px;
    position: relative;
    overflow: hidden;
  }
  
  .hp7-story-container-{{ section_id }} {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }
  
  .hp7-story-content-{{ section_id }} {
    position: relative;
    z-index: 2;
  }
  
  .hp7-story-label-{{ section_id }} {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.9rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: {{ accent_color }};
    margin-bottom: 20px;
    display: block;
  }
  
  .hp7-story-heading-{{ section_id }} {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 500;
    margin: 0 0 30px 0;
    line-height: 1.1;
  }
  
  .hp7-story-text-{{ section_id }} {
    font-family: 'DM Sans', sans-serif;
    font-size: clamp(1.1rem, 2vw, 1.3rem);
    line-height: 1.7;
    opacity: 0.9;
    margin: 0 0 40px 0;
  }
  
  .hp7-story-btn-{{ section_id }} {
    display: inline-block;
    border: 1px solid {{ text_color }};
    color: {{ text_color }};
    padding: 15px 35px;
    border-radius: 30px;
    font-family: 'DM Sans', sans-serif;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s ease;
  }
  
  .hp7-story-btn-{{ section_id }}:hover {
    background-color: {{ text_color }};
    color: {{ bg_color }};
  }
  
  .hp7-story-image-col-{{ section_id }} {
    position: relative;
  }
  
  .hp7-story-image-wrapper-{{ section_id }} {
    position: relative;
    aspect-ratio: 4/5;
    border-radius: 30px 200px 30px 200px; /* Organic leaf shape */
    overflow: hidden;
    background: #3a4239;
    box-shadow: 0 30px 60px rgba(0,0,0,0.3);
  }
  
  .hp7-story-image-wrapper-{{ section_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.8;
  }
  
  /* Abstract lines */
  .hp7-story-lines-{{ section_id }} {
    position: absolute;
    top: -40px;
    right: -40px;
    width: 200px;
    height: 200px;
    background-image: radial-gradient({{ accent_color | color_modify: 'alpha', 0.2 }} 1px, transparent 1px);
    background-size: 20px 20px;
    z-index: 0;
    border-radius: 50%;
  }

  @media (max-width: 992px) {
    .hp7-story-container-{{ section_id }} {
      grid-template-columns: 1fr;
      gap: 50px;
    }
    .hp7-story-image-wrapper-{{ section_id }} {
      max-width: 600px;
      margin: 0 auto;
    }
  }
</style>

<div class="hp7-story-container-{{ section_id }}">
  <div class="hp7-story-content-{{ section_id }}">
    <span class="hp7-story-label-{{ section_id }}">Our Story</span>
    <h2 class="hp7-story-heading-{{ section_id }}">{{ heading }}</h2>
    <p class="hp7-story-text-{{ section_id }}">{{ text }}</p>
    <a href="#" class="hp7-story-btn-{{ section_id }}">Read the Manifesto</a>
  </div>
  
  <div class="hp7-story-image-col-{{ section_id }}">
    <div class="hp7-story-lines-{{ section_id }}"></div>
    <div class="hp7-story-image-wrapper-{{ section_id }}">
      {% if image != blank %}
        <img src="{{ image | image_url: width: 1000 }}" alt="Our Story" loading="lazy" width="600" height="800">
      {% else %}
        <div style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; color:#888;">
          STORY IMAGE
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "HP7 Brand Story",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#2b302a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#f7f4ed"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#e8ecd6"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Philosophy"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "We believe that great design should not come at the cost of our planet. Every piece we create is a step towards a more sustainable future."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    }
  ],
  "presets": [
    {
      "name": "HP7 Brand Story"
    }
  ]
}
{% endschema %}
