{% comment %}
  FB04 Collection CTA — Reversed split (text left, image right) with button
{% endcomment %}

<style>
  .fb04-collect {
    padding: 100px 60px;
    background: #fff;
  }
  .fb04-collect__inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }
  .fb04-collect__text h2 {
    font-family: 'Big Shoulders Display', sans-serif;
    font-weight: 700;
    font-size: 42px;
    color: #282A2F;
    line-height: 1.1;
    margin-bottom: 20px;
  }
  .fb04-collect__text p {
    font-family: 'Host Grotesk', sans-serif;
    font-weight: 400;
    font-size: 16px;
    color: #7B818E;
    line-height: 1.7;
    margin-bottom: 32px;
  }
  .fb04-collect__btn {
    display: inline-block;
    font-family: 'Host Grotesk', sans-serif;
    font-weight: 600;
    font-size: 15px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 14px 36px;
    background: #0066FF;
    color: #fff;
    border-radius: 100px;
    text-decoration: none;
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .fb04-collect__btn:hover {
    background: #2E82FF;
    transform: translateY(-2px);
  }
  .fb04-collect__image {
    border-radius: 12px;
    overflow: hidden;
    aspect-ratio: 1 / 1;
  }
  .fb04-collect__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .fb04-collect__image .placeholder-collect {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #3D4047 0%, #282A2F 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255,255,255,0.1);
    font-family: 'Big Shoulders Display', sans-serif;
    font-size: 30px;
    text-transform: uppercase;
    letter-spacing: 4px;
  }

  @media (max-width: 809px) {
    .fb04-collect {
      padding: 60px 24px;
    }
    .fb04-collect__inner {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .fb04-collect__text {
      order: 1;
    }
    .fb04-collect__image {
      order: 2;
    }
    .fb04-collect__text h2 {
      font-size: 32px;
    }
  }
  @media (min-width: 810px) and (max-width: 1199px) {
    .fb04-collect {
      padding: 80px 40px;
    }
    .fb04-collect__inner {
      gap: 40px;
    }
    .fb04-collect__text h2 {
      font-size: 36px;
    }
  }
</style>

<section class="fb04-collect">
  <div class="fb04-collect__inner">
    <div class="fb04-collect__text">
      <h2>{{ section.settings.heading | default: 'Elevate Your Street Game' }}</h2>
      <p>{{ section.settings.body | default: "From bold graphics to everyday essentials, explore our latest drops and signature pieces designed for the culture." }}</p>
      <a href="{{ section.settings.cta_link | default: '#' }}" class="fb04-collect__btn">
        {{ section.settings.cta_text | default: 'Shop collections' }}
      </a>
    </div>
    <div class="fb04-collect__image">
      {% if section.settings.image != blank %}
        <img src="{{ section.settings.image | image_url: width: 800 }}"
             alt="{{ section.settings.heading }}" loading="lazy" width="800" height="800">
      {% else %}
        <div class="placeholder-collect">Collections</div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FB04 Collection CTA",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Elevate Your Street Game" },
    { "type": "textarea", "id": "body", "label": "Body Text", "default": "From bold graphics to everyday essentials, explore our latest drops and signature pieces designed for the culture." },
    { "type": "text", "id": "cta_text", "label": "CTA Text", "default": "Shop collections" },
    { "type": "url", "id": "cta_link", "label": "CTA Link" }
  ],
  "presets": [{ "name": "FB04 Collection CTA" }]
}
{% endschema %}
