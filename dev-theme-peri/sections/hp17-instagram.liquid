{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#0A0A0A'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 100px 0;
    border-bottom: 1px solid rgba(0, 255, 65, 0.3);
  }
  
  .hp17-ig-header-{{ section_id }} {
    text-align: center;
    margin-bottom: 50px;
    padding: 0 20px;
  }
  
  .hp17-ig-title-{{ section_id }} {
    font-family: 'Arial Black', sans-serif;
    font-size: clamp(2.5rem, 5vw, 4rem);
    text-transform: uppercase;
    color: #FFF;
    margin: 0 0 10px 0;
    line-height: 1;
  }
  
  .hp17-ig-subtitle-{{ section_id }} {
    font-family: 'Courier New', Courier, monospace;
    font-size: 1rem;
    color: #00FF41;
  }
  
  .hp17-ig-grid-{{ section_id }} {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
  }
  
  .hp17-ig-item-{{ section_id }} {
    position: relative;
    padding-top: 100%;
    overflow: hidden;
    border: 1px solid rgba(0, 255, 65, 0.2);
    display: block;
  }
  
  .hp17-ig-image-{{ section_id }} {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover;
    filter: contrast(120%) brightness(80%);
    transition: all 0.5s ease;
  }
  
  .hp17-ig-overlay-{{ section_id }} {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(184, 0, 255, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
    backdrop-filter: blur(2px);
  }
  
  .hp17-ig-overlay-{{ section_id }} svg {
    width: 40px; height: 40px;
    color: #FFF;
  }
  
  .hp17-ig-item-{{ section_id }}:hover .hp17-ig-image-{{ section_id }} {
    transform: scale(1.1);
    filter: contrast(100%) brightness(100%);
  }
  
  .hp17-ig-item-{{ section_id }}:hover .hp17-ig-overlay-{{ section_id }} {
    opacity: 1;
  }

  @media (max-width: 1200px) {
    .hp17-ig-grid-{{ section_id }} {
      grid-template-columns: repeat(4, 1fr);
    }
    .hp17-ig-item-{{ section_id }}:nth-child(5) {
      display: none;
    }
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 60px 0;
    }
    .hp17-ig-grid-{{ section_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
    .hp17-ig-item-{{ section_id }}:nth-child(3),
    .hp17-ig-item-{{ section_id }}:nth-child(4) {
      display: none;
    }
  }
</style>

<div class="hp17-ig-header-{{ section_id }}">
  <h2 class="hp17-ig-title-{{ section_id }}">{{ section.settings.title | default: 'USER_SUBMISSIONS' }}</h2>
  <div class="hp17-ig-subtitle-{{ section_id }}">{{ section.settings.subtitle | default: '@CYBERTECH_OFFICIAL' }}</div>
</div>

<div class="hp17-ig-grid-{{ section_id }}">
  {% for block in section.blocks limit: 5 %}
    <a href="{{ block.settings.link | default: '#' }}" class="hp17-ig-item-{{ section_id }}" {{ block.shopify_attributes }}>
      {% if block.settings.image != blank %}
        <img height="{{ block.settings.image.height }}" width="{{ block.settings.image.width }}" src="{{ block.settings.image | image_url: width: 600 }}" class="hp17-ig-image-{{ section_id }}" loading="lazy" alt="Instagram">
      {% else %}
        <div class="hp17-ig-image-{{ section_id }}" style="background: repeating-linear-gradient(45deg, #EFEFEF, #EFEFEF 12px, #E6E6E6 12px, #E6E6E6 24px);"></div>
      {% endif %}
      <div class="hp17-ig-overlay-{{ section_id }}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
      </div>
    </a>
  {% endfor %}
</div>

{% schema %}
{
  "name": "HP17 Instagram",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#0A0A0A"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "USER_SUBMISSIONS"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "@CYBERTECH_OFFICIAL"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Instagram Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP17 Instagram",
      "blocks": [
        { "type": "image" }, { "type": "image" }, { "type": "image" }, { "type": "image" }, { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
