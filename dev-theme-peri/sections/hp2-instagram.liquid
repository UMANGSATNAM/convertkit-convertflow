{%- liquid
  assign bg_color = section.settings.bg_color | default: '#ffffff'
  assign text_color = section.settings.text_color | default: '#000000'
  
  assign padding_top_desktop = section.settings.padding_top_desktop
  assign padding_bottom_desktop = section.settings.padding_bottom_desktop
  assign padding_top_mobile = section.settings.padding_top_mobile
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile
-%}

<style>
  #shopify-section-{{ section.id }} {
    --hp2-ig-bg: {{ bg_color }};
    --hp2-ig-text: {{ text_color }};
    
    --hp2-ig-pt-desk: {{ padding_top_desktop }}px;
    --hp2-ig-pb-desk: {{ padding_bottom_desktop }}px;
    --hp2-ig-pt-mob: {{ padding_top_mobile }}px;
    --hp2-ig-pb-mob: {{ padding_bottom_mobile }}px;
  }

  .hp2-fashion-ig-{{ section.id }} {
    padding-top: var(--hp2-ig-pt-desk);
    padding-bottom: var(--hp2-ig-pb-desk);
    background-color: var(--hp2-ig-bg);
    color: var(--hp2-ig-text);
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
  }

  .hp2-ig-inner {
    max-width: 100%;
    /* Full bleed option */
    {% if section.settings.full_width %}
      padding: 0;
    {% else %}
      max-width: 1600px;
      margin: 0 auto;
      padding: 0 40px;
    {% endif %}
  }

  .hp2-ig-header {
    text-align: center;
    margin-bottom: 40px;
    {% if section.settings.full_width %}
      padding: 0 40px;
    {% endif %}
  }

  .hp2-ig-title {
    font-size: clamp(32px, 5vw, 64px);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -1.5px;
    margin: 0 0 10px 0;
    line-height: 1;
  }

  .hp2-ig-handle {
    font-size: 16px;
    font-weight: 800;
    text-decoration: none;
    color: var(--hp2-ig-text);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: opacity 0.3s ease;
  }
  .hp2-ig-handle:hover {
    opacity: 0.7;
  }

  /* Grid Layout */
  .hp2-ig-grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: {{ section.settings.grid_gap }}px;
  }

  /* IG Item */
  .hp2-ig-item {
    position: relative;
    aspect-ratio: 1/1;
    overflow: hidden;
    background: #e0e0e0;
    display: block;
    group;
  }

  .hp2-ig-media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .hp2-ig-item:hover .hp2-ig-media {
    transform: scale(1.08);
  }

  /* Overlay */
  .hp2-ig-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.4s ease;
    color: #fff;
  }
  .hp2-ig-item:hover .hp2-ig-overlay {
    opacity: 1;
  }

  .hp2-ig-icon {
    width: 32px;
    height: 32px;
    fill: currentColor;
    transform: scale(0.5);
    transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }
  .hp2-ig-item:hover .hp2-ig-icon {
    transform: scale(1);
  }

  /* Responsive Adjustments */
  @media screen and (max-width: 1024px) {
    .hp2-ig-grid {
      grid-template-columns: repeat({{ section.settings.columns_tablet }}, 1fr);
    }
  }

  @media screen and (max-width: 768px) {
    .hp2-fashion-ig-{{ section.id }} {
      padding-top: var(--hp2-ig-pt-mob);
      padding-bottom: var(--hp2-ig-pb-mob);
    }
    .hp2-ig-inner {
      {% if section.settings.full_width %}
        padding: 0;
      {% else %}
        padding: 0 20px;
      {% endif %}
    }
    .hp2-ig-header {
      padding: 0 20px;
    }
    .hp2-ig-grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr);
      gap: {{ section.settings.grid_gap_mobile }}px;
    }
  }
</style>

<section class="hp2-fashion-ig-{{ section.id }}" aria-label="Instagram Feed">
  <div class="hp2-ig-inner">
    
    <div class="hp2-ig-header">
      {%- if section.settings.heading != blank -%}
        <h2 class="hp2-ig-title">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.handle != blank -%}
        <a href="{{ section.settings.link | default: '#' }}" class="hp2-ig-handle" target="_blank" rel="noopener">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
          </svg>
          {{ section.settings.handle }}
        </a>
      {%- endif -%}
    </div>

    <div class="hp2-ig-grid">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link | default: '#' }}" class="hp2-ig-item" target="_blank" rel="noopener" {{ block.shopify_attributes }}>
          
          {%- if block.settings.image != blank -%}
            <img height="{{ block.settings.image.height }}" width="{{ block.settings.image.width }}" src="{{ block.settings.image | image_url: width: 600 }}" 
                 srcset="{{ block.settings.image | image_url: width: 400 }} 400w, 
                         {{ block.settings.image | image_url: width: 600 }} 600w, 
                         {{ block.settings.image | image_url: width: 800 }} 800w"
                 sizes="(max-width: 768px) 50vw, 25vw"
                 class="hp2-ig-media" 
                 loading="lazy" 
                 alt="Instagram Post {{ forloop.index }}">
          {%- else -%}
            {%- capture current -%}{% cycle 1, 2, 3, 4, 5, 6 %}{%- endcapture -%}
            {{ 'product-' | append: current | placeholder_svg_tag: 'hp2-ig-media placeholder-svg' }}
          {%- endif -%}

          <div class="hp2-ig-overlay">
            <svg class="hp2-ig-icon" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
          </div>
          
        </a>
      {%- endfor -%}
      
      {%- if section.blocks.size == 0 -%}
        {%- for i in (1..section.settings.columns_desktop) -%}
          <div class="hp2-ig-item">
            {%- capture current -%}{% cycle 1, 2, 3, 4, 5, 6 %}{%- endcapture -%}
            {{ 'product-' | append: current | placeholder_svg_tag: 'hp2-ig-media placeholder-svg' }}
            <div class="hp2-ig-overlay">
              <svg class="hp2-ig-icon" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "HP2 Instagram Grid",
  "tag": "section",
  "class": "section-hp2-ig",
  "settings": [
    {
      "type": "header",
      "content": "Header Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "JOIN THE MOVEMENT"
    },
    {
      "type": "text",
      "id": "handle",
      "label": "Instagram Handle",
      "default": "@BRANDNAME"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Instagram Profile Link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Make grid full width",
      "default": true
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 3, "max": 8, "step": 1,
      "label": "Columns (Desktop)", "default": 5
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "min": 2, "max": 6, "step": 1,
      "label": "Columns (Tablet)", "default": 4
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "min": 1, "max": 3, "step": 1,
      "label": "Columns (Mobile)", "default": 2
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 0, "max": 40, "step": 2, "unit": "px",
      "label": "Grid Gap (Desktop)", "default": 0
    },
    {
      "type": "range",
      "id": "grid_gap_mobile",
      "min": 0, "max": 20, "step": 1, "unit": "px",
      "label": "Grid Gap (Mobile)", "default": 0
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Top (Desktop)", "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Bottom (Desktop)", "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Top (Mobile)", "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Bottom (Mobile)", "default": 0
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "IG Post",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Post Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link to Post"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP2 Instagram Grid (Advanced)",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
