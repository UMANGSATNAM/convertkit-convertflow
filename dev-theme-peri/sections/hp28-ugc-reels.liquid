{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Chakra+Petch:ital,wght@0,300;0,400;0,600;0,700;1,400&family=Press+Start+2P&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --cyan: {{ section.settings.cyan_color }};
    --magenta: {{ section.settings.magenta_color }};
    --green: {{ section.settings.green_color }};
    --font-heading: 'Press Start 2P', cursive;
    --font-body: 'Chakra Petch', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    border-bottom: 2px dashed var(--magenta);
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.8 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.8 | round }}px;
    }
  }

  .hp28-ugc-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp28-ugc-wrapper {
      padding: 0 20px;
    }
  }

  .hp28-ugc__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 40px;
  }

  @media screen and (max-width: 768px) {
    .hp28-ugc__header {
      flex-direction: column;
      align-items: flex-start;
      gap: 15px;
    }
  }

  .hp28-ugc__title {
    font-family: var(--font-heading);
    font-size: clamp(20px, 3vw, {{ section.settings.title_size }}px);
    color: var(--magenta);
    text-shadow: 2px 2px 0 var(--cyan);
    margin: 0;
    text-transform: uppercase;
  }

  .hp28-ugc__subtitle {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 700;
    color: var(--text-color);
    margin: 0;
    padding: 8px 16px;
    border: 2px solid var(--text-color);
    background: #000;
  }

  .hp28-ugc__scroll {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    gap: 30px;
    padding-bottom: 20px;
  }

  .hp28-ugc__scroll::-webkit-scrollbar {
    display: none;
  }

  .hp28-ugc__item {
    flex: 0 0 calc({{ 100.0 | divided_by: section.settings.columns_desktop }}% - 30px);
    scroll-snap-align: start;
    position: relative;
    background: #000;
    border: 3px solid var(--cyan);
    box-shadow: 8px 8px 0 var(--magenta);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    cursor: pointer;
  }

  @media screen and (max-width: 992px) {
    .hp28-ugc__item {
      flex: 0 0 calc(50% - 15px);
    }
  }

  @media screen and (max-width: 768px) {
    .hp28-ugc__item {
      flex: 0 0 75%;
    }
  }

  .hp28-ugc__item:hover {
    transform: translate(-4px, -4px);
    box-shadow: 12px 12px 0 var(--cyan);
    border-color: var(--magenta);
  }

  .hp28-ugc__item-bar {
    background: var(--cyan);
    color: #000;
    padding: 6px 10px;
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 700;
    display: flex;
    justify-content: space-between;
    text-transform: uppercase;
  }

  .hp28-ugc__item:hover .hp28-ugc__item-bar {
    background: var(--magenta);
    color: #fff;
  }

  .hp28-ugc__video-container {
    position: relative;
    aspect-ratio: 9/16;
    background: #111;
    overflow: hidden;
  }

  .hp28-ugc__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(120%) contrast(1.1);
    transition: filter 0.3s ease;
  }

  .hp28-ugc__item:hover .hp28-ugc__image {
    filter: saturate(0%) contrast(2);
  }

  /* Scanline effect on hover */
  .hp28-ugc__video-container::after {
    content: '';
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background: repeating-linear-gradient(
      transparent,
      transparent 2px,
      rgba(255, 0, 255, 0.2) 2px,
      rgba(255, 0, 255, 0.2) 4px
    );
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .hp28-ugc__item:hover .hp28-ugc__video-container::after {
    opacity: 1;
  }

  .hp28-ugc__play {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 60px; height: 60px;
    background: var(--green);
    border: 4px solid #000;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    transition: transform 0.2s ease;
  }

  .hp28-ugc__item:hover .hp28-ugc__play {
    transform: translate(-50%, -50%) scale(1.1);
    background: var(--cyan);
  }

  .hp28-ugc__play svg {
    width: 24px; height: 24px;
    fill: #000;
    margin-left: 4px;
  }

  .hp28-ugc__info {
    position: absolute;
    bottom: 0; left: 0; width: 100%;
    background: rgba(0,0,0,0.8);
    padding: 15px;
    border-top: 2px solid var(--cyan);
    z-index: 2;
  }

  .hp28-ugc__item:hover .hp28-ugc__info {
    border-color: var(--magenta);
  }

  .hp28-ugc__user {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 700;
    color: var(--text-color);
    margin: 0;
    text-transform: uppercase;
  }

  /* Simple Modal */
  .hp28-ugc__modal {
    position: fixed;
    top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(0, 0, 0, 0.9);
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
  .hp28-ugc__modal.is-active {
    opacity: 1;
    pointer-events: auto;
  }
  .hp28-ugc__modal-content {
    width: 90%;
    max-width: 400px;
    aspect-ratio: 9/16;
    background: #000;
    border: 4px solid var(--magenta);
    position: relative;
  }
  .hp28-ugc__modal-close {
    position: absolute;
    top: -20px; right: -20px;
    width: 40px; height: 40px;
    background: var(--cyan);
    color: #000;
    border: 2px solid #000;
    font-family: var(--font-heading);
    font-size: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp28-ugc-wrapper" id="HP28Ugc-{{ section.id }}">
  
  <div class="hp28-ugc__header">
    {%- if section.settings.title != blank -%}
      <h2 class="hp28-ugc__title">{{ section.settings.title }}</h2>
    {%- endif -%}
    {%- if section.settings.subtitle != blank -%}
      <div class="hp28-ugc__subtitle">{{ section.settings.subtitle }}</div>
    {%- endif -%}
  </div>

  <div class="hp28-ugc__scroll">
    {%- for block in section.blocks -%}
      <div class="hp28-ugc__item" {{ block.shopify_attributes }} data-video="{{ block.settings.video_url }}">
        <div class="hp28-ugc__item-bar">
          <span>{{ block.settings.username | default: 'USER_LOG' }}</span>
          <span>.MP4</span>
        </div>
        <div class="hp28-ugc__video-container">
          {%- if block.settings.image != blank -%}
            <img height="{{ block.settings.image.height }}" width="{{ block.settings.image.width }}" src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.username }}" class="hp28-ugc__image" loading="lazy">
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'hp28-ugc__image' }}
          {%- endif -%}
          
          <div class="hp28-ugc__play">
            <svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
          </div>

          <div class="hp28-ugc__info">
            <p class="hp28-ugc__user">@{{ block.settings.username | default: 'anonymous' }}</p>
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>

</div>

<!-- Modal -->
<div class="hp28-ugc__modal" id="HP28UgcModal-{{ section.id }}">
  <div class="hp28-ugc__modal-content">
    <button class="hp28-ugc__modal-close">X</button>
    <div id="HP28UgcModalVideo-{{ section.id }}" style="width: 100%; height: 100%;">
      <!-- Video player injected here -->
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const items = document.querySelectorAll('#HP28Ugc-{{ section.id }} .hp28-ugc__item');
    const modal = document.getElementById('HP28UgcModal-{{ section.id }}');
    const closeBtn = modal ? modal.querySelector('.hp28-ugc__modal-close') : null;
    const videoContainer = document.getElementById('HP28UgcModalVideo-{{ section.id }}');

    if(items.length > 0 && modal && videoContainer) {
      items.forEach(item => {
        item.addEventListener('click', () => {
          // For a real implementation, you'd insert the HTML5 <video> or iframe here based on data-video.
          // Example static insertion for preview:
          videoContainer.innerHTML = '<div style="color:#00FF00;font-family:monospace;padding:20px;">[VIDEO SIGNAL DETECTED...]<br><br>PLAYING STREAM.</div>';
          modal.classList.add('is-active');
        });
      });

      closeBtn.addEventListener('click', () => {
        modal.classList.remove('is-active');
        videoContainer.innerHTML = '';
      });

      modal.addEventListener('click', (e) => {
        if(e.target === modal) {
          modal.classList.remove('is-active');
          videoContainer.innerHTML = '';
        }
      });
    }
  });
</script>

