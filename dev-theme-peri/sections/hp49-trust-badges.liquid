{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp49-trust-bg: {{ section.settings.bg_color | default: '#2E1065' }};
    
    background-color: var(--hp49-trust-bg);
    color: #FFFFFF;
    padding-top: {{ section.settings.padding_top | default: 50 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 50 }}px;
  }

  .hp49-trust__grid {
    max-width: {{ section.settings.container_width | default: 1200 }}px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: 4 }}, 1fr);
    gap: 30px;
    text-align: center;
  }

  .hp49-trust__icon {
    font-size: 30px;
    margin-bottom: 12px;
  }

  .hp49-trust__title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 16px;
    font-weight: 800;
    margin: 0 0 6px;
  }

  .hp49-trust__desc {
    font-size: 13px;
    color: #DDD6FE;
    margin: 0;
  }

  @media screen and (max-width: 992px) {
    .hp49-trust__grid { grid-template-columns: repeat(2, 1fr); }
  }
{%- endstyle -%}

<div class="hp49-trust__grid">
  {%- if section.blocks.size > 0 -%}
    {%- for block in section.blocks -%}
      <div {{ block.shopify_attributes }}>
        <div class="hp49-trust__icon">{{ block.settings.icon | default: '🌸' }}</div>
        <h4 class="hp49-trust__title">{{ block.settings.title }}</h4>
        <p class="hp49-trust__desc">{{ block.settings.description }}</p>
      </div>
    {%- endfor -%}
  {%- else -%}
    <div>
      <div class="hp49-trust__icon">🌸</div>
      <h4 class="hp49-trust__title">100% Alpine Lavender</h4>
      <p class="hp49-trust__desc">Certified French altitude steam harvest.</p>
    </div>
    <div>
      <div class="hp49-trust__icon">✈️</div>
      <h4 class="hp49-trust__title">Express Air DDP</h4>
      <p class="hp49-trust__desc">Pre-paid customs in 180+ nations.</p>
    </div>
    <div>
      <div class="hp49-trust__icon">🛡️</div>
      <h4 class="hp49-trust__title">30-Day Calm Trial</h4>
      <p class="hp49-trust__desc">Risk-free soothing guarantee.</p>
    </div>
    <div>
      <div class="hp49-trust__icon">🔒</div>
      <h4 class="hp49-trust__title">256-Bit SSL Checkout</h4>
      <p class="hp49-trust__desc">Encrypted payment protection.</p>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "HP49 - Lavender Badges",
  "class": "section-hp49-badges",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#2E1065" },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "label": "Desktop Columns", "default": 4 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 100, "step": 5, "unit": "px", "label": "Padding Top", "default": 50 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 100, "step": 5, "unit": "px", "label": "Padding Bottom", "default": 50 },
    { "type": "range", "id": "container_width", "min": 800, "max": 1400, "step": 20, "unit": "px", "label": "Container Width", "default": 1200 }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon", "default": "🌸" },
        { "type": "text", "id": "title", "label": "Title", "default": "100% Alpine Lavender" },
        { "type": "text", "id": "description", "label": "Description", "default": "Certified French altitude steam harvest." }
      ]
    }
  ],
  "presets": [
    { "name": "HP49 - Lavender Badges" }
  ]
}
{% endschema %}
