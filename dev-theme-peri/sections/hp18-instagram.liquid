{%- liquid
  assign sec_id = section.id
  assign bg_color = section.settings.bg_color
  assign text_color = section.settings.text_color
  assign accent_color = section.settings.accent_color
  assign border_color = section.settings.border_color
  assign border_width = section.settings.border_width
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
-%}

<style>
  .hp18-insta-{{ sec_id }} {
    background-color: {{ bg_color }};
    padding-top: {{ padding_top }}px;
    padding-bottom: {{ padding_bottom }}px;
    border-bottom: {{ border_width }}px solid {{ border_color }};
    overflow: hidden;
  }

  .hp18-insta-{{ sec_id }}__header {
    text-align: center;
    margin-bottom: 50px;
    padding: 0 20px;
  }

  .hp18-insta-{{ sec_id }}__title {
    font-family: 'Arial Black', Impact, sans-serif;
    font-size: clamp(32px, 5vw, 64px);
    color: {{ text_color }};
    text-transform: uppercase;
    margin: 0;
    line-height: 1;
    letter-spacing: -1px;
    display: inline-flex;
    align-items: center;
    gap: 15px;
  }

  .hp18-insta-{{ sec_id }}__title-icon {
    color: {{ accent_color }};
    font-family: monospace;
    font-size: 1.2em;
  }

  .hp18-insta-{{ sec_id }}__grid {
    display: flex;
    border-top: {{ border_width }}px solid {{ border_color }};
    border-bottom: {{ border_width }}px solid {{ border_color }};
    background-color: {{ border_color }};
    gap: {{ border_width }}px;
  }

  .hp18-insta-{{ sec_id }}__item {
    flex: 1;
    aspect-ratio: 1;
    position: relative;
    background-color: #eee;
    display: block;
    overflow: hidden;
  }

  .hp18-insta-{{ sec_id }}__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease, filter 0.4s ease;
    filter: saturate(0.8);
  }

  .hp18-insta-{{ sec_id }}__overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(0,0,0,0.6);
    display: flex;
    justify-content: center;
    align-items: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .hp18-insta-{{ sec_id }}__icon {
    font-family: 'Courier New', monospace;
    font-weight: bold;
    color: {{ accent_color }};
    font-size: 24px;
    border: 2px solid {{ accent_color }};
    padding: 10px 20px;
    transform: translateY(20px);
    transition: transform 0.3s ease;
  }

  .hp18-insta-{{ sec_id }}__item:hover .hp18-insta-{{ sec_id }}__img {
    transform: scale(1.1);
    filter: saturate(1.2);
  }

  .hp18-insta-{{ sec_id }}__item:hover .hp18-insta-{{ sec_id }}__overlay {
    opacity: 1;
  }

  .hp18-insta-{{ sec_id }}__item:hover .hp18-insta-{{ sec_id }}__icon {
    transform: translateY(0);
  }

  @media screen and (max-width: 992px) {
    .hp18-insta-{{ sec_id }}__grid { flex-wrap: wrap; }
    .hp18-insta-{{ sec_id }}__item { flex: 0 0 calc(33.333% - {{ border_width }}px); }
  }

  @media screen and (max-width: 600px) {
    .hp18-insta-{{ sec_id }}__item { flex: 0 0 calc(50% - {{ border_width }}px); }
  }
</style>

<section class="hp18-insta-{{ sec_id }}">
  
  <div class="hp18-insta-{{ sec_id }}__header">
    <h2 class="hp18-insta-{{ sec_id }}__title">
      <span class="hp18-insta-{{ sec_id }}__title-icon">@</span>
      {{ section.settings.title }}
    </h2>
  </div>

  <div class="hp18-insta-{{ sec_id }}__grid">
    {% for block in section.blocks %}
      <a href="{{ section.settings.insta_link | default: '#' }}" target="_blank" class="hp18-insta-{{ sec_id }}__item" {{ block.shopify_attributes }}>
        {% if block.settings.image != blank %}
          <img height="{{ block.settings.image.height }}" width="{{ block.settings.image.width }}" src="{{ block.settings.image | image_url: width: 600, height: 600, crop: 'center' }}" alt="Instagram Post" class="hp18-insta-{{ sec_id }}__img" loading="lazy">
        {% else %}
          {% capture tmp_class %}hp18-insta-{{ sec_id }}__img{% endcapture %}{{ 'lifestyle-' | append: forloop.index  | placeholder_svg_tag: tmp_class }}
        {% endif %}
        
        <div class="hp18-insta-{{ sec_id }}__overlay">
          <div class="hp18-insta-{{ sec_id }}__icon">VIEW</div>
        </div>
      </a>
    {% else %}
      {% for i in (1..5) %}
        <a href="#" class="hp18-insta-{{ sec_id }}__item">
          {% capture tmp_class %}hp18-insta-{{ sec_id }}__img{% endcapture %}{{ 'lifestyle-' | append: i  | placeholder_svg_tag: tmp_class }}
          <div class="hp18-insta-{{ sec_id }}__overlay">
            <div class="hp18-insta-{{ sec_id }}__icon">VIEW</div>
          </div>
        </a>
      {% endfor %}
    {% endfor %}
  </div>

</section>

{% schema %}
{
  "name": "HP18 Adv Instagram",
  "max_blocks": 6,
  "settings": [
    {
      "type": "header",
      "content": "Color Settings"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f4f4f0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Hover Accent Color",
      "default": "#CCFF00"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Layout & Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "STREET_ARCHIVE"
    },
    {
      "type": "url",
      "id": "insta_link",
      "label": "Instagram Profile Link"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "Border Width",
      "default": 3
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 10,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 10,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Insta Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP18 Advanced Instagram",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
