{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --card-bg: {{ section.settings.card_bg }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    
    --font-heading: 'Outfit', sans-serif;
    --font-body: 'Outfit', sans-serif;
    
    background-color: var(--bg-color);
    padding: 80px 20px;
    overflow: hidden;
  }

  .hp39-testi-wrapper {
    max-width: 1400px;
    margin: 0 auto;
  }

  .hp39-testi__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    font-weight: 700;
    color: var(--text-color);
    margin: 0 0 60px;
    text-align: center;
    letter-spacing: -0.5px;
  }

  .hp39-testi__grid {
    display: flex;
    justify-content: center;
    gap: 30px;
    flex-wrap: wrap;
  }

  .hp39-testi-card {
    flex: 1 1 350px;
    max-width: 450px;
    background: var(--card-bg);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.6);
    border-radius: 40px;
    border-bottom-left-radius: 10px; /* Chat bubble effect */
    padding: 40px;
    box-shadow: 0 20px 40px rgba(0,0,0,0.03);
    transition: transform 0.4s ease;
  }

  .hp39-testi-card:hover {
    transform: translateY(-10px);
  }

  .hp39-testi__stars {
    color: var(--accent-color);
    font-size: 20px;
    margin-bottom: 20px;
    letter-spacing: 2px;
  }

  .hp39-testi__quote {
    font-family: var(--font-body);
    font-size: clamp(18px, 2vw, {{ section.settings.quote_size }}px);
    line-height: 1.5;
    color: var(--text-color);
    margin: 0 0 30px;
  }

  .hp39-testi__author {
    display: flex;
    align-items: center;
    gap: 15px;
  }

  .hp39-testi__avatar {
    width: 50px; height: 50px;
    border-radius: 50%;
    background: #e0e0e0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-size: 18px;
    font-weight: 600;
    color: #fff;
    background: var(--accent-color);
  }

  .hp39-testi__name {
    font-family: var(--font-heading);
    font-size: 16px;
    font-weight: 600;
    color: var(--text-color);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp39-testi-wrapper" id="HP39Testi-{{ section.id }}">
  <h2 class="hp39-testi__title">{{ section.settings.title }}</h2>

  <div class="hp39-testi__grid">
    {%- for block in section.blocks limit: 3 -%}
      <div class="hp39-testi-card" {{ block.shopify_attributes }}>
        <div class="hp39-testi__stars">★★★★★</div>
        <div class="hp39-testi__quote">"{{ block.settings.quote }}"</div>
        <div class="hp39-testi__author">
          <div class="hp39-testi__avatar">{{ block.settings.author | slice: 0 }}</div>
          <div class="hp39-testi__name">{{ block.settings.author }}</div>
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "HP39 - Aura Testimonials",
  "class": "section-hp39-testimonials",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Words of Comfort."
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 48
    },
    {
      "type": "range",
      "id": "quote_size",
      "min": 16,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Quote Size",
      "default": 20
    },
    {
      "type": "header",
      "content": "Aura Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#faf9f8"
    },
    {
      "type": "color_background",
      "id": "card_bg",
      "label": "Card Glass Background",
      "default": "rgba(255, 255, 255, 0.7)"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2D2D2D"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#a18cd1"
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "It feels like wearing a cloud. Absolutely surreal experience."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Mia T."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP39 - Aura Testimonials",
      "blocks": [
        { "type": "review" },
        { "type": "review", "settings": { "quote": "The softest material I have ever felt. Instantly calms me down.", "author": "Liam S." } },
        { "type": "review", "settings": { "quote": "Beautifully designed and unbelievably comfortable. Worth every penny.", "author": "Sophie W." } }
      ]
    }
  ]
}
{% endschema %}
