{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Montserrat:wght@300;400;500&family=Pinyon+Script&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --gold-color: {{ section.settings.gold_color }};
    
    --font-heading: 'Playfair Display', serif;
    --font-body: 'Montserrat', sans-serif;
    --font-sig: 'Pinyon Script', cursive;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    border-bottom: 1px solid rgba(212, 175, 55, 0.2);
  }

  .hp33-founder-wrapper {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    align-items: center;
    gap: 100px;
  }

  @media screen and (max-width: 992px) {
    .hp33-founder-wrapper {
      flex-direction: column-reverse;
      gap: 50px;
      padding: 0 20px;
    }
  }

  .hp33-founder__content-col {
    flex: 1.5;
    position: relative;
  }

  @media screen and (max-width: 992px) {
    .hp33-founder__content-col {
      text-align: center;
    }
  }

  .hp33-founder__subtitle {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    color: var(--gold-color);
    text-transform: uppercase;
    letter-spacing: 4px;
    margin-bottom: 25px;
    display: flex;
    align-items: center;
    gap: 15px;
  }

  @media screen and (max-width: 992px) {
    .hp33-founder__subtitle {
      justify-content: center;
    }
  }

  .hp33-founder__subtitle::before {
    content: '';
    height: 1px;
    width: 40px;
    background: var(--gold-color);
  }

  .hp33-founder__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    line-height: 1.1;
    color: var(--text-color);
    margin: 0 0 30px;
    font-weight: 400;
  }

  .hp33-founder__text {
    font-family: var(--font-heading);
    font-size: 20px;
    line-height: 1.8;
    color: var(--text-color);
    margin: 0 0 40px;
    font-style: italic;
    font-weight: 400;
    opacity: 0.9;
  }

  .hp33-founder__signature {
    margin-top: 40px;
  }

  .hp33-founder__sig-img {
    height: 60px;
    width: auto;
    margin-bottom: 15px;
    filter: invert(72%) sepia(51%) saturate(415%) hue-rotate(5deg) brightness(88%) contrast(85%); /* approximation of gold */
  }

  .hp33-founder__sig-text {
    font-family: var(--font-sig);
    font-size: 48px;
    color: var(--gold-color);
    line-height: 1;
    margin: 0 0 10px;
  }

  .hp33-founder__sig-role {
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 500;
    color: var(--text-color);
    text-transform: uppercase;
    letter-spacing: 2px;
    opacity: 0.6;
  }

  .hp33-founder__image-col {
    flex: 1;
    position: relative;
  }

  @media screen and (max-width: 992px) {
    .hp33-founder__image-col {
      width: 100%;
      max-width: 400px;
      margin: 0 auto;
    }
  }

  .hp33-founder__image-wrap {
    position: relative;
    padding-top: 20px;
    padding-right: 20px;
  }

  .hp33-founder__image-wrap::before {
    content: '';
    position: absolute;
    top: 0; right: 0;
    width: 90%; height: 90%;
    border: 1px solid var(--gold-color);
    z-index: 1;
  }

  .hp33-founder__image {
    width: 100%;
    height: auto;
    aspect-ratio: 3/4;
    object-fit: cover;
    display: block;
    position: relative;
    z-index: 2;
    filter: sepia(30%);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp33-founder-wrapper" id="HP33Founder-{{ section.id }}">
  <div class="hp33-founder__content-col">
    {%- if section.settings.subtitle != blank -%}
      <div class="hp33-founder__subtitle">{{ section.settings.subtitle }}</div>
    {%- endif -%}
    
    <h2 class="hp33-founder__title">{{ section.settings.title }}</h2>
    
    <div class="hp33-founder__text">
      {{ section.settings.text }}
    </div>

    <div class="hp33-founder__signature">
      {%- if section.settings.sig_image != blank -%}
        <img src="{{ section.settings.sig_image | image_url: width: 300 }}" alt="Signature" class="hp33-founder__sig-img" loading="lazy">
      {%- else -%}
        <div class="hp33-founder__sig-text">{{ section.settings.sig_name }}</div>
      {%- endif -%}
      <div class="hp33-founder__sig-role">{{ section.settings.sig_role }}</div>
    </div>
  </div>

  <div class="hp33-founder__image-col">
    <div class="hp33-founder__image-wrap">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 600 }}" alt="{{ section.settings.title | escape }}" class="hp33-founder__image" loading="lazy">
      {%- else -%}
        {{ 'portrait-1' | placeholder_svg_tag: 'hp33-founder__image' }}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "HP33 - Deco Founder",
  "class": "section-hp33-founder-note",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "A PERSONAL NOTE"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Heading",
      "default": "An Unyielding Standard"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>When I established this atelier, it was with a singular vision: to create objects of profound beauty that transcend fleeting trends. True elegance is quiet, commanding attention through perfect execution rather than loud proclamation.</p>"
    },
    {
      "type": "image_picker",
      "id": "sig_image",
      "label": "Signature Image (Optional)"
    },
    {
      "type": "text",
      "id": "sig_name",
      "label": "Signature Name (Fallback)",
      "default": "Arthur Pendelton"
    },
    {
      "type": "text",
      "id": "sig_role",
      "label": "Signature Role",
      "default": "PROPRIETOR"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Portrait Image"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 48
    },
    {
      "type": "header",
      "content": "Deco Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (e.g. Deep Emerald)",
      "default": "#0e1a14"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "gold_color",
      "label": "Gold Accent",
      "default": "#d4af37"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 100
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP33 - Deco Founder"
    }
  ]
}
{% endschema %}
