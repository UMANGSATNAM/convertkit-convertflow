{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@700;900&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --border-color: #000000;
    
    --font-heading: 'Space Grotesk', sans-serif;
    
    background-color: var(--bg-color);
    padding: 80px 20px;
    border-bottom: 4px solid var(--border-color);
  }

  .hp41-video-wrapper {
    max-width: 1000px;
    margin: 0 auto;
    background: #FFF;
    border: 4px solid var(--border-color);
    border-radius: 16px;
    box-shadow: 16px 16px 0px var(--border-color);
    overflow: hidden;
  }

  /* Fake OS Window Title Bar */
  .hp41-video__titlebar {
    background: #38C6F4;
    border-bottom: 4px solid var(--border-color);
    padding: 15px 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .hp41-video__title {
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 900;
    color: var(--border-color);
    margin: 0;
    text-transform: uppercase;
  }

  .hp41-video__controls {
    display: flex;
    gap: 10px;
  }

  .hp41-video__control-btn {
    width: 24px;
    height: 24px;
    border: 3px solid var(--border-color);
    border-radius: 50%;
    background: #FFF;
    box-shadow: 2px 2px 0px var(--border-color);
  }

  .hp41-video__control-btn:nth-child(1) { background: #FF4911; }
  .hp41-video__control-btn:nth-child(2) { background: #D7FF43; }
  .hp41-video__control-btn:nth-child(3) { background: #F0A8E3; }

  .hp41-video__content {
    position: relative;
    width: 100%;
    aspect-ratio: 16/9;
    background: #000;
  }

  .hp41-video__media {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hp41-video__play-overlay {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: #D7FF43;
    border: 4px solid var(--border-color);
    border-radius: 50%;
    width: 80px;
    height: 80px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 8px 8px 0px var(--border-color);
    cursor: pointer;
    transition: all 0.1s ease;
  }
  
  .hp41-video__play-overlay:hover {
    transform: translate(calc(-50% + 2px), calc(-50% + 2px));
    box-shadow: 6px 6px 0px var(--border-color);
  }

  .hp41-video__play-overlay svg {
    width: 40px;
    height: 40px;
    fill: var(--border-color);
    margin-left: 5px; /* Visual center adjustment for play triangle */
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp41-video-wrapper" id="HP41Video-{{ section.id }}">
  <div class="hp41-video__titlebar">
    <h2 class="hp41-video__title">{{ section.settings.title }}</h2>
    <div class="hp41-video__controls">
      <div class="hp41-video__control-btn"></div>
      <div class="hp41-video__control-btn"></div>
      <div class="hp41-video__control-btn"></div>
    </div>
  </div>
  
  <div class="hp41-video__content">
    {%- if section.settings.video_url != blank -%}
      <video class="hp41-video__media" loop muted playsinline>
        <source src="{{ section.settings.video_url }}" type="video/mp4">
      </video>
    {%- else -%}
      {%- if section.settings.image != blank -%}
        <img height="{{ section.settings.image.height }}" width="{{ section.settings.image.width }}" src="{{ section.settings.image | image_url: width: 1200 }}" class="hp41-video__media" alt="Video Fallback" loading="lazy">
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'hp41-video__media' }}
      {%- endif -%}
    {%- endif -%}
    
    <div class="hp41-video__play-overlay">
      <svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
    </div>
  </div>
</div>

<script>
  // Simple play functionality
  document.addEventListener('DOMContentLoaded', function() {
    const wrapper = document.getElementById('HP41Video-{{ section.id }}');
    const video = wrapper.querySelector('video');
    const playBtn = wrapper.querySelector('.hp41-video__play-overlay');
    
    if (video && playBtn) {
      playBtn.addEventListener('click', function() {
        if (video.paused) {
          video.play();
          playBtn.style.display = 'none';
        }
      });
      video.addEventListener('click', function() {
        if (!video.paused) {
          video.pause();
          playBtn.style.display = 'flex';
        }
      });
    }
  });
</script>

{% schema %}
{
  "name": "HP41 - Neo Video",
  "class": "section-hp41-video-banner",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Window Title",
      "default": "VIDEO_PLAYER.EXE"
    },
    {
      "type": "url",
      "id": "video_url",
      "label": "MP4 Video URL (Direct link)"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Fallback Image"
    },
    {
      "type": "header",
      "content": "Neo Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#FDF0D5"
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP41 - Neo Video"
    }
  ]
}
{% endschema %}
