{% comment %}
  FB04 Trust Grid — 4-column USP with icons
{% endcomment %}

<style>
  .fb04-trust {
    padding: 100px 60px;
    background: #fff;
  }
  .fb04-trust__inner {
    max-width: 1200px;
    margin: 0 auto;
  }
  .fb04-trust__heading {
    font-family: 'Big Shoulders Display', sans-serif;
    font-weight: 700;
    font-size: 42px;
    color: #282A2F;
    margin-bottom: 12px;
  }
  .fb04-trust__desc {
    font-family: 'Host Grotesk', sans-serif;
    font-weight: 400;
    font-size: 16px;
    color: #7B818E;
    line-height: 1.6;
    max-width: 520px;
    margin-bottom: 48px;
  }
  .fb04-trust__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }
  .fb04-trust__card {
    background: #F3F4F5;
    border-radius: 12px;
    padding: 32px 24px;
    transition: transform 0.3s ease;
  }
  .fb04-trust__card:hover {
    transform: translateY(-4px);
  }
  .fb04-trust__icon {
    width: 48px;
    height: 48px;
    background: #E8F1FF;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
    font-size: 22px;
  }
  .fb04-trust__card-title {
    font-family: 'Host Grotesk', sans-serif;
    font-weight: 700;
    font-size: 15px;
    text-transform: uppercase;
    color: #282A2F;
    letter-spacing: 0.5px;
    margin-bottom: 8px;
  }
  .fb04-trust__card-desc {
    font-family: 'Host Grotesk', sans-serif;
    font-weight: 400;
    font-size: 14px;
    color: #7B818E;
    line-height: 1.5;
  }

  @media (max-width: 809px) {
    .fb04-trust {
      padding: 60px 24px;
    }
    .fb04-trust__heading {
      font-size: 28px;
    }
    .fb04-trust__grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }
  @media (min-width: 810px) and (max-width: 1199px) {
    .fb04-trust {
      padding: 80px 40px;
    }
    .fb04-trust__heading {
      font-size: 36px;
    }
    .fb04-trust__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

<section class="fb04-trust">
  <div class="fb04-trust__inner">
    <h2 class="fb04-trust__heading">{{ section.settings.heading | default: 'Why Shop With Us?' }}</h2>
    <p class="fb04-trust__desc">{{ section.settings.description | default: "We've got you covered with hassle-free shopping, top-tier service, and guarantees that keep you confident in every purchase." }}</p>

    <div class="fb04-trust__grid">
      {% for block in section.blocks %}
        <div class="fb04-trust__card" {{ block.shopify_attributes }}>
          <div class="fb04-trust__icon">
            {{ block.settings.icon | default: '📦' }}
          </div>
          <h3 class="fb04-trust__card-title">{{ block.settings.title }}</h3>
          <p class="fb04-trust__card-desc">{{ block.settings.description }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FB04 Trust Grid",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why Shop With Us?" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "We've got you covered with hassle-free shopping, top-tier service, and guarantees that keep you confident in every purchase." }
  ],
  "blocks": [
    {
      "type": "trust_item",
      "name": "Trust Item",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon (emoji)", "default": "📦" },
        { "type": "text", "id": "title", "label": "Title", "default": "Free Delivery" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Get your streetwear fast and free, with no extra shipping costs on all orders." }
      ]
    }
  ],
  "presets": [
    {
      "name": "FB04 Trust Grid",
      "blocks": [
        { "type": "trust_item", "settings": { "icon": "📦", "title": "Free Delivery", "description": "Get your streetwear fast and free, with no extra shipping costs on all orders." } },
        { "type": "trust_item", "settings": { "icon": "🔒", "title": "100% Secure Payment", "description": "Shop with confidence using encrypted, safe, and trusted payment methods." } },
        { "type": "trust_item", "settings": { "icon": "↩️", "title": "30 Days Return", "description": "Not the perfect fit? No worries. Return or exchange hassle-free within 30 days." } },
        { "type": "trust_item", "settings": { "icon": "💬", "title": "24/7 Support", "description": "Got questions? Our team is here for you anytime, anywhere." } }
      ]
    }
  ]
}
{% endschema %}
