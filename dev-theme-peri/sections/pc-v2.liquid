{%- comment -%}
  PC V2 — DARK MODE CYBER-TECH PRODUCT GRID
  Design: Dark Obsidian (#0D0F12), Neon Mint (#00FF87) accents, Syne & Space Grotesk typography
  Card Shape: Sharp 4px corners, glowing borders, glassmorphic CTA overlay
{%- endcomment -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Syne:wght@600;700;800&display=swap');

  .pcv2 {
    --bg: {{ section.settings.bg_color | default: '#0D0F12' }};
    --card-bg: {{ section.settings.card_bg | default: '#161920' }};
    --text: {{ section.settings.text_color | default: '#F3F4F6' }};
    --muted: {{ section.settings.muted_color | default: '#9CA3AF' }};
    --accent: {{ section.settings.accent_color | default: '#00FF87' }};
    --accent-hover: {{ section.settings.accent_hover | default: '#00D972' }};
    --border: {{ section.settings.border_color | default: '#262C3A' }};
    --badge-sale-bg: #FF2E63;
    --badge-sale-text: #FFFFFF;
    --f-heading: 'Syne', sans-serif;
    --f-body: 'Space Grotesk', sans-serif;
    --r-card: 4px;
    --ease: all 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
    background-color: var(--bg);
    color: var(--text);
    font-family: var(--f-body);
    padding: {{ section.settings.padding_top | default: 56 }}px 0 {{ section.settings.padding_bottom | default: 56 }}px 0;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }

  .pcv2 *, .pcv2 *::before, .pcv2 *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .pcv2 a { color: inherit; text-decoration: none; }
  .pcv2 button { font-family: inherit; cursor: pointer; border: none; background: none; }
  .pcv2 img { max-width: 100%; display: block; }

  .pcv2__wrap { max-width: 1320px; margin: 0 auto; padding: 0 20px; }

  /* HEADER */
  .pcv2__head { display: flex; flex-direction: column; gap: 10px; margin-bottom: 36px; text-align: {{ section.settings.header_align | default: 'left' }}; }
  @media (min-width: 768px) {
    .pcv2__head { display: flex; flex-direction: row; justify-content: space-between; align-items: flex-end; }
  }
  .pcv2__title { font-family: var(--f-heading); font-size: 30px; font-weight: 800; color: var(--text); letter-spacing: -0.03em; text-transform: uppercase; }
  @media (min-width: 768px) { .pcv2__title { font-size: 38px; } }
  .pcv2__title-accent { color: var(--accent); }
  .pcv2__sub { font-size: 15px; color: var(--muted); max-width: 600px; }
  .pcv2__viewall { display: inline-flex; align-items: center; gap: 8px; font-weight: 700; font-size: 13px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--accent); transition: var(--ease); padding: 8px 16px; border: 1px solid var(--accent); border-radius: 4px; }
  .pcv2__viewall:hover { background: var(--accent); color: #0D0F12; box-shadow: 0 0 15px rgba(0,255,135,0.4); }

  /* GRID */
  .pcv2__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr);
    gap: 16px;
  }
  @media (min-width: 640px) {
    .pcv2__grid { grid-template-columns: repeat({{ section.settings.cols_tablet | default: 3 }}, 1fr); gap: 20px; }
  }
  @media (min-width: 1024px) {
    .pcv2__grid { grid-template-columns: repeat({{ section.settings.cols_desktop | default: 4 }}, 1fr); gap: 24px; }
  }

  /* CARD */
  .pcv2__card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--r-card);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    position: relative;
    transition: var(--ease);
  }
  .pcv2__card:hover {
    transform: translateY(-5px);
    border-color: var(--accent);
    box-shadow: 0 10px 30px -10px rgba(0, 255, 135, 0.2);
  }

  /* IMAGE CONTAINER */
  .pcv2__img-box {
    position: relative;
    width: 100%;
    aspect-ratio: {{ section.settings.img_ratio | default: '3/4' }};
    background: #11141C;
    overflow: hidden;
  }
  .pcv2__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1), filter 0.3s ease;
  }
  .pcv2__img--sec {
    position: absolute;
    top: 0; left: 0;
    opacity: 0;
  }
  .pcv2__card:hover .pcv2__img--pri {
    {% if section.settings.enable_sec_img %}
      opacity: 0;
    {% else %}
      transform: scale(1.06);
      filter: brightness(1.1);
    {% endif %}
  }
  .pcv2__card:hover .pcv2__img--sec { opacity: 1; transform: scale(1.06); filter: brightness(1.1); }

  /* BADGES */
  .pcv2__badges { position: absolute; top: 12px; left: 12px; display: flex; flex-direction: column; gap: 6px; z-index: 2; pointer-events: none; }
  .pcv2__badge { font-size: 10px; font-weight: 700; text-transform: uppercase; padding: 4px 8px; border-radius: 2px; letter-spacing: 0.08em; font-family: var(--f-heading); }
  .pcv2__badge--sale { background: var(--badge-sale-bg); color: var(--badge-sale-text); font-weight: 800; }
  .pcv2__badge--tag { background: var(--accent); color: #0D0F12; }
  .pcv2__badge--sold { background: #374151; color: #9CA3AF; }

  /* WISHLIST BUTTON */
  .pcv2__wish {
    position: absolute;
    top: 12px; right: 12px;
    width: 36px; height: 36px;
    border-radius: 4px;
    background: rgba(13, 15, 18, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(8px);
    display: flex; align-items: center; justify-content: center;
    color: #9CA3AF;
    z-index: 3;
    transition: var(--ease);
  }
  .pcv2__wish:hover { background: rgba(0, 255, 135, 0.15); border-color: var(--accent); color: var(--accent); transform: scale(1.05); }
  .pcv2__wish.active { color: #FF2E63; border-color: #FF2E63; background: rgba(255, 46, 99, 0.15); }

  /* OVERLAY QUICK ADD */
  .pcv2__quick-box {
    position: absolute;
    bottom: 12px; left: 12px; right: 12px;
    z-index: 3;
    transform: translateY(100%);
    opacity: 0;
    transition: var(--ease);
  }
  .pcv2__card:hover .pcv2__quick-box { transform: translateY(0); opacity: 1; }
  @media (max-width: 767px) {
    .pcv2__quick-box { transform: translateY(0); opacity: 1; position: relative; bottom: auto; left: auto; right: auto; padding: 0 12px 12px; }
  }

  .pcv2__quick-btn {
    width: 100%;
    padding: 11px 16px;
    background: var(--accent);
    color: #0D0F12;
    font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em;
    font-family: var(--f-heading);
    border-radius: 3px;
    display: flex; align-items: center; justify-content: center; gap: 8px;
    transition: var(--ease);
    box-shadow: 0 4px 15px rgba(0, 255, 135, 0.3);
  }
  .pcv2__quick-btn:hover { background: var(--accent-hover); box-shadow: 0 4px 20px rgba(0, 255, 135, 0.5); }
  .pcv2__quick-btn:disabled { background: #262C3A; color: #6B7280; cursor: not-allowed; box-shadow: none; }

  /* CARD CONTENT */
  .pcv2__content { padding: 16px; display: flex; flex-direction: column; gap: 8px; flex-grow: 1; background: var(--card-bg); }

  .pcv2__vendor { font-size: 10px; text-transform: uppercase; color: var(--accent); font-weight: 700; letter-spacing: 0.1em; }
  .pcv2__item-title { font-size: 15px; font-weight: 600; color: var(--text); line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; font-family: var(--f-heading); }
  .pcv2__item-title:hover { color: var(--accent); }

  /* RATING */
  .pcv2__rating { display: flex; align-items: center; gap: 6px; font-size: 12px; color: var(--accent); font-weight: 600; }
  .pcv2__stars { letter-spacing: 2px; }
  .pcv2__rev-cnt { color: var(--muted); font-weight: 400; font-size: 11px; }

  /* PRICE */
  .pcv2__price-row { display: flex; align-items: baseline; gap: 10px; margin-top: auto; padding-top: 4px; }
  .pcv2__price { font-size: 17px; font-weight: 700; color: var(--text); font-family: var(--f-heading); }
  .pcv2__cmp-price { font-size: 14px; color: var(--muted); text-decoration: line-through; }

  /* SWATCHES */
  .pcv2__swatches { display: flex; gap: 6px; align-items: center; margin-top: 4px; }
  .pcv2__swatch { width: 12px; height: 12px; border-radius: 2px; border: 1px solid #374151; cursor: pointer; transition: var(--ease); }
  .pcv2__swatch:hover, .pcv2__swatch.active { transform: scale(1.25); border-color: var(--accent); box-shadow: 0 0 6px var(--accent); }

  /* URGENCY MICRO */
  .pcv2__urgency { font-size: 11px; color: #FF2E63; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; display: flex; align-items: center; gap: 6px; margin-top: 2px; }
  .pcv2__urgency-dot { width: 6px; height: 6px; border-radius: 50%; background: #FF2E63; animation: pcv2pulse 1.2s infinite alternate; }
  @keyframes pcv2pulse { 0% { opacity: 0.3; transform: scale(0.8); } 100% { opacity: 1; transform: scale(1.2); } }

  /* TOAST */
  .pcv2__toast {
    position: fixed; bottom: 24px; right: 24px;
    background: #00FF87; color: #0D0F12;
    padding: 14px 24px; border-radius: 4px;
    font-size: 13px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em;
    font-family: var(--f-heading);
    z-index: 9999;
    transform: translateY(100px); opacity: 0;
    transition: all 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
    box-shadow: 0 10px 30px rgba(0, 255, 135, 0.4);
  }
  .pcv2__toast.show { transform: translateY(0); opacity: 1; }
</style>

<div class="pcv2">
  <div class="pcv2__wrap">
    
    {% if section.settings.title != blank or section.settings.subheading != blank %}
      <div class="pcv2__head">
        <div>
          {% if section.settings.title != blank %}
            <h2 class="pcv2__title">
              {{ section.settings.title | escape }}
            </h2>
          {% endif %}
          {% if section.settings.subheading != blank %}
            <p class="pcv2__sub">{{ section.settings.subheading | escape }}</p>
          {% endif %}
        </div>
        {% if section.settings.show_view_all and section.settings.collection != blank %}
          <a href="{{ collections[section.settings.collection].url }}" class="pcv2__viewall">
            {{ section.settings.view_all_label | default: 'Explore All' }} &rarr;
          </a>
        {% endif %}
      </div>
    {% endif %}

    <div class="pcv2__grid">
      {% assign target_coll = collections[section.settings.collection] %}
      {% assign limit_num = section.settings.products_per_page | default: 8 %}

      {% if target_coll != blank and target_coll.products.size > 0 %}
        {% for product in target_coll.products limit: limit_num %}
          {% assign current_variant = product.selected_or_first_available_variant %}
          
          {% render 'card-v2', product: product, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v2', product: nil, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% endif %}
    </div>

  </div>
</div>

<div class="pcv2__toast" id="pcv2-toast">✓ Cart Updated</div>

<script>
(function(){
  // Wishlist is handled globally by assets/wishlist.js (shared store: cf_wishlist_items).
  // Buttons are rendered by snippets/wishlist-button.liquid — no per-section storage.


  document.querySelectorAll('[data-pcv2-add]').forEach(function(btn){
    btn.addEventListener('click', function(e){
      e.preventDefault(); e.stopPropagation();
      var id = btn.dataset.pcv2Add, orig = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = 'Adding...';

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: id, quantity: 1 })
      })
      .then(function(r){ return r.json(); })
      .then(function(){
        btn.innerHTML = '✓ Success!';
        showT('Item added to Cyber Cart!');
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      })
      .catch(function(){
        btn.innerHTML = 'Error';
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      });
    });
  });

  function showT(msg){
    var t = document.getElementById('pcv2-toast');
    if(!t) return;
    t.textContent = msg;
    t.classList.add('show');
    setTimeout(function(){ t.classList.remove('show'); }, 3000);
  }
})();
</script>

