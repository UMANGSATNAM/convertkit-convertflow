{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Lato:wght@300;400;700&family=Playfair+Display:ital,wght@0,400;0,500;1,400&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    
    --font-heading: 'Playfair Display', serif;
    --font-body: 'Lato', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    overflow: hidden;
  }

  .hp31-ugc-wrapper {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp31-ugc-wrapper {
      padding: 0 20px;
    }
  }

  .hp31-ugc__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 50px;
  }

  @media screen and (max-width: 768px) {
    .hp31-ugc__header {
      flex-direction: column;
      align-items: flex-start;
      gap: 15px;
    }
  }

  .hp31-ugc__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 4vw, {{ section.settings.title_size }}px);
    line-height: 1.2;
    color: var(--text-color);
    margin: 0;
    font-weight: 400;
  }

  .hp31-ugc__title em {
    font-style: italic;
  }

  .hp31-ugc__nav {
    display: flex;
    gap: 15px;
  }

  .hp31-ugc__nav-btn {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid rgba(0,0,0,0.1);
    background: transparent;
    color: var(--text-color);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .hp31-ugc__nav-btn:hover {
    background: var(--text-color);
    color: var(--bg-color);
    border-color: var(--text-color);
  }

  .hp31-ugc__slider {
    display: flex;
    gap: 30px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding-bottom: 20px;
    scroll-behavior: smooth;
  }

  .hp31-ugc__slider::-webkit-scrollbar {
    display: none;
  }

  .hp31-ugc__item {
    flex: 0 0 calc(100% / {{ section.settings.columns_desktop }} - 30px + (30px / {{ section.settings.columns_desktop }}));
    scroll-snap-align: start;
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    background: #E8E2D6;
    aspect-ratio: 9/16;
    cursor: pointer;
  }

  @media screen and (max-width: 992px) {
    .hp31-ugc__item {
      flex: 0 0 calc(33.333% - 20px);
    }
  }

  @media screen and (max-width: 768px) {
    .hp31-ugc__item {
      flex: 0 0 calc(60% - 15px);
    }
  }

  @media screen and (max-width: 480px) {
    .hp31-ugc__item {
      flex: 0 0 calc(80% - 15px);
    }
  }

  .hp31-ugc__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.5s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .hp31-ugc__item:hover .hp31-ugc__video {
    transform: scale(1.05);
  }

  .hp31-ugc__overlay {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    padding: 30px 20px;
    background: linear-gradient(to top, rgba(0,0,0,0.6), transparent);
    color: #fff;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .hp31-ugc__handle {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.1em;
    margin: 0;
  }

  .hp31-ugc__play {
    width: 24px;
    height: 24px;
    border: 1px solid rgba(255,255,255,0.6);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-left: auto;
  }

  .hp31-ugc__play::after {
    content: '';
    width: 0;
    height: 0;
    border-top: 4px solid transparent;
    border-bottom: 4px solid transparent;
    border-left: 6px solid #fff;
    margin-left: 2px;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp31-ugc-wrapper" id="HP31UGC-{{ section.id }}">
  <div class="hp31-ugc__header">
    <h2 class="hp31-ugc__title">{{ section.settings.title }}</h2>
    <div class="hp31-ugc__nav">
      <button class="hp31-ugc__nav-btn" id="hp31-u-prev-{{ section.id }}" aria-label="Previous">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
      </button>
      <button class="hp31-ugc__nav-btn" id="hp31-u-next-{{ section.id }}" aria-label="Next">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
      </button>
    </div>
  </div>

  <div class="hp31-ugc__slider" id="hp31-ugc-slider-{{ section.id }}">
    {%- for block in section.blocks -%}
      <div class="hp31-ugc__item" {{ block.shopify_attributes }}>
        {%- if block.settings.video_url != blank -%}
          <video class="hp31-ugc__video" autoplay loop muted playsinline>
            <source src="{{ block.settings.video_url }}" type="video/mp4">
          </video>
        {%- else -%}
          {%- assign placeholder = 'collection-' | append: forloop.index -%}
          {%- if forloop.index > 6 -%}{%- assign placeholder = 'collection-1' -%}{%- endif -%}
          {{ placeholder | placeholder_svg_tag: 'hp31-ugc__video' }}
        {%- endif -%}

        <div class="hp31-ugc__overlay">
          <p class="hp31-ugc__handle">{{ block.settings.handle }}</p>
          <div class="hp31-ugc__play"></div>
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const slider = document.getElementById('hp31-ugc-slider-{{ section.id }}');
    const prev = document.getElementById('hp31-u-prev-{{ section.id }}');
    const next = document.getElementById('hp31-u-next-{{ section.id }}');
    
    if(slider && prev && next) {
      prev.addEventListener('click', () => {
        const itemWidth = slider.querySelector('.hp31-ugc__item').offsetWidth;
        slider.scrollBy({ left: -itemWidth - 30, behavior: 'smooth' });
      });
      next.addEventListener('click', () => {
        const itemWidth = slider.querySelector('.hp31-ugc__item').offsetWidth;
        slider.scrollBy({ left: itemWidth + 30, behavior: 'smooth' });
      });
    }
  });
</script>

{% schema %}
{
  "name": "HP31 - Zen UGC",
  "class": "section-hp31-ugc-reels",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Heading",
      "default": "From our <em>Community</em>"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 3,
      "max": 6,
      "step": 1,
      "label": "Columns (Desktop)",
      "default": 4
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 42
    },
    {
      "type": "header",
      "content": "Zen Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (Beige)",
      "default": "#F9F6F0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text (Charcoal)",
      "default": "#2C2C2C"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "UGC Video",
      "settings": [
        {
          "type": "text",
          "id": "video_url",
          "label": "MP4 Video URL"
        },
        {
          "type": "text",
          "id": "handle",
          "label": "User Handle",
          "default": "@username"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP31 - Zen UGC",
      "blocks": [
        { "type": "video" },
        { "type": "video" },
        { "type": "video" },
        { "type": "video" },
        { "type": "video" }
      ]
    }
  ]
}
{% endschema %}
