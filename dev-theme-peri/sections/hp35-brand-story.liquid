{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;1,400&family=Nunito:wght@300;400;600&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    
    --font-heading: 'Lora', serif;
    --font-body: 'Nunito', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    position: relative;
    overflow: hidden;
  }

  .hp35-story-wrapper {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    align-items: center;
    gap: 80px;
  }

  @media screen and (max-width: 992px) {
    .hp35-story-wrapper {
      flex-direction: column;
      gap: 40px;
      padding: 0 20px;
    }
  }

  .hp35-story__image-col {
    flex: 1;
    position: relative;
  }

  .hp35-story__image-wrap {
    position: relative;
    z-index: 2;
    border-radius: 200px 200px 0 0; /* Arch */
    overflow: hidden;
    aspect-ratio: 4/5;
  }

  .hp35-story__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hp35-story__shape {
    position: absolute;
    bottom: -10%; left: -10%;
    width: 60%; height: 60%;
    background: var(--accent-color);
    border-radius: 50%;
    z-index: 1;
    opacity: 0.2;
    filter: blur(40px);
  }

  .hp35-story__content-col {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
    z-index: 3;
  }

  .hp35-story__subtitle {
    font-family: var(--font-body);
    font-size: 13px;
    color: var(--text-color);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-bottom: 20px;
    opacity: 0.6;
  }

  .hp35-story__title {
    font-family: var(--font-heading);
    font-size: clamp(36px, 5vw, {{ section.settings.title_size }}px);
    line-height: 1.2;
    color: var(--text-color);
    margin: 0 0 30px;
    font-weight: 400;
  }

  .hp35-story__title em {
    font-style: italic;
    color: var(--accent-color);
  }

  .hp35-story__text {
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.8;
    color: var(--text-color);
    margin: 0 0 40px;
    font-weight: 300;
  }

  .hp35-story__btn {
    font-family: var(--font-body);
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-decoration: none;
    padding: 18px 40px;
    border-radius: 50px;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: var(--text-color);
    color: var(--bg-color);
    align-self: flex-start;
    transition: all 0.4s ease;
  }

  .hp35-story__btn:hover {
    background-color: var(--accent-color);
    color: #fff;
    transform: translateY(-2px);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp35-story-wrapper" id="HP35Story-{{ section.id }}">
  <div class="hp35-story__image-col">
    <div class="hp35-story__shape"></div>
    <div class="hp35-story__image-wrap">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.title | escape }}" class="hp35-story__image" loading="lazy">
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'hp35-story__image' }}
      {%- endif -%}
    </div>
  </div>

  <div class="hp35-story__content-col">
    {%- if section.settings.subtitle != blank -%}
      <div class="hp35-story__subtitle">{{ section.settings.subtitle }}</div>
    {%- endif -%}
    
    <h2 class="hp35-story__title">{{ section.settings.title | replace: 'Roots', '<em>Roots</em>' }}</h2>
    
    <div class="hp35-story__text">
      {{ section.settings.text }}
    </div>

    {%- if section.settings.btn_label != blank -%}
      <a href="{{ section.settings.btn_link | default: '#' }}" class="hp35-story__btn">
        {{ section.settings.btn_label }}
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP35 - Organic Story",
  "class": "section-hp35-brand-story",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "OUR PHILOSOPHY"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Heading",
      "default": "Returning to our Roots"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>We believe in the beauty of time. In things made slowly, with intention and care. Our pieces are designed to age gracefully alongside you, becoming more beautiful with every wear.</p>"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "Read Our Story"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 30,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 48
    },
    {
      "type": "header",
      "content": "Organic Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#FDFBF7"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2C422F"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#CC7B5E"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 100
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP35 - Organic Story"
    }
  ]
}
{% endschema %}
