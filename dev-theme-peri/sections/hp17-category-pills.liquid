{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#0A0A0A'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 60px 40px;
    border-bottom: 1px solid rgba(0, 255, 65, 0.2);
  }
  
  .hp17-pills-container-{{ section_id }} {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 20px;
  }
  
  .hp17-pill-{{ section_id }} {
    display: inline-flex;
    align-items: center;
    padding: 12px 25px;
    background: transparent;
    border: 1px solid rgba(0, 255, 65, 0.5);
    color: #FFF;
    text-decoration: none;
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.9rem;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 2px;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }
  
  .hp17-pill-{{ section_id }}::before {
    content: '';
    position: absolute;
    top: 0; left: -100%;
    width: 100%; height: 100%;
    background: linear-gradient(90deg, transparent, rgba(0, 255, 65, 0.2), transparent);
    transition: left 0.5s ease;
  }
  
  .hp17-pill-{{ section_id }}:hover::before {
    left: 100%;
  }
  
  .hp17-pill-{{ section_id }}:hover {
    background: rgba(0, 255, 65, 0.1);
    border-color: #00FF41;
    color: #00FF41;
    box-shadow: 0 0 10px rgba(0, 255, 65, 0.3);
  }
  
  .hp17-pill-{{ section_id }} span {
    color: rgba(255,255,255,0.3);
    margin-right: 10px;
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 40px 20px;
    }
    .hp17-pill-{{ section_id }} {
      padding: 10px 15px;
      font-size: 0.8rem;
    }
  }
</style>

<div class="hp17-pills-container-{{ section_id }}">
  {% for block in section.blocks %}
    <a href="{{ block.settings.link | default: '#' }}" class="hp17-pill-{{ section_id }}" {{ block.shopify_attributes }}>
      <span>[{{ forloop.index | prepend: '0' }}]</span> {{ block.settings.title | default: 'Category' }}
    </a>
  {% endfor %}
</div>

{% schema %}
{
  "name": "HP17 Category Pills",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#0A0A0A"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Category"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP17 Category Pills",
      "blocks": [
        { "type": "category", "settings": { "title": "OUTERWEAR" } },
        { "type": "category", "settings": { "title": "CARGO PANTS" } },
        { "type": "category", "settings": { "title": "HARNESSES" } },
        { "type": "category", "settings": { "title": "FOOTWEAR" } },
        { "type": "category", "settings": { "title": "VISORS" } }
      ]
    }
  ]
}
{% endschema %}
