{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#00FFFF'
  assign text_color = section.settings.text_color | default: '#000000'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 100px 40px;
    border-bottom: 4px solid #000;
    position: relative;
    overflow: hidden;
  }
  
  /* Decorative background elements */
  #shopify-section-{{ section_id }}::before {
    content: '★';
    position: absolute;
    font-size: 150px;
    color: #FF00FF;
    top: -30px;
    right: -20px;
    opacity: 0.5;
    z-index: 1;
  }
  
  #shopify-section-{{ section_id }}::after {
    content: '★';
    position: absolute;
    font-size: 100px;
    color: #FFFF00;
    bottom: 20px;
    left: 20px;
    opacity: 0.8;
    z-index: 1;
    transform: rotate(15deg);
  }
  
  .hp16-bestsellers-container-{{ section_id }} {
    max-width: 1400px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }
  
  .hp16-bestsellers-header-{{ section_id }} {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 50px;
  }
  
  .hp16-bestsellers-heading-{{ section_id }} {
    font-family: 'Arial Black', Impact, sans-serif;
    font-size: clamp(3rem, 5vw, 5rem);
    text-transform: uppercase;
    color: #FFF;
    -webkit-text-stroke: 2px #000;
    text-shadow: 5px 5px 0 #FF00FF;
    margin: 0;
    line-height: 1;
    transform: rotate(-1deg);
  }
  
  .hp16-bestsellers-link-{{ section_id }} {
    font-family: 'Arial Black', sans-serif;
    font-size: 1rem;
    text-transform: uppercase;
    color: #FFF;
    background: #000;
    text-decoration: none;
    padding: 10px 20px;
    border-radius: 20px;
    box-shadow: 4px 4px 0 #FFFF00;
    transition: all 0.2s ease;
  }
  
  .hp16-bestsellers-link-{{ section_id }}:hover {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0 #FFFF00;
  }
  
  .hp16-bestsellers-grid-{{ section_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 30px;
  }
  
  .hp16-product-card-{{ section_id }} {
    background: #FFF;
    border: 4px solid #000;
    border-radius: 20px;
    text-decoration: none;
    color: {{ text_color }};
    display: flex;
    flex-direction: column;
    box-shadow: 8px 8px 0 #000;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    overflow: hidden;
  }
  
  .hp16-product-card-{{ section_id }}:hover {
    transform: translate(-5px, -5px);
    box-shadow: 13px 13px 0 #000;
  }
  
  .hp16-product-image-wrap-{{ section_id }} {
    position: relative;
    padding-top: 120%;
    border-bottom: 4px solid #000;
    background: #FF00FF;
  }
  
  .hp16-product-image-{{ section_id }} {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover;
  }
  
  .hp16-product-badge-{{ section_id }} {
    position: absolute;
    top: 10px; right: 10px;
    background: #FFFF00;
    border: 2px solid #000;
    padding: 5px 10px;
    font-family: 'Comic Sans MS', cursive;
    font-weight: bold;
    font-size: 0.8rem;
    text-transform: uppercase;
    transform: rotate(10deg);
    box-shadow: 2px 2px 0 #000;
  }
  
  .hp16-product-info-{{ section_id }} {
    padding: 15px;
    text-align: center;
    background: #FFF;
  }
  
  .hp16-product-title-{{ section_id }} {
    font-family: 'Comic Sans MS', cursive;
    font-weight: bold;
    font-size: 1.1rem;
    text-transform: uppercase;
    margin: 0 0 10px 0;
  }
  
  .hp16-product-price-{{ section_id }} {
    font-family: 'Arial Black', sans-serif;
    font-size: 1.2rem;
    color: #FF00FF;
    text-shadow: 1px 1px 0 #000;
  }

  @media (max-width: 992px) {
    .hp16-bestsellers-grid-{{ section_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 60px 20px;
    }
    .hp16-bestsellers-header-{{ section_id }} {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }
  }
</style>

<div class="hp16-bestsellers-container-{{ section_id }}">
  <div class="hp16-bestsellers-header-{{ section_id }}">
    <h2 class="hp16-bestsellers-heading-{{ section_id }}">{{ section.settings.title | default: 'TRENDING RN' }}</h2>
    <a href="{{ collections[section.settings.collection].url | default: '#' }}" class="hp16-bestsellers-link-{{ section_id }}">SEE ALL</a>
  </div>
  
  <div class="hp16-bestsellers-grid-{{ section_id }}">
    {% assign collection = collections[section.settings.collection] %}
    {% if collection != blank and collection.products_count > 0 %}
      {% for product in collection.products limit: 4 %}
        <a href="{{ product.url }}" class="hp16-product-card-{{ section_id }}">
          <div class="hp16-product-image-wrap-{{ section_id }}">
            <img height="{{ product.featured_image.height }}" width="{{ product.featured_image.width }}" src="{{ product.featured_image | image_url: width: 600 }}" class="hp16-product-image-{{ section_id }}" loading="lazy" alt="{{ product.title }}">
            <div class="hp16-product-badge-{{ section_id }}">HOT!</div>
          </div>
          <div class="hp16-product-info-{{ section_id }}">
            <h3 class="hp16-product-title-{{ section_id }}">{{ product.title }}</h3>
            <div class="hp16-product-price-{{ section_id }}">{{ product.price | money }}</div>
          </div>
        </a>
      {% endfor %}
    {% else %}
      {% for i in (1..4) %}
        <a href="#" class="hp16-product-card-{{ section_id }}">
          <div class="hp16-product-image-wrap-{{ section_id }}">
            <div class="hp16-product-image-{{ section_id }}" style="background: repeating-linear-gradient(45deg, #EFEFEF, #EFEFEF 12px, #E6E6E6 12px, #E6E6E6 24px);"></div>
            <div class="hp16-product-badge-{{ section_id }}">HOT!</div>
          </div>
          <div class="hp16-product-info-{{ section_id }}">
            <h3 class="hp16-product-title-{{ section_id }}">PLATFORM BOOTS</h3>
            <div class="hp16-product-price-{{ section_id }}">$89.00</div>
          </div>
        </a>
      {% endfor %}
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "HP16 Bestsellers",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#00FFFF"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "TRENDING RN"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    }
  ],
  "presets": [
    {
      "name": "HP16 Bestsellers"
    }
  ]
}
{% endschema %}
