{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@1,700&family=Inter:wght@300;400&display=swap');

  #shopify-section-{{ section.id }} {
    --bg: {{ section.settings.bg_color }};
    --text: {{ section.settings.text_color }};
    --gold: {{ section.settings.accent_color }};
    --serif: 'Playfair Display', serif;
    --sans: 'Inter', sans-serif;
    background: var(--bg);
    padding: 100px 20px;
  }

  .hp42-testi {
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
  }

  .hp42-testi__line { width: 40px; height: 1px; background: var(--gold); margin: 0 auto 50px; }

  .hp42-testi__list {
    display: flex;
    flex-direction: column;
    gap: 80px;
  }

  .hp42-testi__card {
    text-align: center;
  }

  .hp42-testi__quote {
    font-family: var(--serif);
    font-size: clamp(24px, 3.5vw, {{ section.settings.quote_size }}px);
    font-weight: 700;
    font-style: italic;
    line-height: 1.4;
    color: var(--text);
    margin: 0 0 30px;
  }

  .hp42-testi__author {
    font-family: var(--sans);
    font-size: 13px;
    font-weight: 300;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--gold);
  }

  .hp42-testi__separator {
    width: 20px;
    height: 1px;
    background: rgba(201,169,110,0.3);
    margin: 0 auto;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp42-testi" id="HP42Testi-{{ section.id }}">
  <div class="hp42-testi__line"></div>

  <div class="hp42-testi__list">
    {%- for block in section.blocks limit: 3 -%}
      <div class="hp42-testi__card" {{ block.shopify_attributes }}>
        <blockquote class="hp42-testi__quote">"{{ block.settings.quote }}"</blockquote>
        <div class="hp42-testi__author">{{ block.settings.author }}</div>
      </div>
      {%- unless forloop.last -%}
        <div class="hp42-testi__separator"></div>
      {%- endunless -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "HP42 - Noir Testimonials",
  "class": "section-hp42-testimonials",
  "settings": [
    { "type": "range", "id": "quote_size", "min": 24, "max": 60, "step": 2, "unit": "px", "label": "Quote Size", "default": 36 },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#0A0A0A" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#F5F0EB" },
    { "type": "color", "id": "accent_color", "label": "Gold", "default": "#C9A96E" },
    { "type": "html", "id": "custom_css", "label": "Custom CSS" }
  ],
  "blocks": [{ "type": "review", "name": "Review", "settings": [
    { "type": "textarea", "id": "quote", "label": "Quote", "default": "The most exquisite craftsmanship I have ever encountered." },
    { "type": "text", "id": "author", "label": "Author", "default": "— Victoria R." }
  ]}],
  "presets": [{ "name": "HP42 - Noir Testimonials", "blocks": [
    { "type": "review" },
    { "type": "review", "settings": { "quote": "An investment in timeless beauty. I am utterly captivated.", "author": "— James H." } },
    { "type": "review", "settings": { "quote": "Nothing else compares. Dark, refined, perfect.", "author": "— Isabelle M." } }
  ]}]
}
{% endschema %}
