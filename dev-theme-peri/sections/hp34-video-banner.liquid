{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;700&family=JetBrains+Mono:wght@400;700&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --grid-color: rgba(255, 255, 255, 0.1);
    
    --font-heading: 'Inter', sans-serif;
    --font-body: 'JetBrains Mono', monospace;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    border-bottom: 1px solid var(--grid-color);
  }

  .hp34-video-wrapper {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp34-video-wrapper {
      padding: 0 20px;
    }
  }

  .hp34-video__container {
    position: relative;
    width: 100%;
    aspect-ratio: 16/9;
    background: #000;
    border: 1px solid var(--grid-color);
    overflow: hidden;
  }

  .hp34-video__media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%);
    opacity: 0.6;
    transition: filter 0.5s ease, opacity 0.5s ease;
  }

  .hp34-video__container:hover .hp34-video__media {
    filter: grayscale(0%);
    opacity: 0.8;
  }

  /* HUD elements */
  .hp34-video__hud-top-left {
    position: absolute;
    top: 20px; left: 20px;
    font-family: var(--font-body);
    font-size: 10px;
    color: var(--accent-color);
    z-index: 2;
  }

  .hp34-video__hud-bottom-right {
    position: absolute;
    bottom: 20px; right: 20px;
    font-family: var(--font-body);
    font-size: 10px;
    color: var(--accent-color);
    z-index: 2;
    text-align: right;
  }

  .hp34-video__overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    z-index: 3;
    pointer-events: none;
  }

  .hp34-video__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    color: #fff;
    margin: 0 0 20px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    background: #000;
    padding: 5px 15px;
  }

  .hp34-video__play-btn {
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--bg-color);
    background: var(--accent-color);
    padding: 10px 20px;
    text-transform: uppercase;
    font-weight: 700;
    pointer-events: auto;
    cursor: pointer;
    border: none;
    transition: background 0.3s ease;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .hp34-video__play-btn::before {
    content: '>';
  }

  .hp34-video__play-btn:hover {
    background: #fff;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp34-video-wrapper" id="HP34Video-{{ section.id }}">
  <div class="hp34-video__container">
    <div class="hp34-video__hud-top-left">REC<br><span style="animation: blink 1s infinite; color: red;">●</span> 00:00:00:00</div>
    <div class="hp34-video__hud-bottom-right">CAM_01<br>1080P_60FPS</div>
    
    {%- if section.settings.video_url != blank -%}
      {%- if section.settings.video_url.type == 'youtube' -%}
        <iframe class="hp34-video__media" src="https://www.youtube.com/embed/{{ section.settings.video_url.id }}?autoplay=0&controls=0&mute=1&loop=1&playlist={{ section.settings.video_url.id }}" frameborder="0" allow="autoplay; encrypted-media" allowfullscreen></iframe>
      {%- elsif section.settings.video_url.type == 'vimeo' -%}
        <iframe class="hp34-video__media" src="https://player.vimeo.com/video/{{ section.settings.video_url.id }}?background=1" frameborder="0" allow="autoplay; fullscreen" allowfullscreen></iframe>
      {%- endif -%}
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'hp34-video__media' }}
    {%- endif -%}

    <div class="hp34-video__overlay">
      {%- if section.settings.title != blank -%}
        <h2 class="hp34-video__title">{{ section.settings.title }}</h2>
      {%- endif -%}
      <button class="hp34-video__play-btn" aria-label="Play Video">
        EXECUTE_VIDEO
      </button>
    </div>
  </div>
</div>

<style>
@keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }
</style>

{% schema %}
{
  "name": "HP34 - Tech Video",
  "class": "section-hp34-video-banner",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "SYSTEM CAPABILITIES"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "accept": ["youtube", "vimeo"],
      "label": "Video URL"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 48
    },
    {
      "type": "header",
      "content": "Tech Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (e.g. Black)",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#FF4500"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP34 - Tech Video"
    }
  ]
}
{% endschema %}
