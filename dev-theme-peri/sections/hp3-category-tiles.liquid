{%- liquid
  assign bg_color = section.settings.bg_color | default: '#111111'
  assign text_color = section.settings.text_color | default: '#ffffff'
  
  assign padding_top_desktop = section.settings.padding_top_desktop
  assign padding_bottom_desktop = section.settings.padding_bottom_desktop
  assign padding_top_mobile = section.settings.padding_top_mobile
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile
-%}

<style>
  #shopify-section-{{ section.id }} {
    --hp3-ct-bg: {{ bg_color }};
    --hp3-ct-text: {{ text_color }};
    
    --hp3-ct-pt-desk: {{ padding_top_desktop }}px;
    --hp3-ct-pb-desk: {{ padding_bottom_desktop }}px;
    --hp3-ct-pt-mob: {{ padding_top_mobile }}px;
    --hp3-ct-pb-mob: {{ padding_bottom_mobile }}px;
  }

  .hp3-tech-ct-{{ section.id }} {
    padding-top: var(--hp3-ct-pt-desk);
    padding-bottom: var(--hp3-ct-pb-desk);
    background-color: var(--hp3-ct-bg);
    color: var(--hp3-ct-text);
    font-family: 'Inter', sans-serif;
  }

  .hp3-ct-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
  }

  /* Grid configuration - Masonry style */
  .hp3-ct-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: 300px;
    gap: 20px;
  }

  /* Specific block spans to create asymmetric bento grid */
  .hp3-ct-item {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    background: #000;
    text-decoration: none;
    color: #fff;
    group;
  }

  .hp3-ct-item:nth-child(1) { grid-column: span 2; grid-row: span 2; }
  .hp3-ct-item:nth-child(2) { grid-column: span 1; grid-row: span 1; }
  .hp3-ct-item:nth-child(3) { grid-column: span 1; grid-row: span 1; }
  .hp3-ct-item:nth-child(4) { grid-column: span 3; grid-row: span 1; }

  .hp3-ct-media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    opacity: 0.6;
  }
  
  .hp3-ct-item:hover .hp3-ct-media {
    transform: scale(1.05);
    opacity: 0.8;
  }

  /* Techy Overlay gradients */
  .hp3-ct-item::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.9) 0%, transparent 60%);
    pointer-events: none;
  }

  .hp3-ct-content {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    padding: 30px;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .hp3-ct-title {
    font-size: clamp(24px, 3vw, 40px);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -1px;
    margin: 0 0 10px 0;
    text-shadow: 0 2px 10px rgba(0,0,0,0.5);
  }

  .hp3-ct-link-text {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    background: rgba(255,255,255,0.1);
    backdrop-filter: blur(5px);
    border: 1px solid rgba(255,255,255,0.2);
    border-radius: 4px;
    transition: all 0.3s ease;
  }
  
  .hp3-ct-item:hover .hp3-ct-link-text {
    background: #fff;
    color: #000;
  }

  @media screen and (max-width: 1024px) {
    .hp3-ct-grid {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 250px;
    }
    .hp3-ct-item:nth-child(1) { grid-column: span 2; grid-row: span 1; }
    .hp3-ct-item:nth-child(2) { grid-column: span 1; grid-row: span 1; }
    .hp3-ct-item:nth-child(3) { grid-column: span 1; grid-row: span 1; }
    .hp3-ct-item:nth-child(4) { grid-column: span 2; grid-row: span 1; }
  }

  @media screen and (max-width: 768px) {
    .hp3-tech-ct-{{ section.id }} {
      padding-top: var(--hp3-ct-pt-mob);
      padding-bottom: var(--hp3-ct-pb-mob);
    }
    .hp3-ct-inner {
      padding: 0 20px;
    }
    .hp3-ct-grid {
      grid-template-columns: 1fr;
      grid-auto-rows: 220px;
      gap: 15px;
    }
    .hp3-ct-item:nth-child(1),
    .hp3-ct-item:nth-child(2),
    .hp3-ct-item:nth-child(3),
    .hp3-ct-item:nth-child(4) {
      grid-column: span 1;
      grid-row: span 1;
    }
    .hp3-ct-content {
      padding: 20px;
    }
    .hp3-ct-title {
      font-size: 20px;
    }
  }
</style>

<section class="hp3-tech-ct-{{ section.id }}" aria-label="Category Tiles">
  <div class="hp3-ct-inner">
    
    <div class="hp3-ct-grid">
      {%- for block in section.blocks limit: 4 -%}
        <a href="{{ block.settings.link | default: '#' }}" class="hp3-ct-item" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img height="{{ block.settings.image.height }}" width="{{ block.settings.image.width }}" src="{{ block.settings.image | image_url: width: 1200 }}" 
                 class="hp3-ct-media" 
                 loading="lazy" 
                 alt="{{ block.settings.title | escape }}">
          {%- else -%}
             {%- capture current -%}{% cycle 1, 2, 3, 4 %}{%- endcapture -%}
             {{ 'collection-' | append: current | placeholder_svg_tag: 'hp3-ct-media placeholder-svg' }}
          {%- endif -%}
          
          <div class="hp3-ct-content">
            <h3 class="hp3-ct-title">{{ block.settings.title | default: 'Category Name' }}</h3>
            <span class="hp3-ct-link-text">
              EXPLORE
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </span>
          </div>
        </a>
      {%- endfor -%}
      
      {%- if section.blocks.size == 0 -%}
        {%- for i in (1..4) -%}
          <a href="#" class="hp3-ct-item">
            {%- capture current -%}{% cycle 1, 2, 3, 4 %}{%- endcapture -%}
            {{ 'collection-' | append: current | placeholder_svg_tag: 'hp3-ct-media placeholder-svg' }}
            <div class="hp3-ct-content">
              <h3 class="hp3-ct-title">TECH GEAR {{ i }}</h3>
              <span class="hp3-ct-link-text">EXPLORE</span>
            </div>
          </a>
        {%- endfor -%}
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "HP3 Category Tiles",
  "tag": "section",
  "class": "section-hp3-ct",
  "max_blocks": 4,
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Top (Desktop)", "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Bottom (Desktop)", "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Top (Mobile)", "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Bottom (Mobile)", "default": 40
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Tile",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Background Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Category Title",
          "default": "SMART HOME"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP3 Category Tiles (Adv)",
      "category": "Collection",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
