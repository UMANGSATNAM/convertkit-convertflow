{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp47-trust-bg: {{ section.settings.bg_color | default: '#382E2B' }};
    --hp47-trust-text: {{ section.settings.text_color | default: '#FAF7F2' }};
    
    background-color: var(--hp47-trust-bg);
    color: var(--hp47-trust-text);
    padding-top: {{ section.settings.padding_top | default: 50 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 50 }}px;
  }

  .hp47-trust__grid {
    max-width: {{ section.settings.container_width | default: 1200 }}px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: 4 }}, 1fr);
    gap: 30px;
    text-align: center;
  }

  .hp47-trust__icon {
    font-size: 30px;
    margin-bottom: 12px;
  }

  .hp47-trust__title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 18px;
    font-weight: 700;
    margin: 0 0 6px;
  }

  .hp47-trust__desc {
    font-size: 13px;
    color: #D6CCC2;
    margin: 0;
  }

  @media screen and (max-width: 992px) {
    .hp47-trust__grid { grid-template-columns: repeat(2, 1fr); }
  }
{%- endstyle -%}

<div class="hp47-trust__grid">
  {%- if section.blocks.size > 0 -%}
    {%- for block in section.blocks -%}
      <div {{ block.shopify_attributes }}>
        <div class="hp47-trust__icon">{{ block.settings.icon | default: '🌾' }}</div>
        <h4 class="hp47-trust__title">{{ block.settings.title }}</h4>
        <p class="hp47-trust__desc">{{ block.settings.description }}</p>
      </div>
    {%- endfor -%}
  {%- else -%}
    <div>
      <div class="hp47-trust__icon">🌾</div>
      <h4 class="hp47-trust__title">100% Organic Oat</h4>
      <p class="hp47-trust__desc">Certified Scandinavian bio-harvest.</p>
    </div>
    <div>
      <div class="hp47-trust__icon">✈️</div>
      <h4 class="hp47-trust__title">Air Express DDP</h4>
      <p class="hp47-trust__desc">Pre-cleared customs in 180+ nations.</p>
    </div>
    <div>
      <div class="hp47-trust__icon">🛡️</div>
      <h4 class="hp47-trust__title">30-Day Ritual Accord</h4>
      <p class="hp47-trust__desc">Risk-free trial guarantee.</p>
    </div>
    <div>
      <div class="hp47-trust__icon">🔒</div>
      <h4 class="hp47-trust__title">256-Bit SSL Checkout</h4>
      <p class="hp47-trust__desc">Encrypted payment protection.</p>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "HP47 - Taupe Badges",
  "class": "section-hp47-badges",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#382E2B" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#FAF7F2" },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "label": "Desktop Columns", "default": 4 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 100, "step": 5, "unit": "px", "label": "Padding Top", "default": 50 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 100, "step": 5, "unit": "px", "label": "Padding Bottom", "default": 50 },
    { "type": "range", "id": "container_width", "min": 800, "max": 1400, "step": 20, "unit": "px", "label": "Container Width", "default": 1200 }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon", "default": "🌾" },
        { "type": "text", "id": "title", "label": "Title", "default": "100% Organic Oat" },
        { "type": "text", "id": "description", "label": "Description", "default": "Certified Scandinavian bio-harvest." }
      ]
    }
  ],
  "presets": [
    { "name": "HP47 - Taupe Badges" }
  ]
}
{% endschema %}
