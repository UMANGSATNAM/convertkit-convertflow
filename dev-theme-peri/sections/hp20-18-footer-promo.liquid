{%- liquid
  assign sec_id = section.id
-%}

<style>
  #shopify-section-{{ sec_id }} {
    background-color: {{ section.settings.bg_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px 0;
  }

  .hp20-footer-promo-{{ sec_id }} {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hp20-footer-promo-{{ sec_id }}__icon {
    width: 60px;
    height: 60px;
    margin-bottom: 32px;
  }

  .hp20-footer-promo-{{ sec_id }}__title {
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-size: clamp(32px, 5vw, 56px);
    font-weight: 300;
    color: {{ section.settings.text_color }};
    margin: 0 0 24px 0;
    letter-spacing: -0.02em;
    max-width: 800px;
  }

  .hp20-footer-promo-{{ sec_id }}__text {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 16px;
    line-height: 1.6;
    color: {{ section.settings.text_color }};
    opacity: 0.8;
    margin: 0 0 40px 0;
    max-width: 600px;
  }

  .hp20-footer-promo-{{ sec_id }}__btn {
    display: inline-block;
    padding: 18px 48px;
    background-color: {{ section.settings.btn_bg }};
    color: {{ section.settings.btn_text }};
    text-decoration: none;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    transition: opacity 0.3s ease;
  }

  .hp20-footer-promo-{{ sec_id }}__btn:hover {
    opacity: 0.8;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ sec_id }} {
      padding: {{ section.settings.padding_top_mobile }}px 0 {{ section.settings.padding_bottom_mobile }}px 0;
    }
  }
</style>

<section class="hp20-footer-promo-{{ sec_id }}">
  {% if section.settings.image %}
    <img src="{{ section.settings.image | image_url: width: 120 }}" alt="" class="hp20-footer-promo-{{ sec_id }}__icon">
  {% endif %}
  
  <h2 class="hp20-footer-promo-{{ sec_id }}__title">{{ section.settings.title }}</h2>
  
  {% if section.settings.text != blank %}
    <p class="hp20-footer-promo-{{ sec_id }}__text">{{ section.settings.text }}</p>
  {% endif %}
  
  {% if section.settings.btn_link != blank %}
    <a href="{{ section.settings.btn_link }}" class="hp20-footer-promo-{{ sec_id }}__btn">{{ section.settings.btn_label }}</a>
  {% endif %}
</section>

{% schema %}
{
  "name": "HP20 Footer Promo",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Icon/Small Image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Elevate Your Space."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Explore our curated collection of minimalist essentials designed for the modern lifestyle."
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "Shop Collection"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "btn_bg",
      "label": "Button Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "btn_text",
      "label": "Button Text Color",
      "default": "#1a1a1a"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0, "max": 200, "step": 10, "unit": "px",
      "label": "Desktop Top Padding", "default": 140
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0, "max": 200, "step": 10, "unit": "px",
      "label": "Desktop Bottom Padding", "default": 140
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0, "max": 120, "step": 10, "unit": "px",
      "label": "Mobile Top Padding", "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0, "max": 120, "step": 10, "unit": "px",
      "label": "Mobile Bottom Padding", "default": 80
    }
  ],
  "presets": [
    {
      "name": "HP20 Footer Promo"
    }
  ]
}
{% endschema %}
