{%- liquid
  assign section_id = section.id
-%}

<div id="shopify-section-{{ section_id }}" class="hp16-custom-html-wrapper" style="padding: {{ section.settings.padding_top }}px {{ section.settings.padding_side }}px {{ section.settings.padding_bottom }}px;">
  {{ section.settings.custom_html }}
</div>

{% schema %}
{
  "name": "HP16 Custom HTML",
  "settings": [
    {
      "type": "html",
      "id": "custom_html",
      "label": "Custom HTML",
      "default": "<div style='text-align: center; font-family: Arial Black, sans-serif; font-size: 3rem; color: #FF00FF; text-shadow: 3px 3px 0px #000; -webkit-text-stroke: 1px #000;'>XOXO</div>"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_side",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Side",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "HP16 Custom HTML"
    }
  ]
}
{% endschema %}
