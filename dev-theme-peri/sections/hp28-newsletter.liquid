{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Chakra+Petch:ital,wght@0,300;0,400;0,600;0,700;1,400&family=Press+Start+2P&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --cyan: {{ section.settings.cyan_color }};
    --magenta: {{ section.settings.magenta_color }};
    --green: {{ section.settings.green_color }};
    
    --font-heading: 'Press Start 2P', cursive;
    --font-body: 'Chakra Petch', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    position: relative;
    overflow: hidden;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.8 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.8 | round }}px;
    }
  }

  /* 3D Wireframe / Neon Grid BG */
  #shopify-section-{{ section.id }}::before {
    content: '';
    position: absolute;
    bottom: -50%; left: -50%; width: 200%; height: 200%;
    background-image: 
      linear-gradient(rgba(0, 255, 255, 0.2) 2px, transparent 2px),
      linear-gradient(90deg, rgba(0, 255, 255, 0.2) 2px, transparent 2px);
    background-size: 60px 60px;
    transform: perspective(500px) rotateX(60deg);
    transform-origin: center bottom;
    pointer-events: none;
    z-index: 0;
    animation: hp28GridMove 10s linear infinite;
  }

  @keyframes hp28GridMove {
    0% { transform: perspective(500px) rotateX(60deg) translateY(0); }
    100% { transform: perspective(500px) rotateX(60deg) translateY(60px); }
  }

  .hp28-nl-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: center;
  }

  @media screen and (max-width: 768px) {
    .hp28-nl-wrapper {
      padding: 0 20px;
    }
  }

  .hp28-nl__container {
    background: rgba(0,0,0,0.85);
    border: 4px solid var(--magenta);
    box-shadow: 0 0 20px var(--magenta), inset 0 0 10px var(--magenta);
    padding: 60px;
    text-align: center;
    width: 100%;
    max-width: 800px;
  }

  @media screen and (max-width: 768px) {
    .hp28-nl__container {
      padding: 40px 20px;
    }
  }

  .hp28-nl__title {
    font-family: var(--font-heading);
    font-size: clamp(20px, 3.5vw, {{ section.settings.title_size }}px);
    color: var(--cyan);
    margin: 0 0 20px;
    text-transform: uppercase;
    text-shadow: 2px 2px 0 var(--magenta);
  }

  .hp28-nl__text {
    font-family: var(--font-body);
    font-size: 16px;
    color: var(--text-color);
    margin: 0 0 40px;
    letter-spacing: 0.05em;
  }

  .hp28-nl__form-wrap {
    display: flex;
    max-width: 600px;
    margin: 0 auto;
    position: relative;
  }

  @media screen and (max-width: 576px) {
    .hp28-nl__form-wrap {
      flex-direction: column;
      gap: 15px;
    }
  }

  /* Terminal Prompt Style Input */
  .hp28-nl__input-group {
    flex: 1;
    display: flex;
    background: #000;
    border: 2px solid var(--green);
    position: relative;
  }

  .hp28-nl__prompt {
    font-family: var(--font-heading);
    color: var(--green);
    font-size: 12px;
    padding: 16px 0 16px 16px;
    user-select: none;
    display: flex;
    align-items: center;
  }

  .hp28-nl__input {
    flex: 1;
    background: transparent;
    border: none;
    color: var(--green);
    font-family: var(--font-body);
    font-size: 16px;
    padding: 16px;
    outline: none;
  }
  .hp28-nl__input::placeholder {
    color: rgba(57, 255, 20, 0.4);
  }

  /* Mechanical Keyboard Enter Button */
  .hp28-nl__btn {
    background: #c0c0c0;
    border-top: 4px solid #fff;
    border-left: 4px solid #fff;
    border-right: 4px solid #808080;
    border-bottom: 4px solid #808080;
    color: #000;
    font-family: var(--font-heading);
    font-size: 14px;
    padding: 0 30px;
    cursor: pointer;
    transition: all 0.1s ease;
    text-transform: uppercase;
  }

  @media screen and (max-width: 576px) {
    .hp28-nl__btn {
      padding: 16px;
    }
  }

  .hp28-nl__btn:active {
    border-top: 4px solid #808080;
    border-left: 4px solid #808080;
    border-right: 4px solid #fff;
    border-bottom: 4px solid #fff;
    background: #a0a0a0;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp28-nl-wrapper" id="HP28Newsletter-{{ section.id }}">
  <div class="hp28-nl__container">
    {%- if section.settings.title != blank -%}
      <h2 class="hp28-nl__title">{{ section.settings.title }}</h2>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="hp28-nl__text">{{ section.settings.text }}</div>
    {%- endif -%}

    <div class="hp28-nl__form-wrap">
      {%- form 'customer', class: 'hp28-nl__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        
        <div class="hp28-nl__input-group">
          <span class="hp28-nl__prompt">C:\></span>
          <input 
            type="email" 
            name="contact[email]" 
            class="hp28-nl__input"
            placeholder="{{ section.settings.placeholder }}" 
            required
            aria-label="Email address"
          >
        </div>

        <button type="submit" class="hp28-nl__btn">
          {{ section.settings.button_text }}
        </button>
        
        {%- if form.posted_successfully? -%}
          <div style="color: var(--green); margin-top: 15px; font-family: var(--font-body); font-weight: 700; width: 100%;">
            SYSTEM OVERRIDE COMPLETE.
          </div>
        {%- elsif form.errors -%}
          <div style="color: var(--magenta); margin-top: 15px; font-family: var(--font-body); font-weight: 700; width: 100%;">
            ERROR: CONNECTION REFUSED.
          </div>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "HP28 - Y2K Newsletter",
  "class": "section-hp28-newsletter",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "JOIN THE MAINFRAME"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Input your coordinates to receive encrypted dispatches and early access to hardware drops.</p>"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input Placeholder",
      "default": "TYPE_EMAIL_HERE"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "ENTER"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 800,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1200
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 40
    },
    {
      "type": "header",
      "content": "Y2K Cyber Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (Deep Purple)",
      "default": "#1C0B2B"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Base Text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "cyan_color",
      "label": "Cyan Accent",
      "default": "#00FFFF"
    },
    {
      "type": "color",
      "id": "magenta_color",
      "label": "Magenta Accent",
      "default": "#FF00FF"
    },
    {
      "type": "color",
      "id": "green_color",
      "label": "Acid Green Accent",
      "default": "#39FF14"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 120
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP28 - Y2K Newsletter"
    }
  ]
}
{% endschema %}
