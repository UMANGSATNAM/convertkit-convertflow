{% comment %}
  Urgency Sticky ATC Bar - High-CRO Bottom Floating Sticky Bar with Countdown
  PageFly-Style Booster Section
{% endcomment %}

<div id="cf-sticky-urgency-{{ section.id }}" class="cf-sticky-urgency" style="background: {{ section.settings.bg_color | default: '#0f172a' }}; color: {{ section.settings.text_color | default: '#ffffff' }};">
  <div class="cf-sticky-urgency__container">
    <!-- Left: Product info & urgency badge -->
    <div class="cf-sticky-urgency__left">
      <div class="cf-sticky-thumb">
        <img src="https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=120&q=80" alt="Product" width="44" height="44" loading="lazy">
      </div>
      <div class="cf-sticky-details">
        <div class="cf-sticky-title">{{ section.settings.product_title | default: 'Featured Bestseller Limited Edition' }}</div>
        <div class="cf-sticky-pricing">
          <span class="cf-sticky-price" style="color: {{ section.settings.price_color | default: '#10b981' }};">{{ section.settings.sale_price | default: '₹1,499' }}</span>
          <span class="cf-sticky-compare">{{ section.settings.original_price | default: '₹2,999' }}</span>
          <span class="cf-sticky-discount-badge">{{ section.settings.discount_tag | default: '50% OFF' }}</span>
        </div>
      </div>
    </div>

    <!-- Center: Countdown badge -->
    <div class="cf-sticky-urgency__center">
      <div class="cf-sticky-timer-pill">
        <span class="cf-sticky-dot"></span>
        <span class="cf-sticky-timer-text">DEAL EXPIRES:</span>
        <span class="cf-sticky-countdown">02:34:15</span>
      </div>
    </div>

    <!-- Right: Form actions -->
    <div class="cf-sticky-urgency__right">
      <form action="/cart/add" method="post" class="cf-sticky-form">
        <input type="hidden" name="id" value="1">
        <button type="submit" class="cf-sticky-submit" style="background: {{ section.settings.btn_color | default: '#10b981' }}; color: #ffffff;">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
          {{ section.settings.btn_text | default: 'Claim Offer Now' }}
        </button>
      </form>
    </div>
  </div>
</div>

<style>
  .cf-sticky-urgency {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 999999;
    padding: 10px 18px;
    box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.18);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    box-sizing: border-box;
  }
  .cf-sticky-urgency__container {
    max-width: 1380px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
  }
  .cf-sticky-urgency__left {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .cf-sticky-thumb {
    width: 44px;
    height: 44px;
    border-radius: 8px;
    overflow: hidden;
    background: #1e293b;
    flex-shrink: 0;
  }
  .cf-sticky-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cf-sticky-details {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .cf-sticky-title {
    font-size: 13px;
    font-weight: 700;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 320px;
  }
  .cf-sticky-pricing {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .cf-sticky-price {
    font-size: 14px;
    font-weight: 800;
  }
  .cf-sticky-compare {
    font-size: 12px;
    color: #94a3b8;
    text-decoration: line-through;
  }
  .cf-sticky-discount-badge {
    font-size: 10px;
    font-weight: 800;
    background: #ef4444;
    color: #ffffff;
    padding: 1px 6px;
    border-radius: 99px;
  }
  .cf-sticky-urgency__center {
    display: flex;
    align-items: center;
  }
  .cf-sticky-timer-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    padding: 6px 12px;
    border-radius: 99px;
  }
  .cf-sticky-dot {
    width: 7px;
    height: 7px;
    background: #ef4444;
    border-radius: 99px;
    animation: cfPulse 1.4s infinite;
  }
  .cf-sticky-timer-text {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.5px;
    color: #94a3b8;
  }
  .cf-sticky-countdown {
    font-family: monospace;
    font-size: 13px;
    font-weight: 800;
    color: #f59e0b;
  }
  .cf-sticky-urgency__right {
    display: flex;
    align-items: center;
  }
  .cf-sticky-submit {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 22px;
    border: none;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .cf-sticky-submit:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(16, 185, 129, 0.4);
  }
  @media (max-width: 768px) {
    .cf-sticky-urgency__center {
      display: none;
    }
    .cf-sticky-title {
      max-width: 150px;
    }
    .cf-sticky-submit {
      padding: 8px 14px;
      font-size: 12px;
    }
  }
</style>

<script>
  (function() {
    var bar = document.getElementById("cf-sticky-urgency-{{ section.id }}");
    if (!bar) return;
    var timerEl = bar.querySelector(".cf-sticky-countdown");
    if (!timerEl) return;
    var target = Date.now() + 2 * 3600 * 1000 + 34 * 60 * 1000 + 15 * 1000;
    setInterval(function() {
      var remaining = Math.max(0, target - Date.now());
      var h = Math.floor(remaining / (3600 * 1000));
      var m = Math.floor((remaining % (3600 * 1000)) / (60 * 1000));
      var s = Math.floor((remaining % (60 * 1000)) / 1000);
      timerEl.textContent = ("0" + h).slice(-2) + ":" + ("0" + m).slice(-2) + ":" + ("0" + s).slice(-2);
    }, 1000);
  })();
</script>

{% schema %}
{
  "name": "Urgency Sticky ATC",
  "settings": [
    { "type": "text", "id": "product_title", "label": "Product Title", "default": "Featured Bestseller Limited Edition" },
    { "type": "text", "id": "sale_price", "label": "Sale Price", "default": "₹1,499" },
    { "type": "text", "id": "original_price", "label": "Original Price", "default": "₹2,999" },
    { "type": "text", "id": "discount_tag", "label": "Discount Tag", "default": "50% OFF" },
    { "type": "text", "id": "btn_text", "label": "Button Label", "default": "Claim Offer Now" },
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#0f172a" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#ffffff" },
    { "type": "color", "id": "btn_color", "label": "Button Color", "default": "#10b981" },
    { "type": "color", "id": "price_color", "label": "Price Color", "default": "#10b981" }
  ],
  "presets": [
    {
      "name": "Urgency Sticky ATC"
    }
  ]
}
{% endschema %}
