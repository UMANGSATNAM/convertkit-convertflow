{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp51-offer-bg: {{ section.settings.bg_color | default: '#1E3A2B' }};
    
    background: var(--hp51-offer-bg);
    color: #FAF8F5;
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
    text-align: center;
    border-radius: 24px;
    margin: 40px auto;
    max-width: {{ section.settings.container_width | default: 1240 }}px;
    position: relative;
    overflow: hidden;
  }

  .hp51-offer__box {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp51-offer__pill {
    display: inline-block;
    padding: 6px 20px;
    background: rgba(250, 248, 245, 0.15);
    border-radius: 50px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    color: #FAF8F5;
    margin-bottom: 20px;
    text-transform: uppercase;
  }

  .hp51-offer__title {
    font-family: 'Noto Serif JP', serif;
    font-size: clamp(32px, 5vw, 46px);
    font-weight: 700;
    line-height: 1.15;
    margin: 0 0 16px;
  }

  .hp51-offer__desc {
    font-size: 16px;
    line-height: 1.8;
    color: #D3DDD6;
    margin: 0 auto 30px;
    max-width: 580px;
  }

  .hp51-offer__code-wrap {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background: rgba(0, 0, 0, 0.25);
    border: 1px dashed rgba(250, 248, 245, 0.4);
    border-radius: 50px;
    padding: 10px 24px;
    margin-bottom: 30px;
  }

  .hp51-offer__code {
    font-family: 'DM Sans', sans-serif;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 2px;
    color: #FAF8F5;
  }

  .hp51-offer__btn {
    display: inline-flex;
    padding: 16px 36px;
    background: #FAF8F5;
    color: #1E3A2B;
    font-family: 'DM Sans', sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 50px;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
    transition: all 0.25s ease;
  }

  .hp51-offer__btn:hover {
    background: #FFFFFF;
    transform: translateY(-2px);
  }
{%- endstyle -%}

<div class="hp51-offer__box">
  <span class="hp51-offer__pill">{{ section.settings.badge | default: 'TEA MASTER PRIVILEGE' }}</span>
  <h2 class="hp51-offer__title">{{ section.settings.heading | default: 'Enjoy 15% Honorarium on Your Kyoto Ritual' }}</h2>
  <p class="hp51-offer__desc">
    {{ section.settings.description | default: 'Experience the antioxidant purity of shade-grown Uji ceremonial matcha. Redeem code at checkout.' }}
  </p>

  <div class="hp51-offer__code-wrap">
    <span class="hp51-offer__code">CODE: {{ section.settings.promo_code | default: 'ZEN15' }}</span>
  </div>

  <div>
    <a href="{{ section.settings.btn_url | default: '/collections/all' }}" class="hp51-offer__btn">
      {{ section.settings.btn_text | default: 'Claim Zen Honorarium &rarr;' }}
    </a>
  </div>
</div>

{% schema %}
{
  "name": "HP51 - Zen Offer",
  "class": "section-hp51-offer",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#1E3A2B" },
    { "type": "text", "id": "badge", "label": "Badge", "default": "TEA MASTER PRIVILEGE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Enjoy 15% Honorarium on Your Kyoto Ritual" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Experience the antioxidant purity of shade-grown Uji ceremonial matcha." },
    { "type": "text", "id": "promo_code", "label": "Promo Code", "default": "ZEN15" },
    { "type": "text", "id": "btn_text", "label": "Button Text", "default": "Claim Zen Honorarium →" },
    { "type": "url", "id": "btn_url", "label": "Button URL" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 5, "unit": "px", "label": "Padding Top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 5, "unit": "px", "label": "Padding Bottom", "default": 80 },
    { "type": "range", "id": "container_width", "min": 800, "max": 1400, "step": 20, "unit": "px", "label": "Container Width", "default": 1240 }
  ],
  "presets": [
    { "name": "HP51 - Zen Offer" }
  ]
}
{% endschema %}
