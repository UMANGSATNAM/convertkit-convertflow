{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --font-body: 'JetBrains Mono', monospace;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .hp34-tags-wrapper {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp34-tags-wrapper {
      padding: 0 20px;
    }
  }

  .hp34-tags__list {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
    justify-content: center;
  }

  .hp34-tags__item {
    font-family: var(--font-body);
    font-size: 13px;
    color: var(--text-color);
    text-decoration: none;
    text-transform: uppercase;
    font-weight: 700;
    padding: 10px 20px;
    background: transparent;
    transition: all 0.3s ease;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .hp34-tags__item::before {
    content: '[';
    color: var(--accent-color);
  }

  .hp34-tags__item::after {
    content: ']';
    color: var(--accent-color);
  }

  .hp34-tags__item:hover {
    background: var(--text-color);
    color: var(--bg-color);
  }
  
  .hp34-tags__item:hover::before,
  .hp34-tags__item:hover::after {
    color: var(--bg-color);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp34-tags-wrapper" id="HP34Tags-{{ section.id }}">
  <div class="hp34-tags__list">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.link | default: '#' }}" class="hp34-tags__item" {{ block.shopify_attributes }}>
        {{ block.settings.title }}
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "HP34 - Tech Tags",
  "class": "section-hp34-category-pills",
  "settings": [
    {
      "type": "header",
      "content": "Tech Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#FF4500"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Top Padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 40
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "tag",
      "name": "Tag",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "CATEGORY"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP34 - Tech Tags",
      "blocks": [
        { "type": "tag", "settings": { "title": "MENSWEAR" } },
        { "type": "tag", "settings": { "title": "WOMENSWEAR" } },
        { "type": "tag", "settings": { "title": "ACCESSORIES" } },
        { "type": "tag", "settings": { "title": "ARCHIVE" } },
        { "type": "tag", "settings": { "title": "SYSTEM_TOOLS" } }
      ]
    }
  ]
}
{% endschema %}
