{%- liquid
  assign bg_color = section.settings.bg_color | default: '#000000'
  assign text_color = section.settings.text_color | default: '#ffffff'
  assign accent_color = section.settings.accent_color | default: '#ff4500'
  
  assign padding_top_desktop = section.settings.padding_top_desktop
  assign padding_bottom_desktop = section.settings.padding_bottom_desktop
  assign padding_top_mobile = section.settings.padding_top_mobile
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile
-%}

<style>
  #shopify-section-{{ section.id }} {
    --hp6-hero-bg: {{ bg_color }};
    --hp6-hero-text: {{ text_color }};
    --hp6-hero-accent: {{ accent_color }};
    
    --hp6-hero-pt-desk: {{ padding_top_desktop }}px;
    --hp6-hero-pb-desk: {{ padding_bottom_desktop }}px;
    --hp6-hero-pt-mob: {{ padding_top_mobile }}px;
    --hp6-hero-pb-mob: {{ padding_bottom_mobile }}px;
  }

  .hp6-sports-hero-{{ section.id }} {
    position: relative;
    width: 100%;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--hp6-hero-bg);
    overflow: hidden;
    padding-top: var(--hp6-hero-pt-desk);
    padding-bottom: var(--hp6-hero-pb-desk);
  }

  /* Media Background */
  .hp6-hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }
  .hp6-hero-bg img, .hp6-hero-bg video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.8;
  }
  .hp6-hero-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0.3) 50%, rgba(0,0,0,0.1) 100%);
    z-index: 2;
  }

  /* Content */
  .hp6-hero-content {
    position: relative;
    z-index: 10;
    max-width: 1200px;
    width: 100%;
    margin: 0 auto;
    padding: 0 40px;
    text-align: {{ section.settings.text_alignment }};
    color: var(--hp6-hero-text);
  }

  .hp6-hero-badge {
    display: inline-flex;
    align-items: center;
    background: var(--hp6-hero-accent);
    color: #fff;
    padding: 8px 16px;
    border-radius: 30px;
    font-family: 'Oswald', sans-serif;
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 30px;
    clip-path: polygon(10% 0, 100% 0, 90% 100%, 0% 100%);
    animation: hp6SlideRight 0.8s cubic-bezier(0.19, 1, 0.22, 1) forwards;
    opacity: 0;
    transform: translateX(-50px);
  }

  .hp6-hero-title {
    font-family: 'Oswald', sans-serif;
    font-size: clamp(48px, 8vw, 100px);
    font-weight: 700;
    text-transform: uppercase;
    line-height: 0.9;
    margin: 0 0 20px 0;
    letter-spacing: -2px;
    text-shadow: 2px 4px 10px rgba(0,0,0,0.5);
    opacity: 0;
    animation: hp6SlideUp 1s cubic-bezier(0.19, 1, 0.22, 1) 0.2s forwards;
    transform: translateY(50px);
  }

  .hp6-hero-title span {
    color: transparent;
    -webkit-text-stroke: 2px var(--hp6-hero-text);
    display: block;
  }
  
  {% if section.settings.accent_title %}
  .hp6-hero-title strong {
    color: var(--hp6-hero-accent);
    -webkit-text-stroke: 0;
  }
  {% endif %}

  .hp6-hero-desc {
    font-family: 'Inter', sans-serif;
    font-size: clamp(16px, 2vw, 22px);
    line-height: 1.5;
    max-width: 600px;
    margin: 0 {% if section.settings.text_alignment == 'center' %}auto{% else %}0{% endif %} 40px {% if section.settings.text_alignment == 'center' %}auto{% else %}0{% endif %};
    color: rgba(255,255,255,0.8);
    opacity: 0;
    animation: hp6SlideUp 1s cubic-bezier(0.19, 1, 0.22, 1) 0.4s forwards;
    transform: translateY(30px);
  }

  /* Actions */
  .hp6-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    justify-content: {% if section.settings.text_alignment == 'center' %}center{% elsif section.settings.text_alignment == 'right' %}flex-end{% else %}flex-start{% endif %};
    opacity: 0;
    animation: hp6FadeIn 1s ease 0.6s forwards;
  }

  .hp6-btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--hp6-hero-accent);
    color: #fff;
    font-family: 'Oswald', sans-serif;
    font-size: 18px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 20px 40px;
    text-decoration: none;
    clip-path: polygon(5% 0, 100% 0, 95% 100%, 0% 100%);
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }
  
  .hp6-btn-primary::before {
    content: '';
    position: absolute;
    top: 0; left: -100%;
    width: 100%; height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
    transition: left 0.5s ease;
  }

  .hp6-btn-primary:hover {
    transform: scale(1.05) skewX(-2deg);
    box-shadow: 0 10px 20px rgba(255, 69, 0, 0.3);
  }
  .hp6-btn-primary:hover::before {
    left: 100%;
  }

  .hp6-btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    color: var(--hp6-hero-text);
    font-family: 'Oswald', sans-serif;
    font-size: 18px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 20px 40px;
    text-decoration: none;
    border: 2px solid rgba(255,255,255,0.3);
    clip-path: polygon(5% 0, 100% 0, 95% 100%, 0% 100%);
    transition: all 0.3s ease;
  }
  .hp6-btn-secondary:hover {
    border-color: var(--hp6-hero-text);
    background: rgba(255,255,255,0.1);
  }

  /* Animations */
  @keyframes hp6SlideUp {
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes hp6SlideRight {
    to { opacity: 1; transform: translateX(0); }
  }
  @keyframes hp6FadeIn {
    to { opacity: 1; }
  }

  @media screen and (max-width: 768px) {
    .hp6-sports-hero-{{ section.id }} {
      min-height: 80vh;
      padding-top: var(--hp6-hero-pt-mob);
      padding-bottom: var(--hp6-hero-pb-mob);
    }
    .hp6-hero-content {
      padding: 0 20px;
      text-align: center;
    }
    .hp6-hero-desc {
      margin-left: auto; margin-right: auto;
    }
    .hp6-hero-actions {
      justify-content: center;
      flex-direction: column;
      gap: 15px;
    }
    .hp6-btn-primary, .hp6-btn-secondary {
      width: 100%;
      padding: 16px 20px;
    }
  }
</style>

<section class="hp6-sports-hero-{{ section.id }}" aria-label="Hero Section">
  
  <div class="hp6-hero-bg">
    {%- if section.settings.bg_video != blank -%}
      {{ section.settings.bg_video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true }}
    {%- elsif section.settings.bg_image != blank -%}
      <img height="{{ section.settings.bg_image.height }}" width="{{ section.settings.bg_image.width }}" src="{{ section.settings.bg_image | image_url: width: 2000 }}" loading="eager" alt="Hero Background">
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </div>

  <div class="hp6-hero-content">
    {%- if section.settings.badge != blank -%}
      <div class="hp6-hero-badge">
        {{ section.settings.badge }}
      </div>
    {%- endif -%}

    {%- if section.settings.title != blank -%}
      <h1 class="hp6-hero-title">
        {{ section.settings.title }}
      </h1>
    {%- endif -%}

    {%- if section.settings.description != blank -%}
      <p class="hp6-hero-desc">{{ section.settings.description }}</p>
    {%- endif -%}

    <div class="hp6-hero-actions">
      {%- if section.settings.btn_1_text != blank -%}
        <a href="{{ section.settings.btn_1_link }}" class="hp6-btn-primary">{{ section.settings.btn_1_text }}</a>
      {%- endif -%}
      {%- if section.settings.btn_2_text != blank -%}
        <a href="{{ section.settings.btn_2_link }}" class="hp6-btn-secondary">{{ section.settings.btn_2_text }}</a>
      {%- endif -%}
    </div>
  </div>

</section>

{% schema %}
{
  "name": "HP6 Sports Hero",
  "tag": "section",
  "class": "section-hp6-hero",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge Text",
      "default": "NEW ARRIVALS"
    },
    {
      "type": "html",
      "id": "title",
      "label": "Headline (HTML allowed)",
      "default": "DOMINATE<br><span>THE GAME</span><br><strong>EVERYDAY</strong>",
      "info": "Use <span> for outlined text and <strong> for accent color."
    },
    {
      "type": "checkbox",
      "id": "accent_title",
      "label": "Enable Accent Color on Strong Tags",
      "default": true
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Engineered for maximum performance and ultimate durability. Push your limits with the new Pro Series."
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "video",
      "id": "bg_video",
      "label": "Background Video (Overrides Image)"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "btn_1_text",
      "label": "Primary Button Text",
      "default": "Shop Gear"
    },
    {
      "type": "url",
      "id": "btn_1_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "btn_2_text",
      "label": "Secondary Button Text",
      "default": "Explore Collection"
    },
    {
      "type": "url",
      "id": "btn_2_link",
      "label": "Secondary Button Link"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Overlay",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#ff4500"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0, "max": 200, "step": 10, "unit": "px",
      "label": "Padding Top (Desktop)", "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0, "max": 200, "step": 10, "unit": "px",
      "label": "Padding Bottom (Desktop)", "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0, "max": 150, "step": 10, "unit": "px",
      "label": "Padding Top (Mobile)", "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0, "max": 150, "step": 10, "unit": "px",
      "label": "Padding Bottom (Mobile)", "default": 0
    }
  ],
  "presets": [
    {
      "name": "HP6 Sports Hero",
      "category": "Hero"
    }
  ]
}
{% endschema %}
