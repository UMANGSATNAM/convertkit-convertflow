{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp50-offer-bg: #111111;
    
    background: var(--hp50-offer-bg);
    color: #FFFFFF;
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
    text-align: center;
    border-top: 1px solid rgba(226, 232, 240, 0.2);
    border-bottom: 1px solid rgba(226, 232, 240, 0.2);
  }

  .hp50-offer__box {
    max-width: {{ section.settings.container_width | default: 860 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp50-offer__pill {
    display: inline-block;
    padding: 6px 18px;
    background: #000000;
    border: 1px solid rgba(226, 232, 240, 0.3);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 2px;
    color: #E2E8F0;
    margin-bottom: 20px;
    text-transform: uppercase;
  }

  .hp50-offer__title {
    font-family: 'Italiana', serif;
    font-size: clamp(34px, 5vw, 50px);
    font-weight: 400;
    line-height: 1.1;
    margin: 0 0 16px;
    letter-spacing: 1px;
  }

  .hp50-offer__desc {
    font-size: 15px;
    line-height: 1.8;
    color: #94A3B8;
    margin: 0 auto 30px;
    max-width: 580px;
  }

  .hp50-offer__code-wrap {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background: #000000;
    border: 1px dashed rgba(226, 232, 240, 0.4);
    padding: 10px 24px;
    margin-bottom: 30px;
  }

  .hp50-offer__code {
    font-family: 'Syne', sans-serif;
    font-size: 16px;
    font-weight: 800;
    letter-spacing: 2px;
    color: #FFFFFF;
  }

  .hp50-offer__btn {
    display: inline-flex;
    padding: 16px 36px;
    background: #FFFFFF;
    color: #000000;
    font-family: 'Syne', sans-serif;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    text-decoration: none;
    border: 1px solid #FFFFFF;
    transition: all 0.25s ease;
  }

  .hp50-offer__btn:hover {
    background: transparent;
    color: #FFFFFF;
  }
{%- endstyle -%}

<div class="hp50-offer__box">
  <span class="hp50-offer__pill">{{ section.settings.badge | default: 'BACKSTAGE VIP PASS' }}</span>
  <h2 class="hp50-offer__title">{{ section.settings.heading | default: 'RECEIVE 20% PRIVILEGE ON YOUR INITIAL RUNWAY ACQUISITION' }}</h2>
  <p class="hp50-offer__desc">
    {{ section.settings.description | default: 'Experience the transformative contouring power of platinum peptides and obsidian minerals. Apply backstage code at checkout.' }}
  </p>

  <div class="hp50-offer__code-wrap">
    <span class="hp50-offer__code">CODE: {{ section.settings.promo_code | default: 'RUNWAY20' }}</span>
  </div>

  <div>
    <a href="{{ section.settings.btn_url | default: '/collections/all' }}" class="hp50-offer__btn">
      {{ section.settings.btn_text | default: 'Claim Editorial Code &rarr;' }}
    </a>
  </div>
</div>

{% schema %}
{
  "name": "HP50 - Runway Offer",
  "class": "section-hp50-offer",
  "settings": [
    { "type": "text", "id": "badge", "label": "Badge", "default": "BACKSTAGE VIP PASS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "RECEIVE 20% PRIVILEGE ON YOUR INITIAL RUNWAY ACQUISITION" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Experience the transformative contouring power of platinum peptides." },
    { "type": "text", "id": "promo_code", "label": "Promo Code", "default": "RUNWAY20" },
    { "type": "text", "id": "btn_text", "label": "Button Text", "default": "Claim Editorial Code →" },
    { "type": "url", "id": "btn_url", "label": "Button URL" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 5, "unit": "px", "label": "Padding Top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 5, "unit": "px", "label": "Padding Bottom", "default": 80 },
    { "type": "range", "id": "container_width", "min": 600, "max": 1200, "step": 20, "unit": "px", "label": "Container Width", "default": 860 }
  ],
  "presets": [
    { "name": "HP50 - Runway Offer" }
  ]
}
{% endschema %}
