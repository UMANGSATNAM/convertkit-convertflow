{%- style -%}
  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --font-heading: 'Lora', serif;
    --font-body: 'Outfit', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    position: relative;
    overflow: hidden;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }

  /* Organic grain texture overlay */
  {% if section.settings.show_grain %}
  #shopify-section-{{ section.id }}::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    opacity: 0.04;
    pointer-events: none;
    z-index: 1;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
  }
  {% endif %}

  .hp22-founder-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
    position: relative;
    z-index: 2;
  }

  @media screen and (max-width: 768px) {
    .hp22-founder-wrapper {
      padding: 0 20px;
    }
  }

  .hp22-founder__container {
    display: flex;
    align-items: center;
    gap: 80px;
    flex-direction: {% if section.settings.layout == 'image_right' %}row-reverse{% else %}row{% endif %};
  }

  @media screen and (max-width: 992px) {
    .hp22-founder__container {
      flex-direction: column;
      gap: 40px;
    }
  }

  /* Image Column */
  .hp22-founder__image-col {
    flex: 1;
    position: relative;
    width: 100%;
  }

  .hp22-founder__image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 4/5;
    background: #EAE3D9;
    overflow: hidden;
    {% if section.settings.image_shape == 'arch' %}
      border-radius: 400px 400px 20px 20px;
    {% elsif section.settings.image_shape == 'blob' %}
      border-radius: 40% 60% 70% 30% / 40% 50% 60% 50%;
    {% else %}
      border-radius: 200px;
    {% endif %}
    box-shadow: 0 30px 60px rgba(0,0,0,0.06);
  }

  .hp22-founder__image {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Decorative Badge */
  .hp22-founder__badge {
    position: absolute;
    bottom: 40px;
    {% if section.settings.layout == 'image_right' %}left: -30px;{% else %}right: -30px;{% endif %}
    width: 120px;
    height: 120px;
    animation: hp22-spin 20s linear infinite;
    z-index: 2;
  }

  @media screen and (max-width: 992px) {
    .hp22-founder__badge {
      {% if section.settings.layout == 'image_right' %}left: 10px;{% else %}right: 10px;{% endif %}
      bottom: 20px;
      width: 90px;
      height: 90px;
    }
  }

  @keyframes hp22-spin {
    100% { transform: rotate(360deg); }
  }

  .hp22-founder__badge svg {
    width: 100%;
    height: 100%;
    fill: var(--accent-color);
  }

  /* Text Column */
  .hp22-founder__text-col {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .hp22-founder__subtitle {
    font-family: var(--font-body);
    font-size: {{ section.settings.subtitle_size }}px;
    font-weight: 400;
    letter-spacing: 2px;
    color: var(--accent-color);
    text-transform: uppercase;
    margin: 0 0 16px;
  }

  .hp22-founder__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    font-weight: 400;
    color: var(--text-color);
    margin: 0 0 24px;
    line-height: 1.2;
  }
  
  .hp22-founder__title em {
    font-style: italic;
    color: var(--accent-color);
  }

  .hp22-founder__text {
    font-family: var(--font-body);
    font-size: {{ section.settings.text_size }}px;
    font-weight: 300;
    line-height: 1.7;
    color: var(--text-color);
    margin: 0 0 32px;
  }

  .hp22-founder__text p {
    margin: 0 0 16px;
  }

  .hp22-founder__signature {
    margin: 0 0 16px;
  }

  .hp22-founder__signature img {
    max-width: 150px;
    height: auto;
  }

  .hp22-founder__name {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 500;
    color: var(--text-color);
    margin: 0 0 4px;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .hp22-founder__role {
    font-family: var(--font-body);
    font-size: 13px;
    color: var(--accent-color);
    margin: 0;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp22-founder-wrapper" id="HP22Founder-{{ section.id }}">
  <div class="hp22-founder__container">
    
    <div class="hp22-founder__image-col">
      <div class="hp22-founder__image-wrapper">
        {%- if section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.title | escape }}" class="hp22-founder__image" loading="lazy">
        {%- else -%}
          <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:#8A9A86;">FOUNDER IMAGE</div>
        {%- endif -%}
      </div>
      
      {%- if section.settings.show_badge -%}
        <div class="hp22-founder__badge">
          <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
            <path id="circlePath" d="M 50, 50 m -37, 0 a 37,37 0 1,1 74,0 a 37,37 0 1,1 -74,0" fill="none"/>
            <text font-family="Outfit, sans-serif" font-size="12" font-weight="500" letter-spacing="3.5" fill="currentColor">
              <textPath href="#circlePath" startOffset="0%">
                {{ section.settings.badge_text | escape }} • {{ section.settings.badge_text | escape }} •
              </textPath>
            </text>
          </svg>
        </div>
      {%- endif -%}
    </div>

    <div class="hp22-founder__text-col">
      {%- if section.settings.subtitle != blank -%}
        <p class="hp22-founder__subtitle">{{ section.settings.subtitle | escape }}</p>
      {%- endif -%}
      
      {%- if section.settings.title != blank -%}
        <h2 class="hp22-founder__title">{{ section.settings.title }}</h2>
      {%- endif -%}
      
      {%- if section.settings.text != blank -%}
        <div class="hp22-founder__text">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if section.settings.signature_image != blank -%}
        <div class="hp22-founder__signature">
          <img src="{{ section.settings.signature_image | image_url: width: 300 }}" alt="{{ section.settings.name | escape }} Signature" loading="lazy">
        </div>
      {%- endif -%}

      {%- if section.settings.name != blank -%}
        <p class="hp22-founder__name">{{ section.settings.name | escape }}</p>
      {%- endif -%}
      
      {%- if section.settings.role != blank -%}
        <p class="hp22-founder__role">{{ section.settings.role | escape }}</p>
      {%- endif -%}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "HP22 - Organic Founder",
  "class": "section-hp22-founder-note",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Image Position (Desktop)",
      "options": [
        { "value": "image_left", "label": "Image Left" },
        { "value": "image_right", "label": "Image Right" }
      ],
      "default": "image_left"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 800,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1200
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Founder Image"
    },
    {
      "type": "select",
      "id": "image_shape",
      "label": "Image Shape",
      "options": [
        { "value": "arch", "label": "Arch" },
        { "value": "blob", "label": "Organic Blob" },
        { "value": "pill", "label": "Pill" }
      ],
      "default": "arch"
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show Rotating Text Badge",
      "default": true
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "CRUELTY FREE NATURALS"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "A NOTE FROM THE FOUNDER"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Heading",
      "default": "<p>Rooted in <em>Nature</em></p>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Letter Content",
      "default": "<p>I started this journey to find balance. Our formulations are crafted with the purest botanical extracts, designed to harmonize with your skin’s natural rhythm.</p>"
    },
    {
      "type": "image_picker",
      "id": "signature_image",
      "label": "Signature Image (Transparent PNG)"
    },
    {
      "type": "text",
      "id": "name",
      "label": "Name",
      "default": "Elena Woods"
    },
    {
      "type": "text",
      "id": "role",
      "label": "Role",
      "default": "Founder & Formulator"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 42
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Subtitle Size",
      "default": 14
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Text Size",
      "default": 17
    },
    {
      "type": "header",
      "content": "Organic Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#F9F6F0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#3A3A3A"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#8A9A86"
    },
    {
      "type": "checkbox",
      "id": "show_grain",
      "label": "Show subtle paper grain texture",
      "default": true
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP22 - Organic Founder"
    }
  ]
}
{% endschema %}
