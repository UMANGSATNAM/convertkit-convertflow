<style>
@media screen and (max-width: 768px) {
  .hp15-custom-html {
    padding-left: 16px !important;
    padding-right: 16px !important;
    box-sizing: border-box !important;
  }
  img {
    max-width: 100% !important;
    height: auto !important;
  }
}
</style>
{%- liquid
  assign section_id = section.id
-%}

<div id="shopify-section-{{ section_id }}" class="hp15-custom-html-wrapper" style="padding: {{ section.settings.padding_top }}px {{ section.settings.padding_side }}px {{ section.settings.padding_bottom }}px;">
  {{ section.settings.custom_html }}
</div>

{% schema %}
{
  "name": "HP15 Custom HTML",
  "settings": [
    {
      "type": "html",
      "id": "custom_html",
      "label": "Custom HTML",
      "default": "<div style='text-align: center; font-family: Didot, serif; font-size: 2rem; color: #000; letter-spacing: 5px; text-transform: uppercase;'>MAISON</div>"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_side",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Side",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "HP15 Custom HTML"
    }
  ]
}
{% endschema %}
