{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: "#080B10" }};
    padding: {{ section.settings.padding_top | default: 90 }}px 20px {{ section.settings.padding_bottom | default: 90 }}px;
  }

  .hp43-bs__title {
    font-family: 'Orbitron', sans-serif;
    font-size: 32px;
    font-weight: 800;
    color: {{ section.settings.title_color | default: "#F1F5F9" }};
    text-align: center;
    margin: 0 0 50px;
    text-transform: uppercase;
  }

  .hp43-bs__grid {
    max-width: 1320px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns | default: 3 }}, 1fr);
    gap: 30px;
  }

  .hp43-bs__card {
    background: {{ section.settings.card_bg | default: "#101622" }};
    border: 1px solid {{ section.settings.border_color | default: "#1E293B" }};
    border-radius: 6px;
    padding: 24px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    text-align: center;
    transition: all 0.3s ease;
  }

  .hp43-bs__card:hover {
    border-color: {{ section.settings.accent_color | default: "#FF0055" }};
    transform: translateY(-5px);
    box-shadow: 0 15px 40px {{ section.settings.accent_color | default: "#FF0055" }}33;
  }

  .hp43-bs__img,
  .hp43-bs__card svg {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 4px;
    margin-bottom: 20px;
    background: {{ section.settings.bg_color | default: "#080B10" }};
    display: block;
  }

  .hp43-bs__name {
    font-family: 'Orbitron', sans-serif;
    font-size: 18px;
    font-weight: 700;
    color: {{ section.settings.title_color | default: "#F1F5F9" }};
    margin: 0 0 10px;
    text-transform: uppercase;
    text-decoration: none;
    display: block;
  }

  .hp43-bs__price {
    font-family: 'Inter', sans-serif;
    font-size: 20px;
    font-weight: 700;
    color: {{ section.settings.accent_color | default: "#FF0055" }};
    margin-bottom: 18px;
  }
  .hp43-bs__price s { opacity: 0.55; font-size: 15px; margin-left: 6px; }

  .hp43-bs__btn {
    width: 100%;
    padding: 14px;
    background: {{ section.settings.accent_color | default: "#FF0055" }};
    color: #FFFFFF;
    border: none;
    font-family: 'Rajdhani', sans-serif;
    font-size: 16px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    border-radius: 4px;
    cursor: pointer;
    box-shadow: 0 0 15px {{ section.settings.accent_color | default: "#FF0055" }}66;
    transition: background 0.2s;
    min-height: 46px;
  }

  .hp43-bs__btn:hover { filter: brightness(0.9); }
  .hp43-bs__btn[disabled] { opacity: 0.5; cursor: not-allowed; }

  .hp43-bs__empty {
    grid-column: 1 / -1;
    text-align: center;
    color: {{ section.settings.title_color | default: "#F1F5F9" }};
    opacity: 0.7;
  }

  @media screen and (max-width: 900px) {
    .hp43-bs__grid { grid-template-columns: repeat({{ section.settings.columns_mobile | default: 1 }}, 1fr); }
    .hp43-bs__title { font-size: 24px; margin-bottom: 30px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hp43-bs__card { transition: none; }
    .hp43-bs__card:hover { transform: none; }
  }
{%- endstyle -%}

{%- if section.settings.title != blank -%}
  <div class="hp43-bs__title">{{ section.settings.title }}</div>
{%- endif -%}

{%- liquid
  assign bs_products = collections[section.settings.collection].products
  assign bs_limit = section.settings.products_count | default: 3
-%}

<div class="hp43-bs__grid">
  {%- if bs_products.size > 0 -%}
    {%- for product in bs_products limit: bs_limit -%}
      {%- assign bs_variant = product.selected_or_first_available_variant -%}
      <div class="hp43-bs__card">
        <a href="{{ product.url }}" aria-label="{{ product.title | escape }}">
          {%- if product.featured_image -%}
            <img
              src="{{ product.featured_image | image_url: width: 600 }}"
              class="hp43-bs__img"
              alt="{{ product.featured_image.alt | default: product.title | escape }}"
              width="600" height="600" loading="lazy">
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'hp43-bs__img' }}
          {%- endif -%}
        </a>

        <a class="hp43-bs__name" href="{{ product.url }}">{{ product.title }}</a>

        <div class="hp43-bs__price">
          {{ bs_variant.price | money }}
          {%- if bs_variant.compare_at_price > bs_variant.price -%}
            <s>{{ bs_variant.compare_at_price | money }}</s>
          {%- endif -%}
        </div>

        {%- if product.available -%}
          <form method="post" action="{{ routes.cart_add_url }}">
            <input type="hidden" name="id" value="{{ bs_variant.id }}">
            <input type="hidden" name="quantity" value="1">
            <button type="submit" class="hp43-bs__btn">{{ section.settings.button_label | default: 'Add to cart' }}</button>
          </form>
        {%- else -%}
          <button type="button" class="hp43-bs__btn" disabled>{{ section.settings.sold_out_label | default: 'Sold out' }}</button>
        {%- endif -%}
      </div>
    {%- endfor -%}
  {%- else -%}
    <p class="hp43-bs__empty">{{ section.settings.empty_text | default: 'Choose a collection in the section settings to show products here.' }}</p>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "HP43 - Cyber Bestsellers",
  "class": "section-hp43-bestsellers",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Top-tier bestsellers"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Sort the collection by Best selling in the Shopify admin to keep this list accurate."
    },
    {
      "type": "range",
      "id": "products_count",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 3
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Add to cart"
    },
    {
      "type": "text",
      "id": "sold_out_label",
      "label": "Sold out label",
      "default": "Sold out"
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Empty state text",
      "default": "Choose a collection in the section settings to show products here."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns (mobile)",
      "default": "1",
      "options": [
        {
          "value": "1",
          "label": "1 Column"
        },
        {
          "value": "2",
          "label": "2 Columns"
        }
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 88
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 88
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#080B10"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "default": "#101622"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Text",
      "default": "#F1F5F9"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#FF0055"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Card border",
      "default": "#1E293B"
    }
  ],
  "presets": [
    {
      "name": "HP43 - Cyber Bestsellers"
    }
  ]
}
{% endschema %}
