{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp45-comp-bg: {{ section.settings.bg_color | default: '#F5F5F0' }};
    --hp45-border: {{ section.settings.border_color | default: '#0A0A0A' }};
    
    background-color: var(--hp45-comp-bg);
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
  }

  .hp45-comp__wrap {
    max-width: {{ section.settings.container_width | default: 1000 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp45-comp__header {
    text-align: center;
    margin-bottom: 45px;
  }

  .hp45-comp__heading {
    font-size: clamp(28px, 4vw, 40px);
    font-weight: 700;
    text-transform: uppercase;
    color: #0A0A0A;
    margin: 0 0 8px;
  }

  .hp45-comp__table-box {
    background: #FFFFFF;
    border: 2px solid var(--hp45-border);
    box-shadow: 6px 6px 0 var(--hp45-border);
    overflow-x: auto;
  }

  .hp45-comp__table {
    width: 100%;
    border-collapse: collapse;
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
  }

  .hp45-comp__table th, .hp45-comp__table td {
    padding: 18px 20px;
    text-align: center;
    border: 1px solid var(--hp45-border);
    color: #0A0A0A;
  }

  .hp45-comp__table th {
    background: #0A0A0A;
    color: #FFFFFF;
    font-weight: 700;
    text-transform: uppercase;
  }

  .hp45-comp__highlight-col {
    background: #F0F0EA;
    font-weight: 700;
  }
{%- endstyle -%}

<div class="hp45-comp__wrap">
  <div class="hp45-comp__header">
    <h2 class="hp45-comp__heading">{{ section.settings.heading | default: 'STOICHIOMETRIC BENCHMARK MATRIX' }}</h2>
    <p style="font-family:'JetBrains Mono', monospace; font-size:13px; color:#555;">{{ section.settings.subheading | default: 'System v45 technical performance vs standard retail cosmetics.' }}</p>
  </div>

  <div class="hp45-comp__table-box">
    <table class="hp45-comp__table">
      <thead>
        <tr>
          <th style="text-align:left;">EVALUATION CRITERIA</th>
          <th style="background:#222222;">SYSTEM V45 PROTOCOL</th>
          <th>STANDARD MASS COSMETIC</th>
        </tr>
      </thead>
      <tbody>
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <td style="text-align:left; font-weight:700;">{{ block.settings.feature }}</td>
              <td class="hp45-comp__highlight-col">{{ block.settings.brand_val }}</td>
              <td>{{ block.settings.other_val }}</td>
            </tr>
          {%- endfor -%}
        {%- else -%}
          <tr>
            <td style="text-align:left; font-weight:700;">MOLECULAR PURITY</td>
            <td class="hp45-comp__highlight-col">99.8% BIO-ACTIVE GRADE</td>
            <td>&lt; 5% DILUTED FRACTION</td>
          </tr>
          <tr>
            <td style="text-align:left; font-weight:700;">SOLVENT BASE</td>
            <td class="hp45-comp__highlight-col">ECTOIN &amp; COPPER PEPTIDE</td>
            <td>WATER &amp; ETHOXYDIGLYCOL</td>
          </tr>
          <tr>
            <td style="text-align:left; font-weight:700;">VESSEL INTEGRITY</td>
            <td class="hp45-comp__highlight-col">HEAVY BOROSILICATE UV GLASS</td>
            <td>CHEAP PET PLASTIC CONTAINER</td>
          </tr>
          <tr>
            <td style="text-align:left; font-weight:700;">GLOBAL CUSTOMS DDP</td>
            <td class="hp45-comp__highlight-col">100% PRE-CLEARED AT CHECKOUT</td>
            <td>UNPAID POSTAL TARIFF HOLDS</td>
          </tr>
        {%- endif -%}
      </tbody>
    </table>
  </div>
</div>

{% schema %}
{
  "name": "HP45 - Brutal Matrix",
  "class": "section-hp45-matrix",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#F5F5F0" },
    { "type": "color", "id": "border_color", "label": "Border Color", "default": "#0A0A0A" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "STOICHIOMETRIC BENCHMARK MATRIX" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "System v45 technical performance vs standard retail cosmetics." },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 80 },
    { "type": "range", "id": "container_width", "min": 700, "max": 1200, "step": 20, "unit": "px", "label": "Container Width", "default": 1000 }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Matrix Row",
      "settings": [
        { "type": "text", "id": "feature", "label": "Feature", "default": "MOLECULAR PURITY" },
        { "type": "text", "id": "brand_val", "label": "System V45 Value", "default": "99.8% BIO-ACTIVE GRADE" },
        { "type": "text", "id": "other_val", "label": "Standard Value", "default": "< 5% DILUTED FRACTION" }
      ]
    }
  ],
  "presets": [
    { "name": "HP45 - Brutal Matrix" }
  ]
}
{% endschema %}
