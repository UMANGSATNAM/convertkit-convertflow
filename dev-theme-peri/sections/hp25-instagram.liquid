{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,100..900;1,9..144,100..900&family=Outfit:wght@300;400;600;800&family=Caveat:wght@700&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-orange: {{ section.settings.accent_orange }};
    --accent-yellow: {{ section.settings.accent_yellow }};
    --font-heading: 'Fraunces', serif;
    --font-body: 'Outfit', sans-serif;
    --font-hand: 'Caveat', cursive;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    position: relative;
    /* Subtle grainy texture */
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.03'/%3E%3C/svg%3E");
    overflow: hidden;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }

  .hp25-insta-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
    position: relative;
    z-index: 1;
  }

  @media screen and (max-width: 768px) {
    .hp25-insta-wrapper {
      padding: 0 20px;
    }
  }

  .hp25-insta__header {
    text-align: center;
    margin-bottom: {{ section.settings.header_margin }}px;
  }

  .hp25-insta__title {
    font-family: var(--font-heading);
    font-size: clamp(36px, 6vw, {{ section.settings.title_size }}px);
    font-weight: 900;
    font-style: italic;
    color: var(--text-color);
    margin: 0;
    line-height: 1.1;
    text-shadow: 3px 3px 0 var(--accent-yellow);
    position: relative;
    display: inline-block;
  }

  /* Funky starburst behind title */
  .hp25-insta__title::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 120%;
    height: 150%;
    background: var(--accent-orange);
    z-index: -1;
    clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
    opacity: 0.15;
  }

  .hp25-insta__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: 20px;
    margin-bottom: 40px;
  }

  @media screen and (max-width: 992px) {
    .hp25-insta__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media screen and (max-width: 600px) {
    .hp25-insta__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 15px;
    }
  }

  /* Different shapes for images to make it groovy */
  .hp25-insta__item {
    position: relative;
    width: 100%;
    aspect-ratio: 1/1;
    overflow: hidden;
    border: 3px solid var(--text-color);
    background: var(--accent-yellow);
    transition: transform 0.3s ease;
  }

  .hp25-insta__item:hover {
    transform: scale(1.05) rotate(2deg);
    z-index: 2;
    box-shadow: 8px 8px 0 var(--accent-orange);
  }

  .hp25-insta__item:nth-child(4n+1) {
    border-radius: 50% 50% 0 0; /* Arch */
  }
  .hp25-insta__item:nth-child(4n+2) {
    border-radius: 50%; /* Circle */
  }
  .hp25-insta__item:nth-child(4n+3) {
    border-radius: 20px; /* Rounded Square */
  }
  .hp25-insta__item:nth-child(4n+4) {
    border-radius: 0 50% 50% 50%; /* Leaf shape */
  }

  .hp25-insta__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: sepia(0.2) contrast(1.1);
    transition: filter 0.3s ease;
  }

  .hp25-insta__item:hover img {
    filter: sepia(0) contrast(1);
  }

  .hp25-insta__icon {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 40px;
    height: 40px;
    background: var(--text-color);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .hp25-insta__item:hover .hp25-insta__icon {
    opacity: 1;
  }

  .hp25-insta__icon svg {
    width: 20px;
    height: 20px;
    fill: var(--bg-color);
  }

  .hp25-insta__footer {
    text-align: center;
  }

  .hp25-insta__btn {
    display: inline-block;
    padding: 18px 45px;
    background-color: var(--accent-orange);
    color: var(--bg-color);
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 800;
    text-transform: uppercase;
    text-decoration: none;
    border: 3px solid var(--text-color);
    border-radius: 50px;
    box-shadow: 6px 6px 0 var(--text-color);
    transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
  }

  .hp25-insta__btn:hover {
    transform: translate(2px, 2px);
    box-shadow: 4px 4px 0 var(--text-color);
    background-color: var(--text-color);
    color: var(--accent-yellow);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp25-insta-wrapper" id="HP25Insta-{{ section.id }}">
  <div class="hp25-insta__header">
    {%- if section.settings.title != blank -%}
      <h2 class="hp25-insta__title">{{ section.settings.title }}</h2>
    {%- endif -%}
  </div>

  <div class="hp25-insta__grid">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.link | default: '#' }}" class="hp25-insta__item" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          <img height="{{ block.settings.image.height }}" width="{{ block.settings.image.width }}" src="{{ block.settings.image | image_url: width: 600 }}" alt="Instagram image" loading="lazy">
        {%- else -%}
          <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:var(--text-color);font-family:var(--font-heading);font-style:italic;">IMAGE</div>
        {%- endif -%}
        
        <div class="hp25-insta__icon">
          <svg viewBox="0 0 24 24"><path d="M7.8,2H16.2C19.4,2 22,4.6 22,7.8V16.2A5.8,5.8 0 0,1 16.2,22H7.8C4.6,22 2,19.4 2,16.2V7.8A5.8,5.8 0 0,1 7.8,2M7.6,4A3.6,3.6 0 0,0 4,7.6V16.4C4,18.39 5.61,20 7.6,20H16.4A3.6,3.6 0 0,0 20,16.4V7.6C20,5.61 18.39,4 16.4,4H7.6M17.25,5.5A1.25,1.25 0 0,1 18.5,6.75A1.25,1.25 0 0,1 17.25,8A1.25,1.25 0 0,1 16,6.75A1.25,1.25 0 0,1 17.25,5.5M12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9Z"/></svg>
        </div>
      </a>
    {%- endfor -%}
  </div>

  {%- if section.settings.btn_text != blank -%}
    <div class="hp25-insta__footer">
      <a href="{{ section.settings.btn_link | default: '#' }}" class="hp25-insta__btn">
        {{ section.settings.btn_text }}
      </a>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "HP25 - Retro Instagram",
  "class": "section-hp25-instagram",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "@GroovyVibes"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "FOLLOW US"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "range",
      "id": "header_margin",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Margin Below Header",
      "default": 50
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 800,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1200
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 3,
      "max": 6,
      "step": 1,
      "label": "Columns (Desktop)",
      "default": 4
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 56
    },
    {
      "type": "header",
      "content": "Retro 70s Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#E2B144"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text / Border (Dark Brown)",
      "default": "#3E2723"
    },
    {
      "type": "color",
      "id": "accent_orange",
      "label": "Accent (Burnt Orange)",
      "default": "#D15F3C"
    },
    {
      "type": "color",
      "id": "accent_yellow",
      "label": "Accent (Cream)",
      "default": "#F5E6D3"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP25 - Retro Instagram",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
