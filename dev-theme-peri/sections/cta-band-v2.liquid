{%- style -%}
  .cta-band-v2 {
    background-color: var(--primary);
    color: #ffffff;
    padding: var(--space-64) 0;
    position: relative;
    overflow: hidden;
  }
  @media (min-width: 768px) {
    .cta-band-v2 {
      padding: var(--space-80) 0;
    }
  }

  .cta-band-v2__inner {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-20);
  }

  .cta-band-v2__pill {
    background-color: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(8px);
    color: #ffffff;
    font-size: var(--text-12);
    font-weight: 600;
    padding: 6px 16px;
    border-radius: var(--radius-pill);
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }

  .cta-band-v2__title {
    font-size: var(--text-32);
    font-weight: 400;
    color: #ffffff;
    margin: 0;
    line-height: 1.25;
  }
  @media (min-width: 768px) {
    .cta-band-v2__title {
      font-size: var(--text-48);
    }
  }

  .cta-band-v2__subtext {
    font-size: var(--text-16);
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.6;
    max-width: 580px;
    margin: 0;
  }

  .cta-band-v2__form-wrapper {
    width: 100%;
    max-width: 500px;
    margin-top: var(--space-8);
  }

  .cta-band-v2__form {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    width: 100%;
  }
  @media (min-width: 640px) {
    .cta-band-v2__form {
      flex-direction: row;
    }
  }

  .cta-band-v2__input {
    flex: 1;
    height: 52px;
    padding: 0 var(--space-20);
    border-radius: var(--radius-pill);
    border: 1px solid rgba(255, 255, 255, 0.3);
    background-color: rgba(255, 255, 255, 0.08);
    color: #ffffff;
    font-size: var(--text-14);
    outline: none;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }
  .cta-band-v2__input::placeholder {
    color: rgba(255, 255, 255, 0.55);
  }
  .cta-band-v2__input:focus {
    border-color: #ffffff;
    background-color: rgba(255, 255, 255, 0.15);
  }

  .cta-band-v2__button {
    height: 52px;
    padding: 0 var(--space-32);
    border-radius: var(--radius-pill);
    background-color: #ffffff;
    color: var(--primary);
    font-size: var(--text-14);
    font-weight: 600;
    border: none;
    cursor: pointer;
    white-space: nowrap;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .cta-band-v2__button:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
  }

  .cta-band-v2__privacy {
    font-size: var(--text-12);
    color: rgba(255, 255, 255, 0.6);
    margin-top: var(--space-8);
  }
{%- endstyle -%}

<div class="cta-band-v2">
  <div class="fresh-container">
    <div class="cta-band-v2__inner">
      {%- if section.settings.pill_text != blank -%}
        <span class="cta-band-v2__pill">{{ section.settings.pill_text }}</span>
      {%- endif -%}

      <h2 class="cta-band-v2__title">{{ section.settings.title | default: "Join the Botanical Ritual" }}</h2>
      <p class="cta-band-v2__subtext">{{ section.settings.subtext | default: "Subscribe to receive early notifications of private seasonal drops, ingredient guides, and 10% off your first ritual." }}</p>

      <div class="cta-band-v2__form-wrapper">
        <form action="/contact#contact_form" method="post" class="cta-band-v2__form">
          <input type="hidden" name="form_type" value="customer">
          <input type="hidden" name="utf8" value="✓">
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input type="email" name="contact[email]" class="cta-band-v2__input" placeholder="{{ section.settings.placeholder | default: 'Enter your email address' }}" required>
          <button type="submit" class="cta-band-v2__button">{{ section.settings.button_text | default: 'Subscribe' }}</button>
        </form>
        <p class="cta-band-v2__privacy">{{ section.settings.privacy_note | default: 'We respect your inbox. Unsubscribe with one click at any time.' }}</p>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "CTA Band V2",
  "settings": [
    {
      "type": "text",
      "id": "pill_text",
      "label": "Badge Pill Text",
      "default": "Private Circle"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Join the Botanical Ritual"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Subscribe to receive early notifications of private seasonal drops, ingredient guides, and 10% off your first ritual."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input Placeholder",
      "default": "Enter your email address"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "privacy_note",
      "label": "Privacy Note",
      "default": "We respect your inbox. Unsubscribe with one click at any time."
    }
  ],
  "presets": [
    {
      "name": "CTA Band V2"
    }
  ]
}
{% endschema %}
