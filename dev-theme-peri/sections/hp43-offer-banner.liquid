{%- style -%}
  #shopify-section-{{ section.id }} {
    background: linear-gradient(135deg, #00F0FF, #FF0055);
    color: #080B10;
    padding: 70px 20px;
    text-align: center;
  }

  .hp43-offer__box {
    max-width: 840px;
    margin: 0 auto;
  }

  .hp43-offer__badge {
    display: inline-block;
    padding: 6px 16px;
    background: #080B10;
    color: #00F0FF;
    font-family: 'Rajdhani', sans-serif;
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    border-radius: 4px;
    margin-bottom: 20px;
  }

  .hp43-offer__title {
    font-family: 'Orbitron', sans-serif;
    font-size: 40px;
    font-weight: 900;
    color: #FFFFFF;
    margin: 0 0 16px;
    text-transform: uppercase;
    text-shadow: 0 4px 15px rgba(0,0,0,0.4);
  }

  .hp43-offer__code-box {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    padding: 12px 28px;
    background: rgba(8, 11, 16, 0.85);
    border: 2px dashed #00F0FF;
    border-radius: 6px;
    color: #FFFFFF;
    font-family: monospace;
    font-size: 22px;
    font-weight: 700;
    margin-bottom: 30px;
  }

  .hp43-offer__btn {
    display: inline-block;
    padding: 18px 40px;
    background: #080B10;
    color: #FFFFFF;
    font-family: 'Orbitron', sans-serif;
    font-size: 15px;
    font-weight: 800;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 1px;
    border-radius: 4px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    transition: transform 0.2s;
  }

  .hp43-offer__btn:hover {
    transform: scale(1.04);
  }
{%- endstyle -%}

<div class="hp43-offer__box">
  <div class="hp43-offer__badge">LIMITED PROTOCOL DISPATCH</div>
  <h2 class="hp43-offer__title">CLAIM 25% OFF YOUR FIRST SYSTEM</h2>
  <div class="hp43-offer__code-box">
    <span>PROMO: NEON25</span>
  </div>
  <div>
    <a href="/collections/all" class="hp43-offer__btn">ACTIVATE DISCOUNT &rarr;</a>
  </div>
</div>

{% schema %}
{
  "name": "HP43 - Cyber Offer",
  "class": "section-hp43-offer",
  "settings": [],
  "presets": [
    {
      "name": "HP43 - Cyber Offer"
    }
  ]
}
{% endschema %}
