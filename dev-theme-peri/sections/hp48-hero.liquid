{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700;800&family=Montserrat:wght@300;400;500;600;700&display=swap');

  #shopify-section-{{ section.id }} {
    --hp48-bg: {{ section.settings.bg_color | default: '#FAF8F5' }};
    --hp48-text: {{ section.settings.text_color | default: '#1A1715' }};
    --hp48-gold: {{ section.settings.accent_gold | default: '#C59B27' }};
    --hp48-card-bg: {{ section.settings.card_bg | default: '#FFFFFF' }};
    --hp48-btn-bg: {{ section.settings.btn_bg | default: '#1A1715' }};
    --hp48-btn-text-color: {{ section.settings.btn_text_color | default: '#FFFFFF' }};
    
    background-color: var(--hp48-bg);
    color: var(--hp48-text);
    font-family: 'Montserrat', sans-serif;
    padding-top: {{ section.settings.padding_top | default: 100 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 100 }}px;
    position: relative;
  }

  .hp48-hero__container {
    max-width: {{ section.settings.container_width | default: 1280 }}px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  .hp48-hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 20px;
    background: rgba(197, 155, 39, 0.1);
    border: 1px solid var(--hp48-gold);
    border-radius: 50px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--hp48-gold);
    margin-bottom: 24px;
  }

  .hp48-hero__title {
    font-family: 'Cinzel', serif;
    font-size: clamp(38px, 5.5vw, 64px);
    font-weight: 700;
    line-height: 1.1;
    color: var(--hp48-text);
    margin: 0 0 20px;
    letter-spacing: 1px;
  }

  .hp48-hero__title span {
    color: var(--hp48-gold);
    background: linear-gradient(135deg, #C59B27, #E5C365, #99771F);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hp48-hero__desc {
    font-size: 15px;
    line-height: 1.8;
    color: #5C554E;
    margin: 0 0 36px;
    max-width: 520px;
  }

  .hp48-hero__actions {
    display: flex;
    gap: 16px;
    align-items: center;
    flex-wrap: wrap;
  }

  .hp48-hero__btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 36px;
    background: var(--hp48-btn-bg);
    color: var(--hp48-btn-text-color);
    font-family: 'Montserrat', sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 4px;
    border: 1px solid var(--hp48-gold);
    box-shadow: 0 10px 30px rgba(197, 155, 39, 0.2);
    transition: all 0.3s ease;
  }

  .hp48-hero__btn-primary:hover {
    background: var(--hp48-gold);
    color: #1A1715;
    transform: translateY(-2px);
  }

  .hp48-hero__media-frame {
    position: relative;
    border-radius: 8px;
    overflow: hidden;
    background: #EAE6DF;
    border: 1px solid rgba(197, 155, 39, 0.4);
    box-shadow: 0 25px 60px rgba(26, 23, 21, 0.12);
    height: 520px;
  }

  .hp48-hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hp48-hero__floating-seal {
    position: absolute;
    bottom: 24px;
    right: 24px;
    background: rgba(26, 23, 21, 0.9);
    border: 1px solid var(--hp48-gold);
    border-radius: 8px;
    padding: 14px 20px;
    color: #FAF8F5;
    backdrop-filter: blur(10px);
  }

  .hp48-hero__seal-title {
    font-family: 'Cinzel', serif;
    font-size: 14px;
    font-weight: 700;
    color: var(--hp48-gold);
    margin: 0;
  }

  .hp48-hero__seal-sub {
    font-size: 11px;
    color: #FAF8F5;
    margin: 0;
  }

  @media screen and (max-width: 992px) {
    .hp48-hero__container { grid-template-columns: 1fr; text-align: center; }
    .hp48-hero__desc { margin-left: auto; margin-right: auto; }
    .hp48-hero__actions { justify-content: center; }
    .hp48-hero__media-frame { height: 380px; }
  }
{%- endstyle -%}

<div class="hp48-hero__container">
  <div>
    <div class="hp48-hero__badge">
      <span>👑</span>
      <span>{{ section.settings.badge | default: 'ROYAL CHAMPAGNE GOLD v48' }}</span>
    </div>

    <h1 class="hp48-hero__title">
      {{ section.settings.heading | default: 'The Royal Sovereign of <span>Champagne Gold</span> Luxury' }}
    </h1>

    <p class="hp48-hero__desc">
      {{ section.settings.description | default: 'Enriched with micronized 24K colloidal gold, white truffle extract, and imperial pearl nectar for sovereign barrier radiance.' }}
    </p>

    <div class="hp48-hero__actions">
      <a href="{{ section.settings.btn_url | default: '/collections/all' }}" class="hp48-hero__btn-primary">
        <span>{{ section.settings.btn_text | default: 'Explore Royal Suite' }}</span>
        <span>&rarr;</span>
      </a>
    </div>
  </div>

  <div class="hp48-hero__media-frame">
    {%- if section.settings.image != blank -%}
      <img src="{{ section.settings.image | image_url: width: 1000 }}" class="hp48-hero__img" alt="{{ section.settings.heading }}" loading="eager">
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'hp48-hero__img' }}
    {%- endif -%}

    <div class="hp48-hero__floating-seal">
      <p class="hp48-hero__seal-title">24K Colloidal Gold Nectar</p>
      <p class="hp48-hero__seal-sub">Royal Sovereign Formulation</p>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "HP48 - Royal Hero",
  "class": "section-hp48-hero",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#FAF8F5" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#1A1715" },
    { "type": "color", "id": "accent_gold", "label": "Gold Accent", "default": "#C59B27" },
    { "type": "color", "id": "btn_bg", "label": "Button Background", "default": "#1A1715" },
    { "type": "color", "id": "btn_text_color", "label": "Button Text Color", "default": "#FFFFFF" },
    { "type": "text", "id": "badge", "label": "Badge", "default": "ROYAL CHAMPAGNE GOLD v48" },
    { "type": "textarea", "id": "heading", "label": "Heading (HTML allowed)", "default": "The Royal Sovereign of <span>Champagne Gold</span> Luxury" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Enriched with micronized 24K colloidal gold, white truffle extract, and imperial pearl nectar." },
    { "type": "text", "id": "btn_text", "label": "Button Text", "default": "Explore Royal Suite" },
    { "type": "url", "id": "btn_url", "label": "Button URL" },
    { "type": "image_picker", "id": "image", "label": "Hero Image" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 100 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 100 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "presets": [
    { "name": "HP48 - Royal Hero" }
  ]
}
{% endschema %}
