{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#000000'
  assign text_color = section.settings.text_color | default: '#00ff88'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 60px 20px;
    border-top: 1px dashed rgba(0, 255, 136, 0.3);
    border-bottom: 1px dashed rgba(0, 255, 136, 0.3);
    position: relative;
    overflow: hidden;
  }
  
  .hp9-press-container-{{ section_id }} {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    z-index: 2;
  }
  
  .hp9-press-heading-{{ section_id }} {
    font-family: 'Space Mono', monospace;
    font-size: 0.8rem;
    font-weight: 700;
    color: {{ text_color }};
    margin: 0 0 40px 0;
    letter-spacing: 4px;
    text-transform: uppercase;
    text-align: center;
  }
  
  .hp9-press-logos-{{ section_id }} {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 60px;
    width: 100%;
  }
  
  .hp9-press-logo-item-{{ section_id }} {
    flex: 0 0 auto;
    transition: all 0.3s ease;
    filter: brightness(0) invert(1) opacity(0.5); /* Make logos white and semi-transparent by default */
  }
  
  /* If text color is neon green, we want hover to be that color, but standard logos are hard to tint exactly. 
     We'll just make them fully opaque and add a drop shadow */
  .hp9-press-logo-item-{{ section_id }}:hover {
    filter: brightness(0) invert(1) opacity(1) drop-shadow(0 0 8px {{ text_color }});
    transform: scale(1.1);
  }
  
  .hp9-press-logo-img-{{ section_id }} {
    max-width: 150px;
    max-height: 40px;
    width: auto;
    height: auto;
    display: block;
  }
  
  /* Glitch effect on background */
  #shopify-section-{{ section_id }}::before {
    content: '';
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 2px,
      rgba(0,255,136,0.03) 2px,
      rgba(0,255,136,0.03) 4px
    );
    pointer-events: none;
    z-index: 1;
  }

  @media (max-width: 768px) {
    .hp9-press-logos-{{ section_id }} {
      gap: 30px;
    }
    .hp9-press-logo-img-{{ section_id }} {
      max-width: 100px;
      max-height: 30px;
    }
  }
  
  @media (max-width: 480px) {
    .hp9-press-logos-{{ section_id }} {
      gap: 20px;
    }
    .hp9-press-logo-item-{{ section_id }} {
      width: 40%;
      display: flex;
      justify-content: center;
    }
  }
</style>

<div class="hp9-press-container-{{ section_id }}">
  <h3 class="hp9-press-heading-{{ section_id }}">{{ section.settings.heading | default: 'SYSTEM_VERIFIED_BY' }}</h3>
  
  <div class="hp9-press-logos-{{ section_id }}">
    {% for block in section.blocks %}
      <div class="hp9-press-logo-item-{{ section_id }}" {{ block.shopify_attributes }}>
        {% if block.settings.link != blank %}
          <a href="{{ block.settings.link }}" target="_blank" rel="noopener noreferrer">
        {% endif %}
        
        {% if block.settings.image != blank %}
          <img src="{{ block.settings.image | image_url: width: 300 }}" alt="{{ block.settings.image.alt | escape | default: 'Press Logo' }}" class="hp9-press-logo-img-{{ section_id }}" loading="lazy">
        {% else %}
          <div class="hp9-press-logo-img-{{ section_id }}" style="background: rgba(255,255,255,0.1); width: 120px; height: 30px; display:flex; align-items:center; justify-content:center; font-family:monospace; font-size:10px; color:#fff;">LOGO_DATA</div>
        {% endif %}
        
        {% if block.settings.link != blank %}
          </a>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "HP9 Press Logos",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Accent Color",
      "default": "#00ff88"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "SYSTEM_VERIFIED_BY"
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Press Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (Optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP9 Press Logos",
      "blocks": [
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" }
      ]
    }
  ]
}
{% endschema %}
