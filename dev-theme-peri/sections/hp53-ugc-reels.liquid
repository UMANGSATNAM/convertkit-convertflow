{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#FAF5EF' }};
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
  }

  .hp53-ugc__container {
    max-width: {{ section.settings.container_width | default: 1280 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp53-ugc__header {
    text-align: center;
    margin-bottom: 40px;
  }

  .hp53-ugc__eyebrow {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: {{ section.settings.accent_color | default: '#C2703E' }};
    margin: 0 0 12px;
  }

  .hp53-ugc__heading {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(28px, 3.5vw, 42px);
    font-weight: 700;
    color: {{ section.settings.title_color | default: '#5C3D2E' }};
    margin: 0;
  }

  .hp53-ugc__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns | default: 4 }}, 1fr);
    gap: 16px;
  }

  .hp53-ugc__item {
    aspect-ratio: 9/16;
    border-radius: 10px;
    overflow: hidden;
    position: relative;
    background: #E8D5C0;
    border: 1px solid {{ section.settings.border_color | default: '#E8D5C0' }};
  }

  .hp53-ugc__item img,
  .hp53-ugc__item video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hp53-ugc__overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 16px;
    background: linear-gradient(transparent, rgba(92, 61, 46, 0.85));
  }

  .hp53-ugc__handle {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 12px;
    font-weight: 600;
    color: #FAF5EF;
    margin: 0;
  }

  @media screen and (max-width: 992px) {
    .hp53-ugc__grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media screen and (max-width: 480px) {
    .hp53-ugc__grid { grid-template-columns: repeat(2, 1fr); gap: 10px; }
  }
{%- endstyle -%}

<div class="hp53-ugc__container">
  <div class="hp53-ugc__header">
    {%- if section.settings.eyebrow != blank -%}
      <p class="hp53-ugc__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h2 class="hp53-ugc__heading">{{ section.settings.heading | default: 'Desert Community' }}</h2>
  </div>

  <div class="hp53-ugc__grid">
    {%- for block in section.blocks -%}
      <div class="hp53-ugc__item" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          <img height="{{ block.settings.image.height }}" width="{{ block.settings.image.width }}" src="{{ block.settings.image | image_url: width: 400 }}" alt="{{ block.settings.handle }}" loading="lazy">
        {%- endif -%}
        <div class="hp53-ugc__overlay">
          <p class="hp53-ugc__handle">{{ block.settings.handle | default: '@desert_glow' }}</p>
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "HP53 - Dune UGC",
  "class": "section-hp53-ugc",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FAF5EF" },
    { "type": "color", "id": "title_color", "label": "Title Color", "default": "#5C3D2E" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#C2703E" },
    { "type": "color", "id": "border_color", "label": "Border", "default": "#E8D5C0" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "◈ COMMUNITY" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Desert Community" },
    { "type": "range", "id": "columns", "min": 2, "max": 6, "step": 1, "label": "Columns", "default": 4 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 80 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "blocks": [
    {
      "type": "reel",
      "name": "Reel",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "handle", "label": "Handle", "default": "@desert_glow" }
      ]
    }
  ],
  "presets": [{
    "name": "HP53 - Dune UGC",
    "blocks": [
      { "type": "reel" },
      { "type": "reel", "settings": { "handle": "@saharan_beauty" } },
      { "type": "reel", "settings": { "handle": "@dune_ritual" } },
      { "type": "reel", "settings": { "handle": "@argan_queen" } }
    ]
  }]
}
{% endschema %}
