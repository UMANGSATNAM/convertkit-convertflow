{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#ffffff'
  assign text_color = section.settings.text_color | default: '#000000'
  assign handle = section.settings.handle | default: '@luxuria'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 100px 20px;
    color: {{ text_color }};
  }
  
  .hp8-ig-container-{{ section_id }} {
    max-width: 1600px;
    margin: 0 auto;
  }
  
  .hp8-ig-header-{{ section_id }} {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 60px;
    border-bottom: 1px solid rgba({{ text_color | color_to_rgb | remove: 'rgb(' | remove: ')' }}, {{ 0.2 }});
    padding-bottom: 20px;
  }
  
  .hp8-ig-header-{{ section_id }} h2 {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 4px;
    text-transform: uppercase;
    margin: 0;
  }
  
  .hp8-ig-handle-{{ section_id }} {
    font-family: 'Bodoni MT', 'Didot', 'Playfair Display', serif;
    font-size: 2rem;
    font-weight: 400;
    font-style: italic;
    color: {{ text_color }};
    text-decoration: none;
    transition: opacity 0.3s ease;
  }
  
  .hp8-ig-handle-{{ section_id }}:hover {
    opacity: 0.7;
  }
  
  .hp8-ig-grid-{{ section_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0; /* Zero gap for stark editorial look */
  }
  
  .hp8-ig-item-{{ section_id }} {
    position: relative;
    aspect-ratio: 1/1;
    overflow: hidden;
    background: #111;
    display: block;
  }
  
  .hp8-ig-item-{{ section_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%);
    transition: all 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  
  .hp8-ig-item-{{ section_id }}:hover img {
    filter: grayscale(0%);
    transform: scale(1.05);
  }
  
  .hp8-ig-overlay-{{ section_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  
  .hp8-ig-item-{{ section_id }}:hover .hp8-ig-overlay-{{ section_id }} {
    opacity: 1;
  }
  
  .hp8-ig-icon-{{ section_id }} {
    color: #ffffff;
    width: 30px;
    height: 30px;
  }
  
  .hp8-ig-icon-{{ section_id }} svg {
    width: 100%;
    height: 100%;
    fill: currentColor;
  }

  @media (max-width: 992px) {
    .hp8-ig-grid-{{ section_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  @media (max-width: 576px) {
    .hp8-ig-header-{{ section_id }} {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }
  }
</style>

<div class="hp8-ig-container-{{ section_id }}">
  <div class="hp8-ig-header-{{ section_id }}">
    <h2>SOCIAL</h2>
    <a href="#" class="hp8-ig-handle-{{ section_id }}">{{ handle }}</a>
  </div>
  
  <div class="hp8-ig-grid-{{ section_id }}">
    {% for block in section.blocks %}
      <a href="{{ block.settings.link | default: '#' }}" class="hp8-ig-item-{{ section_id }}" {{ block.shopify_attributes }}>
        {% if block.settings.image != blank %}
          <img src="{{ block.settings.image | image_url: width: 600, height: 600, crop: 'center' }}" alt="Instagram post" loading="lazy" width="300" height="300">
        {% else %}
          <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: #222; color: #fff;">
            POST {{ forloop.index }}
          </div>
        {% endif %}
        
        <div class="hp8-ig-overlay-{{ section_id }}">
          <div class="hp8-ig-icon-{{ section_id }}">
            <svg viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
          </div>
        </div>
      </a>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "HP8 Instagram",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "text",
      "id": "handle",
      "label": "Instagram Handle",
      "default": "@luxuria"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Post",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP8 Instagram",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
