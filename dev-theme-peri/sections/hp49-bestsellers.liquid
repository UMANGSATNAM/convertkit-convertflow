{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp49-bs-bg: {{ section.settings.bg_color | default: '#F5F3FF' }};
    --hp49-accent: {{ section.settings.accent_color | default: '#7C3AED' }};
    
    background-color: var(--hp49-bs-bg);
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
  }

  .hp49-bs__wrap {
    max-width: {{ section.settings.container_width | default: 1280 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp49-bs__header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 50px;
  }

  .hp49-bs__heading {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: clamp(30px, 4vw, 42px);
    font-weight: 800;
    color: #2E1065;
    margin: 0 0 8px;
  }

  .hp49-bs__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: 3 }}, 1fr);
    gap: 24px;
  }

  .hp49-bs__card {
    background: #FFFFFF;
    border: 1px solid rgba(124, 58, 237, 0.15);
    border-radius: 28px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    box-shadow: 0 10px 30px rgba(124, 58, 237, 0.06);
    transition: all 0.3s ease;
  }

  .hp49-bs__card:hover {
    border-color: var(--hp49-accent);
    transform: translateY(-6px);
    box-shadow: 0 18px 45px rgba(124, 58, 237, 0.16);
  }

  .hp49-bs__img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 20px;
    margin-bottom: 20px;
  }

  .hp49-bs__title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 18px;
    font-weight: 800;
    color: #2E1065;
    margin: 0 0 8px;
  }

  .hp49-bs__price {
    font-size: 16px;
    font-weight: 800;
    color: var(--hp49-accent);
    margin-bottom: 18px;
  }

  .hp49-bs__btn {
    width: 100%;
    margin-top: auto;
    padding: 13px;
    background: #7C3AED;
    color: #FFFFFF;
    border: none;
    border-radius: 50px;
    font-family: 'Urbanist', sans-serif;
    font-size: 13px;
    font-weight: 800;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .hp49-bs__btn:hover { background: #6D28D9; }

  @media screen and (max-width: 992px) {
    .hp49-bs__grid { grid-template-columns: 1fr; max-width: 460px; margin: 0 auto; }
  }
{%- endstyle -%}

<div class="hp49-bs__wrap">
  <div class="hp49-bs__header">
    <h2 class="hp49-bs__heading">{{ section.settings.heading | default: 'Our Most Loved Lavender Rituals' }}</h2>
    <p style="font-size:14px; color:#5B21B6; opacity:0.85;">{{ section.settings.subheading | default: 'Beloved for nighttime recovery and all-day calming hydration.' }}</p>
  </div>

  <div class="hp49-bs__grid">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <div class="hp49-bs__card" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img height="{{ block.settings.image.height }}" width="{{ block.settings.image.width }}" src="{{ block.settings.image | image_url: width: 600 }}" class="hp49-bs__img" alt="{{ block.settings.title }}" loading="lazy">
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'hp49-bs__img' }}
          {%- endif -%}
          <h3 class="hp49-bs__title">{{ block.settings.title }}</h3>
          <div class="hp49-bs__price">{{ block.settings.price | default: '$54.00 USD' }}</div>
          <button class="hp49-bs__btn">{{ block.settings.btn_text | default: 'Acquire Ritual' }}</button>
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="hp49-bs__card">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'hp49-bs__img' }}
        <h3 class="hp49-bs__title">Alpine Lavender Cloud Recovery Serum</h3>
        <div class="hp49-bs__price">$54.00 USD</div>
        <button class="hp49-bs__btn">Acquire Ritual</button>
      </div>
      <div class="hp49-bs__card">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'hp49-bs__img' }}
        <h3 class="hp49-bs__title">Cherry Blossom Moisture Mist</h3>
        <div class="hp49-bs__price">$42.00 USD</div>
        <button class="hp49-bs__btn">Acquire Ritual</button>
      </div>
      <div class="hp49-bs__card">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'hp49-bs__img' }}
        <h3 class="hp49-bs__title">Velvet Lilac Night Pillow Mask</h3>
        <div class="hp49-bs__price">$62.00 USD</div>
        <button class="hp49-bs__btn">Acquire Ritual</button>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP49 - Lavender Best",
  "class": "section-hp49-bestsellers",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#F5F3FF" },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#7C3AED" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our Most Loved Lavender Rituals" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Beloved for nighttime recovery and all-day calming hydration." },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "label": "Desktop Columns", "default": 3 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 80 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Alpine Lavender Cloud Recovery Serum" },
        { "type": "text", "id": "price", "label": "Price", "default": "$54.00 USD" },
        { "type": "text", "id": "btn_text", "label": "Button Text", "default": "Acquire Ritual" },
        { "type": "url", "id": "url", "label": "Link URL" }
      ]
    }
  ],
  "presets": [
    { "name": "HP49 - Lavender Best" }
  ]
}
{% endschema %}
