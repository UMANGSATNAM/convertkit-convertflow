{%- liquid
  assign sec_id = section.id
  assign bg_color = section.settings.bg_color
  assign text_color = section.settings.text_color
  assign accent_color = section.settings.accent_color
  assign border_color = section.settings.border_color
  assign border_width = section.settings.border_width
  assign shadow_color = section.settings.shadow_color
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
  assign title = section.settings.title
  assign text = section.settings.text
  assign btn_text = section.settings.btn_text
  assign btn_link = section.settings.btn_link
  assign image = section.settings.image
  assign layout_alignment = section.settings.layout_alignment
-%}

<style>
  .hp18-imgtext-{{ sec_id }} {
    background-color: {{ bg_color }};
    border-bottom: {{ border_width }}px solid {{ border_color }};
    padding-top: {{ padding_top }}px;
    padding-bottom: {{ padding_bottom }}px;
  }

  .hp18-imgtext-{{ sec_id }}__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 700px;
    border-top: {{ border_width }}px solid {{ border_color }};
    border-bottom: {{ border_width }}px solid {{ border_color }};
    max-width: var(--page-width, 1600px);
    margin: 0 auto;
    background-color: {{ text_color }};
  }

  .hp18-imgtext-{{ sec_id }}__image-col {
    padding: 40px;
    background-color: {{ accent_color }};
    {% if layout_alignment == 'left' %}
      border-right: {{ border_width }}px solid {{ border_color }};
      order: 1;
    {% else %}
      border-left: {{ border_width }}px solid {{ border_color }};
      order: 2;
    {% endif %}
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .hp18-imgtext-{{ sec_id }}__image-wrapper {
    width: 100%;
    height: 100%;
    max-height: 600px;
    border: {{ border_width }}px solid {{ border_color }};
    box-shadow: 15px 15px 0px {{ shadow_color }};
    position: relative;
    background: #fff;
    overflow: hidden;
  }

  .hp18-imgtext-{{ sec_id }}__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: contrast(1.1);
  }

  .hp18-imgtext-{{ sec_id }}__text-col {
    padding: 80px 60px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    {% if layout_alignment == 'left' %}
      order: 2;
    {% else %}
      order: 1;
    {% endif %}
  }

  .hp18-imgtext-{{ sec_id }}__title {
    font-family: 'Arial Black', Impact, sans-serif;
    font-size: clamp(40px, 6vw, 72px);
    color: {{ bg_color }};
    text-transform: uppercase;
    margin: 0 0 24px 0;
    line-height: 0.9;
    text-shadow: 4px 4px 0px {{ accent_color }};
    letter-spacing: -2px;
  }

  .hp18-imgtext-{{ sec_id }}__text {
    font-family: 'Courier New', monospace;
    font-size: 18px;
    line-height: 1.6;
    margin: 0 0 40px 0;
    color: {{ bg_color }};
    opacity: 0.9;
    max-width: 500px;
  }

  .hp18-imgtext-{{ sec_id }}__btn {
    align-self: flex-start;
    background-color: {{ accent_color }};
    color: {{ border_color }};
    border: {{ border_width }}px solid {{ border_color }};
    padding: 20px 40px;
    font-family: 'Arial Black', sans-serif;
    text-transform: uppercase;
    text-decoration: none;
    font-size: 18px;
    box-shadow: 8px 8px 0px {{ shadow_color }};
    transition: all 0.2s ease;
    position: relative;
  }

  .hp18-imgtext-{{ sec_id }}__btn:hover {
    background-color: {{ bg_color }};
    color: {{ text_color }};
  }

  .hp18-imgtext-{{ sec_id }}__btn:active {
    box-shadow: 0px 0px 0px {{ shadow_color }};
    transform: translate(8px, 8px);
  }

  @media screen and (max-width: 992px) {
    .hp18-imgtext-{{ sec_id }}__grid { 
      grid-template-columns: 1fr; 
      border-left: none;
      border-right: none;
    }
    .hp18-imgtext-{{ sec_id }}__image-col { 
      order: 1; 
      border-right: none; 
      border-left: none;
      border-bottom: {{ border_width }}px solid {{ border_color }};
      padding: 20px;
      min-height: 400px;
    }
    .hp18-imgtext-{{ sec_id }}__text-col { 
      order: 2; 
      padding: 60px 30px;
    }
    .hp18-imgtext-{{ sec_id }}__image-wrapper {
      box-shadow: 8px 8px 0px {{ shadow_color }};
    }
  }
</style>

<section class="hp18-imgtext-{{ sec_id }}">
  <div class="hp18-imgtext-{{ sec_id }}__grid">
    
    <div class="hp18-imgtext-{{ sec_id }}__image-col">
      <div class="hp18-imgtext-{{ sec_id }}__image-wrapper">
        {% if image != blank %}
          <img height="{{ image.height }}" width="{{ image.width }}" src="{{ image | image_url: width: 2048 }}" alt="{{ title }}" class="hp18-imgtext-{{ sec_id }}__image" loading="lazy">
        {% else %}
          {% capture tmp_class %}hp18-imgtext-{{ sec_id }}__image{% endcapture %}{{ 'collection-1'  | placeholder_svg_tag: tmp_class }}
        {% endif %}
      </div>
    </div>
    
    <div class="hp18-imgtext-{{ sec_id }}__text-col">
      <h2 class="hp18-imgtext-{{ sec_id }}__title">{{ title }}</h2>
      <div class="hp18-imgtext-{{ sec_id }}__text">
        {{ text | newline_to_br }}
      </div>
      {% if btn_text != blank and btn_link != blank %}
        <a href="{{ btn_link }}" class="hp18-imgtext-{{ sec_id }}__btn">{{ btn_text }}</a>
      {% endif %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "HP18 Adv Image + Text",
  "settings": [
    {
      "type": "header",
      "content": "Color Settings"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Outside Background Color",
      "default": "#f4f4f0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Inner Dark Background",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#CCFF00"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "shadow_color",
      "label": "Shadow Color",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_alignment",
      "label": "Image Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "Border Width",
      "default": 3
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 10,
      "unit": "px",
      "label": "Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 10,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 40
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "REDEFINE NORMAL"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Break out of the matrix with apparel designed to make a statement. We don't follow trends; we manufacture them. High-GSM cotton, bold graphics, and cuts that defy expectations."
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "DISCOVER MORE"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link",
      "default": "/collections/all"
    }
  ],
  "presets": [
    {
      "name": "HP18 Advanced Image + Text"
    }
  ]
}
{% endschema %}
