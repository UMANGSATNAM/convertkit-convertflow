{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp45-story-bg: {{ section.settings.bg_color | default: '#F5F5F0' }};
    --hp45-border: {{ section.settings.border_color | default: '#0A0A0A' }};
    --hp45-title: {{ section.settings.title_color | default: '#0A0A0A' }};
    
    background-color: var(--hp45-story-bg);
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }

  .hp45-story__grid {
    max-width: {{ section.settings.container_width | default: 1300 }}px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: stretch;
  }

  .hp45-story__media {
    border: 2px solid var(--hp45-border);
    box-shadow: 6px 6px 0 var(--hp45-border);
    background: #0A0A0A;
    min-height: 480px;
  }

  .hp45-story__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: grayscale(100%);
  }

  .hp45-story__content {
    background: #FFFFFF;
    border: 2px solid var(--hp45-border);
    box-shadow: 6px 6px 0 var(--hp45-border);
    padding: 48px 40px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .hp45-story__badge {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    background: #0A0A0A;
    color: #FFFFFF;
    padding: 4px 10px;
    display: inline-block;
    align-self: flex-start;
    margin-bottom: 20px;
  }

  .hp45-story__title {
    font-size: clamp(32px, 4.5vw, 50px);
    font-weight: 700;
    text-transform: uppercase;
    line-height: 1.1;
    letter-spacing: -1px;
    color: var(--hp45-title);
    margin: 0 0 20px;
  }

  .hp45-story__desc {
    font-family: 'JetBrains Mono', monospace;
    font-size: 14px;
    line-height: 1.7;
    color: #4A4A4A;
    margin: 0 0 30px;
  }

  .hp45-story__specs-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    border-top: 2px solid var(--hp45-border);
    padding-top: 24px;
    margin-bottom: 30px;
  }

  .hp45-story__spec-box {
    border: 1.5px solid var(--hp45-border);
    padding: 12px;
    text-align: center;
    background: #F5F5F0;
  }

  .hp45-story__spec-num {
    font-size: 24px;
    font-weight: 700;
    margin: 0 0 4px;
  }

  .hp45-story__spec-lbl {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: #555555;
    margin: 0;
  }

  .hp45-story__btn {
    display: inline-flex;
    align-self: flex-start;
    padding: 14px 30px;
    background: #0A0A0A;
    color: #FFFFFF;
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: 14px;
    text-transform: uppercase;
    text-decoration: none;
    border: 2px solid #0A0A0A;
    box-shadow: 4px 4px 0 #0A0A0A;
    transition: all 0.2s ease;
  }

  .hp45-story__btn:hover {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0 #0A0A0A;
  }

  @media screen and (max-width: 992px) {
    .hp45-story__grid { grid-template-columns: 1fr; }
    .hp45-story__media { min-height: 320px; }
  }
  @media screen and (max-width: 576px) {
    .hp45-story__content { padding: 30px 20px; }
    .hp45-story__specs-grid { grid-template-columns: 1fr; }
  }
{%- endstyle -%}

<div class="hp45-story__grid">
  <div class="hp45-story__media">
    {%- if section.settings.image != blank -%}
      <img src="{{ section.settings.image | image_url: width: 1000 }}" class="hp45-story__img" alt="Brutalist Laboratory" loading="lazy">
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'hp45-story__img' }}
    {%- endif -%}
  </div>

  <div class="hp45-story__content">
    <div>
      <span class="hp45-story__badge">[CLINICAL PHILOSOPHY]</span>
      <h2 class="hp45-story__title">{{ section.settings.heading | default: 'FORMULATED WITHOUT COMPROMISE' }}</h2>
      <p class="hp45-story__desc">
        {{ section.settings.description | default: 'We reject marketing embellishment in favor of molecular precision. Every batch is manufactured in certified pharmaceutical-grade cleanrooms under strict stoichiometry.' }}
      </p>
    </div>

    <div>
      <div class="hp45-story__specs-grid">
        <div class="hp45-story__spec-box">
          <div class="hp45-story__spec-num">99.8%</div>
          <p class="hp45-story__spec-lbl">ACTIVE RATIO</p>
        </div>
        <div class="hp45-story__spec-box">
          <div class="hp45-story__spec-num">0%</div>
          <p class="hp45-story__spec-lbl">FRAGRANCE</p>
        </div>
        <div class="hp45-story__spec-box">
          <div class="hp45-story__spec-num">48HR</div>
          <p class="hp45-story__spec-lbl">BARRIER STABILITY</p>
        </div>
      </div>

      <a href="{{ section.settings.btn_url | default: '/pages/about' }}" class="hp45-story__btn">
        {{ section.settings.btn_text | default: 'READ LAB ARCHIVES [→]' }}
      </a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "HP45 - Brutal Story",
  "class": "section-hp45-story",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#F5F5F0" },
    { "type": "color", "id": "border_color", "label": "Border Color", "default": "#0A0A0A" },
    { "type": "color", "id": "title_color", "label": "Title Color", "default": "#0A0A0A" },
    { "type": "image_picker", "id": "image", "label": "Story Image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "FORMULATED WITHOUT COMPROMISE" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "We reject marketing embellishment in favor of molecular precision." },
    { "type": "text", "id": "btn_text", "label": "Button Text", "default": "READ LAB ARCHIVES [→]" },
    { "type": "url", "id": "btn_url", "label": "Button URL" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1300 }
  ],
  "presets": [
    { "name": "HP45 - Brutal Story" }
  ]
}
{% endschema %}
