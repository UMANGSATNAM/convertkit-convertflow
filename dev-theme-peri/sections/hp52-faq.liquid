{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp52-faq-bg: {{ section.settings.bg_color | default: '#F7EFE6' }};
    --hp52-terra: {{ section.settings.accent_terra | default: '#C2593F' }};
    
    background-color: var(--hp52-faq-bg);
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }

  .hp52-faq__wrap {
    max-width: {{ section.settings.container_width | default: 860 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp52-faq__header {
    text-align: center;
    margin-bottom: 45px;
  }

  .hp52-faq__heading {
    font-family: 'Bodoni Moda', serif;
    font-size: clamp(32px, 4.5vw, 44px);
    font-weight: 700;
    color: #2D3B2D;
    margin: 0 0 8px;
  }

  .hp52-faq__item {
    background: #FFFDF9;
    border: 1px solid rgba(194, 89, 63, 0.15);
    border-radius: 16px;
    padding: 24px 28px;
    margin-bottom: 16px;
    box-shadow: 0 4px 16px rgba(45, 59, 45, 0.03);
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .hp52-faq__item:hover { border-color: var(--hp52-terra); }

  .hp52-faq__q {
    font-family: 'Jost', sans-serif;
    font-size: 16px;
    font-weight: 700;
    color: #2D3B2D;
    margin: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .hp52-faq__a {
    font-size: 15px;
    line-height: 1.8;
    color: #5C675B;
    margin: 14px 0 0;
    padding-top: 14px;
    border-top: 1px solid rgba(194, 89, 63, 0.1);
  }
{%- endstyle -%}

<div class="hp52-faq__wrap">
  <div class="hp52-faq__header">
    <h2 class="hp52-faq__heading">{{ section.settings.heading | default: 'Mediterranean Atelier Inquiries' }}</h2>
    <p style="font-size:14px; color:#5C675B;">{{ section.settings.subheading | default: 'Details concerning our cold-pressed harvest, terracotta purity, and global dispatch.' }}</p>
  </div>

  {%- if section.blocks.size > 0 -%}
    {%- for block in section.blocks -%}
      <div class="hp52-faq__item" {{ block.shopify_attributes }}>
        <h3 class="hp52-faq__q">
          <span>{{ block.settings.question }}</span>
          <span>+</span>
        </h3>
        <p class="hp52-faq__a">{{ block.settings.answer }}</p>
      </div>
    {%- endfor -%}
  {%- else -%}
    <div class="hp52-faq__item">
      <h3 class="hp52-faq__q"><span>How does Tuscan olive squalane benefit dry skin?</span><span>+</span></h3>
      <p class="hp52-faq__a">Plant squalane derived from cold-pressed Tuscan olives matches the molecular structure of human sebum, absorbing instantly without pore-clogging heaviness.</p>
    </div>
    <div class="hp52-faq__item">
      <h3 class="hp52-faq__q"><span>Is the Sicilian clay drying on sensitive complexions?</span><span>+</span></h3>
      <p class="hp52-faq__a">No, our terracotta clay is suspended in pure cold-pressed almond and olive lipid bases, ensuring that skin is gently detoxified while maintaining hydration.</p>
    </div>
    <div class="hp52-faq__item">
      <h3 class="hp52-faq__q"><span>Are international shipments fully insured and pre-cleared?</span><span>+</span></h3>
      <p class="hp52-faq__a">Yes, all international deliveries are dispatched via DDP express courier with all local import taxes, customs, and duties 100% pre-paid.</p>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "HP52 - Terra FAQ",
  "class": "section-hp52-faq",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#F7EFE6" },
    { "type": "color", "id": "accent_terra", "label": "Terracotta Accent", "default": "#C2593F" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Mediterranean Atelier Inquiries" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Details concerning our cold-pressed harvest, terracotta purity, and global dispatch." },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 600, "max": 1200, "step": 20, "unit": "px", "label": "Container Width", "default": 860 }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How does Tuscan olive squalane benefit dry skin?" },
        { "type": "textarea", "id": "answer", "label": "Answer", "default": "Plant squalane derived from cold-pressed Tuscan olives matches human sebum." }
      ]
    }
  ],
  "presets": [
    { "name": "HP52 - Terra FAQ" }
  ]
}
{% endschema %}
