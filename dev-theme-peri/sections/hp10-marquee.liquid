{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#8A9A86'
  assign text_color = section.settings.text_color | default: '#F9F6F0'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 15px 0;
    overflow: hidden;
    position: relative;
    border-radius: 40px; /* pill shape for the marquee container */
    margin: -30px 20px 40px 20px; /* pull up over the hero */
    z-index: 10;
  }
  
  .hp10-marquee-container-{{ section_id }} {
    display: flex;
    white-space: nowrap;
    overflow: hidden;
  }
  
  .hp10-marquee-content-{{ section_id }} {
    display: flex;
    animation: hp10-marquee-scroll-{{ section_id }} 20s linear infinite;
    align-items: center;
  }
  
  .hp10-marquee-item-{{ section_id }} {
    display: inline-flex;
    align-items: center;
    padding: 0 40px;
    font-family: 'Inter', sans-serif;
    font-size: 1.1rem;
    color: {{ text_color }};
    font-weight: 400;
    letter-spacing: 1px;
    text-transform: uppercase;
  }
  
  .hp10-marquee-dot-{{ section_id }} {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: {{ text_color }};
    margin: 0 40px;
    opacity: 0.5;
  }

  @keyframes hp10-marquee-scroll-{{ section_id }} {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
</style>

<div class="hp10-marquee-container-{{ section_id }}">
  <div class="hp10-marquee-content-{{ section_id }}">
    <!-- First set -->
    {% for i in (1..6) %}
      <div class="hp10-marquee-item-{{ section_id }}">
        {{ section.settings.text | default: '100% ORGANIC & SUSTAINABLE' }}
      </div>
      <div class="hp10-marquee-dot-{{ section_id }}"></div>
    {% endfor %}
    <!-- Duplicate for seamless loop -->
    {% for i in (1..6) %}
      <div class="hp10-marquee-item-{{ section_id }}">
        {{ section.settings.text | default: '100% ORGANIC & SUSTAINABLE' }}
      </div>
      <div class="hp10-marquee-dot-{{ section_id }}"></div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "HP10 Marquee",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#8A9A86"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#F9F6F0"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Marquee Text",
      "default": "100% ORGANIC & SUSTAINABLE"
    }
  ],
  "presets": [
    {
      "name": "HP10 Marquee"
    }
  ]
}
{% endschema %}
