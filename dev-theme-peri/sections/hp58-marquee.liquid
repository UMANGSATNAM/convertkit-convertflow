<style>
@media screen and (max-width: 768px) {
  .hp58-marquee {
    padding-left: 16px !important;
    padding-right: 16px !important;
    box-sizing: border-box !important;
  }
  img {
    max-width: 100% !important;
    height: auto !important;
  }
}
</style>
{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp58-marq-bg: {{ section.settings.bg_color | default: '#111827' }};
    --hp58-marq-text: {{ section.settings.text_color | default: '#06B6D4' }};
    background: var(--hp58-marq-bg);
    overflow: hidden;
    padding: {{ section.settings.padding_vertical | default: 10 }}px 0;
    border-top: 1px solid rgba(6, 182, 212, 0.2);
    border-bottom: 1px solid rgba(139, 92, 246, 0.2);
  }
  .hp58-marquee__track {
    display: flex; gap: 50px;
    animation: hp58MarqueeScroll {{ section.settings.speed | default: 25 }}s linear infinite;
    width: max-content;
  }
  .hp58-marquee__item {
    display: flex; align-items: center; gap: 50px; white-space: nowrap;
    font-family: 'Space Grotesk', sans-serif;
    font-size: {{ section.settings.font_size | default: 14 }}px;
    font-weight: 700; letter-spacing: 2px; text-transform: uppercase;
    color: var(--hp58-marq-text);
  }
  .hp58-marquee__dot {
    width: 6px; height: 6px;
    background: {{ section.settings.dot_color | default: '#8B5CF6' }};
    border-radius: 50%; flex-shrink: 0;
    box-shadow: 0 0 8px #8B5CF6;
  }
  @keyframes hp58MarqueeScroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
{%- endstyle -%}
<div class="hp58-marquee__track">
  {%- for i in (1..12) -%}
    <div class="hp58-marquee__item">
      <span>{{ section.settings.marquee_text | default: '⚡ TOKYO CYBER LAB ⚡ QUANTUM PEPTIDES ⚡ FERMENTED CYBER-ALGAE ⚡ NEON PHOTOPROTECTION' }}</span>
      <span class="hp58-marquee__dot"></span>
    </div>
  {%- endfor -%}
</div>
{% schema %}
{
  "name": "HP58 Marquee",
  "class": "section-hp58-marquee",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#111827" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#06B6D4" },
    { "type": "color", "id": "dot_color", "label": "Dot Color", "default": "#8B5CF6" },
    { "type": "text", "id": "marquee_text", "label": "Marquee Text", "default": "⚡ TOKYO CYBER LAB ⚡ QUANTUM PEPTIDES ⚡ FERMENTED CYBER-ALGAE ⚡ NEON PHOTOPROTECTION" },
    { "type": "range", "id": "speed", "min": 10, "max": 50, "step": 5, "unit": "s", "label": "Speed", "default": 25 },
    { "type": "range", "id": "font_size", "min": 10, "max": 22, "step": 1, "unit": "px", "label": "Font Size", "default": 14 },
    { "type": "range", "id": "padding_vertical", "min": 4, "max": 24, "step": 2, "unit": "px", "label": "Padding", "default": 10 }
  ],
  "presets": [{ "name": "HP58 Marquee" }]
}
{% endschema %}
