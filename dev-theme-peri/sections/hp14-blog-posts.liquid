{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#f4f1de'
  assign text_color = section.settings.text_color | default: '#6b705c'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 100px 40px;
  }
  
  .hp14-blog-container-{{ section_id }} {
    max-width: 1400px;
    margin: 0 auto;
  }
  
  .hp14-blog-header-{{ section_id }} {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 50px;
  }
  
  .hp14-blog-heading-{{ section_id }} {
    font-family: 'Georgia', serif;
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: normal;
    color: {{ text_color }};
    margin: 0;
  }
  
  .hp14-blog-heading-{{ section_id }} span {
    font-style: italic;
    color: #cb997e;
  }
  
  .hp14-blog-link-{{ section_id }} {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #cb997e;
    text-decoration: none;
    border-bottom: 1px solid #cb997e;
    padding-bottom: 2px;
  }
  
  .hp14-blog-grid-{{ section_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
  }
  
  .hp14-blog-card-{{ section_id }} {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    background: #fff;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(107, 112, 92, 0.05);
    transition: transform 0.3s ease;
  }
  
  .hp14-blog-card-{{ section_id }}:hover {
    transform: translateY(-10px);
  }
  
  .hp14-blog-image-wrap-{{ section_id }} {
    position: relative;
    padding-top: 70%;
    overflow: hidden;
  }
  
  .hp14-blog-image-{{ section_id }} {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  
  .hp14-blog-card-{{ section_id }}:hover .hp14-blog-image-{{ section_id }} {
    transform: scale(1.05);
  }
  
  .hp14-blog-content-{{ section_id }} {
    padding: 30px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  
  .hp14-blog-meta-{{ section_id }} {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.8rem;
    color: #cb997e;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 15px;
  }
  
  .hp14-blog-title-{{ section_id }} {
    font-family: 'Georgia', serif;
    font-size: 1.4rem;
    color: {{ text_color }};
    margin: 0 0 15px 0;
    line-height: 1.4;
  }
  
  .hp14-blog-excerpt-{{ section_id }} {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.95rem;
    color: #8a8d7a;
    line-height: 1.5;
    margin: 0;
  }

  @media (max-width: 992px) {
    .hp14-blog-grid-{{ section_id }} {
      grid-template-columns: 1fr;
      gap: 30px;
    }
  }
  
  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 60px 20px;
    }
    .hp14-blog-header-{{ section_id }} {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }
  }
</style>

<div class="hp14-blog-container-{{ section_id }}">
  <div class="hp14-blog-header-{{ section_id }}">
    <h2 class="hp14-blog-heading-{{ section_id }}">The <span>Journal</span></h2>
    {% if section.settings.blog != blank %}
      <a href="{{ blogs[section.settings.blog].url }}" class="hp14-blog-link-{{ section_id }}">Read All</a>
    {% endif %}
  </div>
  
  <div class="hp14-blog-grid-{{ section_id }}">
    {% assign blog = blogs[section.settings.blog] %}
    {% if blog != blank and blog.articles_count > 0 %}
      {% for article in blog.articles limit: 3 %}
        <a href="{{ article.url }}" class="hp14-blog-card-{{ section_id }}">
          <div class="hp14-blog-image-wrap-{{ section_id }}">
            {% if article.image %}
              <img height="{{ article.image.height }}" width="{{ article.image.width }}" src="{{ article.image | image_url: width: 600 }}" class="hp14-blog-image-{{ section_id }}" loading="lazy" alt="{{ article.title }}">
            {% else %}
              <div class="hp14-blog-image-{{ section_id }}" style="background: #e2e2e2;"></div>
            {% endif %}
          </div>
          <div class="hp14-blog-content-{{ section_id }}">
            <div class="hp14-blog-meta-{{ section_id }}">{{ article.published_at | date: "%B %d, %Y" }}</div>
            <h3 class="hp14-blog-title-{{ section_id }}">{{ article.title }}</h3>
            <p class="hp14-blog-excerpt-{{ section_id }}">{{ article.excerpt_or_content | strip_html | truncatewords: 20 }}</p>
          </div>
        </a>
      {% endfor %}
    {% else %}
      {% for i in (1..3) %}
        <a href="#" class="hp14-blog-card-{{ section_id }}">
          <div class="hp14-blog-image-wrap-{{ section_id }}">
            <div class="hp14-blog-image-{{ section_id }}" style="background: repeating-linear-gradient(45deg, #EFEFEF, #EFEFEF 12px, #E6E6E6 12px, #E6E6E6 24px);"></div>
          </div>
          <div class="hp14-blog-content-{{ section_id }}">
            <div class="hp14-blog-meta-{{ section_id }}">October 24, 2025</div>
            <h3 class="hp14-blog-title-{{ section_id }}">The Benefits of Botanical Skincare</h3>
            <p class="hp14-blog-excerpt-{{ section_id }}">Discover why natural, earth-sourced ingredients are better for your skin and the environment.</p>
          </div>
        </a>
      {% endfor %}
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "HP14 Blog Posts",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f4f1de"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#6b705c"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    }
  ],
  "presets": [
    {
      "name": "HP14 Blog Posts"
    }
  ]
}
{% endschema %}
