{%- style -%}
  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --font-heading: 'Lora', serif;
    --font-body: 'Outfit', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    position: relative;
    overflow: hidden;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }

  /* Organic grain texture overlay */
  {% if section.settings.show_grain %}
  #shopify-section-{{ section.id }}::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    opacity: 0.04;
    pointer-events: none;
    z-index: 1;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
  }
  {% endif %}

  .hp22-press-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
    position: relative;
    z-index: 2;
  }

  @media screen and (max-width: 768px) {
    .hp22-press-wrapper {
      padding: 0 20px;
    }
  }

  .hp22-press__header {
    text-align: center;
    margin-bottom: {{ section.settings.header_margin }}px;
  }

  .hp22-press__subtitle {
    font-family: var(--font-body);
    font-size: {{ section.settings.subtitle_size }}px;
    font-weight: 400;
    letter-spacing: 2px;
    color: var(--accent-color);
    text-transform: uppercase;
    margin: 0;
  }
  
  .hp22-press__quote {
    font-family: var(--font-heading);
    font-size: clamp(24px, 4vw, {{ section.settings.quote_size }}px);
    font-weight: 400;
    color: var(--text-color);
    margin: 16px auto 0;
    max-width: 800px;
    line-height: 1.3;
    font-style: italic;
  }

  .hp22-press__logos-container {
    position: relative;
    {% if section.settings.layout_style == 'marquee' %}
      display: flex;
      overflow: hidden;
      width: 100vw;
      margin-left: calc(-50vw + 50%);
    {% else %}
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 40px;
    {% endif %}
    align-items: center;
  }

  /* Marquee Animation */
  {% if section.settings.layout_style == 'marquee' %}
    .hp22-press__track {
      display: flex;
      gap: 80px;
      padding: 0 40px;
      animation: hp22-press-scroll {{ section.settings.marquee_speed }}s linear infinite;
    }

    @keyframes hp22-press-scroll {
      0% { transform: translateX(0); }
      100% { transform: translateX(calc(-50% - 40px)); }
    }

    /* Edge gradients for smooth blend */
    .hp22-press__logos-container::before,
    .hp22-press__logos-container::after {
      content: '';
      position: absolute;
      top: 0;
      bottom: 0;
      width: 100px;
      z-index: 2;
      pointer-events: none;
    }
    .hp22-press__logos-container::before {
      left: 0;
      background: linear-gradient(to right, var(--bg-color), transparent);
    }
    .hp22-press__logos-container::after {
      right: 0;
      background: linear-gradient(to left, var(--bg-color), transparent);
    }
  {% endif %}

  .hp22-press__logo {
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.4s ease;
    {% if section.settings.layout_style == 'grid' %}
      width: calc(25% - 30px);
      min-width: 120px;
    {% endif %}
  }

  .hp22-press__logo img {
    max-width: {{ section.settings.logo_max_width }}px;
    height: auto;
    object-fit: contain;
    {% if section.settings.blend_logos %}
      filter: grayscale(100%) opacity(0.5) contrast(1.2) brightness(0.8);
      mix-blend-mode: multiply;
    {% endif %}
    transition: all 0.4s ease;
  }

  .hp22-press__logo:hover img {
    {% if section.settings.blend_logos %}
      filter: grayscale(0%) opacity(1) contrast(1) brightness(1);
    {% endif %}
    transform: scale(1.05);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp22-press-wrapper" id="HP22Press-{{ section.id }}">
  
  {%- if section.settings.subtitle != blank or section.settings.quote != blank -%}
    <div class="hp22-press__header">
      {%- if section.settings.subtitle != blank -%}
        <p class="hp22-press__subtitle">{{ section.settings.subtitle | escape }}</p>
      {%- endif -%}
      {%- if section.settings.quote != blank -%}
        <h3 class="hp22-press__quote">"{{ section.settings.quote }}"</h3>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="hp22-press__logos-container">
    {%- if section.settings.layout_style == 'marquee' -%}
      <div class="hp22-press__track">
        {%- for i in (1..2) -%}
          {%- for block in section.blocks -%}
            <div class="hp22-press__logo" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                <img height="{{ block.settings.image.height }}" width="{{ block.settings.image.width }}" src="{{ block.settings.image | image_url: width: 300 }}" alt="{{ block.settings.image.alt | default: 'Press Logo' | escape }}" loading="lazy">
              {%- else -%}
                <div style="font-family:var(--font-heading); font-size:24px; font-weight:700; color:var(--text-color); opacity:0.4;">LOGO</div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      {%- for block in section.blocks -%}
        <div class="hp22-press__logo" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img height="{{ block.settings.image.height }}" width="{{ block.settings.image.width }}" src="{{ block.settings.image | image_url: width: 300 }}" alt="{{ block.settings.image.alt | default: 'Press Logo' | escape }}" loading="lazy">
          {%- else -%}
            <div style="font-family:var(--font-heading); font-size:24px; font-weight:700; color:var(--text-color); opacity:0.4;">LOGO</div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>

</div>

{% schema %}
{
  "name": "HP22 - Organic Press",
  "class": "section-hp22-press-logos",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "AS SEEN IN"
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Featured Press Quote",
      "default": "A masterclass in botanical formulation. Simply exquisite."
    },
    {
      "type": "range",
      "id": "header_margin",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Margin Below Header",
      "default": 40
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 800,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1200
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Display Style",
      "options": [
        { "value": "grid", "label": "Static Grid" },
        { "value": "marquee", "label": "Scrolling Marquee" }
      ],
      "default": "grid"
    },
    {
      "type": "range",
      "id": "marquee_speed",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "s",
      "label": "Marquee Speed",
      "info": "Only applies if Scrolling Marquee is selected",
      "default": 30
    },
    {
      "type": "range",
      "id": "logo_max_width",
      "min": 80,
      "max": 250,
      "step": 10,
      "unit": "px",
      "label": "Logo Max Width",
      "default": 140
    },
    {
      "type": "checkbox",
      "id": "blend_logos",
      "label": "Blend logos into background",
      "info": "Applies greyscale and multiply effect. Hover to reveal color.",
      "default": true
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "quote_size",
      "min": 20,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Quote Size",
      "default": 32
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Subtitle Size",
      "default": 14
    },
    {
      "type": "header",
      "content": "Organic Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#F9F6F0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#3A3A3A"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#8A9A86"
    },
    {
      "type": "checkbox",
      "id": "show_grain",
      "label": "Show subtle paper grain texture",
      "default": true
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 60
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Press Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP22 - Organic Press",
      "blocks": [
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" }
      ]
    }
  ]
}
{% endschema %}
