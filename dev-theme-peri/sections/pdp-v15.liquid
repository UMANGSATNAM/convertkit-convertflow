{%- comment -%}
  PDP V15: HIGH-END FRAGRANCE
  Aesthetic: Glassmorphism, Ultra-Luxury, Sensory.
  CRO: Scissor-cut offer, Gift Box Upsell, Sensory Notes.
{%- endcomment -%}

{%- assign current_variant = product.selected_or_first_available_variant -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600&family=Montserrat:wght@300;400;500&display=swap');

  :root {
    --v15-bg: #F9F9FA;
    --v15-text: #1A1A1A;
    --v15-text-light: #8A8A8A;
    --v15-accent: #D4AF37; /* Gold */
    --v15-border: #E5E5E5;
    --v15-font-head: 'Cinzel', serif;
    --v15-font-body: 'Montserrat', sans-serif;
  }

  .pdp-v15 {
    background-color: var(--v15-bg);
    color: var(--v15-text);
    font-family: var(--v15-font-body);
    line-height: 1.6;
    background-image: radial-gradient(circle at 50% -20%, #FFF 0%, #F9F9FA 60%);
  }

  .pdp-v15__container {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
  }
  @media (min-width: 992px) {
    .pdp-v15__container { grid-template-columns: 1fr 500px; }
  }

  /* --- GALLERY --- */
  .pdp-v15__gallery {
    padding: 20px;
    display: flex; align-items: center; justify-content: center;
  }
  @media (min-width: 992px) {
    .pdp-v15__gallery { height: calc(100vh - 40px); position: sticky; top: 0; padding: 40px; }
  }
  .pdp-v15__gallery img, .pdp-v15__gallery svg {
    width: 100%; max-width: 600px; height: auto; object-fit: contain; filter: drop-shadow(0 30px 40px rgba(0,0,0,0.05));
  }

  /* --- INFO BOX (GLASSMORPHISM) --- */
  .pdp-v15__info {
    padding: 32px 24px;
    background: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-left: 1px solid rgba(255, 255, 255, 0.5);
    box-shadow: -10px 0 30px rgba(0,0,0,0.02);
  }
  @media (min-width: 992px) {
    .pdp-v15__info { padding: 60px 40px; min-height: 100vh; }
  }

  /* --- SCISSOR CUT OFFER --- */
  .pdp-v15__offer {
    border: 1px dashed var(--v15-accent);
    padding: 12px 16px;
    border-radius: 4px;
    margin-bottom: 32px;
    position: relative;
    text-align: center;
    background: rgba(212, 175, 55, 0.05);
  }
  .pdp-v15__offer-text { font-size: 13px; font-weight: 500; letter-spacing: 1px; }
  .pdp-v15__offer-text strong { color: var(--v15-accent); font-weight: 600; }
  .pdp-v15__scissor { position: absolute; top: -10px; left: 20px; font-size: 16px; background: var(--v15-bg); padding: 0 4px; }

  /* --- HEADER --- */
  .pdp-v15__title { font-family: var(--v15-font-head); font-size: 36px; line-height: 1.2; margin: 0 0 8px 0; }
  .pdp-v15__type { font-size: 11px; text-transform: uppercase; letter-spacing: 3px; color: var(--v15-text-light); margin-bottom: 24px; display: block; }
  
  .pdp-v15__price { font-size: 24px; font-weight: 400; margin-bottom: 32px; display: block; font-family: var(--v15-font-head); }

  /* --- SIZES --- */
  .pdp-v15__sizes { display: flex; gap: 12px; margin-bottom: 32px; }
  .pdp-v15__size {
    flex: 1; text-align: center; border: 1px solid var(--v15-border); padding: 12px 0;
    cursor: pointer; transition: all 0.3s;
  }
  .pdp-v15__size-vol { font-size: 13px; font-weight: 500; margin-bottom: 4px; display: block; }
  .pdp-v15__size-price { font-size: 12px; color: var(--v15-text-light); }
  .pdp-v15__size.active { border-color: var(--v15-text); box-shadow: inset 0 0 0 1px var(--v15-text); }

  /* --- NOTES (SENSORY) --- */
  .pdp-v15__notes { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; text-align: center; margin-bottom: 40px; }
  .pdp-v15__note { padding: 16px 8px; border: 1px solid var(--v15-border); background: #FFF; }
  .pdp-v15__note-label { font-size: 10px; text-transform: uppercase; letter-spacing: 2px; color: var(--v15-text-light); margin-bottom: 8px; display: block; }
  .pdp-v15__note-val { font-family: var(--v15-font-head); font-size: 14px; }

  /* --- GIFT BOX UPSELL --- */
  .pdp-v15__gift {
    border: 1px solid var(--v15-border); padding: 16px; display: flex; gap: 16px; align-items: center; margin-bottom: 32px; background: #FFF;
  }
  .pdp-v15__gift-check {
    appearance: none; width: 20px; height: 20px; border: 1px solid var(--v15-text); border-radius: 50%; cursor: pointer; position: relative;
  }
  .pdp-v15__gift-check:checked::after {
    content:''; position: absolute; width: 10px; height: 10px; background: var(--v15-text); border-radius: 50%; top: 50%; left: 50%; transform: translate(-50%, -50%);
  }
  .pdp-v15__gift-info { flex: 1; }
  .pdp-v15__gift-title { font-size: 13px; font-weight: 500; margin-bottom: 2px; }
  .pdp-v15__gift-desc { font-size: 11px; color: var(--v15-text-light); }
  .pdp-v15__gift-price { font-size: 13px; font-weight: 500; font-family: var(--v15-font-head); }

  /* --- ATC --- */
  .pdp-v15__atc {
    width: 100%; background: var(--v15-text); color: #FFF; border: none; padding: 20px;
    font-family: var(--v15-font-body); font-size: 14px; font-weight: 500; text-transform: uppercase; letter-spacing: 3px;
    cursor: pointer; margin-bottom: 32px; transition: background 0.3s;
  }
  .pdp-v15__atc:hover { background: #333; }

  /* --- ACCORDIONS --- */
  .pdp-v15__acc { border-top: 1px solid var(--v15-border); }
  .pdp-v15__acc:last-child { border-bottom: 1px solid var(--v15-border); }
  .pdp-v15__acc-btn {
    width: 100%; text-align: left; background: none; border: none; padding: 20px 0;
    font-family: var(--v15-font-head); font-size: 16px; font-weight: 500; text-transform: uppercase; letter-spacing: 1px;
    display: flex; justify-content: space-between; cursor: pointer; align-items: center;
  }
  .pdp-v15__acc-content { padding-bottom: 20px; font-size: 13px; color: var(--v15-text-light); line-height: 1.8; }

  /* --- STICKY ATC --- */
  .pdp-v15-sticky {
    position: fixed; bottom: -100px; left: 0; width: 100%; background: rgba(255,255,255,0.9); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    z-index: 999; padding: 16px 20px; display: flex; justify-content: space-between; align-items: center;
    transition: bottom 0.4s ease; border-top: 1px solid var(--v15-border);
  }
  .pdp-v15-sticky.visible { bottom: 0; }
  .pdp-v15-sticky__title { font-family: var(--v15-font-head); font-size: 18px; }
  .pdp-v15-sticky__btn {
    background: var(--v15-text); color: #FFF; border: none; padding: 12px 32px;
    font-size: 12px; text-transform: uppercase; letter-spacing: 2px; cursor: pointer;
  }

</style>

<div class="pdp-v15" data-section="{{ section.id }}">
  
  <div class="pdp-v15__container">
    
    <!-- GALLERY -->
    <div class="pdp-v15__gallery">
      {% if product.featured_media %}
        <img src="{{ product.featured_media | image_url: width: 800 }}">
      {% else %}
        {{ 'product-1' | placeholder_svg_tag }}
      {% endif %}
    </div>

    <!-- INFO BOX (GLASSMORPHISM) -->
    <div class="pdp-v15__info">
      
      {% if section.settings.show_offer %}
        <div class="pdp-v15__offer">
          <span class="pdp-v15__scissor">âœ‚</span>
          <div class="pdp-v15__offer-text">Enjoy a complimentary 2ml sample with every order over <strong>â‚¹5000</strong>.</div>
        </div>
      {% endif %}

      <!-- URGENCY SECTION -->
      {% if section.settings.show_urgency %}
        <div style="background: rgba(212, 175, 55, 0.1); border: 1px solid rgba(212, 175, 55, 0.3); padding: 12px; margin-bottom: 24px; text-align: center; border-radius: 4px;">
          <div style="font-family: var(--v15-font-head); font-size: 13px; font-weight: 600; color: var(--v15-accent); margin-bottom: 4px;">LIMITED EDITION</div>
          <div style="font-size: 12px; font-weight: 500;">Only 8 bottles remaining from this season's batch.</div>
        </div>
      {% endif %}
      
      <h1 class="pdp-v15__title">{{ product.title | default: "Oud & Bergamot" }}</h1>
      <span class="pdp-v15__type">Eau De Parfum</span>
      
      <span class="pdp-v15__price">{{ current_variant.price | money }}</span>

      <div class="pdp-v15__sizes">
        <div class="pdp-v15__size">
          <span class="pdp-v15__size-vol">50 ML</span>
          <span class="pdp-v15__size-price">â‚¹4,500</span>
        </div>
        <div class="pdp-v15__size active">
          <span class="pdp-v15__size-vol">100 ML</span>
          <span class="pdp-v15__size-price">â‚¹7,200</span>
        </div>
      </div>

      <!-- SENSORY NOTES -->
      <div class="pdp-v15__notes">
        <div class="pdp-v15__note">
          <span class="pdp-v15__note-label">Top Note</span>
          <span class="pdp-v15__note-val">Bergamot</span>
        </div>
        <div class="pdp-v15__note">
          <span class="pdp-v15__note-label">Heart Note</span>
          <span class="pdp-v15__note-val">Cedarwood</span>
        </div>
        <div class="pdp-v15__note">
          <span class="pdp-v15__note-label">Base Note</span>
          <span class="pdp-v15__note-val">Rich Oud</span>
        </div>
      </div>

      <!-- GIFT BOX UPSELL -->
      {% if section.settings.show_gift %}
        <div class="pdp-v15__gift">
          <input type="checkbox" class="pdp-v15__gift-check">
          <div class="pdp-v15__gift-info">
            <div class="pdp-v15__gift-title">Add Signature Gift Boxing</div>
            <div class="pdp-v15__gift-desc">Presented in our luxurious textured box with a ribbon.</div>
          </div>
          <div class="pdp-v15__gift-price">+â‚¹499</div>
        </div>
      {% endif %}

      <button class="pdp-v15__atc" id="v15-atc">ADD TO BAG</button>

      <!-- ACCORDIONS -->
      <div class="pdp-v15__acc">
        <button class="pdp-v15__acc-btn">The Story <span>+</span></button>
        <div class="pdp-v15__acc-content">
          {{ product.description | strip_html | default: "A mysterious and smoky character. Central Middle Eastern traditions intertwine with crisp bergamot and an orange granite accord." }}
        </div>
      </div>
      <div class="pdp-v15__acc">
        <button class="pdp-v15__acc-btn">Ingredients <span>+</span></button>
        <div class="pdp-v15__acc-content" style="display:none;">
          Alcohol Denat., Fragrance (Parfum), Water\Aqua\Eau, Linalool, Limonene, Coumarin, Citronellol.
        </div>
      </div>
      <div class="pdp-v15__acc">
        <button class="pdp-v15__acc-btn">Shipping & Returns <span>+</span></button>
        <div class="pdp-v15__acc-content" style="display:none;">
          Complimentary shipping and returns on all orders. Please note that engraved items cannot be returned.
        </div>
      </div>

    </div>
  </div>

  <!-- FULL WIDTH IMAGE / LIFESTYLE -->
  {% if section.settings.show_full_image %}
    <div style="width: 100%; position: relative; margin-top: 80px;">
      {{ 'lifestyle-1' | placeholder_svg_tag: 'style="width: 100%; height: 70vh; object-fit: cover;"' }}
      <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: linear-gradient(to top, rgba(26,26,26,0.8), transparent); display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; color: #FFF; padding: 40px;">
        <h2 style="font-family: var(--v15-font-head); font-size: 42px; font-weight: 500; margin-bottom: 16px; letter-spacing: 2px;">An Unforgettable Aura</h2>
        <p style="font-size: 16px; font-weight: 300; max-width: 600px; margin-bottom: 40px; font-family: var(--v15-font-body); letter-spacing: 1px; line-height: 1.8;">Experience the harmonious blend of rare ingredients, meticulously crafted by master perfumers to leave a lasting impression.</p>
        <button style="background: transparent; color: #FFF; border: 1px solid #FFF; padding: 16px 40px; font-family: var(--v15-font-head); font-weight: 600; font-size: 13px; cursor: pointer; text-transform: uppercase; letter-spacing: 2px; transition: all 0.3s;" onclick="window.scrollTo({top: 0, behavior: 'smooth'})" onmouseover="this.style.background='#FFF'; this.style.color='#000';" onmouseout="this.style.background='transparent'; this.style.color='#FFF';">Discover the Scent</button>
      </div>
    </div>
  {% endif %}

  <!-- CROSS SELL / FEATURED -->
  {% if section.settings.show_cross_sell %}
    <div style="max-width: 1200px; margin: 80px auto; padding: 20px;">
      <h2 style="font-family: var(--v15-font-head); font-size: 28px; text-align: center; margin-bottom: 48px; color: var(--v15-text); letter-spacing: 2px;">The Complete Regimen</h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 32px;">
        <div style="text-align: center;">
          {{ 'product-3' | placeholder_svg_tag: 'style="width:100%; aspect-ratio:3/4; object-fit:cover; margin-bottom:24px; filter: drop-shadow(0 10px 20px rgba(0,0,0,0.05));"' }}
          <h3 style="font-family: var(--v15-font-head); font-size: 16px; font-weight: 600; margin-bottom: 8px;">Nourishing Body CrÃ¨me</h3>
          <p style="color: var(--v15-text-light); font-size: 14px; margin-bottom: 16px;">â‚¹3,500</p>
          <button style="width: 100%; background: var(--v15-bg); color: var(--v15-text); border: 1px solid var(--v15-border); padding: 14px; font-family: var(--v15-font-body); font-weight: 500; font-size: 12px; text-transform: uppercase; letter-spacing: 2px; cursor: pointer; transition: background 0.3s;" onmouseover="this.style.background='#FFF'" onmouseout="this.style.background='var(--v15-bg)'">Add to Bag</button>
        </div>
        <div style="text-align: center;">
          {{ 'product-4' | placeholder_svg_tag: 'style="width:100%; aspect-ratio:3/4; object-fit:cover; margin-bottom:24px; filter: drop-shadow(0 10px 20px rgba(0,0,0,0.05));"' }}
          <h3 style="font-family: var(--v15-font-head); font-size: 16px; font-weight: 600; margin-bottom: 8px;">Exfoliating Shower Gel</h3>
          <p style="color: var(--v15-text-light); font-size: 14px; margin-bottom: 16px;">â‚¹2,800</p>
          <button style="width: 100%; background: var(--v15-bg); color: var(--v15-text); border: 1px solid var(--v15-border); padding: 14px; font-family: var(--v15-font-body); font-weight: 500; font-size: 12px; text-transform: uppercase; letter-spacing: 2px; cursor: pointer; transition: background 0.3s;" onmouseover="this.style.background='#FFF'" onmouseout="this.style.background='var(--v15-bg)'">Add to Bag</button>
        </div>
        <div style="text-align: center;">
          {{ 'product-5' | placeholder_svg_tag: 'style="width:100%; aspect-ratio:3/4; object-fit:cover; margin-bottom:24px; filter: drop-shadow(0 10px 20px rgba(0,0,0,0.05));"' }}
          <h3 style="font-family: var(--v15-font-head); font-size: 16px; font-weight: 600; margin-bottom: 8px;">Travel Spray Set</h3>
          <p style="color: var(--v15-text-light); font-size: 14px; margin-bottom: 16px;">â‚¹4,200</p>
          <button style="width: 100%; background: var(--v15-bg); color: var(--v15-text); border: 1px solid var(--v15-border); padding: 14px; font-family: var(--v15-font-body); font-weight: 500; font-size: 12px; text-transform: uppercase; letter-spacing: 2px; cursor: pointer; transition: background 0.3s;" onmouseover="this.style.background='#FFF'" onmouseout="this.style.background='var(--v15-bg)'">Add to Bag</button>
        </div>
      </div>
    </div>
  {% endif %}

  <!-- RECENTLY VIEWED SECTION -->
  {% if section.settings.show_recently_viewed %}
    <div style="max-width: 1200px; margin: 40px auto 80px auto; padding: 20px;">
      <h2 style="font-family: var(--v15-font-head); font-size: 20px; text-align: left; margin-bottom: 32px; color: var(--v15-text); border-bottom: 1px solid var(--v15-border); padding-bottom: 16px;">Recently Viewed</h2>
      <div style="display: flex; gap: 24px; overflow-x: auto; padding-bottom: 24px; scrollbar-width: none;">
        {% for i in (1..4) %}
          <div style="min-width: 220px; text-align: center;">
            {% capture ph %}product-{{ i }}{% endcapture %}
            {{ ph | placeholder_svg_tag: 'style="width:100%; aspect-ratio:1; object-fit:cover; margin-bottom:16px; background:#FFF;"' }}
            <h4 style="font-family: var(--v15-font-head); font-size: 14px; font-weight: 500; margin: 0 0 6px 0; color: var(--v15-text);">Velvet Rose</h4>
            <div style="font-size: 13px; color: var(--v15-text-light);">â‚¹6,500</div>
          </div>
        {% endfor %}
      </div>
    </div>
  {% endif %}

  <!-- BUILT-IN STICKY ATC -->
  <div class="pdp-v15-sticky" id="v15-sticky">
    <div class="pdp-v15-sticky__title">{{ product.title | default: "Oud & Bergamot" }}</div>
    <button class="pdp-v15-sticky__btn" onclick="window.scrollTo({top: 0, behavior: 'smooth'})">ADD TO BAG - {{ current_variant.price | money }}</button>
  </div>

  <script>
    document.addEventListener("DOMContentLoaded", function() {
      const accBtns = document.querySelectorAll('.pdp-v15__acc-btn');
      accBtns.forEach(btn => {
        btn.addEventListener('click', function() {
          const content = this.nextElementSibling;
          if (content.style.display === "none" || content.style.display === "") {
            content.style.display = "block";
            this.querySelector('span').innerText = "-";
          } else {
            content.style.display = "none";
            this.querySelector('span').innerText = "+";
          }
        });
      });

      const stickyBar = document.getElementById('v15-sticky');
      const mainAtc = document.getElementById('v15-atc');
      if(stickyBar && mainAtc) {
        window.addEventListener('scroll', function() {
          const mainAtcRect = mainAtc.getBoundingClientRect();
          if (mainAtcRect.top < 0) {
            stickyBar.classList.add('visible');
          } else {
            stickyBar.classList.remove('visible');
          }
        });
      }
    });
  </script>

</div>

{% schema %}
{
  "name": "PDP V15 - Fragrance",
  "settings": [
    {
      "type": "header",
      "content": "Offer Banner"
    },
    {
      "type": "checkbox",
      "id": "show_offer",
      "label": "Show Scissor-cut Offer",
      "default": true
    },
    {
      "type": "header",
      "content": "Upsell"
    },
    {
      "type": "checkbox",
      "id": "show_gift",
      "label": "Show Gift Box Upsell",
      "default": true
    },
    {
      "type": "header",
      "content": "Urgency"
    },
    {
      "type": "checkbox",
      "id": "show_urgency",
      "label": "Show Limited Edition Urgency",
      "default": true
    },
    {
      "type": "header",
      "content": "Bottom Sections"
    },
    {
      "type": "checkbox",
      "id": "show_full_image",
      "label": "Show Full Width Lifestyle Image",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cross_sell",
      "label": "Show 'Complete Regimen' Cross Sell",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_recently_viewed",
      "label": "Show Recently Viewed",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "PDP V15 - Fragrance"
    }
  ]
}
{% endschema %}
