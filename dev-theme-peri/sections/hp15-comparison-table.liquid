{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#ffffff'
  assign text_color = section.settings.text_color | default: '#000000'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 120px 40px;
    color: {{ text_color }};
  }
  
  .hp15-table-container-{{ section_id }} {
    max-width: 1000px;
    margin: 0 auto;
  }
  
  .hp15-table-heading-{{ section_id }} {
    font-family: 'Didot', 'Playfair Display', serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: normal;
    text-transform: uppercase;
    letter-spacing: 2px;
    text-align: center;
    margin: 0 0 60px 0;
  }
  
  .hp15-table-wrapper-{{ section_id }} {
    width: 100%;
    border-top: 2px solid {{ text_color }};
  }
  
  .hp15-table-row-{{ section_id }} {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    border-bottom: 1px solid rgba(0,0,0,0.1);
    padding: 25px 0;
  }
  
  .hp15-table-header-{{ section_id }} {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    font-weight: bold;
  }
  
  .hp15-table-cell-{{ section_id }} {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.9rem;
    display: flex;
    align-items: center;
  }
  
  .hp15-table-icon-{{ section_id }} {
    width: 20px;
    height: 20px;
  }
  
  .hp15-table-brand-{{ section_id }} {
    font-weight: bold;
  }
  
  .hp15-table-other-{{ section_id }} {
    color: #888;
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 60px 20px;
    }
    .hp15-table-row-{{ section_id }} {
      grid-template-columns: 1fr 1fr;
      gap: 15px;
    }
    .hp15-table-feature-{{ section_id }} {
      grid-column: span 2;
      padding-bottom: 0;
    }
  }
</style>

<div class="hp15-table-container-{{ section_id }}">
  <h2 class="hp15-table-heading-{{ section_id }}">THE STANDARD</h2>
  
  <div class="hp15-table-wrapper-{{ section_id }}">
    <div class="hp15-table-row-{{ section_id }} hp15-table-header-{{ section_id }}">
      <div class="hp15-table-feature-{{ section_id }}">CRITERIA</div>
      <div class="hp15-table-brand-{{ section_id }}">OUR HOUSE</div>
      <div class="hp15-table-other-{{ section_id }}">OTHERS</div>
    </div>
    
    {% for block in section.blocks %}
      <div class="hp15-table-row-{{ section_id }}" {{ block.shopify_attributes }}>
        <div class="hp15-table-cell-{{ section_id }} hp15-table-feature-{{ section_id }}">{{ block.settings.feature }}</div>
        <div class="hp15-table-cell-{{ section_id }} hp15-table-brand-{{ section_id }}">
          {% if block.settings.brand_has %}
            <svg class="hp15-table-icon-{{ section_id }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
          {% else %}
            <svg class="hp15-table-icon-{{ section_id }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
          {% endif %}
        </div>
        <div class="hp15-table-cell-{{ section_id }} hp15-table-other-{{ section_id }}">
          {% if block.settings.other_has %}
            <svg class="hp15-table-icon-{{ section_id }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
          {% else %}
            <svg class="hp15-table-icon-{{ section_id }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "HP15 Comparison Table",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Feature Row",
      "settings": [
        {
          "type": "text",
          "id": "feature",
          "label": "Feature Name",
          "default": "100% Italian Silk"
        },
        {
          "type": "checkbox",
          "id": "brand_has",
          "label": "Our House Has",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "other_has",
          "label": "Others Have",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP15 Comparison Table",
      "blocks": [
        { "type": "row", "settings": { "feature": "Ethically Sourced Materials", "brand_has": true, "other_has": false } },
        { "type": "row", "settings": { "feature": "Hand-Stitched Details", "brand_has": true, "other_has": false } },
        { "type": "row", "settings": { "feature": "Carbon Neutral Production", "brand_has": true, "other_has": false } },
        { "type": "row", "settings": { "feature": "Lifetime Warranty", "brand_has": true, "other_has": false } }
      ]
    }
  ]
}
{% endschema %}
