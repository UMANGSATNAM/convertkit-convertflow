{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400&family=Space+Grotesk:wght@400;500;600;700&display=swap');

  #shopify-section-{{ section.id }} {
    --hp53-bg: {{ section.settings.bg_color | default: '#FAF5EF' }};
    --hp53-text: {{ section.settings.text_color | default: '#5C3D2E' }};
    --hp53-terracotta: {{ section.settings.accent_color | default: '#C2703E' }};
    --hp53-sand: {{ section.settings.sand_color | default: '#E8D5C0' }};
    --hp53-btn-bg: {{ section.settings.btn_bg | default: '#5C3D2E' }};
    --hp53-btn-text: {{ section.settings.btn_text_color | default: '#FAF5EF' }};

    background-color: var(--hp53-bg);
    color: var(--hp53-text);
    font-family: 'Space Grotesk', sans-serif;
    padding-top: {{ section.settings.padding_top | default: 100 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 100 }}px;
    position: relative;
    overflow: hidden;
  }

  .hp53-hero__dune-accent {
    position: absolute;
    top: -80px;
    right: -120px;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, var(--hp53-sand) 0%, transparent 70%);
    opacity: 0.4;
    pointer-events: none;
  }

  .hp53-hero__container {
    max-width: {{ section.settings.container_width | default: 1280 }}px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 70px;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  .hp53-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 20px;
    background: linear-gradient(135deg, var(--hp53-sand), transparent);
    border-left: 3px solid var(--hp53-terracotta);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--hp53-terracotta);
    margin-bottom: 28px;
  }

  .hp53-hero__title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(40px, 5.5vw, 66px);
    font-weight: 700;
    line-height: 1.08;
    color: var(--hp53-text);
    margin: 0 0 24px;
    letter-spacing: -0.5px;
  }

  .hp53-hero__title em {
    font-style: italic;
    color: var(--hp53-terracotta);
    font-weight: 400;
  }

  .hp53-hero__desc {
    font-size: 16px;
    line-height: 1.75;
    color: var(--hp53-terracotta);
    margin: 0 0 38px;
    max-width: 500px;
    font-weight: 400;
  }

  .hp53-hero__actions {
    display: flex;
    gap: 16px;
    align-items: center;
    flex-wrap: wrap;
  }

  .hp53-hero__btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 15px 34px;
    background: var(--hp53-btn-bg);
    color: var(--hp53-btn-text);
    font-family: 'Space Grotesk', sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 4px;
    transition: all 0.35s ease;
    border: 2px solid var(--hp53-btn-bg);
  }

  .hp53-hero__btn:hover {
    background: transparent;
    color: var(--hp53-btn-bg);
  }

  .hp53-hero__media {
    position: relative;
  }

  .hp53-hero__img-wrap {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    height: 520px;
    box-shadow: 20px 20px 0 var(--hp53-sand);
  }

  .hp53-hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: sepia(15%) contrast(1.05);
    transition: transform 0.6s ease;
  }

  .hp53-hero__img-wrap:hover .hp53-hero__img {
    transform: scale(1.04);
  }

  .hp53-hero__float-card {
    position: absolute;
    bottom: -20px;
    left: -20px;
    background: var(--hp53-bg);
    border: 2px solid var(--hp53-sand);
    border-radius: 8px;
    padding: 16px 22px;
    display: flex;
    align-items: center;
    gap: 14px;
    box-shadow: 0 12px 30px rgba(92, 61, 46, 0.12);
  }

  .hp53-hero__float-icon {
    width: 42px;
    height: 42px;
    background: var(--hp53-terracotta);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #FFFFFF;
    font-size: 18px;
  }

  .hp53-hero__float-label {
    font-family: 'Cormorant Garamond', serif;
    font-size: 16px;
    font-weight: 700;
    color: var(--hp53-text);
    margin: 0;
  }

  .hp53-hero__float-sub {
    font-size: 11px;
    color: var(--hp53-terracotta);
    letter-spacing: 1px;
    text-transform: uppercase;
    margin: 2px 0 0;
  }

  @media screen and (max-width: 992px) {
    .hp53-hero__container { grid-template-columns: 1fr; text-align: center; gap: 40px; }
    .hp53-hero__desc { margin-left: auto; margin-right: auto; }
    .hp53-hero__actions { justify-content: center; }
    .hp53-hero__img-wrap { height: 380px; box-shadow: 12px 12px 0 var(--hp53-sand); }
    .hp53-hero__float-card { left: 50%; transform: translateX(-50%); bottom: -16px; }
    .hp53-hero__dune-accent { width: 300px; height: 300px; }
  }

  @media screen and (max-width: 480px) {
    .hp53-hero__img-wrap { height: 300px; }
    .hp53-hero__float-card { padding: 12px 16px; }
  }
{%- endstyle -%}

<div class="hp53-hero__dune-accent"></div>

<div class="hp53-hero__container">
  <div>
    <div class="hp53-hero__eyebrow">
      <span>◈</span>
      <span>{{ section.settings.badge | default: 'SAHARAN DUNE COLLECTION v53' }}</span>
    </div>

    <h1 class="hp53-hero__title">
      {{ section.settings.heading | default: 'Desert <em>Terracotta</em> Radiance' }}
    </h1>

    <p class="hp53-hero__desc">
      {{ section.settings.description | default: 'Infused with Saharan argan oil, red desert clay minerals, and prickly pear bio-actives for sun-kissed luminous skin.' }}
    </p>

    <div class="hp53-hero__actions">
      <a href="{{ section.settings.btn_url | default: '/collections/all' }}" class="hp53-hero__btn">
        <span>{{ section.settings.btn_text | default: 'Explore Dune Vault' }}</span>
        <span>&rarr;</span>
      </a>
    </div>
  </div>

  <div class="hp53-hero__media">
    <div class="hp53-hero__img-wrap">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 1000 }}" class="hp53-hero__img" alt="{{ section.settings.heading }}" loading="eager">
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'hp53-hero__img' }}
      {%- endif -%}

      <div class="hp53-hero__float-card">
        <div class="hp53-hero__float-icon">✦</div>
        <div>
          <p class="hp53-hero__float-label">Argan Gold Elixir</p>
          <p class="hp53-hero__float-sub">Desert Botanical Complex</p>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "HP53 - Dune Hero",
  "class": "section-hp53-hero",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#FAF5EF" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#5C3D2E" },
    { "type": "color", "id": "accent_color", "label": "Terracotta Accent", "default": "#C2703E" },
    { "type": "color", "id": "sand_color", "label": "Sand Accent", "default": "#E8D5C0" },
    { "type": "color", "id": "btn_bg", "label": "Button Background", "default": "#5C3D2E" },
    { "type": "color", "id": "btn_text_color", "label": "Button Text Color", "default": "#FAF5EF" },
    { "type": "text", "id": "badge", "label": "Badge", "default": "SAHARAN DUNE COLLECTION v53" },
    { "type": "textarea", "id": "heading", "label": "Heading (HTML allowed)", "default": "Desert <em>Terracotta</em> Radiance" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Infused with Saharan argan oil and red desert clay minerals for sun-kissed luminous skin." },
    { "type": "text", "id": "btn_text", "label": "Button Text", "default": "Explore Dune Vault" },
    { "type": "url", "id": "btn_url", "label": "Button URL" },
    { "type": "image_picker", "id": "image", "label": "Hero Image" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 100 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 100 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 },
    { "type": "color", "id": "card_bg", "label": "Card Background", "default": "#F5EDE3" }
  ],
  "presets": [
    { "name": "HP53 - Dune Hero" }
  ]
}
{% endschema %}
