<style>
@media screen and (max-width: 768px) {
  .hp53-hero {
    padding-left: 16px !important;
    padding-right: 16px !important;
    box-sizing: border-box !important;
  }
  img {
    max-width: 100% !important;
    height: auto !important;
  }
}
</style>
{%- style -%}#shopify-section-{{ section.id }}{position:relative;color:#fff}.hp53-bg{position:absolute;inset:0}.hp53-bg img{width:100%;height:100%;object-fit:cover}.hp53-bg::after{content:'';position:absolute;inset:0;background:rgba(0,0,0,.5)}.hp53-content{position:relative;max-width:1280px;margin:0 auto;padding:90px 24px;min-height:560px;display:flex;align-items:center}{%- endstyle -%}<div class="hp53-bg">{% if section.settings.image != blank %}<img src="{{section.settings.image|image_url:width:1600}}">{% else %}{{'lifestyle-1'|placeholder_svg_tag}}{% endif %}</div><div class="hp53-content"><div><h1 style="font-size:48px;font-weight:800">{{section.settings.heading|default:'Live activewear'}}</h1><p>{{section.settings.description|default:'Seamless stretch for every rep'}}</p><a href="{{section.settings.btn_url|default:'/collections/all'}}" style="background:#fff;color:#111;padding:12px 20px;text-decoration:none;font-weight:700">{{section.settings.btn_text|default:'Explore'}}</a></div></div>{% schema %}{"name":"HP53 Hero Full","settings":[{"type":"textarea","id":"heading","label":"Heading","default":"Live activewear"},{"type":"textarea","id":"description","label":"Desc","default":"Seamless stretch for every rep"},{"type":"text","id":"btn_text","label":"CTA","default":"Explore"},{"type":"url","id":"btn_url","label":"Link"},{"type":"image_picker","id":"image","label":"Image"}],"presets":[{"name":"HP53 Hero Full"}]}{% endschema %}