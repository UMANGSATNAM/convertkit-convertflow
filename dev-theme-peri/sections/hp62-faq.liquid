{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#ECFDF5' }};
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }
  .hp62-faq__container { max-width: {{ section.settings.container_width | default: 800 }}px; margin: 0 auto; padding: 0 24px; }
  .hp62-faq__header { text-align: center; margin-bottom: 50px; }
  .hp62-faq__eyebrow { font-family: 'Outfit', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: {{ section.settings.accent_color | default: '#059669' }}; margin: 0 0 12px; }
  .hp62-faq__heading { font-family: 'Italiana', serif; font-size: clamp(28px, 3.5vw, 42px); font-weight: 700; color: #064E3B; margin: 0; }
  .hp62-faq__item {
    background: {{ section.settings.card_bg | default: '#FFFFFF' }};
    border: 1px solid rgba(6, 78, 59, 0.15);
    border-radius: 16px; margin-bottom: 14px; overflow: hidden;
    box-shadow: 0 4px 20px rgba(6, 78, 59, 0.05);
    transition: border-color 0.3s ease;
  }
  .hp62-faq__item.active { border-color: #064E3B; }
  .hp62-faq__question {
    width: 100%; background: none; border: none; padding: 20px 24px;
    display: flex; justify-content: space-between; align-items: center; cursor: pointer;
    font-family: 'Italiana', serif; font-size: 19px; font-weight: 700; color: #064E3B; text-align: left;
  }
  .hp62-faq__icon { font-size: 20px; color: {{ section.settings.accent_color | default: '#059669' }}; transition: transform 0.3s ease; flex-shrink: 0; margin-left: 16px; }
  .hp62-faq__item.active .hp62-faq__icon { transform: rotate(45deg); }
  .hp62-faq__answer { max-height: 0; overflow: hidden; transition: max-height 0.35s ease; }
  .hp62-faq__item.active .hp62-faq__answer { max-height: 300px; }
  .hp62-faq__answer-inner { padding: 0 24px 20px; font-size: 14px; line-height: 1.7; color: #475569; font-family: 'Outfit', sans-serif; }
{%- endstyle -%}
<div class="hp62-faq__container">
  <div class="hp62-faq__header">
    {%- if section.settings.eyebrow != blank -%}<p class="hp62-faq__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="hp62-faq__heading">{{ section.settings.heading | default: 'Alpine Inquiries' }}</h2>
  </div>
  {%- for block in section.blocks -%}
    <div class="hp62-faq__item" {{ block.shopify_attributes }}>
      <button class="hp62-faq__question" onclick="this.parentElement.classList.toggle('active')">
        <span>{{ block.settings.question | default: 'What is Leontopodic Acid?' }}</span>
        <span class="hp62-faq__icon">+</span>
      </button>
      <div class="hp62-faq__answer">
        <div class="hp62-faq__answer-inner">{{ block.settings.answer | default: 'Leontopodic acid is a powerful natural compound synthesized by the edelweiss flower to survive high-altitude UV radiation. It exhibits twice the free radical scavenging power of Vitamin C.' }}</div>
      </div>
    </div>
  {%- endfor -%}
</div>
{% schema %}
{
  "name": "HP62 FAQ",
  "class": "section-hp62-faq",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ECFDF5" },
    { "type": "color", "id": "card_bg", "label": "Card Background", "default": "#FFFFFF" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#059669" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "🏔️ FAQ" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Alpine Inquiries" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 600, "max": 1000, "step": 20, "unit": "px", "label": "Container Width", "default": 800 }
  ],
  "blocks": [{
    "type": "faq", "name": "Question",
    "settings": [
      { "type": "text", "id": "question", "label": "Question", "default": "What is Leontopodic Acid?" },
      { "type": "textarea", "id": "answer", "label": "Answer", "default": "Leontopodic acid is a powerful natural compound synthesized by the edelweiss flower." }
    ]
  }],
  "presets": [{
    "name": "HP62 FAQ",
    "blocks": [
      { "type": "faq" },
      { "type": "faq", "settings": { "question": "Where is the glacial water sourced?", "answer": "Our glacial dew is micro-filtered from pristine natural runoff originating at the foot of the Zermatt Matterhorn glacier." } },
      { "type": "faq", "settings": { "question": "Is the alpine collection suitable for redness-prone skin?", "answer": "Yes, alpine edelweiss extract has clinical anti-inflammatory efficacy, calming erythema and capillary flushing." } }
    ]
  }]
}
{% endschema %}
