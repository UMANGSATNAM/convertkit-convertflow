{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp53-usp-bg: {{ section.settings.bg_color | default: '#FAF5EF' }};
    --hp53-card-bg: {{ section.settings.card_bg | default: '#FFFFFF' }};
    --hp53-border: {{ section.settings.border_color | default: '#E8D5C0' }};

    background-color: var(--hp53-usp-bg);
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
  }

  .hp53-usp__container {
    max-width: {{ section.settings.container_width | default: 1280 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp53-usp__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns | default: 4 }}, 1fr);
    gap: 24px;
  }

  .hp53-usp__card {
    background: var(--hp53-card-bg);
    border: 1px solid var(--hp53-border);
    border-radius: 10px;
    padding: 32px 24px;
    text-align: center;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .hp53-usp__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 30px rgba(92, 61, 46, 0.1);
  }

  .hp53-usp__icon {
    width: 52px;
    height: 52px;
    background: linear-gradient(135deg, #E8D5C0, #C2703E);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 18px;
    font-size: 22px;
    color: #FFFFFF;
  }

  .hp53-usp__title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 18px;
    font-weight: 700;
    color: {{ section.settings.title_color | default: '#5C3D2E' }};
    margin: 0 0 10px;
  }

  .hp53-usp__desc {
    font-size: 13px;
    line-height: 1.6;
    color: {{ section.settings.desc_color | default: '#8B6F5E' }};
    margin: 0;
  }

  @media screen and (max-width: 992px) {
    .hp53-usp__grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media screen and (max-width: 480px) {
    .hp53-usp__grid { grid-template-columns: 1fr; }
  }
{%- endstyle -%}

<div class="hp53-usp__container">
  <div class="hp53-usp__grid">
    {%- for block in section.blocks -%}
      <div class="hp53-usp__card" {{ block.shopify_attributes }}>
        <div class="hp53-usp__icon">{{ block.settings.icon | default: '◈' }}</div>
        <h3 class="hp53-usp__title">{{ block.settings.title | default: 'Desert Botanicals' }}</h3>
        <p class="hp53-usp__desc">{{ block.settings.description | default: 'Wild-harvested from arid landscapes for potent skin nourishment.' }}</p>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "HP53 - Dune Pillars",
  "class": "section-hp53-usp",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FAF5EF" },
    { "type": "color", "id": "card_bg", "label": "Card Background", "default": "#FFFFFF" },
    { "type": "color", "id": "border_color", "label": "Border Color", "default": "#E8D5C0" },
    { "type": "color", "id": "title_color", "label": "Title Color", "default": "#5C3D2E" },
    { "type": "color", "id": "desc_color", "label": "Description Color", "default": "#8B6F5E" },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "label": "Columns", "default": 4 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 80 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon/Emoji", "default": "◈" },
        { "type": "text", "id": "title", "label": "Title", "default": "Desert Botanicals" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Wild-harvested from arid landscapes." }
      ]
    }
  ],
  "presets": [{
    "name": "HP53 - Dune Pillars",
    "blocks": [
      { "type": "pillar", "settings": { "icon": "🌿", "title": "Argan Complex", "description": "Cold-pressed Moroccan argan oil bio-complex." } },
      { "type": "pillar", "settings": { "icon": "🏜️", "title": "Desert Clay", "description": "Red Saharan clay mineral purification." } },
      { "type": "pillar", "settings": { "icon": "✦", "title": "Prickly Pear", "description": "Cactus-derived moisture barrier repair." } },
      { "type": "pillar", "settings": { "icon": "☀️", "title": "Sun Shield", "description": "SPF-ready desert-proof UV defense." } }
    ]
  }]
}
{% endschema %}
