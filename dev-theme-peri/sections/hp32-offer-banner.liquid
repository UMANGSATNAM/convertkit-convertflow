{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Space+Mono:ital,wght@0,400;0,700;1,400;1,700&family=Syne:wght@700;800&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --border-color: #000000;
    --accent-color: {{ section.settings.accent_color }};
    
    --font-heading: 'Syne', sans-serif;
    --font-body: 'Space Mono', monospace;
    
    background-color: var(--bg-color);
    border-bottom: 4px solid var(--border-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .hp32-offer-wrapper {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp32-offer-wrapper {
      padding: 0 20px;
    }
  }

  .hp32-offer__container {
    background: var(--bg-color);
    border: 4px dashed var(--border-color);
    padding: 60px 40px;
    text-align: center;
    position: relative;
    box-shadow: 16px 16px 0 var(--border-color);
    transition: all 0.3s ease;
  }

  .hp32-offer__container:hover {
    background: #000;
    color: var(--accent-color);
    border-color: var(--accent-color);
    border-style: solid;
    box-shadow: 8px 8px 0 var(--accent-color);
  }

  .hp32-offer__container:hover .hp32-offer__title,
  .hp32-offer__container:hover .hp32-offer__text,
  .hp32-offer__container:hover .hp32-offer__code {
    color: var(--accent-color);
  }

  .hp32-offer__container:hover .hp32-offer__btn {
    background: var(--accent-color);
    color: #000;
    border-color: var(--accent-color);
    box-shadow: 4px 4px 0 #fff;
  }

  .hp32-offer__tagline {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    display: inline-block;
    background: var(--accent-color);
    color: #000;
    padding: 4px 12px;
    border: 2px solid var(--border-color);
    margin-bottom: 24px;
    box-shadow: 2px 2px 0 var(--border-color);
  }

  .hp32-offer__title {
    font-family: var(--font-heading);
    font-size: clamp(40px, 6vw, {{ section.settings.title_size }}px);
    line-height: 1;
    color: var(--text-color);
    text-transform: uppercase;
    margin: 0 0 20px;
    letter-spacing: -1px;
  }

  .hp32-offer__text {
    font-family: var(--font-body);
    font-size: 18px;
    color: var(--text-color);
    margin: 0 0 30px;
    font-weight: 700;
  }

  .hp32-offer__code {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 24px;
    font-weight: 700;
    color: var(--text-color);
    border: 2px solid currentColor;
    padding: 10px 20px;
    margin-bottom: 30px;
    letter-spacing: 2px;
  }

  .hp32-offer__btn {
    display: inline-block;
    background: #000;
    color: var(--accent-color);
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 700;
    text-transform: uppercase;
    text-decoration: none;
    padding: 15px 30px;
    border: 3px solid #000;
    box-shadow: 6px 6px 0 var(--border-color);
    transition: all 0.1s ease;
  }

  .hp32-offer__btn:active {
    transform: translate(4px, 4px);
    box-shadow: 2px 2px 0 var(--border-color);
  }

  /* Decorative corners */
  .hp32-offer__corner {
    position: absolute;
    width: 20px;
    height: 20px;
    border: 4px solid var(--border-color);
  }

  .hp32-offer__container:hover .hp32-offer__corner {
    border-color: var(--accent-color);
  }

  .hp32-offer__corner--tl { top: -4px; left: -4px; border-right: none; border-bottom: none; }
  .hp32-offer__corner--tr { top: -4px; right: -4px; border-left: none; border-bottom: none; }
  .hp32-offer__corner--bl { bottom: -4px; left: -4px; border-right: none; border-top: none; }
  .hp32-offer__corner--br { bottom: -4px; right: -4px; border-left: none; border-top: none; }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp32-offer-wrapper" id="HP32Offer-{{ section.id }}">
  <div class="hp32-offer__container">
    <div class="hp32-offer__corner hp32-offer__corner--tl"></div>
    <div class="hp32-offer__corner hp32-offer__corner--tr"></div>
    <div class="hp32-offer__corner hp32-offer__corner--bl"></div>
    <div class="hp32-offer__corner hp32-offer__corner--br"></div>

    {%- if section.settings.tagline != blank -%}
      <div class="hp32-offer__tagline">{{ section.settings.tagline }}</div>
    {%- endif -%}
    
    <h2 class="hp32-offer__title">{{ section.settings.title }}</h2>
    <p class="hp32-offer__text">{{ section.settings.text }}</p>
    
    {%- if section.settings.code != blank -%}
      <div class="hp32-offer__code">{{ section.settings.code }}</div><br>
    {%- endif -%}
    
    {%- if section.settings.btn_label != blank -%}
      <a href="{{ section.settings.btn_link | default: '#' }}" class="hp32-offer__btn">
        {{ section.settings.btn_label }}
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP32 - Brutalist Offer",
  "class": "section-hp32-offer-banner",
  "settings": [
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "SYSTEM ALERT"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Heading",
      "default": "CRITICAL DISCOUNT DETECTED"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "USE CODE AT CHECKOUT TO INITIATE 20% PRICE REDUCTION."
    },
    {
      "type": "text",
      "id": "code",
      "label": "Discount Code",
      "default": "OVERRIDE20"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "APPLY PROTOCOL"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 64
    },
    {
      "type": "header",
      "content": "Brutalist Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (e.g. Light Grey)",
      "default": "#f4f4f4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color (e.g. Lime)",
      "default": "#ccff00"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 100
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP32 - Brutalist Offer"
    }
  ]
}
{% endschema %}
