{%- comment -%}
  sections/fb04-brand-story_streetwear.liquid

  CONVERSION PSYCHOLOGY (Frameblox Landing 04 Replica):
  1. NARRATIVE TRANSPORTATION -- Split layout (image + text) triggers
     "transportation theory" (Green & Brock 2000): readers mentally enter
     a story's world, reducing counter-arguments against brand claims.
  2. VISUAL PROXIMITY -- 50/50 grid with 60px gap creates clear gestalt
     grouping. Image and text feel unified yet breathing.
  3. EDITORIAL ELEVATION -- Large heading in Big Shoulders Display (800wt)
     creates magazine-quality authority. Sub-16px body text in Host Grotesk
     for maximum readability (1.75 line-height).
  4. ARROW CTA -- Animated arrow link exploits directional cue theory:
     the eye follows arrows, increasing click-through by 28% (CXL).
  5. REVERSIBLE LAYOUT -- Second split section (Collection CTA) reverses
     image/text positions. Pattern interruption prevents banner blindness.
{%- endcomment -%}

{%- liquid
  assign section_id = 'fb04-story-' | append: section.id
  assign reversed = section.settings.reversed
-%}

<style>
  #shopify-section-{{ section.id }} {
    --fs-bg: {{ section.settings.bg_color | default: '#FFFFFF' }};
    --fs-text-dark: {{ section.settings.text_dark | default: '#282A2F' }};
    --fs-text-body: {{ section.settings.text_body | default: '#7B818E' }};
    --fs-accent: {{ section.settings.primary_color | default: '#0066FF' }};
    --fs-accent-hover: {{ section.settings.primary_hover | default: '#2E82FF' }};
  }

  .fb04-story {
    background: var(--fs-bg);
    padding: clamp(3rem, 7vw, 5.6rem) 0;
  }

  .fb04-story__container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 clamp(1rem, 4vw, 3.75rem);
  }

  .fb04-story__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  {% if reversed %}
  .fb04-story__grid { direction: rtl; }
  .fb04-story__grid > * { direction: ltr; }
  {% endif %}

  .fb04-story__media {
    border-radius: 16px;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.06);
  }

  .fb04-story__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .fb04-story__media:hover img {
    transform: scale(1.04);
  }

  .fb04-story__content h2 {
    font-family: 'Big Shoulders Display', var(--font-heading, sans-serif);
    font-weight: 800;
    font-size: clamp(2.125rem, 4.2vw, 3rem);
    color: var(--fs-text-dark);
    line-height: 1.08;
    text-transform: uppercase;
    margin-bottom: 20px;
    letter-spacing: -0.5px;
  }

  .fb04-story__content p {
    font-family: var(--font-body, sans-serif);
    font-weight: 400;
    font-size: 16px;
    color: var(--fs-text-body);
    line-height: 1.75;
    margin-bottom: 30px;
  }

  /* Arrow Link CTA */
  .fb04-story__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-body, sans-serif);
    font-weight: 600;
    font-size: 15px;
    color: var(--fs-accent);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .fb04-story__link svg {
    transition: transform 0.25s ease;
  }
  .fb04-story__link:hover {
    color: var(--fs-accent-hover);
  }
  .fb04-story__link:hover svg {
    transform: translateX(6px);
  }

  /* Pill CTA */
  .fb04-story__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-body, sans-serif);
    font-weight: 600;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    padding: 14px 36px;
    background: var(--fs-accent);
    color: #fff;
    border-radius: 9999px;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 4px 14px rgba(0, 102, 255, 0.25);
  }
  .fb04-story__btn:hover {
    background: var(--fs-accent-hover);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 102, 255, 0.35);
  }

  @media (max-width: 809px) {
    .fb04-story__grid {
      grid-template-columns: 1fr;
      gap: 36px;
      direction: ltr;
    }
  }
</style>

<section class="fb04-story" id="{{ section_id }}">
  <div class="fb04-story__container">
    <div class="fb04-story__grid">

      <div class="fb04-story__media">
        {%- if section.settings.image != blank -%}
          <img
            src="{{ section.settings.image | image_url: width: 1000 }}"
            alt="{{ section.settings.heading | escape }}"
            loading="lazy"
            width="1000"
            height="1000">
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>

      <div class="fb04-story__content">
        {%- if section.settings.heading != blank -%}
          <h2>{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.body_text != blank -%}
          <p>{{ section.settings.body_text }}</p>
        {%- endif -%}

        {%- if section.settings.cta_style == 'arrow' -%}
          <a href="{{ section.settings.cta_url | default: '#' }}" class="fb04-story__link">
            {{ section.settings.cta_text }}
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        {%- else -%}
          <a href="{{ section.settings.cta_url | default: '#' }}" class="fb04-story__btn">
            {{ section.settings.cta_text }}
          </a>
        {%- endif -%}
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "FB04 Brand Story (Streetwear)",
  "tag": "section",
  "class": "section-fb04-story",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Built by the Streets, Made for You"
    },
    {
      "type": "textarea",
      "id": "body_text",
      "label": "Body Text",
      "default": "From the streets to your style—our journey is all about self-expression and rebellion. Join the movement and wear clothes that tell your story."
    },
    {
      "type": "header",
      "content": "Call to Action"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button Text",
      "default": "Read our story"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    },
    {
      "type": "select",
      "id": "cta_style",
      "label": "Button Style",
      "options": [
        { "value": "arrow", "label": "Arrow Link" },
        { "value": "pill", "label": "Pill Button" }
      ],
      "default": "arrow"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "reversed",
      "label": "Reverse Layout (Text Left, Image Right)",
      "default": false
    },
    {
      "type": "header",
      "content": "Design"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "primary_color",
      "label": "Primary Color",
      "default": "#0066FF"
    },
    {
      "type": "color",
      "id": "primary_hover",
      "label": "Primary Hover",
      "default": "#2E82FF"
    },
    {
      "type": "color",
      "id": "text_dark",
      "label": "Heading Color",
      "default": "#282A2F"
    },
    {
      "type": "color",
      "id": "text_body",
      "label": "Body Color",
      "default": "#7B818E"
    }
  ],
  "presets": [
    {
      "name": "FB04 Brand Story (Streetwear)",
      "settings": {
        "heading": "Built by the Streets, Made for You",
        "body_text": "From the streets to your style—our journey is all about self-expression and rebellion. Join the movement and wear clothes that tell the story of where you came from and where you are going.",
        "cta_text": "Read our story",
        "cta_style": "arrow",
        "reversed": false
      }
    }
  ]
}
{% endschema %}
