{%- style -%}
  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --btn-bg: {{ section.settings.btn_bg }};
    --btn-text: {{ section.settings.btn_text_color }};
    --font-heading: 'Lora', serif;
    --font-body: 'Outfit', sans-serif;
    
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }

  .hp22-offer-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp22-offer-wrapper {
      padding: 0 20px;
    }
  }

  .hp22-offer__container {
    background-color: var(--bg-color);
    {% if section.settings.box_shape == 'pill' %}
      border-radius: 100px;
    {% elsif section.settings.box_shape == 'soft' %}
      border-radius: 24px;
    {% else %}
      border-radius: 0;
    {% endif %}
    padding: {{ section.settings.inner_padding }}px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
    position: relative;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0,0,0,0.05);
  }

  @media screen and (max-width: 992px) {
    .hp22-offer__container {
      flex-direction: column;
      text-align: center;
      padding: {{ section.settings.inner_padding | times: 0.75 | round }}px 20px;
      {% if section.settings.box_shape == 'pill' %}
        border-radius: 40px; /* soften pill on mobile */
      {% endif %}
    }
  }

  /* Organic grain texture overlay inside banner */
  {% if section.settings.show_grain %}
  .hp22-offer__container::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    opacity: 0.06;
    pointer-events: none;
    z-index: 1;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
  }
  {% endif %}

  /* Abstract Organic Shapes */
  .hp22-offer__deco-shape-1 {
    position: absolute;
    top: -50%;
    left: -10%;
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, rgba(255,255,255,0.2) 0%, rgba(255,255,255,0) 70%);
    border-radius: 50%;
    z-index: 0;
  }
  
  .hp22-offer__deco-shape-2 {
    position: absolute;
    bottom: -30%;
    right: -5%;
    width: 250px;
    height: 250px;
    background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, rgba(255,255,255,0) 70%);
    border-radius: 50%;
    z-index: 0;
  }

  .hp22-offer__content {
    position: relative;
    z-index: 2;
    flex: 1;
    max-width: 600px;
  }

  @media screen and (max-width: 992px) {
    .hp22-offer__content {
      max-width: 100%;
    }
  }

  .hp22-offer__subtitle {
    font-family: var(--font-body);
    font-size: {{ section.settings.subtitle_size }}px;
    font-weight: 400;
    letter-spacing: 3px;
    color: var(--text-color);
    opacity: 0.9;
    text-transform: uppercase;
    margin: 0 0 12px;
  }

  .hp22-offer__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    font-weight: 400;
    color: var(--text-color);
    margin: 0 0 16px;
    line-height: 1.1;
  }
  
  .hp22-offer__title em {
    font-style: italic;
    font-weight: 300;
  }

  .hp22-offer__text {
    font-family: var(--font-body);
    font-size: {{ section.settings.text_size }}px;
    font-weight: 300;
    color: var(--text-color);
    opacity: 0.8;
    margin: 0;
    line-height: 1.5;
  }

  .hp22-offer__action {
    position: relative;
    z-index: 2;
    flex-shrink: 0;
  }

  .hp22-offer__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 40px;
    background: var(--btn-bg);
    color: var(--btn-text);
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 15px;
    letter-spacing: 1px;
    text-decoration: none;
    border-radius: 40px;
    transition: all 0.3s ease;
    border: 1px solid var(--btn-bg);
  }

  .hp22-offer__btn:hover {
    background: transparent;
    color: var(--text-color);
    border-color: var(--text-color);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp22-offer-wrapper" id="HP22OfferBanner-{{ section.id }}">
  <div class="hp22-offer__container">
    
    <div class="hp22-offer__deco-shape-1"></div>
    <div class="hp22-offer__deco-shape-2"></div>
    
    <div class="hp22-offer__content">
      {%- if section.settings.subtitle != blank -%}
        <div class="hp22-offer__subtitle">{{ section.settings.subtitle | escape }}</div>
      {%- endif -%}
      
      {%- if section.settings.title != blank -%}
        <h2 class="hp22-offer__title">{{ section.settings.title }}</h2>
      {%- endif -%}
      
      {%- if section.settings.text != blank -%}
        <div class="hp22-offer__text">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    <div class="hp22-offer__action">
      {%- if section.settings.btn_text != blank -%}
        <a href="{{ section.settings.btn_link | default: '#' }}" class="hp22-offer__btn">
          {{ section.settings.btn_text | escape }}
        </a>
      {%- endif -%}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "HP22 - Organic Offer",
  "class": "section-hp22-offer-banner",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "SPECIAL HARVEST"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Heading",
      "default": "<p>Enjoy <em>20% Off</em> Your First Ritual</p>"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Body Text",
      "default": "Embrace the power of nature with our organic essentials."
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "REDEEM NOW"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 800,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1200
    },
    {
      "type": "range",
      "id": "inner_padding",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Inner Padding",
      "default": 60
    },
    {
      "type": "select",
      "id": "box_shape",
      "label": "Banner Shape",
      "options": [
        { "value": "pill", "label": "Pill (Fully Rounded)" },
        { "value": "soft", "label": "Soft Corners" },
        { "value": "square", "label": "Square" }
      ],
      "default": "pill"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 42
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Subtitle Size",
      "default": 14
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Text Size",
      "default": 18
    },
    {
      "type": "header",
      "content": "Organic Styling"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Banner Background Color",
      "default": "#8A9A86"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "btn_bg",
      "label": "Button Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Button Text Color",
      "default": "#8A9A86"
    },
    {
      "type": "checkbox",
      "id": "show_grain",
      "label": "Show subtle paper grain texture inside banner",
      "default": true
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Outer Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Outer Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP22 - Organic Offer"
    }
  ]
}
{% endschema %}
