{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#8A9A86'
  assign text_color = section.settings.text_color | default: '#F9F6F0'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    color: {{ text_color }};
  }
  
  .hp10-announcement-container-{{ section_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 10px 20px;
    min-height: 40px;
    text-align: center;
  }
  
  .hp10-announcement-text-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 1px;
    margin: 0;
  }
  
  .hp10-announcement-text-{{ section_id }} a {
    color: {{ text_color }};
    text-decoration: underline;
    text-underline-offset: 4px;
    font-weight: 600;
  }

@media screen and (max-width: 768px) {
  .hp10-announcement-bar {
    padding-left: 16px !important;
    padding-right: 16px !important;
    box-sizing: border-box !important;
  }
  img {
    max-width: 100% !important;
    height: auto !important;
  }
}

</style>

<div class="hp10-announcement-container-{{ section_id }}">
  <p class="hp10-announcement-text-{{ section_id }}">
    {{ section.settings.text | default: 'Free shipping on all organic orders over $50' }}
    {% if section.settings.link != blank %}
      <a href="{{ section.settings.link }}">Shop Now</a>
    {% endif %}
  </p>
</div>

{% schema %}
{
  "name": "HP10 Announcement Bar",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#8A9A86"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#F9F6F0"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Announcement Text",
      "default": "Free shipping on all organic orders over $50"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link (Optional)"
    }
  ],
  "presets": [
    {
      "name": "HP10 Announcement Bar"
    }
  ]
}
{% endschema %}
