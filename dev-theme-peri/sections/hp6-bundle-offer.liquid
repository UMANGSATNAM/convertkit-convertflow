{%- liquid
  assign bg_color = section.settings.bg_color | default: '#050505'
  assign text_color = section.settings.text_color | default: '#ffffff'
  assign accent_color = section.settings.accent_color | default: '#ff4500'
  
  assign padding_top_desktop = section.settings.padding_top_desktop
  assign padding_bottom_desktop = section.settings.padding_bottom_desktop
  assign padding_top_mobile = section.settings.padding_top_mobile
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile
-%}

<style>
  #shopify-section-{{ section.id }} {
    --hp6-bo-bg: {{ bg_color }};
    --hp6-bo-text: {{ text_color }};
    --hp6-bo-accent: {{ accent_color }};
    
    --hp6-bo-pt-desk: {{ padding_top_desktop }}px;
    --hp6-bo-pb-desk: {{ padding_bottom_desktop }}px;
    --hp6-bo-pt-mob: {{ padding_top_mobile }}px;
    --hp6-bo-pb-mob: {{ padding_bottom_mobile }}px;
  }

  .hp6-sports-bo-{{ section.id }} {
    padding-top: var(--hp6-bo-pt-desk);
    padding-bottom: var(--hp6-bo-pb-desk);
    background-color: var(--hp6-bo-bg);
    color: var(--hp6-bo-text);
  }

  .hp6-bo-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .hp6-bo-header {
    text-align: center;
    margin-bottom: 50px;
  }
  .hp6-bo-title {
    font-family: 'Oswald', sans-serif;
    font-size: clamp(32px, 5vw, 56px);
    font-weight: 700;
    text-transform: uppercase;
    margin: 0 0 15px 0;
    letter-spacing: -1px;
  }
  .hp6-bo-title span {
    color: var(--hp6-bo-accent);
  }
  .hp6-bo-desc {
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    color: rgba(255,255,255,0.6);
    max-width: 600px;
    margin: 0 auto;
  }

  .hp6-bo-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
  }

  .hp6-bo-item {
    background: #111111;
    border: 1px solid rgba(255,255,255,0.05);
    padding: 40px;
    position: relative;
    clip-path: polygon(10% 0, 100% 0, 90% 100%, 0% 100%);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    transition: transform 0.4s ease, border-color 0.4s ease;
  }
  .hp6-bo-item:hover {
    transform: translateY(-10px);
    border-color: var(--hp6-bo-accent);
  }
  .hp6-bo-item.popular {
    background: #1a1a1a;
    border-color: var(--hp6-bo-accent);
  }

  .hp6-bo-popular-badge {
    position: absolute;
    top: 20px;
    background: var(--hp6-bo-accent);
    color: #fff;
    padding: 5px 15px;
    font-family: 'Oswald', sans-serif;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    clip-path: polygon(10% 0, 100% 0, 90% 100%, 0% 100%);
  }

  .hp6-bo-img {
    width: 150px; height: 150px;
    object-fit: contain;
    margin-bottom: 25px;
    margin-top: 15px;
  }

  .hp6-bo-name {
    font-family: 'Oswald', sans-serif;
    font-size: 24px;
    font-weight: 700;
    text-transform: uppercase;
    margin: 0 0 10px 0;
  }

  .hp6-bo-price {
    font-family: 'Inter', sans-serif;
    font-size: 20px;
    font-weight: 700;
    color: var(--hp6-bo-accent);
    margin-bottom: 20px;
  }
  .hp6-bo-compare {
    text-decoration: line-through;
    color: rgba(255,255,255,0.4);
    font-size: 14px;
    margin-left: 10px;
  }

  .hp6-bo-list {
    list-style: none;
    padding: 0; margin: 0 0 30px 0;
    width: 100%;
    text-align: left;
  }
  .hp6-bo-list li {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    color: rgba(255,255,255,0.8);
    padding: 8px 0;
    border-bottom: 1px solid rgba(255,255,255,0.1);
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .hp6-bo-list li:last-child { border-bottom: none; }
  .hp6-bo-list li svg { width: 16px; height: 16px; fill: var(--hp6-bo-accent); }

  .hp6-bo-btn {
    background: transparent;
    border: 2px solid var(--hp6-bo-text);
    color: var(--hp6-bo-text);
    padding: 12px 30px;
    font-family: 'Oswald', sans-serif;
    font-size: 16px;
    font-weight: 700;
    text-transform: uppercase;
    text-decoration: none;
    clip-path: polygon(10% 0, 100% 0, 90% 100%, 0% 100%);
    transition: all 0.3s ease;
    width: 100%;
    margin-top: auto;
  }
  .hp6-bo-item.popular .hp6-bo-btn, .hp6-bo-btn:hover {
    background: var(--hp6-bo-accent);
    border-color: var(--hp6-bo-accent);
    color: #fff;
  }

  @media screen and (max-width: 1024px) {
    .hp6-bo-grid { grid-template-columns: 1fr; max-width: 500px; margin: 0 auto; }
    .hp6-bo-item { clip-path: none; border-radius: 8px; }
    .hp6-bo-popular-badge { clip-path: none; border-radius: 4px; }
    .hp6-bo-btn { clip-path: none; border-radius: 4px; }
  }
  @media screen and (max-width: 768px) {
    .hp6-sports-bo-{{ section.id }} {
      padding-top: var(--hp6-bo-pt-mob);
      padding-bottom: var(--hp6-bo-pb-mob);
    }
    .hp6-bo-inner { padding: 0 20px; }
  }
</style>

<section class="hp6-sports-bo-{{ section.id }}" aria-label="Bundles">
  <div class="hp6-bo-inner">
    
    <div class="hp6-bo-header">
      <h2 class="hp6-bo-title">{{ section.settings.heading | replace: 'HIGHLIGHT WORD', '<span>HIGHLIGHT WORD</span>' }}</h2>
      <p class="hp6-bo-desc">{{ section.settings.subheading }}</p>
    </div>

    <div class="hp6-bo-grid">
      {%- for block in section.blocks limit: 3 -%}
        <div class="hp6-bo-item {% if block.settings.is_popular %}popular{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.is_popular -%}
            <span class="hp6-bo-popular-badge">Most Popular</span>
          {%- endif -%}
          
          {%- if block.settings.image != blank -%}
            <img height="{{ block.settings.image.height }}" width="{{ block.settings.image.width }}" src="{{ block.settings.image | image_url: width: 300 }}" class="hp6-bo-img" loading="lazy" alt="{{ block.settings.title }}">
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'hp6-bo-img placeholder-svg' }}
          {%- endif -%}

          <h3 class="hp6-bo-name">{{ block.settings.title }}</h3>
          <div class="hp6-bo-price">
            {{ block.settings.price }}
            {%- if block.settings.compare_price != blank -%}
              <span class="hp6-bo-compare">{{ block.settings.compare_price }}</span>
            {%- endif -%}
          </div>

          <ul class="hp6-bo-list">
            {%- assign items = block.settings.list_items | split: ',' -%}
            {%- for item in items -%}
              <li>
                <svg viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                {{ item | strip }}
              </li>
            {%- endfor -%}
          </ul>

          <a href="{{ block.settings.btn_link }}" class="hp6-bo-btn">{{ block.settings.btn_text | default: 'Add to Cart' }}</a>
        </div>
      {%- endfor -%}

      {%- if section.blocks.size == 0 -%}
        {%- for i in (1..3) -%}
          <div class="hp6-bo-item {% if i == 2 %}popular{% endif %}">
            {%- if i == 2 -%}<span class="hp6-bo-popular-badge">Most Popular</span>{%- endif -%}
            {{ 'product-' | append: i | placeholder_svg_tag: 'hp6-bo-img placeholder-svg' }}
            <h3 class="hp6-bo-name">Starter Pack</h3>
            <div class="hp6-bo-price">$89.99 <span class="hp6-bo-compare">$120.00</span></div>
            <ul class="hp6-bo-list">
              <li><svg viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg> Performance Tee</li>
              <li><svg viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg> Training Shorts</li>
              <li><svg viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg> Premium Socks</li>
            </ul>
            <a href="#" class="hp6-bo-btn">Add to Cart</a>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "HP6 Sports Bundles",
  "tag": "section",
  "class": "section-hp6-bundle",
  "max_blocks": 3,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "UPGRADE YOUR <span>ARSENAL</span>"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Bundle your gear and save up to 25% on pro-level equipment."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#050505"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#ff4500"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Top (Desktop)", "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Bottom (Desktop)", "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Top (Mobile)", "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Bottom (Mobile)", "default": 50
    }
  ],
  "blocks": [
    {
      "type": "bundle",
      "name": "Bundle",
      "settings": [
        {
          "type": "checkbox",
          "id": "is_popular",
          "label": "Highlight as Popular",
          "default": false
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Bundle Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Starter Pack"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price String",
          "default": "$89.99"
        },
        {
          "type": "text",
          "id": "compare_price",
          "label": "Compare Price String",
          "default": "$120.00"
        },
        {
          "type": "textarea",
          "id": "list_items",
          "label": "Included Items (Comma separated)",
          "default": "Performance Tee, Training Shorts, Premium Socks"
        },
        {
          "type": "text",
          "id": "btn_text",
          "label": "Button Text",
          "default": "Add to Cart"
        },
        {
          "type": "url",
          "id": "btn_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP6 Sports Bundles",
      "category": "Product",
      "blocks": [
        { "type": "bundle", "settings": { "title": "Starter Pack" } },
        { "type": "bundle", "settings": { "title": "Pro Pack", "is_popular": true } },
        { "type": "bundle", "settings": { "title": "Elite Pack" } }
      ]
    }
  ]
}
{% endschema %}
