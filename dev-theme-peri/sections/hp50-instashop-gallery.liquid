{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp50-insta-bg: {{ section.settings.bg_color | default: '#000000' }};
    
    background-color: var(--hp50-insta-bg);
    padding-top: {{ section.settings.padding_top | default: 70 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 70 }}px;
  }

  .hp50-insta__wrap {
    max-width: {{ section.settings.container_width | default: 1240 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp50-insta__header {
    text-align: center;
    margin-bottom: 40px;
  }

  .hp50-insta__sub {
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: #94A3B8;
    margin: 0 0 8px;
  }

  .hp50-insta__heading {
    font-family: 'Italiana', serif;
    font-size: clamp(30px, 4vw, 42px);
    font-weight: 400;
    color: #FFFFFF;
    margin: 0;
    letter-spacing: 1px;
  }

  .hp50-insta__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: 4 }}, 1fr);
    gap: 18px;
  }

  .hp50-insta__item {
    aspect-ratio: 1;
    overflow: hidden;
    position: relative;
    border: 1px solid rgba(226, 232, 240, 0.2);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
  }

  .hp50-insta__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: grayscale(40%) contrast(1.1);
    transition: transform 0.4s ease;
  }

  .hp50-insta__item:hover .hp50-insta__img { transform: scale(1.06); filter: grayscale(0%); }

  .hp50-insta__tag {
    position: absolute;
    bottom: 12px; left: 12px;
    background: #000000;
    border: 1px solid #FFFFFF;
    color: #FFFFFF;
    font-family: 'Syne', sans-serif;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 5px 12px;
  }

  @media screen and (max-width: 992px) {
    .hp50-insta__grid { grid-template-columns: repeat(2, 1fr); }
  }
{%- endstyle -%}

<div class="hp50-insta__wrap">
  <div class="hp50-insta__header">
    <p class="hp50-insta__sub">{{ section.settings.subheading | default: '@PERI_RUNWAY' }}</p>
    <h2 class="hp50-insta__heading">{{ section.settings.heading | default: 'Shop The Runway Lookbook' }}</h2>
  </div>

  <div class="hp50-insta__grid">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <div class="hp50-insta__item" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img height="{{ block.settings.image.height }}" width="{{ block.settings.image.width }}" src="{{ block.settings.image | image_url: width: 600 }}" class="hp50-insta__img" alt="{{ block.settings.tag }}" loading="lazy">
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'hp50-insta__img' }}
          {%- endif -%}
          <span class="hp50-insta__tag">{{ block.settings.tag | default: 'Shop Platinum Elixir' }}</span>
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="hp50-insta__item">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'hp50-insta__img' }}
        <span class="hp50-insta__tag">Shop Platinum Elixir</span>
      </div>
      <div class="hp50-insta__item">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'hp50-insta__img' }}
        <span class="hp50-insta__tag">Shop Noir Crème</span>
      </div>
      <div class="hp50-insta__item">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'hp50-insta__img' }}
        <span class="hp50-insta__tag">Shop Silver Mist</span>
      </div>
      <div class="hp50-insta__item">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'hp50-insta__img' }}
        <span class="hp50-insta__tag">Shop Peel Mask</span>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP50 - Runway Lookbook",
  "class": "section-hp50-lookbook",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#000000" },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "label": "Desktop Columns", "default": 4 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 70 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 70 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1240 }
  ],
  "blocks": [
    {
      "type": "gallery_item",
      "name": "Lookbook Item",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "tag", "label": "Tag", "default": "Shop Platinum Elixir" }
      ]
    }
  ],
  "presets": [
    { "name": "HP50 - Runway Lookbook" }
  ]
}
{% endschema %}
