{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp45-vid-bg: {{ section.settings.bg_color | default: '#F5F5F0' }};
    --hp45-border: {{ section.settings.border_color | default: '#0A0A0A' }};
    
    background-color: var(--hp45-vid-bg);
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
  }

  .hp45-video__box {
    max-width: {{ section.settings.container_width | default: 1300 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp45-video__frame {
    width: 100%;
    height: {{ section.settings.video_height | default: 480 }}px;
    background: #0A0A0A;
    border: 2px solid var(--hp45-border);
    box-shadow: 6px 6px 0 var(--hp45-border);
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hp45-video__poster {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: grayscale(100%);
  }

  .hp45-video__play-btn {
    position: absolute;
    width: 80px;
    height: 80px;
    background: #FFFFFF;
    color: #0A0A0A;
    border: 2px solid #0A0A0A;
    box-shadow: 4px 4px 0 #0A0A0A;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .hp45-video__play-btn:hover {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0 #0A0A0A;
  }

  @media screen and (max-width: 768px) {
    .hp45-video__frame { height: 320px; }
  }
{%- endstyle -%}

<div class="hp45-video__box">
  <div class="hp45-video__frame">
    {%- if section.settings.poster_image != blank -%}
      <img height="{{ section.settings.poster_image.height }}" width="{{ section.settings.poster_image.width }}" src="{{ section.settings.poster_image | image_url: width: 1400 }}" class="hp45-video__poster" alt="Video Frame" loading="lazy">
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'hp45-video__poster' }}
    {%- endif -%}
    <div class="hp45-video__play-btn" onclick="alert('Initiating Cleanroom Molecular Video Stream');">▶</div>
  </div>
</div>

{% schema %}
{
  "name": "HP45 - Brutal Video",
  "class": "section-hp45-video",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#F5F5F0" },
    { "type": "color", "id": "border_color", "label": "Border Color", "default": "#0A0A0A" },
    { "type": "image_picker", "id": "poster_image", "label": "Poster Image" },
    { "type": "range", "id": "video_height", "min": 300, "max": 700, "step": 20, "unit": "px", "label": "Video Height", "default": 480 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 80 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1300 }
  ],
  "presets": [
    { "name": "HP45 - Brutal Video" }
  ]
}
{% endschema %}
