{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#050505'
  assign text_color = section.settings.text_color | default: '#00FFA3'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 100px 40px;
    border-bottom: 1px solid #333;
    overflow: hidden;
  }
  
  .hp13-testimonial-container-{{ section_id }} {
    max-width: 1000px;
    margin: 0 auto;
    position: relative;
    border-left: 5px solid {{ text_color }};
    padding-left: 40px;
  }
  
  .hp13-testimonial-sys-{{ section_id }} {
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.8rem;
    color: #666;
    margin-bottom: 20px;
  }
  
  .hp13-testimonial-quote-{{ section_id }} {
    font-family: 'Courier New', Courier, monospace;
    font-size: clamp(1.2rem, 3vw, 2rem);
    font-weight: bold;
    line-height: 1.5;
    color: #FFF;
    margin: 0 0 30px 0;
    text-transform: uppercase;
  }
  
  .hp13-testimonial-author-{{ section_id }} {
    font-family: 'Courier New', Courier, monospace;
    font-size: 1rem;
    font-weight: bold;
    color: {{ text_color }};
    text-transform: uppercase;
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 60px 20px;
    }
    .hp13-testimonial-container-{{ section_id }} {
      padding-left: 20px;
      border-width: 3px;
    }
  }
</style>

<div class="hp13-testimonial-container-{{ section_id }}">
  <div class="hp13-testimonial-sys-{{ section_id }}">USER_LOG: {{ 'now' | date: "%Y%m%d" }}</div>
  
  <blockquote class="hp13-testimonial-quote-{{ section_id }}">
    "{{ section.settings.quote | default: 'FLAWLESS EXECUTION. THE GEAR WITHSTOOD EXTREME CONDITIONS IN SECTOR 7. WILL BE DEPLOYING AGAIN WITH THIS LOADOUT.' }}"
  </blockquote>
  
  <div class="hp13-testimonial-author-{{ section_id }}">
    > ID: {{ section.settings.author | default: 'OPERATIVE_X99' }}
  </div>
</div>

{% schema %}
{
  "name": "HP13 Testimonial",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#050505"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Highlight Color",
      "default": "#00FFA3"
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Quote",
      "default": "FLAWLESS EXECUTION. THE GEAR WITHSTOOD EXTREME CONDITIONS IN SECTOR 7. WILL BE DEPLOYING AGAIN WITH THIS LOADOUT."
    },
    {
      "type": "text",
      "id": "author",
      "label": "Author",
      "default": "OPERATIVE_X99"
    }
  ],
  "presets": [
    {
      "name": "HP13 Testimonial"
    }
  ]
}
{% endschema %}
