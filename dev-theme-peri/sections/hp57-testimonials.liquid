{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#0F291E' }};
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }
  .hp57-test__container { max-width: {{ section.settings.container_width | default: 1280 }}px; margin: 0 auto; padding: 0 24px; }
  .hp57-test__header { text-align: center; margin-bottom: 50px; }
  .hp57-test__eyebrow { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: #D97706; margin: 0 0 12px; }
  .hp57-test__heading { font-family: 'Cormorant Garamond', serif; font-size: clamp(28px, 3.5vw, 42px); font-weight: 700; color: #FFFFFF; margin: 0; }
  .hp57-test__grid { display: grid; grid-template-columns: repeat({{ section.settings.columns | default: 3 }}, 1fr); gap: 20px; }
  .hp57-test__card { background: #1B4332; border: 1px solid rgba(167, 243, 208, 0.15); border-radius: 12px; padding: 32px 24px; }
  .hp57-test__stars { color: #D97706; font-size: 16px; margin-bottom: 16px; letter-spacing: 2px; }
  .hp57-test__quote { font-family: 'Cormorant Garamond', serif; font-size: 17px; font-style: italic; line-height: 1.6; color: #F4F6F0; margin: 0 0 20px; }
  .hp57-test__author { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 13px; font-weight: 700; color: #FFFFFF; margin: 0; }
  .hp57-test__role { font-size: 11px; color: #A7F3D0; margin: 4px 0 0; letter-spacing: 1px; text-transform: uppercase; }
  @media screen and (max-width: 992px) { .hp57-test__grid { grid-template-columns: 1fr; max-width: 600px; margin: 0 auto; } }
{%- endstyle -%}
<div class="hp57-test__container">
  <div class="hp57-test__header">
    {%- if section.settings.eyebrow != blank -%}<p class="hp57-test__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="hp57-test__heading">{{ section.settings.heading | default: 'Botanist Testimonials' }}</h2>
  </div>
  <div class="hp57-test__grid">
    {%- for block in section.blocks -%}
      <div class="hp57-test__card" {{ block.shopify_attributes }}>
        <div class="hp57-test__stars">{{ block.settings.stars | default: '★★★★★' }}</div>
        <p class="hp57-test__quote">"{{ block.settings.quote | default: 'The Forest Fern Elixir resolved my sensitized redness overnight.' }}"</p>
        <p class="hp57-test__author">{{ block.settings.author | default: 'Dr. Clara Thorne' }}</p>
        <p class="hp57-test__role">{{ block.settings.role | default: 'Herbal Medicine Practitioner' }}</p>
      </div>
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "HP57 Reviews",
  "class": "section-hp57-test",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#0F291E" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "🌿 TESTIMONIALS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Botanist Testimonials" },
    { "type": "range", "id": "columns", "min": 1, "max": 3, "step": 1, "label": "Columns", "default": 3 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "blocks": [{ "type": "testimonial", "name": "Review", "settings": [
    { "type": "text", "id": "stars", "label": "Stars", "default": "★★★★★" },
    { "type": "textarea", "id": "quote", "label": "Quote", "default": "The Forest Fern Elixir resolved my redness overnight." },
    { "type": "text", "id": "author", "label": "Author", "default": "Dr. Clara Thorne" },
    { "type": "text", "id": "role", "label": "Role", "default": "Herbal Medicine Practitioner" }
  ]}],
  "presets": [{ "name": "HP57 Reviews", "blocks": [
    { "type": "testimonial" },
    { "type": "testimonial", "settings": { "quote": "Nothing soothes my reactive skin like this calendula night balm.", "author": "Sophie M.", "role": "Certified Esthetician" } },
    { "type": "testimonial", "settings": { "quote": "Pure organic botanical perfection in amber glass.", "author": "Liam H.", "role": "Organic Lifestyle Advocate" } }
  ]}]
}
{% endschema %}
