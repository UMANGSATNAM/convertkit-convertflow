<style>
@media screen and (max-width: 768px) {
  .hp42-category-pills {
    padding-left: 16px !important;
    padding-right: 16px !important;
    box-sizing: border-box !important;
  }
  img {
    max-width: 100% !important;
    height: auto !important;
  }
}
</style>
{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@1,700&family=Inter:wght@300&display=swap');

  #shopify-section-{{ section.id }} {
    --bg: {{ section.settings.bg_color }};
    --text: {{ section.settings.text_color }};
    --gold: {{ section.settings.accent_color }};
    --serif: 'Playfair Display', serif;
    --sans: 'Inter', sans-serif;
    background: var(--bg);
    padding: 60px 20px;
  }

  .hp42-cats {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 15px;
  }

  .hp42-cats__item {
    padding: 14px 40px;
    border: 1px solid rgba(201,169,110,0.3);
    font-family: var(--sans);
    font-size: 13px;
    font-weight: 300;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--text);
    text-decoration: none;
    transition: all 0.4s ease;
  }

  .hp42-cats__item:hover {
    background: var(--gold);
    color: var(--bg);
    border-color: var(--gold);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp42-cats" id="HP42Cats-{{ section.id }}">
  {%- for block in section.blocks -%}
    <a href="{{ block.settings.link | default: '#' }}" class="hp42-cats__item" {{ block.shopify_attributes }}>{{ block.settings.title }}</a>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "HP42 - Noir Categories",
  "class": "section-hp42-category-pills",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#0A0A0A" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#F5F0EB" },
    { "type": "color", "id": "accent_color", "label": "Gold", "default": "#C9A96E" },
    { "type": "html", "id": "custom_css", "label": "Custom CSS" }
  ],
  "blocks": [{ "type": "category", "name": "Category", "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Evening Wear" },
    { "type": "url", "id": "link", "label": "Link" }
  ]}],
  "presets": [{ "name": "HP42 - Noir Categories", "blocks": [
    { "type": "category", "settings": { "title": "Evening" } },
    { "type": "category", "settings": { "title": "Tailoring" } },
    { "type": "category", "settings": { "title": "Accessories" } },
    { "type": "category", "settings": { "title": "Archive" } }
  ]}]
}
{% endschema %}
