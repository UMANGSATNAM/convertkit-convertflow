{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#ffffff'
  assign text_color = section.settings.text_color | default: '#2b302a'
  assign accent_color = section.settings.accent_color | default: '#4a6741'
  assign heading = section.settings.heading | default: 'Curated Kits'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 100px 20px;
    color: {{ text_color }};
  }
  
  .hp7-bundle-container-{{ section_id }} {
    max-width: 1400px;
    margin: 0 auto;
  }
  
  .hp7-bundle-header-{{ section_id }} {
    text-align: center;
    margin-bottom: 60px;
  }
  
  .hp7-bundle-header-{{ section_id }} h2 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    font-weight: 500;
    margin: 0;
  }
  
  .hp7-bundle-grid-{{ section_id }} {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 40px;
  }
  
  .hp7-bundle-card-{{ section_id }} {
    display: flex;
    background-color: #f7f4ed;
    border-radius: 40px;
    overflow: hidden;
    transition: transform 0.4s ease;
  }
  
  .hp7-bundle-card-{{ section_id }}:hover {
    transform: translateY(-5px);
  }
  
  .hp7-bundle-img-{{ section_id }} {
    width: 45%;
    position: relative;
  }
  
  .hp7-bundle-img-{{ section_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .hp7-bundle-content-{{ section_id }} {
    width: 55%;
    padding: 40px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  
  .hp7-bundle-tag-{{ section_id }} {
    display: inline-block;
    background-color: {{ accent_color | color_modify: 'alpha', 0.1 }};
    color: {{ accent_color }};
    font-family: 'DM Sans', sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    padding: 5px 12px;
    border-radius: 20px;
    margin-bottom: 15px;
    align-self: flex-start;
  }
  
  .hp7-bundle-title-{{ section_id }} {
    font-family: 'Playfair Display', serif;
    font-size: 1.8rem;
    font-weight: 500;
    margin: 0 0 10px 0;
  }
  
  .hp7-bundle-desc-{{ section_id }} {
    font-family: 'DM Sans', sans-serif;
    font-size: 1rem;
    color: {{ text_color | color_modify: 'alpha', 0.7 }};
    margin: 0 0 20px 0;
    line-height: 1.5;
  }
  
  .hp7-bundle-price-{{ section_id }} {
    font-family: 'DM Sans', sans-serif;
    font-size: 1.3rem;
    font-weight: 700;
    color: {{ accent_color }};
    margin-bottom: 25px;
  }
  
  .hp7-bundle-price-{{ section_id }} s {
    font-size: 1rem;
    color: {{ text_color | color_modify: 'alpha', 0.5 }};
    font-weight: 400;
    margin-left: 10px;
  }
  
  .hp7-bundle-btn-{{ section_id }} {
    background-color: {{ text_color }};
    color: #fff;
    border: none;
    padding: 15px 30px;
    border-radius: 30px;
    font-family: 'DM Sans', sans-serif;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    text-decoration: none;
    text-align: center;
  }
  
  .hp7-bundle-btn-{{ section_id }}:hover {
    background-color: {{ accent_color }};
  }

  @media (max-width: 1024px) {
    .hp7-bundle-grid-{{ section_id }} {
      grid-template-columns: 1fr;
    }
  }
  
  @media (max-width: 600px) {
    .hp7-bundle-card-{{ section_id }} {
      flex-direction: column;
      border-radius: 30px;
    }
    .hp7-bundle-img-{{ section_id }},
    .hp7-bundle-content-{{ section_id }} {
      width: 100%;
    }
    .hp7-bundle-img-{{ section_id }} {
      height: 250px;
    }
    .hp7-bundle-content-{{ section_id }} {
      padding: 30px 20px;
    }
  }
</style>

<div class="hp7-bundle-container-{{ section_id }}">
  {% if heading != blank %}
    <div class="hp7-bundle-header-{{ section_id }}">
      <h2>{{ heading }}</h2>
    </div>
  {% endif %}
  
  <div class="hp7-bundle-grid-{{ section_id }}">
    {% for block in section.blocks %}
      <div class="hp7-bundle-card-{{ section_id }}" {{ block.shopify_attributes }}>
        <div class="hp7-bundle-img-{{ section_id }}">
          {% if block.settings.image != blank %}
            <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title }}" loading="lazy" width="400" height="400">
          {% else %}
            <div style="width:100%; height:100%; background: #e0ddd5;"></div>
          {% endif %}
        </div>
        
        <div class="hp7-bundle-content-{{ section_id }}">
          <div class="hp7-bundle-tag-{{ section_id }}">{{ block.settings.tag | default: 'Save 20%' }}</div>
          <h3 class="hp7-bundle-title-{{ section_id }}">{{ block.settings.title | default: 'The Essentials Kit' }}</h3>
          <p class="hp7-bundle-desc-{{ section_id }}">{{ block.settings.text | default: 'Everything you need to start your sustainable journey.' }}</p>
          <div class="hp7-bundle-price-{{ section_id }}">
            {{ block.settings.price | default: '$95.00' }} <s>{{ block.settings.compare_price | default: '$120.00' }}</s>
          </div>
          <a href="{{ block.settings.link | default: '#' }}" class="hp7-bundle-btn-{{ section_id }}">Shop Kit</a>
        </div>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "HP7 Bundle Offer",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2b302a"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#4a6741"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Curated Kits"
    }
  ],
  "blocks": [
    {
      "type": "bundle",
      "name": "Bundle",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Tag",
          "default": "Save 20%"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "The Everyday Kit"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Three essential pieces made from organic cotton."
        },
        {
          "type": "text",
          "id": "price",
          "label": "Sale Price",
          "default": "$95.00"
        },
        {
          "type": "text",
          "id": "compare_price",
          "label": "Compare at Price",
          "default": "$120.00"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP7 Bundle Offer",
      "blocks": [
        { "type": "bundle" },
        { "type": "bundle" }
      ]
    }
  ]
}
{% endschema %}
