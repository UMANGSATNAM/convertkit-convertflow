{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;700&family=JetBrains+Mono:wght@400;700&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --grid-color: rgba(255, 255, 255, 0.1);
    
    --font-heading: 'Inter', sans-serif;
    --font-body: 'JetBrains Mono', monospace;
    
    background-color: var(--bg-color);
    color: var(--text-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    
    /* Technical Grid Background */
    background-image: 
      linear-gradient(var(--grid-color) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-color) 1px, transparent 1px);
    background-size: 50px 50px;
    border-bottom: 1px solid var(--grid-color);
  }

  .hp34-hero-wrapper {
    max-width: 100%;
    margin: 0;
    padding: 0 40px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 80vh;
  }

  @media screen and (max-width: 992px) {
    .hp34-hero-wrapper {
      grid-template-columns: 1fr;
      padding: 0 20px;
    }
  }

  .hp34-hero__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    border-right: 1px solid var(--grid-color);
    padding-right: 40px;
    position: relative;
  }

  @media screen and (max-width: 992px) {
    .hp34-hero__content {
      border-right: none;
      border-bottom: 1px solid var(--grid-color);
      padding-right: 0;
      padding-bottom: 40px;
      margin-bottom: 40px;
    }
  }

  .hp34-hero__system-info {
    font-family: var(--font-body);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--accent-color);
    margin-bottom: 30px;
    display: flex;
    justify-content: space-between;
  }

  .hp34-hero__title {
    font-family: var(--font-heading);
    font-size: clamp(60px, 8vw, {{ section.settings.title_size }}px);
    line-height: 0.9;
    font-weight: 700;
    margin: 0 0 30px;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }

  .hp34-hero__text {
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.6;
    max-width: 500px;
    margin: 0 0 40px;
    opacity: 0.8;
  }

  .hp34-hero__btn-group {
    display: flex;
    gap: 15px;
  }

  .hp34-hero__btn {
    font-family: var(--font-body);
    font-size: 13px;
    text-transform: uppercase;
    text-decoration: none;
    padding: 15px 30px;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }

  .hp34-hero__btn--primary {
    background-color: var(--accent-color);
    color: #000;
  }

  .hp34-hero__btn--primary:hover {
    background-color: #fff;
  }

  .hp34-hero__btn--secondary {
    background-color: transparent;
    color: var(--text-color);
    border: 1px solid var(--text-color);
  }

  .hp34-hero__btn--secondary:hover {
    border-color: var(--accent-color);
    color: var(--accent-color);
  }

  .hp34-hero__image-col {
    position: relative;
    padding-left: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media screen and (max-width: 992px) {
    .hp34-hero__image-col {
      padding-left: 0;
    }
  }

  .hp34-hero__image-wrap {
    width: 100%;
    aspect-ratio: 4/5;
    position: relative;
    border: 1px solid var(--grid-color);
    background: #000;
    overflow: hidden;
  }

  .hp34-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%) contrast(1.2);
    transition: filter 0.5s ease;
  }

  .hp34-hero__image-wrap:hover .hp34-hero__image {
    filter: grayscale(0%) contrast(1);
  }

  /* Target box reticle */
  .hp34-hero__reticle {
    position: absolute;
    width: 30px; height: 30px;
    border: 1px solid var(--accent-color);
    pointer-events: none;
    z-index: 2;
  }
  .hp34-hero__reticle--tl { top: 20px; left: 20px; border-right: none; border-bottom: none; }
  .hp34-hero__reticle--tr { top: 20px; right: 20px; border-left: none; border-bottom: none; }
  .hp34-hero__reticle--bl { bottom: 20px; left: 20px; border-right: none; border-top: none; }
  .hp34-hero__reticle--br { bottom: 20px; right: 20px; border-left: none; border-top: none; }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp34-hero-wrapper" id="HP34Hero-{{ section.id }}">
  <div class="hp34-hero__content">
    <div class="hp34-hero__system-info">
      <span>SYS.OP.{{ 'now' | date: '%y%m' }}</span>
      <span>V.34.0</span>
    </div>
    
    <h1 class="hp34-hero__title">{{ section.settings.title }}</h1>
    <p class="hp34-hero__text">{{ section.settings.text }}</p>
    
    <div class="hp34-hero__btn-group">
      {%- if section.settings.btn1_label != blank -%}
        <a href="{{ section.settings.btn1_link | default: '#' }}" class="hp34-hero__btn hp34-hero__btn--primary">
          {{ section.settings.btn1_label }}
        </a>
      {%- endif -%}
      {%- if section.settings.btn2_label != blank -%}
        <a href="{{ section.settings.btn2_link | default: '#' }}" class="hp34-hero__btn hp34-hero__btn--secondary">
          {{ section.settings.btn2_label }}
        </a>
      {%- endif -%}
    </div>
  </div>
  
  <div class="hp34-hero__image-col">
    <div class="hp34-hero__image-wrap">
      <div class="hp34-hero__reticle hp34-hero__reticle--tl"></div>
      <div class="hp34-hero__reticle hp34-hero__reticle--tr"></div>
      <div class="hp34-hero__reticle hp34-hero__reticle--bl"></div>
      <div class="hp34-hero__reticle hp34-hero__reticle--br"></div>
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.title | escape }}" class="hp34-hero__image" loading="lazy">
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'hp34-hero__image' }}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "HP34 - Tech Hero",
  "class": "section-hp34-hero",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Heading",
      "default": "SYSTEM.CORE\nINITIALIZED"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Executing primary protocols. Deploying the latest collection designed for maximum efficiency and aesthetic precision."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Image"
    },
    {
      "type": "text",
      "id": "btn1_label",
      "label": "Button 1 Label",
      "default": "[ EXECUTE: SHOP ]"
    },
    {
      "type": "url",
      "id": "btn1_link",
      "label": "Button 1 Link"
    },
    {
      "type": "text",
      "id": "btn2_label",
      "label": "Button 2 Label",
      "default": "SYS_INFO"
    },
    {
      "type": "url",
      "id": "btn2_link",
      "label": "Button 2 Link"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 40,
      "max": 150,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 120
    },
    {
      "type": "header",
      "content": "Tech Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (e.g. Black)",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color (e.g. Neon Orange)",
      "default": "#FF4500"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 0
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP34 - Tech Hero"
    }
  ]
}
{% endschema %}
