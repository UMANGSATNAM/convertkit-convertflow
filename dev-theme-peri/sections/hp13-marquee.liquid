{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#00FFA3'
  assign text_color = section.settings.text_color | default: '#050505'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    border-bottom: 1px solid #050505;
    padding: 15px 0;
    overflow: hidden;
  }
  
  .hp13-marquee-wrapper-{{ section_id }} {
    display: flex;
    white-space: nowrap;
    overflow: hidden;
  }
  
  .hp13-marquee-content-{{ section_id }} {
    display: flex;
    animation: hp13-marquee-{{ section_id }} 20s linear infinite;
  }
  
  .hp13-marquee-item-{{ section_id }} {
    font-family: 'Courier New', Courier, monospace;
    font-size: 1.5rem;
    font-weight: bold;
    color: {{ text_color }};
    text-transform: uppercase;
    letter-spacing: 2px;
    padding: 0 30px;
    display: flex;
    align-items: center;
  }
  
  .hp13-marquee-item-{{ section_id }} span {
    margin: 0 30px;
  }

  @keyframes hp13-marquee-{{ section_id }} {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
</style>

<div class="hp13-marquee-wrapper-{{ section_id }}">
  <div class="hp13-marquee-content-{{ section_id }}">
    {% for i in (1..5) %}
      <div class="hp13-marquee-item-{{ section_id }}">
        {{ section.settings.text | default: 'SYSTEM.ONLINE /// SECURE.CONNECTION' }} <span>+++</span>
      </div>
    {% endfor %}
    {% for i in (1..5) %}
      <div class="hp13-marquee-item-{{ section_id }}">
        {{ section.settings.text | default: 'SYSTEM.ONLINE /// SECURE.CONNECTION' }} <span>+++</span>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "HP13 Marquee",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#00FFA3"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#050505"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "SYSTEM.ONLINE /// SECURE.CONNECTION"
    }
  ],
  "presets": [
    {
      "name": "HP13 Marquee"
    }
  ]
}
{% endschema %}
