{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#FAF5EF' }};
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }

  .hp53-comp__container {
    max-width: {{ section.settings.container_width | default: 1000 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp53-comp__header {
    text-align: center;
    margin-bottom: 50px;
  }

  .hp53-comp__eyebrow {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: {{ section.settings.accent_color | default: '#C2703E' }};
    margin: 0 0 12px;
  }

  .hp53-comp__heading {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(28px, 3.5vw, 42px);
    font-weight: 700;
    color: {{ section.settings.title_color | default: '#5C3D2E' }};
    margin: 0;
  }

  .hp53-comp__table {
    width: 100%;
    border-collapse: collapse;
    background: {{ section.settings.card_bg | default: '#FFFFFF' }};
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid {{ section.settings.border_color | default: '#E8D5C0' }};
  }

  .hp53-comp__table th {
    background: {{ section.settings.header_bg | default: '#5C3D2E' }};
    color: {{ section.settings.header_text | default: '#FAF5EF' }};
    font-family: 'Space Grotesk', sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    padding: 16px 20px;
    text-align: left;
  }

  .hp53-comp__table td {
    padding: 16px 20px;
    font-size: 14px;
    color: {{ section.settings.text_color | default: '#5C3D2E' }};
    border-bottom: 1px solid {{ section.settings.border_color | default: '#E8D5C0' }};
  }

  .hp53-comp__table tr:last-child td {
    border-bottom: none;
  }

  .hp53-comp__check {
    color: {{ section.settings.accent_color | default: '#C2703E' }};
    font-weight: 700;
  }

  @media screen and (max-width: 768px) {
    .hp53-comp__table { font-size: 13px; }
    .hp53-comp__table th,
    .hp53-comp__table td { padding: 12px 14px; }
  }
{%- endstyle -%}

<div class="hp53-comp__container">
  <div class="hp53-comp__header">
    {%- if section.settings.eyebrow != blank -%}
      <p class="hp53-comp__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h2 class="hp53-comp__heading">{{ section.settings.heading | default: 'Why Choose Dune?' }}</h2>
  </div>

  <table class="hp53-comp__table">
    <thead>
      <tr>
        <th>{{ section.settings.col1_head | default: 'Feature' }}</th>
        <th>{{ section.settings.col2_head | default: 'Dune Collection' }}</th>
        <th>{{ section.settings.col3_head | default: 'Others' }}</th>
      </tr>
    </thead>
    <tbody>
      {%- for block in section.blocks -%}
        <tr {{ block.shopify_attributes }}>
          <td>{{ block.settings.feature | default: 'Feature' }}</td>
          <td class="hp53-comp__check">{{ block.settings.us | default: '✓' }}</td>
          <td>{{ block.settings.them | default: '✗' }}</td>
        </tr>
      {%- endfor -%}
    </tbody>
  </table>
</div>

{% schema %}
{
  "name": "HP53 - Dune Compare",
  "class": "section-hp53-comp",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FAF5EF" },
    { "type": "color", "id": "card_bg", "label": "Table BG", "default": "#FFFFFF" },
    { "type": "color", "id": "header_bg", "label": "Header BG", "default": "#5C3D2E" },
    { "type": "color", "id": "header_text", "label": "Header Text", "default": "#FAF5EF" },
    { "type": "color", "id": "border_color", "label": "Border", "default": "#E8D5C0" },
    { "type": "color", "id": "title_color", "label": "Title Color", "default": "#5C3D2E" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#C2703E" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#5C3D2E" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "◈ COMPARISON" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why Choose Dune?" },
    { "type": "text", "id": "col1_head", "label": "Column 1", "default": "Feature" },
    { "type": "text", "id": "col2_head", "label": "Column 2", "default": "Dune Collection" },
    { "type": "text", "id": "col3_head", "label": "Column 3", "default": "Others" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 700, "max": 1200, "step": 20, "unit": "px", "label": "Container Width", "default": 1000 }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        { "type": "text", "id": "feature", "label": "Feature", "default": "Natural Ingredients" },
        { "type": "text", "id": "us", "label": "Us", "default": "✓" },
        { "type": "text", "id": "them", "label": "Others", "default": "✗" }
      ]
    }
  ],
  "presets": [{
    "name": "HP53 - Dune Compare",
    "blocks": [
      { "type": "row", "settings": { "feature": "Desert Botanicals", "us": "✓", "them": "✗" } },
      { "type": "row", "settings": { "feature": "Cruelty-Free", "us": "✓", "them": "~" } },
      { "type": "row", "settings": { "feature": "Sustainable Packaging", "us": "✓", "them": "✗" } },
      { "type": "row", "settings": { "feature": "Clinical Results", "us": "✓", "them": "✓" } }
    ]
  }]
}
{% endschema %}
