{% comment %}
  Urgency Flash Bar - High-CRO Flash Sale Countdown & Coupon Bar
  PageFly-Style Booster Section
{% endcomment %}

<div id="cf-urgency-bar-{{ section.id }}" class="cf-urgency-bar" style="background: {{ section.settings.bg_color | default: '#090d16' }}; color: {{ section.settings.text_color | default: '#ffffff' }};">
  <div class="cf-urgency-bar__container">
    <div class="cf-urgency-bar__left">
      <span class="cf-urgency-pill">
        <span class="cf-urgency-pulse"></span>
        {{ section.settings.badge_text | default: 'LIMITED TIME DEAL' }}
      </span>
      <span class="cf-urgency-headline">{{ section.settings.headline | default: '⚡ Mega Flash Sale Ends Soon!' }}</span>
    </div>

    <div class="cf-urgency-bar__center">
      <div class="cf-countdown-timer" data-hours="{{ section.settings.timer_hours | default: 4 }}">
        <div class="cf-timer-unit">
          <span class="cf-timer-num cf-hours">03</span>
          <span class="cf-timer-lbl">HRS</span>
        </div>
        <span class="cf-timer-colon">:</span>
        <div class="cf-timer-unit">
          <span class="cf-timer-num cf-mins">45</span>
          <span class="cf-timer-lbl">MIN</span>
        </div>
        <span class="cf-timer-colon">:</span>
        <div class="cf-timer-unit">
          <span class="cf-timer-num cf-secs">20</span>
          <span class="cf-timer-lbl">SEC</span>
        </div>
      </div>
    </div>

    <div class="cf-urgency-bar__right">
      {% if section.settings.coupon_code != blank %}
        <button type="button" class="cf-coupon-btn" onclick="navigator.clipboard && navigator.clipboard.writeText('{{ section.settings.coupon_code }}'); this.innerText='COPIED! 🎉'; setTimeout(() => this.innerText='USE: {{ section.settings.coupon_code }}', 2500);" title="Click to copy coupon code">
          USE: <strong>{{ section.settings.coupon_code }}</strong>
        </button>
      {% endif %}
      {% if section.settings.cta_link != blank %}
        <a href="{{ section.settings.cta_link }}" class="cf-urgency-cta" style="background: {{ section.settings.accent_color | default: '#10b981' }}; color: #ffffff;">
          {{ section.settings.cta_text | default: 'Shop Now →' }}
        </a>
      {% endif %}
    </div>
  </div>
</div>

<style>
  .cf-urgency-bar {
    width: 100%;
    padding: 10px 16px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    box-sizing: border-box;
  }
  .cf-urgency-bar__container {
    max-width: 1380px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .cf-urgency-bar__left {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .cf-urgency-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(239, 68, 68, 0.2);
    border: 1px solid rgba(239, 68, 68, 0.6);
    color: #fca5a5;
    padding: 3px 8px;
    border-radius: 99px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }
  .cf-urgency-pulse {
    width: 7px;
    height: 7px;
    background: #ef4444;
    border-radius: 99px;
    box-shadow: 0 0 8px #ef4444;
    animation: cfPulse 1.4s infinite ease-in-out;
  }
  @keyframes cfPulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }
  .cf-urgency-headline {
    font-size: 13px;
    font-weight: 700;
  }
  .cf-urgency-bar__center {
    display: flex;
    align-items: center;
  }
  .cf-countdown-timer {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: rgba(255, 255, 255, 0.08);
    padding: 4px 10px;
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.12);
  }
  .cf-timer-unit {
    display: flex;
    align-items: baseline;
    gap: 2px;
  }
  .cf-timer-num {
    font-size: 14px;
    font-weight: 800;
    font-family: monospace;
    color: #38bdf8;
  }
  .cf-timer-lbl {
    font-size: 9px;
    font-weight: 700;
    color: #94a3b8;
  }
  .cf-timer-colon {
    font-weight: 700;
    color: #64748b;
  }
  .cf-urgency-bar__right {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .cf-coupon-btn {
    background: rgba(255, 255, 255, 0.12);
    border: 1px dashed rgba(255, 255, 255, 0.35);
    color: #f1f5f9;
    padding: 5px 10px;
    border-radius: 4px;
    font-size: 11px;
    cursor: pointer;
    transition: all 0.2s;
  }
  .cf-coupon-btn:hover {
    background: rgba(255, 255, 255, 0.22);
    border-color: #38bdf8;
  }
  .cf-urgency-cta {
    padding: 6px 14px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 700;
    text-decoration: none;
    transition: opacity 0.2s;
  }
  .cf-urgency-cta:hover {
    opacity: 0.9;
  }
  @media (max-width: 768px) {
    .cf-urgency-bar__container {
      justify-content: center;
      text-align: center;
    }
  }
</style>

<script>
  (function() {
    var bar = document.getElementById("cf-urgency-bar-{{ section.id }}");
    if (!bar) return;
    var timer = bar.querySelector(".cf-countdown-timer");
    if (!timer) return;
    var storageKey = "cf_flash_end_" + (timer.dataset.hours || 4);
    var target = localStorage.getItem(storageKey);
    var hours = parseInt(timer.dataset.hours || "4", 10);
    if (!target || isNaN(parseInt(target, 10)) || Date.now() > parseInt(target, 10)) {
      target = Date.now() + hours * 3600 * 1000;
      localStorage.setItem(storageKey, target);
    } else {
      target = parseInt(target, 10);
    }

    function tick() {
      var remaining = Math.max(0, target - Date.now());
      var h = Math.floor(remaining / (3600 * 1000));
      var m = Math.floor((remaining % (3600 * 1000)) / (60 * 1000));
      var s = Math.floor((remaining % (60 * 1000)) / 1000);
      var hEl = timer.querySelector(".cf-hours");
      var mEl = timer.querySelector(".cf-mins");
      var sEl = timer.querySelector(".cf-secs");
      if (hEl) hEl.textContent = ("0" + h).slice(-2);
      if (mEl) mEl.textContent = ("0" + m).slice(-2);
      if (sEl) sEl.textContent = ("0" + s).slice(-2);
    }
    tick();
    setInterval(tick, 1000);
  })();
</script>

{% schema %}
{
  "name": "Urgency Flash Bar",
  "settings": [
    { "type": "text", "id": "badge_text", "label": "Badge Text", "default": "LIMITED TIME DEAL" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "⚡ Mega Flash Sale Ends Soon!" },
    { "type": "number", "id": "timer_hours", "label": "Countdown Duration (Hours)", "default": 4 },
    { "type": "text", "id": "coupon_code", "label": "Coupon Code (Optional)", "default": "SAVE20" },
    { "type": "url", "id": "cta_link", "label": "Button Link", "default": "/collections/all" },
    { "type": "text", "id": "cta_text", "label": "Button Text", "default": "Claim Offer →" },
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#090d16" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#ffffff" },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#10b981" }
  ],
  "presets": [
    {
      "name": "Urgency Flash Bar"
    }
  ]
}
{% endschema %}
