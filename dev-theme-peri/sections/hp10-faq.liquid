{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#FFFFFF'
  assign text_color = section.settings.text_color | default: '#2A3B2C'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 100px 20px;
    color: {{ text_color }};
  }
  
  .hp10-faq-container-{{ section_id }} {
    max-width: 800px;
    margin: 0 auto;
  }
  
  .hp10-faq-header-{{ section_id }} {
    text-align: center;
    margin-bottom: 50px;
  }
  
  .hp10-faq-heading-{{ section_id }} {
    font-family: 'Lora', serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 400;
    margin: 0;
  }
  
  .hp10-faq-item-{{ section_id }} {
    border-bottom: 1px solid rgba(42, 59, 44, 0.1);
    padding: 20px 0;
  }
  
  .hp10-faq-question-{{ section_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    font-family: 'Inter', sans-serif;
    font-size: 1.1rem;
    font-weight: 500;
  }
  
  .hp10-faq-icon-{{ section_id }} {
    width: 24px;
    height: 24px;
    position: relative;
  }
  
  .hp10-faq-icon-{{ section_id }}::before,
  .hp10-faq-icon-{{ section_id }}::after {
    content: '';
    position: absolute;
    background: {{ text_color }};
    transition: transform 0.3s ease;
  }
  
  .hp10-faq-icon-{{ section_id }}::before {
    top: 11px; left: 4px; width: 16px; height: 2px;
  }
  
  .hp10-faq-icon-{{ section_id }}::after {
    top: 4px; left: 11px; width: 2px; height: 16px;
  }
  
  .hp10-faq-item-{{ section_id }}.active .hp10-faq-icon-{{ section_id }}::after {
    transform: rotate(90deg);
  }
  
  .hp10-faq-answer-{{ section_id }} {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s ease;
    font-family: 'Inter', sans-serif;
    font-size: 1rem;
    line-height: 1.6;
    color: rgba(42, 59, 44, 0.7);
  }
  
  .hp10-faq-answer-inner-{{ section_id }} {
    padding-top: 20px;
    padding-bottom: 10px;
  }
</style>

<div class="hp10-faq-container-{{ section_id }}">
  <div class="hp10-faq-header-{{ section_id }}">
    <h2 class="hp10-faq-heading-{{ section_id }}">{{ section.settings.heading | default: 'Common Questions' }}</h2>
  </div>
  
  <div class="hp10-faq-list-{{ section_id }}">
    {% for block in section.blocks %}
      <div class="hp10-faq-item-{{ section_id }}" {{ block.shopify_attributes }}>
        <div class="hp10-faq-question-{{ section_id }}" onclick="this.parentElement.classList.toggle('active'); var ans = this.nextElementSibling; if(this.parentElement.classList.contains('active')) { ans.style.maxHeight = ans.scrollHeight + 'px'; } else { ans.style.maxHeight = '0'; }">
          {{ block.settings.question | default: 'Question?' }}
          <div class="hp10-faq-icon-{{ section_id }}"></div>
        </div>
        <div class="hp10-faq-answer-{{ section_id }}">
          <div class="hp10-faq-answer-inner-{{ section_id }}">
            {{ block.settings.answer | default: 'Answer goes here.' }}
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "HP10 FAQ",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Common Questions"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Are your products truly organic?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "Yes, we source 100% certified organic ingredients from sustainable farms worldwide."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP10 FAQ",
      "blocks": [
        { "type": "faq" },
        { "type": "faq" },
        { "type": "faq" }
      ]
    }
  ]
}
{% endschema %}
