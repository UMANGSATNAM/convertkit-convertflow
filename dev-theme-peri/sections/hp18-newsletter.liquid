{%- liquid
  assign sec_id = section.id
  assign bg_color = section.settings.bg_color
  assign text_color = section.settings.text_color
  assign input_bg = section.settings.input_bg
  assign btn_bg = section.settings.btn_bg
  assign border_color = section.settings.border_color
  assign border_width = section.settings.border_width
  assign shadow_color = section.settings.shadow_color
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
-%}

<style>
  .hp18-news-{{ sec_id }} {
    background-color: {{ bg_color }};
    padding-top: {{ padding_top }}px;
    padding-bottom: {{ padding_bottom }}px;
    border-bottom: {{ border_width }}px solid {{ border_color }};
  }

  .hp18-news-{{ sec_id }}__container {
    max-width: var(--page-width, 1000px);
    margin: 0 auto;
    padding: 0 40px;
  }

  .hp18-news-{{ sec_id }}__wrapper {
    background-color: {{ bg_color }};
    border: {{ border_width }}px solid {{ border_color }};
    box-shadow: 15px 15px 0px {{ shadow_color }};
    padding: 60px 80px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  /* Grid background pattern for brutlist feel */
  .hp18-news-{{ sec_id }}__wrapper::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-image: linear-gradient({{ border_color }}11 1px, transparent 1px),
      linear-gradient(90deg, {{ border_color }}11 1px, transparent 1px);
    background-size: 20px 20px;
    z-index: 1;
    pointer-events: none;
  }

  .hp18-news-{{ sec_id }}__content {
    position: relative;
    z-index: 2;
  }

  .hp18-news-{{ sec_id }}__title {
    font-family: 'Arial Black', Impact, sans-serif;
    font-size: clamp(32px, 5vw, 56px);
    color: {{ text_color }};
    text-transform: uppercase;
    margin: 0 0 15px 0;
    line-height: 1.1;
  }

  .hp18-news-{{ sec_id }}__text {
    font-family: 'Courier New', monospace;
    font-size: 18px;
    font-weight: bold;
    color: {{ text_color }};
    margin: 0 0 40px 0;
  }

  .hp18-news-{{ sec_id }}__form {
    display: flex;
    max-width: 600px;
    margin: 0 auto;
    box-shadow: 8px 8px 0px {{ shadow_color }};
  }

  .hp18-news-{{ sec_id }}__input {
    flex: 1;
    background-color: {{ input_bg }};
    border: {{ border_width }}px solid {{ border_color }};
    border-right: none;
    padding: 20px 25px;
    font-family: 'Courier New', monospace;
    font-size: 16px;
    font-weight: bold;
    color: {{ text_color }};
    outline: none;
  }

  .hp18-news-{{ sec_id }}__input::placeholder {
    color: {{ text_color }};
    opacity: 0.5;
  }

  .hp18-news-{{ sec_id }}__btn {
    background-color: {{ btn_bg }};
    color: {{ text_color }};
    border: {{ border_width }}px solid {{ border_color }};
    padding: 20px 40px;
    font-family: 'Arial Black', sans-serif;
    font-size: 16px;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 0.2s;
  }

  .hp18-news-{{ sec_id }}__btn:hover {
    background-color: {{ text_color }};
    color: {{ btn_bg }};
  }

  @media screen and (max-width: 768px) {
    .hp18-news-{{ sec_id }}__container { padding: 0 20px; }
    .hp18-news-{{ sec_id }}__wrapper { 
      padding: 40px 20px; 
      box-shadow: 8px 8px 0px {{ shadow_color }};
    }
    .hp18-news-{{ sec_id }}__form { flex-direction: column; box-shadow: none; }
    .hp18-news-{{ sec_id }}__input { 
      border-right: {{ border_width }}px solid {{ border_color }};
      margin-bottom: 15px;
      box-shadow: 6px 6px 0px {{ shadow_color }};
    }
    .hp18-news-{{ sec_id }}__btn {
      box-shadow: 6px 6px 0px {{ shadow_color }};
    }
  }
</style>

<section class="hp18-news-{{ sec_id }}">
  <div class="hp18-news-{{ sec_id }}__container">
    <div class="hp18-news-{{ sec_id }}__wrapper">
      <div class="hp18-news-{{ sec_id }}__content">
        
        <h2 class="hp18-news-{{ sec_id }}__title">{{ section.settings.title }}</h2>
        <p class="hp18-news-{{ sec_id }}__text">{{ section.settings.text }}</p>

        {% capture form_class %}hp18-news-{{ sec_id }}__form{% endcapture %}
        {% form 'customer', class: form_class %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          
          {% if form.posted_successfully? %}
            <p style="font-family: 'Courier New', monospace; font-weight: bold; background: {{ btn_bg }}; padding: 15px; border: {{ border_width }}px solid {{ border_color }};">You're on the list.</p>
          {% else %}
            <div class="hp18-news-{{ sec_id }}__form">
              <input type="email"
                name="contact[email]"
                class="hp18-news-{{ sec_id }}__input"
                value="{{ form.email }}"
                placeholder="ENTER EMAIL ADDRESS"
                required>
              <button type="submit" class="hp18-news-{{ sec_id }}__btn">
                {{ section.settings.btn_text }}
              </button>
            </div>
            {{ form.errors | default_errors }}
          {% endif %}
        {% endform %}

      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "HP18 Adv Newsletter",
  "settings": [
    {
      "type": "header",
      "content": "Color Settings"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f4f4f0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "input_bg",
      "label": "Input Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "btn_bg",
      "label": "Button Background",
      "default": "#CCFF00"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "shadow_color",
      "label": "Shadow Color",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Layout & Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "JOIN THE CULT"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Subheading",
      "default": "10% OFF YOUR FIRST ORDER. EXCLUSIVE DROP ALERTS."
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "SUBSCRIBE"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "Border Width",
      "default": 3
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 10,
      "unit": "px",
      "label": "Padding Top",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 10,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "HP18 Advanced Newsletter"
    }
  ]
}
{% endschema %}
