{% comment %} CL V28 — Botanical / Plant Shop {% endcomment %}
{{ 'component-facets.css' | asset_url | stylesheet_tag }}
<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
<style>
  .clv28 { background: {{ section.settings.bg_color | default: '#F2F5ED' }}; color: {{ section.settings.text_color | default: '#2C4A2D' }}; padding: 60px 20px; font-family: 'Lora', serif; }
  .clv28-hero { text-align: center; margin-bottom: 50px; background: #E6EFE0; padding: 70px 40px; border-radius: 200px 200px 0 0; }
  .clv28-hero h1 { font-size: 46px; font-weight: 400; color: #2C4A2D; margin-bottom: 15px; }
  .clv28-hero p { font-size: 16px; font-family: 'Karla', sans-serif; color: #527053; max-width: 600px; margin: 0 auto; line-height: 1.6; }
  .clv28-chips { display: flex; gap: 15px; justify-content: center; margin-bottom: 50px; flex-wrap: wrap; }
  .clv28-chips a { padding: 10px 25px; background: #FFFFFF; color: #2C4A2D; text-decoration: none; font-family: 'Karla', sans-serif; font-size: 14px; font-weight: 600; border-radius: 40px; transition: 0.3s; border: 1px solid #D5E1CD; }
  .clv28-chips a:hover, .clv28-chips a.active { background: #2C4A2D; color: #FFF; border-color: #2C4A2D; }
  .clv28-toolbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 40px; font-family: 'Karla', sans-serif; padding-bottom: 20px; border-bottom: 1px solid #D5E1CD; }
  .clv28-grid { display: grid; grid-template-columns: repeat({{ section.settings.cols_desktop | default: 4 }}, 1fr); gap: 30px; }
  .clv28-promo { grid-column: span 1; background: #C87A5E; color: #FFF; border-radius: 12px; padding: 40px; text-align: center; display: flex; flex-direction: column; justify-content: center; }
  .clv28-promo h3 { font-size: 26px; font-weight: 400; margin-bottom: 20px; }
  .clv28-promo a { display: inline-block; padding: 12px 28px; background: #FFF; color: #C87A5E; font-family: 'Karla', sans-serif; text-decoration: none; font-size: 14px; font-weight: 700; border-radius: 30px; }
  .clv28-seo { margin-top: 70px; text-align: center; padding: 60px 40px; background: #FFFFFF; border-radius: 12px; box-shadow: 0 4px 20px rgba(44,74,45,0.05); }
  @media (max-width: 768px) { .clv28-grid { grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr); gap: 15px; } .clv28-hero { border-radius: 100px 100px 0 0; padding: 50px 20px; } }
</style>
<div class="clv28" style="max-width: 1250px; margin: 0 auto;">
  <div class="clv28-hero">
    <h1>{% if collection.title != blank %}{{ collection.title | escape }}{% else %}Urban Jungle{% endif %}</h1>
    <p>{% if collection.description != blank %}{{ collection.description }}{% else %}Bring life into your space with our hand-picked botanicals.{% endif %}</p>
  </div>
  {% if section.settings.sub_collections != blank %}
    <div class="clv28-chips">
      {% for link in section.settings.sub_collections.links %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% endfor %}
    </div>
  {% endif %}
  <div class="clv28-toolbar">
    <facet-filters-form style="width: 100%;">
      <form id="FacetFiltersForm" style="display: flex; justify-content: space-between; align-items: center; width: 100%; flex-wrap: wrap; gap: 20px;">
        <div style="display: flex; gap: 20px;">
          {%- for filter in collection.filters -%}
            <details style="position: relative;">
              <summary style="cursor: pointer; font-size: 14px; font-weight: 600;">{{ filter.label }} 🪴</summary>
              <div style="position: absolute; background: #FFF; padding: 25px; border-radius: 12px; border: 1px solid #D5E1CD; z-index: 10; margin-top: 15px; min-width: 230px; box-shadow: 0 10px 30px rgba(44,74,45,0.1);">
                {%- for value in filter.values -%}
                  <label style="display: block; margin-bottom: 12px; cursor: pointer; font-size: 14px; color: #527053;">
                    <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %}>
                    {{ value.label }} ({{ value.count }})
                  </label>
                {%- endfor -%}
              </div>
            </details>
          {%- endfor -%}
        </div>
        <select name="sort_by" onchange="this.form.submit()" style="background: transparent; border: none; font-size: 14px; font-weight: 600; color: #2C4A2D; cursor: pointer;">
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>Sort: {{ option.name }}</option>
          {%- endfor -%}
        </select>
      </form>
    </facet-filters-form>
  </div>
  {% assign limit_num = section.settings.products_per_page | default: 16 %}
  {% paginate collection.products by limit_num %}
    <div class="clv28-grid">
      {% for product in collection.products %}
        {% render 'card-v28', product: product %}
        {% if forloop.index == 8 and section.settings.show_promo_tile %}
          <div class="clv28-promo">
            <span style="font-family: 'Karla', sans-serif; font-size: 12px; text-transform: uppercase; letter-spacing: 2px; margin-bottom: 10px;">Plant Care</span>
            <h3>Potting<br>Mixes</h3>
            <a href="/collections/soil">Shop Soil</a>
          </div>
        {% endif %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v28', product: nil %}
        {% endfor %}
      {% endfor %}
    </div>
    <div style="margin-top: 50px; text-align: center; font-family: 'Karla', sans-serif;">{{ paginate | default_pagination }}</div>
  {% endpaginate %}
  {% if section.settings.show_seo_block %}
    <div class="clv28-seo">
      <h2 style="font-size: 28px; font-weight: 400; color: #2C4A2D; margin-bottom: 15px;">{{ section.settings.seo_title | default: 'Grown with Love' }}</h2>
      <p style="font-family: 'Karla', sans-serif; font-size: 15px; color: #527053; max-width: 650px; margin: 0 auto; line-height: 1.8;">{{ section.settings.seo_text | default: 'Every plant is nurtured in our local greenhouse until it is ready to thrive in your home.' }}</p>
    </div>
  {% endif %}
</div>
{% schema %}
{
  "name": "CL V28 — Botanical", "settings": [
    {"type": "range", "id": "products_per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 16},
    {"type": "range", "id": "cols_desktop", "label": "Desktop Columns", "min": 2, "max": 5, "default": 4},
    {"type": "select", "id": "cols_mobile", "label": "Mobile Columns", "options": [{"value": "1", "label": "1"}, {"value": "2", "label": "2"}], "default": "2"},
    {"type": "link_list", "id": "sub_collections", "label": "Sub-Collection Menu"},
    {"type": "checkbox", "id": "show_promo_tile", "label": "Show Promo Card", "default": true},
    {"type": "checkbox", "id": "show_seo_block", "label": "Show SEO Block", "default": true},
    {"type": "color", "id": "bg_color", "label": "Background Color", "default": "#F2F5ED"},
    {"type": "color", "id": "text_color", "label": "Text Color", "default": "#2C4A2D"}
  ], "presets": [{"name": "CL V28 — Botanical"}]
}
{% endschema %}
