{%- liquid
  assign bg_color = section.settings.bg_color | default: '#ffffff'
  assign text_color = section.settings.text_color | default: '#1a2a3a'
  assign accent_color = section.settings.accent_color | default: '#0066cc'
  assign icon_bg = section.settings.icon_bg | default: '#f4f7f9'
  
  assign padding_top_desktop = section.settings.padding_top_desktop
  assign padding_bottom_desktop = section.settings.padding_bottom_desktop
  assign padding_top_mobile = section.settings.padding_top_mobile
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile
-%}

<style>
  #shopify-section-{{ section.id }} {
    --hp5-usp-bg: {{ bg_color }};
    --hp5-usp-text: {{ text_color }};
    --hp5-usp-accent: {{ accent_color }};
    --hp5-usp-icon-bg: {{ icon_bg }};
    
    --hp5-usp-pt-desk: {{ padding_top_desktop }}px;
    --hp5-usp-pb-desk: {{ padding_bottom_desktop }}px;
    --hp5-usp-pt-mob: {{ padding_top_mobile }}px;
    --hp5-usp-pb-mob: {{ padding_bottom_mobile }}px;
  }

  .hp5-health-usp-{{ section.id }} {
    padding-top: var(--hp5-usp-pt-desk);
    padding-bottom: var(--hp5-usp-pb-desk);
    background-color: var(--hp5-usp-bg);
    color: var(--hp5-usp-text);
    font-family: 'Inter', sans-serif;
  }

  .hp5-usp-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .hp5-usp-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 60px auto;
  }

  .hp5-usp-label {
    display: inline-block;
    color: var(--hp5-usp-accent);
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 15px;
  }

  .hp5-usp-title {
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 700;
    line-height: 1.2;
    margin: 0;
    letter-spacing: -1px;
  }

  .hp5-usp-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 40px;
  }

  .hp5-usp-item {
    text-align: center;
    padding: 40px 30px;
    background: #ffffff;
    border-radius: 16px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.03);
    border: 1px solid rgba(26,42,58,0.05);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .hp5-usp-item:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.06);
  }

  .hp5-usp-icon-wrap {
    width: 80px; height: 80px;
    background: var(--hp5-usp-icon-bg);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 25px auto;
    color: var(--hp5-usp-accent);
  }
  .hp5-usp-icon-wrap svg {
    width: 32px; height: 32px;
  }
  .hp5-usp-icon-wrap img {
    max-width: 40px;
    max-height: 40px;
    object-fit: contain;
  }

  .hp5-usp-item-title {
    font-size: 20px;
    font-weight: 700;
    margin: 0 0 15px 0;
  }
  .hp5-usp-item-desc {
    font-size: 15px;
    line-height: 1.6;
    color: rgba(26,42,58,0.7);
    margin: 0;
  }

  @media screen and (max-width: 768px) {
    .hp5-health-usp-{{ section.id }} {
      padding-top: var(--hp5-usp-pt-mob);
      padding-bottom: var(--hp5-usp-pb-mob);
    }
    .hp5-usp-inner {
      padding: 0 20px;
    }
    .hp5-usp-header {
      margin-bottom: 40px;
    }
    .hp5-usp-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .hp5-usp-item {
      padding: 30px 20px;
    }
  }
</style>

<section class="hp5-health-usp-{{ section.id }}" aria-label="Why Choose Us">
  <div class="hp5-usp-inner">
    
    <div class="hp5-usp-header">
      {%- if section.settings.label != blank -%}
        <span class="hp5-usp-label">{{ section.settings.label }}</span>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 class="hp5-usp-title">{{ section.settings.title }}</h2>
      {%- endif -%}
    </div>

    <div class="hp5-usp-grid">
      {%- for block in section.blocks -%}
        <div class="hp5-usp-item" {{ block.shopify_attributes }}>
          <div class="hp5-usp-icon-wrap">
            {%- if block.settings.image != blank -%}
              <img height="{{ block.settings.image.height }}" width="{{ block.settings.image.width }}" src="{{ block.settings.image | image_url: width: 100 }}" loading="lazy" alt="Icon">
            {%- else -%}
              <!-- Default Medical/Science SVG icons -->
              {%- case forloop.index -%}
                {%- when 1 -%}
                  <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path></svg>
                {%- when 2 -%}
                  <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
                {%- else -%}
                  <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z"></path></svg>
              {%- endcase -%}
            {%- endif -%}
          </div>
          <h3 class="hp5-usp-item-title">{{ block.settings.title }}</h3>
          <p class="hp5-usp-item-desc">{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}

      {%- if section.blocks.size == 0 -%}
        {%- for i in (1..3) -%}
          <div class="hp5-usp-item">
            <div class="hp5-usp-icon-wrap">
              <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path></svg>
            </div>
            <h3 class="hp5-usp-item-title">Science-Backed</h3>
            <p class="hp5-usp-item-desc">Formulated based on peer-reviewed clinical studies for maximum efficacy and safety.</p>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "HP5 Health USP",
  "tag": "section",
  "class": "section-hp5-usp",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Small Label",
      "default": "THE DIFFERENCE"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Engineered for optimal absorption and real results."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f4f7f9"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1a2a3a"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#0066cc"
    },
    {
      "type": "color",
      "id": "icon_bg",
      "label": "Icon Background",
      "default": "#e6eff6"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Top (Desktop)", "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Bottom (Desktop)", "default": 100
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Top (Mobile)", "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Bottom (Mobile)", "default": 60
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Icon (Optional)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Science-Backed"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Formulated based on peer-reviewed clinical studies for maximum efficacy."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP5 Health USP",
      "category": "Features",
      "blocks": [
        { "type": "feature", "settings": { "title": "Science-Backed", "text": "Formulated based on peer-reviewed clinical studies for maximum efficacy." } },
        { "type": "feature", "settings": { "title": "Bioavailable", "text": "Designed with advanced delivery systems to ensure nutrients actually reach your cells." } },
        { "type": "feature", "settings": { "title": "Clean Label", "text": "No artificial fillers, colors, or binders. 100% transparent ingredient sourcing." } }
      ]
    }
  ]
}
{% endschema %}
