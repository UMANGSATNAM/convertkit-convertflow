{%- style -%}
  #shopify-section-{{ section.id }} {
    --padding-top: {{ section.settings.padding_top }}px;
    --padding-bottom: {{ section.settings.padding_bottom }}px;
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --heading-color: {{ section.settings.heading_color }};
    --accent-color: {{ section.settings.accent_color }};
    
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
    background-color: var(--bg-color);
    color: var(--text-color);
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      --padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      --padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }

  .hp19-brand-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    align-items: {{ section.settings.vertical_alignment }};
    gap: {{ section.settings.desktop_gap }}px;
    flex-direction: {% if section.settings.layout == 'image_right' %}row-reverse{% else %}row{% endif %};
  }

  @media screen and (max-width: 992px) {
    .hp19-brand-wrapper {
      flex-direction: column;
      text-align: {{ section.settings.mobile_text_alignment }};
      gap: {{ section.settings.mobile_gap }}px;
    }
  }

  .hp19-brand__image-block {
    flex: 1;
    position: relative;
    width: 100%;
  }

  {% if section.settings.show_image_decoration %}
  .hp19-brand__image-block::after {
    content: '';
    position: absolute;
    top: -20px;
    left: {% if section.settings.layout == 'image_right' %}20px{% else %}-20px{% endif %};
    right: {% if section.settings.layout == 'image_right' %}-20px{% else %}20px{% endif %};
    bottom: 20px;
    border: {{ section.settings.decoration_thickness }}px solid var(--accent-color);
    z-index: 0;
    pointer-events: none;
    transition: all 0.5s ease;
  }
  
  @media screen and (max-width: 992px) {
    .hp19-brand__image-block::after {
      left: -15px;
      right: 15px;
      top: -15px;
      bottom: 15px;
    }
  }
  {% endif %}

  .hp19-brand__image-container {
    position: relative;
    z-index: 1;
    width: 100%;
    border-radius: {{ section.settings.image_radius }}px;
    overflow: hidden;
    {% if section.settings.aspect_ratio != 'auto' %}
      aspect-ratio: {{ section.settings.aspect_ratio }};
    {% endif %}
  }

  .hp19-brand__image-container img,
  .hp19-brand__image-container svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.8s ease;
  }

  {% if section.settings.enable_hover_zoom %}
  .hp19-brand-wrapper:hover .hp19-brand__image-container img {
    transform: scale(1.05);
  }
  {% endif %}

  .hp19-brand__content-block {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  @media screen and (max-width: 992px) {
    .hp19-brand__content-block {
      align-items: {% if section.settings.mobile_text_alignment == 'center' %}center{% elsif section.settings.mobile_text_alignment == 'right' %}flex-end{% else %}flex-start{% endif %};
    }
  }

  .hp19-brand__tagline {
    font-family: 'Inter', sans-serif;
    font-size: {{ section.settings.tagline_size }}px;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--accent-color);
    margin-bottom: 24px;
    font-weight: 600;
  }

  .hp19-brand__title {
    font-family: 'Baskerville', 'Georgia', serif;
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    font-style: italic;
    color: var(--heading-color);
    margin: 0 0 32px;
    line-height: 1.2;
  }

  .hp19-brand__text {
    font-family: 'Inter', sans-serif;
    font-size: {{ section.settings.text_size }}px;
    line-height: 1.8;
    color: var(--text-color);
    opacity: 0.9;
    margin: 0 0 40px;
  }

  .hp19-brand__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 40px;
    border: 1px solid var(--heading-color);
    color: var(--heading-color);
    background-color: transparent;
    font-family: 'Inter', sans-serif;
    text-transform: uppercase;
    letter-spacing: 2px;
    text-decoration: none;
    font-size: 13px;
    font-weight: 600;
    transition: all 0.3s ease;
    border-radius: {{ section.settings.button_radius }}px;
  }

  .hp19-brand__btn:hover {
    background-color: var(--heading-color);
    color: var(--bg-color);
    transform: translateY(-2px);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp19-brand-wrapper" id="HP19BrandStory-{{ section.id }}">
  <div class="hp19-brand__image-block">
    <div class="hp19-brand__image-container">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 1200 }}" 
             alt="{{ section.settings.image.alt | default: section.settings.title | escape }}" 
             loading="lazy" 
             width="{{ section.settings.image.width }}" 
             height="{{ section.settings.image.height }}">
      {%- else -%}
        {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>
  </div>
  
  <div class="hp19-brand__content-block">
    {%- if section.settings.tagline != blank -%}
      <div class="hp19-brand__tagline">{{ section.settings.tagline | escape }}</div>
    {%- endif -%}
    
    {%- if section.settings.title != blank -%}
      <h2 class="hp19-brand__title">{{ section.settings.title | escape }}</h2>
    {%- endif -%}
    
    {%- if section.settings.text != blank -%}
      <div class="hp19-brand__text">{{ section.settings.text }}</div>
    {%- endif -%}
    
    {%- if section.settings.btn_text != blank and section.settings.btn_link != blank -%}
      <a href="{{ section.settings.btn_link }}" class="hp19-brand__btn">
        {{ section.settings.btn_text | escape }}
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP19 - Brand Story Pro",
  "class": "section-hp19-brand-story",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Image Placement",
      "options": [
        { "value": "image_left", "label": "Image on Left" },
        { "value": "image_right", "label": "Image on Right" }
      ],
      "default": "image_left"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 800,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1200
    },
    {
      "type": "range",
      "id": "desktop_gap",
      "min": 20,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Desktop Gap",
      "default": 80
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Mobile Gap",
      "default": 64
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "Vertical Alignment",
      "options": [
        { "value": "flex-start", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Bottom" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "mobile_text_alignment",
      "label": "Mobile Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Image Settings"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Image Aspect Ratio",
      "options": [
        { "value": "auto", "label": "Original" },
        { "value": "1/1", "label": "Square (1:1)" },
        { "value": "4/5", "label": "Portrait (4:5)" },
        { "value": "3/4", "label": "Portrait (3:4)" },
        { "value": "16/9", "label": "Landscape (16:9)" }
      ],
      "default": "4/5"
    },
    {
      "type": "range",
      "id": "image_radius",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Image Border Radius",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "show_image_decoration",
      "label": "Show Decorative Border",
      "default": true
    },
    {
      "type": "range",
      "id": "decoration_thickness",
      "min": 1,
      "max": 5,
      "step": 1,
      "unit": "px",
      "label": "Decorative Border Thickness",
      "default": 1
    },
    {
      "type": "checkbox",
      "id": "enable_hover_zoom",
      "label": "Enable Image Hover Zoom",
      "default": true
    },
    {
      "type": "header",
      "content": "Text Content"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Our Philosophy"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>We believe that the simplest things in life are often the best. That's why we source only the finest natural ingredients, working closely with farmers and artisans who share our dedication to quality and sustainability.</p>"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "Read Our Story"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "range",
      "id": "button_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Button Border Radius",
      "default": 0
    },
    {
      "type": "header",
      "content": "Typography Settings"
    },
    {
      "type": "range",
      "id": "tagline_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Tagline Size",
      "default": 13
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 48
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Text Size",
      "default": 16
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#451A03"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading/Button Color",
      "default": "#FFFBEB"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFBEB"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#D97706"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 120
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP19 - Brand Story Pro",
      "category": "Image with text"
    }
  ]
}
{% endschema %}
