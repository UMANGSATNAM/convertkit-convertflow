{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#F7FAFC'
  assign text_color = section.settings.text_color | default: '#2D3748'
  assign button_bg = section.settings.button_bg | default: '#2D3748'
  assign button_text = section.settings.button_text | default: '#F7FAFC'
  assign button_border = section.settings.button_border | default: '#2D3748'
  assign desktop_image = section.settings.image
  assign mobile_image = section.settings.image_mobile | default: desktop_image
  assign img_position = section.settings.image_position | default: 'right'
  assign padding_top = section.settings.padding_top | default: 80
  assign padding_bottom = section.settings.padding_bottom | default: 80
  assign padding_top_mobile = section.settings.padding_top_mobile | default: 60
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile | default: 60
  assign desktop_height = section.settings.desktop_height | default: '80vh'
-%}

<style>
  #shopify-section-{{ section_id }} {
    --bg-color: {{ bg_color }};
    --text-color: {{ text_color }};
    --btn-bg: {{ button_bg }};
    --btn-text: {{ button_text }};
    --btn-border: {{ button_border }};
    --padding-top: {{ padding_top }}px;
    --padding-bottom: {{ padding_bottom }}px;
    --padding-top-mobile: {{ padding_top_mobile }}px;
    --padding-bottom-mobile: {{ padding_bottom_mobile }}px;
    --desktop-height: {{ desktop_height }};
    
    background-color: var(--bg-color);
    color: var(--text-color);
    overflow: hidden;
  }

  .hpv6-hero-{{ section_id }} {
    display: flex;
    flex-wrap: wrap;
    min-height: var(--desktop-height);
    flex-direction: {% if img_position == 'left' %}row-reverse{% else %}row{% endif %};
  }

  .hpv6-hero__content-wrap {
    flex: 1 1 50%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--padding-top) 6vw var(--padding-bottom) 6vw;
    box-sizing: border-box;
    opacity: 0;
    transform: translateY(20px);
    animation: hpv6FadeInUp 0.8s forwards 0.2s;
  }

  @keyframes hpv6FadeInUp {
    to { opacity: 1; transform: translateY(0); }
  }

  .hpv6-hero__image-wrap {
    flex: 1 1 50%;
    position: relative;
    min-height: 400px;
    background-color: #E2E8F0;
    overflow: hidden;
  }

  .hpv6-hero__image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    animation: hpv6FadeIn 1.2s forwards;
  }

  .hpv6-hero__image--mobile {
    display: none;
  }

  @keyframes hpv6FadeIn {
    to { opacity: 1; }
  }

  .hpv6-hero__subtitle {
    font-family: 'Inter', sans-serif;
    font-size: clamp(11px, 1vw, 13px);
    letter-spacing: 3px;
    text-transform: uppercase;
    margin-bottom: 2rem;
    font-weight: 500;
  }

  .hpv6-hero__title {
    font-family: 'Playfair Display', 'Georgia', serif;
    font-size: clamp(3rem, 6vw, 5.5rem);
    line-height: 1.1;
    font-weight: 400;
    margin-bottom: 2rem;
    letter-spacing: -0.02em;
  }

  .hpv6-hero__text {
    font-family: 'Inter', sans-serif;
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    line-height: 1.6;
    max-width: 480px;
    margin-bottom: 3rem;
    opacity: 0.85;
  }

  .hpv6-hero__buttons {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .hpv6-hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 18px 40px;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    letter-spacing: 2px;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    min-width: 160px;
  }

  .hpv6-hero__btn--primary {
    background-color: var(--btn-bg);
    color: var(--btn-text);
    border: 1px solid var(--btn-border);
  }

  .hpv6-hero__btn--primary:hover {
    background-color: transparent;
    color: var(--text-color);
    border-color: var(--text-color);
  }

  .hpv6-hero__btn--secondary {
    background-color: transparent;
    color: var(--text-color);
    border: 1px solid var(--text-color);
  }

  .hpv6-hero__btn--secondary:hover {
    background-color: var(--btn-bg);
    color: var(--btn-text);
    border-color: var(--btn-border);
  }

  @media screen and (max-width: 989px) {
    .hpv6-hero-{{ section_id }} {
      flex-direction: column-reverse;
      min-height: auto;
    }
    .hpv6-hero__content-wrap {
      flex: 1 1 100%;
      padding: var(--padding-top-mobile) 5vw var(--padding-bottom-mobile) 5vw;
      align-items: flex-start;
    }
    .hpv6-hero__image-wrap {
      flex: 1 1 100%;
      height: 60vh;
      min-height: 300px;
    }
    .hpv6-hero__image--desktop {
      display: none;
    }
    .hpv6-hero__image--mobile {
      display: block;
    }
  }
</style>

<div class="hpv6-hero-{{ section_id }}">
  <div class="hpv6-hero__content-wrap">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'subtitle' -%}
          {%- if block.settings.text != blank -%}
            <div class="hpv6-hero__subtitle" {{ block.shopify_attributes }}>
              {{ block.settings.text | escape }}
            </div>
          {%- endif -%}

        {%- when 'title' -%}
          {%- if block.settings.text != blank -%}
            <h1 class="hpv6-hero__title" {{ block.shopify_attributes }}>
              {{ block.settings.text | newline_to_br }}
            </h1>
          {%- endif -%}

        {%- when 'text' -%}
          {%- if block.settings.text != blank -%}
            <div class="hpv6-hero__text" {{ block.shopify_attributes }}>
              {{ block.settings.text }}
            </div>
          {%- endif -%}

        {%- when 'buttons' -%}
          <div class="hpv6-hero__buttons" {{ block.shopify_attributes }}>
            {%- if block.settings.button_label_1 != blank -%}
              <a href="{{ block.settings.button_link_1 | default: '#' }}" class="hpv6-hero__btn hpv6-hero__btn--primary" aria-label="{{ block.settings.button_label_1 }}">
                {{ block.settings.button_label_1 | escape }}
              </a>
            {%- endif -%}
            {%- if block.settings.button_label_2 != blank -%}
              <a href="{{ block.settings.button_link_2 | default: '#' }}" class="hpv6-hero__btn hpv6-hero__btn--secondary" aria-label="{{ block.settings.button_label_2 }}">
                {{ block.settings.button_label_2 | escape }}
              </a>
            {%- endif -%}
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>

  <div class="hpv6-hero__image-wrap">
    {%- if desktop_image != blank -%}
      {{ desktop_image | image_url: width: 2000 | image_tag: 
         class: 'hpv6-hero__image hpv6-hero__image--desktop',
         loading: 'eager',
         sizes: '(min-width: 990px) 50vw, 100vw',
         widths: '400, 600, 800, 1000, 1200, 1600, 2000'
      }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'hpv6-hero__image hpv6-hero__image--desktop' }}
    {%- endif -%}

    {%- if mobile_image != blank -%}
      {{ mobile_image | image_url: width: 1200 | image_tag: 
         class: 'hpv6-hero__image hpv6-hero__image--mobile',
         loading: 'eager',
         sizes: '100vw',
         widths: '400, 600, 800, 1000, 1200'
      }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'hpv6-hero__image hpv6-hero__image--mobile' }}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HPV6 Split Hero",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop Image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile Image",
      "info": "Optional. Falls back to desktop image if blank."
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Desktop Image Position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "right"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#F7FAFC"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#2D3748"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Primary Button Background",
      "default": "#2D3748"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Primary Button Text",
      "default": "#F7FAFC"
    },
    {
      "type": "color",
      "id": "button_border",
      "label": "Primary Button Border",
      "default": "#2D3748"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "desktop_height",
      "label": "Desktop Height",
      "options": [
        { "value": "60vh", "label": "Small (60vh)" },
        { "value": "80vh", "label": "Medium (80vh)" },
        { "value": "100vh", "label": "Full Screen (100vh)" }
      ],
      "default": "80vh"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Desktop Padding Top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Desktop Padding Bottom",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "subtitle",
      "name": "Subtitle",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "New Arrival" }
      ]
    },
    {
      "type": "title",
      "name": "Title",
      "limit": 1,
      "settings": [
        { "type": "textarea", "id": "text", "label": "Text", "default": "Nordic Serenity" }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "limit": 1,
      "settings": [
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Embrace the calm of Scandinavian minimalism with our newest curated collection.</p>" }
      ]
    },
    {
      "type": "buttons",
      "name": "Buttons",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "button_label_1",
          "label": "Primary Button Label",
          "default": "Explore Now"
        },
        {
          "type": "url",
          "id": "button_link_1",
          "label": "Primary Button Link"
        },
        {
          "type": "text",
          "id": "button_label_2",
          "label": "Secondary Button Label",
          "default": "Learn More"
        },
        {
          "type": "url",
          "id": "button_link_2",
          "label": "Secondary Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HPV6 Split Hero",
      "blocks": [
        { "type": "subtitle" },
        { "type": "title" },
        { "type": "text" },
        { "type": "buttons" }
      ]
    }
  ]
}
{% endschema %}
