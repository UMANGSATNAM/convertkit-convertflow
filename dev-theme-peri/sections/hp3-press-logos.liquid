{%- liquid
  assign bg_color = section.settings.bg_color | default: '#050505'
  assign text_color = section.settings.text_color | default: '#ffffff'
  assign speed = section.settings.animation_speed | default: 20
  
  assign padding_top_desktop = section.settings.padding_top_desktop
  assign padding_bottom_desktop = section.settings.padding_bottom_desktop
  assign padding_top_mobile = section.settings.padding_top_mobile
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile
-%}

<style>
  #shopify-section-{{ section.id }} {
    --hp3-press-bg: {{ bg_color }};
    --hp3-press-text: {{ text_color }};
    --hp3-press-speed: {{ speed }}s;
    
    --hp3-press-pt-desk: {{ padding_top_desktop }}px;
    --hp3-press-pb-desk: {{ padding_bottom_desktop }}px;
    --hp3-press-pt-mob: {{ padding_top_mobile }}px;
    --hp3-press-pb-mob: {{ padding_bottom_mobile }}px;
  }

  .hp3-tech-press-{{ section.id }} {
    padding-top: var(--hp3-press-pt-desk);
    padding-bottom: var(--hp3-press-pb-desk);
    background-color: var(--hp3-press-bg);
    color: var(--hp3-press-text);
    font-family: 'Inter', sans-serif;
    border-top: 1px solid rgba(255,255,255,0.05);
    border-bottom: 1px solid rgba(255,255,255,0.05);
    overflow: hidden;
  }

  .hp3-press-inner {
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    align-items: center;
    gap: 40px;
  }

  .hp3-press-header {
    flex-shrink: 0;
    width: 200px;
    border-right: 2px solid rgba(255,255,255,0.1);
  }
  
  .hp3-press-title {
    font-size: 14px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin: 0;
    color: rgba(255,255,255,0.5);
  }

  .hp3-press-track-wrapper {
    flex-grow: 1;
    overflow: hidden;
    position: relative;
    mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
  }

  .hp3-press-track {
    display: flex;
    align-items: center;
    white-space: nowrap;
    will-change: transform;
    animation: hp3PressMarquee var(--hp3-press-speed) linear infinite;
  }

  .hp3-press-item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 50px;
    flex-shrink: 0;
  }

  .hp3-press-logo {
    height: {{ section.settings.logo_height }}px;
    width: auto;
    max-width: 200px;
    object-fit: contain;
    /* High contrast tech feel */
    filter: invert(1) brightness(2) opacity(0.4);
    transition: all 0.3s ease;
  }
  
  /* Fallback text if no logo image */
  .hp3-press-text {
    font-size: 24px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.5px;
    opacity: 0.4;
    transition: all 0.3s ease;
  }

  /* Highlight on hover */
  .hp3-press-item:hover .hp3-press-logo {
    filter: invert(1) brightness(2) opacity(1);
    transform: scale(1.1);
  }
  .hp3-press-item:hover .hp3-press-text {
    opacity: 1;
    transform: scale(1.1);
    color: var(--hp3-press-accent, #00ffcc);
  }

  @keyframes hp3PressMarquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); } 
  }

  @media screen and (max-width: 1024px) {
    .hp3-press-inner {
      flex-direction: column;
      align-items: center;
      gap: 30px;
    }
    .hp3-press-header {
      width: 100%;
      border-right: none;
      text-align: center;
    }
    .hp3-press-track-wrapper {
      width: 100%;
    }
  }

  @media screen and (max-width: 768px) {
    .hp3-tech-press-{{ section.id }} {
      padding-top: var(--hp3-press-pt-mob);
      padding-bottom: var(--hp3-press-pb-mob);
    }
    .hp3-press-inner {
      padding: 0 20px;
    }
    .hp3-press-item {
      padding: 0 30px;
    }
    .hp3-press-logo {
      height: {{ section.settings.logo_height_mobile }}px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hp3-press-track {
      animation: none !important;
      transform: none !important;
      flex-wrap: wrap;
      justify-content: center;
    }
    .hp3-press-item {
      margin: 15px;
    }
    .hp3-press-track .hp3-press-item:nth-child(n+{{ section.blocks.size | plus: 1 }}) {
      display: none;
    }
  }
</style>

<section class="hp3-tech-press-{{ section.id }}" aria-label="Press Logos">
  <div class="hp3-press-inner">
    
    {%- if section.settings.heading != blank -%}
      <div class="hp3-press-header">
        <h2 class="hp3-press-title">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    <div class="hp3-press-track-wrapper">
      <div class="hp3-press-track">
        
        {%- capture press_content -%}
          {%- for block in section.blocks -%}
            <div class="hp3-press-item" {{ block.shopify_attributes }}>
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}" target="_blank" rel="noopener" aria-label="Read review">
              {%- endif -%}
              
              {%- if block.settings.logo != blank -%}
                <img height="{{ block.settings.logo.height }}" width="{{ block.settings.logo.width }}" src="{{ block.settings.logo | image_url: width: 400 }}" 
                     class="hp3-press-logo" 
                     loading="lazy" 
                     alt="{{ block.settings.logo.alt | default: block.settings.title | escape }}">
              {%- else -%}
                <span class="hp3-press-text">{{ block.settings.title | default: 'WIRED' }}</span>
              {%- endif -%}
              
              {%- if block.settings.link != blank -%}
                </a>
              {%- endif -%}
            </div>
          {%- endfor -%}
          
          {%- if section.blocks.size == 0 -%}
            <div class="hp3-press-item"><span class="hp3-press-text">TECHCRUNCH</span></div>
            <div class="hp3-press-item"><span class="hp3-press-text">THE VERGE</span></div>
            <div class="hp3-press-item"><span class="hp3-press-text">WIRED</span></div>
            <div class="hp3-press-item"><span class="hp3-press-text">ENGADGET</span></div>
            <div class="hp3-press-item"><span class="hp3-press-text">CNET</span></div>
          {%- endif -%}
        {%- endcapture -%}

        {{ press_content }}
        {{ press_content }}
        
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "HP3 Tech Press Logos",
  "tag": "section",
  "class": "section-hp3-press",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FEATURED ON"
    },
    {
      "type": "range",
      "id": "logo_height",
      "min": 20, "max": 100, "step": 2, "unit": "px",
      "label": "Desktop Logo Height",
      "default": 30
    },
    {
      "type": "range",
      "id": "logo_height_mobile",
      "min": 10, "max": 60, "step": 2, "unit": "px",
      "label": "Mobile Logo Height",
      "default": 20
    },
    {
      "type": "range",
      "id": "animation_speed",
      "min": 10, "max": 60, "step": 1, "unit": "sec",
      "label": "Scroll Speed",
      "default": 25
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#050505"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Top (Desktop)", "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Bottom (Desktop)", "default": 40
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Top (Mobile)", "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Bottom (Mobile)", "default": 30
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo Image (PNG recommended)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Fallback Name"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP3 Tech Press Logos (Adv)",
      "category": "Trust"
    }
  ]
}
{% endschema %}
