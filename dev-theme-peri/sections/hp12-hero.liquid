{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#FAFAFA'
  assign text_color = section.settings.text_color | default: '#333333'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 60px 40px;
  }
  
  .hp12-hero-container-{{ section_id }} {
    max-width: 1600px;
    margin: 0 auto;
    position: relative;
    width: 100%;
    height: 70vh;
    min-height: 500px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  
  .hp12-hero-bg-{{ section_id }} {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover;
    opacity: 0.9;
  }
  
  .hp12-hero-content-{{ section_id }} {
    position: relative;
    z-index: 3;
    text-align: center;
    color: {{ text_color }};
    max-width: 800px;
    padding: 40px;
  }
  
  .hp12-hero-heading-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 300;
    line-height: 1.1;
    margin: 0 0 30px 0;
    letter-spacing: 2px;
  }
  
  .hp12-hero-btn-{{ section_id }} {
    display: inline-block;
    color: {{ text_color }};
    padding: 10px 0;
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    font-weight: 400;
    text-transform: uppercase;
    text-decoration: none;
    letter-spacing: 2px;
    border-bottom: 1px solid {{ text_color }};
    transition: opacity 0.3s ease;
  }
  
  .hp12-hero-btn-{{ section_id }}:hover {
    opacity: 0.5;
  }
  
  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 20px;
    }
    .hp12-hero-container-{{ section_id }} {
      height: 60vh;
    }
    .hp12-hero-content-{{ section_id }} {
      padding: 20px;
    }
  }
</style>

<div class="hp12-hero-container-{{ section_id }}">
  {% if section.settings.image != blank %}
    <img height="{{ section.settings.image.height }}" width="{{ section.settings.image.width }}" src="{{ section.settings.image | image_url: width: 2000 }}" alt="Hero" class="hp12-hero-bg-{{ section_id }}">
  {% else %}
    <div class="hp12-hero-bg-{{ section_id }}" style="background: repeating-linear-gradient(45deg, #EFEFEF, #EFEFEF 12px, #E6E6E6 12px, #E6E6E6 24px);"></div>
  {% endif %}
  
  <div class="hp12-hero-content-{{ section_id }}">
    <h1 class="hp12-hero-heading-{{ section_id }}">{{ section.settings.heading | default: 'Forms of silence.' }}</h1>
    
    {% if section.settings.button_label != blank %}
      <a href="{{ section.settings.button_link | default: '#' }}" class="hp12-hero-btn-{{ section_id }}">
        {{ section.settings.button_label }}
      </a>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "HP12 Hero",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Outer Background Color",
      "default": "#FAFAFA"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#333333"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Forms of silence."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Explore"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "HP12 Hero"
    }
  ]
}
{% endschema %}
