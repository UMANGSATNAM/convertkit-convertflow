{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp48-insta-bg: {{ section.settings.bg_color | default: '#FAF8F5' }};
    --hp48-gold: {{ section.settings.accent_gold | default: '#C59B27' }};
    
    background-color: var(--hp48-insta-bg);
    padding-top: {{ section.settings.padding_top | default: 70 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 70 }}px;
  }

  .hp48-insta__wrap {
    max-width: {{ section.settings.container_width | default: 1240 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp48-insta__header {
    text-align: center;
    margin-bottom: 40px;
  }

  .hp48-insta__sub {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--hp48-gold);
    margin: 0 0 8px;
  }

  .hp48-insta__heading {
    font-family: 'Cinzel', serif;
    font-size: clamp(28px, 4vw, 38px);
    font-weight: 700;
    color: #1A1715;
    margin: 0;
  }

  .hp48-insta__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: 4 }}, 1fr);
    gap: 18px;
  }

  .hp48-insta__item {
    aspect-ratio: 1;
    border-radius: 8px;
    overflow: hidden;
    position: relative;
    border: 1px solid rgba(197, 155, 39, 0.3);
    box-shadow: 0 10px 30px rgba(26, 23, 21, 0.05);
  }

  .hp48-insta__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .hp48-insta__item:hover .hp48-insta__img { transform: scale(1.06); }

  .hp48-insta__tag {
    position: absolute;
    bottom: 12px; left: 12px;
    background: rgba(26, 23, 21, 0.9);
    border: 1px solid var(--hp48-gold);
    color: var(--hp48-gold);
    font-family: 'Montserrat', sans-serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 6px 12px;
    border-radius: 4px;
  }

  @media screen and (max-width: 992px) {
    .hp48-insta__grid { grid-template-columns: repeat(2, 1fr); }
  }
{%- endstyle -%}

<div class="hp48-insta__wrap">
  <div class="hp48-insta__header">
    <p class="hp48-insta__sub">{{ section.settings.subheading | default: '@PERI_ROYAL' }}</p>
    <h2 class="hp48-insta__heading">{{ section.settings.heading | default: 'Shop The Sovereign Gallery' }}</h2>
  </div>

  <div class="hp48-insta__grid">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <div class="hp48-insta__item" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 600 }}" class="hp48-insta__img" alt="{{ block.settings.tag }}" loading="lazy">
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'hp48-insta__img' }}
          {%- endif -%}
          <span class="hp48-insta__tag">{{ block.settings.tag | default: 'Shop 24K Nectar' }}</span>
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="hp48-insta__item">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'hp48-insta__img' }}
        <span class="hp48-insta__tag">Shop 24K Nectar</span>
      </div>
      <div class="hp48-insta__item">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'hp48-insta__img' }}
        <span class="hp48-insta__tag">Shop Velvet Crème</span>
      </div>
      <div class="hp48-insta__item">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'hp48-insta__img' }}
        <span class="hp48-insta__tag">Shop Pearl Oil</span>
      </div>
      <div class="hp48-insta__item">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'hp48-insta__img' }}
        <span class="hp48-insta__tag">Shop Gold Foil Mask</span>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP48 - Royal Lookbook",
  "class": "section-hp48-lookbook",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#FAF8F5" },
    { "type": "color", "id": "accent_gold", "label": "Gold Accent", "default": "#C59B27" },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "label": "Desktop Columns", "default": 4 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 70 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 70 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1240 }
  ],
  "blocks": [
    {
      "type": "gallery_item",
      "name": "Lookbook Item",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "tag", "label": "Tag", "default": "Shop 24K Nectar" }
      ]
    }
  ],
  "presets": [
    { "name": "HP48 - Royal Lookbook" }
  ]
}
{% endschema %}
