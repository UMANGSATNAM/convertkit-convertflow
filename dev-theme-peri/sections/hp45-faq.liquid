{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp45-faq-bg: {{ section.settings.bg_color | default: '#F5F5F0' }};
    --hp45-border: {{ section.settings.border_color | default: '#0A0A0A' }};
    
    background-color: var(--hp45-faq-bg);
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
  }

  .hp45-faq__wrap {
    max-width: {{ section.settings.container_width | default: 860 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp45-faq__header {
    text-align: center;
    margin-bottom: 45px;
  }

  .hp45-faq__heading {
    font-size: clamp(28px, 4vw, 40px);
    font-weight: 700;
    text-transform: uppercase;
    color: #0A0A0A;
    margin: 0 0 8px;
  }

  .hp45-faq__item {
    background: #FFFFFF;
    border: 2px solid var(--hp45-border);
    box-shadow: 4px 4px 0 var(--hp45-border);
    padding: 22px 26px;
    margin-bottom: 16px;
    cursor: pointer;
  }

  .hp45-faq__q {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 16px;
    font-weight: 700;
    text-transform: uppercase;
    color: #0A0A0A;
    margin: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .hp45-faq__a {
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    line-height: 1.7;
    color: #4A4A4A;
    margin: 14px 0 0;
    padding-top: 14px;
    border-top: 1.5px solid #EAEAE5;
  }
{%- endstyle -%}

<div class="hp45-faq__wrap">
  <div class="hp45-faq__header">
    <h2 class="hp45-faq__heading">{{ section.settings.heading | default: 'PROTOCOL SPECIFICATION FAQ' }}</h2>
    <p style="font-family:'JetBrains Mono', monospace; font-size:13px; color:#555;">{{ section.settings.subheading | default: 'Technical answers regarding stoichiometry, carrier fluids, and global DDP clearance.' }}</p>
  </div>

  {%- if section.blocks.size > 0 -%}
    {%- for block in section.blocks -%}
      <div class="hp45-faq__item" {{ block.shopify_attributes }}>
        <h3 class="hp45-faq__q">
          <span>{{ block.settings.question }}</span>
          <span>[+]</span>
        </h3>
        <p class="hp45-faq__a">{{ block.settings.answer }}</p>
      </div>
    {%- endfor -%}
  {%- else -%}
    <div class="hp45-faq__item">
      <h3 class="hp45-faq__q"><span>ARE CHEMICAL FRAGRANCES PRESENT IN V45 FORMULATIONS?</span><span>[+]</span></h3>
      <p class="hp45-faq__a">Zero artificial perfumes or fragrance masking agents are added. The aroma profile is strictly derived from raw botanical and peptide ingredients.</p>
    </div>
    <div class="hp45-faq__item">
      <h3 class="hp45-faq__q"><span>WHAT IS THE PROTOCOL FOR AIR CARRIER IMPORT DUTIES?</span><span>[+]</span></h3>
      <p class="hp45-faq__a">All shipments are dispatched via Delivered Duty Paid (DDP). 100% of import duties and taxes are finalized at checkout.</p>
    </div>
    <div class="hp45-faq__item">
      <h3 class="hp45-faq__q"><span>HOW SHOULD COMPOUNDS BE STORED AFTER DEPLOYMENT?</span><span>[+]</span></h3>
      <p class="hp45-faq__a">Store in ambient room conditions between 15°C and 25°C. Keep vessels securely sealed in heavy borosilicate glass away from direct solar radiation.</p>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "HP45 - Brutal FAQ",
  "class": "section-hp45-faq",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#F5F5F0" },
    { "type": "color", "id": "border_color", "label": "Border Color", "default": "#0A0A0A" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "PROTOCOL SPECIFICATION FAQ" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Technical answers regarding stoichiometry, carrier fluids, and global DDP clearance." },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 80 },
    { "type": "range", "id": "container_width", "min": 600, "max": 1200, "step": 20, "unit": "px", "label": "Container Width", "default": 860 }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "ARE CHEMICAL FRAGRANCES PRESENT IN V45?" },
        { "type": "textarea", "id": "answer", "label": "Answer", "default": "Zero artificial perfumes or fragrance masking agents are added." }
      ]
    }
  ],
  "presets": [
    { "name": "HP45 - Brutal FAQ" }
  ]
}
{% endschema %}
