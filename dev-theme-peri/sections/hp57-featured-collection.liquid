{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#1B4332' }};
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }
  .hp57-fc__container { max-width: {{ section.settings.container_width | default: 1280 }}px; margin: 0 auto; padding: 0 24px; }
  .hp57-fc__header { text-align: center; margin-bottom: 50px; }
  .hp57-fc__eyebrow { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: {{ section.settings.accent_color | default: '#D97706' }}; margin: 0 0 12px; }
  .hp57-fc__heading { font-family: 'Cormorant Garamond', serif; font-size: clamp(30px, 4vw, 46px); font-weight: 700; color: #FFFFFF; margin: 0; }
  .hp57-fc__grid { display: grid; grid-template-columns: repeat({{ section.settings.columns | default: 4 }}, 1fr); gap: 20px; }
  .hp57-fc__card {
    background: {{ section.settings.card_bg | default: '#0F291E' }};
    border: 1px solid rgba(167, 243, 208, 0.15);
    border-radius: 12px; overflow: hidden;
    transition: transform 0.3s ease, border-color 0.3s ease;
  }
  .hp57-fc__card:hover { transform: translateY(-6px); border-color: rgba(217, 119, 6, 0.5); }
  .hp57-fc__img-wrap { aspect-ratio: 3/4; overflow: hidden; background: #0A1C14; }
  .hp57-fc__img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
  .hp57-fc__card:hover .hp57-fc__img { transform: scale(1.06); }
  .hp57-fc__info { padding: 18px 16px; }
  .hp57-fc__product-title { font-family: 'Cormorant Garamond', serif; font-size: 17px; font-weight: 700; color: #FFFFFF; margin: 0 0 6px; text-decoration: none; display: block; }
  .hp57-fc__price { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 15px; font-weight: 700; color: {{ section.settings.accent_color | default: '#D97706' }}; margin: 0; }
  .hp57-fc__view-all { display: block; text-align: center; margin-top: 40px; }
  .hp57-fc__view-btn {
    display: inline-flex; align-items: center; gap: 8px; padding: 14px 34px;
    background: {{ section.settings.btn_bg | default: '#D97706' }}; color: #0F291E;
    font-family: 'Plus Jakarta Sans', sans-serif; font-size: 13px; font-weight: 700;
    text-decoration: none; border-radius: 6px; transition: all 0.3s ease;
    box-shadow: 0 4px 16px rgba(217, 119, 6, 0.3);
  }
  .hp57-fc__view-btn:hover { box-shadow: 0 8px 25px rgba(217, 119, 6, 0.5); transform: translateY(-2px); }
  @media screen and (max-width: 992px) { .hp57-fc__grid { grid-template-columns: repeat(2, 1fr); } }
  @media screen and (max-width: 480px) { .hp57-fc__grid { grid-template-columns: repeat(2, 1fr); gap: 12px; } }
{%- endstyle -%}
<div class="hp57-fc__container">
  <div class="hp57-fc__header">
    {%- if section.settings.eyebrow != blank -%}<p class="hp57-fc__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="hp57-fc__heading">{{ section.settings.heading | default: 'The Apothecary Compendium' }}</h2>
  </div>
  {%- assign collection = collections[section.settings.collection] -%}
  <div class="hp57-fc__grid">
    {%- for product in collection.products limit: section.settings.products_to_show -%}
      <div class="hp57-fc__card">
        <a href="{{ product.url }}" class="hp57-fc__img-wrap">
          {%- if product.featured_image != blank -%}<img height="{{ product.featured_image.height }}" width="{{ product.featured_image.width }}" src="{{ product.featured_image | image_url: width: 600 }}" class="hp57-fc__img" alt="{{ product.title }}" loading="lazy">{%- endif -%}
        </a>
        <div class="hp57-fc__info">
          <a href="{{ product.url }}" class="hp57-fc__product-title">{{ product.title }}</a>
          <p class="hp57-fc__price">{{ product.price | money }}</p>
        </div>
      </div>
    {%- endfor -%}
  </div>
  {%- if section.settings.show_view_all -%}
    <div class="hp57-fc__view-all"><a href="{{ collection.url | default: '/collections/all' }}" class="hp57-fc__view-btn">{{ section.settings.view_all_text | default: 'View All' }} &rarr;</a></div>
  {%- endif -%}
</div>
{% schema %}
{
  "name": "HP57 Collection",
  "class": "section-hp57-fc",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#1B4332" },
    { "type": "color", "id": "card_bg", "label": "Card BG", "default": "#0F291E" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#D97706" },
    { "type": "color", "id": "btn_bg", "label": "Button BG", "default": "#D97706" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "🌿 BOTANICAL ARCHIVE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Apothecary Compendium" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 12, "step": 1, "label": "Products", "default": 4 },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "label": "Columns", "default": 4 },
    { "type": "checkbox", "id": "show_view_all", "label": "Show View All", "default": true },
    { "type": "text", "id": "view_all_text", "label": "View All Text", "default": "View All" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "presets": [{ "name": "HP57 Collection" }]
}
{% endschema %}
