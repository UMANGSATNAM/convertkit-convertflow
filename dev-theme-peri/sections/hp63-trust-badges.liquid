{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#FFFBEB' }};
    padding-top: {{ section.settings.padding_top | default: 50 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 50 }}px;
    border-top: 1px solid rgba(136, 19, 55, 0.12);
  }
  .hp63-trust__container { max-width: {{ section.settings.container_width | default: 1280 }}px; margin: 0 auto; padding: 0 24px; }
  .hp63-trust__grid { display: flex; justify-content: center; gap: 50px; flex-wrap: wrap; }
  .hp63-trust__item { display: flex; align-items: center; gap: 14px; }
  .hp63-trust__icon {
    width: 44px; height: 44px; background: #FFFFFF;
    border-radius: 4px; display: flex; align-items: center; justify-content: center;
    font-size: 18px; color: #881337; flex-shrink: 0;
    border: 1px solid rgba(217, 119, 6, 0.3); box-shadow: 0 4px 15px rgba(136, 19, 55, 0.05);
  }
  .hp63-trust__label { font-family: 'Playfair Display', serif; font-size: 17px; font-weight: 700; color: #1C1917; margin: 0; }
  .hp63-trust__sub { font-size: 11px; color: #881337; margin: 2px 0 0; font-family: 'Plus Jakarta Sans', sans-serif; letter-spacing: 0.5px; }
  @media screen and (max-width: 768px) { .hp63-trust__grid { gap: 24px; } }
  @media screen and (max-width: 480px) {
    .hp63-trust__grid { flex-direction: column; align-items: center; text-align: center; }
    .hp63-trust__item { flex-direction: column; }
  }
{%- endstyle -%}
<div class="hp63-trust__container">
  <div class="hp63-trust__grid">
    {%- for block in section.blocks -%}
      <div class="hp63-trust__item" {{ block.shopify_attributes }}>
        <div class="hp63-trust__icon">{{ block.settings.icon | default: '🌹' }}</div>
        <div>
          <p class="hp63-trust__label">{{ block.settings.title | default: '100% Dades Valley' }}</p>
          <p class="hp63-trust__sub">{{ block.settings.subtitle | default: 'Single origin Moroccan harvest' }}</p>
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "HP63 Trust",
  "class": "section-hp63-trust",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FFFBEB" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 100, "step": 10, "unit": "px", "label": "Padding Top", "default": 50 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 100, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 50 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "blocks": [{
    "type": "badge", "name": "Badge",
    "settings": [
      { "type": "text", "id": "icon", "label": "Icon", "default": "🌹" },
      { "type": "text", "id": "title", "label": "Title", "default": "100% Dades Valley" },
      { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Single origin Moroccan harvest" }
    ]
  }],
  "presets": [{
    "name": "HP63 Trust",
    "blocks": [
      { "type": "badge", "settings": { "icon": "🌹", "title": "100% Dades Valley", "subtitle": "Single origin Moroccan harvest" } },
      { "type": "badge", "settings": { "icon": "🏺", "title": "Copper Alembic Distilled", "subtitle": "Pure steam extraction" } },
      { "type": "badge", "settings": { "icon": "📦", "title": "Velvet Keepsake Box", "subtitle": "Luxury artisan packaging" } },
      { "type": "badge", "settings": { "icon": "🛡️", "title": "Rose Purity Guarantee", "subtitle": "60-day satisfaction pledge" } }
    ]
  }]
}
{% endschema %}
