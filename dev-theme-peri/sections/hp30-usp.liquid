{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;700&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --border-color: {{ section.settings.border_color }};
    
    --font-body: 'Space Grotesk', sans-serif;
    
    background-color: var(--bg-color);
    border-bottom: 4px solid var(--border-color);
  }

  .hp30-usp-grid {
    display: grid;
    grid-template-columns: repeat({{ section.blocks.size }}, 1fr);
    max-width: 1800px;
    margin: 0 auto;
    border-left: 4px solid var(--border-color);
    border-right: 4px solid var(--border-color);
  }

  @media screen and (max-width: 992px) {
    .hp30-usp-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 576px) {
    .hp30-usp-grid {
      grid-template-columns: 1fr;
    }
  }

  .hp30-usp__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 60px 30px;
    border-right: 4px solid var(--border-color);
    transition: background-color 0s;
  }

  .hp30-usp__item:last-child {
    border-right: none;
  }

  @media screen and (max-width: 992px) {
    .hp30-usp__item:nth-child(2n) {
      border-right: none;
    }
    .hp30-usp__item {
      border-bottom: 4px solid var(--border-color);
    }
    .hp30-usp__item:nth-last-child(-n+2) {
      border-bottom: none;
    }
  }

  @media screen and (max-width: 576px) {
    .hp30-usp__item:nth-child(n) {
      border-right: none;
      border-bottom: 4px solid var(--border-color);
    }
    .hp30-usp__item:last-child {
      border-bottom: none;
    }
  }

  .hp30-usp__item:hover {
    background-color: var(--text-color);
    color: var(--bg-color);
  }

  .hp30-usp__item:hover .hp30-usp__icon,
  .hp30-usp__item:hover .hp30-usp__title,
  .hp30-usp__item:hover .hp30-usp__text {
    color: var(--bg-color);
  }

  .hp30-usp__icon {
    width: 48px;
    height: 48px;
    margin-bottom: 20px;
    color: var(--text-color);
  }

  .hp30-usp__icon svg {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: square;
    stroke-linejoin: miter;
  }

  .hp30-usp__title {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--text-color);
    margin: 0 0 10px;
  }

  .hp30-usp__text {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 400;
    color: var(--text-color);
    opacity: 0.8;
    margin: 0;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp30-usp-grid" id="HP30USP-{{ section.id }}">
  {%- for block in section.blocks -%}
    <div class="hp30-usp__item" {{ block.shopify_attributes }}>
      <div class="hp30-usp__icon">
        {%- if block.settings.custom_svg != blank -%}
          {{ block.settings.custom_svg }}
        {%- else -%}
          <!-- Fallback Brutalist Icon -->
          <svg viewBox="0 0 24 24">
            <rect x="3" y="3" width="18" height="18" />
            <line x1="3" y1="3" x2="21" y2="21" />
          </svg>
        {%- endif -%}
      </div>
      <h3 class="hp30-usp__title">{{ block.settings.title }}</h3>
      {%- if block.settings.text != blank -%}
        <p class="hp30-usp__text">{{ block.settings.text }}</p>
      {%- endif -%}
    </div>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "HP30 - Brutalist USP",
  "class": "section-hp30-usp",
  "max_blocks": 4,
  "settings": [
    {
      "type": "header",
      "content": "Brutalist Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text / Hover Bg",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Borders",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "usp",
      "name": "Value Proposition",
      "settings": [
        {
          "type": "html",
          "id": "custom_svg",
          "label": "Custom SVG Icon",
          "info": "Use stark, sharp vector icons."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "GLOBAL SHIPPING"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Express delivery worldwide."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP30 - Brutalist USP",
      "blocks": [
        { "type": "usp", "settings": { "title": "SECURE CHECKOUT" } },
        { "type": "usp", "settings": { "title": "24/7 SUPPORT" } },
        { "type": "usp", "settings": { "title": "EASY RETURNS" } },
        { "type": "usp", "settings": { "title": "AUTHENTICITY" } }
      ]
    }
  ]
}
{% endschema %}
