{% comment %} CL V46 — Gothic / Dark Academia {% endcomment %}
{{ 'component-facets.css' | asset_url | stylesheet_tag }}
<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
<style>
  .clv46 { background: {{ section.settings.bg_color | default: '#121212' }}; color: {{ section.settings.text_color | default: '#E0E0E0' }}; padding: 60px 20px; font-family: 'Cinzel', serif; }
  .clv46-hero { text-align: center; margin-bottom: 50px; padding: 50px 20px; border: 1px solid #4A0404; background: radial-gradient(circle, #2A0808 0%, #121212 100%); position: relative; }
  .clv46-hero::before { content: '❦'; position: absolute; top: 10px; left: 50%; transform: translateX(-50%); color: #8B0000; font-size: 24px; }
  .clv46-hero h1 { font-size: 48px; font-weight: 400; color: #8B0000; margin-bottom: 20px; letter-spacing: 3px; }
  .clv46-hero p { font-size: 15px; font-family: 'Lora', serif; color: #A9A9A9; max-width: 600px; margin: 0 auto; line-height: 1.6; font-style: italic; }
  .clv46-chips { display: flex; gap: 20px; justify-content: center; margin-bottom: 50px; flex-wrap: wrap; }
  .clv46-chips a { padding: 8px 0; color: #A9A9A9; text-decoration: none; font-size: 14px; text-transform: uppercase; letter-spacing: 2px; border-bottom: 1px solid transparent; transition: 0.3s; }
  .clv46-chips a:hover, .clv46-chips a.active { color: #8B0000; border-bottom: 1px solid #8B0000; }
  .clv46-toolbar { background: transparent; border-top: 1px solid #333; border-bottom: 1px solid #333; padding: 20px 0; margin-bottom: 50px; font-family: 'Lora', serif; }
  .clv46-grid { display: grid; grid-template-columns: repeat({{ section.settings.cols_desktop | default: 4 }}, 1fr); gap: 40px 20px; }
  .clv46-promo { grid-column: span 1; background: #1A1A1A; border: 1px solid #4A0404; padding: 40px; text-align: center; display: flex; flex-direction: column; justify-content: center; position: relative; }
  .clv46-promo::after { content: ''; position: absolute; top: 10px; left: 10px; right: 10px; bottom: 10px; border: 1px solid rgba(139,0,0,0.3); pointer-events: none; }
  .clv46-promo h3 { font-size: 24px; color: #8B0000; margin-bottom: 20px; letter-spacing: 1px; }
  .clv46-promo a { display: inline-block; padding: 10px 25px; background: #8B0000; color: #121212; text-decoration: none; font-size: 12px; letter-spacing: 2px; font-family: 'Cinzel', serif; transition: 0.3s; }
  .clv46-promo a:hover { background: #E0E0E0; }
  .clv46-seo { margin-top: 70px; text-align: center; max-width: 800px; margin-left: auto; margin-right: auto; padding: 40px; border: 1px solid #333; background: #1A1A1A; }
  @media (max-width: 768px) { .clv46-grid { grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr); gap: 20px; } .clv46-hero h1 { font-size: 36px; } }
</style>
<div class="clv46" style="max-width: 1200px; margin: 0 auto;">
  <div class="clv46-hero">
    <h1>{% if collection.title != blank %}{{ collection.title | escape }}{% else %}NOCTURNAL{% endif %}</h1>
    <p>{% if collection.description != blank %}{{ collection.description }}{% else %}Curiosities and garments for the academically inclined and the eternally sleepless.{% endif %}</p>
  </div>
  {% if section.settings.sub_collections != blank %}
    <div class="clv46-chips">
      {% for link in section.settings.sub_collections.links %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% endfor %}
    </div>
  {% endif %}
  <div class="clv46-toolbar">
    <facet-filters-form style="width: 100%;">
      <form id="FacetFiltersForm" style="display: flex; justify-content: space-between; align-items: center; width: 100%; flex-wrap: wrap; gap: 20px;">
        <div style="display: flex; gap: 30px;">
          {%- for filter in collection.filters -%}
            <details style="position: relative;">
              <summary style="cursor: pointer; font-size: 13px; font-style: italic; color: #A9A9A9;">{{ filter.label }} ☙</summary>
              <div style="position: absolute; background: #1A1A1A; border: 1px solid #4A0404; padding: 20px; z-index: 10; margin-top: 15px; min-width: 250px; box-shadow: 0 10px 20px rgba(0,0,0,0.8);">
                {%- for value in filter.values -%}
                  <label style="display: block; margin-bottom: 15px; cursor: pointer; font-size: 14px; color: #E0E0E0;">
                    <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %}>
                    {{ value.label }} <span style="color: #666; font-size: 12px;">({{ value.count }})</span>
                  </label>
                {%- endfor -%}
              </div>
            </details>
          {%- endfor -%}
        </div>
        <select name="sort_by" onchange="this.form.submit()" style="background: transparent; border: none; border-bottom: 1px solid #A9A9A9; color: #E0E0E0; padding: 5px 0; font-size: 13px; font-family: 'Lora', serif; font-style: italic; cursor: pointer; outline: none;">
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}" style="background: #121212;"{% if option.value == sort_by %} selected{% endif %}>Sort: {{ option.name }}</option>
          {%- endfor -%}
        </select>
      </form>
    </facet-filters-form>
  </div>
  {% assign limit_num = section.settings.products_per_page | default: 16 %}
  {% paginate collection.products by limit_num %}
    <div class="clv46-grid">
      {% for product in collection.products %}
        {% render 'card-v46', product: product %}
        {% if forloop.index == 8 and section.settings.show_promo_tile %}
          <div class="clv46-promo">
            <h3>Antiquarian<br>Books</h3>
            <a href="/collections/books">Browse Library</a>
          </div>
        {% endif %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v46', product: nil %}
        {% endfor %}
      {% endfor %}
    </div>
    <div style="margin-top: 60px; text-align: center; font-size: 14px; letter-spacing: 2px;">{{ paginate | default_pagination }}</div>
  {% endpaginate %}
  {% if section.settings.show_seo_block %}
    <div class="clv46-seo">
      <h2 style="font-size: 26px; color: #8B0000; margin-bottom: 20px; letter-spacing: 2px;">{{ section.settings.seo_title | default: 'The Archives' }}</h2>
      <p style="font-size: 14px; font-family: 'Lora', serif; color: #A9A9A9; line-height: 1.8;">{{ section.settings.seo_text | default: 'Our collections draw inspiration from 19th-century literature, gothic architecture, and the hidden knowledge found only in the oldest of libraries.' }}</p>
    </div>
  {% endif %}
</div>
{% schema %}
{
  "name": "CL V46 — Dark Academia", "settings": [
    {"type": "range", "id": "products_per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 16},
    {"type": "range", "id": "cols_desktop", "label": "Desktop Columns", "min": 2, "max": 5, "default": 4},
    {"type": "select", "id": "cols_mobile", "label": "Mobile Columns", "options": [{"value": "1", "label": "1"}, {"value": "2", "label": "2"}], "default": "2"},
    {"type": "link_list", "id": "sub_collections", "label": "Sub-Collection Menu"},
    {"type": "checkbox", "id": "show_promo_tile", "label": "Show Promo Card", "default": true},
    {"type": "checkbox", "id": "show_seo_block", "label": "Show SEO Block", "default": true},
    {"type": "color", "id": "bg_color", "label": "Background Color", "default": "#121212"},
    {"type": "color", "id": "text_color", "label": "Text Color", "default": "#E0E0E0"}
  ], "presets": [{"name": "CL V46 — Dark Academia"}]
}
{% endschema %}
