{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Shrikhand&family=DM+Sans:wght@400;500;700&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    
    --font-heading: 'Shrikhand', cursive;
    --font-body: 'DM Sans', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .hp37-news-wrapper {
    max-width: 1000px;
    margin: 0 auto;
    padding: 60px 40px;
    background: var(--accent-color);
    border: 4px solid var(--text-color);
    border-radius: 40px;
    box-shadow: 12px 12px 0px var(--text-color);
    text-align: center;
  }

  @media screen and (max-width: 768px) {
    .hp37-news-wrapper {
      padding: 40px 20px;
      border-radius: 20px;
      box-shadow: 6px 6px 0px var(--text-color);
    }
  }

  .hp37-news__title {
    font-family: var(--font-heading);
    font-size: clamp(40px, 8vw, {{ section.settings.title_size }}px);
    line-height: 1.1;
    color: var(--bg-color);
    margin: 0 0 20px;
    text-shadow: 3px 3px 0px var(--text-color);
    transform: rotate(-2deg);
  }

  .hp37-news__text {
    font-family: var(--font-body);
    font-size: 20px;
    color: var(--text-color);
    font-weight: 700;
    margin-bottom: 40px;
  }

  .hp37-news__form {
    max-width: 600px;
    margin: 0 auto;
    display: flex;
    gap: 15px;
  }

  @media screen and (max-width: 600px) {
    .hp37-news__form {
      flex-direction: column;
    }
  }

  .hp37-news__input {
    flex: 1;
    padding: 20px 30px;
    background: var(--bg-color);
    border: 3px solid var(--text-color);
    border-radius: 50px;
    font-family: var(--font-body);
    font-size: 18px;
    color: var(--text-color);
    outline: none;
    box-shadow: 4px 4px 0px var(--text-color);
  }

  .hp37-news__input::placeholder {
    color: rgba(74, 50, 25, 0.5); /* derived from default text color, adjust if needed */
  }

  .hp37-news__btn {
    padding: 20px 40px;
    background: var(--text-color);
    color: var(--bg-color);
    border: 3px solid var(--text-color);
    border-radius: 50px;
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 4px 4px 0px var(--bg-color);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .hp37-news__btn:hover {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0px var(--bg-color);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp37-news-wrapper" id="HP37News-{{ section.id }}">
  <h2 class="hp37-news__title">{{ section.settings.title }}</h2>
  
  {%- if section.settings.text != blank -%}
    <div class="hp37-news__text">{{ section.settings.text }}</div>
  {%- endif -%}
  
  {%- form 'customer', class: 'hp37-news__form' -%}
    <input type="hidden" name="contact[tags]" value="newsletter">
    <input type="email" 
           name="contact[email]" 
           class="hp37-news__input" 
           placeholder="{{ section.settings.placeholder }}" 
           required>
    <button type="submit" class="hp37-news__btn">{{ section.settings.btn_label }}</button>
  {%- endform -%}
</div>

{% schema %}
{
  "name": "HP37 - Retro Newsletter",
  "class": "section-hp37-newsletter",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Stay Rad"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Sign up for good vibes and early access to new gear."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input Placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "Subscribe"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 40,
      "max": 140,
      "step": 5,
      "unit": "px",
      "label": "Heading Size",
      "default": 100
    },
    {
      "type": "header",
      "content": "Retro Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Page Background",
      "default": "#F4E3C5"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Banner Background",
      "default": "#798A58"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#4A3219"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 100
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP37 - Retro Newsletter"
    }
  ]
}
{% endschema %}
