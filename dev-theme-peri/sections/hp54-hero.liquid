{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Tenor+Sans&family=Inter:wght@400;500;600;700&display=swap');

  #shopify-section-{{ section.id }} {
    --hp54-bg: {{ section.settings.bg_color | default: '#0A1628' }};
    --hp54-text: {{ section.settings.text_color | default: '#E0E7FF' }};
    --hp54-sapphire: {{ section.settings.accent_color | default: '#3B82F6' }};
    --hp54-navy: {{ section.settings.navy_color | default: '#1E3A5F' }};
    --hp54-btn-bg: {{ section.settings.btn_bg | default: '#3B82F6' }};
    --hp54-btn-text: {{ section.settings.btn_text_color | default: '#FFFFFF' }};

    background: linear-gradient(180deg, var(--hp54-bg) 0%, #0F1D32 100%);
    color: var(--hp54-text);
    font-family: 'Inter', sans-serif;
    padding-top: {{ section.settings.padding_top | default: 100 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 100 }}px;
    position: relative;
    overflow: hidden;
  }

  .hp54-hero__glow {
    position: absolute;
    top: -150px;
    left: 50%;
    transform: translateX(-50%);
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(59, 130, 246, 0.15) 0%, transparent 70%);
    pointer-events: none;
  }

  .hp54-hero__container {
    max-width: {{ section.settings.container_width | default: 1280 }}px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 70px;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  .hp54-hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 18px;
    background: rgba(59, 130, 246, 0.12);
    border: 1px solid rgba(59, 130, 246, 0.35);
    border-radius: 6px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--hp54-sapphire);
    margin-bottom: 26px;
  }

  .hp54-hero__title {
    font-family: 'Tenor Sans', serif;
    font-size: clamp(40px, 5.5vw, 66px);
    font-weight: 400;
    line-height: 1.08;
    color: #FFFFFF;
    margin: 0 0 24px;
    letter-spacing: 0.5px;
  }

  .hp54-hero__title span {
    background: linear-gradient(135deg, #60A5FA, #3B82F6, #818CF8);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hp54-hero__desc {
    font-size: 16px;
    line-height: 1.75;
    color: #94A3B8;
    margin: 0 0 36px;
    max-width: 520px;
  }

  .hp54-hero__actions {
    display: flex;
    gap: 16px;
    align-items: center;
    flex-wrap: wrap;
  }

  .hp54-hero__btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 15px 34px;
    background: var(--hp54-btn-bg);
    color: var(--hp54-btn-text);
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1px;
    text-decoration: none;
    border-radius: 8px;
    transition: all 0.35s ease;
    box-shadow: 0 4px 20px rgba(59, 130, 246, 0.35);
  }

  .hp54-hero__btn:hover {
    box-shadow: 0 8px 30px rgba(59, 130, 246, 0.5);
    transform: translateY(-2px);
  }

  .hp54-hero__media {
    position: relative;
  }

  .hp54-hero__img-wrap {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    height: 520px;
    border: 1px solid rgba(59, 130, 246, 0.25);
    box-shadow: 0 30px 80px rgba(10, 22, 40, 0.7);
  }

  .hp54-hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: brightness(0.9) contrast(1.1);
    transition: transform 0.6s ease;
  }

  .hp54-hero__img-wrap:hover .hp54-hero__img {
    transform: scale(1.04);
  }

  .hp54-hero__float-card {
    position: absolute;
    bottom: -16px;
    left: -16px;
    background: rgba(10, 22, 40, 0.92);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(59, 130, 246, 0.3);
    border-radius: 12px;
    padding: 16px 22px;
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .hp54-hero__float-icon {
    width: 42px;
    height: 42px;
    background: linear-gradient(135deg, #3B82F6, #818CF8);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #FFFFFF;
    font-size: 18px;
  }

  .hp54-hero__float-label {
    font-family: 'Tenor Sans', serif;
    font-size: 16px;
    color: #FFFFFF;
    margin: 0;
  }

  .hp54-hero__float-sub {
    font-size: 11px;
    color: #60A5FA;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin: 2px 0 0;
  }

  @media screen and (max-width: 992px) {
    .hp54-hero__container { grid-template-columns: 1fr; text-align: center; gap: 40px; }
    .hp54-hero__desc { margin-left: auto; margin-right: auto; }
    .hp54-hero__actions { justify-content: center; }
    .hp54-hero__img-wrap { height: 380px; }
    .hp54-hero__float-card { left: 50%; transform: translateX(-50%); bottom: -16px; }
  }

  @media screen and (max-width: 480px) {
    .hp54-hero__img-wrap { height: 300px; }
  }
{%- endstyle -%}

<div class="hp54-hero__glow"></div>

<div class="hp54-hero__container">
  <div>
    <div class="hp54-hero__badge">
      <span>◆</span>
      <span>{{ section.settings.badge | default: 'MIDNIGHT SAPPHIRE v54' }}</span>
    </div>

    <h1 class="hp54-hero__title">
      {{ section.settings.heading | default: 'Midnight <span>Sapphire</span> Elixir' }}
    </h1>

    <p class="hp54-hero__desc">
      {{ section.settings.description | default: 'Powered by deep-sea sapphire peptides, blue tansy extract, and moonlit hyaluronic reservoirs for overnight skin metamorphosis.' }}
    </p>

    <div class="hp54-hero__actions">
      <a href="{{ section.settings.btn_url | default: '/collections/all' }}" class="hp54-hero__btn">
        <span>{{ section.settings.btn_text | default: 'Discover Collection' }}</span>
        <span>&rarr;</span>
      </a>
    </div>
  </div>

  <div class="hp54-hero__media">
    <div class="hp54-hero__img-wrap">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 1000 }}" class="hp54-hero__img" alt="{{ section.settings.heading }}" loading="eager">
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'hp54-hero__img' }}
      {%- endif -%}

      <div class="hp54-hero__float-card">
        <div class="hp54-hero__float-icon">◆</div>
        <div>
          <p class="hp54-hero__float-label">Blue Tansy Complex</p>
          <p class="hp54-hero__float-sub">Deep Sea Formula</p>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "HP54 - Sapphire Hero",
  "class": "section-hp54-hero",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#0A1628" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#E0E7FF" },
    { "type": "color", "id": "accent_color", "label": "Sapphire Accent", "default": "#3B82F6" },
    { "type": "color", "id": "navy_color", "label": "Navy Accent", "default": "#1E3A5F" },
    { "type": "color", "id": "btn_bg", "label": "Button Background", "default": "#3B82F6" },
    { "type": "color", "id": "btn_text_color", "label": "Button Text Color", "default": "#FFFFFF" },
    { "type": "text", "id": "badge", "label": "Badge", "default": "MIDNIGHT SAPPHIRE v54" },
    { "type": "textarea", "id": "heading", "label": "Heading (HTML allowed)", "default": "Midnight <span>Sapphire</span> Elixir" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Powered by deep-sea sapphire peptides and blue tansy extract for overnight skin metamorphosis." },
    { "type": "text", "id": "btn_text", "label": "Button Text", "default": "Discover Collection" },
    { "type": "url", "id": "btn_url", "label": "Button URL" },
    { "type": "image_picker", "id": "image", "label": "Hero Image" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 100 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 100 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "presets": [{ "name": "HP54 - Sapphire Hero" }]
}
{% endschema %}
