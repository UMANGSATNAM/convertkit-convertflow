{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Space+Mono:ital,wght@0,400;0,700;1,400;1,700&family=Syne:wght@700;800&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --border-color: #000000;
    --accent-color: {{ section.settings.accent_color }};
    
    --font-heading: 'Syne', sans-serif;
    --font-body: 'Space Mono', monospace;
    
    background-color: var(--bg-color);
    border-bottom: 4px solid var(--border-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .hp32-founder-wrapper {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    gap: 60px;
    align-items: center;
  }

  @media screen and (max-width: 992px) {
    .hp32-founder-wrapper {
      flex-direction: column;
      gap: 40px;
      padding: 0 20px;
    }
  }

  .hp32-founder__image-col {
    flex: 1;
    max-width: 450px;
    position: relative;
  }

  @media screen and (max-width: 992px) {
    .hp32-founder__image-col {
      width: 100%;
      margin: 0 auto;
    }
  }

  /* ID Badge styling */
  .hp32-founder__badge-wrap {
    background: #fff;
    border: 4px solid var(--border-color);
    padding: 20px;
    box-shadow: 12px 12px 0 var(--border-color);
    position: relative;
  }

  .hp32-founder__badge-header {
    border-bottom: 4px solid var(--border-color);
    padding-bottom: 10px;
    margin-bottom: 15px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .hp32-founder__badge-title {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 700;
    color: #000;
    text-transform: uppercase;
  }

  .hp32-founder__badge-code {
    font-family: var(--font-body);
    font-size: 14px;
    background: #000;
    color: var(--accent-color);
    padding: 2px 8px;
  }

  .hp32-founder__image-wrap {
    aspect-ratio: 3/4;
    border: 4px solid var(--border-color);
    background: #f4f4f4;
    overflow: hidden;
    position: relative;
    margin-bottom: 15px;
  }

  .hp32-founder__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%) contrast(150%);
  }

  /* Scanlines */
  .hp32-founder__image-wrap::after {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: linear-gradient(rgba(0,0,0,0) 50%, rgba(0,0,0,0.1) 50%);
    background-size: 100% 4px;
    pointer-events: none;
  }

  .hp32-founder__badge-footer {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 700;
    color: #000;
    text-transform: uppercase;
  }

  .hp32-founder__content-col {
    flex: 1.2;
    background: #fff;
    border: 4px solid var(--border-color);
    box-shadow: 8px 8px 0 var(--border-color);
    padding: 40px;
  }

  @media screen and (max-width: 768px) {
    .hp32-founder__content-col {
      padding: 20px;
    }
  }

  .hp32-founder__tagline {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 700;
    color: var(--accent-color);
    background: #000;
    padding: 4px 12px;
    display: inline-block;
    margin-bottom: 20px;
    text-transform: uppercase;
  }

  .hp32-founder__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 4vw, {{ section.settings.title_size }}px);
    line-height: 1;
    color: #000;
    text-transform: uppercase;
    margin: 0 0 30px;
    letter-spacing: -1px;
  }

  .hp32-founder__text {
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.6;
    color: #000;
    margin: 0 0 30px;
  }

  .hp32-founder__text p {
    margin-bottom: 16px;
  }

  .hp32-founder__text p::before {
    content: '> ';
    color: var(--accent-color);
    font-weight: 700;
  }

  .hp32-founder__signature {
    margin-top: 30px;
    border-top: 4px dashed var(--border-color);
    padding-top: 20px;
  }

  .hp32-founder__name {
    font-family: var(--font-heading);
    font-size: 24px;
    color: #000;
    text-transform: uppercase;
    margin: 0 0 5px;
  }

  .hp32-founder__title-role {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 700;
    color: #000;
    text-transform: uppercase;
    opacity: 0.5;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp32-founder-wrapper" id="HP32Founder-{{ section.id }}">
  <div class="hp32-founder__image-col">
    <div class="hp32-founder__badge-wrap">
      <div class="hp32-founder__badge-header">
        <span class="hp32-founder__badge-title">ID_CARD // AUTH_REQ</span>
        <span class="hp32-founder__badge-code">LEVEL_5</span>
      </div>
      
      <div class="hp32-founder__image-wrap">
        {%- if section.settings.image != blank -%}
          <img height="{{ section.settings.image.height }}" width="{{ section.settings.image.width }}" src="{{ section.settings.image | image_url: width: 600 }}" alt="{{ section.settings.name | escape }}" class="hp32-founder__image" loading="lazy">
        {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'hp32-founder__image' }}
        {%- endif -%}
      </div>
      
      <div class="hp32-founder__badge-footer">
        <span>STATUS: ACTIVE</span>
        <span>ID: #9932</span>
      </div>
    </div>
  </div>

  <div class="hp32-founder__content-col">
    {%- if section.settings.tagline != blank -%}
      <div class="hp32-founder__tagline">{{ section.settings.tagline }}</div>
    {%- endif -%}
    
    <h2 class="hp32-founder__title">{{ section.settings.title }}</h2>
    
    <div class="hp32-founder__text">
      {{ section.settings.text }}
    </div>

    <div class="hp32-founder__signature">
      <div class="hp32-founder__name">{{ section.settings.name }}</div>
      <div class="hp32-founder__title-role">{{ section.settings.role }}</div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "HP32 - Brutalist Founder",
  "class": "section-hp32-founder-note",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Founder Image (Will be grayscaled with scanlines)"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "SYSTEM_ADMIN_MSG"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Heading",
      "default": "INITIATING THE DIRECTIVE."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>WE BUILT THIS BECAUSE THE ALTERNATIVES FAILED. WE REFUSE TO ACCEPT PLANNED OBSOLESCENCE.</p><p>THIS EQUIPMENT IS DESIGNED TO OUTLAST ITS USER. IT IS A TOOL. TREAT IT ROUGHLY. IT WILL ENDURE.</p>"
    },
    {
      "type": "text",
      "id": "name",
      "label": "Name",
      "default": "J. ARCHER"
    },
    {
      "type": "text",
      "id": "role",
      "label": "Role",
      "default": "LEAD ARCHITECT"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 42
    },
    {
      "type": "header",
      "content": "Brutalist Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#f4f4f4"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#ccff00"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 100
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP32 - Brutalist Founder"
    }
  ]
}
{% endschema %}
