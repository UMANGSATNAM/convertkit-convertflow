{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Oswald:wght@300;400;500&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --font-sans: 'Oswald', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    border-bottom: 1px solid var(--text-color);
  }

  .hp36-offer-wrapper {
    max-width: 100%;
    margin: 0 auto;
    padding: 100px 40px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  @media screen and (max-width: 768px) {
    .hp36-offer-wrapper {
      padding: 60px 20px;
    }
  }

  .hp36-offer__title {
    font-family: var(--font-sans);
    font-size: clamp(80px, 15vw, {{ section.settings.title_size }}px);
    line-height: 0.85;
    color: var(--text-color);
    margin: 0 0 20px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    position: relative;
    z-index: 2;
  }

  .hp36-offer__subtitle {
    font-family: var(--font-sans);
    font-size: 16px;
    color: var(--text-color);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    margin-bottom: 40px;
    position: relative;
    z-index: 2;
  }

  .hp36-offer__btn {
    font-family: var(--font-sans);
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    text-decoration: none;
    padding: 20px 40px;
    border: 1px solid var(--text-color);
    background-color: var(--text-color);
    color: var(--bg-color);
    display: inline-flex;
    position: relative;
    z-index: 2;
    transition: all 0.3s ease;
  }

  .hp36-offer__btn:hover {
    background-color: transparent;
    color: var(--text-color);
  }

  /* Decorative repeating background text */
  .hp36-offer__bg-text {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    font-family: var(--font-sans);
    font-size: 400px;
    line-height: 1;
    color: var(--text-color);
    opacity: 0.05;
    white-space: nowrap;
    z-index: 1;
    pointer-events: none;
    text-transform: uppercase;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp36-offer-wrapper" id="HP36Offer-{{ section.id }}">
  <div class="hp36-offer__bg-text">{{ section.settings.bg_text }}</div>
  
  <h2 class="hp36-offer__title">{{ section.settings.title }}</h2>
  
  {%- if section.settings.subtitle != blank -%}
    <div class="hp36-offer__subtitle">{{ section.settings.subtitle }}</div>
  {%- endif -%}
  
  {%- if section.settings.btn_label != blank -%}
    <a href="{{ section.settings.btn_link | default: '#' }}" class="hp36-offer__btn">
      {{ section.settings.btn_label }}
    </a>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "HP36 - Editorial Offer",
  "class": "section-hp36-offer-banner",
  "settings": [
    {
      "type": "textarea",
      "id": "title",
      "label": "Heading",
      "default": "ARCHIVE SALE"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "UP TO 50% OFF SELECTED ICONS"
    },
    {
      "type": "text",
      "id": "bg_text",
      "label": "Background Text",
      "default": "SALE"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "Enter Archive"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 100,
      "max": 300,
      "step": 5,
      "unit": "px",
      "label": "Heading Size",
      "default": 180
    },
    {
      "type": "header",
      "content": "Editorial Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (e.g. Deep Red or Black)",
      "default": "#8B0000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 0
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP36 - Editorial Offer"
    }
  ]
}
{% endschema %}
