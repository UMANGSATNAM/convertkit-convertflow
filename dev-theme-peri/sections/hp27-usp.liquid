{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600&family=Syncopate:wght@400;700&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --font-heading: 'Syncopate', sans-serif;
    --font-body: 'Space Grotesk', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.8 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.8 | round }}px;
    }
  }

  .hp27-usp-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp27-usp-wrapper {
      padding: 0 20px;
    }
  }

  .hp27-usp__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    /* Internal borders using gap and background color */
    gap: 1px;
    background-color: rgba(226, 226, 226, 0.1);
    border: 1px solid rgba(226, 226, 226, 0.1);
  }

  @media screen and (max-width: 992px) {
    .hp27-usp__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 600px) {
    .hp27-usp__grid {
      grid-template-columns: 1fr;
    }
  }

  .hp27-usp__item {
    background-color: var(--bg-color);
    padding: 40px 30px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    position: relative;
    overflow: hidden;
    transition: background-color 0.4s ease;
  }

  .hp27-usp__item::before {
    content: '';
    position: absolute;
    top: 0; left: 0; width: 100%; height: 2px;
    background: var(--accent-color);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s ease;
  }

  .hp27-usp__item:hover::before {
    transform: scaleX(1);
  }

  .hp27-usp__item:hover {
    background-color: rgba(255, 255, 255, 0.02);
  }

  .hp27-usp__icon {
    width: 32px;
    height: 32px;
    margin-bottom: 25px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hp27-usp__icon svg {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: var(--text-color);
    stroke-width: 1.5;
    stroke-linecap: square; /* technical look */
    stroke-linejoin: miter;
    transition: stroke 0.4s ease;
  }

  .hp27-usp__item:hover .hp27-usp__icon svg {
    stroke: var(--accent-color);
  }

  .hp27-usp__title {
    font-family: var(--font-heading);
    font-size: clamp(12px, 1vw, 14px);
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--text-color);
    margin: 0 0 15px;
    text-transform: uppercase;
  }

  .hp27-usp__text {
    font-family: var(--font-body);
    font-size: clamp(13px, 1.2vw, 14px);
    font-weight: 300;
    line-height: 1.6;
    color: var(--text-color);
    opacity: 0.6;
    margin: 0;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp27-usp-wrapper" id="HP27USP-{{ section.id }}">
  <div class="hp27-usp__grid">
    {%- for block in section.blocks -%}
      <div class="hp27-usp__item" {{ block.shopify_attributes }}>
        <div class="hp27-usp__icon">
          {%- case block.settings.icon -%}
            {%- when 'tech' -%}
              <!-- Microchip / Tech icon -->
              <svg viewBox="0 0 24 24"><path d="M22 10V14M2 10V14M10 2H14M10 22H14M6 6H18V18H6V6ZM10 10H14V14H10V10Z"/></svg>
            {%- when 'shield' -%}
              <!-- Sharp shield icon -->
              <svg viewBox="0 0 24 24"><path d="M12 2L4 6V11C4 16.55 7.42 21.6 12 23C16.58 21.6 20 16.55 20 11V6L12 2Z"/></svg>
            {%- when 'speed' -%}
              <!-- Lightning / Speed -->
              <svg viewBox="0 0 24 24"><path d="M13 2L3 14H12L11 22L21 10H12L13 2Z"/></svg>
            {%- when 'globe' -%}
              <!-- Geometric Globe -->
              <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><ellipse cx="12" cy="12" rx="4" ry="10"/><path d="M2 12H22"/></svg>
            {%- else -%}
              <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18"/></svg>
          {%- endcase -%}
        </div>
        
        <h3 class="hp27-usp__title">{{ block.settings.title }}</h3>
        <p class="hp27-usp__text">{{ block.settings.text }}</p>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "HP27 - Eng USP",
  "class": "section-hp27-usp",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1400
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Columns (Desktop)",
      "default": 4
    },
    {
      "type": "header",
      "content": "Dark Engineered Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#0A0A0A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#E2E2E2"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#FF2A2A"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 60
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "usp",
      "name": "USP Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "tech", "label": "Processor / Tech" },
            { "value": "shield", "label": "Shield" },
            { "value": "speed", "label": "Lightning" },
            { "value": "globe", "label": "Globe" }
          ],
          "default": "tech"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "SYSTEM.V1"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Proprietary alloy construction."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP27 - Eng USP",
      "blocks": [
        { "type": "usp", "settings": { "icon": "tech", "title": "AEROSPACE GRADE", "text": "Machined from solid billet aluminum." } },
        { "type": "usp", "settings": { "icon": "shield", "title": "LIFETIME WARRANTY", "text": "Built to endure the harshest conditions." } },
        { "type": "usp", "settings": { "icon": "speed", "title": "ULTRA-FAST DISPATCH", "text": "Same day shipping on orders before 2PM." } },
        { "type": "usp", "settings": { "icon": "globe", "title": "GLOBAL NETWORK", "text": "Service centers in 40+ countries." } }
      ]
    }
  ]
}
{% endschema %}
