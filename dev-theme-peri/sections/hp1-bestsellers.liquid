{%- liquid
  assign collection = collections[section.settings.collection]
  assign product_limit = section.settings.product_limit
  assign bg_color = section.settings.bg_color | default: '#faf5f0'
  assign text_color = section.settings.text_color | default: '#2c2c2c'
-%}

<section class="hp1-beauty-bestsellers" style="background-color: {{ bg_color }}; color: {{ text_color }};" id="hp1-bestsellers-{{ section.id }}">
  <div class="hp1-bestsellers-inner">
    
    <div class="hp1-section-header hp1-header-split">
      <div class="hp1-header-left">
        {%- if section.settings.subheading != blank -%}
          <span class="hp1-section-subheading">{{ section.settings.subheading }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="hp1-section-heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
      {%- if section.settings.show_view_all and collection != blank -%}
        <div class="hp1-header-right desktop-only">
          <a href="{{ collection.url }}" class="hp1-view-all-link">{{ 'sections.featured_collection.view_all' | t | default: 'Shop All' }} &rarr;</a>
        </div>
      {%- endif -%}
    </div>

    <div class="hp1-carousel-wrapper">
      <div class="hp1-carousel-track">
        {%- if collection != blank and collection.products_count > 0 -%}
          {%- for product in collection.products limit: product_limit -%}
            <div class="hp1-carousel-slide">
              {% render 'card-v1', product: product %}
            </div>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..product_limit) -%}
            <div class="hp1-carousel-slide">
              <div class="hp1-product-placeholder">
                {{ 'product-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}
                <div class="hp1-placeholder-info">
                  <h4>Bestseller Item</h4>
                  <p>$35.00</p>
                </div>
              </div>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
    
    {%- if section.settings.show_view_all and collection != blank -%}
      <div class="hp1-header-right mobile-only">
        <a href="{{ collection.url }}" class="hp1-view-all-link">{{ 'sections.featured_collection.view_all' | t | default: 'Shop All' }} &rarr;</a>
      </div>
    {%- endif -%}

  </div>
</section>

<style>
  .hp1-beauty-bestsellers {
    padding: 80px 0;
    font-family: 'Inter', sans-serif;
    overflow: hidden;
  }
  .hp1-bestsellers-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }
  .hp1-header-split {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 40px;
  }
  .hp1-section-subheading {
    display: block;
    font-size: 13px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #8a7a6c;
    margin-bottom: 10px;
  }
  .hp1-section-heading {
    font-family: 'Playfair Display', serif;
    font-size: clamp(28px, 4vw, 40px);
    font-weight: 400;
    margin: 0;
  }
  .hp1-view-all-link {
    display: inline-block;
    color: {{ text_color }};
    text-decoration: none;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding-bottom: 3px;
    border-bottom: 1px solid currentColor;
    transition: opacity 0.3s ease;
  }
  .hp1-view-all-link:hover {
    opacity: 0.7;
  }
  
  .hp1-carousel-wrapper {
    position: relative;
    margin: 0 -20px;
    padding: 0 20px;
  }
  .hp1-carousel-track {
    display: flex;
    gap: 30px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding-bottom: 30px;
  }
  .hp1-carousel-track::-webkit-scrollbar {
    display: none;
  }
  .hp1-carousel-slide {
    flex: 0 0 calc(25% - 22.5px);
    scroll-snap-align: start;
  }
  
  /* Placeholders */
  .hp1-product-placeholder {
    background: #fff;
    border-radius: 8px;
    overflow: hidden;
  }
  .hp1-placeholder-info {
    padding: 15px;
    text-align: center;
  }
  .hp1-placeholder-info h4 {
    margin: 0 0 5px;
    font-family: 'Playfair Display', serif;
    font-weight: 500;
  }
  .hp1-placeholder-info p {
    margin: 0;
    color: #8a7a6c;
  }

  .mobile-only { display: none; }
  
  @media (max-width: 991px) {
    .hp1-carousel-slide { flex: 0 0 calc(33.333% - 20px); }
  }
  @media (max-width: 767px) {
    .hp1-beauty-bestsellers { padding: 50px 0; }
    .hp1-header-split { flex-direction: column; align-items: flex-start; }
    .desktop-only { display: none; }
    .mobile-only { display: block; margin-top: 30px; text-align: center; }
    .hp1-carousel-track { gap: 15px; }
    .hp1-carousel-slide { flex: 0 0 calc(60% - 15px); }
  }
</style>

{% schema %}
{
  "name": "HP1 Bestsellers Carousel",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Customer Favorites"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Bestsellers"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "product_limit",
      "min": 4,
      "max": 12,
      "step": 1,
      "label": "Maximum products to show",
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'Shop All' link",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#faf5f0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2c2c2c"
    }
  ],
  "presets": [
    {
      "name": "HP1 Bestsellers Carousel"
    }
  ]
}
{% endschema %}
