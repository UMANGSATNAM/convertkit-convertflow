{%- comment -%}
  PDP V7: Beauty / Cosmetics (Liquid Glass Luxury)
  FULL PAGE ARCHITECTURE
{%- endcomment -%}

{%- assign current_variant = product.selected_or_first_available_variant -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Jost:wght@300;400;500;600&display=swap');

  :root {
    --v7-primary: #1C1917;
    --v7-accent: #CA8A04;
    --v7-bg: #FAFAF9;
    --v7-surface: #FFFFFF;
    --v7-border: #E7E5E4;
    --v7-text: #0C0A09;
    --v7-text-muted: #78716C;
    
    --v7-font-heading: 'Bodoni Moda', serif;
    --v7-font-body: 'Jost', sans-serif;
    --v7-transition: all 400ms ease;
  }

  .pdp-v7 {
    background-color: var(--v7-bg);
    color: var(--v7-text);
    font-family: var(--v7-font-body);
    overflow-x: hidden;
  }

  /* --- HERO --- */
  .pdp-v7__hero { padding: 60px 16px; }
  .pdp-v7__container { max-width: 1300px; margin: 0 auto; display: grid; gap: 60px; }
  @media (min-width: 992px) { .pdp-v7__container { grid-template-columns: 1fr 450px; } }

  .pdp-v7__gallery { background: var(--v7-surface); border: 1px solid var(--v7-border); padding: 40px; display: flex; justify-content: center; position: sticky; top: 40px; height: max-content; }
  .pdp-v7__gallery img, .pdp-v7__gallery svg { max-width: 100%; height: auto; object-fit: cover; }

  .pdp-v7__title { font-family: var(--v7-font-heading); font-size: 42px; font-weight: 500; line-height: 1.2; margin: 0 0 16px 0; }
  .pdp-v7__subtitle { font-size: 16px; color: var(--v7-text-muted); font-style: italic; font-family: var(--v7-font-heading); margin-bottom: 32px; }

  /* Bundles (Upsell) */
  .pdp-v7__bundles { display: flex; flex-direction: column; gap: 12px; margin-bottom: 40px; }
  .pdp-v7__bundle { border: 1px solid var(--v7-border); padding: 20px; display: flex; align-items: center; justify-content: space-between; cursor: pointer; transition: var(--v7-transition); position: relative; background: var(--v7-surface); }
  .pdp-v7__bundle:hover { border-color: var(--v7-primary); }
  .pdp-v7__bundle.is-active { border-color: var(--v7-accent); background: #FFF; box-shadow: 0 4px 20px rgba(202, 138, 4, 0.1); }
  .pdp-v7__bundle-badge { position: absolute; top: -10px; left: 20px; background: var(--v7-accent); color: #FFF; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; padding: 4px 10px; }
  .pdp-v7__bundle-info { display: flex; align-items: center; gap: 16px; }
  .pdp-v7__bundle-radio { width: 20px; height: 20px; border: 1px solid var(--v7-border); border-radius: 50%; display: flex; align-items: center; justify-content: center; }
  .pdp-v7__bundle.is-active .pdp-v7__bundle-radio { border-color: var(--v7-accent); }
  .pdp-v7__bundle.is-active .pdp-v7__bundle-radio::after { content: ''; width: 10px; height: 10px; background: var(--v7-accent); border-radius: 50%; }
  .pdp-v7__bundle-name { font-weight: 500; font-size: 16px; }
  .pdp-v7__bundle-price { font-family: var(--v7-font-heading); font-size: 20px; }

  .pdp-v7__atc { width: 100%; background: var(--v7-primary); color: #FFF; border: 1px solid var(--v7-primary); padding: 20px; font-size: 14px; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; cursor: pointer; transition: var(--v7-transition); margin-bottom: 24px; }
  .pdp-v7__atc:hover { background: transparent; color: var(--v7-primary); }

  /* --- INGREDIENTS/HOW TO USE --- */
  .pdp-v7__desc-sec { background: var(--v7-surface); padding: 80px 16px; border-top: 1px solid var(--v7-border); }
  .pdp-v7__desc-container { max-width: 900px; margin: 0 auto; text-align: center; }
  .pdp-v7__section-title { font-family: var(--v7-font-heading); font-size: 36px; margin-bottom: 24px; }
  .pdp-v7__text { font-size: 16px; line-height: 1.8; color: var(--v7-text-muted); margin-bottom: 40px; }
  
  .pdp-v7__ingredients-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 32px; text-align: left; margin-top: 40px; }
  .pdp-v7__ingredient { border-top: 1px solid var(--v7-border); padding-top: 20px; }
  .pdp-v7__ing-name { font-family: var(--v7-font-heading); font-size: 20px; margin-bottom: 8px; }
  .pdp-v7__ing-desc { font-size: 14px; color: var(--v7-text-muted); line-height: 1.6; }

  /* --- VIDEO FEATURE --- */
  .pdp-v7__video { background: var(--v7-primary); color: var(--v7-bg); padding: 100px 16px; text-align: center; }
  .pdp-v7__video-box { max-width: 800px; margin: 40px auto 0 auto; aspect-ratio: 16/9; background: #333; position: relative; }
  .pdp-v7__play { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 80px; height: 80px; background: rgba(255,255,255,0.2); border-radius: 50%; display: flex; align-items: center; justify-content: center; backdrop-filter: blur(4px); cursor: pointer; }
  .pdp-v7__play::after { content: ''; border-top: 12px solid transparent; border-bottom: 12px solid transparent; border-left: 20px solid #FFF; margin-left: 6px; }

  /* --- FEATURED COLLECTION --- */
  .pdp-v7__collection { padding: 80px 16px; }
  .pdp-v7__coll-grid { max-width: 1300px; margin: 40px auto 0 auto; display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 40px; }
  .pdp-v7__product-card { text-align: center; cursor: pointer; }
  .pdp-v7__product-card img, .pdp-v7__product-card svg { width: 100%; aspect-ratio: 1; object-fit: cover; background: var(--v7-surface); margin-bottom: 24px; transition: transform 400ms; border: 1px solid var(--v7-border); }
  .pdp-v7__product-card:hover img { transform: scale(1.02); }
  .pdp-v7__card-title { font-family: var(--v7-font-heading); font-size: 20px; margin-bottom: 8px; }
  .pdp-v7__card-price { font-size: 14px; color: var(--v7-text-muted); }

</style>

<div class="pdp-v7" data-section="{{ section.id }}">
  
  <!-- HERO -->
  <div class="pdp-v7__hero">
    <div class="pdp-v7__container">
      <div class="pdp-v7__gallery">
        {% if product.featured_media %}
          <img src="{{ product.featured_media | image_url: width: 800 }}" alt="{{ product.title }}">
        {% else %}
          {{ 'product-3' | placeholder_svg_tag }}
        {% endif %}
      </div>

      <div class="pdp-v7__info">
        <h1 class="pdp-v7__title">{{ product.title }}</h1>
        <div class="pdp-v7__subtitle">The ultimate ritual for flawless skin.</div>

        <!-- Bundle Selector (Upsell) -->
        <div class="pdp-v7__bundles">
          <div class="pdp-v7__bundle">
            <div class="pdp-v7__bundle-info">
              <div class="pdp-v7__bundle-radio"></div>
              <div class="pdp-v7__bundle-name">1 Bottle</div>
            </div>
            <div class="pdp-v7__bundle-price">{{ current_variant.price | money }}</div>
          </div>
          <div class="pdp-v7__bundle is-active">
            <div class="pdp-v7__bundle-badge">Most Popular</div>
            <div class="pdp-v7__bundle-info">
              <div class="pdp-v7__bundle-radio"></div>
              <div class="pdp-v7__bundle-name">2 Bottles <span style="font-size:12px; color:var(--v7-text-muted);">(Save 10%)</span></div>
            </div>
            {% assign pack_2_price = current_variant.price | times: 2 | times: 0.9 %}
            <div class="pdp-v7__bundle-price">{{ pack_2_price | money }}</div>
          </div>
          <div class="pdp-v7__bundle">
            <div class="pdp-v7__bundle-badge" style="background:var(--v7-primary);">Best Value</div>
            <div class="pdp-v7__bundle-info">
              <div class="pdp-v7__bundle-radio"></div>
              <div class="pdp-v7__bundle-name">3 Bottles <span style="font-size:12px; color:var(--v7-text-muted);">(Save 20%)</span></div>
            </div>
            {% assign pack_3_price = current_variant.price | times: 3 | times: 0.8 %}
            <div class="pdp-v7__bundle-price">{{ pack_3_price | money }}</div>
          </div>
        </div>

        <button class="pdp-v7__atc">Add to Bag</button>
        <div style="text-align: center; font-size: 13px; color: var(--v7-text-muted); letter-spacing: 0.05em; text-transform: uppercase;">
          Free shipping on all orders over $50
        </div>
      </div>
    </div>
  </div>

  <!-- INGREDIENTS -->
  <div class="pdp-v7__desc-sec">
    <div class="pdp-v7__desc-container">
      <h2 class="pdp-v7__section-title">The Formulation</h2>
      <div class="pdp-v7__text">
        {{ product.description | default: "Our award-winning formula is crafted with potent, ethically sourced ingredients to deliver visible results without compromising the skin's delicate barrier." }}
      </div>
      <div class="pdp-v7__ingredients-grid">
        <div class="pdp-v7__ingredient">
          <div class="pdp-v7__ing-name">Hyaluronic Acid</div>
          <div class="pdp-v7__ing-desc">Draws moisture into the skin, keeping it hydrated, plump, and youthful.</div>
        </div>
        <div class="pdp-v7__ingredient">
          <div class="pdp-v7__ing-name">Vitamin C (L-Ascorbic Acid)</div>
          <div class="pdp-v7__ing-desc">A potent antioxidant that brightens the complexion and evens skin tone.</div>
        </div>
        <div class="pdp-v7__ingredient">
          <div class="pdp-v7__ing-name">Botanical Squalane</div>
          <div class="pdp-v7__ing-desc">Mimics skin's natural oils to lock in moisture weightlessly.</div>
        </div>
      </div>
    </div>
  </div>

  <!-- VIDEO BLOCK -->
  <div class="pdp-v7__video">
    <h2 class="pdp-v7__section-title" style="color:var(--v7-bg);">The Ritual</h2>
    <div class="pdp-v7__text" style="color:var(--v7-border); max-width:600px; margin:0 auto;">
      Watch how to incorporate this into your daily routine for maximum efficacy.
    </div>
    <div class="pdp-v7__video-box">
      {{ 'lifestyle-2' | placeholder_svg_tag: 'video-poster' }}
      <div class="pdp-v7__play"></div>
    </div>
  </div>

  <!-- FEATURED COLLECTION -->
  <div class="pdp-v7__collection">
    <h2 class="pdp-v7__section-title" style="text-align: center;">Curated For You</h2>
    <div class="pdp-v7__coll-grid">
      {% for i in (1..3) %}
      <div class="pdp-v7__product-card">
        {{ 'product-' | append: i | placeholder_svg_tag }}
        <div class="pdp-v7__card-title">Botanical Essence {{ i }}</div>
        <div class="pdp-v7__card-price">$45.00</div>
      </div>
      {% endfor %}
    </div>
  </div>

</div>


<!-- STICKY ATC -->
<style>
  .sticky-atc-{{ section.id }} {
    position: fixed;
    bottom: -100px;
    left: 0;
    width: 100%;
    background: #FFF;
    box-shadow: 0 -4px 10px rgba(0,0,0,0.1);
    z-index: 999;
    padding: 10px 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: bottom 0.3s ease-in-out;
    border-top: 1px solid #eee;
  }
  .sticky-atc-{{ section.id }}.visible {
    bottom: 0;
  }
  .sticky-atc-{{ section.id }}__info { display: flex; align-items: center; gap: 10px; }
  .sticky-atc-{{ section.id }}__img { width: 40px; height: 40px; object-fit: cover; border-radius: 4px; }
  .sticky-atc-{{ section.id }}__title { font-weight: 600; font-size: 14px; color: #000; }
  .sticky-atc-{{ section.id }}__price { font-weight: 700; color: #D32F2F; font-size: 14px; }
  .sticky-atc-{{ section.id }}__btn { background: #000; color: #FFF; border: none; padding: 12px 24px; font-weight: 700; cursor: pointer; border-radius: 4px; text-transform: uppercase; }
  .sticky-atc-{{ section.id }}__btn:hover { opacity: 0.8; }
  @media (max-width: 768px) {
    .sticky-atc-{{ section.id }}__info { display: none; }
    .sticky-atc-{{ section.id }}__btn { width: 100%; padding: 14px; font-size: 16px; }
  }
</style>

<div class="sticky-atc-{{ section.id }}" id="sticky-atc-{{ section.id }}">
  <div class="sticky-atc-{{ section.id }}__info">
    {% if product.featured_media %}
      <img src="{{ product.featured_media | image_url: width: 100 }}" class="sticky-atc-{{ section.id }}__img">
    {% endif %}
    <div>
      <div class="sticky-atc-{{ section.id }}__title">{{ product.title }}</div>
      <div class="sticky-atc-{{ section.id }}__price">{{ product.selected_or_first_available_variant.price | money }}</div>
    </div>
  </div>
  <button class="sticky-atc-{{ section.id }}__btn" onclick="window.scrollTo({top: 0, behavior: 'smooth'})">ADD TO CART</button>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const stickyBar = document.getElementById('sticky-atc-{{ section.id }}');
    if(stickyBar) {
      window.addEventListener('scroll', function() {
        if (window.scrollY > 600) {
          stickyBar.classList.add('visible');
        } else {
          stickyBar.classList.remove('visible');
        }
      });
    }
  });
</script>

{% schema %}

{
  "name": "PDP V7 - Beauty Full",
  "settings": [],
  "presets": [
    {
      "name": "PDP V7 - Beauty Full"
    }
  ]
}
{% endschema %}
