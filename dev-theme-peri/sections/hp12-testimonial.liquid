{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#FAFAFA'
  assign text_color = section.settings.text_color | default: '#333333'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 120px 40px;
    border-bottom: 1px solid #E5E5E5;
  }
  
  .hp12-testimonial-container-{{ section_id }} {
    max-width: 1000px;
    margin: 0 auto;
    position: relative;
  }
  
  .hp12-testimonial-icon-{{ section_id }} {
    text-align: center;
    margin-bottom: 40px;
  }
  
  .hp12-testimonial-icon-{{ section_id }} svg {
    width: 30px;
    height: 30px;
    fill: {{ text_color }};
    opacity: 0.2;
  }
  
  .hp12-testimonial-quote-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    font-weight: 300;
    line-height: 1.4;
    text-align: center;
    color: {{ text_color }};
    margin: 0 0 40px 0;
  }
  
  .hp12-testimonial-author-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 2px;
    text-align: center;
    color: {{ text_color }};
    opacity: 0.6;
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 80px 20px;
    }
  }
</style>

<div class="hp12-testimonial-container-{{ section_id }}">
  <div class="hp12-testimonial-icon-{{ section_id }}">
    <svg viewBox="0 0 24 24"><path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/></svg>
  </div>
  
  <blockquote class="hp12-testimonial-quote-{{ section_id }}">
    "{{ section.settings.quote | default: 'A rare balance of form and function. These pieces do not shout for attention, yet they completely transform the energy of a room.' }}"
  </blockquote>
  
  <div class="hp12-testimonial-author-{{ section_id }}">
    {{ section.settings.author | default: 'ARCHITECTURE DIGEST' }}
  </div>
</div>

{% schema %}
{
  "name": "HP12 Testimonial",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FAFAFA"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#333333"
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Quote",
      "default": "A rare balance of form and function. These pieces do not shout for attention, yet they completely transform the energy of a room."
    },
    {
      "type": "text",
      "id": "author",
      "label": "Author",
      "default": "ARCHITECTURE DIGEST"
    }
  ],
  "presets": [
    {
      "name": "HP12 Testimonial"
    }
  ]
}
{% endschema %}
