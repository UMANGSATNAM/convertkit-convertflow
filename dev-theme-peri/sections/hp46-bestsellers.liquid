{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp46-bs-bg: {{ section.settings.bg_color | default: '#0B0F19' }};
    
    background-color: var(--hp46-bs-bg);
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
  }

  .hp46-bs__wrap {
    max-width: {{ section.settings.container_width | default: 1280 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp46-bs__header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 50px;
  }

  .hp46-bs__heading {
    font-family: 'Syne', sans-serif;
    font-size: clamp(28px, 4vw, 42px);
    font-weight: 800;
    color: #FFFFFF;
    margin: 0 0 8px;
  }

  .hp46-bs__heading span {
    background: linear-gradient(135deg, #38BDF8, #F472B6);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hp46-bs__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: 3 }}, 1fr);
    gap: 24px;
  }

  .hp46-bs__card {
    background: rgba(15, 23, 42, 0.65);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(56, 189, 248, 0.2);
    border-radius: 24px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
    transition: all 0.3s ease;
  }

  .hp46-bs__card:hover {
    border-color: #F472B6;
    transform: translateY(-6px);
    box-shadow: 0 18px 45px rgba(244, 114, 182, 0.2);
  }

  .hp46-bs__img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 16px;
    margin-bottom: 20px;
  }

  .hp46-bs__title {
    font-family: 'Syne', sans-serif;
    font-size: 18px;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0 0 8px;
  }

  .hp46-bs__price {
    font-size: 16px;
    font-weight: 700;
    color: #F472B6;
    margin-bottom: 18px;
  }

  .hp46-bs__btn {
    width: 100%;
    margin-top: auto;
    padding: 14px;
    background: linear-gradient(135deg, #38BDF8, #F472B6);
    color: #0B0F19;
    border: none;
    border-radius: 50px;
    font-family: 'Syne', sans-serif;
    font-size: 13px;
    font-weight: 800;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .hp46-bs__btn:hover {
    box-shadow: 0 0 25px rgba(244, 114, 182, 0.5);
  }

  @media screen and (max-width: 992px) {
    .hp46-bs__grid { grid-template-columns: 1fr; max-width: 460px; margin: 0 auto; }
  }
{%- endstyle -%}

<div class="hp46-bs__wrap">
  <div class="hp46-bs__header">
    <h2 class="hp46-bs__heading">MOST COVETED <span>CYBER DROPS</span></h2>
    <p style="font-size:14px; color:#94A3B8;">{{ section.settings.subheading | default: 'Our viral bio-luminescent formulas in highest demand.' }}</p>
  </div>

  <div class="hp46-bs__grid">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <div class="hp46-bs__card" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 600 }}" class="hp46-bs__img" alt="{{ block.settings.title }}" loading="lazy">
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'hp46-bs__img' }}
          {%- endif -%}
          <h3 class="hp46-bs__title">{{ block.settings.title }}</h3>
          <div class="hp46-bs__price">{{ block.settings.price | default: '$68.00 USD' }}</div>
          <button class="hp46-bs__btn">{{ block.settings.btn_text | default: 'ACQUIRE DROP' }}</button>
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="hp46-bs__card">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'hp46-bs__img' }}
        <h3 class="hp46-bs__title">HOLOGRAPHIC ENZYME SERUM</h3>
        <div class="hp46-bs__price">$68.00 USD</div>
        <button class="hp46-bs__btn">ACQUIRE DROP</button>
      </div>
      <div class="hp46-bs__card">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'hp46-bs__img' }}
        <h3 class="hp46-bs__title">NEON PEPTIDE GLAZE BALM</h3>
        <div class="hp46-bs__price">$54.00 USD</div>
        <button class="hp46-bs__btn">ACQUIRE DROP</button>
      </div>
      <div class="hp46-bs__card">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'hp46-bs__img' }}
        <h3 class="hp46-bs__title">BIO-LUMINESCENT JELLY MASK</h3>
        <div class="hp46-bs__price">$60.00 USD</div>
        <button class="hp46-bs__btn">ACQUIRE DROP</button>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP46 - Cyber Best",
  "class": "section-hp46-bestsellers",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#0B0F19" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "MOST COVETED CYBER DROPS" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Our viral bio-luminescent formulas in highest demand." },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "label": "Desktop Columns", "default": 3 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 80 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "HOLOGRAPHIC ENZYME SERUM" },
        { "type": "text", "id": "price", "label": "Price", "default": "$68.00 USD" },
        { "type": "text", "id": "btn_text", "label": "Button Text", "default": "ACQUIRE DROP" },
        { "type": "url", "id": "url", "label": "Link URL" }
      ]
    }
  ],
  "presets": [
    { "name": "HP46 - Cyber Best" }
  ]
}
{% endschema %}
