{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;1,400&family=Nunito:wght@300;400;600&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    
    --font-heading: 'Lora', serif;
    --font-body: 'Nunito', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .hp35-ig-wrapper {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
    text-align: center;
  }

  @media screen and (max-width: 768px) {
    .hp35-ig-wrapper {
      padding: 0 20px;
    }
  }

  .hp35-ig__title {
    font-family: var(--font-heading);
    font-size: clamp(28px, 5vw, {{ section.settings.title_size }}px);
    line-height: 1.2;
    color: var(--text-color);
    margin: 0 0 10px;
    font-weight: 400;
  }
  
  .hp35-ig__title em {
    font-style: italic;
    color: var(--accent-color);
  }

  .hp35-ig__handle {
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--text-color);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-bottom: 50px;
    display: inline-block;
    text-decoration: none;
    opacity: 0.6;
    transition: opacity 0.3s ease;
  }

  .hp35-ig__handle:hover {
    opacity: 1;
  }

  .hp35-ig__grid {
    display: flex;
    justify-content: center;
    gap: 15px;
    flex-wrap: wrap;
  }

  .hp35-ig__item {
    flex: 1 1 200px;
    max-width: 300px;
    aspect-ratio: 1/1;
    position: relative;
    border-radius: 50%; /* Circle images for organic feel */
    overflow: hidden;
    text-decoration: none;
    transition: transform 0.5s ease, border-radius 0.5s ease;
  }

  .hp35-ig__item:hover {
    transform: scale(1.05);
    border-radius: 20px; /* Morphs from circle to rounded square on hover */
  }

  .hp35-ig__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hp35-ig__overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0,0,0,0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .hp35-ig__item:hover .hp35-ig__overlay {
    opacity: 1;
  }

  .hp35-ig__overlay svg {
    width: 30px; height: 30px;
    fill: #fff;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp35-ig-wrapper" id="HP35IG-{{ section.id }}">
  <h2 class="hp35-ig__title">{{ section.settings.title | replace: 'journey', '<em>journey</em>' }}</h2>
  
  <a href="{{ section.settings.link | default: '#' }}" class="hp35-ig__handle">{{ section.settings.handle }}</a>

  <div class="hp35-ig__grid">
    {%- for block in section.blocks limit: 5 -%}
      <a href="{{ block.settings.link | default: '#' }}" class="hp35-ig__item" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          <img height="{{ block.settings.image.height }}" width="{{ block.settings.image.width }}" src="{{ block.settings.image | image_url: width: 400 }}" alt="Instagram image" class="hp35-ig__image" loading="lazy">
        {%- else -%}
          {%- assign placeholder = 'collection-' | append: forloop.index -%}
          {%- if forloop.index > 6 -%}{%- assign placeholder = 'collection-1' -%}{%- endif -%}
          {{ placeholder | placeholder_svg_tag: 'hp35-ig__image' }}
        {%- endif -%}
        <div class="hp35-ig__overlay">
          <svg viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
        </div>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "HP35 - Organic Instagram",
  "class": "section-hp35-instagram",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Join the journey"
    },
    {
      "type": "text",
      "id": "handle",
      "label": "Instagram Handle",
      "default": "@brandname"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Profile Link"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 40
    },
    {
      "type": "header",
      "content": "Organic Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#FDFBF7"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2C422F"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#CC7B5E"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 100
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Post",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP35 - Organic Instagram",
      "blocks": [
        { "type": "post" },
        { "type": "post" },
        { "type": "post" },
        { "type": "post" },
        { "type": "post" }
      ]
    }
  ]
}
{% endschema %}
