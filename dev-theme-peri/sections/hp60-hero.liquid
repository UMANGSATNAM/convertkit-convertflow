{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,600;0,6..96,700;1,6..96,600&family=Outfit:wght@400;500;600;700&display=swap');

  #shopify-section-{{ section.id }} {
    --hp60-bg: {{ section.settings.bg_color | default: '#FFFDF0' }};
    --hp60-text: {{ section.settings.text_color | default: '#1E293B' }};
    --hp60-amber: {{ section.settings.accent_amber | default: '#D97706' }};
    --hp60-olive: {{ section.settings.accent_olive | default: '#3F6212' }};
    --hp60-btn-bg: {{ section.settings.btn_bg | default: '#3F6212' }};
    --hp60-btn-text: {{ section.settings.btn_text_color | default: '#FFFFFF' }};

    background: radial-gradient(circle at 90% 15%, #FEF9C3 0%, var(--hp60-bg) 70%);
    color: var(--hp60-text);
    font-family: 'Outfit', sans-serif;
    padding-top: {{ section.settings.padding_top | default: 95 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 95 }}px;
    position: relative;
    overflow: hidden;
  }

  .hp60-hero__container {
    max-width: {{ section.settings.container_width | default: 1280 }}px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 70px;
    align-items: center;
  }

  .hp60-hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 18px;
    background: rgba(63, 98, 18, 0.08);
    border: 1px solid rgba(63, 98, 18, 0.25);
    border-radius: 4px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--hp60-olive);
    margin-bottom: 24px;
  }

  .hp60-hero__title {
    font-family: 'Bodoni Moda', serif;
    font-size: clamp(38px, 5.2vw, 64px);
    font-weight: 700;
    line-height: 1.08;
    color: #1E293B;
    margin: 0 0 24px;
    letter-spacing: -0.5px;
  }

  .hp60-hero__title em {
    font-style: italic;
    color: var(--hp60-amber);
  }

  .hp60-hero__desc {
    font-size: 16px;
    line-height: 1.8;
    color: #475569;
    margin: 0 0 36px;
    max-width: 520px;
  }

  .hp60-hero__actions {
    display: flex;
    gap: 16px;
    align-items: center;
    flex-wrap: wrap;
  }

  .hp60-hero__btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 36px;
    background: var(--hp60-btn-bg);
    color: var(--hp60-btn-text);
    font-family: 'Outfit', sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 4px;
    transition: all 0.35s ease;
    box-shadow: 0 8px 25px rgba(63, 98, 18, 0.25);
  }

  .hp60-hero__btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 35px rgba(63, 98, 18, 0.4);
  }

  .hp60-hero__media {
    position: relative;
  }

  .hp60-hero__img-wrap {
    position: relative;
    border-radius: 8px;
    overflow: hidden;
    height: 520px;
    border: 1px solid rgba(217, 119, 6, 0.25);
    box-shadow: 0 25px 60px rgba(63, 98, 18, 0.12);
  }

  .hp60-hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }

  .hp60-hero__img-wrap:hover .hp60-hero__img {
    transform: scale(1.04);
  }

  .hp60-hero__float-card {
    position: absolute;
    bottom: -16px;
    left: -16px;
    background: rgba(255, 253, 240, 0.95);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(217, 119, 6, 0.3);
    border-radius: 8px;
    padding: 16px 22px;
    display: flex;
    align-items: center;
    gap: 14px;
    box-shadow: 0 10px 30px rgba(30, 41, 59, 0.08);
  }

  .hp60-hero__float-icon {
    width: 42px;
    height: 42px;
    background: linear-gradient(135deg, #FEF9C3, #D97706);
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #1E293B;
    font-size: 18px;
  }

  .hp60-hero__float-label {
    font-family: 'Bodoni Moda', serif;
    font-size: 17px;
    font-weight: 700;
    color: #1E293B;
    margin: 0;
  }

  .hp60-hero__float-sub {
    font-size: 11px;
    color: #3F6212;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin: 2px 0 0;
  }

  @media screen and (max-width: 992px) {
    .hp60-hero__container { grid-template-columns: 1fr; text-align: center; gap: 40px; }
    .hp60-hero__desc { margin-left: auto; margin-right: auto; }
    .hp60-hero__actions { justify-content: center; }
    .hp60-hero__img-wrap { height: 380px; }
    .hp60-hero__float-card { left: 50%; transform: translateX(-50%); bottom: -16px; }
  }

  @media screen and (max-width: 480px) {
    .hp60-hero__img-wrap { height: 300px; }
  }
{%- endstyle -%}

<div class="hp60-hero__container">
  <div>
    <div class="hp60-hero__badge">
      <span>🍋</span>
      <span>{{ section.settings.badge | default: 'TUSCAN CITRUS GROVE v60' }}</span>
    </div>

    <h1 class="hp60-hero__title">
      {{ section.settings.heading | default: 'Calabrian Bergamot & <em>Tuscan Olive</em> Elixir' }}
    </h1>

    <p class="hp60-hero__desc">
      {{ section.settings.description | default: 'Cold-pressed under the Mediterranean sun in ancient Tuscan groves, infusing cold-milled olive leaf polyphenols with brightening Calabrian bergamot essence.' }}
    </p>

    <div class="hp60-hero__actions">
      <a href="{{ section.settings.btn_url | default: '/collections/all' }}" class="hp60-hero__btn">
        <span>{{ section.settings.btn_text | default: 'Explore Tuscan Harvest' }}</span>
        <span>&rarr;</span>
      </a>
    </div>
  </div>

  <div class="hp60-hero__media">
    <div class="hp60-hero__img-wrap">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 1000 }}" class="hp60-hero__img" alt="{{ section.settings.heading }}" loading="eager">
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'hp60-hero__img' }}
      {%- endif -%}

      <div class="hp60-hero__float-card">
        <div class="hp60-hero__float-icon">🍋</div>
        <div>
          <p class="hp60-hero__float-label">Oleuropein & Vit C</p>
          <p class="hp60-hero__float-sub">Ancient Olive Polyphenols</p>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "HP60 Hero",
  "class": "section-hp60-hero",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#FFFDF0" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#1E293B" },
    { "type": "color", "id": "accent_amber", "label": "Amber Accent", "default": "#D97706" },
    { "type": "color", "id": "accent_olive", "label": "Olive Accent", "default": "#3F6212" },
    { "type": "color", "id": "btn_bg", "label": "Button Background", "default": "#3F6212" },
    { "type": "color", "id": "btn_text_color", "label": "Button Text Color", "default": "#FFFFFF" },
    { "type": "text", "id": "badge", "label": "Badge", "default": "TUSCAN CITRUS GROVE v60" },
    { "type": "textarea", "id": "heading", "label": "Heading (HTML allowed)", "default": "Calabrian Bergamot & <em>Tuscan Olive</em> Elixir" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Cold-pressed under the Mediterranean sun in ancient Tuscan groves." },
    { "type": "text", "id": "btn_text", "label": "Button Text", "default": "Explore Tuscan Harvest" },
    { "type": "url", "id": "btn_url", "label": "Button URL" },
    { "type": "image_picker", "id": "image", "label": "Hero Image" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "presets": [{ "name": "HP60 Hero" }]
}
{% endschema %}
