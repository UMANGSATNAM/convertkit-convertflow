{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#090D16' }};
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }
  .hp64-story__container {
    max-width: {{ section.settings.container_width | default: 1280 }}px;
    margin: 0 auto; padding: 0 24px;
    display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 70px; align-items: center;
  }
  .hp64-story__img-wrap {
    border-radius: 8px; overflow: hidden; height: 480px;
    border: 1px solid rgba(6, 182, 212, 0.35); box-shadow: 0 0 35px rgba(6, 182, 212, 0.2);
  }
  .hp64-story__img { width: 100%; height: 100%; object-fit: cover; filter: brightness(0.95) contrast(1.1); }
  .hp64-story__eyebrow { font-family: 'Space Grotesk', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: {{ section.settings.accent_color | default: '#06B6D4' }}; margin: 0 0 16px; }
  .hp64-story__heading { font-family: 'Syne', sans-serif; font-size: clamp(28px, 3.5vw, 42px); font-weight: 800; color: #FFFFFF; margin: 0 0 22px; line-height: 1.15; }
  .hp64-story__text { font-size: 15px; line-height: 1.8; color: #94A3B8; margin: 0 0 32px; font-family: 'Space Grotesk', sans-serif; }
  .hp64-story__btn {
    display: inline-flex; align-items: center; gap: 10px; padding: 14px 34px;
    background: {{ section.settings.btn_bg | default: '#06B6D4' }}; color: #030712;
    font-family: 'Space Grotesk', sans-serif; font-size: 13px; font-weight: 700;
    letter-spacing: 1.5px; text-transform: uppercase;
    text-decoration: none; border-radius: 4px; transition: all 0.3s ease;
    box-shadow: 0 0 25px rgba(6, 182, 212, 0.4);
  }
  .hp64-story__btn:hover { box-shadow: 0 0 40px rgba(6, 182, 212, 0.7); transform: translateY(-2px); }
  @media screen and (max-width: 992px) { .hp64-story__container { grid-template-columns: 1fr; text-align: center; gap: 40px; } .hp64-story__img-wrap { height: 350px; } }
{%- endstyle -%}
<div class="hp64-story__container">
  <div class="hp64-story__img-wrap">
    {%- if section.settings.image != blank -%}
      <img height="{{ section.settings.image.height }}" width="{{ section.settings.image.width }}" src="{{ section.settings.image | image_url: width: 800 }}" class="hp64-story__img" alt="{{ section.settings.heading }}" loading="lazy">
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'hp64-story__img' }}
    {%- endif -%}
  </div>
  <div>
    <p class="hp64-story__eyebrow">{{ section.settings.eyebrow | default: '🧬 ABYSSAL BIOTECH GENESIS' }}</p>
    <h2 class="hp64-story__heading">{{ section.settings.heading | default: 'Light in the 4,000m Darkness' }}</h2>
    <p class="hp64-story__text">{{ section.settings.text | default: 'Four thousand meters below sea level, where sunlight never penetrates, organisms emit their own biological luminescence to survive extreme pressures. We sustainably isolate these photoluminescent enzyme complexes to restore cellular energy and illuminate dull, fatigued skin.' }}</p>
    {%- if section.settings.btn_label != blank -%}
      <a href="{{ section.settings.btn_url | default: '/pages/about' }}" class="hp64-story__btn">{{ section.settings.btn_label }} &rarr;</a>
    {%- endif -%}
  </div>
</div>
{% schema %}
{
  "name": "HP64 Story",
  "class": "section-hp64-story",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#090D16" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#06B6D4" },
    { "type": "color", "id": "btn_bg", "label": "Button BG", "default": "#06B6D4" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "🧬 ABYSSAL BIOTECH GENESIS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Light in the 4,000m Darkness" },
    { "type": "textarea", "id": "text", "label": "Story Text", "default": "Four thousand meters below sea level." },
    { "type": "text", "id": "btn_label", "label": "Button Label", "default": "Abyssal Manifesto" },
    { "type": "url", "id": "btn_url", "label": "Button URL" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "presets": [{ "name": "HP64 Story" }]
}
{% endschema %}
