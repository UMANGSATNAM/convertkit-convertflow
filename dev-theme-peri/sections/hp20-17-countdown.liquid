{%- liquid
  assign sec_id = section.id
-%}

<style>
  #shopify-section-{{ sec_id }} {
    background-color: {{ section.settings.bg_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px 0;
  }

  .hp20-countdown-{{ sec_id }} {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 24px;
    text-align: center;
  }

  .hp20-countdown-{{ sec_id }}__title {
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-size: clamp(28px, 4vw, 40px);
    font-weight: 300;
    color: {{ section.settings.text_color }};
    margin: 0 0 16px 0;
    letter-spacing: -0.01em;
  }

  .hp20-countdown-{{ sec_id }}__text {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 14px;
    color: {{ section.settings.text_color }};
    opacity: 0.7;
    margin: 0 0 40px 0;
  }

  .hp20-timer {
    display: flex;
    justify-content: center;
    gap: 32px;
  }

  .hp20-timer__block {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .hp20-timer__num {
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-size: clamp(40px, 6vw, 64px);
    font-weight: 300;
    line-height: 1;
    color: {{ section.settings.text_color }};
    min-width: 1.2em;
  }

  .hp20-timer__label {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: {{ section.settings.text_color }};
    opacity: 0.6;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ sec_id }} {
      padding: {{ section.settings.padding_top_mobile }}px 0 {{ section.settings.padding_bottom_mobile }}px 0;
    }
    .hp20-timer {
      gap: 16px;
    }
  }
</style>

<section class="hp20-countdown-{{ sec_id }}">
  <h2 class="hp20-countdown-{{ sec_id }}__title">{{ section.settings.title }}</h2>
  {% if section.settings.text != blank %}
    <p class="hp20-countdown-{{ sec_id }}__text">{{ section.settings.text }}</p>
  {% endif %}

  <div class="hp20-timer" data-date="{{ section.settings.end_date }}">
    <div class="hp20-timer__block">
      <span class="hp20-timer__num js-days">00</span>
      <span class="hp20-timer__label">Days</span>
    </div>
    <div class="hp20-timer__block">
      <span class="hp20-timer__num js-hours">00</span>
      <span class="hp20-timer__label">Hours</span>
    </div>
    <div class="hp20-timer__block">
      <span class="hp20-timer__num js-minutes">00</span>
      <span class="hp20-timer__label">Mins</span>
    </div>
    <div class="hp20-timer__block">
      <span class="hp20-timer__num js-seconds">00</span>
      <span class="hp20-timer__label">Secs</span>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const timerEl = document.querySelector('#shopify-section-{{ sec_id }} .hp20-timer');
    if(!timerEl) return;
    
    const targetDateStr = timerEl.getAttribute('data-date');
    if(!targetDateStr) return;
    
    const targetDate = new Date(targetDateStr).getTime();
    if(isNaN(targetDate)) return;

    const daysEl = timerEl.querySelector('.js-days');
    const hoursEl = timerEl.querySelector('.js-hours');
    const minsEl = timerEl.querySelector('.js-minutes');
    const secsEl = timerEl.querySelector('.js-seconds');

    const updateTimer = () => {
      const now = new Date().getTime();
      const distance = targetDate - now;

      if(distance < 0) {
        clearInterval(interval);
        return;
      }

      const d = Math.floor(distance / (1000 * 60 * 60 * 24));
      const h = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const m = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
      const s = Math.floor((distance % (1000 * 60)) / 1000);

      daysEl.textContent = d < 10 ? '0' + d : d;
      hoursEl.textContent = h < 10 ? '0' + h : h;
      minsEl.textContent = m < 10 ? '0' + m : m;
      secsEl.textContent = s < 10 ? '0' + s : s;
    };

    updateTimer();
    const interval = setInterval(updateTimer, 1000);
  });
</script>

{% schema %}
{
  "name": "HP20 Countdown",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "The Summer Drop"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Releasing soon. Mark your calendars."
    },
    {
      "type": "text",
      "id": "end_date",
      "label": "End Date",
      "info": "Format: YYYY-MM-DDTHH:MM:SS (e.g. 2026-12-31T23:59:59)"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f9f9f9"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1a1a1a"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0, "max": 160, "step": 10, "unit": "px",
      "label": "Desktop Top Padding", "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0, "max": 160, "step": 10, "unit": "px",
      "label": "Desktop Bottom Padding", "default": 100
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0, "max": 100, "step": 10, "unit": "px",
      "label": "Mobile Top Padding", "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0, "max": 100, "step": 10, "unit": "px",
      "label": "Mobile Bottom Padding", "default": 60
    }
  ],
  "presets": [
    {
      "name": "HP20 Countdown"
    }
  ]
}
{% endschema %}
