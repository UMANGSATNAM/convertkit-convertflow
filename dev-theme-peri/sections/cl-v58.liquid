{% comment %} CL V58 — Yoga / Meditation (Lavender/Sage Soft) {% endcomment %}
{{ 'component-facets.css' | asset_url | stylesheet_tag }}
<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
<style>
  .clv58 { background: {{ section.settings.bg_color | default: '#F9F8FA' }}; color: {{ section.settings.text_color | default: '#6E6278' }}; padding: 50px 20px; font-family: 'Lora', serif; }
  .clv58-hero { text-align: center; margin-bottom: 50px; padding: 70px 20px; background: linear-gradient(to bottom, #EBE7EE, #F9F8FA); border-radius: 200px 200px 0 0; }
  .clv58-hero h1 { font-size: 46px; font-weight: 400; color: #52475A; margin-bottom: 15px; letter-spacing: 1px; }
  .clv58-hero p { font-size: 16px; color: #8F8498; max-width: 500px; margin: 0 auto; line-height: 1.7; font-family: 'Arial', sans-serif; }
  .clv58-chips { display: flex; gap: 15px; justify-content: center; margin-bottom: 40px; flex-wrap: wrap; }
  .clv58-chips a { padding: 10px 25px; background: #FFF; color: #8F8498; text-decoration: none; font-size: 13px; font-family: 'Arial', sans-serif; letter-spacing: 1px; border-radius: 40px; transition: 0.4s; box-shadow: 0 4px 15px rgba(0,0,0,0.03); border: 1px solid transparent; }
  .clv58-chips a:hover, .clv58-chips a.active { background: #E2E8DE; color: #52475A; border-color: #C5CEBE; }
  .clv58-toolbar { background: transparent; border-bottom: 1px solid #EBE7EE; padding-bottom: 15px; margin-bottom: 40px; display: flex; justify-content: space-between; align-items: center; font-family: 'Arial', sans-serif; }
  .clv58-grid { display: grid; grid-template-columns: repeat({{ section.settings.cols_desktop | default: 3 }}, 1fr); gap: 40px; }
  .clv58-promo { grid-column: span 1; background: #E2E8DE; color: #52475A; padding: 50px; text-align: center; display: flex; flex-direction: column; justify-content: center; border-radius: 10px 100px 10px 100px; }
  .clv58-promo h3 { font-size: 28px; font-weight: 400; margin-bottom: 20px; line-height: 1.4; }
  .clv58-promo a { display: inline-block; padding: 12px 30px; background: #FFF; color: #52475A; text-decoration: none; font-size: 12px; font-family: 'Arial', sans-serif; letter-spacing: 2px; text-transform: uppercase; border-radius: 30px; transition: 0.3s; box-shadow: 0 4px 10px rgba(0,0,0,0.05); }
  .clv58-promo a:hover { background: #52475A; color: #FFF; }
  .clv58-seo { margin-top: 80px; text-align: center; padding: 50px 20px; background: #FFF; border-radius: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.02); }
  @media (max-width: 768px) { .clv58-grid { grid-template-columns: repeat({{ section.settings.cols_mobile | default: 1 }}, 1fr); gap: 20px; } .clv58-hero h1 { font-size: 36px; } .clv58-hero { border-radius: 100px 100px 0 0; padding: 40px 20px; } }
</style>
<div class="clv58" style="max-width: 1100px; margin: 0 auto;">
  <div class="clv58-hero">
    <h1>{% if collection.title != blank %}{{ collection.title | escape }}{% else %}Inner Peace{% endif %}</h1>
    <p>{% if collection.description != blank %}{{ collection.description }}{% else %}Breathe deeply and find your center with our mindful collection.{% endif %}</p>
  </div>
  {% if section.settings.sub_collections != blank %}
    <div class="clv58-chips">
      {% for link in section.settings.sub_collections.links %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% endfor %}
    </div>
  {% endif %}
  <div class="clv58-toolbar">
    <facet-filters-form style="width: 100%;">
      <form id="FacetFiltersForm" style="display: flex; justify-content: space-between; align-items: center; width: 100%; flex-wrap: wrap; gap: 20px;">
        <div style="display: flex; gap: 30px;">
          {%- for filter in collection.filters -%}
            <details style="position: relative;">
              <summary style="cursor: pointer; font-size: 14px; color: #52475A; letter-spacing: 1px;">{{ filter.label }} <span style="opacity:0.5; font-size:10px;">▼</span></summary>
              <div style="position: absolute; background: #FFF; border: 1px solid #EBE7EE; padding: 25px; border-radius: 10px; z-index: 10; margin-top: 15px; min-width: 220px; box-shadow: 0 10px 20px rgba(0,0,0,0.05);">
                {%- for value in filter.values -%}
                  <label style="display: block; margin-bottom: 12px; cursor: pointer; font-size: 13px; color: #8F8498;">
                    <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} style="accent-color: #C5CEBE;">
                    {{ value.label }} <span style="font-size: 11px;">({{ value.count }})</span>
                  </label>
                {%- endfor -%}
              </div>
            </details>
          {%- endfor -%}
        </div>
        <select name="sort_by" onchange="this.form.submit()" style="background: transparent; border: none; font-family: 'Arial', sans-serif; font-size: 13px; color: #52475A; letter-spacing: 1px; cursor: pointer; outline: none;">
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>Sort by: {{ option.name }}</option>
          {%- endfor -%}
        </select>
      </form>
    </facet-filters-form>
  </div>
  {% assign limit_num = section.settings.products_per_page | default: 12 %}
  {% paginate collection.products by limit_num %}
    <div class="clv58-grid">
      {% for product in collection.products %}
        {% render 'card-v58', product: product %}
        {% if forloop.index == 5 and section.settings.show_promo_tile %}
          <div class="clv58-promo">
            <h3>Guided<br>Meditation<br>Series</h3>
            <a href="/pages/meditation">Join Now</a>
          </div>
        {% endif %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v58', product: nil %}
        {% endfor %}
      {% endfor %}
    </div>
    <div style="margin-top: 60px; text-align: center; font-size: 16px; font-style: italic; color: #8F8498;">{{ paginate | default_pagination }}</div>
  {% endpaginate %}
  {% if section.settings.show_seo_block %}
    <div class="clv58-seo">
      <h2 style="font-size: 26px; font-weight: 400; color: #52475A; margin-bottom: 15px;">{{ section.settings.seo_title | default: 'Consciously Crafted' }}</h2>
      <p style="font-size: 15px; font-family: 'Arial', sans-serif; color: #8F8498; max-width: 650px; margin: 0 auto; line-height: 1.8;">{{ section.settings.seo_text | default: 'Our yoga and wellness essentials are made from organic, ethically sourced materials to support your practice and the planet.' }}</p>
    </div>
  {% endif %}
</div>
{% schema %}
{
  "name": "CL V58 — Yoga", "settings": [
    {"type": "range", "id": "products_per_page", "label": "Products per page", "min": 6, "max": 36, "step": 3, "default": 12},
    {"type": "range", "id": "cols_desktop", "label": "Desktop Columns", "min": 2, "max": 4, "default": 3},
    {"type": "select", "id": "cols_mobile", "label": "Mobile Columns", "options": [{"value": "1", "label": "1"}, {"value": "2", "label": "2"}], "default": "1"},
    {"type": "link_list", "id": "sub_collections", "label": "Sub-Collection Menu"},
    {"type": "checkbox", "id": "show_promo_tile", "label": "Show Promo Card", "default": true},
    {"type": "checkbox", "id": "show_seo_block", "label": "Show SEO Block", "default": true},
    {"type": "color", "id": "bg_color", "label": "Background Color", "default": "#F9F8FA"},
    {"type": "color", "id": "text_color", "label": "Text Color", "default": "#6E6278"}
  ], "presets": [{"name": "CL V58 — Yoga"}]
}
{% endschema %}
