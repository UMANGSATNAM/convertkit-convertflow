{%- liquid
  assign bg_color = section.settings.bg_color | default: '#ffffff'
  assign text_color = section.settings.text_color | default: '#2c2c2c'
  assign accent_color = section.settings.accent_color | default: '#8c7b66'
  
  assign padding_top_desktop = section.settings.padding_top_desktop
  assign padding_bottom_desktop = section.settings.padding_bottom_desktop
  assign padding_top_mobile = section.settings.padding_top_mobile
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile
-%}

<style>
  #shopify-section-{{ section.id }} {
    --hp4-usp-bg: {{ bg_color }};
    --hp4-usp-text: {{ text_color }};
    --hp4-usp-accent: {{ accent_color }};
    
    --hp4-usp-pt-desk: {{ padding_top_desktop }}px;
    --hp4-usp-pb-desk: {{ padding_bottom_desktop }}px;
    --hp4-usp-pt-mob: {{ padding_top_mobile }}px;
    --hp4-usp-pb-mob: {{ padding_bottom_mobile }}px;
  }

  .hp4-decor-usp-{{ section.id }} {
    padding-top: var(--hp4-usp-pt-desk);
    padding-bottom: var(--hp4-usp-pb-desk);
    background-color: var(--hp4-usp-bg);
    color: var(--hp4-usp-text);
    font-family: 'Inter', sans-serif;
    border-bottom: 1px solid rgba(0,0,0,0.05);
  }

  .hp4-usp-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .hp4-usp-grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: 40px;
  }

  .hp4-usp-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 30px;
    background: transparent;
    transition: transform 0.3s ease;
  }
  
  .hp4-usp-item:hover {
    transform: translateY(-5px);
  }

  /* Elegant Thin Icon Container */
  .hp4-usp-icon {
    width: 60px;
    height: 60px;
    margin-bottom: 25px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--hp4-usp-accent);
    position: relative;
  }
  
  /* Subtle circle background */
  .hp4-usp-icon::before {
    content: '';
    position: absolute;
    width: 100%;
    height: 100%;
    background: var(--hp4-usp-accent);
    opacity: 0.1;
    border-radius: 50%;
    z-index: 0;
  }

  .hp4-usp-icon svg {
    width: 28px;
    height: 28px;
    stroke-width: 1.2px; /* Thin elegant lines */
    fill: none;
    position: relative;
    z-index: 1;
  }
  
  .hp4-usp-icon img {
    width: 32px;
    height: 32px;
    object-fit: contain;
    position: relative;
    z-index: 1;
  }

  .hp4-usp-title {
    font-family: 'Playfair Display', serif;
    font-size: 20px;
    font-weight: 500;
    margin: 0 0 15px 0;
    color: var(--hp4-usp-text);
  }

  .hp4-usp-desc {
    font-size: 14px;
    line-height: 1.6;
    color: rgba(44,44,44,0.7);
    margin: 0;
    font-weight: 300;
  }

  @media screen and (max-width: 1024px) {
    .hp4-usp-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 30px;
    }
  }

  @media screen and (max-width: 768px) {
    .hp4-decor-usp-{{ section.id }} {
      padding-top: var(--hp4-usp-pt-mob);
      padding-bottom: var(--hp4-usp-pb-mob);
    }
    .hp4-usp-inner {
      padding: 0 20px;
    }
    .hp4-usp-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .hp4-usp-item {
      flex-direction: row;
      text-align: left;
      align-items: center;
      gap: 25px;
      padding: 20px 0;
      border-bottom: 1px solid rgba(0,0,0,0.05);
    }
    .hp4-usp-item:last-child {
      border-bottom: none;
    }
    .hp4-usp-icon {
      margin-bottom: 0;
      width: 50px;
      height: 50px;
      flex-shrink: 0;
    }
  }
</style>

<section class="hp4-decor-usp-{{ section.id }}" aria-label="Store Benefits">
  <div class="hp4-usp-inner">
    
    <div class="hp4-usp-grid">
      {%- for block in section.blocks -%}
        <div class="hp4-usp-item" {{ block.shopify_attributes }}>
          <div class="hp4-usp-icon">
            {%- if block.settings.custom_icon != blank -%}
              <img src="{{ block.settings.custom_icon | image_url: width: 100 }}" alt="{{ block.settings.title }}">
            {%- else -%}
              {%- case block.settings.icon -%}
                {%- when 'truck' -%}
                  <svg viewBox="0 0 24 24" stroke="currentColor"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line><line x1="9" y1="21" x2="9" y2="9"></line></svg>
                {%- when 'leaf' -%}
                  <svg viewBox="0 0 24 24" stroke="currentColor"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                {%- when 'heart' -%}
                  <svg viewBox="0 0 24 24" stroke="currentColor"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                {%- when 'shield' -%}
                  <svg viewBox="0 0 24 24" stroke="currentColor"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                {%- else -%}
                  <svg viewBox="0 0 24 24" stroke="currentColor"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
              {%- endcase -%}
            {%- endif -%}
          </div>
          <div class="hp4-usp-text-content">
            <h3 class="hp4-usp-title">{{ block.settings.title }}</h3>
            <p class="hp4-usp-desc">{{ block.settings.text }}</p>
          </div>
        </div>
      {%- endfor -%}

      {%- if section.blocks.size == 0 -%}
        {%- for i in (1..4) -%}
          <div class="hp4-usp-item">
            <div class="hp4-usp-icon">
              <svg viewBox="0 0 24 24" stroke="currentColor"><circle cx="12" cy="12" r="10"></circle></svg>
            </div>
            <div class="hp4-usp-text-content">
              <h3 class="hp4-usp-title">Artisan Crafted</h3>
              <p class="hp4-usp-desc">Handmade pieces by master craftsmen.</p>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "HP4 Decor USP Bar",
  "tag": "section",
  "class": "section-hp4-usp",
  "settings": [
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2, "max": 5, "step": 1,
      "label": "Columns (Desktop)", "default": 4
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2c2c2c"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Icon/Accent Color",
      "default": "#8c7b66"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Top (Desktop)", "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Bottom (Desktop)", "default": 60
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Top (Mobile)", "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Bottom (Mobile)", "default": 40
    }
  ],
  "blocks": [
    {
      "type": "usp",
      "name": "USP Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "truck", "label": "Truck/Delivery" },
            { "value": "leaf", "label": "Leaf/Eco" },
            { "value": "heart", "label": "Heart" },
            { "value": "shield", "label": "Shield" },
            { "value": "star", "label": "Star" }
          ],
          "default": "truck"
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Custom Icon Image (Overrides select)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Free Shipping"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Complimentary delivery on orders over $200."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP4 Decor USP Bar (Adv)",
      "category": "Trust",
      "blocks": [
        { "type": "usp", "settings": { "title": "White Glove Delivery", "icon": "truck" } },
        { "type": "usp", "settings": { "title": "Sustainable Sourcing", "icon": "leaf" } },
        { "type": "usp", "settings": { "title": "Artisan Crafted", "icon": "heart" } },
        { "type": "usp", "settings": { "title": "Lifetime Warranty", "icon": "shield" } }
      ]
    }
  ]
}
{% endschema %}
