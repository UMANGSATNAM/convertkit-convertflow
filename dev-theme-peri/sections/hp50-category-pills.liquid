{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp50-pills-bg: {{ section.settings.bg_color | default: '#000000' }};
    
    background-color: var(--hp50-pills-bg);
    padding: {{ section.settings.padding_vertical | default: 35 }}px 0;
  }

  .hp50-pills__wrap {
    max-width: {{ section.settings.container_width | default: 1100 }}px;
    margin: 0 auto;
    padding: 0 20px;
    display: flex;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .hp50-pill {
    padding: 10px 24px;
    background: #111111;
    border: 1px solid rgba(226, 232, 240, 0.25);
    color: #E2E8F0;
    font-family: 'Syne', sans-serif;
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .hp50-pill:hover, .hp50-pill--active {
    background: #FFFFFF;
    color: #000000;
    border-color: #FFFFFF;
    transform: translateY(-2px);
  }

  @media screen and (max-width: 576px) {
    .hp50-pills__wrap { justify-content: flex-start; overflow-x: auto; flex-wrap: nowrap; }
    .hp50-pill { flex-shrink: 0; }
  }
{%- endstyle -%}

<div class="hp50-pills__wrap">
  {%- if section.blocks.size > 0 -%}
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.url | default: '/collections/all' }}" class="hp50-pill {% if forloop.first %}hp50-pill--active{% endif %}" {{ block.shopify_attributes }}>
        {{ block.settings.title }}
      </a>
    {%- endfor -%}
  {%- else -%}
    <a href="/collections/all" class="hp50-pill hp50-pill--active">✦ All Runway Formulations</a>
    <a href="/collections/platinum" class="hp50-pill">✦ Platinum Contour Elixirs</a>
    <a href="/collections/obsidian" class="hp50-pill">✦ Obsidian Noir Crèmes</a>
    <a href="/collections/silver" class="hp50-pill">✦ Sterling Silver Mists</a>
    <a href="/collections/masks" class="hp50-pill">✦ Runway Peel Masks</a>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "HP50 - Runway Pills",
  "class": "section-hp50-pills",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#000000" },
    { "type": "range", "id": "padding_vertical", "min": 10, "max": 70, "step": 5, "unit": "px", "label": "Vertical Padding", "default": 35 },
    { "type": "range", "id": "container_width", "min": 800, "max": 1400, "step": 20, "unit": "px", "label": "Container Width", "default": 1100 }
  ],
  "blocks": [
    {
      "type": "pill",
      "name": "Pill",
      "settings": [
        { "type": "text", "id": "title", "label": "Label", "default": "✦ All Runway Formulations" },
        { "type": "url", "id": "url", "label": "Link URL" }
      ]
    }
  ],
  "presets": [
    { "name": "HP50 - Runway Pills" }
  ]
}
{% endschema %}
