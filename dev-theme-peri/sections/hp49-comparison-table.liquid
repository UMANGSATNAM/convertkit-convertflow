{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp49-comp-bg: {{ section.settings.bg_color | default: '#F5F3FF' }};
    --hp49-accent: {{ section.settings.accent_color | default: '#7C3AED' }};
    
    background-color: var(--hp49-comp-bg);
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
  }

  .hp49-comp__wrap {
    max-width: {{ section.settings.container_width | default: 980 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp49-comp__header {
    text-align: center;
    margin-bottom: 45px;
  }

  .hp49-comp__heading {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: clamp(30px, 4vw, 42px);
    font-weight: 800;
    color: #2E1065;
    margin: 0 0 8px;
  }

  .hp49-comp__card {
    background: #FFFFFF;
    border: 1px solid rgba(124, 58, 237, 0.2);
    border-radius: 32px;
    overflow: hidden;
    box-shadow: 0 15px 40px rgba(124, 58, 237, 0.08);
  }

  .hp49-comp__table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }

  .hp49-comp__table th, .hp49-comp__table td {
    padding: 18px 24px;
    text-align: center;
    border-bottom: 1px solid rgba(124, 58, 237, 0.12);
    color: #2E1065;
  }

  .hp49-comp__table th {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-weight: 800;
    background: #EDE9FE;
  }

  .hp49-comp__highlight {
    background: rgba(124, 58, 237, 0.08);
    font-weight: 800;
    color: var(--hp49-accent) !important;
  }

  @media screen and (max-width: 600px) {
    .hp49-comp__table th, .hp49-comp__table td { padding: 12px 10px; font-size: 12px; }
  }
{%- endstyle -%}

<div class="hp49-comp__wrap">
  <div class="hp49-comp__header">
    <h2 class="hp49-comp__heading">The Lavender Purity Benchmark</h2>
    <p style="font-size:14px; color:#5B21B6; opacity:0.85;">{{ section.settings.subheading | default: 'Pure French Alpine hydrosols vs artificial fragrance diluted formulas.' }}</p>
  </div>

  <div class="hp49-comp__card">
    <table class="hp49-comp__table">
      <thead>
        <tr>
          <th style="text-align:left;">Botanical Criteria</th>
          <th class="hp49-comp__highlight">Peri Lavender v49</th>
          <th>Conventional Brand</th>
        </tr>
      </thead>
      <tbody>
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <td style="text-align:left; font-weight:700;">{{ block.settings.feature }}</td>
              <td class="hp49-comp__highlight">{{ block.settings.brand_val }}</td>
              <td>{{ block.settings.other_val }}</td>
            </tr>
          {%- endfor -%}
        {%- else -%}
          <tr>
            <td style="text-align:left; font-weight:700;">Lavender Source</td>
            <td class="hp49-comp__highlight">1,200m French Alpine Steam Hydrosol</td>
            <td>Synthetic Perfume &amp; Solvent Extracts</td>
          </tr>
          <tr>
            <td style="text-align:left; font-weight:700;">Barrier Cushion Agent</td>
            <td class="hp49-comp__highlight">Bio-Peptides &amp; Cherry Blossom Micro-Lipids</td>
            <td>Heavy Mineral Petrolatum</td>
          </tr>
          <tr>
            <td style="text-align:left; font-weight:700;">Skin Reactivity Score</td>
            <td class="hp49-comp__highlight">0.00 Non-Irritant (Dermatologist Cleared)</td>
            <td>Potential Allergenic Perfumes</td>
          </tr>
          <tr>
            <td style="text-align:left; font-weight:700;">Global DDP Air Delivery</td>
            <td class="hp49-comp__highlight">100% Pre-Paid Customs &amp; Taxes</td>
            <td>Unexpected Border Duty Fees</td>
          </tr>
        {%- endif -%}
      </tbody>
    </table>
  </div>
</div>

{% schema %}
{
  "name": "HP49 - Lavender Matrix",
  "class": "section-hp49-matrix",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#F5F3FF" },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#7C3AED" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 80 },
    { "type": "range", "id": "container_width", "min": 700, "max": 1200, "step": 20, "unit": "px", "label": "Container Width", "default": 980 }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Matrix Row",
      "settings": [
        { "type": "text", "id": "feature", "label": "Feature", "default": "Lavender Source" },
        { "type": "text", "id": "brand_val", "label": "Our Value", "default": "1,200m French Alpine Steam Hydrosol" },
        { "type": "text", "id": "other_val", "label": "Conventional Value", "default": "Synthetic Perfume" }
      ]
    }
  ],
  "presets": [
    { "name": "HP49 - Lavender Matrix" }
  ]
}
{% endschema %}
