{% comment %} CL V39 — Baking / Patisserie (Soft Pink & Chocolate) {% endcomment %}
{{ 'component-facets.css' | asset_url | stylesheet_tag }}
<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
<style>
  .clv39 { background: {{ section.settings.bg_color | default: '#FFF5F5' }}; color: {{ section.settings.text_color | default: '#5C3A21' }}; padding: 50px 20px; font-family: 'Georgia', serif; }
  .clv39-hero { text-align: center; margin-bottom: 50px; }
  .clv39-hero h1 { font-size: 48px; font-weight: normal; color: #E5989B; margin-bottom: 15px; font-style: italic; }
  .clv39-hero p { font-size: 16px; font-family: 'Helvetica Neue', sans-serif; color: #5C3A21; max-width: 500px; margin: 0 auto; line-height: 1.6; }
  .clv39-hero::after { content: '∽ ✿ ∽'; display: block; margin-top: 20px; color: #FFB5A7; font-size: 20px; }
  .clv39-chips { display: flex; gap: 15px; justify-content: center; margin-bottom: 40px; flex-wrap: wrap; }
  .clv39-chips a { padding: 10px 25px; background: transparent; color: #5C3A21; text-decoration: none; font-size: 13px; font-family: 'Helvetica Neue', sans-serif; text-transform: uppercase; letter-spacing: 1px; border: 1px solid #E5989B; border-radius: 30px; transition: 0.3s; }
  .clv39-chips a:hover, .clv39-chips a.active { background: #E5989B; color: #FFF; }
  .clv39-toolbar { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px dashed #E5989B; padding-bottom: 20px; margin-bottom: 40px; font-family: 'Helvetica Neue', sans-serif; }
  .clv39-grid { display: grid; grid-template-columns: repeat({{ section.settings.cols_desktop | default: 4 }}, 1fr); gap: 30px; }
  .clv39-promo { grid-column: span 1; background: #FFCAD4; color: #5C3A21; border-radius: 15px; padding: 40px; text-align: center; display: flex; flex-direction: column; justify-content: center; align-items: center; }
  .clv39-promo h3 { font-size: 28px; font-style: italic; margin-bottom: 15px; font-weight: normal; line-height: 1.3; }
  .clv39-promo a { display: inline-block; padding: 10px 20px; background: #5C3A21; color: #FFF; text-decoration: none; font-size: 12px; font-family: 'Helvetica Neue', sans-serif; text-transform: uppercase; letter-spacing: 1px; border-radius: 20px; }
  .clv39-seo { margin-top: 60px; text-align: center; padding: 40px; border: 1px solid #FFCAD4; border-radius: 15px; background: #FFF; }
  @media (max-width: 768px) { .clv39-grid { grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr); gap: 20px; } .clv39-hero h1 { font-size: 36px; } }
</style>
<div class="clv39" style="max-width: 1200px; margin: 0 auto;">
  <div class="clv39-hero">
    <h1>{% if collection.title != blank %}{{ collection.title | escape }}{% else %}La Patisserie{% endif %}</h1>
    <p>{% if collection.description != blank %}{{ collection.description }}{% else %}Artisan tools and exquisite ingredients for the home baker.{% endif %}</p>
  </div>
  {% if section.settings.sub_collections != blank %}
    <div class="clv39-chips">
      {% for link in section.settings.sub_collections.links %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% endfor %}
    </div>
  {% endif %}
  <div class="clv39-toolbar">
    <facet-filters-form style="width: 100%;">
      <form id="FacetFiltersForm" style="display: flex; justify-content: space-between; align-items: center; width: 100%; flex-wrap: wrap; gap: 20px;">
        <div style="display: flex; gap: 25px;">
          {%- for filter in collection.filters -%}
            <details style="position: relative;">
              <summary style="cursor: pointer; font-size: 13px; text-transform: uppercase; letter-spacing: 1px; color: #5C3A21;">{{ filter.label }} ⏷</summary>
              <div style="position: absolute; background: #FFF; padding: 20px; border-radius: 10px; border: 1px solid #FFCAD4; z-index: 10; margin-top: 15px; min-width: 220px; box-shadow: 0 5px 15px rgba(0,0,0,0.05);">
                {%- for value in filter.values -%}
                  <label style="display: block; margin-bottom: 12px; cursor: pointer; font-size: 14px; color: #5C3A21;">
                    <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %}>
                    {{ value.label }} <span style="opacity: 0.6;">({{ value.count }})</span>
                  </label>
                {%- endfor -%}
              </div>
            </details>
          {%- endfor -%}
        </div>
        <select name="sort_by" onchange="this.form.submit()" style="background: transparent; border: none; font-family: 'Helvetica Neue', sans-serif; font-size: 13px; color: #5C3A21; text-transform: uppercase; letter-spacing: 1px; cursor: pointer; outline: none;">
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>Sort: {{ option.name }}</option>
          {%- endfor -%}
        </select>
      </form>
    </facet-filters-form>
  </div>
  {% assign limit_num = section.settings.products_per_page | default: 16 %}
  {% paginate collection.products by limit_num %}
    <div class="clv39-grid">
      {% for product in collection.products %}
        {% render 'card-v39', product: product %}
        {% if forloop.index == 8 and section.settings.show_promo_tile %}
          <div class="clv39-promo">
            <h3>French<br>Macarons</h3>
            <a href="/products/macarons">Taste Now</a>
          </div>
        {% endif %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v39', product: nil %}
        {% endfor %}
      {% endfor %}
    </div>
    <div style="margin-top: 50px; text-align: center; font-family: 'Helvetica Neue', sans-serif; font-size: 14px;">{{ paginate | default_pagination }}</div>
  {% endpaginate %}
  {% if section.settings.show_seo_block %}
    <div class="clv39-seo">
      <h2 style="font-size: 24px; font-style: italic; color: #E5989B; margin-bottom: 15px; font-weight: normal;">{{ section.settings.seo_title | default: 'Baked with Love' }}</h2>
      <p style="font-size: 14px; font-family: 'Helvetica Neue', sans-serif; color: #5C3A21; max-width: 650px; margin: 0 auto; line-height: 1.8;">{{ section.settings.seo_text | default: 'From premium vanilla bean paste to professional-grade pastry bags, we provide everything you need to create sweet masterpieces in your own kitchen.' }}</p>
    </div>
  {% endif %}
</div>
{% schema %}
{
  "name": "CL V39 — Baking", "settings": [
    {"type": "range", "id": "products_per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 16},
    {"type": "range", "id": "cols_desktop", "label": "Desktop Columns", "min": 2, "max": 5, "default": 4},
    {"type": "select", "id": "cols_mobile", "label": "Mobile Columns", "options": [{"value": "1", "label": "1"}, {"value": "2", "label": "2"}], "default": "2"},
    {"type": "link_list", "id": "sub_collections", "label": "Sub-Collection Menu"},
    {"type": "checkbox", "id": "show_promo_tile", "label": "Show Promo Card", "default": true},
    {"type": "checkbox", "id": "show_seo_block", "label": "Show SEO Block", "default": true},
    {"type": "color", "id": "bg_color", "label": "Background Color", "default": "#FFF5F5"},
    {"type": "color", "id": "text_color", "label": "Text Color", "default": "#5C3A21"}
  ], "presets": [{"name": "CL V39 — Baking"}]
}
{% endschema %}
