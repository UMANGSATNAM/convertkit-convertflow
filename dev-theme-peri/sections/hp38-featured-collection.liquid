{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Space+Mono:ital,wght@0,400;0,700;1,400;1,700&family=Inter:wght@400;600;800&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    
    --font-heading: 'Space Mono', monospace;
    --font-body: 'Inter', sans-serif;
    
    background-color: var(--bg-color);
    border-bottom: 2px solid var(--text-color);
  }

  .hp38-featured-wrapper {
    display: grid;
    grid-template-columns: 350px 1fr;
    /* Grid gap acts as border via background color */
    background-color: var(--text-color);
    gap: 2px;
  }

  @media screen and (max-width: 992px) {
    .hp38-featured-wrapper {
      grid-template-columns: 1fr;
    }
  }

  /* SIDEBAR */
  .hp38-featured__sidebar {
    background-color: var(--bg-color);
    padding: 60px 40px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  @media screen and (max-width: 992px) {
    .hp38-featured__sidebar {
      padding: 40px 20px;
      text-align: center;
      align-items: center;
    }
  }

  .hp38-featured__meta {
    font-family: var(--font-heading);
    font-size: 12px;
    font-weight: 700;
    color: var(--accent-color);
    border: 1px solid var(--accent-color);
    padding: 4px 8px;
    margin-bottom: 20px;
    align-self: flex-start;
  }
  @media screen and (max-width: 992px) {
    .hp38-featured__meta { align-self: center; }
  }

  .hp38-featured__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    line-height: 1.1;
    text-transform: uppercase;
    color: var(--text-color);
    margin: 0 0 20px;
  }

  .hp38-featured__text {
    font-family: var(--font-body);
    font-size: 16px;
    color: var(--text-color);
    margin-bottom: 30px;
  }

  .hp38-featured__btn {
    display: inline-block;
    padding: 15px 30px;
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    text-decoration: none;
    border: 2px solid var(--text-color);
    background: var(--text-color);
    color: var(--bg-color);
    align-self: flex-start;
  }
  @media screen and (max-width: 992px) {
    .hp38-featured__btn { align-self: center; }
  }

  .hp38-featured__btn:hover {
    background: var(--bg-color);
    color: var(--text-color);
  }

  /* GRID AREA */
  .hp38-featured__grid {
    background-color: var(--bg-color);
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 2px;
    background-color: var(--text-color); /* Lines */
  }

  .hp38-product-card {
    background: var(--bg-color);
    display: flex;
    flex-direction: column;
    text-decoration: none;
    position: relative;
    group: card;
  }

  .hp38-product-card__image-wrap {
    width: 100%;
    aspect-ratio: 4/5;
    background: #f4f4f4;
    position: relative;
    overflow: hidden;
    border-bottom: 2px solid var(--text-color);
  }

  .hp38-product-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%);
    transition: filter 0.3s ease;
  }

  .hp38-product-card:hover .hp38-product-card__image {
    filter: grayscale(0%);
  }

  .hp38-product-card__badge {
    position: absolute;
    top: 15px;
    right: 15px;
    background: var(--accent-color);
    color: #fff;
    font-family: var(--font-heading);
    font-size: 12px;
    padding: 4px 8px;
    text-transform: uppercase;
  }

  .hp38-product-card__info {
    padding: 20px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    justify-content: space-between;
  }

  .hp38-product-card__title {
    font-family: var(--font-heading);
    font-size: 18px;
    color: var(--text-color);
    margin: 0 0 10px;
    text-transform: uppercase;
  }

  .hp38-product-card__price {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 700;
    color: var(--text-color);
  }

  .hp38-product-card__footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 15px;
    border-top: 1px dashed var(--text-color);
    padding-top: 15px;
  }

  .hp38-product-card__id {
    font-family: var(--font-heading);
    font-size: 10px;
    color: var(--text-color);
    opacity: 0.5;
  }

  .hp38-product-card__add {
    font-family: var(--font-heading);
    font-size: 12px;
    color: var(--text-color);
    text-transform: uppercase;
    font-weight: 700;
  }

  .hp38-product-card:hover .hp38-product-card__add {
    color: var(--accent-color);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp38-featured-wrapper" id="HP38Featured-{{ section.id }}">
  <div class="hp38-featured__sidebar">
    <div class="hp38-featured__meta">OBJ // COLLECTION</div>
    <h2 class="hp38-featured__title">{{ section.settings.title }}</h2>
    {%- if section.settings.text != blank -%}
      <p class="hp38-featured__text">{{ section.settings.text }}</p>
    {%- endif -%}
    {%- if section.settings.btn_label != blank -%}
      <a href="{{ section.settings.btn_link | default: '#' }}" class="hp38-featured__btn">
        {{ section.settings.btn_label }}
      </a>
    {%- endif -%}
  </div>

  <div class="hp38-featured__grid">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.product_link | default: '#' }}" class="hp38-product-card" {{ block.shopify_attributes }}>
        <div class="hp38-product-card__image-wrap">
          {%- if block.settings.badge != blank -%}
            <div class="hp38-product-card__badge">{{ block.settings.badge }}</div>
          {%- endif -%}
          
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title | escape }}" class="hp38-product-card__image" loading="lazy">
          {%- else -%}
            {%- assign placeholder = 'product-' | append: forloop.index -%}
            {%- if forloop.index > 6 -%}{%- assign placeholder = 'product-1' -%}{%- endif -%}
            {{ placeholder | placeholder_svg_tag: 'hp38-product-card__image' }}
          {%- endif -%}
        </div>
        
        <div class="hp38-product-card__info">
          <div>
            <h3 class="hp38-product-card__title">{{ block.settings.title }}</h3>
            <div class="hp38-product-card__price">{{ block.settings.price }}</div>
          </div>
          
          <div class="hp38-product-card__footer">
            <span class="hp38-product-card__id">ID:{{ forloop.index }}00{{ section.id | slice: 0, 4 }}</span>
            <span class="hp38-product-card__add">[ + ADD ]</span>
          </div>
        </div>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "HP38 - Brutalist Featured",
  "class": "section-hp38-featured-collection",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "CORE ASSETS"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Standard issue equipment for daily operations. High durability."
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "VIEW ALL"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 48
    },
    {
      "type": "header",
      "content": "Brutalist Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text & Grid Lines",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#0000FF"
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge",
          "default": "NEW"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "UNIT-01 JACKET"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "$150.00"
        },
        {
          "type": "url",
          "id": "product_link",
          "label": "Product Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP38 - Brutalist Featured",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
