{%- style -%}
  .featured-categories-v2 {
    background-color: var(--bg-base);
    padding: var(--space-48) 0;
    position: relative;
  }
  @media (min-width: 768px) {
    .featured-categories-v2 {
      padding: var(--space-64) 0;
    }
  }

  .featured-categories-v2__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    margin-bottom: var(--space-32);
    text-align: left;
  }
  @media (min-width: 768px) {
    .featured-categories-v2__header {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
      margin-bottom: var(--space-40);
    }
  }

  .featured-categories-v2__title-wrapper {
    max-width: 600px;
  }
  .featured-categories-v2__subhead {
    font-size: var(--text-12);
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--primary);
    margin-bottom: var(--space-8);
    display: block;
  }
  .featured-categories-v2__title {
    font-size: var(--text-32);
    font-weight: 400;
    line-height: 1.2;
    color: var(--text-main);
    margin: 0;
  }
  @media (min-width: 768px) {
    .featured-categories-v2__title {
      font-size: var(--text-40);
    }
  }

  .featured-categories-v2__grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: var(--space-20);
  }
  @media (min-width: 640px) {
    .featured-categories-v2__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .featured-categories-v2__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .fc-card {
    position: relative;
    border-radius: var(--radius-card);
    overflow: hidden;
    aspect-ratio: 4 / 5;
    text-decoration: none;
    background-color: var(--surface);
    border: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: var(--space-24);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s ease;
  }
  .fc-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lg);
  }

  .fc-card__image-wrapper {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }
  .fc-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .fc-card:hover .fc-card__image {
    transform: scale(1.08);
  }

  .fc-card__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(180deg, rgba(0,0,0,0) 40%, rgba(15,23,42,0.85) 100%);
    z-index: 2;
    transition: opacity 0.3s ease;
  }
  .fc-card:hover .fc-card__overlay {
    background: linear-gradient(180deg, rgba(0,0,0,0.1) 30%, rgba(15,23,42,0.92) 100%);
  }

  .fc-card__content {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }
  .fc-card__tag {
    align-self: flex-start;
    background-color: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(8px);
    color: #ffffff;
    font-size: var(--text-12);
    font-weight: 500;
    padding: 4px 12px;
    border-radius: var(--radius-pill);
    letter-spacing: 0.5px;
  }
  .fc-card__title {
    font-size: var(--text-20);
    font-weight: 500;
    color: #ffffff;
    margin: 0;
    line-height: 1.3;
  }
  .fc-card__link-text {
    font-size: var(--text-14);
    font-weight: 500;
    color: #ffffff;
    opacity: 0.8;
    display: flex;
    align-items: center;
    gap: 6px;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .fc-card:hover .fc-card__link-text {
    opacity: 1;
    transform: translateX(4px);
  }
{%- endstyle -%}

<div class="featured-categories-v2">
  <div class="fresh-container">
    <div class="featured-categories-v2__header">
      <div class="featured-categories-v2__title-wrapper">
        {%- if section.settings.subhead != blank -%}
          <span class="featured-categories-v2__subhead">{{ section.settings.subhead }}</span>
        {%- endif -%}
        <h2 class="featured-categories-v2__title">{{ section.settings.title | default: "Clinical Botanical Collections" }}</h2>
      </div>
      {%- if section.settings.view_all_url != blank -%}
        <a href="{{ section.settings.view_all_url }}" class="fresh-btn fresh-btn--outline">
          Explore All Formulas →
        </a>
      {%- endif -%}
    </div>

    <div class="featured-categories-v2__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign collection = collections[block.settings.collection]
          assign title = block.settings.title | default: collection.title | default: "Botanical Ritual"
          assign image = block.settings.image | default: collection.image | default: collection.products.first.featured_image
          assign url = collection.url | default: block.settings.url | default: "#"
        -%}

        <a href="{{ url }}" class="fc-card" {{ block.shopify_attributes }}>
          <div class="fc-card__image-wrapper">
            {%- if image -%}
              <img height="{{ image.height }}" width="{{ image.width }}" src="{{ image | image_url: width: 600 }}" alt="{{ title | escape }}" class="fc-card__image" loading="lazy">
            {%- else -%}
              <div class="fc-card__image" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); display: flex; flex-direction: column; align-items: center; justify-content: center; color: #ffffff; text-align: center; padding: 24px; width: 100%; height: 100%;">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" style="opacity: 0.4; margin-bottom: 12px;"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                <span style="font-size: 11px; font-weight: 600; letter-spacing: 2px; text-transform: uppercase; opacity: 0.8;">{{ shop.name | default: 'AURELLE BEAUTY' }}</span>
                <span style="font-size: 9px; font-weight: 500; letter-spacing: 1.5px; text-transform: uppercase; opacity: 0.4; margin-top: 4px;">Botanical Ritual</span>
              </div>
            {%- endif -%}
          </div>
          <div class="fc-card__overlay"></div>
          <div class="fc-card__content">
            <span class="fc-card__tag">{{ block.settings.tag_text | default: "Targeted Care" }}</span>
            <h3 class="fc-card__title">{{ title }}</h3>
            <span class="fc-card__link-text">Shop Collection →</span>
          </div>
        </a>
      {%- else -%}
        {%- comment -%} Fallback blocks when none added in admin {%- endcomment -%}
        {%- assign fallback_titles = "Hydration & Serums,Barrier Repair Creams,Exfoliating Toners,Daily Defense SPF" | split: "," -%}
        {%- assign fallback_tags = "Deep Moisture,Restorative,Cellular Renewal,Broad Spectrum" | split: "," -%}

        {%- for i in (0..3) -%}
          <a href="/collections/all" class="fc-card">
            <div class="fc-card__image-wrapper">
              <div class="fc-card__image" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); display: flex; flex-direction: column; align-items: center; justify-content: center; color: #ffffff; text-align: center; padding: 24px; width: 100%; height: 100%;">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" style="opacity: 0.4; margin-bottom: 12px;"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                <span style="font-size: 11px; font-weight: 600; letter-spacing: 2px; text-transform: uppercase; opacity: 0.8;">{{ shop.name | default: 'AURELLE BEAUTY' }}</span>
                <span style="font-size: 9px; font-weight: 500; letter-spacing: 1.5px; text-transform: uppercase; opacity: 0.4; margin-top: 4px;">{{ fallback_titles[i] }}</span>
              </div>
            </div>
            <div class="fc-card__overlay"></div>
            <div class="fc-card__content">
              <span class="fc-card__tag">{{ fallback_tags[i] }}</span>
              <h3 class="fc-card__title">{{ fallback_titles[i] }}</h3>
              <span class="fc-card__link-text">Shop Collection →</span>
            </div>
          </a>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Featured Categories V2",
  "settings": [
    {
      "type": "text",
      "id": "subhead",
      "label": "Subheading",
      "default": "Targeted Solutions"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Clinical Botanical Collections"
    },
    {
      "type": "url",
      "id": "view_all_url",
      "label": "View All URL",
      "default": "/collections/all"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Block",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom Title (Optional)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Image (Optional)"
        },
        {
          "type": "text",
          "id": "tag_text",
          "label": "Badge Tag",
          "default": "Bestseller"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Custom Link (Optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Categories V2",
      "blocks": [
        { "type": "category", "settings": { "tag_text": "Deep Moisture" } },
        { "type": "category", "settings": { "tag_text": "Barrier Repair" } },
        { "type": "category", "settings": { "tag_text": "Cell Renewal" } },
        { "type": "category", "settings": { "tag_text": "Daily Shield" } }
      ]
    }
  ]
}
{% endschema %}
