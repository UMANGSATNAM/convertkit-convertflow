{%- liquid
  assign sec_id = section.id
  assign bg_color = section.settings.bg_color
  assign text_color = section.settings.text_color
  assign accent_color = section.settings.accent_color
  assign border_color = section.settings.border_color
  assign border_width = section.settings.border_width
  assign sticky_header = section.settings.sticky_header
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
  assign logo_text = section.settings.logo_text
  assign main_menu = section.settings.main_menu
  assign show_cart = section.settings.show_cart
  assign show_search = section.settings.show_search
  assign show_account = section.settings.show_account
-%}

<style>
  .hp18-header-{{ sec_id }} {
    background-color: {{ bg_color }};
    border-bottom: {{ border_width }}px solid {{ border_color }};
    padding-top: {{ padding_top }}px;
    padding-bottom: {{ padding_bottom }}px;
    {% if sticky_header %}
      position: sticky;
      top: 0;
      z-index: 999;
    {% else %}
      position: relative;
      z-index: 999;
    {% endif %}
    transition: transform 0.3s ease;
  }

  .hp18-header-{{ sec_id }}.is-hidden {
    transform: translateY(-100%);
  }

  .hp18-header-{{ sec_id }}__wrap {
    max-width: var(--page-width, 1440px);
    margin: 0 auto;
    padding: 0 40px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
  }

  .hp18-header-{{ sec_id }}__mobile-toggle {
    display: none;
    background: transparent;
    border: none;
    cursor: pointer;
    color: {{ text_color }};
    padding: 0;
    align-items: center;
  }

  .hp18-header-{{ sec_id }}__logo-wrapper {
    grid-column: 2;
    text-align: center;
  }

  .hp18-header-{{ sec_id }}__logo {
    font-family: 'Arial Black', Impact, sans-serif;
    font-size: clamp(24px, 3vw, 40px);
    color: {{ text_color }};
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: -1px;
    text-shadow: 3px 3px 0px {{ accent_color }};
    display: inline-block;
    transition: transform 0.2s ease;
  }

  .hp18-header-{{ sec_id }}__logo:hover {
    transform: translate(-2px, -2px);
    text-shadow: 5px 5px 0px {{ accent_color }};
  }

  .hp18-header-{{ sec_id }}__nav {
    grid-column: 1;
    grid-row: 1;
    display: flex;
    gap: 30px;
  }

  .hp18-header-{{ sec_id }}__link {
    font-family: 'Courier New', monospace;
    font-weight: bold;
    color: {{ text_color }};
    text-decoration: none;
    font-size: 16px;
    text-transform: uppercase;
    padding: 8px 12px;
    border: 2px solid transparent;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .hp18-header-{{ sec_id }}__link:hover {
    background-color: {{ text_color }};
    color: {{ accent_color }};
    border: 2px solid {{ border_color }};
    box-shadow: 4px 4px 0px {{ accent_color }};
    transform: translate(-2px, -2px);
  }

  .hp18-header-{{ sec_id }}__actions {
    grid-column: 3;
    display: flex;
    justify-content: flex-end;
    gap: 15px;
  }

  .hp18-header-{{ sec_id }}__icon-btn {
    background: transparent;
    border: 2px solid transparent;
    color: {{ text_color }};
    width: 44px;
    height: 44px;
    display: flex;
    justify-content: center;
    align-items: center;
    cursor: pointer;
    transition: all 0.2s ease;
    text-decoration: none;
  }

  .hp18-header-{{ sec_id }}__icon-btn:hover {
    background-color: {{ text_color }};
    color: {{ bg_color }};
    border: 2px solid {{ border_color }};
    box-shadow: 3px 3px 0px {{ accent_color }};
    transform: translate(-2px, -2px);
  }

  .hp18-header-{{ sec_id }}__icon-btn svg {
    width: 24px;
    height: 24px;
    fill: currentColor;
  }

  .hp18-header-{{ sec_id }}__cart-btn {
    background-color: {{ accent_color }};
    color: {{ text_color }};
    border: {{ border_width }}px solid {{ border_color }};
    padding: 0 24px;
    height: 44px;
    display: flex;
    align-items: center;
    font-family: 'Arial Black', sans-serif;
    text-transform: uppercase;
    text-decoration: none;
    box-shadow: 4px 4px 0px {{ border_color }};
    transition: all 0.1s ease;
  }

  .hp18-header-{{ sec_id }}__cart-btn:hover {
    background-color: {{ text_color }};
    color: {{ accent_color }};
  }

  .hp18-header-{{ sec_id }}__cart-btn:active {
    box-shadow: 0px 0px 0px {{ border_color }};
    transform: translate(4px, 4px);
  }

  .hp18-header-{{ sec_id }}__cart-count {
    margin-left: 8px;
    background-color: {{ text_color }};
    color: {{ bg_color }};
    padding: 2px 6px;
    font-size: 14px;
  }

  /* Mobile Drawer Styles */
  .hp18-drawer-{{ sec_id }} {
    position: fixed;
    top: 0;
    left: -100%;
    width: 100%;
    max-width: 400px;
    height: 100vh;
    background-color: {{ bg_color }};
    border-right: {{ border_width }}px solid {{ border_color }};
    z-index: 10000;
    transition: left 0.3s cubic-bezier(0.25, 1, 0.5, 1);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
  }

  .hp18-drawer-{{ sec_id }}.is-open {
    left: 0;
    box-shadow: 20px 0 0px rgba(0,0,0,0.1);
  }

  .hp18-drawer-{{ sec_id }}__header {
    padding: 20px;
    border-bottom: {{ border_width }}px solid {{ border_color }};
    display: flex;
    justify-content: space-between;
    align-items: center;
    background-color: {{ accent_color }};
  }

  .hp18-drawer-{{ sec_id }}__close {
    background: transparent;
    border: 2px solid {{ border_color }};
    width: 40px;
    height: 40px;
    display: flex;
    justify-content: center;
    align-items: center;
    cursor: pointer;
    background-color: {{ bg_color }};
    box-shadow: 3px 3px 0px {{ border_color }};
  }
  
  .hp18-drawer-{{ sec_id }}__close:active {
    box-shadow: 0 0 0 {{ border_color }};
    transform: translate(3px, 3px);
  }

  .hp18-drawer-{{ sec_id }}__nav {
    display: flex;
    flex-direction: column;
    padding: 20px;
  }

  .hp18-drawer-{{ sec_id }}__nav-link {
    font-family: 'Arial Black', sans-serif;
    font-size: 24px;
    color: {{ text_color }};
    text-decoration: none;
    text-transform: uppercase;
    padding: 15px 0;
    border-bottom: 2px solid rgba(0,0,0,0.1);
  }

  .hp18-overlay-{{ sec_id }} {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    background-color: rgba(0,0,0,0.5);
    z-index: 9999;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .hp18-overlay-{{ sec_id }}.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  @media screen and (max-width: 992px) {
    .hp18-header-{{ sec_id }}__wrap {
      grid-template-columns: auto 1fr auto;
      padding: 0 20px;
      gap: 15px;
    }
    .hp18-header-{{ sec_id }}__nav { display: none; }
    .hp18-header-{{ sec_id }}__mobile-toggle { 
      display: flex; 
      grid-column: 1;
    }
    .hp18-header-{{ sec_id }}__mobile-toggle svg {
      width: 32px;
      height: 32px;
    }
    .hp18-header-{{ sec_id }}__icon-btn { display: none; }
  }
</style>

<header class="hp18-header-{{ sec_id }}" id="Header-{{ sec_id }}" data-sticky="{{ sticky_header }}">
  <div class="hp18-header-{{ sec_id }}__wrap">
    
    <button type="button" class="hp18-header-{{ sec_id }}__mobile-toggle js-mobile-toggle">
      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z"/></svg>
    </button>

    <nav class="hp18-header-{{ sec_id }}__nav">
      {% for link in linklists[main_menu].links %}
        <a href="{{ link.url }}" class="hp18-header-{{ sec_id }}__link">{{ link.title }}</a>
      {% else %}
        <a href="/collections/all" class="hp18-header-{{ sec_id }}__link">Shop</a>
        <a href="/collections/new" class="hp18-header-{{ sec_id }}__link">New Drops</a>
        <a href="/pages/about" class="hp18-header-{{ sec_id }}__link">About</a>
      {% endfor %}
    </nav>
    
    <div class="hp18-header-{{ sec_id }}__logo-wrapper">
      {% if section.settings.logo_image != blank %}
        <a href="{{ routes.root_url }}" class="hp18-header-{{ sec_id }}__logo-img">
          <img src="{{ section.settings.logo_image | image_url: width: 2048 }}" alt="{{ shop.name }}" style="max-height: {{ section.settings.logo_max_height }}px;">
        </a>
      {% else %}
        <a href="{{ routes.root_url }}" class="hp18-header-{{ sec_id }}__logo">
          {{ logo_text | default: shop.name | default: 'STREETWR.' }}
        </a>
      {% endif %}
    </div>
    
    <div class="hp18-header-{{ sec_id }}__actions">
      {% if show_search %}
      <a href="{{ routes.search_url }}" class="hp18-header-{{ sec_id }}__icon-btn">
        <svg viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0016 9.5 6.5 6.5 0 109.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
      </a>
      {% endif %}
      
      {% if show_account and shop.customer_accounts_enabled %}
      <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="hp18-header-{{ sec_id }}__icon-btn">
        <svg viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
      </a>
      {% endif %}

      {% render 'search-bar', compact: true %}
      {% render 'wishlist-icon', class: 'hp18-header-' | append: sec_id | append: '__icon-btn' %}

      {% if show_cart %}
      <a href="{{ routes.cart_url }}" data-cart-open class="hp18-header-{{ sec_id }}__cart-btn">
        CART <span class="hp18-header-{{ sec_id }}__cart-count">{{ cart.item_count }}</span>
      </a>
      {% endif %}
    </div>
  </div>
</header>

<!-- Mobile Drawer -->
<div class="hp18-overlay-{{ sec_id }} js-drawer-overlay"></div>
<div class="hp18-drawer-{{ sec_id }} js-drawer">
  <div class="hp18-drawer-{{ sec_id }}__header">
    <span style="font-family: 'Arial Black'; font-size: 24px; color: {{ text_color }};">MENU</span>
    <button class="hp18-drawer-{{ sec_id }}__close js-drawer-close">
      <svg viewBox="0 0 24 24" fill="currentColor" width="24" height="24"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
    </button>
  </div>
  <nav class="hp18-drawer-{{ sec_id }}__nav">
    {% for link in linklists[main_menu].links %}
      <a href="{{ link.url }}" class="hp18-drawer-{{ sec_id }}__nav-link">{{ link.title }}</a>
    {% else %}
      <a href="/collections/all" class="hp18-drawer-{{ sec_id }}__nav-link">Shop</a>
      <a href="/collections/new" class="hp18-drawer-{{ sec_id }}__nav-link">New Drops</a>
      <a href="/pages/about" class="hp18-drawer-{{ sec_id }}__nav-link">About</a>
    {% endfor %}
    
    {% if show_account and shop.customer_accounts_enabled %}
      <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="hp18-drawer-{{ sec_id }}__nav-link">Account</a>
    {% endif %}
  </nav>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Drawer Logic
    const toggleBtn = document.querySelector('.js-mobile-toggle');
    const closeBtn = document.querySelector('.js-drawer-close');
    const drawer = document.querySelector('.js-drawer');
    const overlay = document.querySelector('.js-drawer-overlay');

    function openDrawer() {
      drawer.classList.add('is-open');
      overlay.classList.add('is-open');
      document.body.style.overflow = 'hidden';
    }

    function closeDrawer() {
      drawer.classList.remove('is-open');
      overlay.classList.remove('is-open');
      document.body.style.overflow = '';
    }

    if (toggleBtn) toggleBtn.addEventListener('click', openDrawer);
    if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
    if (overlay) overlay.addEventListener('click', closeDrawer);

    // Sticky Header Scroll Logic
    const header = document.getElementById('Header-{{ sec_id }}');
    if (header && header.dataset.sticky === 'true') {
      let lastScroll = 0;
      window.addEventListener('scroll', () => {
        const currentScroll = window.pageYOffset;
        if (currentScroll <= 0) {
          header.classList.remove('is-hidden');
          return;
        }
        if (currentScroll > lastScroll && currentScroll > 100) {
          header.classList.add('is-hidden');
        } else {
          header.classList.remove('is-hidden');
        }
        lastScroll = currentScroll;
      });
    }
  });
</script>

{% schema %}
{
  "name": "HP18 Advanced Header",
  "settings": [
    {
      "type": "header",
      "content": "Color Settings"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f4f4f0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#CCFF00"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Layout & Branding"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "Border Width",
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "sticky_header",
      "label": "Enable Sticky Header",
      "default": true
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo Text",
      "default": "STREETWR."
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo Image (Overrides text)"
    },
    {
      "type": "range",
      "id": "logo_max_height",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Logo Image Max Height",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 10,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Padding Top",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 10,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 20
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "link_list",
      "id": "main_menu",
      "label": "Main Menu"
    },
    {
      "type": "header",
      "content": "Icons"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show Search Icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show Account Icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cart",
      "label": "Show Cart Button",
      "default": true
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation menu",
      "info": "Leave empty to use the store's main menu.",
      "default": "main-menu"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "padding_mobile",
      "label": "Mobile padding",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Falls back to the store name when empty."
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 60,
      "max": 260,
      "step": 10,
      "unit": "px",
      "default": 120
    },
    {
      "type": "header",
      "content": "Behaviour"
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "Stick to the top on scroll",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "HP18 Advanced Header"
    }
  ]
}
{% endschema %}
