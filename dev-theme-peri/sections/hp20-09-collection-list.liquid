{%- liquid
  assign sec_id = section.id
-%}

<style>
  #shopify-section-{{ sec_id }} {
    background-color: {{ section.settings.bg_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px 0;
  }

  .hp20-cl-{{ sec_id }} {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp20-cl-{{ sec_id }}__header {
    text-align: center;
    margin-bottom: 60px;
  }

  .hp20-cl-{{ sec_id }}__title {
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 300;
    color: {{ section.settings.text_color }};
    margin: 0;
    letter-spacing: -0.02em;
  }

  .hp20-cl-{{ sec_id }}__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.grid_cols }}, 1fr);
    gap: 24px;
  }

  .hp20-cl-card {
    position: relative;
    overflow: hidden;
    display: block;
    padding-top: 130%;
    background-color: #f0f0f0;
  }

  .hp20-cl-card__img {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .hp20-cl-card__overlay {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background: linear-gradient(to top, rgba(0,0,0,0.6) 0%, rgba(0,0,0,0) 40%);
    opacity: 0.6;
    transition: opacity 0.4s ease;
  }

  .hp20-cl-card:hover .hp20-cl-card__img {
    transform: scale(1.08);
  }
  .hp20-cl-card:hover .hp20-cl-card__overlay {
    opacity: 0.8;
  }

  .hp20-cl-card__content {
    position: absolute;
    bottom: 0; left: 0; width: 100%;
    padding: 32px;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    z-index: 2;
  }

  .hp20-cl-card__title {
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-size: 24px;
    font-weight: 400;
    color: #ffffff;
    margin: 0;
  }

  .hp20-cl-card__count {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(255,255,255,0.7);
  }

  @media screen and (max-width: 990px) {
    .hp20-cl-{{ sec_id }}__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ sec_id }} {
      padding: {{ section.settings.padding_top_mobile }}px 0 {{ section.settings.padding_bottom_mobile }}px 0;
    }
    .hp20-cl-{{ sec_id }}__grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .hp20-cl-card__content {
      padding: 24px;
    }
  }
</style>

<section class="hp20-cl-{{ sec_id }}">
  {% if section.settings.title != blank %}
    <div class="hp20-cl-{{ sec_id }}__header">
      <h2 class="hp20-cl-{{ sec_id }}__title">{{ section.settings.title }}</h2>
    </div>
  {% endif %}

  <div class="hp20-cl-{{ sec_id }}__grid">
    {% for block in section.blocks %}
      {% assign coll = collections[block.settings.collection] %}
      <a href="{{ coll.url | default: '#' }}" class="hp20-cl-card" {{ block.shopify_attributes }}>
        {% if block.settings.image != blank %}
          <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ coll.title | escape }}" class="hp20-cl-card__img" loading="lazy">
        {% elsif coll.image != blank %}
          <img src="{{ coll.image | image_url: width: 800 }}" alt="{{ coll.title | escape }}" class="hp20-cl-card__img" loading="lazy">
        {% else %}
          {{ 'collection-' | append: forloop.index | placeholder_svg_tag: 'hp20-cl-card__img' }}
        {% endif %}
        
        <div class="hp20-cl-card__overlay"></div>
        <div class="hp20-cl-card__content">
          <h3 class="hp20-cl-card__title">{{ block.settings.title | default: coll.title | default: 'Collection' }}</h3>
          <span class="hp20-cl-card__count">{{ coll.products_count | default: 0 }} Items</span>
        </div>
      </a>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "HP20 Collection List",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Shop by Category"
    },
    {
      "type": "range",
      "id": "grid_cols",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Desktop Columns",
      "default": 3
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1a1a1a"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0, "max": 160, "step": 10, "unit": "px",
      "label": "Desktop Top Padding", "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0, "max": 160, "step": 10, "unit": "px",
      "label": "Desktop Bottom Padding", "default": 120
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0, "max": 100, "step": 10, "unit": "px",
      "label": "Mobile Top Padding", "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0, "max": 100, "step": 10, "unit": "px",
      "label": "Mobile Bottom Padding", "default": 60
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Image (Optional)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom Title (Optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP20 Collection List",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
