{%- style -%}
  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --border-color: {{ section.settings.border_color }};
    --border-thickness: {{ section.settings.border_thickness }}px;
    --shadow-color: {{ section.settings.shadow_color }};
    --shadow-offset: {{ section.settings.shadow_offset }}px;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }

  .hp20-offer-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp20-offer__container {
    background: {{ section.settings.box_bg }};
    border: var(--border-thickness) solid var(--border-color);
    box-shadow: var(--shadow-offset) var(--shadow-offset) 0px var(--shadow-color);
    display: flex;
    flex-direction: {% if section.settings.layout == 'left' %}row{% else %}row-reverse{% endif %};
    align-items: stretch;
    position: relative;
    overflow: hidden;
  }

  @media screen and (max-width: 992px) {
    .hp20-offer__container {
      flex-direction: column;
    }
  }

  .hp20-offer__content {
    flex: 1;
    padding: {{ section.settings.content_padding }}px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
  }

  @media screen and (max-width: 768px) {
    .hp20-offer__content {
      padding: 40px 24px;
    }
  }

  .hp20-offer__badge {
    display: inline-block;
    padding: 8px 16px;
    background: var(--text-color);
    color: var(--bg-color);
    font-family: 'Inter', sans-serif;
    font-weight: 800;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 2px;
    border: var(--border-thickness) solid var(--border-color);
    margin-bottom: 24px;
  }

  .hp20-offer__title {
    font-family: 'Inter', sans-serif;
    font-weight: 900;
    font-size: clamp(40px, 8vw, {{ section.settings.title_size }}px);
    line-height: 1;
    color: var(--text-color);
    text-transform: uppercase;
    margin: 0 0 16px;
    letter-spacing: -1px;
  }
  
  .hp20-offer__subtitle {
    font-family: 'Inter', sans-serif;
    font-weight: 700;
    font-size: {{ section.settings.subtitle_size }}px;
    color: var(--text-color);
    margin: 0 0 24px;
    text-transform: uppercase;
  }

  .hp20-offer__text {
    font-family: 'Inter', sans-serif;
    font-size: {{ section.settings.text_size }}px;
    font-weight: 500;
    line-height: 1.5;
    color: var(--text-color);
    margin: 0 0 40px;
    max-width: 500px;
  }

  .hp20-offer__code-box {
    display: inline-flex;
    align-items: center;
    padding: 12px 24px;
    background: var(--bg-color);
    border: var(--border-thickness) dashed var(--border-color);
    font-family: 'Inter', sans-serif;
    font-weight: 800;
    font-size: 20px;
    color: var(--text-color);
    margin-bottom: 32px;
  }

  .hp20-offer__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 18px 36px;
    background: {{ section.settings.btn_bg }};
    color: {{ section.settings.btn_text_color }};
    font-family: 'Inter', sans-serif;
    font-weight: 800;
    font-size: 16px;
    text-transform: uppercase;
    letter-spacing: 2px;
    text-decoration: none;
    border: var(--border-thickness) solid var(--border-color);
    box-shadow: 4px 4px 0px var(--shadow-color);
    transition: all 0.1s ease;
  }

  .hp20-offer__btn:hover {
    background: var(--text-color);
    color: var(--bg-color);
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0px var(--shadow-color);
  }

  .hp20-offer__image-block {
    flex: 1;
    position: relative;
    border-left: {% if section.settings.layout == 'left' %}var(--border-thickness) solid var(--border-color){% else %}none{% endif %};
    border-right: {% if section.settings.layout == 'right' %}var(--border-thickness) solid var(--border-color){% else %}none{% endif %};
    background: #000;
    min-height: 300px;
  }

  @media screen and (max-width: 992px) {
    .hp20-offer__image-block {
      border-left: none;
      border-right: none;
      border-bottom: var(--border-thickness) solid var(--border-color);
      min-height: 250px;
    }
  }

  .hp20-offer__image-block img {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    filter: {% if section.settings.image_grayscale %}grayscale(100%) contrast(120%){% else %}none{% endif %};
  }

  /* Warning tape effect */
  {% if section.settings.show_tape %}
  .hp20-offer__tape {
    position: absolute;
    top: 40px;
    right: -40px;
    background: #E2FF00;
    color: #000;
    font-family: 'Inter', sans-serif;
    font-weight: 900;
    font-size: 14px;
    padding: 8px 60px;
    transform: rotate(45deg);
    border-top: 2px solid #000;
    border-bottom: 2px solid #000;
    text-transform: uppercase;
    letter-spacing: 2px;
    z-index: 10;
  }
  {% endif %}

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp20-offer-wrapper" id="HP20OfferBanner-{{ section.id }}">
  <div class="hp20-offer__container">
    
    {% if section.settings.show_tape %}
    <div class="hp20-offer__tape">LIMITED TIME</div>
    {% endif %}

    <div class="hp20-offer__content">
      {%- if section.settings.badge != blank -%}
        <div class="hp20-offer__badge">{{ section.settings.badge | escape }}</div>
      {%- endif -%}
      
      {%- if section.settings.title != blank -%}
        <h2 class="hp20-offer__title">{{ section.settings.title | escape }}</h2>
      {%- endif -%}
      
      {%- if section.settings.subtitle != blank -%}
        <div class="hp20-offer__subtitle">{{ section.settings.subtitle | escape }}</div>
      {%- endif -%}
      
      {%- if section.settings.text != blank -%}
        <div class="hp20-offer__text">{{ section.settings.text | escape }}</div>
      {%- endif -%}

      {%- if section.settings.code != blank -%}
        <div class="hp20-offer__code-box">CODE: {{ section.settings.code | escape }}</div>
      {%- endif -%}
      
      {%- if section.settings.btn_text != blank and section.settings.btn_link != blank -%}
        <a href="{{ section.settings.btn_link }}" class="hp20-offer__btn">
          {{ section.settings.btn_text | escape }}
        </a>
      {%- endif -%}
    </div>

    <div class="hp20-offer__image-block">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 1000 }}" alt="{{ section.settings.title | escape }}" loading="lazy">
      {%- else -%}
        {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "HP20 - Brutalist Offer",
  "class": "section-hp20-offer-banner",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Text Position (Desktop)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1400
    },
    {
      "type": "range",
      "id": "content_padding",
      "min": 20,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "Desktop Content Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge Text",
      "default": "FLASH SALE"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "50% OFF EVERYTHING"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "THE BIGGEST DROP OF THE YEAR"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Stock up on the essentials before they are gone. No exclusions."
    },
    {
      "type": "text",
      "id": "code",
      "label": "Discount Code (Optional)",
      "default": "BRUTAL50"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "SHOP THE SALE"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "checkbox",
      "id": "image_grayscale",
      "label": "Enable High-Contrast Grayscale",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_tape",
      "label": "Show Corner 'Warning Tape'",
      "default": true
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 30,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 64
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "min": 14,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Subtitle Size",
      "default": 20
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 14,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Text Size",
      "default": 18
    },
    {
      "type": "header",
      "content": "Brutalist Styling"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Outer Background",
      "default": "#F4F4F0"
    },
    {
      "type": "color",
      "id": "box_bg",
      "label": "Banner Background",
      "default": "#FF3366"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "btn_bg",
      "label": "Button Background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Button Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "border_thickness",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "Global Border Thickness",
      "default": 3
    },
    {
      "type": "color",
      "id": "shadow_color",
      "label": "Hard Shadow Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "shadow_offset",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Hard Shadow Offset",
      "default": 12
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP20 - Brutalist Offer"
    }
  ]
}
{% endschema %}
