{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#FFFFFF'
  assign text_color = section.settings.text_color | default: '#2D3748'
  assign padding_top = section.settings.padding_top | default: 80
  assign padding_bottom = section.settings.padding_bottom | default: 80
  assign padding_top_mobile = section.settings.padding_top_mobile | default: 40
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile | default: 40
  assign layout = section.settings.layout | default: 'image_left'
  assign text_align = section.settings.text_alignment | default: 'center'
  assign image_ratio = section.settings.image_ratio | default: '4/5'
-%}

<style>
  #shopify-section-{{ section_id }} {
    --bg-color: {{ bg_color }};
    --text-color: {{ text_color }};
    --padding-top: {{ padding_top }}px;
    --padding-bottom: {{ padding_bottom }}px;
    --padding-top-mobile: {{ padding_top_mobile }}px;
    --padding-bottom-mobile: {{ padding_bottom_mobile }}px;
    --image-ratio: {% if image_ratio == 'square' %}1/1{% elsif image_ratio == 'portrait' %}4/5{% elsif image_ratio == 'landscape' %}16/9{% else %}auto{% endif %};
    
    background-color: var(--bg-color);
    color: var(--text-color);
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
  }

  .hpv6-iwt-{{ section_id }} {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    max-width: var(--page-width, 1440px);
    margin: 0 auto;
    flex-direction: {% if layout == 'image_right' %}row-reverse{% else %}row{% endif %};
  }

  .hpv6-iwt__image-col {
    flex: 1 1 50%;
    padding: 0 4vw;
    box-sizing: border-box;
  }

  .hpv6-iwt__image-wrap {
    position: relative;
    aspect-ratio: var(--image-ratio);
    background: #E2E8F0;
    width: 100%;
    overflow: hidden;
  }

  .hpv6-iwt__image {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover;
  }

  .hpv6-iwt__text-col {
    flex: 1 1 50%;
    padding: 6vw 8vw;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: {% if text_align == 'center' %}center{% elsif text_align == 'right' %}flex-end{% else %}flex-start{% endif %};
    text-align: {{ text_align }};
  }

  .hpv6-iwt__subtitle {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    letter-spacing: 3px;
    text-transform: uppercase;
    margin-bottom: 2rem;
    font-weight: 500;
  }

  .hpv6-iwt__title {
    font-family: 'Playfair Display', 'Georgia', serif;
    font-size: clamp(2rem, 4vw, 3.5rem);
    line-height: 1.2;
    font-weight: 400;
    margin-bottom: 2rem;
  }

  .hpv6-iwt__text {
    font-family: 'Inter', sans-serif;
    font-size: 1.125rem;
    line-height: 1.6;
    opacity: 0.8;
    margin-bottom: 3rem;
    max-width: 500px;
  }

  .hpv6-iwt__btn {
    display: inline-block;
    padding: 16px 32px;
    border: 1px solid currentColor;
    color: inherit;
    text-decoration: none;
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    letter-spacing: 2px;
    text-transform: uppercase;
    transition: all 0.3s ease;
  }

  .hpv6-iwt__btn:hover {
    background-color: var(--text-color);
    color: var(--bg-color);
  }

  @media screen and (max-width: 989px) {
    .hpv6-iwt-{{ section_id }} {
      flex-direction: column;
    }
    .hpv6-iwt__image-col {
      width: 100%;
      padding: 0 4vw;
      margin-bottom: 3rem;
    }
    .hpv6-iwt__text-col {
      width: 100%;
      padding: 0 4vw;
    }
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding-top: var(--padding-top-mobile);
      padding-bottom: var(--padding-bottom-mobile);
    }
    .hpv6-iwt__title { margin-bottom: 1.5rem; }
    .hpv6-iwt__text { margin-bottom: 2rem; font-size: 1rem; }
  }
</style>

<div class="hpv6-iwt-{{ section_id }}">
  <div class="hpv6-iwt__image-col">
    <div class="hpv6-iwt__image-wrap">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1200 | image_tag: 
           class: 'hpv6-iwt__image',
           loading: 'lazy',
           sizes: '(min-width: 990px) 50vw, 100vw',
           widths: '400, 600, 800, 1000, 1200'
        }}
      {%- else -%}
        {{ 'image' | placeholder_svg_tag: 'hpv6-iwt__image placeholder-svg' }}
      {%- endif -%}
    </div>
  </div>
  
  <div class="hpv6-iwt__text-col">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'subtitle' -%}
          {%- if block.settings.text != blank -%}
            <div class="hpv6-iwt__subtitle" {{ block.shopify_attributes }}>
              {{ block.settings.text | escape }}
            </div>
          {%- endif -%}

        {%- when 'title' -%}
          {%- if block.settings.text != blank -%}
            <h2 class="hpv6-iwt__title" {{ block.shopify_attributes }}>
              {{ block.settings.text | escape }}
            </h2>
          {%- endif -%}

        {%- when 'text' -%}
          {%- if block.settings.text != blank -%}
            <div class="hpv6-iwt__text" {{ block.shopify_attributes }}>
              {{ block.settings.text }}
            </div>
          {%- endif -%}

        {%- when 'button' -%}
          {%- if block.settings.button_label != blank -%}
            <a href="{{ block.settings.button_link | default: '#' }}" class="hpv6-iwt__btn" {{ block.shopify_attributes }}>
              {{ block.settings.button_label | escape }}
            </a>
          {%- endif -%}
      {%- endcase -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "HPV6 Image with Text",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image Ratio",
      "options": [
        { "value": "auto", "label": "Adapt to image" },
        { "value": "square", "label": "Square (1:1)" },
        { "value": "portrait", "label": "Portrait (4:5)" },
        { "value": "landscape", "label": "Landscape (16:9)" }
      ],
      "default": "portrait"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Desktop Layout",
      "options": [
        { "value": "image_left", "label": "Image on Left" },
        { "value": "image_right", "label": "Image on Right" }
      ],
      "default": "image_left"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2D3748"
    },
    {
      "type": "header",
      "content": "Desktop Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 80
    },
    {
      "type": "header",
      "content": "Mobile Padding"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "subtitle",
      "name": "Subtitle",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Our Philosophy" }
      ]
    },
    {
      "type": "title",
      "name": "Title",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Designed for longevity." }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "limit": 1,
      "settings": [
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>We believe in objects that grow more beautiful with time. Discover the story behind our sustainable materials and minimalist approach.</p>" }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "button_label", "label": "Button Label", "default": "Discover Our Story" },
        { "type": "url", "id": "button_link", "label": "Button Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "HPV6 Image with Text",
      "blocks": [
        { "type": "subtitle" },
        { "type": "title" },
        { "type": "text" },
        { "type": "button" }
      ]
    }
  ]
}
{% endschema %}
