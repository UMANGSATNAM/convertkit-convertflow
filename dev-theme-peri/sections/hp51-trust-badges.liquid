{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp51-trust-bg: {{ section.settings.bg_color | default: '#FAF8F5' }};
    --hp51-matcha: {{ section.settings.accent_matcha | default: '#2D5A3D' }};
    
    background-color: var(--hp51-trust-bg);
    color: #1E3A2B;
    padding-top: {{ section.settings.padding_top | default: 50 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 50 }}px;
    border-top: 1px solid rgba(30, 58, 43, 0.1);
  }

  .hp51-trust__grid {
    max-width: {{ section.settings.container_width | default: 1200 }}px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: 4 }}, 1fr);
    gap: 30px;
    text-align: center;
  }

  .hp51-trust__icon {
    font-size: 28px;
    margin-bottom: 12px;
  }

  .hp51-trust__title {
    font-family: 'Noto Serif JP', serif;
    font-size: 15px;
    font-weight: 700;
    margin: 0 0 6px;
  }

  .hp51-trust__desc {
    font-size: 13px;
    color: #4A5B50;
    margin: 0;
  }

  @media screen and (max-width: 992px) {
    .hp51-trust__grid { grid-template-columns: repeat(2, 1fr); }
  }
{%- endstyle -%}

<div class="hp51-trust__grid">
  {%- if section.blocks.size > 0 -%}
    {%- for block in section.blocks -%}
      <div {{ block.shopify_attributes }}>
        <div class="hp51-trust__icon">{{ block.settings.icon | default: '🍵' }}</div>
        <h4 class="hp51-trust__title">{{ block.settings.title }}</h4>
        <p class="hp51-trust__desc">{{ block.settings.description }}</p>
      </div>
    {%- endfor -%}
  {%- else -%}
    <div>
      <div class="hp51-trust__icon">🍵</div>
      <h4 class="hp51-trust__title">100% Uji Organic</h4>
      <p class="hp51-trust__desc">Certified shade-grown spring harvest.</p>
    </div>
    <div>
      <div class="hp51-trust__icon">✈️</div>
      <h4 class="hp51-trust__title">Direct DDP Air Courier</h4>
      <p class="hp51-trust__desc">Customs duties pre-paid globally.</p>
    </div>
    <div>
      <div class="hp51-trust__icon">🛡️</div>
      <h4 class="hp51-trust__title">30-Day Zen Accord</h4>
      <p class="hp51-trust__desc">Complete satisfaction guarantee.</p>
    </div>
    <div>
      <div class="hp51-trust__icon">🔒</div>
      <h4 class="hp51-trust__title">256-Bit SSL Checkout</h4>
      <p class="hp51-trust__desc">Encrypted payment protection.</p>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "HP51 - Zen Badges",
  "class": "section-hp51-badges",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#FAF8F5" },
    { "type": "color", "id": "accent_matcha", "label": "Matcha Accent", "default": "#2D5A3D" },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "label": "Desktop Columns", "default": 4 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 100, "step": 5, "unit": "px", "label": "Padding Top", "default": 50 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 100, "step": 5, "unit": "px", "label": "Padding Bottom", "default": 50 },
    { "type": "range", "id": "container_width", "min": 800, "max": 1400, "step": 20, "unit": "px", "label": "Container Width", "default": 1200 }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon", "default": "🍵" },
        { "type": "text", "id": "title", "label": "Title", "default": "100% Uji Organic" },
        { "type": "text", "id": "description", "label": "Description", "default": "Certified shade-grown spring harvest." }
      ]
    }
  ],
  "presets": [
    { "name": "HP51 - Zen Badges" }
  ]
}
{% endschema %}
