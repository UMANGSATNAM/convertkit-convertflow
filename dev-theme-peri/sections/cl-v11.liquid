{% comment %} CL V11 — Retro 90s / Nostalgia {% endcomment %}
{{ 'component-facets.css' | asset_url | stylesheet_tag }}
<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
<style>
  .clv11 { background: {{ section.settings.bg_color | default: '#FFE45E' }}; color: {{ section.settings.text_color | default: '#111' }}; padding: 50px 20px; font-family: 'Comic Sans MS', sans-serif; }
  .clv11-hero { text-align: center; margin-bottom: 40px; background: #FF5A5F; color: #FFF; padding: 40px; border: 4px solid #111; box-shadow: 6px 6px 0px #111; border-radius: 10px; }
  .clv11-hero h1 { font-size: 45px; font-weight: 900; margin-bottom: 10px; text-transform: uppercase; letter-spacing: 2px; text-shadow: 2px 2px 0px #111; }
  .clv11-hero p { font-size: 18px; max-width: 600px; margin: 0 auto; font-weight: bold; }
  .clv11-chips { display: flex; gap: 15px; justify-content: center; margin-bottom: 40px; flex-wrap: wrap; }
  .clv11-chips a { padding: 10px 20px; background: #08F7FE; color: #111; text-decoration: none; font-weight: bold; font-size: 14px; border: 3px solid #111; border-radius: 5px; box-shadow: 4px 4px 0px #111; transition: 0.1s; text-transform: uppercase; }
  .clv11-chips a:active { transform: translate(4px, 4px); box-shadow: none; }
  .clv11-toolbar { background: #FFF; border: 4px solid #111; border-radius: 10px; padding: 20px; margin-bottom: 40px; box-shadow: 6px 6px 0px #111; }
  .clv11-grid { display: grid; grid-template-columns: repeat({{ section.settings.cols_desktop | default: 4 }}, 1fr); gap: 30px; }
  .clv11-promo { grid-column: span 1; background: #9D4EDD; border: 4px solid #111; padding: 30px; text-align: center; display: flex; flex-direction: column; justify-content: center; color: #FFF; box-shadow: 6px 6px 0px #111; border-radius: 10px; }
  .clv11-promo h3 { font-size: 26px; font-weight: 900; margin-bottom: 20px; text-shadow: 2px 2px 0px #111; }
  .clv11-promo a { display: inline-block; padding: 12px 24px; background: #FFE45E; color: #111; text-decoration: none; font-weight: 900; font-size: 15px; border: 3px solid #111; box-shadow: 4px 4px 0px #111; border-radius: 5px; }
  .clv11-seo { margin-top: 60px; padding: 40px; background: #08F7FE; border: 4px solid #111; border-radius: 10px; text-align: center; box-shadow: 6px 6px 0px #111; }
  @media (max-width: 768px) { .clv11-grid { grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr); gap: 20px; } .clv11-hero h1 { font-size: 32px; } }
</style>
<div class="clv11" style="max-width: 1300px; margin: 0 auto;">
  <div class="clv11-hero">
    <h1>{% if collection.title != blank %}{{ collection.title | escape }}{% else %}RADICAL RETRO{% endif %}</h1>
    <p>{% if collection.description != blank %}{{ collection.description }}{% else %}Step back into the 90s. Pure nostalgia.{% endif %}</p>
  </div>
  {% if section.settings.sub_collections != blank %}
    <div class="clv11-chips">
      {% for link in section.settings.sub_collections.links %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% endfor %}
    </div>
  {% endif %}
  <div class="clv11-toolbar">
    <facet-filters-form style="width: 100%;">
      <form id="FacetFiltersForm" style="display: flex; justify-content: space-between; align-items: center; width: 100%; flex-wrap: wrap; gap: 20px;">
        <div style="display: flex; gap: 20px;">
          {%- for filter in collection.filters -%}
            <details style="position: relative;">
              <summary style="cursor: pointer; font-size: 15px; font-weight: 900; color: #111; text-transform: uppercase;">{{ filter.label }} 💥</summary>
              <div style="position: absolute; background: #FFF; border: 3px solid #111; padding: 20px; border-radius: 5px; z-index: 10; margin-top: 10px; min-width: 220px; box-shadow: 4px 4px 0px #111;">
                {%- for value in filter.values -%}
                  <label style="display: block; margin-bottom: 12px; cursor: pointer; font-size: 15px; font-weight: bold; color: #111;">
                    <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %}>
                    {{ value.label }} ({{ value.count }})
                  </label>
                {%- endfor -%}
              </div>
            </details>
          {%- endfor -%}
        </div>
        <select name="sort_by" onchange="this.form.submit()" style="background: #FFE45E; border: 3px solid #111; color: #111; padding: 10px 15px; border-radius: 5px; font-size: 15px; font-weight: 900; cursor: pointer; box-shadow: 4px 4px 0px #111; text-transform: uppercase;">
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>
          {%- endfor -%}
        </select>
      </form>
    </facet-filters-form>
  </div>
  {% assign limit_num = section.settings.products_per_page | default: 16 %}
  {% paginate collection.products by limit_num %}
    <div class="clv11-grid">
      {% for product in collection.products %}
        {% render 'card-v11', product: product %}
        {% if forloop.index == 8 and section.settings.show_promo_tile %}
          <div class="clv11-promo">
            <h3>🔥 MEGA DEALS!</h3>
            <a href="/discount/RETRO">GRAB 'EM</a>
          </div>
        {% endif %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v11', product: nil %}
        {% endfor %}
      {% endfor %}
    </div>
    <div style="margin-top: 60px; text-align: center; font-weight: 900; font-size: 20px;">{{ paginate | default_pagination }}</div>
  {% endpaginate %}
  {% if section.settings.show_seo_block %}
    <div class="clv11-seo">
      <h2 style="font-size: 28px; font-weight: 900; margin-bottom: 15px; text-transform: uppercase; text-shadow: 2px 2px 0px #FFF;">{{ section.settings.seo_title | default: 'TOTALLY RAD GEAR' }}</h2>
      <p style="font-size: 16px; font-weight: bold; max-width: 800px; margin: 0 auto; line-height: 1.6;">{{ section.settings.seo_text | default: 'We brought back the best decade. Bold prints, crazy colors, and unmatched style.' }}</p>
    </div>
  {% endif %}
</div>
{% schema %}
{
  "name": "CL V11 — Retro", "settings": [
    {"type": "range", "id": "products_per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 16},
    {"type": "range", "id": "cols_desktop", "label": "Desktop Columns", "min": 2, "max": 5, "default": 4},
    {"type": "select", "id": "cols_mobile", "label": "Mobile Columns", "options": [{"value": "1", "label": "1"}, {"value": "2", "label": "2"}], "default": "2"},
    {"type": "link_list", "id": "sub_collections", "label": "Sub-Collection Menu"},
    {"type": "checkbox", "id": "show_promo_tile", "label": "Show Promo Card", "default": true},
    {"type": "checkbox", "id": "show_seo_block", "label": "Show SEO Block", "default": true},
    {"type": "color", "id": "bg_color", "label": "Background Color", "default": "#FFE45E"},
    {"type": "color", "id": "text_color", "label": "Text Color", "default": "#111111"}
  ], "presets": [{"name": "CL V11 — Retro"}]
}
{% endschema %}
