{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#0A0A0A'
-%}

<style>
  :root { --border-color: {{ s.border_color }}; }

  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 80px 40px 40px;
    border-top: 1px solid rgba(0, 255, 65, 0.5);
  }
  
  .hp17-footer-container-{{ section_id }} {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 40px;
  }
  
  .hp17-footer-logo-{{ section_id }} {
    font-family: 'Arial Black', sans-serif;
    font-size: 2.5rem;
    color: #FFF;
    text-decoration: none;
    letter-spacing: 2px;
    margin-bottom: 20px;
    display: inline-block;
  }
  
  .hp17-footer-logo-{{ section_id }} span {
    color: #00FF41;
  }
  
  .hp17-footer-text-{{ section_id }} {
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.95rem;
    color: rgba(255,255,255,0.6);
    line-height: 1.6;
    max-width: 300px;
    margin: 0 0 20px 0;
  }
  
  .hp17-footer-title-{{ section_id }} {
    font-family: 'Courier New', Courier, monospace;
    font-size: 1rem;
    font-weight: bold;
    color: #00FF41;
    text-transform: uppercase;
    margin: 0 0 20px 0;
    letter-spacing: 2px;
  }
  
  .hp17-footer-menu-{{ section_id }} {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  
  .hp17-footer-menu-{{ section_id }} li {
    margin-bottom: 12px;
  }
  
  .hp17-footer-menu-{{ section_id }} a {
    color: #FFF;
    text-decoration: none;
    font-family: 'Arial', sans-serif;
    font-size: 0.95rem;
    transition: all 0.2s ease;
  }
  
  .hp17-footer-menu-{{ section_id }} a:hover {
    color: #00FF41;
    padding-left: 5px;
  }
  
  .hp17-footer-bottom-{{ section_id }} {
    max-width: 1400px;
    margin: 60px auto 0;
    padding-top: 20px;
    border-top: 1px dashed rgba(0, 255, 65, 0.3);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  .hp17-footer-copy-{{ section_id }} {
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.8rem;
    color: rgba(255,255,255,0.5);
  }
  
  .hp17-footer-social-{{ section_id }} {
    display: flex;
    gap: 15px;
  }
  
  .hp17-footer-social-{{ section_id }} a {
    color: #00FF41;
    transition: all 0.3s ease;
  }
  
  .hp17-footer-social-{{ section_id }} a:hover {
    color: #FFF;
    transform: translateY(-3px);
  }

  @media (max-width: 992px) {
    .hp17-footer-container-{{ section_id }} {
      grid-template-columns: 1fr 1fr;
    }
  }
  
  @media (max-width: 600px) {
    .hp17-footer-container-{{ section_id }} {
      grid-template-columns: 1fr;
    }
    .hp17-footer-bottom-{{ section_id }} {
      flex-direction: column;
      gap: 20px;
      text-align: center;
    }
  }
</style>

<div class="hp17-footer-container-{{ section_id }}">
  <div class="hp17-footer-col">
    <a href="/" class="hp17-footer-logo-{{ section_id }}">{{ shop.name | default: 'CYBER<span>TECH</span>' }}</a>
    <p class="hp17-footer-text-{{ section_id }}">{{ section.settings.text | default: 'Equipping the modern netrunner with high-performance stealth gear.' }}</p>
  </div>
  
  <div class="hp17-footer-col">
    <h3 class="hp17-footer-title-{{ section_id }}">SYSTEM</h3>
    <ul class="hp17-footer-menu-{{ section_id }}">
      {%- assign cf_menu = section.settings.menu | default: linklists['footer'] -%}

      {%- if cf_menu == blank -%}{%- assign cf_menu = linklists['main-menu'] -%}{%- endif -%}

      {%- for link in cf_menu.links -%}

        <li><a href="{{ link.url }}">{{ link.title }}</a></li>

      {%- endfor -%}
    </ul>
  </div>
  
  <div class="hp17-footer-col">
    <h3 class="hp17-footer-title-{{ section_id }}">SUPPORT</h3>
    <ul class="hp17-footer-menu-{{ section_id }}">
      {%- assign cf_menu = section.settings.menu | default: linklists['footer'] -%}

      {%- if cf_menu == blank -%}{%- assign cf_menu = linklists['main-menu'] -%}{%- endif -%}

      {%- for link in cf_menu.links -%}

        <li><a href="{{ link.url }}">{{ link.title }}</a></li>

      {%- endfor -%}
    </ul>
  </div>
  
  <div class="hp17-footer-col">
    <h3 class="hp17-footer-title-{{ section_id }}">LOCATION</h3>
    <p class="hp17-footer-text-{{ section_id }}">Sector 7, Neo-Tokyo Sprawl.<br>Coordinates encrypted.</p>
  </div>
</div>

<div class="hp17-footer-bottom-{{ section_id }}">
  <div class="hp17-footer-copy-{{ section_id }}">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. ALL RIGHTS RESERVED.</div>
  <div class="hp17-footer-social-{{ section_id }}">
    <a href="#"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg></a>
    <a href="#"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg></a>
    <a href="#"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"></path></svg></a>
  </div>
</div>

{% schema %}
{
  "name": "HP17 Footer",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#0A0A0A"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Brand Text",
      "default": "Equipping the modern netrunner with high-performance stealth gear."
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Footer menu",
      "info": "Leave empty to use the store's main menu.",
      "default": "footer"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_mobile",
      "label": "Mobile padding",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border colour",
      "default": "#E5E7EB"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Footer logo"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show social links",
      "default": true
    },
    {
      "type": "text",
      "id": "copyright_note",
      "label": "Copyright line",
      "info": "The year and store name are added automatically.",
      "default": "All rights reserved."
    }
  ],
  "presets": [
    {
      "name": "HP17 Footer"
    }
  ]
}
{% endschema %}
