{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#ffe8d6'
  assign text_color = section.settings.text_color | default: '#6b705c'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 120px 40px;
  }
  
  .hp14-testimonial-container-{{ section_id }} {
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
  }
  
  .hp14-testimonial-stars-{{ section_id }} {
    color: #cb997e;
    margin-bottom: 30px;
  }
  
  .hp14-testimonial-stars-{{ section_id }} svg {
    width: 24px;
    height: 24px;
    margin: 0 5px;
    fill: currentColor;
  }
  
  .hp14-testimonial-quote-{{ section_id }} {
    font-family: 'Georgia', serif;
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    font-style: italic;
    line-height: 1.4;
    color: {{ text_color }};
    margin: 0 0 40px 0;
  }
  
  .hp14-testimonial-author-{{ section_id }} {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 1rem;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #cb997e;
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 80px 20px;
    }
  }
</style>

<div class="hp14-testimonial-container-{{ section_id }}">
  <div class="hp14-testimonial-stars-{{ section_id }}">
    {% for i in (1..5) %}
      <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
    {% endfor %}
  </div>
  
  <blockquote class="hp14-testimonial-quote-{{ section_id }}">
    "{{ section.settings.quote | default: 'These botanical formulations completely transformed my skin. It feels like a spa ritual every single morning.' }}"
  </blockquote>
  
  <div class="hp14-testimonial-author-{{ section_id }}">
    {{ section.settings.author | default: 'Sarah Jenkins' }}
  </div>
</div>

{% schema %}
{
  "name": "HP14 Testimonial",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffe8d6"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#6b705c"
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Quote",
      "default": "These botanical formulations completely transformed my skin. It feels like a spa ritual every single morning."
    },
    {
      "type": "text",
      "id": "author",
      "label": "Author",
      "default": "Sarah Jenkins"
    }
  ],
  "presets": [
    {
      "name": "HP14 Testimonial"
    }
  ]
}
{% endschema %}
