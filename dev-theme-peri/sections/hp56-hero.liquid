{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Syne:wght@700;800&display=swap');

  #shopify-section-{{ section.id }} {
    --hp56-bg: {{ section.settings.bg_color | default: '#F0F9FF' }};
    --hp56-text: {{ section.settings.text_color | default: '#082F49' }};
    --hp56-ice: {{ section.settings.accent_ice | default: '#0284C7' }};
    --hp56-berry: {{ section.settings.accent_berry | default: '#F59E0B' }};
    --hp56-btn-bg: {{ section.settings.btn_bg | default: '#082F49' }};
    --hp56-btn-text: {{ section.settings.btn_text_color | default: '#FFFFFF' }};

    background: linear-gradient(135deg, #E0F2FE 0%, var(--hp56-bg) 50%, #F8FAFC 100%);
    color: var(--hp56-text);
    font-family: 'Outfit', sans-serif;
    padding-top: {{ section.settings.padding_top | default: 100 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 100 }}px;
    position: relative;
    overflow: hidden;
  }

  .hp56-hero__crystal-glow {
    position: absolute;
    top: -120px;
    right: -100px;
    width: 550px;
    height: 550px;
    background: radial-gradient(circle, rgba(2, 132, 199, 0.15) 0%, transparent 70%);
    pointer-events: none;
  }

  .hp56-hero__container {
    max-width: {{ section.settings.container_width | default: 1280 }}px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 70px;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  .hp56-hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 18px;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(2, 132, 199, 0.25);
    border-radius: 8px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--hp56-ice);
    margin-bottom: 26px;
    box-shadow: 0 4px 15px rgba(2, 132, 199, 0.08);
  }

  .hp56-hero__title {
    font-family: 'Syne', sans-serif;
    font-size: clamp(38px, 5.2vw, 64px);
    font-weight: 800;
    line-height: 1.08;
    color: var(--hp56-text);
    margin: 0 0 24px;
    letter-spacing: -1px;
  }

  .hp56-hero__title span {
    background: linear-gradient(135deg, #0284C7 0%, #0369A1 50%, #F59E0B 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hp56-hero__desc {
    font-size: 16px;
    line-height: 1.75;
    color: #334155;
    margin: 0 0 36px;
    max-width: 520px;
    font-weight: 400;
  }

  .hp56-hero__actions {
    display: flex;
    gap: 16px;
    align-items: center;
    flex-wrap: wrap;
  }

  .hp56-hero__btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 36px;
    background: var(--hp56-btn-bg);
    color: var(--hp56-btn-text);
    font-family: 'Outfit', sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 8px;
    transition: all 0.35s ease;
    box-shadow: 0 8px 25px rgba(8, 47, 73, 0.2);
  }

  .hp56-hero__btn:hover {
    transform: translateY(-2px);
    background: var(--hp56-ice);
    box-shadow: 0 12px 35px rgba(2, 132, 199, 0.35);
  }

  .hp56-hero__media {
    position: relative;
  }

  .hp56-hero__img-wrap {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    height: 520px;
    border: 1px solid rgba(255, 255, 255, 0.8);
    box-shadow: 0 25px 60px rgba(2, 132, 199, 0.15), 0 0 0 1px rgba(2, 132, 199, 0.1);
  }

  .hp56-hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: brightness(1.02) contrast(1.05);
    transition: transform 0.6s ease;
  }

  .hp56-hero__img-wrap:hover .hp56-hero__img {
    transform: scale(1.04);
  }

  .hp56-hero__float-card {
    position: absolute;
    bottom: -16px;
    left: -16px;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(2, 132, 199, 0.2);
    border-radius: 12px;
    padding: 16px 22px;
    display: flex;
    align-items: center;
    gap: 14px;
    box-shadow: 0 10px 30px rgba(2, 132, 199, 0.12);
  }

  .hp56-hero__float-icon {
    width: 42px;
    height: 42px;
    background: linear-gradient(135deg, #0284C7, #38BDF8);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #FFFFFF;
    font-size: 18px;
  }

  .hp56-hero__float-label {
    font-family: 'Syne', sans-serif;
    font-size: 15px;
    font-weight: 700;
    color: #082F49;
    margin: 0;
  }

  .hp56-hero__float-sub {
    font-size: 11px;
    color: #0284C7;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin: 2px 0 0;
  }

  @media screen and (max-width: 992px) {
    .hp56-hero__container { grid-template-columns: 1fr; text-align: center; gap: 40px; }
    .hp56-hero__desc { margin-left: auto; margin-right: auto; }
    .hp56-hero__actions { justify-content: center; }
    .hp56-hero__img-wrap { height: 380px; }
    .hp56-hero__float-card { left: 50%; transform: translateX(-50%); bottom: -16px; }
  }

  @media screen and (max-width: 480px) {
    .hp56-hero__img-wrap { height: 300px; }
  }
{%- endstyle -%}

<div class="hp56-hero__crystal-glow"></div>

<div class="hp56-hero__container">
  <div>
    <div class="hp56-hero__badge">
      <span>❄️</span>
      <span>{{ section.settings.badge | default: 'NORDIC GLACIAL EDITION v56' }}</span>
    </div>

    <h1 class="hp56-hero__title">
      {{ section.settings.heading | default: 'Arctic <span>Cloudberry & Glacial</span> Bio-Active' }}
    </h1>

    <p class="hp56-hero__desc">
      {{ section.settings.description | default: 'Harnessing wild Arctic cloudberries, Finnish birch sap, and glacial oxygen springs to freeze cellular aging in sub-zero purity.' }}
    </p>

    <div class="hp56-hero__actions">
      <a href="{{ section.settings.btn_url | default: '/collections/all' }}" class="hp56-hero__btn">
        <span>{{ section.settings.btn_text | default: 'Explore Glacial Vault' }}</span>
        <span>&rarr;</span>
      </a>
    </div>
  </div>

  <div class="hp56-hero__media">
    <div class="hp56-hero__img-wrap">
      {%- if section.settings.image != blank -%}
        <img height="{{ section.settings.image.height }}" width="{{ section.settings.image.width }}" src="{{ section.settings.image | image_url: width: 1000 }}" class="hp56-hero__img" alt="{{ section.settings.heading }}" loading="eager">
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'hp56-hero__img' }}
      {%- endif -%}

      <div class="hp56-hero__float-card">
        <div class="hp56-hero__float-icon">❄️</div>
        <div>
          <p class="hp56-hero__float-label">Wild Cloudberry Bio-C</p>
          <p class="hp56-hero__float-sub">Sub-Zero Pure Extraction</p>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "HP56 Hero",
  "class": "section-hp56-hero",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#F0F9FF" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#082F49" },
    { "type": "color", "id": "accent_ice", "label": "Ice Accent", "default": "#0284C7" },
    { "type": "color", "id": "accent_berry", "label": "Berry Accent", "default": "#F59E0B" },
    { "type": "color", "id": "btn_bg", "label": "Button Background", "default": "#082F49" },
    { "type": "color", "id": "btn_text_color", "label": "Button Text Color", "default": "#FFFFFF" },
    { "type": "text", "id": "badge", "label": "Badge", "default": "NORDIC GLACIAL EDITION v56" },
    { "type": "textarea", "id": "heading", "label": "Heading (HTML allowed)", "default": "Arctic <span>Cloudberry & Glacial</span> Bio-Active" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Harnessing wild Arctic cloudberries and Finnish birch sap." },
    { "type": "text", "id": "btn_text", "label": "Button Text", "default": "Explore Glacial Vault" },
    { "type": "url", "id": "btn_url", "label": "Button URL" },
    { "type": "image_picker", "id": "image", "label": "Hero Image" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 100 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 100 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "presets": [{ "name": "HP56 Hero" }]
}
{% endschema %}
