{%- liquid
  assign sec_id = section.id
  assign blog = blogs[section.settings.blog]
-%}

<style>
  #shopify-section-{{ sec_id }} {
    background-color: {{ section.settings.bg_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px 0;
  }

  .hp20-blog-{{ sec_id }} {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp20-blog-{{ sec_id }}__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 60px;
  }

  .hp20-blog-{{ sec_id }}__title {
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 300;
    color: {{ section.settings.text_color }};
    margin: 0;
    letter-spacing: -0.02em;
  }

  .hp20-blog-{{ sec_id }}__view-all {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: {{ section.settings.text_color }};
    text-decoration: none;
    border-bottom: 1px solid {{ section.settings.text_color }};
    padding-bottom: 4px;
    transition: opacity 0.3s ease;
  }

  .hp20-blog-{{ sec_id }}__view-all:hover {
    opacity: 0.6;
  }

  .hp20-blog-{{ sec_id }}__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
  }

  .hp20-blog-card {
    display: flex;
    flex-direction: column;
  }

  .hp20-blog-card__media {
    position: relative;
    padding-top: 66.66%; /* 3:2 aspect ratio */
    background-color: #f0f0f0;
    margin-bottom: 24px;
    overflow: hidden;
  }

  .hp20-blog-card__img {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .hp20-blog-card:hover .hp20-blog-card__img {
    transform: scale(1.03);
  }

  .hp20-blog-card__meta {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: {{ section.settings.text_color }};
    opacity: 0.6;
    margin-bottom: 12px;
    display: flex;
    gap: 16px;
  }

  .hp20-blog-card__title {
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-size: 20px;
    font-weight: 400;
    line-height: 1.3;
    color: {{ section.settings.text_color }};
    margin: 0 0 16px 0;
    text-decoration: none;
  }

  .hp20-blog-card__excerpt {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 14px;
    line-height: 1.6;
    color: {{ section.settings.text_color }};
    opacity: 0.8;
    margin: 0;
  }

  @media screen and (max-width: 990px) {
    .hp20-blog-{{ sec_id }}__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ sec_id }} {
      padding: {{ section.settings.padding_top_mobile }}px 0 {{ section.settings.padding_bottom_mobile }}px 0;
    }
    .hp20-blog-{{ sec_id }}__header {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
      margin-bottom: 40px;
    }
    .hp20-blog-{{ sec_id }}__grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>

<section class="hp20-blog-{{ sec_id }}">
  <div class="hp20-blog-{{ sec_id }}__header">
    <h2 class="hp20-blog-{{ sec_id }}__title">{{ section.settings.title }}</h2>
    {% if blog != blank and section.settings.show_view_all %}
      <a href="{{ blog.url }}" class="hp20-blog-{{ sec_id }}__view-all">{{ section.settings.view_all_text }}</a>
    {% endif %}
  </div>

  <div class="hp20-blog-{{ sec_id }}__grid">
    {% if blog != blank and blog.articles_count > 0 %}
      {% for article in blog.articles limit: section.settings.post_limit %}
        <article class="hp20-blog-card">
          <a href="{{ article.url }}" class="hp20-blog-card__media">
            {% if article.image %}
              <img src="{{ article.image | image_url: width: 600 }}" alt="{{ article.title | escape }}" class="hp20-blog-card__img" loading="lazy">
            {% else %}
              {{ 'image' | placeholder_svg_tag: 'hp20-blog-card__img' }}
            {% endif %}
          </a>
          
          <div class="hp20-blog-card__meta">
            <span>{{ article.published_at | date: "%B %d, %Y" }}</span>
            {% if section.settings.show_author %}
              <span>{{ article.author }}</span>
            {% endif %}
          </div>
          
          <a href="{{ article.url }}" class="hp20-blog-card__title">{{ article.title }}</a>
          
          {% if section.settings.show_excerpt %}
            <p class="hp20-blog-card__excerpt">
              {% if article.excerpt.size > 0 %}
                {{ article.excerpt | strip_html | truncatewords: 20 }}
              {% else %}
                {{ article.content | strip_html | truncatewords: 20 }}
              {% endif %}
            </p>
          {% endif %}
        </article>
      {% endfor %}
    {% else %}
      {% for i in (1..section.settings.post_limit) %}
        <article class="hp20-blog-card">
          <div class="hp20-blog-card__media">
            {{ 'lifestyle-' | append: i | placeholder_svg_tag: 'hp20-blog-card__img' }}
          </div>
          <div class="hp20-blog-card__meta">
            <span>October 12, 2026</span>
            {% if section.settings.show_author %}
              <span>Author Name</span>
            {% endif %}
          </div>
          <h3 class="hp20-blog-card__title">Editorial Post {{ i }}</h3>
          {% if section.settings.show_excerpt %}
            <p class="hp20-blog-card__excerpt">Select a blog in the section settings to display your latest articles here.</p>
          {% endif %}
        </article>
      {% endfor %}
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "HP20 Editorial Journal",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "The Journal"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "range",
      "id": "post_limit",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Number of posts",
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View all' link",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View All Text",
      "default": "Read All Articles"
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show Author",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show Excerpt",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1a1a1a"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0, "max": 160, "step": 10, "unit": "px",
      "label": "Desktop Top Padding", "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0, "max": 160, "step": 10, "unit": "px",
      "label": "Desktop Bottom Padding", "default": 120
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0, "max": 100, "step": 10, "unit": "px",
      "label": "Mobile Top Padding", "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0, "max": 100, "step": 10, "unit": "px",
      "label": "Mobile Bottom Padding", "default": 60
    }
  ],
  "presets": [
    {
      "name": "HP20 Editorial Journal"
    }
  ]
}
{% endschema %}
