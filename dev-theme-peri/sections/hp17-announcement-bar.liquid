{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#000000'
  assign text_color = section.settings.text_color | default: '#00FF41'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    color: {{ text_color }};
    padding: 8px 20px;
    text-align: center;
    position: relative;
    z-index: 100;
    border-bottom: 1px solid #00FF41;
  }
  
  .hp17-announcement-{{ section_id }} {
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.85rem;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin: 0;
    text-shadow: 0 0 5px rgba(0, 255, 65, 0.5);
  }
  
  .hp17-announcement-{{ section_id }}::before {
    content: "> SYS.MSG: ";
    opacity: 0.7;
  }
  
  .hp17-announcement-{{ section_id }} a {
    color: #FFF;
    text-decoration: none;
    border-bottom: 1px solid #FFF;
    margin-left: 10px;
    transition: all 0.2s ease;
  }
  
  .hp17-announcement-{{ section_id }} a:hover {
    color: #00FF41;
    border-color: #00FF41;
    text-shadow: 0 0 8px #00FF41;
  }

@media screen and (max-width: 768px) {
  .hp17-announcement-bar {
    padding-left: 16px !important;
    padding-right: 16px !important;
    box-sizing: border-box !important;
  }
  img {
    max-width: 100% !important;
    height: auto !important;
  }
}

</style>

<div class="hp17-announcement-{{ section_id }}">
  {{ section.settings.text | default: 'INITIALIZING FREE PROTOCOL OVER $150 <a href="#">[EXECUTE]</a>' }}
</div>

{% schema %}
{
  "name": "HP17 Announcement Bar",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#00FF41"
    },
    {
      "type": "html",
      "id": "text",
      "label": "Announcement Text",
      "default": "INITIALIZING FREE PROTOCOL OVER $150 <a href=\"#\">[EXECUTE]</a>"
    }
  ],
  "presets": [
    {
      "name": "HP17 Announcement Bar"
    }
  ]
}
{% endschema %}
