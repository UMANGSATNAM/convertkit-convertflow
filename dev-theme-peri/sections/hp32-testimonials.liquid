{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Space+Mono:ital,wght@0,400;0,700;1,400;1,700&family=Syne:wght@700;800&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --border-color: #000000;
    --accent-color: {{ section.settings.accent_color }};
    
    --font-heading: 'Syne', sans-serif;
    --font-body: 'Space Mono', monospace;
    
    background-color: var(--bg-color);
    border-bottom: 4px solid var(--border-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .hp32-testi-wrapper {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp32-testi-wrapper {
      padding: 0 20px;
    }
  }

  .hp32-testi__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    line-height: 1;
    color: #000;
    text-transform: uppercase;
    margin: 0 0 40px;
    letter-spacing: -1px;
    text-align: center;
  }

  .hp32-testi__terminal {
    background: #fff;
    border: 4px solid var(--border-color);
    box-shadow: 12px 12px 0 var(--border-color);
    display: flex;
    flex-direction: column;
  }

  .hp32-testi__header {
    background: var(--border-color);
    padding: 10px 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: #fff;
  }

  .hp32-testi__header-title {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
  }

  .hp32-testi__controls {
    display: flex;
    gap: 8px;
  }

  .hp32-testi__control {
    width: 16px;
    height: 16px;
    background: #fff;
    border: 2px solid #fff;
    border-radius: 50%;
  }
  
  .hp32-testi__control:nth-child(2) { background: transparent; }
  .hp32-testi__control:nth-child(3) { background: var(--accent-color); border-color: var(--accent-color); }

  .hp32-testi__body {
    padding: 40px;
    position: relative;
    min-height: 250px;
  }

  @media screen and (max-width: 768px) {
    .hp32-testi__body {
      padding: 20px;
    }
  }

  .hp32-testi__item {
    display: none;
    flex-direction: column;
    animation: hp32-fade 0.3s ease forwards;
  }

  .hp32-testi__item.is-active {
    display: flex;
  }

  @keyframes hp32-fade {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .hp32-testi__log-id {
    font-family: var(--font-body);
    font-size: 12px;
    color: var(--accent-color);
    background: #000;
    padding: 4px 8px;
    align-self: flex-start;
    margin-bottom: 20px;
    text-transform: uppercase;
    font-weight: 700;
  }

  .hp32-testi__quote {
    font-family: var(--font-body);
    font-size: clamp(16px, 3vw, 24px);
    line-height: 1.4;
    color: #000;
    font-weight: 700;
    margin: 0 0 30px;
  }

  .hp32-testi__quote::before {
    content: '> ';
    color: var(--accent-color);
  }

  .hp32-testi__author {
    font-family: var(--font-body);
    font-size: 14px;
    color: #000;
    opacity: 0.5;
    text-transform: uppercase;
    font-weight: 700;
  }

  .hp32-testi__nav {
    display: flex;
    justify-content: space-between;
    padding: 20px 40px;
    border-top: 4px dashed var(--border-color);
    background: #f9f9f9;
  }

  @media screen and (max-width: 768px) {
    .hp32-testi__nav {
      padding: 15px 20px;
    }
  }

  .hp32-testi__btn {
    background: transparent;
    border: 2px solid var(--border-color);
    color: #000;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    padding: 8px 16px;
    cursor: pointer;
    box-shadow: 4px 4px 0 var(--border-color);
    transition: all 0.1s ease;
  }

  .hp32-testi__btn:hover,
  .hp32-testi__btn:active {
    background: var(--accent-color);
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0 var(--border-color);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp32-testi-wrapper" id="HP32Testi-{{ section.id }}">
  <h2 class="hp32-testi__title">{{ section.settings.title }}</h2>

  <div class="hp32-testi__terminal">
    <div class="hp32-testi__header">
      <span class="hp32-testi__header-title">USER_LOGS.EXE</span>
      <div class="hp32-testi__controls">
        <div class="hp32-testi__control"></div>
        <div class="hp32-testi__control"></div>
        <div class="hp32-testi__control"></div>
      </div>
    </div>
    
    <div class="hp32-testi__body" id="hp32-t-body-{{ section.id }}">
      {%- for block in section.blocks -%}
        <div class="hp32-testi__item {% if forloop.first %}is-active{% endif %}" {{ block.shopify_attributes }}>
          <div class="hp32-testi__log-id">LOG_ID: {{ forloop.index | prepend: '00' }}</div>
          <div class="hp32-testi__quote">{{ block.settings.quote }}</div>
          <div class="hp32-testi__author">USER: {{ block.settings.author }} // STATUS: {{ block.settings.detail }}</div>
        </div>
      {%- endfor -%}
    </div>

    <div class="hp32-testi__nav">
      <button class="hp32-testi__btn" id="hp32-t-prev-{{ section.id }}">&lt; PREV</button>
      <button class="hp32-testi__btn" id="hp32-t-next-{{ section.id }}">NEXT &gt;</button>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const items = document.querySelectorAll('#hp32-t-body-{{ section.id }} .hp32-testi__item');
    const prev = document.getElementById('hp32-t-prev-{{ section.id }}');
    const next = document.getElementById('hp32-t-next-{{ section.id }}');
    let currentIndex = 0;

    function showItem(index) {
      items.forEach(i => i.classList.remove('is-active'));
      items[index].classList.add('is-active');
    }

    if(items.length > 0 && prev && next) {
      prev.addEventListener('click', () => {
        currentIndex = (currentIndex === 0) ? items.length - 1 : currentIndex - 1;
        showItem(currentIndex);
      });
      next.addEventListener('click', () => {
        currentIndex = (currentIndex === items.length - 1) ? 0 : currentIndex + 1;
        showItem(currentIndex);
      });
    }
  });
</script>

{% schema %}
{
  "name": "HP32 - Brutalist Testi",
  "class": "section-hp32-testimonials",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "SYSTEM_FEEDBACK"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 48
    },
    {
      "type": "header",
      "content": "Brutalist Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (e.g. Light Grey)",
      "default": "#f4f4f4"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color (e.g. Lime)",
      "default": "#ccff00"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 100
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Quote",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "HARDWARE EXCEEDS ALL EXPECTATIONS. DURABILITY IS UNMATCHED IN FIELD TESTS."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "AGENT K"
        },
        {
          "type": "text",
          "id": "detail",
          "label": "Detail",
          "default": "VERIFIED"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP32 - Brutalist Testi",
      "blocks": [
        { "type": "quote" },
        { "type": "quote", "settings": { "quote": "THE AESTHETIC IS BRUTAL. THE FUNCTION IS FLAWLESS.", "author": "J. DOE" } },
        { "type": "quote", "settings": { "quote": "FINALLY, GEAR THAT DOESN'T COMPROMISE ON PERFORMANCE OR DESIGN.", "author": "SECTOR_7" } }
      ]
    }
  ]
}
{% endschema %}
