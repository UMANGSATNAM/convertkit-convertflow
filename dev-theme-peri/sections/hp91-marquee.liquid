{%- style -%}#shopify-section-{{ section.id }}{--hp91-mq-bg:{{ section.settings.bg_color | default: '#0D9488' }};--hp91-mq-text:{{ section.settings.text_color | default: '#fff' }};background:var(--hp91-mq-bg);color:var(--hp91-mq-text);padding:12px 0;overflow:hidden;white-space:nowrap;border-y:1px solid rgba(255,255,255,.12)}.hp91-mq__track{display:flex;gap:40px;animation:hp91-marq 22s linear infinite}@keyframes hp91-marq{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}.hp91-mq__item{font-size:12px;font-weight:700;letter-spacing:2px;text-transform:uppercase;display:flex;align-items:center;gap:10px} .hp91-mq__dot{width:6px;height:6px;border-radius:50%;background:currentColor;opacity:.6} {%- endstyle -%}<div class="hp91-mq__track">{% for i in (1..2) %}{% for block in section.blocks %}<span class="hp91-mq__item"><span>{{ block.settings.text }}</span><span class="hp91-mq__dot"></span></span>{% endfor %}{% if section.blocks.size == 0 %}<span class="hp91-mq__item">GROOMING CO. • Free Shipping • Easy Returns <span class="hp91-mq__dot"></span></span><span class="hp91-mq__item">New Drop Live <span class="hp91-mq__dot"></span></span>{% endif %}{% endfor %}</div>{% schema %}{"name":"HP91 Marquee","settings":[{"type":"color","id":"bg_color","label":"BG","default":"#0D9488"},{"type":"color","id":"text_color","label":"Text","default":"#ffffff"}],"blocks":[{"type":"item","name":"Item","settings":[{"type":"text","id":"text","label":"Text","default":"Free Shipping Over ₹999"}]}]}{% endschema %}