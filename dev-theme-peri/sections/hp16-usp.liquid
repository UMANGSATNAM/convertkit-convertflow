{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#FFFF00'
  assign text_color = section.settings.text_color | default: '#000000'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 80px 40px;
    border-bottom: 4px solid #000;
  }
  
  .hp16-usp-container-{{ section_id }} {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
  }
  
  .hp16-usp-item-{{ section_id }} {
    text-align: center;
    color: {{ text_color }};
    background: #FFF;
    border: 4px solid #000;
    border-radius: 20px;
    padding: 30px;
    box-shadow: 8px 8px 0 #FF00FF;
    transition: transform 0.2s ease;
  }
  
  .hp16-usp-item-{{ section_id }}:nth-child(2) {
    box-shadow: 8px 8px 0 #00FFFF;
  }
  
  .hp16-usp-item-{{ section_id }}:hover {
    transform: translate(-5px, -5px);
    box-shadow: 13px 13px 0 #FF00FF;
  }
  
  .hp16-usp-item-{{ section_id }}:nth-child(2):hover {
    box-shadow: 13px 13px 0 #00FFFF;
  }
  
  .hp16-usp-title-{{ section_id }} {
    font-family: 'Arial Black', Impact, sans-serif;
    font-size: 1.8rem;
    text-transform: uppercase;
    margin: 0 0 15px 0;
    -webkit-text-stroke: 1px #000;
    color: #FFF;
    text-shadow: 3px 3px 0 #000;
  }
  
  .hp16-usp-text-{{ section_id }} {
    font-family: 'Comic Sans MS', cursive;
    font-size: 1rem;
    font-weight: bold;
    line-height: 1.4;
    margin: 0;
  }

  @media (max-width: 992px) {
    .hp16-usp-container-{{ section_id }} {
      grid-template-columns: 1fr;
    }
  }
  
  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 40px 20px;
    }
  }
</style>

<div class="hp16-usp-container-{{ section_id }}">
  {% for block in section.blocks limit: 3 %}
    <div class="hp16-usp-item-{{ section_id }}" {{ block.shopify_attributes }}>
      <h3 class="hp16-usp-title-{{ section_id }}">{{ block.settings.title }}</h3>
      <p class="hp16-usp-text-{{ section_id }}">{{ block.settings.text }}</p>
    </div>
  {% endfor %}
</div>

{% schema %}
{
  "name": "HP16 USP",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFF00"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    }
  ],
  "blocks": [
    {
      "type": "usp",
      "name": "USP Item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "SO FAST"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Lightning speed delivery to your door!"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP16 USP",
      "blocks": [
        { "type": "usp", "settings": { "title": "SO FAST", "text": "Lightning speed delivery to your door!" } },
        { "type": "usp", "settings": { "title": "BFF RETURNS", "text": "Not vibing? Send it back free for 30 days." } },
        { "type": "usp", "settings": { "title": "100% CUTE", "text": "Only the hottest trends guaranteed." } }
      ]
    }
  ]
}
{% endschema %}
