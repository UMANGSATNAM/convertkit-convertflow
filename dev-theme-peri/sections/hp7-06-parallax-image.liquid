{%- liquid
  assign section_id = section.id
  assign height = section.settings.height | default: '80vh'
  assign text_color = section.settings.text_color | default: '#F4F4F0'
  assign overlay_opacity = section.settings.overlay_opacity | default: 40
-%}

<style>
  #shopify-section-{{ section_id }} {
    --text-color: {{ text_color }};
    --overlay-opacity: {{ overlay_opacity | divided_by: 100.0 }};
    --parallax-height: {{ height }};
  }

  .hp7-parallax-{{ section_id }} {
    position: relative;
    width: 100%;
    height: var(--parallax-height);
    min-height: 500px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    clip-path: inset(0 0 0 0); /* Trick for smooth parallax on Safari */
  }

  .hp7-parallax__media {
    position: fixed; /* Parallax effect */
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh; /* Must be larger than container for parallax */
    z-index: 1;
    will-change: transform;
    pointer-events: none;
  }

  .hp7-parallax__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hp7-parallax__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #000;
    opacity: var(--overlay-opacity);
    z-index: 2;
  }

  .hp7-parallax__content {
    position: relative;
    z-index: 3;
    text-align: center;
    color: var(--text-color);
    padding: 0 4vw;
    width: 100%;
  }

  .hp7-parallax__title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(3rem, 10vw, 12rem);
    font-weight: 400;
    line-height: 0.85;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    mix-blend-mode: overlay; /* Brutalist touch */
  }
  
  .hp7-parallax__title em {
    font-style: italic;
    color: transparent;
    -webkit-text-stroke: 1px var(--text-color);
    text-stroke: 1px var(--text-color);
  }

  @media screen and (max-width: 768px) {
    .hp7-parallax-{{ section_id }} {
      height: 60vh;
    }
    
    .hp7-parallax__media {
      position: absolute; /* Disable fixed parallax on mobile for performance */
      height: 100%;
    }
    
    .hp7-parallax__title {
      mix-blend-mode: normal;
    }
  }
</style>

<section class="hp7-parallax-{{ section_id }}">
  
  <div class="hp7-parallax__media">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag: 
         loading: 'lazy',
         class: 'hp7-parallax__image',
         alt: section.settings.title | escape
      }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'hp7-parallax__image placeholder-svg' }}
    {%- endif -%}
  </div>

  <div class="hp7-parallax__overlay"></div>

  <div class="hp7-parallax__content">
    {%- if section.settings.title != blank -%}
      <h2 class="hp7-parallax__title">{{ section.settings.title }}</h2>
    {%- endif -%}
  </div>

</section>

{% schema %}
{
  "name": "HP7 Parallax Banner",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Aesthetic: Editorial Brutalism",
      "info": "CSS-only parallax banner with mix-blend-mode typography."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "html",
      "id": "title",
      "label": "Title",
      "default": "RAW<br><em>BEAUTY</em>",
      "info": "Use <em> for outline text effect."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Overlay Opacity",
      "default": 40
    },
    {
      "type": "select",
      "id": "height",
      "label": "Desktop Height",
      "options": [
        { "value": "100vh", "label": "Full Screen (100vh)" },
        { "value": "80vh", "label": "Large (80vh)" },
        { "value": "60vh", "label": "Medium (60vh)" }
      ],
      "default": "80vh"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#F4F4F0"
    }
  ],
  "presets": [
    {
      "name": "HP7 Parallax Banner"
    }
  ]
}
{% endschema %}
