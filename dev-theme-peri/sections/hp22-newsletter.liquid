{%- style -%}
  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --input-bg: {{ section.settings.input_bg }};
    --font-heading: 'Lora', serif;
    --font-body: 'Outfit', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    position: relative;
    overflow: hidden;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }

  /* Organic grain texture overlay */
  {% if section.settings.show_grain %}
  #shopify-section-{{ section.id }}::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    opacity: 0.04;
    pointer-events: none;
    z-index: 1;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
  }
  {% endif %}

  .hp22-newsletter-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
    position: relative;
    z-index: 2;
  }

  @media screen and (max-width: 768px) {
    .hp22-newsletter-wrapper {
      padding: 0 20px;
    }
  }

  .hp22-newsletter__container {
    background: {{ section.settings.card_bg }};
    padding: 80px 40px;
    text-align: center;
    position: relative;
    overflow: hidden;
    {% if section.settings.shape == 'arch' %}
      border-radius: 400px 400px 40px 40px;
    {% elsif section.settings.shape == 'pill' %}
      border-radius: 200px;
    {% else %}
      border-radius: 40px;
    {% endif %}
    box-shadow: 0 20px 60px rgba(0,0,0,0.03);
  }

  @media screen and (max-width: 992px) {
    .hp22-newsletter__container {
      padding: 60px 30px;
      {% if section.settings.shape == 'arch' %}
        border-radius: 200px 200px 24px 24px;
      {% elsif section.settings.shape == 'pill' %}
        border-radius: 40px; /* soften on mobile */
      {% endif %}
    }
  }

  /* Decorative Abstract Shapes */
  .hp22-newsletter__deco-1 {
    position: absolute;
    top: -50px;
    left: -50px;
    width: 200px;
    height: 200px;
    background: var(--accent-color);
    opacity: 0.1;
    border-radius: 40% 60% 70% 30% / 40% 50% 60% 50%;
    animation: hp22-float 10s ease-in-out infinite;
    pointer-events: none;
  }

  .hp22-newsletter__deco-2 {
    position: absolute;
    bottom: -80px;
    right: -20px;
    width: 300px;
    height: 300px;
    background: var(--accent-color);
    opacity: 0.05;
    border-radius: 60% 40% 30% 70% / 50% 60% 40% 50%;
    animation: hp22-float 12s ease-in-out infinite reverse;
    pointer-events: none;
  }

  @keyframes hp22-float {
    0%, 100% { transform: translate(0, 0) rotate(0deg); }
    50% { transform: translate(20px, -20px) rotate(10deg); }
  }

  .hp22-newsletter__content {
    position: relative;
    z-index: 2;
    max-width: 600px;
    margin: 0 auto;
  }

  .hp22-newsletter__subtitle {
    font-family: var(--font-body);
    font-size: {{ section.settings.subtitle_size }}px;
    font-weight: 400;
    letter-spacing: 2px;
    color: var(--accent-color);
    text-transform: uppercase;
    margin: 0 0 16px;
  }

  .hp22-newsletter__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    font-weight: 400;
    color: var(--text-color);
    margin: 0 0 20px;
    line-height: 1.15;
  }
  
  .hp22-newsletter__title em {
    font-style: italic;
    color: var(--accent-color);
  }

  .hp22-newsletter__text {
    font-family: var(--font-body);
    font-size: {{ section.settings.text_size }}px;
    font-weight: 300;
    line-height: 1.6;
    color: var(--text-color);
    opacity: 0.8;
    margin: 0 0 40px;
  }

  /* Form Styling */
  .hp22-newsletter__form {
    display: flex;
    position: relative;
    max-width: 500px;
    margin: 0 auto;
    background: var(--input-bg);
    border-radius: 40px;
    padding: 6px;
    box-shadow: 0 5px 15px rgba(0,0,0,0.03);
    border: 1px solid rgba(0,0,0,0.05);
  }

  @media screen and (max-width: 480px) {
    .hp22-newsletter__form {
      flex-direction: column;
      background: transparent;
      box-shadow: none;
      border: none;
      padding: 0;
      gap: 12px;
    }
  }

  .hp22-newsletter__input {
    flex: 1;
    background: transparent;
    border: none;
    padding: 0 24px;
    font-family: var(--font-body);
    font-size: 15px;
    color: var(--text-color);
    outline: none;
  }

  .hp22-newsletter__input::placeholder {
    color: var(--text-color);
    opacity: 0.5;
  }

  @media screen and (max-width: 480px) {
    .hp22-newsletter__input {
      background: var(--input-bg);
      height: 54px;
      border-radius: 30px;
      border: 1px solid rgba(0,0,0,0.05);
    }
  }

  .hp22-newsletter__btn {
    background: var(--accent-color);
    color: #ffffff;
    border: none;
    border-radius: 30px;
    padding: 0 32px;
    height: 46px;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 1px;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .hp22-newsletter__btn:hover {
    background: var(--text-color);
  }

  @media screen and (max-width: 480px) {
    .hp22-newsletter__btn {
      height: 54px;
      width: 100%;
    }
  }

  .hp22-newsletter__disclaimer {
    font-family: var(--font-body);
    font-size: 12px;
    color: var(--text-color);
    opacity: 0.5;
    margin: 20px 0 0;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp22-newsletter-wrapper" id="HP22Newsletter-{{ section.id }}">
  <div class="hp22-newsletter__container">
    
    <div class="hp22-newsletter__deco-1"></div>
    <div class="hp22-newsletter__deco-2"></div>

    <div class="hp22-newsletter__content">
      {%- if section.settings.subtitle != blank -%}
        <p class="hp22-newsletter__subtitle">{{ section.settings.subtitle | escape }}</p>
      {%- endif -%}
      
      {%- if section.settings.title != blank -%}
        <h2 class="hp22-newsletter__title">{{ section.settings.title }}</h2>
      {%- endif -%}
      
      {%- if section.settings.text != blank -%}
        <p class="hp22-newsletter__text">{{ section.settings.text | escape }}</p>
      {%- endif -%}

      {% form 'customer', class: 'hp22-newsletter__form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input 
          type="email" 
          name="contact[email]" 
          class="hp22-newsletter__input" 
          placeholder="{{ section.settings.placeholder | escape }}"
          aria-label="{{ section.settings.placeholder | escape }}"
          required
        >
        <button type="submit" class="hp22-newsletter__btn">
          {{ section.settings.btn_text | escape }}
        </button>
      {% endform %}

      {%- if section.settings.disclaimer != blank -%}
        <p class="hp22-newsletter__disclaimer">{{ section.settings.disclaimer | escape }}</p>
      {%- endif -%}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "HP22 - Organic Newsletter",
  "class": "section-hp22-newsletter",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 800,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1200
    },
    {
      "type": "select",
      "id": "shape",
      "label": "Container Shape",
      "options": [
        { "value": "arch", "label": "Arch (Top Rounded)" },
        { "value": "pill", "label": "Pill (Fully Rounded)" },
        { "value": "soft", "label": "Soft Corners" }
      ],
      "default": "pill"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "JOIN THE CLUB"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Heading",
      "default": "<p>Embrace your <em>Nature</em></p>"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Body Text",
      "default": "Sign up for 15% off your first order, early access to new botanical drops, and skincare rituals delivered to your inbox."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input Placeholder",
      "default": "Enter your email address"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "disclaimer",
      "label": "Disclaimer text",
      "default": "By subscribing, you agree to our Terms of Service and Privacy Policy."
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 48
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Subtitle Size",
      "default": 14
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Text Size",
      "default": 16
    },
    {
      "type": "header",
      "content": "Organic Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#F9F6F0"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Container Background",
      "default": "#EAE3D9"
    },
    {
      "type": "color",
      "id": "input_bg",
      "label": "Input Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#3A3A3A"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#8A9A86"
    },
    {
      "type": "checkbox",
      "id": "show_grain",
      "label": "Show subtle paper grain texture",
      "default": true
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP22 - Organic Newsletter"
    }
  ]
}
{% endschema %}
