{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#F7FAFC'
  assign text_color = section.settings.text_color | default: '#2D3748'
  assign border_color = section.settings.border_color | default: 'rgba(45, 55, 72, 0.1)'
  assign padding_top = section.settings.padding_top | default: 40
  assign padding_bottom = section.settings.padding_bottom | default: 40
  assign padding_top_mobile = section.settings.padding_top_mobile | default: 24
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile | default: 24
  assign speed = section.settings.speed | default: 25
  assign direction = section.settings.direction | default: 'left'
  assign text_size = section.settings.text_size | default: 'medium'
  assign show_border = section.settings.show_border
-%}

<style>
  #shopify-section-{{ section_id }} {
    --bg-color: {{ bg_color }};
    --text-color: {{ text_color }};
    --border-color: {{ border_color }};
    --padding-top: {{ padding_top }}px;
    --padding-bottom: {{ padding_bottom }}px;
    --padding-top-mobile: {{ padding_top_mobile }}px;
    --padding-bottom-mobile: {{ padding_bottom_mobile }}px;
    --marquee-speed: {{ speed }}s;
    
    background-color: var(--bg-color);
    color: var(--text-color);
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
    overflow: hidden;
    display: flex;
    {%- if show_border -%}
      border-top: 1px solid var(--border-color);
      border-bottom: 1px solid var(--border-color);
    {%- endif -%}
  }

  .hpv6-marquee-{{ section_id }} {
    display: flex;
    width: 100%;
    overflow: hidden;
    position: relative;
    user-select: none;
  }

  .hpv6-marquee__track {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    {%- if direction == 'left' -%}
      animation: hpv6MarqueeLeft var(--marquee-speed) linear infinite;
    {%- else -%}
      animation: hpv6MarqueeRight var(--marquee-speed) linear infinite;
    {%- endif -%}
    min-width: 100%;
  }

  /* Pause on hover */
  .hpv6-marquee-{{ section_id }}:hover .hpv6-marquee__track {
    animation-play-state: paused;
  }

  .hpv6-marquee__item {
    display: flex;
    align-items: center;
    padding: 0 3vw;
    white-space: nowrap;
    transition: opacity 0.3s ease;
  }

  /* Text Styling */
  .hpv6-marquee__text {
    font-family: 'Playfair Display', 'Georgia', serif;
    font-style: italic;
    font-weight: 400;
    line-height: 1.2;
    margin: 0;
  }
  
  .hpv6-marquee__text--small {
    font-size: clamp(1.5rem, 3vw, 2.5rem);
  }
  
  .hpv6-marquee__text--medium {
    font-size: clamp(2.5rem, 5vw, 4rem);
  }
  
  .hpv6-marquee__text--large {
    font-size: clamp(4rem, 8vw, 6rem);
  }

  /* Image styling */
  .hpv6-marquee__image {
    display: block;
    object-fit: contain;
    margin: 0 1rem;
    max-height: 80px;
    width: auto;
  }

  /* Animations */
  @keyframes hpv6MarqueeLeft {
    0% { transform: translate3d(0, 0, 0); }
    100% { transform: translate3d(-100%, 0, 0); }
  }

  @keyframes hpv6MarqueeRight {
    0% { transform: translate3d(-100%, 0, 0); }
    100% { transform: translate3d(0, 0, 0); }
  }

  /* Responsive Adjustments */
  @media screen and (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding-top: var(--padding-top-mobile);
      padding-bottom: var(--padding-bottom-mobile);
    }
    
    .hpv6-marquee__item {
      padding: 0 5vw;
    }
    
    .hpv6-marquee__image {
      max-height: 50px;
    }
  }

  /* Reduced Motion */
  @media (prefers-reduced-motion: reduce) {
    .hpv6-marquee__track {
      animation-duration: calc(var(--marquee-speed) * 4);
    }
  }
</style>

<div class="hpv6-marquee-{{ section_id }}" role="marquee" aria-label="Scrolling announcements">
  <!-- Original Track -->
  <div class="hpv6-marquee__track">
    {%- for block in section.blocks -%}
      <div class="hpv6-marquee__item" {{ block.shopify_attributes }}>
        {%- case block.type -%}
          {%- when 'text' -%}
            {%- if block.settings.text != blank -%}
              <span class="hpv6-marquee__text hpv6-marquee__text--{{ text_size }}">
                {{ block.settings.text | escape }}
              </span>
            {%- endif -%}
          {%- when 'image' -%}
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 400 | image_tag: 
                 loading: 'lazy',
                 class: 'hpv6-marquee__image',
                 alt: block.settings.image.alt | default: 'Marquee Image'
              }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'hpv6-marquee__image placeholder-svg' }}
            {%- endif -%}
        {%- endcase -%}
      </div>
    {%- endfor -%}
  </div>

  <!-- Duplicated Track for infinite loop (aria-hidden to prevent screen reader duplication) -->
  <div class="hpv6-marquee__track" aria-hidden="true">
    {%- for block in section.blocks -%}
      <div class="hpv6-marquee__item">
        {%- case block.type -%}
          {%- when 'text' -%}
            {%- if block.settings.text != blank -%}
              <span class="hpv6-marquee__text hpv6-marquee__text--{{ text_size }}">
                {{ block.settings.text | escape }}
              </span>
            {%- endif -%}
          {%- when 'image' -%}
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 400 | image_tag: 
                 loading: 'lazy',
                 class: 'hpv6-marquee__image'
              }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'hpv6-marquee__image placeholder-svg' }}
            {%- endif -%}
        {%- endcase -%}
      </div>
    {%- endfor -%}
  </div>

  <!-- Second Duplicated Track for ultra-wide screens -->
  <div class="hpv6-marquee__track" aria-hidden="true">
    {%- for block in section.blocks -%}
      <div class="hpv6-marquee__item">
        {%- case block.type -%}
          {%- when 'text' -%}
            {%- if block.settings.text != blank -%}
              <span class="hpv6-marquee__text hpv6-marquee__text--{{ text_size }}">
                {{ block.settings.text | escape }}
              </span>
            {%- endif -%}
          {%- when 'image' -%}
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 400 | image_tag: 
                 loading: 'lazy',
                 class: 'hpv6-marquee__image'
              }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'hpv6-marquee__image placeholder-svg' }}
            {%- endif -%}
        {%- endcase -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "HPV6 Marquee",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F7FAFC"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2D3748"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "rgba(45, 55, 72, 0.1)"
    },
    {
      "type": "checkbox",
      "id": "show_border",
      "label": "Show top/bottom borders",
      "default": true
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "select",
      "id": "text_size",
      "label": "Text Size",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "medium"
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 5,
      "max": 60,
      "step": 1,
      "unit": "s",
      "label": "Scrolling Speed",
      "default": 25,
      "info": "Lower number = faster speed"
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Direction",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Desktop Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Desktop Padding Bottom",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text block",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Simplicity is the ultimate sophistication"
        }
      ]
    },
    {
      "type": "image",
      "name": "Image block",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Transparent PNG or SVG works best"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HPV6 Marquee",
      "blocks": [
        { "type": "text" },
        { "type": "image" },
        { "type": "text" }
      ]
    }
  ]
}
{% endschema %}
