{%- comment -%}
  sections/fb04-category-tiles_streetwear.liquid

  CONVERSION PSYCHOLOGY (Frameblox Landing 04 Replica):
  1. DUAL GENDER SPLIT -- High-impact 2-column image tile layout for Women & Men collections.
  2. DARK GRADIENT OVERLAY -- Linear black gradient overlay guarantees high text contrast on imagery.
  3. CIRCULAR ARROW INDICATOR -- Hover animation slides arrow right, driving visual feedback.
{%- endcomment -%}

{%- liquid
  assign section_id = 'fb04-cats-' | append: section.id
-%}

<style>
  #shopify-section-{{ section.id }} {
    --ct-bg: {{ section.settings.bg_color | default: '#FFFFFF' }};
    --ct-primary: {{ section.settings.primary_color | default: '#0066FF' }};
  }

  .fb04-categories {
    background: var(--ct-bg);
    padding: clamp(2rem, 5vw, 4rem) 0;
  }

  .fb04-categories__container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 clamp(1rem, 4vw, 3.75rem);
  }

  .fb04-categories__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  .fb04-cat-tile {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    cursor: pointer;
    display: block;
    text-decoration: none;
  }

  .fb04-cat-tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .fb04-cat-tile:hover img {
    transform: scale(1.06);
  }

  .fb04-cat-tile__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.7) 0%, rgba(0, 0, 0, 0.1) 60%, transparent 100%);
    display: flex;
    align-items: flex-end;
    padding: 36px 32px;
    transition: background 0.3s ease;
  }

  .fb04-cat-tile:hover .fb04-cat-tile__overlay {
    background: linear-gradient(to top, rgba(0, 0, 0, 0.85) 0%, rgba(0, 0, 0, 0.2) 60%, transparent 100%);
  }

  .fb04-cat-tile__title {
    font-family: 'Big Shoulders Display', var(--font-heading, sans-serif);
    font-weight: 800;
    font-size: 36px;
    color: #fff;
    text-transform: uppercase;
    letter-spacing: 2px;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .fb04-cat-tile__arrow {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .fb04-cat-tile:hover .fb04-cat-tile__arrow {
    background: var(--ct-primary);
    transform: translateX(6px);
  }

  @media (max-width: 809px) {
    .fb04-categories__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<section class="fb04-categories" id="{{ section_id }}">
  <div class="fb04-categories__container">
    <div class="fb04-categories__grid">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link | default: '#' }}" class="fb04-cat-tile" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img
              src="{{ block.settings.image | image_url: width: 1000 }}"
              alt="{{ block.settings.title | escape }}"
              loading="lazy"
              width="1000"
              height="1250">
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}

          <div class="fb04-cat-tile__overlay">
            <div class="fb04-cat-tile__title">
              {{ block.settings.title }}
              <span class="fb04-cat-tile__arrow">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </span>
            </div>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FB04 Category Tiles",
  "tag": "section",
  "class": "section-fb04-categories",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "primary_color",
      "label": "Primary Accent",
      "default": "#0066FF"
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Category Tile",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Tile Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Category Title",
          "default": "Women"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Category Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FB04 Category Tiles",
      "blocks": [
        {
          "type": "tile",
          "settings": {
            "title": "Women"
          }
        },
        {
          "type": "tile",
          "settings": {
            "title": "Men"
          }
        }
      ]
    }
  ]
}
{% endschema %}
