{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#000000'
  assign text_color = section.settings.text_color | default: '#00FFFF'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 15px 0;
    overflow: hidden;
    border-bottom: 4px solid #FFF;
  }
  
  .hp16-marquee-container-{{ section_id }} {
    display: flex;
    white-space: nowrap;
    overflow: hidden;
  }
  
  .hp16-marquee-content-{{ section_id }} {
    display: inline-block;
    padding-left: 100%;
    animation: hp16-marquee-{{ section_id }} 10s linear infinite;
    font-family: 'Courier New', Courier, monospace;
    font-size: 1.5rem;
    font-weight: bold;
    text-transform: uppercase;
    color: {{ text_color }};
    text-shadow: 2px 2px 0 #FF00FF;
  }
  
  .hp16-marquee-content-{{ section_id }} span {
    margin: 0 30px;
    color: #FFFF00;
  }
  
  @keyframes hp16-marquee-{{ section_id }} {
    0% { transform: translate(0, 0); }
    100% { transform: translate(-100%, 0); }
  }

@media screen and (max-width: 768px) {
  .hp16-marquee {
    padding-left: 16px !important;
    padding-right: 16px !important;
    box-sizing: border-box !important;
  }
  img {
    max-width: 100% !important;
    height: auto !important;
  }
}

</style>

<div class="hp16-marquee-container-{{ section_id }}">
  <div class="hp16-marquee-content-{{ section_id }}">
    {% for i in (1..8) %}
      {{ section.settings.text | default: 'HOTTEST DROP OF THE CENTURY' }}
      <span>★</span>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "HP16 Marquee",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#00FFFF"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "HOTTEST DROP OF THE CENTURY"
    }
  ],
  "presets": [
    {
      "name": "HP16 Marquee"
    }
  ]
}
{% endschema %}
