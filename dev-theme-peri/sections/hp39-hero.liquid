{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;700;800&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-gradient-1: {{ section.settings.gradient_1 }};
    --bg-gradient-2: {{ section.settings.gradient_2 }};
    --text-dark: #2D2D2D;
    --text-light: #FFFFFF;
    
    --font-heading: 'Outfit', sans-serif;
    --font-body: 'Outfit', sans-serif;
  }

  .hp39-hero-wrapper {
    position: relative;
    width: 100%;
    min-height: 85vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: linear-gradient(135deg, var(--bg-gradient-1), var(--bg-gradient-2));
    padding: 40px 20px;
  }

  /* Optional ambient animated blobs in background */
  .hp39-hero__blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.6;
    z-index: 1;
    animation: float 20s infinite ease-in-out alternate;
  }

  .hp39-hero__blob--1 {
    width: 50vw; height: 50vw;
    background: #ffb7b2;
    top: -10%; left: -10%;
    animation-delay: 0s;
  }
  .hp39-hero__blob--2 {
    width: 40vw; height: 40vw;
    background: #e2f0cb;
    bottom: -10%; right: -10%;
    animation-delay: -5s;
  }
  .hp39-hero__blob--3 {
    width: 30vw; height: 30vw;
    background: #c7ceea;
    top: 40%; left: 60%;
    animation-delay: -10s;
  }

  @keyframes float {
    0% { transform: translate(0, 0) scale(1); }
    100% { transform: translate(10%, 10%) scale(1.1); }
  }

  .hp39-hero__glass-card {
    position: relative;
    z-index: 2;
    background: rgba(255, 255, 255, 0.4);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.6);
    border-radius: 40px;
    padding: 80px 60px;
    text-align: center;
    max-width: 800px;
    width: 100%;
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.05);
  }

  @media screen and (max-width: 768px) {
    .hp39-hero__glass-card {
      padding: 50px 30px;
      border-radius: 30px;
    }
  }

  .hp39-hero__badge {
    display: inline-block;
    padding: 8px 20px;
    background: rgba(255, 255, 255, 0.6);
    border-radius: 50px;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 500;
    color: var(--text-dark);
    margin-bottom: 25px;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .hp39-hero__title {
    font-family: var(--font-heading);
    font-size: clamp(40px, 6vw, {{ section.settings.title_size }}px);
    font-weight: 800;
    line-height: 1.1;
    color: var(--text-dark);
    margin: 0 0 20px;
    letter-spacing: -1px;
  }

  .hp39-hero__text {
    font-family: var(--font-body);
    font-size: clamp(16px, 2vw, 20px);
    line-height: 1.6;
    color: rgba(45, 45, 45, 0.8);
    margin: 0 auto 40px;
    max-width: 600px;
    font-weight: 400;
  }

  .hp39-hero__buttons {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 15px;
  }

  @media screen and (max-width: 480px) {
    .hp39-hero__buttons {
      flex-direction: column;
    }
  }

  .hp39-hero__btn {
    display: inline-block;
    padding: 16px 36px;
    border-radius: 50px;
    font-family: var(--font-heading);
    font-size: 16px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .hp39-hero__btn--primary {
    background: var(--text-dark);
    color: var(--text-light);
    box-shadow: 0 10px 20px rgba(0,0,0,0.1);
  }
  .hp39-hero__btn--primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 15px 25px rgba(0,0,0,0.15);
  }

  .hp39-hero__btn--secondary {
    background: rgba(255, 255, 255, 0.7);
    color: var(--text-dark);
    border: 1px solid rgba(255, 255, 255, 0.9);
  }
  .hp39-hero__btn--secondary:hover {
    background: rgba(255, 255, 255, 1);
    transform: translateY(-3px);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp39-hero-wrapper" id="HP39Hero-{{ section.id }}">
  <div class="hp39-hero__blob hp39-hero__blob--1"></div>
  <div class="hp39-hero__blob hp39-hero__blob--2"></div>
  <div class="hp39-hero__blob hp39-hero__blob--3"></div>

  <div class="hp39-hero__glass-card">
    {%- if section.settings.badge != blank -%}
      <div class="hp39-hero__badge">{{ section.settings.badge }}</div>
    {%- endif -%}
    
    <h1 class="hp39-hero__title">{{ section.settings.title }}</h1>
    
    {%- if section.settings.text != blank -%}
      <p class="hp39-hero__text">{{ section.settings.text }}</p>
    {%- endif -%}

    <div class="hp39-hero__buttons">
      {%- if section.settings.btn_1_label != blank -%}
        <a href="{{ section.settings.btn_1_link | default: '#' }}" class="hp39-hero__btn hp39-hero__btn--primary">
          {{ section.settings.btn_1_label }}
        </a>
      {%- endif -%}
      {%- if section.settings.btn_2_label != blank -%}
        <a href="{{ section.settings.btn_2_link | default: '#' }}" class="hp39-hero__btn hp39-hero__btn--secondary">
          {{ section.settings.btn_2_label }}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "HP39 - Aura Hero",
  "class": "section-hp39-hero",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge Text",
      "default": "New Collection"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Embrace the Soft Glow."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Experience a new dimension of comfort with our ethereal collection designed for modern living."
    },
    {
      "type": "text",
      "id": "btn_1_label",
      "label": "Primary Button Label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "btn_1_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "btn_2_label",
      "label": "Secondary Button Label",
      "default": "Explore"
    },
    {
      "type": "url",
      "id": "btn_2_link",
      "label": "Secondary Button Link"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 40,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 80
    },
    {
      "type": "header",
      "content": "Aura Colors"
    },
    {
      "type": "color",
      "id": "gradient_1",
      "label": "Gradient Start",
      "default": "#fdfbfb"
    },
    {
      "type": "color",
      "id": "gradient_2",
      "label": "Gradient End",
      "default": "#ebedee"
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP39 - Aura Hero"
    }
  ]
}
{% endschema %}
