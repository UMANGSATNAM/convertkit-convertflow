{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#FEF3C7' }};
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }
  .hp63-test__container { max-width: {{ section.settings.container_width | default: 1280 }}px; margin: 0 auto; padding: 0 24px; }
  .hp63-test__header { text-align: center; margin-bottom: 50px; }
  .hp63-test__eyebrow { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: #881337; margin: 0 0 12px; }
  .hp63-test__heading { font-family: 'Playfair Display', serif; font-size: clamp(28px, 3.5vw, 42px); font-weight: 700; color: #1C1917; margin: 0; }
  .hp63-test__grid { display: grid; grid-template-columns: repeat({{ section.settings.columns | default: 3 }}, 1fr); gap: 20px; }
  .hp63-test__card { background: #FFFFFF; border: 1px solid rgba(217, 119, 6, 0.25); border-radius: 6px; padding: 32px 24px; box-shadow: 0 4px 20px rgba(136, 19, 55, 0.05); }
  .hp63-test__stars { color: #D97706; font-size: 16px; margin-bottom: 16px; letter-spacing: 2px; }
  .hp63-test__quote { font-family: 'Playfair Display', serif; font-size: 17px; font-style: italic; line-height: 1.6; color: #44403C; margin: 0 0 20px; }
  .hp63-test__author { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 13px; font-weight: 700; color: #1C1917; margin: 0; }
  .hp63-test__role { font-size: 11px; color: #881337; margin: 4px 0 0; letter-spacing: 1px; text-transform: uppercase; }
  @media screen and (max-width: 992px) { .hp63-test__grid { grid-template-columns: 1fr; max-width: 600px; margin: 0 auto; } }
{%- endstyle -%}
<div class="hp63-test__container">
  <div class="hp63-test__header">
    {%- if section.settings.eyebrow != blank -%}<p class="hp63-test__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="hp63-test__heading">{{ section.settings.heading | default: 'Riad & Hammam Chronicles' }}</h2>
  </div>
  <div class="hp63-test__grid">
    {%- for block in section.blocks -%}
      <div class="hp63-test__card" {{ block.shopify_attributes }}>
        <div class="hp63-test__stars">{{ block.settings.stars | default: '★★★★★' }}</div>
        <p class="hp63-test__quote">"{{ block.settings.quote | default: 'The pure Damask rose water brought life and luminosity back to my dehydrated complexion.' }}"</p>
        <p class="hp63-test__author">{{ block.settings.author | default: 'Soraya Benali' }}</p>
        <p class="hp63-test__role">{{ block.settings.role | default: 'Marrakech Hammam Master' }}</p>
      </div>
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "HP63 Reviews",
  "class": "section-hp63-test",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FEF3C7" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "🌹 REVIEWS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Riad & Hammam Chronicles" },
    { "type": "range", "id": "columns", "min": 1, "max": 3, "step": 1, "label": "Columns", "default": 3 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "blocks": [{ "type": "testimonial", "name": "Review", "settings": [
    { "type": "text", "id": "stars", "label": "Stars", "default": "★★★★★" },
    { "type": "textarea", "id": "quote", "label": "Quote", "default": "The pure Damask rose water brought life and luminosity back." },
    { "type": "text", "id": "author", "label": "Author", "default": "Soraya Benali" },
    { "type": "text", "id": "role", "label": "Role", "default": "Marrakech Hammam Master" }
  ]}],
  "presets": [{ "name": "HP63 Reviews", "blocks": [
    { "type": "testimonial" },
    { "type": "testimonial", "settings": { "quote": "The spiced amber nectar feels like velvet. My fine lines around the eyes have softened drastically.", "author": "Camilla Dupont", "role": "Parisian Esthetician" } },
    { "type": "testimonial", "settings": { "quote": "Authentic Moroccan rose distillation. You can smell the morning dew on the petals.", "author": "Leila El Mansouri", "role": "Botanical Chemist" } }
  ]}]
}
{% endschema %}
