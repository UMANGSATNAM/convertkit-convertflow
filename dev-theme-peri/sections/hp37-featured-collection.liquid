{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Shrikhand&family=DM+Sans:wght@400;500;700&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --card-bg: {{ section.settings.card_bg }};
    --accent-color: {{ section.settings.accent_color }};
    
    --font-heading: 'Shrikhand', cursive;
    --font-body: 'DM Sans', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .hp37-featured-wrapper {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp37-featured-wrapper {
      padding: 0 20px;
    }
  }

  .hp37-featured__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 50px;
  }

  @media screen and (max-width: 768px) {
    .hp37-featured__header {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }
  }

  .hp37-featured__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 6vw, {{ section.settings.title_size }}px);
    line-height: 1.1;
    color: var(--text-color);
    margin: 0;
    text-shadow: 2px 2px 0px var(--accent-color);
  }

  .hp37-featured__view-all {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 700;
    color: var(--text-color);
    text-decoration: none;
    border: 3px solid var(--text-color);
    padding: 10px 25px;
    border-radius: 50px;
    background: var(--card-bg);
    box-shadow: 4px 4px 0px var(--text-color);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .hp37-featured__view-all:hover {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0px var(--text-color);
  }

  .hp37-featured__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 30px;
  }

  @media screen and (max-width: 1024px) {
    .hp37-featured__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media screen and (max-width: 500px) {
    .hp37-featured__grid {
      grid-template-columns: 1fr;
    }
  }

  .hp37-featured__product {
    background: var(--card-bg);
    border: 3px solid var(--text-color);
    border-radius: 20px;
    padding: 20px;
    box-shadow: 6px 6px 0px var(--text-color);
    display: flex;
    flex-direction: column;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    group: card;
  }

  .hp37-featured__product:hover {
    transform: translate(3px, 3px);
    box-shadow: 3px 3px 0px var(--text-color);
  }

  .hp37-featured__image-wrap {
    aspect-ratio: 4/5;
    background: #e9e9e9;
    border-radius: 100px 100px 10px 10px; /* Arched top */
    overflow: hidden;
    margin-bottom: 20px;
    border: 2px solid var(--text-color);
    position: relative;
  }

  .hp37-featured__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    mix-blend-mode: multiply;
  }

  .hp37-featured__info {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    flex-grow: 1;
  }

  .hp37-featured__vendor {
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 700;
    color: var(--accent-color);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 5px;
  }

  .hp37-featured__product-title {
    font-family: var(--font-heading);
    font-size: 20px;
    color: var(--text-color);
    margin: 0 0 10px;
    line-height: 1.2;
  }

  .hp37-featured__price {
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 700;
    color: var(--text-color);
    margin-bottom: 20px;
  }

  .hp37-featured__add-btn {
    width: 100%;
    padding: 12px;
    background: var(--text-color);
    color: var(--bg-color);
    border: none;
    border-radius: 50px;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    cursor: pointer;
    margin-top: auto;
  }

  .hp37-featured__add-btn:hover {
    background: var(--accent-color);
    color: var(--text-color);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp37-featured-wrapper" id="HP37Featured-{{ section.id }}">
  <div class="hp37-featured__header">
    <h2 class="hp37-featured__title">{{ section.settings.title }}</h2>
    {%- if section.settings.view_all_label != blank -%}
      <a href="{{ section.settings.view_all_link | default: '#' }}" class="hp37-featured__view-all">
        {{ section.settings.view_all_label }}
      </a>
    {%- endif -%}
  </div>

  <div class="hp37-featured__grid">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.product_link | default: '#' }}" class="hp37-featured__product" {{ block.shopify_attributes }}>
        <div class="hp37-featured__image-wrap">
          {%- if block.settings.image != blank -%}
            <img height="{{ block.settings.image.height }}" width="{{ block.settings.image.width }}" src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title | escape }}" class="hp37-featured__image" loading="lazy">
          {%- else -%}
            {%- assign placeholder = 'product-' | append: forloop.index -%}
            {%- if forloop.index > 6 -%}{%- assign placeholder = 'product-1' -%}{%- endif -%}
            {{ placeholder | placeholder_svg_tag: 'hp37-featured__image' }}
          {%- endif -%}
        </div>
        
        <div class="hp37-featured__info">
          {%- if block.settings.vendor != blank -%}
            <div class="hp37-featured__vendor">{{ block.settings.vendor }}</div>
          {%- endif -%}
          <h3 class="hp37-featured__product-title">{{ block.settings.title }}</h3>
          <div class="hp37-featured__price">{{ block.settings.price }}</div>
          
          <button class="hp37-featured__add-btn">Add to Bag</button>
        </div>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "HP37 - Retro Featured",
  "class": "section-hp37-featured-collection",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "New Arrivals"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View All Label",
      "default": "Shop All"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View All Link"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 64
    },
    {
      "type": "header",
      "content": "Retro Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#F4E3C5"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background",
      "default": "#F9F3EA"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#4A3219"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#D96C4A"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "vendor",
          "label": "Vendor",
          "default": "Retro Co."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Striped Ringer Tee"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "$45"
        },
        {
          "type": "url",
          "id": "product_link",
          "label": "Product Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP37 - Retro Featured",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
