{% comment %}
  FB04 Footer — 4-column dark footer with logo, links, social
{% endcomment %}

<style>
  .fb04-footer {
    padding: 80px 60px 40px;
    background: #282A2F;
  }
  .fb04-footer__inner {
    max-width: 1200px;
    margin: 0 auto;
  }
  .fb04-footer__grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 48px;
    margin-bottom: 48px;
  }
  .fb04-footer__brand-name {
    font-family: 'Big Shoulders Display', sans-serif;
    font-weight: 700;
    font-size: 28px;
    color: #fff;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 16px;
  }
  .fb04-footer__brand-desc {
    font-family: 'Host Grotesk', sans-serif;
    font-weight: 400;
    font-size: 14px;
    color: #7B818E;
    line-height: 1.6;
    max-width: 300px;
  }
  .fb04-footer__col-title {
    font-family: 'Host Grotesk', sans-serif;
    font-weight: 700;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #fff;
    margin-bottom: 20px;
  }
  .fb04-footer__links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .fb04-footer__links a {
    font-family: 'Host Grotesk', sans-serif;
    font-weight: 400;
    font-size: 14px;
    color: #7B818E;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .fb04-footer__links a:hover {
    color: #fff;
  }
  .fb04-footer__divider {
    border: none;
    border-top: 1px solid rgba(255,255,255,0.08);
    margin-bottom: 24px;
  }
  .fb04-footer__copyright {
    font-family: 'Host Grotesk', sans-serif;
    font-weight: 400;
    font-size: 12px;
    color: #7B818E;
    text-align: center;
  }

  @media (max-width: 809px) {
    .fb04-footer {
      padding: 60px 24px 32px;
    }
    .fb04-footer__grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
  @media (min-width: 810px) and (max-width: 1199px) {
    .fb04-footer {
      padding: 60px 40px 32px;
    }
    .fb04-footer__grid {
      grid-template-columns: 1fr 1fr;
      gap: 32px;
    }
  }
</style>

<footer class="fb04-footer">
  <div class="fb04-footer__inner">
    <div class="fb04-footer__grid">
      <div class="fb04-footer__brand">
        <p class="fb04-footer__brand-name">{{ section.settings.brand_name | default: 'RAWBLOX' }}</p>
        <p class="fb04-footer__brand-desc">{{ section.settings.brand_desc | default: 'Streetwear for the Bold, Built for the Movement. Inspired by the raw energy of the streets, we create statement pieces that blend style, attitude, and individuality.' }}</p>
      </div>

      {% for block in section.blocks %}
        {% if block.type == 'link_column' %}
          <div class="fb04-footer__col">
            <p class="fb04-footer__col-title">{{ block.settings.column_title }}</p>
            <ul class="fb04-footer__links">
              {% if block.settings.link_1_text != blank %}
                <li><a href="{{ block.settings.link_1_url | default: '#' }}">{{ block.settings.link_1_text }}</a></li>
              {% endif %}
              {% if block.settings.link_2_text != blank %}
                <li><a href="{{ block.settings.link_2_url | default: '#' }}">{{ block.settings.link_2_text }}</a></li>
              {% endif %}
              {% if block.settings.link_3_text != blank %}
                <li><a href="{{ block.settings.link_3_url | default: '#' }}">{{ block.settings.link_3_text }}</a></li>
              {% endif %}
              {% if block.settings.link_4_text != blank %}
                <li><a href="{{ block.settings.link_4_url | default: '#' }}">{{ block.settings.link_4_text }}</a></li>
              {% endif %}
              {% if block.settings.link_5_text != blank %}
                <li><a href="{{ block.settings.link_5_url | default: '#' }}">{{ block.settings.link_5_text }}</a></li>
              {% endif %}
            </ul>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <hr class="fb04-footer__divider">
    <p class="fb04-footer__copyright">{{ section.settings.copyright | default: '© 2025 Copyright' }}</p>
  </div>
</footer>

{% schema %}
{
  "name": "FB04 Footer",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "brand_name", "label": "Brand Name", "default": "RAWBLOX" },
    { "type": "textarea", "id": "brand_desc", "label": "Brand Description", "default": "Streetwear for the Bold, Built for the Movement. Inspired by the raw energy of the streets, we create statement pieces that blend style, attitude, and individuality." },
    { "type": "text", "id": "copyright", "label": "Copyright Text", "default": "© 2025 Copyright" }
  ],
  "blocks": [
    {
      "type": "link_column",
      "name": "Link Column",
      "settings": [
        { "type": "text", "id": "column_title", "label": "Column Title", "default": "Menu" },
        { "type": "text", "id": "link_1_text", "label": "Link 1 Text", "default": "Home" },
        { "type": "url", "id": "link_1_url", "label": "Link 1 URL" },
        { "type": "text", "id": "link_2_text", "label": "Link 2 Text", "default": "Shop" },
        { "type": "url", "id": "link_2_url", "label": "Link 2 URL" },
        { "type": "text", "id": "link_3_text", "label": "Link 3 Text", "default": "About" },
        { "type": "url", "id": "link_3_url", "label": "Link 3 URL" },
        { "type": "text", "id": "link_4_text", "label": "Link 4 Text", "default": "Contact" },
        { "type": "url", "id": "link_4_url", "label": "Link 4 URL" },
        { "type": "text", "id": "link_5_text", "label": "Link 5 Text" },
        { "type": "url", "id": "link_5_url", "label": "Link 5 URL" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FB04 Footer",
      "blocks": [
        { "type": "link_column", "settings": { "column_title": "Menu", "link_1_text": "Home", "link_2_text": "Shop", "link_3_text": "About", "link_4_text": "Contact", "link_5_text": "Story" } },
        { "type": "link_column", "settings": { "column_title": "Shop", "link_1_text": "Collections", "link_2_text": "New Arrival", "link_3_text": "Men Collections", "link_4_text": "Women Collections", "link_5_text": "Accessories" } },
        { "type": "link_column", "settings": { "column_title": "Social", "link_1_text": "LinkedIn", "link_2_text": "Instagram", "link_3_text": "Twitter", "link_4_text": "Facebook", "link_5_text": "TikTok" } }
      ]
    }
  ]
}
{% endschema %}
