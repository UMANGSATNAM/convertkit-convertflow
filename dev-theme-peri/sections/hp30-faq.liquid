{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Oswald:wght@700&family=Space+Grotesk:wght@400;700&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --border-color: {{ section.settings.border_color }};
    --accent-color: {{ section.settings.accent_color }};
    
    --font-heading: 'Oswald', sans-serif;
    --font-body: 'Space Grotesk', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    border-bottom: 4px solid var(--border-color);
  }

  .hp30-faq-wrapper {
    max-width: 1800px;
    margin: 0 auto;
    border-left: 4px solid var(--border-color);
    border-right: 4px solid var(--border-color);
    display: grid;
    grid-template-columns: 1fr 2fr;
  }

  @media screen and (max-width: 992px) {
    .hp30-faq-wrapper {
      grid-template-columns: 1fr;
    }
  }

  .hp30-faq__header-col {
    padding: 60px;
    border-right: 4px solid var(--border-color);
    background: var(--text-color);
    color: var(--bg-color);
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }

  @media screen and (max-width: 992px) {
    .hp30-faq__header-col {
      padding: 40px 20px;
      border-right: none;
      border-bottom: 4px solid var(--border-color);
    }
  }

  .hp30-faq__title {
    font-family: var(--font-heading);
    font-size: clamp(40px, 6vw, {{ section.settings.title_size }}px);
    line-height: 1;
    text-transform: uppercase;
    color: currentColor;
    margin: 0 0 20px;
    letter-spacing: -0.02em;
  }

  .hp30-faq__subtitle {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 700;
    text-transform: uppercase;
    color: currentColor;
    opacity: 0.8;
    margin: 0;
  }

  .hp30-faq__accordion-col {
    display: flex;
    flex-direction: column;
  }

  .hp30-faq__item {
    border-bottom: 4px solid var(--border-color);
  }

  .hp30-faq__item:last-child {
    border-bottom: none;
  }

  .hp30-faq__question {
    width: 100%;
    background: transparent;
    border: none;
    padding: 30px 40px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-heading);
    font-size: clamp(20px, 3vw, 30px);
    text-transform: uppercase;
    color: var(--text-color);
    text-align: left;
    cursor: pointer;
    transition: background-color 0s, color 0s;
  }

  @media screen and (max-width: 768px) {
    .hp30-faq__question {
      padding: 20px;
    }
  }

  .hp30-faq__question:hover,
  .hp30-faq__item.is-active .hp30-faq__question {
    background: var(--text-color);
    color: var(--bg-color);
  }

  .hp30-faq__icon {
    font-family: var(--font-body);
    font-size: 30px;
    font-weight: 700;
    color: inherit;
    line-height: 1;
  }

  .hp30-faq__answer {
    max-height: 0;
    overflow: hidden;
    background: var(--bg-color);
  }

  .hp30-faq__answer-inner {
    padding: 30px 40px;
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 700;
    line-height: 1.5;
    text-transform: uppercase;
    color: var(--text-color);
  }

  @media screen and (max-width: 768px) {
    .hp30-faq__answer-inner {
      padding: 20px;
      font-size: 16px;
    }
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp30-faq-wrapper" id="HP30FAQ-{{ section.id }}">
  <div class="hp30-faq__header-col">
    <h2 class="hp30-faq__title">{{ section.settings.title }}</h2>
    <p class="hp30-faq__subtitle">{{ section.settings.subtitle }}</p>
  </div>

  <div class="hp30-faq__accordion-col">
    {%- for block in section.blocks -%}
      <div class="hp30-faq__item" {{ block.shopify_attributes }}>
        <button class="hp30-faq__question" aria-expanded="false">
          {{ block.settings.question }}
          <span class="hp30-faq__icon">+</span>
        </button>
        <div class="hp30-faq__answer">
          <div class="hp30-faq__answer-inner">
            {{ block.settings.answer }}
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const faqItems = document.querySelectorAll('#HP30FAQ-{{ section.id }} .hp30-faq__item');
    
    faqItems.forEach(item => {
      const btn = item.querySelector('.hp30-faq__question');
      const answer = item.querySelector('.hp30-faq__answer');
      const icon = item.querySelector('.hp30-faq__icon');
      
      btn.addEventListener('click', () => {
        const isActive = item.classList.contains('is-active');
        
        // Close all
        faqItems.forEach(faq => {
          faq.classList.remove('is-active');
          faq.querySelector('.hp30-faq__question').setAttribute('aria-expanded', 'false');
          faq.querySelector('.hp30-faq__answer').style.maxHeight = null;
          faq.querySelector('.hp30-faq__icon').textContent = '+';
        });

        // Open current if it wasn't active
        if (!isActive) {
          item.classList.add('is-active');
          btn.setAttribute('aria-expanded', 'true');
          answer.style.maxHeight = answer.scrollHeight + "px";
          icon.textContent = '-';
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "HP30 - Brutalist FAQ",
  "class": "section-hp30-faq",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "SYSTEM.INFO"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "CRITICAL DATA & PARAMETERS"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 40,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "Heading Size",
      "default": 80
    },
    {
      "type": "header",
      "content": "Brutalist Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (White)",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text (Black)",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Borders",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent (Red)",
      "default": "#FF0000"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 0
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "DELIVERY PARAMETERS?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "ALL ORDERS ARE DISPATCHED WITHIN 24 HOURS. GLOBAL REACH. NO EXCEPTIONS."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP30 - Brutalist FAQ",
      "blocks": [
        { "type": "faq" },
        { "type": "faq", "settings": { "question": "RETURN PROTOCOL?", "answer": "14-DAY RETURN WINDOW. ITEMS MUST BE IN ORIGINAL CONDITION WITH ALL TAGS ATTACHED." } },
        { "type": "faq", "settings": { "question": "MATERIAL SPECIFICATIONS?", "answer": "HEAVYWEIGHT COTTON. INDUSTRIAL GRADE HARDWARE. ENGINEERED FOR LONGEVITY." } }
      ]
    }
  ]
}
{% endschema %}
