{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#FF00FF'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 60px 40px;
    border-bottom: 4px solid #000;
  }
  
  .hp16-pills-container-{{ section_id }} {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 20px;
  }
  
  .hp16-pill-{{ section_id }} {
    display: inline-flex;
    align-items: center;
    padding: 15px 30px;
    background: #FFF;
    border: 3px solid #000;
    border-radius: 40px;
    color: #000;
    text-decoration: none;
    font-family: 'Arial Black', sans-serif;
    font-size: 1.2rem;
    text-transform: uppercase;
    box-shadow: 5px 5px 0 #FFFF00;
    transition: all 0.2s ease;
  }
  
  .hp16-pill-{{ section_id }}:hover {
    background: #00FFFF;
    transform: translate(2px, 2px);
    box-shadow: 3px 3px 0 #FFFF00;
  }
  
  .hp16-pill-{{ section_id }}:nth-child(even) {
    box-shadow: 5px 5px 0 #000;
  }
  .hp16-pill-{{ section_id }}:nth-child(even):hover {
    box-shadow: 3px 3px 0 #000;
    background: #FFFF00;
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 40px 20px;
    }
    .hp16-pill-{{ section_id }} {
      padding: 10px 20px;
      font-size: 1rem;
    }
  }
</style>

<div class="hp16-pills-container-{{ section_id }}">
  {% for block in section.blocks %}
    <a href="{{ block.settings.link | default: '#' }}" class="hp16-pill-{{ section_id }}" {{ block.shopify_attributes }}>
      {{ block.settings.title | default: 'Category' }}
    </a>
  {% endfor %}
</div>

{% schema %}
{
  "name": "HP16 Category Pills",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FF00FF"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Category"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP16 Category Pills",
      "blocks": [
        { "type": "category", "settings": { "title": "CROP TOPS" } },
        { "type": "category", "settings": { "title": "LOW RISE JEANS" } },
        { "type": "category", "settings": { "title": "CHUNKY SHOES" } },
        { "type": "category", "settings": { "title": "TINY BAGS" } }
      ]
    }
  ]
}
{% endschema %}
