{%- style -%}
  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --font-heading: 'Lora', serif;
    --font-body: 'Outfit', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    position: relative;
    overflow: hidden;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }

  /* Organic grain texture overlay */
  {% if section.settings.show_grain %}
  #shopify-section-{{ section.id }}::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    opacity: 0.04;
    pointer-events: none;
    z-index: 1;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
  }
  {% endif %}

  .hp22-video-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
    position: relative;
    z-index: 2;
  }

  @media screen and (max-width: 768px) {
    .hp22-video-wrapper {
      padding: 0 20px;
    }
  }

  .hp22-video__container {
    position: relative;
    width: 100%;
    aspect-ratio: {{ section.settings.desktop_ratio }};
    background-color: #DCD2C6;
    overflow: hidden;
    box-shadow: 0 30px 60px rgba(0,0,0,0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    
    {% if section.settings.video_shape == 'arch' %}
      border-radius: 400px 400px 24px 24px;
    {% elsif section.settings.video_shape == 'pill' %}
      border-radius: 400px;
    {% else %}
      border-radius: 24px;
    {% endif %}
  }

  @media screen and (max-width: 992px) {
    .hp22-video__container {
      aspect-ratio: {{ section.settings.mobile_ratio }};
      {% if section.settings.video_shape == 'arch' %}
        border-radius: 200px 200px 16px 16px;
      {% elsif section.settings.video_shape == 'pill' %}
        border-radius: 200px;
      {% endif %}
    }
  }

  .hp22-video__media {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
    transition: transform 1.5s ease;
  }

  .hp22-video__container:hover .hp22-video__media {
    transform: scale(1.03);
  }

  .hp22-video__overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0,0,0, {{ section.settings.overlay_opacity }});
    z-index: 2;
  }

  .hp22-video__content {
    position: relative;
    z-index: 3;
    text-align: center;
    padding: 40px;
    max-width: 800px;
  }

  .hp22-video__play-btn {
    width: {{ section.settings.play_btn_size }}px;
    height: {{ section.settings.play_btn_size }}px;
    border-radius: 50%;
    background: var(--bg-color);
    color: var(--accent-color);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 32px;
    border: none;
    transition: all 0.4s ease;
    cursor: pointer;
    box-shadow: 0 10px 30px rgba(0,0,0,0.1);
  }

  .hp22-video__container:hover .hp22-video__play-btn {
    transform: scale(1.1);
    background: var(--accent-color);
    color: var(--bg-color);
  }

  .hp22-video__play-btn svg {
    width: 30%;
    height: 30%;
    fill: currentColor;
    margin-left: 10%;
  }

  .hp22-video__subtitle {
    font-family: var(--font-body);
    font-size: {{ section.settings.subtitle_size }}px;
    font-weight: 400;
    letter-spacing: 3px;
    color: #FFFFFF;
    text-transform: uppercase;
    margin: 0 0 16px;
  }

  .hp22-video__title {
    font-family: var(--font-heading);
    font-size: clamp(36px, 6vw, {{ section.settings.title_size }}px);
    font-weight: 400;
    color: #FFFFFF;
    margin: 0;
    line-height: 1.15;
  }
  
  .hp22-video__title em {
    font-style: italic;
    color: var(--bg-color);
    font-weight: 300;
  }

  /* Decorative Leaf SVG */
  .hp22-video__deco-leaf-1 {
    position: absolute;
    top: 50px; left: 50px;
    width: 100px; height: 100px;
    color: var(--accent-color);
    opacity: 0.15;
    z-index: 1;
    transform: rotate(-30deg);
  }
  
  .hp22-video__deco-leaf-2 {
    position: absolute;
    bottom: 50px; right: 50px;
    width: 140px; height: 140px;
    color: var(--accent-color);
    opacity: 0.15;
    z-index: 1;
    transform: rotate(150deg);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp22-video-wrapper" id="HP22Video-{{ section.id }}">
  
  {%- if section.settings.show_deco_leaves -%}
    <svg class="hp22-video__deco-leaf-1" viewBox="0 0 24 24" fill="currentColor"><path d="M17,8C8,10 5.9,16.17 3.82,21.34L5.71,22L6.66,19.7C7.14,19.87 7.64,20 8,20C19,20 22,3 22,3C21,5 14,5.25 9,6.25C4,7.25 7,14 7,14C18,14 17,8 17,8Z"/></svg>
    <svg class="hp22-video__deco-leaf-2" viewBox="0 0 24 24" fill="currentColor"><path d="M17,8C8,10 5.9,16.17 3.82,21.34L5.71,22L6.66,19.7C7.14,19.87 7.64,20 8,20C19,20 22,3 22,3C21,5 14,5.25 9,6.25C4,7.25 7,14 7,14C18,14 17,8 17,8Z"/></svg>
  {%- endif -%}

  <div class="hp22-video__container">
    
    {%- if section.settings.video_url != blank -%}
      <video class="hp22-video__media" autoplay loop muted playsinline>
        <source src="{{ section.settings.video_url }}" type="video/mp4">
      </video>
    {%- elsif section.settings.image != blank -%}
      <img src="{{ section.settings.image | image_url: width: 2000 }}" alt="{{ section.settings.title | escape }}" class="hp22-video__media" loading="lazy">
    {%- else -%}
      <div style="width:100%;height:100%;background:#8A9A86;position:absolute;"></div>
    {%- endif -%}

    <div class="hp22-video__overlay"></div>

    <div class="hp22-video__content">
      <button class="hp22-video__play-btn" aria-label="Play Video">
        <svg viewBox="0 0 24 24"><path d="M8,5.14V19.14L19,12.14L8,5.14Z"/></svg>
      </button>

      {%- if section.settings.subtitle != blank -%}
        <p class="hp22-video__subtitle">{{ section.settings.subtitle | escape }}</p>
      {%- endif -%}
      
      {%- if section.settings.title != blank -%}
        <h2 class="hp22-video__title">{{ section.settings.title }}</h2>
      {%- endif -%}
    </div>

  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const videoContainer = document.querySelector('#HP22Video-{{ section.id }} .hp22-video__container');
    const video = videoContainer.querySelector('video');
    
    if(video) {
      videoContainer.addEventListener('click', function() {
        if(video.paused) {
          video.play();
        } else {
          video.pause();
        }
      });
    }
  });
</script>

{% schema %}
{
  "name": "HP22 - Organic Video",
  "class": "section-hp22-video-banner",
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "MP4 Video URL",
      "info": "Hosted MP4 link (e.g. from Shopify Files)"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Fallback Image",
      "info": "Displays if video fails or is empty"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "THE RITUAL"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Heading",
      "default": "<p>Experience true <em>radiance</em>.</p>"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 2000,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1400
    },
    {
      "type": "select",
      "id": "video_shape",
      "label": "Video Shape",
      "options": [
        { "value": "arch", "label": "Arch (Top Rounded)" },
        { "value": "pill", "label": "Pill (Fully Rounded)" },
        { "value": "soft", "label": "Soft Corners" }
      ],
      "default": "arch"
    },
    {
      "type": "select",
      "id": "desktop_ratio",
      "label": "Desktop Aspect Ratio",
      "options": [
        { "value": "16/9", "label": "Widescreen (16:9)" },
        { "value": "21/9", "label": "Cinematic (21:9)" },
        { "value": "1/1", "label": "Square (1:1)" },
        { "value": "3/2", "label": "Standard (3:2)" }
      ],
      "default": "16/9"
    },
    {
      "type": "select",
      "id": "mobile_ratio",
      "label": "Mobile Aspect Ratio",
      "options": [
        { "value": "16/9", "label": "Widescreen (16:9)" },
        { "value": "1/1", "label": "Square (1:1)" },
        { "value": "3/4", "label": "Portrait (3:4)" },
        { "value": "9/16", "label": "Vertical (9:16)" }
      ],
      "default": "3/4"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 0.9,
      "step": 0.1,
      "label": "Overlay Opacity",
      "default": 0.3
    },
    {
      "type": "range",
      "id": "play_btn_size",
      "min": 60,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "Play Button Size",
      "default": 100
    },
    {
      "type": "checkbox",
      "id": "show_deco_leaves",
      "label": "Show Decorative SVG Leaves behind video",
      "default": true
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 30,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 64
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Subtitle Size",
      "default": 14
    },
    {
      "type": "header",
      "content": "Organic Styling"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#F9F6F0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#3A3A3A"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color (Leaves / Play Icon)",
      "default": "#8A9A86"
    },
    {
      "type": "checkbox",
      "id": "show_grain",
      "label": "Show subtle paper grain texture",
      "default": true
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP22 - Organic Video"
    }
  ]
}
{% endschema %}
