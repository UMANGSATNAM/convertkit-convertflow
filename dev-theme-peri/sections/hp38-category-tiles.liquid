{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Space+Mono:ital,wght@0,400;0,700;1,400;1,700&family=Inter:wght@400;600;800&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    
    --font-heading: 'Space Mono', monospace;
    --font-body: 'Inter', sans-serif;
    
    background-color: var(--text-color); /* Acts as the border color between grid items */
    border-bottom: 2px solid var(--text-color);
  }

  .hp38-tiles-wrapper {
    /* Full width grid */
  }

  .hp38-tiles__header {
    background: var(--bg-color);
    padding: 60px 40px;
    border-bottom: 2px solid var(--text-color);
    text-align: center;
  }

  @media screen and (max-width: 768px) {
    .hp38-tiles__header {
      padding: 40px 20px;
    }
  }

  .hp38-tiles__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    line-height: 1.1;
    color: var(--text-color);
    text-transform: uppercase;
    margin: 0;
  }

  .hp38-tiles__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
  }

  @media screen and (max-width: 992px) {
    .hp38-tiles__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media screen and (max-width: 600px) {
    .hp38-tiles__grid { grid-template-columns: 1fr; }
  }

  .hp38-tile {
    position: relative;
    text-decoration: none;
    aspect-ratio: 1;
    background: var(--bg-color);
    overflow: hidden;
    group: card;
  }

  .hp38-tile__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%);
    transition: transform 0.5s ease, filter 0.5s ease;
  }

  .hp38-tile:hover .hp38-tile__image {
    filter: grayscale(0%);
    transform: scale(1.05);
  }

  .hp38-tile__overlay {
    position: absolute;
    inset: 0;
    padding: 20px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: linear-gradient(to top, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0) 50%);
  }

  .hp38-tile__meta {
    font-family: var(--font-heading);
    font-size: 12px;
    color: #fff;
    align-self: flex-start;
    padding: 5px 10px;
    border: 1px solid #fff;
    background: rgba(0,0,0,0.5);
  }

  .hp38-tile__title {
    font-family: var(--font-heading);
    font-size: 32px;
    color: #fff;
    margin: 0;
    text-transform: uppercase;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp38-tiles-wrapper" id="HP38Tiles-{{ section.id }}">
  <div class="hp38-tiles__header">
    <h2 class="hp38-tiles__title">{{ section.settings.title }}</h2>
  </div>

  <div class="hp38-tiles__grid">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.link | default: '#' }}" class="hp38-tile" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title | escape }}" class="hp38-tile__image" loading="lazy">
        {%- else -%}
          {%- assign placeholder = 'collection-' | append: forloop.index -%}
          {%- if forloop.index > 6 -%}{%- assign placeholder = 'collection-1' -%}{%- endif -%}
          {{ placeholder | placeholder_svg_tag: 'hp38-tile__image' }}
        {%- endif -%}
        
        <div class="hp38-tile__overlay">
          <div class="hp38-tile__meta">DIR:0{{ forloop.index }}</div>
          <h3 class="hp38-tile__title">{{ block.settings.title }}</h3>
        </div>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "HP38 - Brutalist Tiles",
  "class": "section-hp38-category-tiles",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "DIRECTORIES"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 48
    },
    {
      "type": "header",
      "content": "Brutalist Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text & Grid Lines",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#0000FF"
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Category Tile",
      "limit": 6,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "EQUIPMENT"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP38 - Brutalist Tiles",
      "blocks": [
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" }
      ]
    }
  ]
}
{% endschema %}
