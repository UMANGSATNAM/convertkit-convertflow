{%- comment -%}
  PC V3 — EDITORIAL LUXURY HIGH-END SERIF PRODUCT GRID
  Design: Warm Cream (#FDFBF7), Olive Gold (#8A7335) accents, Playfair Display & Plus Jakarta Sans typography
  Card Shape: Elegant 2px corners, warm subtle borders, editorial slide-up CTA
{%- endcomment -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');

  .pcv3 {
    --bg: {{ section.settings.bg_color | default: '#FDFBF7' }};
    --card-bg: {{ section.settings.card_bg | default: '#FFFFFF' }};
    --text: {{ section.settings.text_color | default: '#1F1E1B' }};
    --muted: {{ section.settings.muted_color | default: '#78756E' }};
    --accent: {{ section.settings.accent_color | default: '#8A7335' }};
    --accent-hover: {{ section.settings.accent_hover | default: '#6E5B28' }};
    --border: {{ section.settings.border_color | default: '#EFEBE4' }};
    --badge-sale-bg: #8A7335;
    --badge-sale-text: #FFFFFF;
    --f-serif: 'Playfair Display', Georgia, serif;
    --f-sans: 'Plus Jakarta Sans', sans-serif;
    --r-card: 2px;
    --ease: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    background-color: var(--bg);
    color: var(--text);
    font-family: var(--f-sans);
    padding: {{ section.settings.padding_top | default: 60 }}px 0 {{ section.settings.padding_bottom | default: 60 }}px 0;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }

  .pcv3 *, .pcv3 *::before, .pcv3 *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .pcv3 a { color: inherit; text-decoration: none; }
  .pcv3 button { font-family: inherit; cursor: pointer; border: none; background: none; }
  .pcv3 img { max-width: 100%; display: block; }

  .pcv3__wrap { max-width: 1280px; margin: 0 auto; padding: 0 24px; }

  /* HEADER */
  .pcv3__head { display: flex; flex-direction: column; gap: 12px; margin-bottom: 40px; text-align: {{ section.settings.header_align | default: 'center' }}; }
  @media (min-width: 768px) {
    .pcv3__head { display: flex; flex-direction: row; justify-content: space-between; align-items: flex-end; }
  }
  .pcv3__title { font-family: var(--f-serif); font-size: 32px; font-weight: 600; color: var(--text); letter-spacing: -0.01em; font-style: italic; }
  @media (min-width: 768px) { .pcv3__title { font-size: 42px; } }
  .pcv3__sub { font-size: 15px; color: var(--muted); font-weight: 400; }
  .pcv3__viewall { display: inline-flex; align-items: center; gap: 8px; font-weight: 600; font-size: 13px; text-transform: uppercase; letter-spacing: 0.12em; color: var(--accent); transition: var(--ease); border-bottom: 1px solid var(--accent); padding-bottom: 2px; }
  .pcv3__viewall:hover { color: var(--accent-hover); border-color: var(--accent-hover); }

  /* GRID */
  .pcv3__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr);
    gap: 20px;
  }
  @media (min-width: 640px) {
    .pcv3__grid { grid-template-columns: repeat({{ section.settings.cols_tablet | default: 3 }}, 1fr); gap: 28px; }
  }
  @media (min-width: 1024px) {
    .pcv3__grid { grid-template-columns: repeat({{ section.settings.cols_desktop | default: 4 }}, 1fr); gap: 32px; }
  }

  /* CARD */
  .pcv3__card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--r-card);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    position: relative;
    transition: var(--ease);
  }
  .pcv3__card:hover {
    box-shadow: 0 16px 32px -8px rgba(138, 115, 53, 0.08);
    border-color: #D9D2C5;
  }

  /* IMAGE BOX */
  .pcv3__img-box {
    position: relative;
    width: 100%;
    aspect-ratio: {{ section.settings.img_ratio | default: '4/5' }};
    background: #F4F1EA;
    overflow: hidden;
  }
  .pcv3__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .pcv3__img--sec {
    position: absolute;
    top: 0; left: 0;
    opacity: 0;
  }
  .pcv3__card:hover .pcv3__img--pri {
    {% if section.settings.enable_sec_img %}
      opacity: 0;
    {% else %}
      transform: scale(1.05);
    {% endif %}
  }
  .pcv3__card:hover .pcv3__img--sec { opacity: 1; transform: scale(1.05); }

  /* BADGES */
  .pcv3__badges { position: absolute; top: 14px; left: 14px; display: flex; flex-direction: column; gap: 6px; z-index: 2; pointer-events: none; }
  .pcv3__badge { font-size: 10px; font-weight: 600; text-transform: uppercase; padding: 5px 10px; border-radius: 1px; letter-spacing: 0.1em; font-family: var(--f-sans); }
  .pcv3__badge--sale { background: var(--badge-sale-bg); color: var(--badge-sale-text); }
  .pcv3__badge--tag { background: #1F1E1B; color: #FFFFFF; }
  .pcv3__badge--sold { background: #9EA0A5; color: #FFFFFF; }

  /* WISHLIST BUTTON */
  .pcv3__wish {
    position: absolute;
    top: 14px; right: 14px;
    width: 36px; height: 36px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(4px);
    display: flex; align-items: center; justify-content: center;
    color: #78756E;
    z-index: 3;
    transition: var(--ease);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
  }
  .pcv3__wish:hover { background: #FFFFFF; color: var(--accent); transform: scale(1.08); }
  .pcv3__wish.active { color: var(--accent); background: #FFFFFF; }

  /* QUICK ADD HOVER */
  .pcv3__quick-box {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    z-index: 3;
    transform: translateY(100%);
    opacity: 0;
    transition: var(--ease);
  }
  .pcv3__card:hover .pcv3__quick-box { transform: translateY(0); opacity: 1; }
  @media (max-width: 767px) {
    .pcv3__quick-box { transform: translateY(0); opacity: 1; position: relative; bottom: auto; left: auto; right: auto; padding: 0 16px 16px; }
  }

  .pcv3__quick-btn {
    width: 100%;
    padding: 13px 16px;
    background: var(--text);
    color: #FFFFFF;
    font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.15em;
    font-family: var(--f-sans);
    display: flex; align-items: center; justify-content: center; gap: 8px;
    transition: var(--ease);
  }
  .pcv3__quick-btn:hover { background: var(--accent); }
  .pcv3__quick-btn:disabled { background: #D9D2C5; color: #78756E; cursor: not-allowed; }

  /* CARD CONTENT */
  .pcv3__content { padding: 18px; display: flex; flex-direction: column; gap: 8px; flex-grow: 1; text-align: center; }

  .pcv3__vendor { font-size: 10px; text-transform: uppercase; color: var(--muted); font-weight: 600; letter-spacing: 0.12em; }
  .pcv3__item-title { font-family: var(--f-serif); font-size: 17px; font-weight: 500; color: var(--text); line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .pcv3__item-title:hover { color: var(--accent); }

  /* RATING */
  .pcv3__rating { display: flex; align-items: center; justify-content: center; gap: 6px; font-size: 11px; color: var(--accent); }
  .pcv3__stars { letter-spacing: 2px; }
  .pcv3__rev-cnt { color: var(--muted); font-weight: 400; font-size: 11px; }

  /* PRICE */
  .pcv3__price-row { display: flex; align-items: baseline; justify-content: center; gap: 10px; margin-top: auto; padding-top: 4px; }
  .pcv3__price { font-size: 16px; font-weight: 600; color: var(--text); font-family: var(--f-sans); }
  .pcv3__cmp-price { font-size: 13px; color: var(--muted); text-decoration: line-through; }

  /* SWATCHES */
  .pcv3__swatches { display: flex; gap: 8px; align-items: center; justify-content: center; margin-top: 4px; }
  .pcv3__swatch { width: 12px; height: 12px; border-radius: 50%; border: 1px solid #EFEBE4; cursor: pointer; transition: var(--ease); }
  .pcv3__swatch:hover, .pcv3__swatch.active { transform: scale(1.25); border-color: var(--accent); }

  /* URGENCY MICRO */
  .pcv3__urgency { font-size: 11px; color: var(--accent); font-weight: 500; font-style: italic; font-family: var(--f-serif); display: flex; align-items: center; justify-content: center; gap: 4px; margin-top: 2px; }

  /* TOAST */
  .pcv3__toast {
    position: fixed; bottom: 24px; right: 24px;
    background: #1F1E1B; color: #FFFFFF;
    padding: 14px 24px; border-radius: 2px;
    font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em;
    font-family: var(--f-sans);
    z-index: 9999;
    transform: translateY(100px); opacity: 0;
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.15);
  }
  .pcv3__toast.show { transform: translateY(0); opacity: 1; }
</style>

<div class="pcv3">
  <div class="pcv3__wrap">
    
    {% if section.settings.title != blank or section.settings.subheading != blank %}
      <div class="pcv3__head">
        <div>
          {% if section.settings.title != blank %}
            <h2 class="pcv3__title">{{ section.settings.title | escape }}</h2>
          {% endif %}
          {% if section.settings.subheading != blank %}
            <p class="pcv3__sub">{{ section.settings.subheading | escape }}</p>
          {% endif %}
        </div>
        {% if section.settings.show_view_all and section.settings.collection != blank %}
          <a href="{{ collections[section.settings.collection].url }}" class="pcv3__viewall">
            {{ section.settings.view_all_label | default: 'View Collection' }} &rarr;
          </a>
        {% endif %}
      </div>
    {% endif %}

    <div class="pcv3__grid">
      {% assign target_coll = collections[section.settings.collection] %}
      {% assign limit_num = section.settings.products_per_page | default: 8 %}

      {% if target_coll != blank and target_coll.products.size > 0 %}
        {% for product in target_coll.products limit: limit_num %}
          {% assign current_variant = product.selected_or_first_available_variant %}
          
          {% render 'card-v3', product: product, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v3', product: nil, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% endif %}
    </div>

  </div>
</div>

<div class="pcv3__toast" id="pcv3-toast">Added to Shopping Bag</div>

<script>
(function(){
  // Wishlist is handled globally by assets/wishlist.js (shared store: cf_wishlist_items).
  // Buttons are rendered by snippets/wishlist-button.liquid — no per-section storage.


  document.querySelectorAll('[data-pcv3-add]').forEach(function(btn){
    btn.addEventListener('click', function(e){
      e.preventDefault(); e.stopPropagation();
      var id = btn.dataset.pcv3Add, orig = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = 'Processing...';

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: id, quantity: 1 })
      })
      .then(function(r){ return r.json(); })
      .then(function(){
        btn.innerHTML = 'Added';
        showT('Added to Shopping Bag');
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      })
      .catch(function(){
        btn.innerHTML = 'Error';
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      });
    });
  });

  function showT(msg){
    var t = document.getElementById('pcv3-toast');
    if(!t) return;
    t.textContent = msg;
    t.classList.add('show');
    setTimeout(function(){ t.classList.remove('show'); }, 3000);
  }
})();
</script>

