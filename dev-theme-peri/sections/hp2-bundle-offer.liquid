{%- liquid
  assign bg_color = section.settings.bg_color | default: '#000000'
  assign text_color = section.settings.text_color | default: '#ffffff'
  assign card_bg = section.settings.card_bg | default: '#1a1a1a'
  
  assign padding_top_desktop = section.settings.padding_top_desktop
  assign padding_bottom_desktop = section.settings.padding_bottom_desktop
  assign padding_top_mobile = section.settings.padding_top_mobile
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile
  
  assign product_1 = all_products[section.settings.product_1]
  assign product_2 = all_products[section.settings.product_2]
-%}

<style>
  #shopify-section-{{ section.id }} {
    --hp2-bund-bg: {{ bg_color }};
    --hp2-bund-text: {{ text_color }};
    --hp2-bund-card: {{ card_bg }};
    
    --hp2-bund-pt-desk: {{ padding_top_desktop }}px;
    --hp2-bund-pb-desk: {{ padding_bottom_desktop }}px;
    --hp2-bund-pt-mob: {{ padding_top_mobile }}px;
    --hp2-bund-pb-mob: {{ padding_bottom_mobile }}px;
  }

  .hp2-fashion-bundle-{{ section.id }} {
    padding-top: var(--hp2-bund-pt-desk);
    padding-bottom: var(--hp2-bund-pb-desk);
    background-color: var(--hp2-bund-bg);
    color: var(--hp2-bund-text);
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
  }

  .hp2-bund-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    align-items: center;
    gap: 60px;
  }

  /* Image Side */
  .hp2-bund-img-col {
    flex: 1;
    position: relative;
  }
  
  .hp2-bund-img-wrapper {
    width: 100%;
    aspect-ratio: 4/5;
    background: var(--hp2-bund-card);
    position: relative;
    overflow: hidden;
  }
  
  .hp2-bund-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hp2-bund-badge {
    position: absolute;
    top: 20px;
    left: 20px;
    background: var(--hp2-bund-text);
    color: var(--hp2-bund-bg);
    padding: 10px 20px;
    font-size: 14px;
    font-weight: 900;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  /* Content Side */
  .hp2-bund-txt-col {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .hp2-bund-title {
    font-size: clamp(32px, 4vw, 56px);
    font-weight: 900;
    text-transform: uppercase;
    line-height: 1;
    margin: 0 0 15px 0;
    letter-spacing: -1px;
  }

  .hp2-bund-desc {
    font-size: 16px;
    line-height: 1.5;
    margin-bottom: 40px;
    opacity: 0.8;
  }

  /* Product Items */
  .hp2-bund-products {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-bottom: 40px;
  }

  .hp2-bund-item {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 20px;
    background: var(--hp2-bund-card);
    border: 1px solid rgba(255,255,255,0.1);
  }

  .hp2-bund-item-img {
    width: 80px;
    height: 100px;
    object-fit: cover;
    background: #333;
  }

  .hp2-bund-item-info {
    flex: 1;
  }

  .hp2-bund-item-title {
    font-size: 16px;
    font-weight: 800;
    text-transform: uppercase;
    margin: 0 0 5px 0;
  }

  .hp2-bund-item-price {
    font-size: 14px;
    font-weight: 500;
    color: #999;
  }

  /* Plus icon */
  .hp2-bund-plus {
    display: flex;
    justify-content: center;
    font-size: 24px;
    font-weight: 300;
    margin: -5px 0;
  }

  /* Total & CTA */
  .hp2-bund-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 2px solid var(--hp2-bund-text);
    padding-top: 20px;
  }

  .hp2-bund-total-lbl {
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 1px;
    opacity: 0.7;
    margin-bottom: 5px;
  }

  .hp2-bund-total-val {
    font-size: 24px;
    font-weight: 900;
  }

  .hp2-bund-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 40px;
    background: var(--hp2-bund-text);
    color: var(--hp2-bund-bg);
    text-decoration: none;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: transform 0.3s ease;
  }
  .hp2-bund-btn:hover {
    transform: translateY(-3px);
  }

  @media screen and (max-width: 991px) {
    .hp2-bund-inner {
      flex-direction: column;
      gap: 40px;
    }
    .hp2-bund-img-col, .hp2-bund-txt-col {
      width: 100%;
    }
  }

  @media screen and (max-width: 768px) {
    .hp2-fashion-bundle-{{ section.id }} {
      padding-top: var(--hp2-bund-pt-mob);
      padding-bottom: var(--hp2-bund-pb-mob);
    }
    .hp2-bund-inner {
      padding: 0 20px;
    }
    .hp2-bund-footer {
      flex-direction: column;
      align-items: stretch;
      gap: 20px;
      text-align: center;
    }
    .hp2-bund-btn {
      width: 100%;
    }
  }
</style>

<section class="hp2-fashion-bundle-{{ section.id }}" aria-label="Curated Outfit Bundle">
  <div class="hp2-bund-inner">
    
    <div class="hp2-bund-img-col">
      <div class="hp2-bund-img-wrapper">
        {%- if section.settings.main_image != blank -%}
          <img src="{{ section.settings.main_image | image_url: width: 1000 }}" 
               srcset="{{ section.settings.main_image | image_url: width: 600 }} 600w, 
                       {{ section.settings.main_image | image_url: width: 1000 }} 1000w"
               sizes="(max-width: 991px) 100vw, 50vw"
               class="hp2-bund-img" 
               loading="lazy" 
               alt="{{ section.settings.main_image.alt | default: 'Lookbook Outfit' }}">
        {%- else -%}
          {{ 'collection-3' | placeholder_svg_tag: 'hp2-bund-img placeholder-svg' }}
        {%- endif -%}
        
        {%- if section.settings.badge_text != blank -%}
          <div class="hp2-bund-badge">{{ section.settings.badge_text }}</div>
        {%- endif -%}
      </div>
    </div>

    <div class="hp2-bund-txt-col">
      <h2 class="hp2-bund-title">{{ section.settings.heading | default: 'THE STUDIO SET' }}</h2>
      <p class="hp2-bund-desc">{{ section.settings.description | default: 'Perfectly paired items for a complete look. Buy together and save.' }}</p>
      
      <div class="hp2-bund-products">
        {%- comment -%} Product 1 {%- endcomment -%}
        <div class="hp2-bund-item">
          {%- if product_1 != blank -%}
            <img src="{{ product_1.featured_image | image_url: width: 200 }}" class="hp2-bund-item-img" alt="{{ product_1.title }}">
            <div class="hp2-bund-item-info">
              <h3 class="hp2-bund-item-title">{{ product_1.title }}</h3>
              <span class="hp2-bund-item-price">{{ product_1.price | money }}</span>
            </div>
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'hp2-bund-item-img placeholder-svg' }}
            <div class="hp2-bund-item-info">
              <h3 class="hp2-bund-item-title">Select Product 1</h3>
              <span class="hp2-bund-item-price">$--.--</span>
            </div>
          {%- endif -%}
        </div>

        <div class="hp2-bund-plus">+</div>

        {%- comment -%} Product 2 {%- endcomment -%}
        <div class="hp2-bund-item">
          {%- if product_2 != blank -%}
            <img src="{{ product_2.featured_image | image_url: width: 200 }}" class="hp2-bund-item-img" alt="{{ product_2.title }}">
            <div class="hp2-bund-item-info">
              <h3 class="hp2-bund-item-title">{{ product_2.title }}</h3>
              <span class="hp2-bund-item-price">{{ product_2.price | money }}</span>
            </div>
          {%- else -%}
            {{ 'product-2' | placeholder_svg_tag: 'hp2-bund-item-img placeholder-svg' }}
            <div class="hp2-bund-item-info">
              <h3 class="hp2-bund-item-title">Select Product 2</h3>
              <span class="hp2-bund-item-price">$--.--</span>
            </div>
          {%- endif -%}
        </div>
      </div>

      <div class="hp2-bund-footer">
        <div class="hp2-bund-total">
          <div class="hp2-bund-total-lbl">Bundle Total</div>
          <div class="hp2-bund-total-val">
            {%- if product_1 != blank and product_2 != blank -%}
              {%- assign total = product_1.price | plus: product_2.price -%}
              {{ total | money }}
            {%- else -%}
              $0.00
            {%- endif -%}
          </div>
        </div>
        <a href="{{ section.settings.btn_link | default: '#' }}" class="hp2-bund-btn">
          {{ section.settings.btn_label | default: 'SHOP THE LOOK' }}
        </a>
      </div>

    </div>

  </div>
</section>

{% schema %}
{
  "name": "HP2 Shop The Look Bundle",
  "tag": "section",
  "class": "section-hp2-bundle",
  "settings": [
    {
      "type": "header",
      "content": "Image & Content"
    },
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Lookbook Image"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "BUNDLE & SAVE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "THE STUDIO SET"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Perfectly paired items for a complete look. Buy together and save."
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "product",
      "id": "product_1",
      "label": "Product 1"
    },
    {
      "type": "product",
      "id": "product_2",
      "label": "Product 2"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "SHOP THE LOOK"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Product Card Background",
      "default": "#1a1a1a"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Top (Desktop)", "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Bottom (Desktop)", "default": 100
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Top (Mobile)", "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Bottom (Mobile)", "default": 60
    }
  ],
  "presets": [
    {
      "name": "HP2 Outfit Bundle (Advanced)",
      "category": "Product"
    }
  ]
}
{% endschema %}
