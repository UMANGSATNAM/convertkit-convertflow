{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400;1,600&family=Oswald:wght@300;400;500&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --border-color: {{ section.settings.border_color }};
    
    --font-serif: 'Playfair Display', serif;
    --font-sans: 'Oswald', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    border-bottom: 1px solid var(--border-color);
  }

  .hp36-tiles-wrapper {
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp36-tiles-wrapper {
      padding: 0 20px;
    }
  }

  .hp36-tiles__header {
    margin-bottom: 50px;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
  }

  .hp36-tiles__title {
    font-family: var(--font-serif);
    font-size: clamp(40px, 6vw, {{ section.settings.title_size }}px);
    line-height: 1;
    color: var(--text-color);
    margin: 0;
    text-transform: uppercase;
  }
  
  .hp36-tiles__title em {
    font-style: italic;
    text-transform: lowercase;
  }

  .hp36-tiles__subtitle {
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--text-color);
    text-transform: uppercase;
    letter-spacing: 0.2em;
  }

  .hp36-tiles__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: minmax(400px, auto);
    gap: 1px;
    background-color: var(--border-color);
    border: 1px solid var(--border-color);
  }

  @media screen and (max-width: 992px) {
    .hp36-tiles__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media screen and (max-width: 768px) {
    .hp36-tiles__grid {
      grid-template-columns: 1fr;
    }
  }

  .hp36-tile {
    position: relative;
    background: var(--bg-color);
    text-decoration: none;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    group: card;
  }

  /* Make the first tile span 2 columns if on large screens */
  @media screen and (min-width: 993px) {
    .hp36-tile:nth-child(1) {
      grid-column: span 2;
      grid-row: span 2;
    }
  }

  .hp36-tile__image-wrap {
    flex: 1;
    position: relative;
    overflow: hidden;
  }

  .hp36-tile__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%);
    transition: filter 0.5s ease, transform 1s ease;
  }

  .hp36-tile:hover .hp36-tile__image {
    filter: grayscale(0%);
    transform: scale(1.05);
  }

  .hp36-tile__content {
    padding: 30px;
    border-top: 1px solid var(--border-color);
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--bg-color);
    z-index: 2;
  }

  .hp36-tile__title {
    font-family: var(--font-serif);
    font-size: 24px;
    color: var(--text-color);
    margin: 0;
    text-transform: uppercase;
  }

  .hp36-tile__link {
    font-family: var(--font-sans);
    font-size: 12px;
    color: var(--text-color);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .hp36-tile__link svg {
    width: 16px; height: 16px;
    fill: currentColor;
    transition: transform 0.3s ease;
  }

  .hp36-tile:hover .hp36-tile__link svg {
    transform: translateX(5px);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp36-tiles-wrapper" id="HP36Tiles-{{ section.id }}">
  <div class="hp36-tiles__header">
    <h2 class="hp36-tiles__title">{{ section.settings.title | replace: 'Collections', '<em>Collections</em>' }}</h2>
    {%- if section.settings.subtitle != blank -%}
      <div class="hp36-tiles__subtitle">{{ section.settings.subtitle }}</div>
    {%- endif -%}
  </div>

  <div class="hp36-tiles__grid">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.link | default: '#' }}" class="hp36-tile" {{ block.shopify_attributes }}>
        <div class="hp36-tile__image-wrap">
          {%- if block.settings.image != blank -%}
            <img height="{{ block.settings.image.height }}" width="{{ block.settings.image.width }}" src="{{ block.settings.image | image_url: width: 1200 }}" alt="{{ block.settings.title | escape }}" class="hp36-tile__image" loading="lazy">
          {%- else -%}
            {%- assign placeholder = 'collection-' | append: forloop.index -%}
            {%- if forloop.index > 6 -%}{%- assign placeholder = 'collection-1' -%}{%- endif -%}
            {{ placeholder | placeholder_svg_tag: 'hp36-tile__image' }}
          {%- endif -%}
        </div>
        
        <div class="hp36-tile__content">
          <h3 class="hp36-tile__title">{{ block.settings.title }}</h3>
          <div class="hp36-tile__link">
            Explore <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" fill="none"/></svg>
          </div>
        </div>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "HP36 - Editorial Tiles",
  "class": "section-hp36-category-tiles",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Curated Collections"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "THE DIRECTORY"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 40,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 80
    },
    {
      "type": "header",
      "content": "Editorial Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Category Tile",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Editorial"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP36 - Editorial Tiles",
      "blocks": [
        { "type": "tile", "settings": { "title": "Runway" } },
        { "type": "tile", "settings": { "title": "Essentials" } },
        { "type": "tile", "settings": { "title": "Accessories" } },
        { "type": "tile", "settings": { "title": "Footwear" } }
      ]
    }
  ]
}
{% endschema %}
