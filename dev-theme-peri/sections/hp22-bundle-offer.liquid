{%- style -%}
  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --btn-bg: {{ section.settings.btn_bg }};
    --btn-text: {{ section.settings.btn_text_color }};
    --card-bg: {{ section.settings.card_bg }};
    --font-heading: 'Lora', serif;
    --font-body: 'Outfit', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    position: relative;
    overflow: hidden;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }

  /* Organic grain texture overlay */
  {% if section.settings.show_grain %}
  #shopify-section-{{ section.id }}::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    opacity: 0.04;
    pointer-events: none;
    z-index: 1;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
  }
  {% endif %}

  .hp22-bundle-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
    position: relative;
    z-index: 2;
  }

  @media screen and (max-width: 768px) {
    .hp22-bundle-wrapper {
      padding: 0 20px;
    }
  }

  .hp22-bundle__container {
    display: flex;
    background-color: var(--card-bg);
    border-radius: 40px;
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(0,0,0,0.03);
    flex-direction: {% if section.settings.layout == 'image_right' %}row{% else %}row-reverse{% endif %};
  }

  @media screen and (max-width: 992px) {
    .hp22-bundle__container {
      flex-direction: column;
      border-radius: 24px;
    }
  }

  /* Image Column */
  .hp22-bundle__image-col {
    flex: 1;
    position: relative;
    min-height: 400px;
    background: #EAE3D9;
  }

  @media screen and (max-width: 992px) {
    .hp22-bundle__image-col {
      min-height: 350px;
    }
  }

  .hp22-bundle__image {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hp22-bundle__badge {
    position: absolute;
    top: 30px;
    {% if section.settings.layout == 'image_right' %}left: 30px;{% else %}right: 30px;{% endif %}
    background: var(--bg-color);
    color: var(--accent-color);
    width: 90px;
    height: 90px;
    border-radius: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    box-shadow: 0 10px 20px rgba(0,0,0,0.1);
    transform: rotate(-10deg);
    z-index: 2;
  }

  .hp22-bundle__badge-text {
    font-family: var(--font-body);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 2px;
  }

  .hp22-bundle__badge-price {
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 400;
  }

  /* Text Column */
  .hp22-bundle__text-col {
    flex: 1;
    padding: 60px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  @media screen and (max-width: 992px) {
    .hp22-bundle__text-col {
      padding: 40px 30px;
      text-align: center;
    }
  }

  .hp22-bundle__subtitle {
    font-family: var(--font-body);
    font-size: {{ section.settings.subtitle_size }}px;
    font-weight: 400;
    letter-spacing: 2px;
    color: var(--accent-color);
    text-transform: uppercase;
    margin: 0 0 16px;
  }

  .hp22-bundle__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 4vw, {{ section.settings.title_size }}px);
    font-weight: 400;
    line-height: 1.15;
    color: var(--text-color);
    margin: 0 0 24px;
  }
  
  .hp22-bundle__title em {
    font-style: italic;
    color: var(--accent-color);
  }

  .hp22-bundle__text {
    font-family: var(--font-body);
    font-size: {{ section.settings.text_size }}px;
    font-weight: 300;
    line-height: 1.6;
    color: var(--text-color);
    opacity: 0.8;
    margin: 0 0 32px;
  }

  /* Bundle Items List */
  .hp22-bundle__items {
    list-style: none;
    padding: 0;
    margin: 0 0 40px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .hp22-bundle__item {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  @media screen and (max-width: 992px) {
    .hp22-bundle__item {
      justify-content: center;
      text-align: left;
    }
  }

  .hp22-bundle__item-icon {
    width: 24px;
    height: 24px;
    color: var(--accent-color);
    flex-shrink: 0;
  }

  .hp22-bundle__item-icon svg {
    width: 100%;
    height: 100%;
    fill: currentColor;
  }

  .hp22-bundle__item-text {
    font-family: var(--font-body);
    font-size: 16px;
    color: var(--text-color);
    font-weight: 400;
  }

  /* Price & Button */
  .hp22-bundle__footer {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  @media screen and (max-width: 992px) {
    .hp22-bundle__footer {
      flex-direction: column;
      gap: 16px;
    }
  }

  .hp22-bundle__prices {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }

  .hp22-bundle__price-regular {
    font-family: var(--font-body);
    font-size: 16px;
    color: var(--text-color);
    opacity: 0.5;
    text-decoration: line-through;
  }

  .hp22-bundle__price-sale {
    font-family: var(--font-heading);
    font-size: 28px;
    color: var(--accent-color);
  }

  .hp22-bundle__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 40px;
    background: var(--btn-bg);
    color: var(--btn-text);
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 15px;
    letter-spacing: 1px;
    text-decoration: none;
    border-radius: 40px; /* Pill */
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
  }

  .hp22-bundle__btn:hover {
    background: var(--text-color);
    color: var(--card-bg);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp22-bundle-wrapper" id="HP22BundleOffer-{{ section.id }}">
  <div class="hp22-bundle__container">
    
    <div class="hp22-bundle__image-col">
      {%- if section.settings.show_badge -%}
      <div class="hp22-bundle__badge">
        <span class="hp22-bundle__badge-text">{{ section.settings.badge_text | escape }}</span>
        <span class="hp22-bundle__badge-price">{{ section.settings.badge_price | escape }}</span>
      </div>
      {%- endif -%}

      {%- if section.settings.image != blank -%}
        <img height="{{ section.settings.image.height }}" width="{{ section.settings.image.width }}" src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.title | escape }}" class="hp22-bundle__image" loading="lazy">
      {%- else -%}
        <div style="width:100%;height:100%;background:#DCD2C6;display:flex;align-items:center;justify-content:center;color:#8A9A86;">BUNDLE IMAGE</div>
      {%- endif -%}
    </div>

    <div class="hp22-bundle__text-col">
      {%- if section.settings.subtitle != blank -%}
        <div class="hp22-bundle__subtitle">{{ section.settings.subtitle | escape }}</div>
      {%- endif -%}
      
      {%- if section.settings.title != blank -%}
        <h2 class="hp22-bundle__title">{{ section.settings.title }}</h2>
      {%- endif -%}
      
      {%- if section.settings.text != blank -%}
        <div class="hp22-bundle__text">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="hp22-bundle__items">
          {%- for block in section.blocks -%}
            <li class="hp22-bundle__item" {{ block.shopify_attributes }}>
              <div class="hp22-bundle__item-icon">
                <svg viewBox="0 0 24 24"><path d="M12 2C6.5 2 2 6.5 2 12S6.5 22 12 22 22 17.5 22 12 17.5 2 12 2M10 17L5 12L6.41 10.59L10 14.17L17.59 6.58L19 8L10 17Z"/></svg>
              </div>
              <span class="hp22-bundle__item-text">{{ block.settings.text | escape }}</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      <div class="hp22-bundle__footer">
        <div class="hp22-bundle__prices">
          {%- if section.settings.price_regular != blank -%}
            <span class="hp22-bundle__price-regular">{{ section.settings.price_regular | escape }}</span>
          {%- endif -%}
          {%- if section.settings.price_sale != blank -%}
            <span class="hp22-bundle__price-sale">{{ section.settings.price_sale | escape }}</span>
          {%- endif -%}
        </div>
        
        {%- if section.settings.btn_text != blank -%}
          <button type="button" class="hp22-bundle__btn" onclick="window.location.href='{{ section.settings.btn_link | default: '#' }}'">
            {{ section.settings.btn_text | escape }}
          </button>
        {%- endif -%}
      </div>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "HP22 - Organic Bundle",
  "class": "section-hp22-bundle-offer",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Image Position (Desktop)",
      "options": [
        { "value": "image_left", "label": "Image Left" },
        { "value": "image_right", "label": "Image Right" }
      ],
      "default": "image_left"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1200
    },
    {
      "type": "header",
      "content": "Image & Badge"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Bundle Image"
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show Saving Badge",
      "default": true
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "SAVE"
    },
    {
      "type": "text",
      "id": "badge_price",
      "label": "Badge Amount",
      "default": "$25"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "THE COMPLETE RITUAL"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Heading",
      "default": "<p>Daily <em>Glow</em> Essentials</p>"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Body Text",
      "default": "Everything you need to nourish, protect, and revitalize your skin naturally."
    },
    {
      "type": "text",
      "id": "price_regular",
      "label": "Regular Price",
      "default": "$150.00"
    },
    {
      "type": "text",
      "id": "price_sale",
      "label": "Sale Price",
      "default": "$125.00"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "ADD BUNDLE TO CART"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 42
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Subtitle Size",
      "default": 14
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Text Size",
      "default": 16
    },
    {
      "type": "header",
      "content": "Organic Styling"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#F9F6F0"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#3A3A3A"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#8A9A86"
    },
    {
      "type": "color",
      "id": "btn_bg",
      "label": "Button Background",
      "default": "#8A9A86"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Button Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "checkbox",
      "id": "show_grain",
      "label": "Show subtle paper grain texture",
      "default": true
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Bundle Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Item Description",
          "default": "Purifying Botanical Cleanser (4oz)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP22 - Organic Bundle",
      "blocks": [
        { "type": "item", "settings": { "text": "Purifying Botanical Cleanser (4oz)" } },
        { "type": "item", "settings": { "text": "Rosewater Hydrating Mist (2oz)" } },
        { "type": "item", "settings": { "text": "Antioxidant Face Oil (1oz)" } }
      ]
    }
  ]
}
{% endschema %}
