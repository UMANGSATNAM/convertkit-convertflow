{%- style -%}
  #shopify-section-{{ section.id }} {
    background: linear-gradient(180deg, #0A1628 0%, #060D17 100%);
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }
  .hp54-news__container { max-width: {{ section.settings.container_width | default: 700 }}px; margin: 0 auto; padding: 0 24px; text-align: center; }
  .hp54-news__eyebrow { font-family: 'Inter', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: {{ section.settings.accent_color | default: '#60A5FA' }}; margin: 0 0 16px; }
  .hp54-news__heading { font-family: 'Tenor Sans', serif; font-size: clamp(28px, 4vw, 44px); color: #FFFFFF; margin: 0 0 16px; }
  .hp54-news__desc { font-size: 15px; line-height: 1.7; color: #94A3B8; margin: 0 0 32px; }
  .hp54-news__form { display: flex; gap: 12px; max-width: 480px; margin: 0 auto; }
  .hp54-news__input {
    flex: 1; padding: 14px 20px; background: #111D33; border: 1px solid rgba(59, 130, 246, 0.3);
    border-radius: 8px; color: #FFFFFF; font-family: 'Inter', sans-serif; font-size: 14px;
  }
  .hp54-news__input::placeholder { color: #64748B; }
  .hp54-news__btn {
    padding: 14px 28px; background: {{ section.settings.btn_bg | default: '#3B82F6' }};
    color: #FFFFFF; border: none; border-radius: 8px; font-family: 'Inter', sans-serif;
    font-size: 13px; font-weight: 700; cursor: pointer; transition: all 0.3s ease;
    box-shadow: 0 4px 16px rgba(59, 130, 246, 0.3);
  }
  .hp54-news__btn:hover { box-shadow: 0 8px 25px rgba(59, 130, 246, 0.5); transform: translateY(-2px); }
  @media screen and (max-width: 480px) { .hp54-news__form { flex-direction: column; } }
{%- endstyle -%}
<div class="hp54-news__container">
  {%- if section.settings.eyebrow != blank -%}<p class="hp54-news__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
  <h2 class="hp54-news__heading">{{ section.settings.heading | default: 'Enter the Midnight Circle' }}</h2>
  <p class="hp54-news__desc">{{ section.settings.description | default: 'Receive private invitations to nocturnal formula launches, private consultations, and member-only pricing.' }}</p>
  {%- form 'customer', id: 'hp54-newsletter' -%}
    <input type="hidden" name="contact[tags]" value="newsletter">
    <div class="hp54-news__form">
      <input type="email" name="contact[email]" class="hp54-news__input" placeholder="{{ section.settings.placeholder | default: 'Enter your email' }}" required>
      <button type="submit" class="hp54-news__btn">{{ section.settings.btn_label | default: 'Join Circle' }}</button>
    </div>
  {%- endform -%}
</div>
{% schema %}
{
  "name": "HP54 Newsletter",
  "class": "section-hp54-news",
  "settings": [
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#60A5FA" },
    { "type": "color", "id": "btn_bg", "label": "Button BG", "default": "#3B82F6" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "◆ PRIVATE ACCESS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Enter the Midnight Circle" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Receive private invitations to nocturnal formula launches." },
    { "type": "text", "id": "placeholder", "label": "Placeholder", "default": "Enter your email" },
    { "type": "text", "id": "btn_label", "label": "Button Label", "default": "Join Circle" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 500, "max": 900, "step": 20, "unit": "px", "label": "Container Width", "default": 700 }
  ],
  "presets": [{ "name": "HP54 - Sapphire Newsletter" }]
}
{% endschema %}
