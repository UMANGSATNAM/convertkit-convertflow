  .elite-sticky-price-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .elite-sticky-price {
    font-size: 14px;
    font-weight: 800;
    color: var(--ep-text-main);
  }
  .elite-sticky-badge {
    font-size: 11px;
    font-weight: 600;
    color: var(--ep-success);
    background: #ecfdf5;
    padding: 1px 6px;
    border-radius: 4px;
  }
  .elite-sticky-btn {
    background: #0f172a;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 10px 24px;
    font-size: 13px;
    font-weight: 800;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 8px;
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.2);
