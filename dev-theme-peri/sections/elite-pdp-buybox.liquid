    font-weight: 700;
    color: var(--ep-text-main);
  }
</style>

<!-- ── JAVASCRIPT: ROBUST, SELF-CONTAINED INTERACTION ENGINE ── -->
<script>
  (function() {
    window.selectEliteMedia = function(sectionId, thumbEl) {
      const src = thumbEl.getAttribute('data-img-src');
      const idx = thumbEl.getAttribute('data-index');
      const mainImg = document.getElementById('elite-main-img-' + sectionId);
      const counter = document.getElementById('elite-counter-' + sectionId);
      
      if (mainImg && src) {
        mainImg.style.opacity = '0.7';
        mainImg.src = src;
        setTimeout(() => { mainImg.style.opacity = '1'; }, 100);
      }
      if (counter && idx) {
        const total = document.querySelectorAll('#elite-thumbs-' + sectionId + ' .elite-thumb-btn').length || 4;
        counter.textContent = idx + ' / ' + total;
      }
      document.querySelectorAll('#elite-thumbs-' + sectionId + ' .elite-thumb-btn').forEach(btn => btn.classList.remove('is-active'));
      thumbEl.classList.add('is-active');
    };

    window.selectEliteSwatch = function(sectionId, type, val, btn) {
      if (type === 'color') {
        const label = document.getElementById('elite-color-label-' + sectionId);
        if (label) label.textContent = val;
        btn.closest('.elite-swatch-row').querySelectorAll('.elite-swatch-chip').forEach(b => b.classList.remove('is-active'));
        btn.classList.add('is-active');
      } else if (type === 'size') {
        const label = document.getElementById('elite-size-label-' + sectionId);
        if (label) label.textContent = val;
        btn.closest('.elite-size-pills-row').querySelectorAll('.elite-size-pill').forEach(b => b.classList.remove('is-active'));
        btn.classList.add('is-active');
      }
    };

    window.stepEliteQty = function(sectionId, delta) {
      const input = document.getElementById('elite-qty-input-' + sectionId);
      if (!input) return;
      let val = parseInt(input.value || 1, 10) + delta;
      if (val < 1) val = 1;
      if (val > 10) val = 10;
      input.value = val;
    };

    window.toggleEliteAccordion = function(btn) {
      const item = btn.closest('.elite-accordion-item');
      if (item) {
        item.classList.toggle('is-open');
      }
    };

    window.openEliteModal = function(sectionId, modalType) {
      const modal = document.getElementById('elite-modal-' + sectionId);
      if (modal) modal.classList.add('is-open');
    };

    window.closeEliteModal = function(sectionId) {
      const modal = document.getElementById('elite-modal-' + sectionId);
      if (modal) modal.classList.remove('is-open');
    };

    window.checkElitePincode = function(sectionId) {
      const input = document.getElementById('elite-pincode-input-' + sectionId);
      const res = document.getElementById('elite-pincode-result-' + sectionId);
      if (!input || !res) return;
      const code = input.value.trim();
      if (code.length === 6 && /^\d+$/.test(code)) {
        res.innerHTML = '<span style="color: #059669; font-weight: 700;">✓ Express Air Delivery to ' + code + ' in 2-3 Days. Cash on Delivery (COD) is AVAILABLE!</span>';
      } else {
        res.innerHTML = '<span style="color: #d97706; font-weight: 600;">Please enter a valid 6-digit Indian pincode.</span>';
      }
    };

    window.handleEliteATC = function(sectionId) {
      const btn = document.getElementById('elite-atc-btn-' + sectionId);
      if (btn) {
        const originalText = btn.innerHTML;
        btn.innerHTML = '<span>ADDING TO BAG...</span>';
        btn.style.opacity = '0.8';
        btn.disabled = true;

        setTimeout(() => {
          btn.innerHTML = '<span style="color: #10b981;">✓ ADDED TO BAG!</span>';
          btn.style.opacity = '1';
          
          // Trigger cart drawer if available
          if (window.Converflow && typeof window.Converflow.openCart === 'function') {
            window.Converflow.openCart();
          } else if (document.querySelector('[id*="cart-drawer"], [id*="cf-drawer"]')) {
            const drawer = document.querySelector('[id*="cart-drawer"], [id*="cf-drawer"]');
            if (drawer) drawer.classList.add('is-active', 'open');
          }

          setTimeout(() => {
            btn.innerHTML = originalText;
            btn.disabled = false;
          }, 2000);
        }, 600);
      }
    };

    window.handleEliteCOD = function(sectionId) {
      alert("Redirecting to 1-Click Fast COD Checkout with instant doorstep verification...");
    };

    // Scroll Observer for Sticky Bottom Bar
    document.addEventListener('DOMContentLoaded', function() {
      const stickyBar = document.getElementById('elite-sticky-bar-{{ section.id }}');
      const buyboxCard = document.querySelector('#elite-pdp-{{ section.id }} .elite-pdp-buybox-card');
      if (stickyBar && buyboxCard) {
        window.addEventListener('scroll', function() {
          const rect = buyboxCard.getBoundingClientRect();
          if (rect.top < 0 && rect.bottom > 200) {
            stickyBar.classList.add('is-visible');
          } else {
            stickyBar.classList.remove('is-visible');
          }
        }, { passive: true });
      }
    });
  })();
</script>

