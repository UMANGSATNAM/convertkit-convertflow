{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign has_real_product = false
  if product and product.title != blank
    assign has_real_product = true
  endif

  assign fallback_title = section.settings.fallback_title | default: "The Signature Cashmere Overcoat"
  assign fallback_price = section.settings.fallback_price | default: 499900
  assign fallback_compare = section.settings.fallback_compare | default: 899900

  if has_real_product
    assign p_title = product.title
    assign p_vendor = product.vendor | default: "Atelier Reserve"
    assign p_price = current_variant.price
    assign p_compare = current_variant.compare_at_price
    assign p_sku = current_variant.sku | default: "AR-1000-01"
  else
    assign p_title = fallback_title
    assign p_vendor = section.settings.brand_label | default: "Atelier Reserve"
    assign p_price = fallback_price
    assign p_compare = fallback_compare
    assign p_sku = "AR-LUX-001"
  endif

  assign savings_amount = 0
  assign savings_percent = 0
  if p_compare and p_compare > p_price
    assign savings_amount = p_compare | minus: p_price
    assign savings_percent = savings_amount | times: 100 | divided_by: p_compare
  endif
-%}

<section 
  id="elite-pdp-{{ section.id }}" 
  class="elite-pdp-section"
  data-section-id="{{ section.id }}"
  style="
    --ep-bg: {{ section.settings.bg_color | default: '#ffffff' }};
    --ep-surface: {{ section.settings.card_bg | default: '#ffffff' }};
    --ep-text-main: {{ section.settings.text_color | default: '#0f172a' }};
    --ep-text-muted: {{ section.settings.text_muted | default: '#64748b' }};
    --ep-border: {{ section.settings.border_color | default: '#e2e8f0' }};
    --ep-accent: {{ section.settings.accent_color | default: '#0f172a' }};
    --ep-success: {{ section.settings.success_color | default: '#059669' }};
    --ep-urgency: {{ section.settings.urgency_color | default: '#d97706' }};
    --ep-radius: {{ section.settings.corner_radius | default: 12 }}px;
    padding-top: {{ section.settings.padding_top | default: 48 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 64 }}px;
  "
>
  <div class="elite-pdp-wrapper">
    
    <!-- ── LEFT COLUMN: STICKY LUXURY GALLERY ── -->
    <div class="elite-pdp-gallery-col">
      <div class="elite-pdp-gallery-sticky">
        
        <!-- Main Focal Image -->
        <div class="elite-pdp-main-image-container">
          <!-- Overlays -->
          <div class="elite-pdp-badge-overlay-left">
            <span class="elite-badge-pill elite-badge-gold">
              <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              {{ section.settings.gallery_badge | default: "FLAGSHIP EDITION" }}
            </span>
            {%- if savings_percent > 0 -%}
              <span class="elite-badge-pill elite-badge-emerald">
                SAVE {{ savings_percent }}% OFF
              </span>
            {%- endif -%}
          </div>

          <div class="elite-pdp-badge-overlay-right">
            <span class="elite-img-counter" id="elite-counter-{{ section.id }}">1 / 4</span>
          </div>

          <!-- Featured Image Display -->
          {%- if has_real_product and product.featured_media -%}
            <img 
              id="elite-main-img-{{ section.id }}"
              src="{{ product.featured_media | image_url: width: 1200 }}" 
              alt="{{ product.title | escape }}"
              width="600"
              height="750"
              loading="eager"
              class="elite-main-image"
            />
          {%- else -%}
            <img 
              id="elite-main-img-{{ section.id }}"
              src="https://images.unsplash.com/photo-1539571696357-5a69c17a67c6?auto=format&fit=crop&w=1000&q=85" 
              alt="Luxury Cashmere Overcoat Editorial"
              width="600"
              height="750"
              loading="eager"
              class="elite-main-image"
            />
          {%- endif -%}
        </div>

        <!-- Thumbnails Strip -->
        <div class="elite-pdp-thumbs" id="elite-thumbs-{{ section.id }}">
          {%- if has_real_product and product.media.size > 0 -%}
            {%- for media in product.media -%}
              <button 
                type="button" 
                class="elite-thumb-btn {% if forloop.first %}is-active{% endif %}"
                data-img-src="{{ media | image_url: width: 1200 }}"
                data-index="{{ forloop.index }}"
                onclick="window.selectEliteMedia('{{ section.id }}', this)"
                aria-label="View product image {{ forloop.index }}"
              >
                <img src="{{ media | image_url: width: 160, height: 200, crop: 'center' }}" alt="{{ media.alt | default: product.title }}" loading="lazy" />
              </button>
            {%- endfor -%}
          {%- else -%}
            <!-- Fallback Luxury Thumbnails -->
            <button type="button" class="elite-thumb-btn is-active" data-img-src="https://images.unsplash.com/photo-1539571696357-5a69c17a67c6?auto=format&fit=crop&w=1000&q=85" data-index="1" onclick="window.selectEliteMedia('{{ section.id }}', this)">
              <img src="https://images.unsplash.com/photo-1539571696357-5a69c17a67c6?auto=format&fit=crop&w=160&h=200&q=80" alt="View 1" />
            </button>
            <button type="button" class="elite-thumb-btn" data-img-src="https://images.unsplash.com/photo-1485230895905-ec40ba36b9bc?auto=format&fit=crop&w=1000&q=85" data-index="2" onclick="window.selectEliteMedia('{{ section.id }}', this)">
              <img src="https://images.unsplash.com/photo-1485230895905-ec40ba36b9bc?auto=format&fit=crop&w=160&h=200&q=80" alt="View 2" />
            </button>
            <button type="button" class="elite-thumb-btn" data-img-src="https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?auto=format&fit=crop&w=1000&q=85" data-index="3" onclick="window.selectEliteMedia('{{ section.id }}', this)">
              <img src="https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?auto=format&fit=crop&w=160&h=200&q=80" alt="View 3" />
            </button>
            <button type="button" class="elite-thumb-btn" data-img-src="https://images.unsplash.com/photo-1509631179647-0177331693ae?auto=format&fit=crop&w=1000&q=85" data-index="4" onclick="window.selectEliteMedia('{{ section.id }}', this)">
              <img src="https://images.unsplash.com/photo-1509631179647-0177331693ae?auto=format&fit=crop&w=160&h=200&q=80" alt="View 4" />
            </button>
          {%- endif -%}
        </div>

      </div>
    </div>

    <!-- ── RIGHT COLUMN: HIGH-AOV BUY BOX ── -->
    <div class="elite-pdp-buybox-col">
      <div class="elite-pdp-buybox-card">

        <!-- Top Micro Brand Bar & Rating -->
        <div class="elite-header-row">
          <div class="elite-brand-capsule">
            <span class="elite-brand-dot"></span>
            <span class="elite-brand-name">{{ p_vendor }}</span>
            <span class="elite-sku-text">SKU: {{ p_sku }}</span>
          </div>

          <!-- Social Proof Rating -->
          <div class="elite-rating-badge" title="4.9 out of 5 based on 2,840+ verified customer reviews">
            <div class="elite-stars-wrap">
              {%- for i in (1..5) -%}
                <svg width="13" height="13" viewBox="0 0 24 24" fill="#d97706"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              {%- endfor -%}
            </div>
            <span class="elite-rating-score">{{ section.settings.rating_score | default: "4.9" }}</span>
            <span class="elite-rating-count">({{ section.settings.rating_count | default: "2,840+" }} Verified)</span>
          </div>
        </div>

        <!-- Title -->
        <h1 class="elite-product-title">{{ p_title }}</h1>

        <!-- Editorial Subtitle / Tagline -->
        <p class="elite-product-tagline">
          {{ section.settings.tagline | default: "Tailored from pure Grade-A Mongolian cashmere with structured drop-shoulders and bespoke horn buttons." }}
        </p>

        <!-- Pricing Band -->
        <div class="elite-pricing-box">
          <div class="elite-price-main-wrap">
            <span class="elite-current-price" id="elite-price-{{ section.id }}">
              {%- if has_real_product -%}
                {{ p_price | money }}
              {%- else -%}
                ₹4,999
              {%- endif -%}
            </span>

            {%- if p_compare and p_compare > p_price -%}
              <span class="elite-compare-price" id="elite-compare-{{ section.id }}">
                {%- if has_real_product -%}
                  {{ p_compare | money }}
                {%- else -%}
                  ₹8,999
                {%- endif -%}
              </span>
              <span class="elite-savings-pill">
                SAVE ₹3,000 (44% OFF)
              </span>
            {%- endif -%}
          </div>

          <div class="elite-price-microcopy">
            <span class="elite-check-icon">✓</span>
            <span>Taxes included. Free express air shipping on all prepaid & COD orders.</span>
          </div>
        </div>

        <!-- ── LIVE SCARCITY & URGENCY METER ── -->
        {%- if section.settings.show_scarcity -%}
          <div class="elite-scarcity-container">
            <div class="elite-scarcity-header">
              <div class="elite-pulse-dot-wrap">
                <span class="elite-pulse-ring"></span>
                <span class="elite-pulse-core"></span>
              </div>
              <span class="elite-scarcity-text">
                <strong>High Demand:</strong> Only <span class="elite-stock-num">4 items</span> left in stock for instant dispatch.
              </span>
            </div>
            <div class="elite-scarcity-progress-bar">
              <div class="elite-scarcity-progress-fill" style="width: 82%;"></div>
            </div>
            <div class="elite-scarcity-footer">
              <span>🔥 38 shoppers are looking at this item right now</span>
              <span>82% Claimed</span>
            </div>
          </div>
        {%- endif -%}

        <!-- ── VARIANT SELECTORS ── -->
        <div class="elite-options-container">
          
          <!-- Color Swatches -->
          <div class="elite-option-group">
            <div class="elite-option-header">
              <span class="elite-option-label">Color:</span>
              <span class="elite-option-value-selected" id="elite-color-label-{{ section.id }}">Obsidian Black</span>
            </div>
            <div class="elite-swatch-row">
              <button 
                type="button" 
                class="elite-swatch-chip is-active" 
                data-color="Obsidian Black"
                data-color-hex="#0f172a"
                onclick="window.selectEliteSwatch('{{ section.id }}', 'color', 'Obsidian Black', this)"
              >
                <span class="elite-swatch-dot" style="background: #0f172a;"></span>
                <span>Obsidian Black</span>
              </button>

              <button 
                type="button" 
                class="elite-swatch-chip" 
                data-color="Camel Beige"
                data-color-hex="#c2a278"
                onclick="window.selectEliteSwatch('{{ section.id }}', 'color', 'Camel Beige', this)"
              >
                <span class="elite-swatch-dot" style="background: #c2a278;"></span>
                <span>Camel Beige</span>
              </button>

              <button 
                type="button" 
                class="elite-swatch-chip" 
                data-color="Pure Ivory"
                data-color-hex="#f1ece1"
                onclick="window.selectEliteSwatch('{{ section.id }}', 'color', 'Pure Ivory', this)"
              >
                <span class="elite-swatch-dot" style="background: #f1ece1; border: 1px solid #cbd5e1;"></span>
                <span>Pure Ivory</span>
              </button>
            </div>
          </div>

          <!-- Size Selector with Size Guide -->
          <div class="elite-option-group" style="margin-top: 18px;">
            <div class="elite-option-header">
              <div>
                <span class="elite-option-label">Size:</span>
                <span class="elite-option-value-selected" id="elite-size-label-{{ section.id }}">M (Slim Fit)</span>
              </div>
              <button type="button" class="elite-size-guide-trigger" onclick="window.openEliteModal('{{ section.id }}', 'size-guide')">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 3H3v18h18V3zM3 9h18M9 21V9"/></svg>
                <span>Size Guide</span>
              </button>
            </div>
            <div class="elite-size-pills-row">
              {%- assign sizes = "XS,S,M,L,XL,XXL" | split: "," -%}
              {%- for sz in sizes -%}
                <button 
                  type="button" 
                  class="elite-size-pill {% if sz == 'M' %}is-active{% endif %}"
                  data-size="{{ sz }}"
                  onclick="window.selectEliteSwatch('{{ section.id }}', 'size', '{{ sz }}', this)"
                >
                  {{ sz }}
                  {%- if sz == 'M' -%}
                    <span class="elite-size-badge-hot">Popular</span>
                  {%- endif -%}
                </button>
              {%- endfor -%}
            </div>
          </div>

        </div>

        <!-- ── QUANTITY & ACTION BUTTONS ── -->
        <div class="elite-actions-block">
          <div class="elite-qty-and-atc-row">
            
            <!-- Tactile Quantity Stepper -->
            <div class="elite-qty-box">
              <button type="button" class="elite-qty-btn" onclick="window.stepEliteQty('{{ section.id }}', -1)" aria-label="Decrease quantity">−</button>
              <input type="number" id="elite-qty-input-{{ section.id }}" class="elite-qty-input" value="1" min="1" max="10" readonly />
              <button type="button" class="elite-qty-btn" onclick="window.stepEliteQty('{{ section.id }}', 1)" aria-label="Increase quantity">+</button>
            </div>

            <!-- Primary Add to Bag CTA -->
            <button 
              type="button" 
              class="elite-atc-btn" 
              id="elite-atc-btn-{{ section.id }}"
              onclick="window.handleEliteATC('{{ section.id }}')"
            >
              <span class="elite-btn-text">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4zM3 6h18M16 10a4 4 0 01-8 0"/></svg>
                <span>ADD TO BAG</span>
              </span>
              <span class="elite-btn-separator">•</span>
              <span class="elite-btn-price" id="elite-atc-price-{{ section.id }}">
                {%- if has_real_product -%}{{ p_price | money }}{%- else -%}₹4,999{%- endif -%}
              </span>
            </button>
          </div>

          <!-- Secondary 1-Click Fast Checkout / COD Button -->
          {%- if section.settings.show_cod_btn -%}
            <button 
              type="button" 
              class="elite-cod-btn"
              onclick="window.handleEliteCOD('{{ section.id }}')"
            >
              <div class="elite-cod-left">
                <span class="elite-bolt-icon">⚡</span>
                <div style="text-align: left;">
                  <div style="font-size: 13px; font-weight: 800; letter-spacing: 0.02em;">BUY WITH CASH ON DELIVERY</div>
                  <div style="font-size: 11px; opacity: 0.85; font-weight: 500;">Pay at your doorstep • Free Express Shipping</div>
                </div>
              </div>
              <div class="elite-cod-arrow">→</div>
            </button>
          {%- endif -%}
        </div>

        <!-- ── PINCODE DELIVERY ESTIMATOR ── -->
        {%- if section.settings.show_pincode -%}
          <div class="elite-pincode-card">
            <div class="elite-pincode-header">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#0f172a" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
              <span>Check Delivery & COD Availability</span>
            </div>
            <div class="elite-pincode-input-row">
              <input 
                type="text" 
                id="elite-pincode-input-{{ section.id }}" 
                class="elite-pincode-input" 
                placeholder="Enter 6-digit Pincode (e.g. 110001)"
                maxlength="6"
              />
              <button type="button" class="elite-pincode-submit" onclick="window.checkElitePincode('{{ section.id }}')">
                Check
              </button>
            </div>
            <div class="elite-pincode-result" id="elite-pincode-result-{{ section.id }}">
              <span class="elite-pincode-status">⚡ Enter pincode to view guaranteed delivery date</span>
            </div>
          </div>
        {%- endif -%}

        <!-- ── 4 LUXURY TRUST PILLARS ── -->
        <div class="elite-trust-grid">
          <div class="elite-trust-item">
            <div class="elite-trust-icon-box">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            </div>
            <div>
              <div class="elite-trust-title">Free Express Air</div>
              <div class="elite-trust-sub">Dispatched in 24 Hours</div>
            </div>
          </div>

          <div class="elite-trust-item">
            <div class="elite-trust-icon-box">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <div>
              <div class="elite-trust-title">100% Certified</div>
              <div class="elite-trust-sub">Pure Mongolian Cashmere</div>
            </div>
          </div>

          <div class="elite-trust-item">
            <div class="elite-trust-icon-box">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 11-2.12-9.36L23 10"/></svg>
            </div>
            <div>
              <div class="elite-trust-title">15-Day Exchange</div>
              <div class="elite-trust-sub">Doorstep Hassle-Free</div>
            </div>
          </div>

          <div class="elite-trust-item">
            <div class="elite-trust-icon-box">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
            </div>
            <div>
              <div class="elite-trust-title">Encrypted Checkout</div>
              <div class="elite-trust-sub">UPI • Cards • COD</div>
            </div>
          </div>
        </div>

        <!-- ── EDITORIAL COLLAPSIBLE ACCORDIONS ── -->
        <div class="elite-accordions-group">
          
          <div class="elite-accordion-item is-open">
            <button type="button" class="elite-accordion-header" onclick="window.toggleEliteAccordion(this)">
              <div class="elite-accordion-title-wrap">
                <span class="elite-accordion-bullet">✦</span>
                <span class="elite-accordion-title">Craftsmanship & Highlights</span>
              </div>
              <span class="elite-accordion-icon">+</span>
            </button>
            <div class="elite-accordion-body">
              <p>Hand-tailored from select double-faced Grade-A cashmere yarns sourced from the high plateaus of Inner Mongolia. Each garment undergoes a 36-stage hand-pressing procedure to impart a drape that is soft, sculptured, and entirely weightless.</p>
              <ul class="elite-bullet-list">
                <li>100% sustainable Mongolian virgin cashmere (480 GSM)</li>
                <li>Genuine polished horn buttons sourced ethically</li>
                <li>Interior bespoke welt pocket designed for smartphone & cardholder</li>
                <li>Hand-finished bound seams that sit flush against tailored layers</li>
              </ul>
            </div>
          </div>

          <div class="elite-accordion-item">
            <button type="button" class="elite-accordion-header" onclick="window.toggleEliteAccordion(this)">
              <div class="elite-accordion-title-wrap">
                <span class="elite-accordion-bullet">✦</span>
                <span class="elite-accordion-title">Fit & Silhouette Specs</span>
              </div>
              <span class="elite-accordion-icon">+</span>
            </button>
            <div class="elite-accordion-body">
              <p>Modern relaxed silhouette engineered to drape effortlessly over an oversized hoodie, knit turtleneck, or structured suit jacket. True to size. Take your standard size for an intentional modern drape, or size down for a slimmer sartorial fit.</p>
            </div>
          </div>

          <div class="elite-accordion-item">
            <button type="button" class="elite-accordion-header" onclick="window.toggleEliteAccordion(this)">
              <div class="elite-accordion-title-wrap">
                <span class="elite-accordion-bullet">✦</span>
                <span class="elite-accordion-title">Shipping, COD & Returns</span>
              </div>
              <span class="elite-accordion-icon">+</span>
            </button>
            <div class="elite-accordion-body">
              <p>Complimentary express air delivery within 48 to 72 business hours across India & major global metros. Cash on Delivery (COD) available with OTP doorstep verification. Try at home with our complimentary 15-day exchange and return policy.</p>
            </div>
          </div>

        </div>

      </div>
    </div>

  </div>

  <!-- ── FLOATING STICKY ATC BAR ON SCROLL ── -->
  <div class="elite-sticky-bar" id="elite-sticky-bar-{{ section.id }}">
    <div class="elite-sticky-inner">
      <div class="elite-sticky-left">
        {%- if has_real_product and product.featured_media -%}
          <img src="{{ product.featured_media | image_url: width: 100 }}" alt="" class="elite-sticky-thumb" />
        {%- else -%}
          <img src="https://images.unsplash.com/photo-1539571696357-5a69c17a67c6?auto=format&fit=crop&w=100&q=80" alt="" class="elite-sticky-thumb" />
        {%- endif -%}
        <div>
          <div class="elite-sticky-title">{{ p_title }}</div>
          <div class="elite-sticky-price-row">
            <span class="elite-sticky-price">{%- if has_real_product -%}{{ p_price | money }}{%- else -%}₹4,999{%- endif -%}</span>
            <span class="elite-sticky-badge">In Stock • Express Air</span>
          </div>
        </div>
      </div>

      <div class="elite-sticky-right">
        <button type="button" class="elite-sticky-btn" onclick="window.handleEliteATC('{{ section.id }}')">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4zM3 6h18M16 10a4 4 0 01-8 0"/></svg>
          <span>ADD TO BAG</span>
        </button>
      </div>
    </div>
  </div>

  <!-- ── SIZE GUIDE MODAL ── -->
  <div class="elite-modal-backdrop" id="elite-modal-{{ section.id }}" onclick="if(event.target === this) window.closeEliteModal('{{ section.id }}')">
    <div class="elite-modal-card">
      <div class="elite-modal-header">
        <h3 class="elite-modal-title">Bespoke Size & Fit Guide</h3>
        <button type="button" class="elite-modal-close" onclick="window.closeEliteModal('{{ section.id }}')">✕</button>
      </div>
