  /* ── Modal Backdrop & Dialog ── */
  .elite-modal-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.6);
    backdrop-filter: blur(4px);
    z-index: 10000;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }
  .elite-modal-backdrop.is-open {
    display: flex;
  }
  .elite-modal-card {
    background: #ffffff;
    border-radius: 16px;
    max-width: 600px;
    width: 100%;
    padding: 24px 28px;
    box-shadow: 0 25px 50px -12px rgba(15, 23, 42, 0.25);
    animation: eliteModalIn 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @keyframes eliteModalIn {
    from { opacity: 0; transform: scale(0.96) translateY(10px); }
    to { opacity: 1; transform: scale(1) translateY(0); }
  }
  .elite-modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
    padding-bottom: 12px;
