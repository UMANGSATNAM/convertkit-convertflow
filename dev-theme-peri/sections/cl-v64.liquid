{% comment %} CL V64 — Magic / Astrology (Deep Purple/Gold) {% endcomment %}
{{ 'component-facets.css' | asset_url | stylesheet_tag }}
<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
<style>
  .clv64 { background: {{ section.settings.bg_color | default: '#150A21' }}; color: {{ section.settings.text_color | default: '#EAE0D5' }}; padding: 50px 20px; font-family: 'Cinzel', serif; }
  .clv64-hero { text-align: center; margin-bottom: 50px; padding: 60px 20px; border: 1px solid #D4AF37; position: relative; background: radial-gradient(circle at center, #2A1542 0%, #150A21 100%); }
  .clv64-hero::before { content: '✧ ✦ ✧'; position: absolute; top: 15px; font-size: 20px; color: #D4AF37; }
  .clv64-hero::after { content: '✧ ✦ ✧'; position: absolute; bottom: 15px; font-size: 20px; color: #D4AF37; }
  .clv64-hero h1 { font-size: 48px; font-weight: normal; color: #D4AF37; margin-bottom: 15px; letter-spacing: 4px; }
  .clv64-hero p { font-size: 14px; color: #EAE0D5; max-width: 500px; margin: 0 auto; line-height: 1.8; letter-spacing: 1px; font-family: 'Montserrat', sans-serif; }
  .clv64-chips { display: flex; gap: 20px; justify-content: center; margin-bottom: 40px; flex-wrap: wrap; }
  .clv64-chips a { padding: 5px 0; color: #EAE0D5; text-decoration: none; font-size: 12px; font-family: 'Montserrat', sans-serif; text-transform: uppercase; letter-spacing: 2px; border-bottom: 1px solid transparent; transition: 0.3s; }
  .clv64-chips a:hover, .clv64-chips a.active { color: #D4AF37; border-bottom: 1px solid #D4AF37; }
  .clv64-toolbar { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(212, 175, 55, 0.3); padding-bottom: 15px; margin-bottom: 40px; }
  .clv64-grid { display: grid; grid-template-columns: repeat({{ section.settings.cols_desktop | default: 4 }}, 1fr); gap: 30px; }
  .clv64-promo { grid-column: span 1; background: #2A1542; color: #D4AF37; border: 1px solid #D4AF37; padding: 40px; text-align: center; display: flex; flex-direction: column; justify-content: center; align-items: center; }
  .clv64-promo h3 { font-size: 24px; font-weight: normal; margin-bottom: 20px; letter-spacing: 2px; line-height: 1.4; }
  .clv64-promo a { display: inline-block; padding: 10px 25px; background: transparent; color: #D4AF37; text-decoration: none; font-size: 12px; font-family: 'Montserrat', sans-serif; text-transform: uppercase; letter-spacing: 1px; border: 1px solid #D4AF37; transition: 0.3s; }
  .clv64-promo a:hover { background: #D4AF37; color: #150A21; }
  .clv64-seo { margin-top: 60px; text-align: center; padding: 40px; background: #2A1542; border: 1px solid #D4AF37; }
  @media (max-width: 768px) { .clv64-grid { grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr); gap: 15px; } .clv64-hero h1 { font-size: 32px; } }
</style>
<div class="clv64" style="max-width: 1200px; margin: 0 auto;">
  <div class="clv64-hero">
    <h1>{% if collection.title != blank %}{{ collection.title | escape }}{% else %}ASTRAL VISIONS{% endif %}</h1>
    <p>{% if collection.description != blank %}{{ collection.description }}{% else %}Discover tools aligned with the cosmos for your spiritual journey.{% endif %}</p>
  </div>
  {% if section.settings.sub_collections != blank %}
    <div class="clv64-chips">
      {% for link in section.settings.sub_collections.links %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% endfor %}
    </div>
  {% endif %}
  <div class="clv64-toolbar">
    <facet-filters-form style="width: 100%;">
      <form id="FacetFiltersForm" style="display: flex; justify-content: space-between; align-items: center; width: 100%; flex-wrap: wrap; gap: 20px;">
        <div style="display: flex; gap: 30px;">
          {%- for filter in collection.filters -%}
            <details style="position: relative;">
              <summary style="cursor: pointer; font-size: 12px; font-family: 'Montserrat', sans-serif; text-transform: uppercase; letter-spacing: 2px; color: #D4AF37;">{{ filter.label }} ✧</summary>
              <div style="position: absolute; background: #2A1542; border: 1px solid #D4AF37; padding: 20px; z-index: 10; margin-top: 15px; min-width: 220px; box-shadow: 0 5px 20px rgba(0,0,0,0.5);">
                {%- for value in filter.values -%}
                  <label style="display: block; margin-bottom: 12px; cursor: pointer; font-size: 13px; color: #EAE0D5; font-family: 'Montserrat', sans-serif;">
                    <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} style="accent-color: #D4AF37;">
                    {{ value.label }} <span style="font-size: 11px; color: #D4AF37;">({{ value.count }})</span>
                  </label>
                {%- endfor -%}
              </div>
            </details>
          {%- endfor -%}
        </div>
        <select name="sort_by" onchange="this.form.submit()" style="background: transparent; border: none; font-family: 'Montserrat', sans-serif; font-size: 12px; text-transform: uppercase; letter-spacing: 2px; color: #D4AF37; cursor: pointer; outline: none;">
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>
          {%- endfor -%}
        </select>
      </form>
    </facet-filters-form>
  </div>
  {% assign limit_num = section.settings.products_per_page | default: 16 %}
  {% paginate collection.products by limit_num %}
    <div class="clv64-grid">
      {% for product in collection.products %}
        {% render 'card-v64', product: product %}
        {% if forloop.index == 8 and section.settings.show_promo_tile %}
          <div class="clv64-promo">
            <h3>TAROT<br>READINGS</h3>
            <a href="/pages/readings">BOOK NOW</a>
          </div>
        {% endif %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v64', product: nil %}
        {% endfor %}
      {% endfor %}
    </div>
    <div style="margin-top: 50px; text-align: center; font-size: 16px; color: #D4AF37;">{{ paginate | default_pagination }}</div>
  {% endpaginate %}
  {% if section.settings.show_seo_block %}
    <div class="clv64-seo">
      <h2 style="font-size: 22px; font-weight: normal; color: #D4AF37; margin-bottom: 15px; letter-spacing: 2px;">{{ section.settings.seo_title | default: 'ETHICALLY SOURCED' }}</h2>
      <p style="font-size: 13px; font-family: 'Montserrat', sans-serif; color: #EAE0D5; max-width: 600px; margin: 0 auto; line-height: 1.8; letter-spacing: 1px;">{{ section.settings.seo_text | default: 'All crystals and herbs are sustainably gathered with respect for the earth and its energies.' }}</p>
    </div>
  {% endif %}
</div>
{% schema %}
{
  "name": "CL V64 — Magic", "settings": [
    {"type": "range", "id": "products_per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 16},
    {"type": "range", "id": "cols_desktop", "label": "Desktop Columns", "min": 2, "max": 5, "default": 4},
    {"type": "select", "id": "cols_mobile", "label": "Mobile Columns", "options": [{"value": "1", "label": "1"}, {"value": "2", "label": "2"}], "default": "2"},
    {"type": "link_list", "id": "sub_collections", "label": "Sub-Collection Menu"},
    {"type": "checkbox", "id": "show_promo_tile", "label": "Show Promo Card", "default": true},
    {"type": "checkbox", "id": "show_seo_block", "label": "Show SEO Block", "default": true},
    {"type": "color", "id": "bg_color", "label": "Background Color", "default": "#150A21"},
    {"type": "color", "id": "text_color", "label": "Text Color", "default": "#EAE0D5"}
  ], "presets": [{"name": "CL V64 — Magic"}]
}
{% endschema %}
