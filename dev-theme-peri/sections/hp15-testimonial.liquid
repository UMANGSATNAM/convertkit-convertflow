{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#ffffff'
  assign text_color = section.settings.text_color | default: '#000000'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 150px 40px;
    color: {{ text_color }};
    text-align: center;
  }
  
  .hp15-testimonial-container-{{ section_id }} {
    max-width: 900px;
    margin: 0 auto;
  }
  
  .hp15-testimonial-quote-{{ section_id }} {
    font-family: 'Didot', 'Playfair Display', serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-style: italic;
    line-height: 1.3;
    margin: 0 0 50px 0;
  }
  
  .hp15-testimonial-author-{{ section_id }} {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.75rem;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 3px;
  }
  
  .hp15-testimonial-publication-{{ section_id }} {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    opacity: 0.6;
    margin-top: 5px;
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 80px 20px;
    }
  }
</style>

<div class="hp15-testimonial-container-{{ section_id }}">
  <blockquote class="hp15-testimonial-quote-{{ section_id }}">
    "{{ section.settings.quote | default: 'A masterclass in restraint. They have completely redefined what modern luxury looks and feels like.' }}"
  </blockquote>
  
  <div class="hp15-testimonial-author-{{ section_id }}">
    {{ section.settings.author | default: 'VOGUE PARIS' }}
  </div>
  {% if section.settings.publication != blank %}
    <div class="hp15-testimonial-publication-{{ section_id }}">
      {{ section.settings.publication }}
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "HP15 Testimonial",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Quote",
      "default": "A masterclass in restraint. They have completely redefined what modern luxury looks and feels like."
    },
    {
      "type": "text",
      "id": "author",
      "label": "Author/Publication",
      "default": "VOGUE PARIS"
    },
    {
      "type": "text",
      "id": "publication",
      "label": "Secondary Text (Date/Issue)"
    }
  ],
  "presets": [
    {
      "name": "HP15 Testimonial"
    }
  ]
}
{% endschema %}
