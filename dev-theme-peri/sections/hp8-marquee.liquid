{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#f4f4f4'
  assign text_color = section.settings.text_color | default: '#000000'
  assign speed = section.settings.speed | default: 20
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    color: {{ text_color }};
    padding: 30px 0;
    overflow: hidden;
    border-bottom: 1px solid rgba(0,0,0,0.05);
  }
  
  .hp8-marquee-wrapper-{{ section_id }} {
    display: flex;
    white-space: nowrap;
    position: relative;
  }
  
  .hp8-marquee-content-{{ section_id }} {
    display: flex;
    animation: hp8-marquee-scroll-{{ section_id }} {{ speed }}s linear infinite;
  }
  
  .hp8-marquee-item-{{ section_id }} {
    display: flex;
    align-items: center;
    padding: 0 40px;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: 2px;
    text-transform: uppercase;
  }
  
  .hp8-marquee-item-{{ section_id }} svg {
    margin-right: 40px;
    width: 24px;
    height: 24px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }
  
  @keyframes hp8-marquee-scroll-{{ section_id }} {
    0% { transform: translateX(0); }
    100% { transform: translateX(-100%); }
  }
</style>

<div class="hp8-marquee-wrapper-{{ section_id }}">
  <!-- We output the content twice for a seamless infinite loop -->
  {% for i in (1..2) %}
    <div class="hp8-marquee-content-{{ section_id }}">
      {% for block in section.blocks %}
        <div class="hp8-marquee-item-{{ section_id }}" {{ block.shopify_attributes }}>
          <svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
          {{ block.settings.text }}
        </div>
      {% endfor %}
    </div>
  {% endfor %}
</div>

{% schema %}
{
  "name": "HP8 Marquee",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f4f4f4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 10,
      "max": 50,
      "step": 2,
      "unit": "s",
      "label": "Animation Speed",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text Block",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "LUXURY REDEFINED"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP8 Marquee",
      "blocks": [
        { "type": "text", "settings": { "text": "PARIS" } },
        { "type": "text", "settings": { "text": "MILAN" } },
        { "type": "text", "settings": { "text": "LONDON" } },
        { "type": "text", "settings": { "text": "NEW YORK" } }
      ]
    }
  ]
}
{% endschema %}
