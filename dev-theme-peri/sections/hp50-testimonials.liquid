{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp50-test-bg: {{ section.settings.bg_color | default: '#000000' }};
    
    background-color: var(--hp50-test-bg);
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }

  .hp50-test__wrap {
    max-width: {{ section.settings.container_width | default: 1240 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp50-test__header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 50px;
  }

  .hp50-test__heading {
    font-family: 'Italiana', serif;
    font-size: clamp(34px, 4.5vw, 48px);
    font-weight: 400;
    color: #FFFFFF;
    margin: 0 0 8px;
    letter-spacing: 1px;
  }

  .hp50-test__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: 3 }}, 1fr);
    gap: 24px;
  }

  .hp50-test__card {
    background: #111111;
    border: 1px solid rgba(226, 232, 240, 0.2);
    padding: 36px 28px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
  }

  .hp50-test__stars {
    color: #FFFFFF;
    font-size: 16px;
    margin-bottom: 16px;
    letter-spacing: 2px;
  }

  .hp50-test__quote {
    font-size: 14px;
    line-height: 1.8;
    color: #E2E8F0;
    margin: 0 0 24px;
    font-style: italic;
  }

  .hp50-test__author-row {
    border-top: 1px solid rgba(226, 232, 240, 0.15);
    padding-top: 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .hp50-test__author {
    font-family: 'Syne', sans-serif;
    font-size: 12px;
    font-weight: 800;
    color: #FFFFFF;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .hp50-test__verified {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
    color: #94A3B8;
    text-transform: uppercase;
  }

  @media screen and (max-width: 992px) {
    .hp50-test__grid { grid-template-columns: 1fr; max-width: 500px; margin: 0 auto; }
  }
{%- endstyle -%}

<div class="hp50-test__wrap">
  <div class="hp50-test__header">
    <h2 class="hp50-test__heading">{{ section.settings.heading | default: 'Backstage & Editorial Endorsements' }}</h2>
    <p style="font-size:12px; color:#94A3B8; letter-spacing:1.5px; text-transform:uppercase;">{{ section.settings.subheading | default: 'Direct testimonials from high-fashion models and lead artists.' }}</p>
  </div>

  <div class="hp50-test__grid">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <div class="hp50-test__card" {{ block.shopify_attributes }}>
          <div>
            <div class="hp50-test__stars">★★★★★</div>
            <p class="hp50-test__quote">"{{ block.settings.quote }}"</p>
          </div>
          <div class="hp50-test__author-row">
            <span class="hp50-test__author">{{ block.settings.author }}</span>
            <span class="hp50-test__verified">✓ Editorial Verified</span>
          </div>
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="hp50-test__card">
        <div>
          <div class="hp50-test__stars">★★★★★</div>
          <p class="hp50-test__quote">"The platinum contour elixir sculpts jawlines in seconds backstage. An absolute non-negotiable for runway shows."</p>
        </div>
        <div class="hp50-test__author-row">
          <span class="hp50-test__author">VALENTINA ROSTI</span>
          <span class="hp50-test__verified">✓ Milan Fashion Week</span>
        </div>
      </div>
      <div class="hp50-test__card">
        <div>
          <div class="hp50-test__stars">★★★★★</div>
          <p class="hp50-test__quote">"The sterling silver micro-mist eliminates shine under 4K studio cameras without leaving the skin looking dry or powdery."</p>
        </div>
        <div class="hp50-test__author-row">
          <span class="hp50-test__author">JEAN-LUC VAUQUELIN</span>
          <span class="hp50-test__verified">✓ Paris Studio Lead</span>
        </div>
      </div>
      <div class="hp50-test__card">
        <div>
          <div class="hp50-test__stars">★★★★★</div>
          <p class="hp50-test__quote">"Minimalist black monolith packaging, incredible performance, and lightning-fast white-glove courier to New York."</p>
        </div>
        <div class="hp50-test__author-row">
          <span class="hp50-test__author">SASHA KENDALL</span>
          <span class="hp50-test__verified">✓ NYC Editorial</span>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP50 - Runway Test",
  "class": "section-hp50-testimonials",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#000000" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Backstage & Editorial Endorsements" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Direct testimonials from high-fashion models and lead artists." },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "label": "Desktop Columns", "default": 3 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1240 }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review Item",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "The platinum contour elixir sculpts jawlines in seconds backstage." },
        { "type": "text", "id": "author", "label": "Author Name", "default": "VALENTINA ROSTI" }
      ]
    }
  ],
  "presets": [
    { "name": "HP50 - Runway Test" }
  ]
}
{% endschema %}
