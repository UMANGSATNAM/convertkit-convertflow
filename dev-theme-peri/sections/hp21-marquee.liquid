{%- style -%}
  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --border-color: {{ section.settings.border_color }};
    --font-body: 'Jost', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    border-top: 1px solid var(--border-color);
    border-bottom: 1px solid var(--border-color);
    overflow: hidden;
    position: relative;
    display: flex;
    align-items: center;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }

  .hp21-marquee__track {
    display: flex;
    white-space: nowrap;
    width: max-content;
    animation: hp21Marquee {{ section.settings.speed }}s linear infinite;
  }
  
  {%- if section.settings.direction == 'right' -%}
  .hp21-marquee__track {
    animation-direction: reverse;
  }
  {%- endif -%}

  @keyframes hp21Marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  /* When hovering over the section, slow down the animation for a luxurious feel */
  #shopify-section-{{ section.id }}:hover .hp21-marquee__track {
    animation-play-state: paused; /* or just slower via JS, but paused is simple CSS */
  }

  .hp21-marquee__content {
    display: flex;
    align-items: center;
    padding-right: 40px; /* Space before it repeats */
  }

  .hp21-marquee__item {
    font-family: var(--font-body);
    font-size: {{ section.settings.text_size }}px;
    font-weight: 300;
    letter-spacing: {{ section.settings.letter_spacing }}px;
    color: var(--text-color);
    text-transform: uppercase;
    display: flex;
    align-items: center;
  }

  .hp21-marquee__item-text {
    opacity: 0.9;
  }

  .hp21-marquee__separator {
    margin: 0 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-color);
  }

  .hp21-marquee__separator svg {
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;
    opacity: 0.8;
  }
  
  .hp21-marquee__separator--dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background-color: var(--accent-color);
    opacity: 0.5;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp21-marquee-wrapper" id="HP21Marquee-{{ section.id }}">
  <div class="hp21-marquee__track">
    <!-- Duplicate content for seamless scrolling -->
    {%- for i in (1..2) -%}
      <div class="hp21-marquee__content">
        {%- for block in section.blocks -%}
          <div class="hp21-marquee__item" {{ block.shopify_attributes }}>
            <span class="hp21-marquee__item-text">{{ block.settings.text | escape }}</span>
            
            {%- unless forloop.last and i == 2 -%}
              <div class="hp21-marquee__separator">
                {%- if section.settings.separator_style == 'diamond' -%}
                  <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2L2 12l10 10 10-10L12 2z"/></svg>
                {%- elsif section.settings.separator_style == 'star' -%}
                  <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.4 7.6H22l-6.2 4.5 2.4 7.6-6.2-4.5-6.2 4.5 2.4-7.6-6.2-4.5h7.6L12 2z"/></svg>
                {%- else -%}
                  <div class="hp21-marquee__separator--dot"></div>
                {%- endif -%}
              </div>
            {%- endunless -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "HP21 - Luxury Marquee",
  "class": "section-hp21-marquee",
  "settings": [
    {
      "type": "header",
      "content": "Behavior"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "s",
      "label": "Animation Duration (Slower = higher)",
      "default": 40
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Direction",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Text Size",
      "default": 13
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "Letter Spacing",
      "default": 3
    },
    {
      "type": "header",
      "content": "Separators"
    },
    {
      "type": "select",
      "id": "separator_style",
      "label": "Separator Style",
      "options": [
        { "value": "diamond", "label": "Diamond" },
        { "value": "star", "label": "Star" },
        { "value": "dot", "label": "Subtle Dot" }
      ],
      "default": "diamond"
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 8,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Icon Size",
      "default": 12
    },
    {
      "type": "header",
      "content": "Luxury Styling"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#0A0A0A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Separator Color (Gold/Silver)",
      "default": "#D4AF37"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "rgba(255, 255, 255, 0.1)"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Top Padding",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 16
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text Block",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "COMPLIMENTARY SHIPPING ON EXCLUSIVE ORDERS"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP21 - Luxury Marquee",
      "blocks": [
        { "type": "text" },
        { "type": "text" },
        { "type": "text" }
      ]
    }
  ]
}
{% endschema %}
