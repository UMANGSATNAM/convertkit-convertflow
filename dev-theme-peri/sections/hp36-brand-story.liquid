{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400;1,600&family=Oswald:wght@300;400;500&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --border-color: {{ section.settings.border_color }};
    
    --font-serif: 'Playfair Display', serif;
    --font-sans: 'Oswald', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    border-bottom: 1px solid var(--border-color);
  }

  .hp36-story-wrapper {
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    gap: 80px;
  }

  @media screen and (max-width: 1024px) {
    .hp36-story-wrapper {
      flex-direction: column;
      gap: 50px;
    }
  }
  @media screen and (max-width: 768px) {
    .hp36-story-wrapper {
      padding: 0 20px;
    }
  }

  .hp36-story__image-col {
    flex: 1;
    position: relative;
    border: 1px solid var(--border-color);
    padding: 20px;
  }

  .hp36-story__image-wrap {
    aspect-ratio: 3/4;
    position: relative;
    overflow: hidden;
  }

  .hp36-story__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%);
  }

  .hp36-story__content-col {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .hp36-story__subtitle {
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--text-color);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    margin-bottom: 30px;
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .hp36-story__subtitle::after {
    content: '';
    flex: 1;
    height: 1px;
    background-color: var(--border-color);
  }

  .hp36-story__title {
    font-family: var(--font-serif);
    font-size: clamp(48px, 6vw, {{ section.settings.title_size }}px);
    line-height: 1;
    color: var(--text-color);
    margin: 0 0 40px;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .hp36-story__title em {
    font-style: italic;
    color: var(--text-color);
    text-transform: lowercase;
  }

  .hp36-story__columns {
    display: column;
    column-count: 2;
    column-gap: 40px;
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 1.8;
    color: var(--text-color);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-align: justify;
  }

  @media screen and (max-width: 768px) {
    .hp36-story__columns {
      column-count: 1;
    }
  }

  /* Editorial Drop Cap */
  .hp36-story__columns > p:first-child::first-letter {
    font-family: var(--font-serif);
    font-size: 80px;
    line-height: 0.8;
    float: left;
    margin: 8px 10px 0 0;
    color: var(--text-color);
    font-style: italic;
  }

  .hp36-story__columns p {
    margin: 0 0 20px 0;
  }

  .hp36-story__btn {
    margin-top: 40px;
    font-family: var(--font-sans);
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    text-decoration: none;
    padding: 20px 40px;
    border: 1px solid var(--text-color);
    color: var(--bg-color);
    background-color: var(--text-color);
    transition: all 0.3s ease;
    align-self: flex-start;
    display: inline-block;
  }

  .hp36-story__btn:hover {
    background-color: transparent;
    color: var(--text-color);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp36-story-wrapper" id="HP36Story-{{ section.id }}">
  <div class="hp36-story__image-col">
    <div class="hp36-story__image-wrap">
      {%- if section.settings.image != blank -%}
        <img height="{{ section.settings.image.height }}" width="{{ section.settings.image.width }}" src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.title | escape }}" class="hp36-story__image" loading="lazy">
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'hp36-story__image' }}
      {%- endif -%}
    </div>
  </div>

  <div class="hp36-story__content-col">
    {%- if section.settings.subtitle != blank -%}
      <div class="hp36-story__subtitle">{{ section.settings.subtitle }}</div>
    {%- endif -%}
    
    <h2 class="hp36-story__title">{{ section.settings.title | replace: 'Vision', '<em>Vision</em>' }}</h2>
    
    <div class="hp36-story__columns">
      {{ section.settings.text }}
    </div>

    {%- if section.settings.btn_label != blank -%}
      <a href="{{ section.settings.btn_link | default: '#' }}" class="hp36-story__btn">
        {{ section.settings.btn_label }}
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP36 - Editorial Story",
  "class": "section-hp36-brand-story",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "CHAPTER I: THE MANIFESTO"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Heading",
      "default": "A singular Vision."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>In an era defined by excess, we strip away the superfluous to reveal the essential. Our philosophy is rooted in the belief that true luxury lies not in abundance, but in uncompromising quality and meticulous attention to detail.</p><p>Every garment is a study in proportion, a quiet rebellion against the ephemeral nature of trend-driven fashion. We construct pieces designed to outlive the seasons, elevating the mundane to the extraordinary through architectural silhouettes and masterful tailoring.</p>"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "Read Manifesto"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 40,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 80
    },
    {
      "type": "header",
      "content": "Editorial Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 100
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP36 - Editorial Story"
    }
  ]
}
{% endschema %}
