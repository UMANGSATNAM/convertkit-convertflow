{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Chakra+Petch:ital,wght@0,300;0,400;0,600;0,700;1,400&family=Press+Start+2P&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --cyan: {{ section.settings.cyan_color }};
    --magenta: {{ section.settings.magenta_color }};
    --win-bg: #c0c0c0;
    --win-dark: #000000;
    --win-light: #ffffff;
    --win-border-light: #dfdfdf;
    --win-border-dark: #808080;
    --win-title-bg: #000080;

    --font-heading: 'Press Start 2P', cursive;
    --font-body: 'Chakra Petch', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    position: relative;
    /* Optional diagonal stripe background */
    background-image: repeating-linear-gradient(
      45deg,
      transparent,
      transparent 10px,
      rgba(255, 0, 255, 0.05) 10px,
      rgba(255, 0, 255, 0.05) 20px
    );
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.8 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.8 | round }}px;
    }
  }

  .hp28-video-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    justify-content: center;
  }

  @media screen and (max-width: 768px) {
    .hp28-video-wrapper {
      padding: 0 20px;
    }
  }

  /* Retro Media Player Container */
  .hp28-video__player {
    width: 100%;
    background: var(--win-bg);
    border-top: 2px solid var(--win-light);
    border-left: 2px solid var(--win-light);
    border-right: 2px solid var(--win-dark);
    border-bottom: 2px solid var(--win-dark);
    padding: 4px;
    box-shadow: 10px 10px 0 var(--cyan);
  }

  .hp28-video__title-bar {
    background: var(--win-title-bg);
    color: var(--win-light);
    padding: 6px 10px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 700;
    margin-bottom: 4px;
    letter-spacing: 0.05em;
  }

  .hp28-video__title-btns {
    display: flex;
    gap: 4px;
  }

  .hp28-video__title-btn {
    width: 16px;
    height: 16px;
    background: var(--win-bg);
    border-top: 1px solid var(--win-light);
    border-left: 1px solid var(--win-light);
    border-right: 1px solid var(--win-dark);
    border-bottom: 1px solid var(--win-dark);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #000;
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: bold;
    line-height: 1;
    cursor: default;
  }

  .hp28-video__screen-container {
    position: relative;
    width: 100%;
    aspect-ratio: 16/9;
    background: #000;
    border-top: 2px solid var(--win-border-dark);
    border-left: 2px solid var(--win-border-dark);
    border-right: 2px solid var(--win-light);
    border-bottom: 2px solid var(--win-light);
    overflow: hidden;
  }

  .hp28-video__bg {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    z-index: 1;
  }

  .hp28-video__bg img,
  .hp28-video__bg video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: {{ section.settings.media_opacity | divided_by: 100.0 }};
    /* Extreme color saturation */
    filter: saturate(150%) hue-rotate(-20deg) contrast(1.2);
    transition: filter 0.3s ease;
  }

  .hp28-video__player:hover .hp28-video__bg img,
  .hp28-video__player:hover .hp28-video__bg video {
    filter: saturate(100%) hue-rotate(0deg) contrast(1);
  }

  /* VHS overlay */
  .hp28-video__vhs {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background: repeating-linear-gradient(
      transparent,
      transparent 2px,
      rgba(0, 0, 0, 0.2) 2px,
      rgba(0, 0, 0, 0.2) 4px
    );
    z-index: 2;
    pointer-events: none;
  }

  .hp28-video__content {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 20px;
  }

  .hp28-video__play {
    width: 80px;
    height: 80px;
    background: var(--win-bg);
    border-top: 4px solid var(--win-light);
    border-left: 4px solid var(--win-light);
    border-right: 4px solid var(--win-dark);
    border-bottom: 4px solid var(--win-dark);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 30px;
    cursor: pointer;
    box-shadow: 4px 4px 0 var(--magenta);
    transition: all 0.1s ease;
  }

  .hp28-video__play:active {
    border-top: 4px solid var(--win-dark);
    border-left: 4px solid var(--win-dark);
    border-right: 4px solid var(--win-light);
    border-bottom: 4px solid var(--win-light);
    box-shadow: 0px 0px 0 var(--magenta);
    transform: translate(4px, 4px);
  }

  .hp28-video__play svg {
    width: 30px;
    height: 30px;
    fill: #000;
    margin-left: 6px;
  }

  .hp28-video__title {
    font-family: var(--font-heading);
    font-size: clamp(24px, 4vw, {{ section.settings.title_size }}px);
    color: var(--cyan);
    margin: 0;
    text-transform: uppercase;
    text-shadow: 3px 3px 0 var(--magenta);
  }

  /* Modal Styles */
  .hp28-video__modal {
    position: fixed;
    top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(28, 11, 43, 0.95);
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .hp28-video__modal.is-active {
    opacity: 1;
    pointer-events: auto;
  }

  .hp28-video__modal-container {
    width: 90%;
    max-width: 1000px;
    background: var(--win-bg);
    border-top: 2px solid var(--win-light);
    border-left: 2px solid var(--win-light);
    border-right: 2px solid var(--win-dark);
    border-bottom: 2px solid var(--win-dark);
    padding: 4px;
    box-shadow: 10px 10px 0 var(--cyan);
  }

  .hp28-video__modal-header {
    background: var(--win-title-bg);
    color: var(--win-light);
    padding: 6px 10px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 700;
    margin-bottom: 4px;
  }

  .hp28-video__modal-close {
    width: 16px;
    height: 16px;
    background: var(--win-bg);
    border-top: 1px solid var(--win-light);
    border-left: 1px solid var(--win-light);
    border-right: 1px solid var(--win-dark);
    border-bottom: 1px solid var(--win-dark);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #000;
    font-family: Arial, sans-serif;
    font-size: 10px;
    font-weight: bold;
    cursor: pointer;
  }

  .hp28-video__modal-close:active {
    border-top: 1px solid var(--win-dark);
    border-left: 1px solid var(--win-dark);
    border-right: 1px solid var(--win-light);
    border-bottom: 1px solid var(--win-light);
  }

  .hp28-video__modal-content {
    width: 100%;
    aspect-ratio: 16/9;
    background: #000;
    border-top: 2px solid var(--win-border-dark);
    border-left: 2px solid var(--win-border-dark);
    border-right: 2px solid var(--win-light);
    border-bottom: 2px solid var(--win-light);
  }

  .hp28-video__modal-content iframe {
    width: 100%;
    height: 100%;
    border: none;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp28-video-wrapper" id="HP28Video-{{ section.id }}">
  <div class="hp28-video__player">
    
    <div class="hp28-video__title-bar">
      <span>{{ section.settings.title_bar_text | default: 'MEDIA_PLAYER.EXE' }}</span>
      <div class="hp28-video__title-btns">
        <div class="hp28-video__title-btn">_</div>
        <div class="hp28-video__title-btn">□</div>
        <div class="hp28-video__title-btn">x</div>
      </div>
    </div>

    <div class="hp28-video__screen-container">
      <div class="hp28-video__bg">
        {%- if section.settings.image != blank -%}
          <img height="{{ section.settings.image.height }}" width="{{ section.settings.image.width }}" src="{{ section.settings.image | image_url: width: 2000 }}" alt="{{ section.settings.title | escape }}" loading="lazy">
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag }}
        {%- endif -%}
      </div>
      <div class="hp28-video__vhs"></div>

      <div class="hp28-video__content">
        {%- if section.settings.video_url != blank -%}
          <button class="hp28-video__play" aria-label="Play Video">
            <!-- Pixelated Play Icon Simulation -->
            <svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
          </button>
        {%- endif -%}

        {%- if section.settings.title != blank -%}
          <h2 class="hp28-video__title">{{ section.settings.title }}</h2>
        {%- endif -%}
      </div>
    </div>
    
  </div>
</div>

{%- if section.settings.video_url != blank -%}
<div class="hp28-video__modal" id="HP28VideoModal-{{ section.id }}">
  <div class="hp28-video__modal-container">
    <div class="hp28-video__modal-header">
      <span>{{ section.settings.title_bar_text | default: 'MEDIA_PLAYER.EXE' }} - PLAYING</span>
      <button class="hp28-video__modal-close" aria-label="Close">x</button>
    </div>
    <div class="hp28-video__modal-content">
      {%- if section.settings.video_url.type == 'youtube' -%}
        <iframe data-src="https://www.youtube.com/embed/{{ section.settings.video_url.id }}?autoplay=1&rel=0" allow="autoplay; encrypted-media" allowfullscreen></iframe>
      {%- elsif section.settings.video_url.type == 'vimeo' -%}
        <iframe data-src="https://player.vimeo.com/video/{{ section.settings.video_url.id }}?autoplay=1" allow="autoplay; fullscreen" allowfullscreen></iframe>
      {%- endif -%}
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const playBtn = document.querySelector('#HP28Video-{{ section.id }} .hp28-video__play');
    const modal = document.getElementById('HP28VideoModal-{{ section.id }}');
    const closeBtn = modal ? modal.querySelector('.hp28-video__modal-close') : null;
    const iframe = modal ? modal.querySelector('iframe') : null;

    if(playBtn && modal && iframe) {
      playBtn.addEventListener('click', () => {
        iframe.src = iframe.getAttribute('data-src');
        modal.classList.add('is-active');
      });

      closeBtn.addEventListener('click', () => {
        modal.classList.remove('is-active');
        iframe.src = '';
      });

      modal.addEventListener('click', (e) => {
        if(e.target === modal) {
          modal.classList.remove('is-active');
          iframe.src = '';
        }
      });
    }
  });
</script>
{%- endif -%}

{% schema %}
{
  "name": "HP28 - Y2K Video Banner",
  "class": "section-hp28-video-banner",
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Cover Image"
    },
    {
      "type": "range",
      "id": "media_opacity",
      "min": 10,
      "max": 100,
      "step": 5,
      "label": "Media Opacity (%)",
      "default": 60
    },
    {
      "type": "video_url",
      "id": "video_url",
      "accept": ["youtube", "vimeo"],
      "label": "Video URL",
      "info": "YouTube or Vimeo URL"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title_bar_text",
      "label": "Window Title",
      "default": "SYSTEM_VIEWER.EXE"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Heading",
      "default": "PLAY TRANSMISSION"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 800,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1200
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 48
    },
    {
      "type": "header",
      "content": "Y2K Cyber Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (Deep Purple)",
      "default": "#1C0B2B"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Base Text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "cyan_color",
      "label": "Cyan Accent",
      "default": "#00FFFF"
    },
    {
      "type": "color",
      "id": "magenta_color",
      "label": "Magenta Accent",
      "default": "#FF00FF"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP28 - Y2K Video Banner"
    }
  ]
}
{% endschema %}
