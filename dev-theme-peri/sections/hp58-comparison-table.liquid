{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#111827' }};
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }
  .hp58-comp__container { max-width: {{ section.settings.container_width | default: 1000 }}px; margin: 0 auto; padding: 0 24px; }
  .hp58-comp__header { text-align: center; margin-bottom: 50px; }
  .hp58-comp__eyebrow { font-family: 'Space Grotesk', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: {{ section.settings.accent_color | default: '#06B6D4' }}; margin: 0 0 12px; }
  .hp58-comp__heading { font-family: 'Syne', sans-serif; font-size: clamp(28px, 3.5vw, 42px); font-weight: 800; color: #FFFFFF; margin: 0; }
  .hp58-comp__table {
    width: 100%; border-collapse: collapse; background: {{ section.settings.card_bg | default: '#0B0F19' }};
    border-radius: 8px; overflow: hidden; border: 1px solid rgba(6, 182, 212, 0.25);
    box-shadow: 0 0 30px rgba(6, 182, 212, 0.1);
  }
  .hp58-comp__table th {
    background: #030712; color: #06B6D4; font-family: 'Space Grotesk', sans-serif;
    font-size: 12px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase;
    padding: 18px 20px; text-align: left; border-bottom: 1px solid rgba(6, 182, 212, 0.25);
  }
  .hp58-comp__table td {
    padding: 16px 20px; font-size: 14px; color: #F8FAFC;
    border-bottom: 1px solid rgba(6, 182, 212, 0.1);
  }
  .hp58-comp__table tr:last-child td { border-bottom: none; }
  .hp58-comp__check { color: #06B6D4; font-weight: 700; }
  @media screen and (max-width: 768px) {
    .hp58-comp__table { font-size: 13px; }
    .hp58-comp__table th, .hp58-comp__table td { padding: 12px 14px; }
  }
{%- endstyle -%}
<div class="hp58-comp__container">
  <div class="hp58-comp__header">
    {%- if section.settings.eyebrow != blank -%}<p class="hp58-comp__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="hp58-comp__heading">{{ section.settings.heading | default: 'The Tokyo Tech Matrix' }}</h2>
  </div>
  <table class="hp58-comp__table">
    <thead>
      <tr>
        <th>{{ section.settings.col1_head | default: 'Bio-Metric' }}</th>
        <th>{{ section.settings.col2_head | default: 'Tokyo Cyber Lab' }}</th>
        <th>{{ section.settings.col3_head | default: 'Conventional Skincare' }}</th>
      </tr>
    </thead>
    <tbody>
      {%- for block in section.blocks -%}
        <tr {{ block.shopify_attributes }}>
          <td>{{ block.settings.feature | default: 'Peptide Synthesis' }}</td>
          <td class="hp58-comp__check">{{ block.settings.us | default: '⚡ Quantum Targeted 7X' }}</td>
          <td style="color:#64748B;">{{ block.settings.them | default: 'Random Multi-Mix' }}</td>
        </tr>
      {%- endfor -%}
    </tbody>
  </table>
</div>
{% schema %}
{
  "name": "HP58 Compare",
  "class": "section-hp58-comp",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#111827" },
    { "type": "color", "id": "card_bg", "label": "Table BG", "default": "#0B0F19" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#06B6D4" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "⚡ MATRIX" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Tokyo Tech Matrix" },
    { "type": "text", "id": "col1_head", "label": "Column 1", "default": "Bio-Metric" },
    { "type": "text", "id": "col2_head", "label": "Column 2", "default": "Tokyo Cyber Lab" },
    { "type": "text", "id": "col3_head", "label": "Column 3", "default": "Conventional Skincare" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 700, "max": 1200, "step": 20, "unit": "px", "label": "Container Width", "default": 1000 }
  ],
  "blocks": [{
    "type": "row", "name": "Row",
    "settings": [
      { "type": "text", "id": "feature", "label": "Feature", "default": "Peptide Synthesis" },
      { "type": "text", "id": "us", "label": "Us", "default": "⚡ Quantum Targeted 7X" },
      { "type": "text", "id": "them", "label": "Others", "default": "Random Multi-Mix" }
    ]
  }],
  "presets": [{
    "name": "HP58 Compare",
    "blocks": [
      { "type": "row", "settings": { "feature": "Peptide Precision", "us": "⚡ Quantum Targeted 7X", "them": "Random Multi-Mix" } },
      { "type": "row", "settings": { "feature": "HEV Blue Light Defense", "us": "⚡ 98% Optical Blockade", "them": "0% Blue Light Defense" } },
      { "type": "row", "settings": { "feature": "Cellular Energy Synthesis", "us": "⚡ +340% Mitochondrial ATP", "them": "Surface Hydration Only" } },
      { "type": "row", "settings": { "feature": "Absorption Rate", "us": "⚡ <10 Seconds Nanoscale", "them": "Greasy Film 1-2 Hours" } }
    ]
  }]
}
{% endschema %}
