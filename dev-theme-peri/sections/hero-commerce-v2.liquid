<style>
  .hero-commerce-v2 {
    background-color: var(--bg-base);
    position: relative;
    overflow: hidden;
    padding: var(--space-48) 0;
  }
  .hero-commerce-v2__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-48);
  }
  @media (min-width: 768px) {
    .hero-commerce-v2 {
      padding: var(--space-64) 0;
    }
    .hero-commerce-v2__inner {
      flex-direction: row;
      align-items: center;
    }
  }

  /* Left Column: Content */
  .hero-commerce-v2__content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
  }
  
  .hero-commerce-v2__badge-pill {
    align-self: flex-start;
    background-color: var(--tint-green);
    color: var(--primary);
    padding: var(--space-8) var(--space-16);
    border-radius: var(--radius-pill);
    font-size: var(--text-12);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    display: flex;
    align-items: center;
    gap: var(--space-8);
  }
  .hero-commerce-v2__badge-pill span:not(:last-child)::after {
    content: "•";
    margin-left: var(--space-8);
    opacity: 0.5;
  }

  .hero-commerce-v2__heading {
    font-size: var(--text-40);
    line-height: 1.1;
    margin: 0;
    font-weight: 700;
    color: var(--text-main);
  }
  @media (min-width: 768px) {
    .hero-commerce-v2__heading {
      font-size: var(--text-48);
    }
  }
  
  .hero-commerce-v2__heading-line {
    display: block;
  }

  .hero-commerce-v2__subtext {
    font-size: var(--text-18);
    color: var(--text-muted);
    line-height: 1.5;
    margin: 0;
    max-width: 500px;
  }

  .hero-commerce-v2__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-16);
  }
  
  .hero-commerce-v2__btn {
    padding: var(--space-16) var(--space-32);
    border-radius: var(--radius-pill);
    font-weight: 600;
    font-size: var(--text-16);
    text-decoration: none;
    text-align: center;
    transition: all 0.2s ease;
  }
  .hero-commerce-v2__btn--primary {
    background-color: var(--primary);
    color: var(--surface);
    border: 2px solid var(--primary);
  }
  .hero-commerce-v2__btn--primary:hover {
    background-color: var(--primary-hover);
    border-color: var(--primary-hover);
  }
  .hero-commerce-v2__btn--secondary {
    background-color: transparent;
    color: var(--primary);
    border: 2px solid var(--primary);
  }
  .hero-commerce-v2__btn--secondary:hover {
    background-color: var(--tint-green);
  }

  .hero-commerce-v2__trust-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-24);
    margin-top: var(--space-8);
    padding-top: var(--space-24);
    border-top: 1px solid var(--border);
  }
  .hero-commerce-v2__trust-item {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    font-size: var(--text-14);
    color: var(--text-main);
    font-weight: 500;
  }
  .hero-commerce-v2__trust-icon {
    width: 24px;
    height: 24px;
    color: var(--primary);
  }

  /* Right Column: Visuals */
  .hero-commerce-v2__visuals {
    flex: 1;
    position: relative;
    min-height: 400px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  @media (min-width: 768px) {
    .hero-commerce-v2__visuals {
      min-height: 500px;
    }
  }

  .hero-commerce-v2__image-main {
    width: 80%;
    max-width: 400px;
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-md);
    position: relative;
    z-index: 1;
  }

  .hero-commerce-v2__image-float {
    position: absolute;
    width: 40%;
    max-width: 200px;
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-md);
    z-index: 2;
    bottom: 10%;
    left: 0;
    border: 4px solid var(--surface);
  }

  .hero-commerce-v2__visual-chip {
    position: absolute;
    top: 20%;
    right: 5%;
    background-color: var(--surface);
    padding: var(--space-12) var(--space-16);
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-md);
    display: flex;
    align-items: center;
    gap: var(--space-8);
    z-index: 3;
    font-weight: 700;
    font-size: var(--text-14);
    color: var(--text-main);
  }
  .hero-commerce-v2__visual-chip span {
    color: var(--star-amber);
    font-size: var(--text-18);
  }

  /* Ticker Strip */
  .hero-commerce-v2__ticker {
    background-color: var(--primary);
    color: var(--surface);
    padding: var(--space-12) 0;
    overflow: hidden;
    white-space: nowrap;
    display: flex;
  }
  .hero-commerce-v2__ticker-track {
    display: inline-block;
    animation: ticker 30s linear infinite;
  }
  .hero-commerce-v2__ticker-item {
    display: inline-block;
    padding: 0 var(--space-32);
    font-size: var(--text-14);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
  }
  @keyframes ticker {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
</style>

<div class="hero-commerce-v2">
  <div class="page-width">
    <div class="hero-commerce-v2__inner">
      
      <div class="hero-commerce-v2__content">
        {%- if section.settings.badge_text_1 != blank or section.settings.badge_text_2 != blank -%}
          <div class="hero-commerce-v2__badge-pill">
            {% if section.settings.badge_text_1 != blank %}<span>{{ section.settings.badge_text_1 }}</span>{% endif %}
            {% if section.settings.badge_text_2 != blank %}<span>{{ section.settings.badge_text_2 }}</span>{% endif %}
            {% if section.settings.badge_text_3 != blank %}<span>{{ section.settings.badge_text_3 }}</span>{% endif %}
          </div>
        {%- endif -%}

        <h1 class="hero-commerce-v2__heading">
          <span class="hero-commerce-v2__heading-line" style="color: {{ section.settings.line_1_color }}">{{ section.settings.heading_line_1 }}</span>
          <span class="hero-commerce-v2__heading-line" style="color: {{ section.settings.line_2_color }}">{{ section.settings.heading_line_2 }}</span>
          <span class="hero-commerce-v2__heading-line" style="color: {{ section.settings.line_3_color }}">{{ section.settings.heading_line_3 }}</span>
        </h1>

        {%- if section.settings.subtext != blank -%}
          <p class="hero-commerce-v2__subtext">{{ section.settings.subtext }}</p>
        {%- endif -%}

        <div class="hero-commerce-v2__ctas">
          {%- if section.settings.btn_1_label != blank -%}
            <a href="{{ section.settings.btn_1_link | default: '#' }}" class="hero-commerce-v2__btn hero-commerce-v2__btn--primary">
              {{ section.settings.btn_1_label }}
            </a>
          {%- endif -%}
          {%- if section.settings.btn_2_label != blank -%}
            <a href="{{ section.settings.btn_2_link | default: '#' }}" class="hero-commerce-v2__btn hero-commerce-v2__btn--secondary">
              {{ section.settings.btn_2_label }}
            </a>
          {%- endif -%}
        </div>

        {%- if section.settings.show_trust_row -%}
          <div class="hero-commerce-v2__trust-row">
            {%- if section.settings.trust_1_text != blank -%}
              <div class="hero-commerce-v2__trust-item">
                <svg class="hero-commerce-v2__trust-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                {{ section.settings.trust_1_text }}
              </div>
            {%- endif -%}
            {%- if section.settings.trust_2_text != blank -%}
              <div class="hero-commerce-v2__trust-item">
                <svg class="hero-commerce-v2__trust-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M9 12l2 2 4-4"/></svg>
                {{ section.settings.trust_2_text }}
              </div>
            {%- endif -%}
            {%- if section.settings.trust_3_text != blank -%}
              <div class="hero-commerce-v2__trust-item">
                <svg class="hero-commerce-v2__trust-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                {{ section.settings.trust_3_text }}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      <div class="hero-commerce-v2__visuals">
        {%- if section.settings.image_main -%}
          <img src="{{ section.settings.image_main | image_url: width: 800 }}" class="hero-commerce-v2__image-main" loading="lazy" alt="Hero Main">
        {%- else -%}
          <div class="hero-commerce-v2__image-main" style="background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%); display: flex; flex-direction: column; align-items: center; justify-content: center; color: var(--text-main); text-align: center; padding: 24px; border: 1px solid var(--border); border-radius: var(--radius-card);">
            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" style="opacity: 0.4; margin-bottom: 16px;"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            <span style="font-size: 14px; font-weight: 600; letter-spacing: 2px; text-transform: uppercase; opacity: 0.75;">{{ shop.name | default: 'AURELLE BEAUTY' }}</span>
            <span style="font-size: 11px; font-weight: 500; letter-spacing: 1.5px; text-transform: uppercase; opacity: 0.45; margin-top: 6px;">Botanical Formula Showcase</span>
          </div>
        {%- endif -%}

        {%- if section.settings.image_float -%}
          <img src="{{ section.settings.image_float | image_url: width: 400 }}" class="hero-commerce-v2__image-float" loading="lazy" alt="Hero Float">
        {%- else -%}
          <div class="hero-commerce-v2__image-float" style="background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%); display: flex; flex-direction: column; align-items: center; justify-content: center; color: var(--text-main); text-align: center; padding: 16px; border: 1px solid var(--border); border-radius: var(--radius-card); box-shadow: var(--shadow-md);">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" style="opacity: 0.5; margin-bottom: 8px;"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            <span style="font-size: 10px; font-weight: 600; letter-spacing: 1.5px; text-transform: uppercase; opacity: 0.75;">CONCENTRATED</span>
            <span style="font-size: 8px; font-weight: 500; letter-spacing: 1px; text-transform: uppercase; opacity: 0.45; margin-top: 2px;">Pure Actives</span>
          </div>
        {%- endif -%}

        {%- if section.settings.chip_text != blank -%}
          <div class="hero-commerce-v2__visual-chip">
            <span>★</span> {{ section.settings.chip_text }}
          </div>
        {%- endif -%}
      </div>

    </div>
  </div>
</div>

{%- if section.settings.show_ticker -%}
  <div class="hero-commerce-v2__ticker">
    <div class="hero-commerce-v2__ticker-track">
      {%- for i in (1..10) -%}
        <div class="hero-commerce-v2__ticker-item">{{ section.settings.ticker_text | default: 'FREE SHIPPING OVER $50' }}</div>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

