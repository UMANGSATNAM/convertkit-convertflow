{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Lato:wght@300;400;700&family=Playfair+Display:ital,wght@0,400;0,500;1,400&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    
    --font-heading: 'Playfair Display', serif;
    --font-body: 'Lato', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .hp31-usp-wrapper {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp31-usp-wrapper {
      padding: 0 20px;
    }
  }

  .hp31-usp__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: 60px;
    text-align: center;
  }

  @media screen and (max-width: 992px) {
    .hp31-usp__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 40px;
    }
  }

  @media screen and (max-width: 576px) {
    .hp31-usp__grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }

  .hp31-usp__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    opacity: 0;
    transform: translateY(20px);
    animation: hp31FadeInUp 0.8s ease forwards;
  }

  /* Stagger animations */
  .hp31-usp__item:nth-child(1) { animation-delay: 0.1s; }
  .hp31-usp__item:nth-child(2) { animation-delay: 0.2s; }
  .hp31-usp__item:nth-child(3) { animation-delay: 0.3s; }
  .hp31-usp__item:nth-child(4) { animation-delay: 0.4s; }

  .hp31-usp__icon {
    width: 48px;
    height: 48px;
    margin-bottom: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-color);
    opacity: 0.8;
  }

  .hp31-usp__icon svg, .hp31-usp__icon img {
    max-width: 100%;
    max-height: 100%;
    fill: currentColor;
  }

  .hp31-usp__title {
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 400;
    color: var(--text-color);
    margin: 0 0 12px;
    letter-spacing: 0.02em;
  }

  .hp31-usp__text {
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-color);
    opacity: 0.6;
    margin: 0;
    font-weight: 300;
  }

  @keyframes hp31FadeInUp {
    0% { opacity: 0; transform: translateY(20px); }
    100% { opacity: 1; transform: translateY(0); }
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp31-usp-wrapper" id="HP31USP-{{ section.id }}">
  <div class="hp31-usp__grid">
    {%- for block in section.blocks -%}
      <div class="hp31-usp__item" {{ block.shopify_attributes }}>
        <div class="hp31-usp__icon">
          {%- if block.settings.icon != blank -%}
            {{ block.settings.icon }}
          {%- else -%}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="8" x2="12" y2="16"></line>
              <line x1="8" y1="12" x2="16" y2="12"></line>
            </svg>
          {%- endif -%}
        </div>
        <h3 class="hp31-usp__title">{{ block.settings.title }}</h3>
        <p class="hp31-usp__text">{{ block.settings.text }}</p>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "HP31 - Zen USP",
  "class": "section-hp31-usp",
  "settings": [
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Columns (Desktop)",
      "default": 4
    },
    {
      "type": "header",
      "content": "Zen Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (Beige)",
      "default": "#F9F6F0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text (Charcoal)",
      "default": "#2C2C2C"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 100
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "usp",
      "name": "USP Item",
      "settings": [
        {
          "type": "html",
          "id": "icon",
          "label": "SVG Icon Code",
          "info": "Paste raw SVG code for a minimalist icon."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Mindful Sourcing"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Materials chosen with intention and respect for nature."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP31 - Zen USP",
      "blocks": [
        { "type": "usp" },
        { "type": "usp", "settings": { "title": "Slow Craft", "text": "Pieces designed to endure beyond transient seasons." } },
        { "type": "usp", "settings": { "title": "Quiet Comfort", "text": "Textures that soothe the senses and elevate the everyday." } },
        { "type": "usp", "settings": { "title": "Carbon Neutral", "text": "Offsetting our footprint to maintain global harmony." } }
      ]
    }
  ]
}
{% endschema %}
