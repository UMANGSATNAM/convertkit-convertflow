{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp45-test-bg: {{ section.settings.bg_color | default: '#F5F5F0' }};
    --hp45-border: {{ section.settings.border_color | default: '#0A0A0A' }};
    
    background-color: var(--hp45-test-bg);
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
  }

  .hp45-test__wrap {
    max-width: {{ section.settings.container_width | default: 1300 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp45-test__header {
    text-align: center;
    margin-bottom: 50px;
  }

  .hp45-test__heading {
    font-size: clamp(28px, 4vw, 42px);
    font-weight: 700;
    text-transform: uppercase;
    color: #0A0A0A;
    margin: 0 0 8px;
  }

  .hp45-test__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: 3 }}, 1fr);
    gap: 24px;
  }

  .hp45-test__card {
    background: #FFFFFF;
    border: 2px solid var(--hp45-border);
    box-shadow: 5px 5px 0 var(--hp45-border);
    padding: 32px 28px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .hp45-test__log {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: 700;
    color: #888888;
    margin-bottom: 14px;
  }

  .hp45-test__quote {
    font-family: 'JetBrains Mono', monospace;
    font-size: 14px;
    line-height: 1.65;
    color: #0A0A0A;
    margin: 0 0 24px;
  }

  .hp45-test__author-row {
    border-top: 1.5px solid #EAEAE5;
    padding-top: 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .hp45-test__author {
    font-weight: 700;
    font-size: 14px;
    text-transform: uppercase;
  }

  .hp45-test__badge {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: 700;
    background: #0A0A0A;
    color: #FFFFFF;
    padding: 3px 8px;
  }

  @media screen and (max-width: 992px) {
    .hp45-test__grid { grid-template-columns: 1fr; max-width: 500px; margin: 0 auto; }
  }
{%- endstyle -%}

<div class="hp45-test__wrap">
  <div class="hp45-test__header">
    <h2 class="hp45-test__heading">{{ section.settings.heading | default: 'CLINICAL TRIAL TESTIMONIALS' }}</h2>
    <p style="font-family:'JetBrains Mono', monospace; font-size:13px; color:#555;">{{ section.settings.subheading | default: 'Independent participant evaluations under dermatological supervision.' }}</p>
  </div>

  <div class="hp45-test__grid">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <div class="hp45-test__card" {{ block.shopify_attributes }}>
          <div>
            <div class="hp45-test__log">[EVAL ID: #{{ forloop.index }}092]</div>
            <p class="hp45-test__quote">"{{ block.settings.quote }}"</p>
          </div>
          <div class="hp45-test__author-row">
            <span class="hp45-test__author">{{ block.settings.author }}</span>
            <span class="hp45-test__badge">VERIFIED SUBJECT</span>
          </div>
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="hp45-test__card">
        <div>
          <div class="hp45-test__log">[EVAL ID: #1092]</div>
          <p class="hp45-test__quote">"Zero greasy residue. Cellular matrix recon reduced micro-wrinkle depth visibly by day 14."</p>
        </div>
        <div class="hp45-test__author-row">
          <span class="hp45-test__author">DR. K. VANDERBILT</span>
          <span class="hp45-test__badge">VERIFIED SUBJECT</span>
        </div>
      </div>
      <div class="hp45-test__card">
        <div>
          <div class="hp45-test__log">[EVAL ID: #2041]</div>
          <p class="hp45-test__quote">"The ectoin shield completely halted erythema reactions caused by intense dry HVAC environments."</p>
        </div>
        <div class="hp45-test__author-row">
          <span class="hp45-test__author">MARCUS CHEN</span>
          <span class="hp45-test__badge">VERIFIED SUBJECT</span>
        </div>
      </div>
      <div class="hp45-test__card">
        <div>
          <div class="hp45-test__log">[EVAL ID: #3088]</div>
          <p class="hp45-test__quote">"Architectural dosage packaging is airtight and leak-proof during international flights. Exceptional."</p>
        </div>
        <div class="hp45-test__author-row">
          <span class="hp45-test__author">SOPHIA LEROUX</span>
          <span class="hp45-test__badge">VERIFIED SUBJECT</span>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP45 - Brutal Test",
  "class": "section-hp45-test",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#F5F5F0" },
    { "type": "color", "id": "border_color", "label": "Border Color", "default": "#0A0A0A" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "CLINICAL TRIAL TESTIMONIALS" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Independent participant evaluations under dermatological supervision." },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "label": "Desktop Columns", "default": 3 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 80 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1300 }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review Item",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "Zero greasy residue. Cellular matrix recon reduced micro-wrinkle depth visibly." },
        { "type": "text", "id": "author", "label": "Author Name", "default": "DR. K. VANDERBILT" }
      ]
    }
  ],
  "presets": [
    { "name": "HP45 - Brutal Test" }
  ]
}
{% endschema %}
