{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp45-fc-bg: {{ section.settings.bg_color | default: '#F5F5F0' }};
    --hp45-fc-card: {{ section.settings.card_bg | default: '#FFFFFF' }};
    --hp45-fc-border: {{ section.settings.border_color | default: '#0A0A0A' }};
    --hp45-fc-title: {{ section.settings.title_color | default: '#0A0A0A' }};
    
    background-color: var(--hp45-fc-bg);
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
  }

  .hp45-fc__wrapper {
    max-width: {{ section.settings.container_width | default: 1300 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp45-fc__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 40px;
    border-bottom: 2px solid var(--hp45-fc-border);
    padding-bottom: 20px;
  }

  .hp45-fc__heading {
    font-size: clamp(28px, 4vw, 42px);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -1px;
    color: var(--hp45-fc-title);
    margin: 0;
  }

  .hp45-fc__view-all {
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--hp45-fc-title);
    text-decoration: none;
    padding: 8px 16px;
    border: 1.5px solid var(--hp45-fc-border);
    background: #FFFFFF;
    box-shadow: 3px 3px 0 var(--hp45-fc-border);
  }

  .hp45-fc__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: 4 }}, 1fr);
    gap: 24px;
  }

  .hp45-prod-card {
    background: var(--hp45-fc-card);
    border: 2px solid var(--hp45-fc-border);
    box-shadow: 5px 5px 0 var(--hp45-fc-border);
    display: flex;
    flex-direction: column;
    transition: all 0.2s ease;
  }

  .hp45-prod-card:hover {
    transform: translate(2px, 2px);
    box-shadow: 3px 3px 0 var(--hp45-fc-border);
  }

  .hp45-prod-card__media {
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    background: #EAEAE5;
    border-bottom: 2px solid var(--hp45-fc-border);
    position: relative;
  }

  .hp45-prod-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: grayscale(100%);
    transition: filter 0.3s ease;
  }

  .hp45-prod-card:hover .hp45-prod-card__img {
    filter: grayscale(0%);
  }

  .hp45-prod-card__badge {
    position: absolute;
    top: 10px;
    left: 10px;
    background: #0A0A0A;
    color: #FFFFFF;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: 700;
    padding: 4px 8px;
  }

  .hp45-prod-card__body {
    padding: 20px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .hp45-prod-card__spec {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: #777777;
    margin: 0 0 4px;
  }

  .hp45-prod-card__title {
    font-size: 17px;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--hp45-fc-title);
    margin: 0 0 10px;
  }

  .hp45-prod-card__price {
    font-family: 'JetBrains Mono', monospace;
    font-size: 16px;
    font-weight: 700;
    margin-bottom: 16px;
  }

  .hp45-prod-card__btn {
    width: 100%;
    margin-top: auto;
    padding: 13px;
    background: #0A0A0A;
    color: #FFFFFF;
    border: 2px solid #0A0A0A;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .hp45-prod-card__btn:hover {
    background: #FFFFFF;
    color: #0A0A0A;
  }

  @media screen and (max-width: 992px) {
    .hp45-fc__grid { grid-template-columns: repeat(2, 1fr); gap: 16px; }
  }
  @media screen and (max-width: 576px) {
    .hp45-fc__header { flex-direction: column; align-items: flex-start; gap: 14px; }
  }
{%- endstyle -%}

<div class="hp45-fc__wrapper">
  <div class="hp45-fc__header">
    <h2 class="hp45-fc__heading">{{ section.settings.heading | default: 'SYSTEM CATALOGUE // V45' }}</h2>
    <a href="{{ section.settings.view_all_url | default: '/collections/all' }}" class="hp45-fc__view-all">
      {{ section.settings.view_all_text | default: 'FULL CATALOGUE [→]' }}
    </a>
  </div>

  <div class="hp45-fc__grid">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <div class="hp45-prod-card" {{ block.shopify_attributes }}>
          <div class="hp45-prod-card__media">
            {%- if block.settings.badge != blank -%}
              <span class="hp45-prod-card__badge">{{ block.settings.badge }}</span>
            {%- endif -%}
            {%- if block.settings.image != blank -%}
              <img height="{{ block.settings.image.height }}" width="{{ block.settings.image.width }}" src="{{ block.settings.image | image_url: width: 600 }}" class="hp45-prod-card__img" alt="{{ block.settings.title }}" loading="lazy">
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'hp45-prod-card__img' }}
            {%- endif -%}
          </div>
          <div class="hp45-prod-card__body">
            <span class="hp45-prod-card__spec">[CONCENTRATE: {{ block.settings.spec | default: '15% ACTIVE' }}]</span>
            <h3 class="hp45-prod-card__title">{{ block.settings.title }}</h3>
            <div class="hp45-prod-card__price">{{ block.settings.price | default: '$64.00 USD' }}</div>
            <button class="hp45-prod-card__btn">{{ block.settings.btn_text | default: 'ACQUIRE DOSAGE' }}</button>
          </div>
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="hp45-prod-card">
        <div class="hp45-prod-card__media">
          <span class="hp45-prod-card__badge">SPEC 01</span>
          {{ 'product-1' | placeholder_svg_tag: 'hp45-prod-card__img' }}
        </div>
        <div class="hp45-prod-card__body">
          <span class="hp45-prod-card__spec">[CONCENTRATE: 20% COPPER PEPTIDE]</span>
          <h3 class="hp45-prod-card__title">CELLULAR MATRIX RECON</h3>
          <div class="hp45-prod-card__price">$74.00 USD</div>
          <button class="hp45-prod-card__btn">ACQUIRE DOSAGE</button>
        </div>
      </div>
      <div class="hp45-prod-card">
        <div class="hp45-prod-card__media">
          <span class="hp45-prod-card__badge">SPEC 02</span>
          {{ 'product-1' | placeholder_svg_tag: 'hp45-prod-card__img' }}
        </div>
        <div class="hp45-prod-card__body">
          <span class="hp45-prod-card__spec">[CONCENTRATE: 12% ECTOIN COMPLEX]</span>
          <h3 class="hp45-prod-card__title">EPIDERMAL DEFENSE SHIELD</h3>
          <div class="hp45-prod-card__price">$58.00 USD</div>
          <button class="hp45-prod-card__btn">ACQUIRE DOSAGE</button>
        </div>
      </div>
      <div class="hp45-prod-card">
        <div class="hp45-prod-card__media">
          <span class="hp45-prod-card__badge">SPEC 03</span>
          {{ 'product-1' | placeholder_svg_tag: 'hp45-prod-card__img' }}
        </div>
        <div class="hp45-prod-card__body">
          <span class="hp45-prod-card__spec">[CONCENTRATE: 5-MOLECULAR HA]</span>
          <h3 class="hp45-prod-card__title">OSMOTIC INFUSION FLUID</h3>
          <div class="hp45-prod-card__price">$48.00 USD</div>
          <button class="hp45-prod-card__btn">ACQUIRE DOSAGE</button>
        </div>
      </div>
      <div class="hp45-prod-card">
        <div class="hp45-prod-card__media">
          <span class="hp45-prod-card__badge">SPEC 04</span>
          {{ 'product-1' | placeholder_svg_tag: 'hp45-prod-card__img' }}
        </div>
        <div class="hp45-prod-card__body">
          <span class="hp45-prod-card__spec">[CONCENTRATE: MICRO-CERAMIDES]</span>
          <h3 class="hp45-prod-card__title">LIPID ARCHITECTURE BALM</h3>
          <div class="hp45-prod-card__price">$62.00 USD</div>
          <button class="hp45-prod-card__btn">ACQUIRE DOSAGE</button>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP45 - Brutal Grid",
  "class": "section-hp45-grid",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#F5F5F0" },
    { "type": "color", "id": "card_bg", "label": "Card Background", "default": "#FFFFFF" },
    { "type": "color", "id": "border_color", "label": "Border Color", "default": "#0A0A0A" },
    { "type": "color", "id": "title_color", "label": "Title Color", "default": "#0A0A0A" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "SYSTEM CATALOGUE // V45" },
    { "type": "text", "id": "view_all_text", "label": "View All Text", "default": "FULL CATALOGUE [→]" },
    { "type": "url", "id": "view_all_url", "label": "View All URL" },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "label": "Desktop Columns", "default": 4 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 80 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1300 }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "badge", "label": "Badge", "default": "SPEC 01" },
        { "type": "text", "id": "spec", "label": "Concentrate Spec", "default": "20% COPPER PEPTIDE" },
        { "type": "text", "id": "title", "label": "Product Title", "default": "CELLULAR MATRIX RECON" },
        { "type": "text", "id": "price", "label": "Price", "default": "$74.00 USD" },
        { "type": "text", "id": "btn_text", "label": "Button Label", "default": "ACQUIRE DOSAGE" },
        { "type": "url", "id": "url", "label": "Product Link" }
      ]
    }
  ],
  "presets": [
    { "name": "HP45 - Brutal Grid" }
  ]
}
{% endschema %}
