{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp46-trust-bg: {{ section.settings.bg_color | default: '#0B0F19' }};
    
    background-color: var(--hp46-trust-bg);
    padding: {{ section.settings.padding_vertical | default: 50 }}px 0;
    border-top: 1px solid rgba(56, 189, 248, 0.2);
  }

  .hp46-trust__grid {
    max-width: {{ section.settings.container_width | default: 1200 }}px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: 4 }}, 1fr);
    gap: 30px;
    text-align: center;
  }

  .hp46-trust__icon {
    font-size: 32px;
    margin-bottom: 12px;
    filter: drop-shadow(0 0 10px rgba(56, 189, 248, 0.5));
  }

  .hp46-trust__title {
    font-family: 'Syne', sans-serif;
    font-size: 16px;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0 0 6px;
  }

  .hp46-trust__desc {
    font-size: 13px;
    color: #94A3B8;
    margin: 0;
  }

  @media screen and (max-width: 992px) {
    .hp46-trust__grid { grid-template-columns: repeat(2, 1fr); }
  }
{%- endstyle -%}

<div class="hp46-trust__grid">
  {%- if section.blocks.size > 0 -%}
    {%- for block in section.blocks -%}
      <div {{ block.shopify_attributes }}>
        <div class="hp46-trust__icon">{{ block.settings.icon | default: '⚡' }}</div>
        <h4 class="hp46-trust__title">{{ block.settings.title }}</h4>
        <p class="hp46-trust__desc">{{ block.settings.description }}</p>
      </div>
    {%- endfor -%}
  {%- else -%}
    <div>
      <div class="hp46-trust__icon">⚡</div>
      <h4 class="hp46-trust__title">100% PURE BIO-TECH</h4>
      <p class="hp46-trust__desc">Certified vegan enzymatic synthesis.</p>
    </div>
    <div>
      <div class="hp46-trust__icon">✈️</div>
      <h4 class="hp46-trust__title">PRIORITY AIR DDP</h4>
      <p class="hp46-trust__desc">100% pre-paid customs in 180+ nations.</p>
    </div>
    <div>
      <div class="hp46-trust__icon">🛡️</div>
      <h4 class="hp46-trust__title">30-DAY GLOW TRIAL</h4>
      <p class="hp46-trust__desc">Complete satisfaction guarantee.</p>
    </div>
    <div>
      <div class="hp46-trust__icon">🔒</div>
      <h4 class="hp46-trust__title">256-BIT ENCRYPTED</h4>
      <p class="hp46-trust__desc">Zero-storage payment security.</p>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "HP46 - Cyber Badges",
  "class": "section-hp46-badges",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#0B0F19" },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "label": "Desktop Columns", "default": 4 },
    { "type": "range", "id": "padding_vertical", "min": 20, "max": 80, "step": 5, "unit": "px", "label": "Vertical Padding", "default": 50 },
    { "type": "range", "id": "container_width", "min": 800, "max": 1400, "step": 20, "unit": "px", "label": "Container Width", "default": 1200 }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon", "default": "⚡" },
        { "type": "text", "id": "title", "label": "Title", "default": "100% PURE BIO-TECH" },
        { "type": "text", "id": "description", "label": "Description", "default": "Certified vegan enzymatic synthesis." }
      ]
    }
  ],
  "presets": [
    { "name": "HP46 - Cyber Badges" }
  ]
}
{% endschema %}
