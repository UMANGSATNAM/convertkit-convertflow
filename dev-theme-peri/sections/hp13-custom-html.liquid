{%- liquid
  assign section_id = section.id
-%}

<div id="shopify-section-{{ section_id }}" class="hp13-custom-html-wrapper" style="padding: {{ section.settings.padding_top }}px {{ section.settings.padding_side }}px {{ section.settings.padding_bottom }}px;">
  {{ section.settings.custom_html }}
</div>

{% schema %}
{
  "name": "HP13 Custom HTML",
  "settings": [
    {
      "type": "html",
      "id": "custom_html",
      "label": "Custom HTML",
      "default": "<div style='text-align: center; font-family: Courier New, Courier, monospace; font-size: 14px; font-weight: bold; color: #00FFA3;'>/// CUSTOM_HTML_INJECT ///</div>"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_side",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Side",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "HP13 Custom HTML"
    }
  ]
}
{% endschema %}
