{%- liquid
  assign bg_color = section.settings.bg_color | default: '#e32636'
  assign text_color = section.settings.text_color | default: '#ffffff'
  
  assign padding_top_desktop = section.settings.padding_top_desktop
  assign padding_bottom_desktop = section.settings.padding_bottom_desktop
  assign padding_top_mobile = section.settings.padding_top_mobile
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile
-%}

<style>
  #shopify-section-{{ section.id }} {
    --hp2-ob-bg: {{ bg_color }};
    --hp2-ob-text: {{ text_color }};
    
    --hp2-ob-pt-desk: {{ padding_top_desktop }}px;
    --hp2-ob-pb-desk: {{ padding_bottom_desktop }}px;
    --hp2-ob-pt-mob: {{ padding_top_mobile }}px;
    --hp2-ob-pb-mob: {{ padding_bottom_mobile }}px;
  }

  .hp2-fashion-offer-{{ section.id }} {
    padding-top: var(--hp2-ob-pt-desk);
    padding-bottom: var(--hp2-ob-pb-desk);
    background-color: var(--hp2-ob-bg);
    color: var(--hp2-ob-text);
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
  }

  .hp2-ob-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .hp2-ob-label {
    display: inline-block;
    background: var(--hp2-ob-text);
    color: var(--hp2-ob-bg);
    padding: 6px 12px;
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 25px;
    border-radius: {{ section.settings.label_radius }}px;
  }

  .hp2-ob-title {
    font-size: clamp(32px, 5vw, 64px);
    font-weight: 900;
    text-transform: uppercase;
    line-height: 1;
    letter-spacing: -1px;
    margin: 0 0 20px 0;
  }
  
  .hp2-ob-code-box {
    margin: 20px 0 30px;
    padding: 15px 30px;
    border: 2px dashed var(--hp2-ob-text);
    font-size: 24px;
    font-weight: 800;
    letter-spacing: 4px;
    display: inline-block;
    position: relative;
    cursor: pointer;
    transition: all 0.3s ease;
  }
  .hp2-ob-code-box:hover {
    background: rgba(255,255,255,0.1);
  }
  
  .hp2-ob-copy-msg {
    position: absolute;
    top: -30px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 11px;
    background: var(--hp2-ob-text);
    color: var(--hp2-ob-bg);
    padding: 4px 8px;
    border-radius: 4px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
    white-space: nowrap;
  }
  .hp2-ob-copy-msg.show {
    opacity: 1;
  }

  .hp2-ob-desc {
    font-size: 16px;
    line-height: 1.5;
    max-width: 600px;
    margin: 0 auto 30px;
    opacity: 0.9;
  }

  .hp2-ob-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 18px 50px;
    text-decoration: none;
    text-transform: uppercase;
    font-weight: 800;
    letter-spacing: 1px;
    font-size: 14px;
    background: var(--hp2-ob-text);
    color: var(--hp2-ob-bg);
    transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  .hp2-ob-btn:hover {
    transform: scale(1.05);
    box-shadow: 0 10px 20px rgba(0,0,0,0.2);
  }

  /* Responsive Adjustments */
  @media screen and (max-width: 768px) {
    .hp2-fashion-offer-{{ section.id }} {
      padding-top: var(--hp2-ob-pt-mob);
      padding-bottom: var(--hp2-ob-pb-mob);
    }
    .hp2-ob-inner {
      padding: 0 20px;
    }
    .hp2-ob-code-box {
      font-size: 20px;
      padding: 12px 24px;
      width: 100%;
    }
    .hp2-ob-btn {
      width: 100%;
    }
  }
</style>

<section class="hp2-fashion-offer-{{ section.id }}" aria-label="Special Offer">
  <div class="hp2-ob-inner">
    
    {%- if section.settings.label != blank -%}
      <div class="hp2-ob-label">{{ section.settings.label }}</div>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="hp2-ob-title">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.description != blank -%}
      <p class="hp2-ob-desc">{{ section.settings.description }}</p>
    {%- endif -%}

    {%- if section.settings.discount_code != blank -%}
      <div class="hp2-ob-code-box" id="copyCode-{{ section.id }}" data-code="{{ section.settings.discount_code }}">
        {{ section.settings.discount_code }}
        <span class="hp2-ob-copy-msg" id="copyMsg-{{ section.id }}">Copied to clipboard!</span>
      </div>
    {%- endif -%}

    {%- if section.settings.btn_label != blank and section.settings.btn_link != blank -%}
      <a href="{{ section.settings.btn_link }}" class="hp2-ob-btn">
        {{ section.settings.btn_label }}
      </a>
    {%- endif -%}

  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const codeBox = document.getElementById('copyCode-{{ section.id }}');
    const copyMsg = document.getElementById('copyMsg-{{ section.id }}');
    
    if(codeBox && copyMsg) {
      codeBox.addEventListener('click', function() {
        const code = this.getAttribute('data-code');
        navigator.clipboard.writeText(code).then(function() {
          copyMsg.classList.add('show');
          setTimeout(() => {
            copyMsg.classList.remove('show');
          }, 2000);
        });
      });
    }
  });
</script>

{% schema %}
{
  "name": "HP2 Offer Banner",
  "tag": "section",
  "class": "section-hp2-offer",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Small Top Label",
      "default": "FLASH SALE"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Main Heading",
      "default": "GET 20% OFF EVERYTHING"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Exclusive weekend offer. Use the code below at checkout to claim your discount."
    },
    {
      "type": "text",
      "id": "discount_code",
      "label": "Discount Code (Click to Copy)",
      "default": "HYPE20"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "SHOP THE SALE"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#e32636"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Styling"
    },
    {
      "type": "range",
      "id": "label_radius",
      "min": 0, "max": 20, "step": 1, "unit": "px",
      "label": "Label Border Radius",
      "default": 0
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Top (Desktop)", "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Bottom (Desktop)", "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Top (Mobile)", "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Bottom (Mobile)", "default": 60
    }
  ],
  "presets": [
    {
      "name": "HP2 Offer Banner (Advanced)",
      "category": "Promotional"
    }
  ]
}
{% endschema %}
