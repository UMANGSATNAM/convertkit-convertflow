{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,100..900;1,9..144,100..900&family=Outfit:wght@300;400;600;800&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-orange: {{ section.settings.accent_orange }};
    --accent-yellow: {{ section.settings.accent_yellow }};
    --accent-green: {{ section.settings.accent_green }};
    --font-heading: 'Fraunces', serif;
    --font-body: 'Outfit', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    position: relative;
    border-top: 4px solid var(--text-color);
    border-bottom: 4px solid var(--text-color);
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }

  .hp25-pills-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
    text-align: center;
  }

  @media screen and (max-width: 768px) {
    .hp25-pills-wrapper {
      padding: 0 20px;
    }
  }

  .hp25-pills__title {
    font-family: var(--font-heading);
    font-size: clamp(28px, 4vw, {{ section.settings.title_size }}px);
    font-weight: 800;
    font-style: italic;
    color: var(--text-color);
    margin: 0 0 40px;
    letter-spacing: -0.02em;
  }

  .hp25-pills__container {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 20px;
  }

  @media screen and (max-width: 600px) {
    .hp25-pills__container {
      flex-wrap: nowrap;
      justify-content: flex-start;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-bottom: 20px;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .hp25-pills__container::-webkit-scrollbar {
      display: none;
    }
  }

  .hp25-pills__item {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    background-color: var(--bg-color);
    border: 3px solid var(--text-color);
    border-radius: 100px;
    padding: 12px 30px;
    position: relative;
    transition: all 0.3s ease;
    box-shadow: 4px 4px 0 var(--accent-orange);
  }

  @media screen and (max-width: 600px) {
    .hp25-pills__item {
      flex: 0 0 auto;
      scroll-snap-align: center;
    }
  }

  .hp25-pills__item:hover {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0 var(--accent-green);
    background-color: var(--accent-yellow);
  }

  .hp25-pills__icon {
    width: 24px;
    height: 24px;
    margin-right: 12px;
    fill: var(--text-color);
  }

  .hp25-pills__text {
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 800;
    color: var(--text-color);
    text-transform: uppercase;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp25-pills-wrapper" id="HP25Pills-{{ section.id }}">
  {%- if section.settings.title != blank -%}
    <h2 class="hp25-pills__title">{{ section.settings.title }}</h2>
  {%- endif -%}

  <div class="hp25-pills__container">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.link | default: '#' }}" class="hp25-pills__item" {{ block.shopify_attributes }}>
        {%- case block.settings.icon -%}
          {%- when 'sparkle' -%}
            <svg class="hp25-pills__icon" viewBox="0 0 24 24"><path d="M11.5,22C11.64,16.5 16.5,11.64 22,11.5C16.5,11.36 11.64,6.5 11.5,1C11.36,6.5 6.5,11.36 1,11.5C6.5,11.64 11.36,16.5 11.5,22M12.5,22C12.36,16.5 7.5,11.64 2,11.5C7.5,11.36 12.36,6.5 12.5,1C12.64,6.5 17.5,11.36 23,11.5C17.5,11.64 12.64,16.5 12.5,22Z" fill="currentColor"/></svg>
          {%- when 'flower' -%}
             <svg class="hp25-pills__icon" viewBox="0 0 24 24"><path d="M12,2C14.76,2 17,4.24 17,7C17,8.38 16.44,9.63 15.54,10.54C16.45,11.44 17.71,12 19,12C21.76,12 24,14.24 24,17C24,19.76 21.76,22 19,22C17.62,22 16.37,21.44 15.46,20.54C14.56,21.45 13.3,22 12,22C9.24,22 7,19.76 7,17C7,15.62 7.56,14.37 8.46,13.46C7.55,12.56 6.29,12 5,12C2.24,12 0,9.76 0,7C0,4.24 2.24,2 5,2C6.38,2 7.63,2.56 8.54,3.46C9.44,2.55 10.7,2 12,2Z" fill="currentColor"/></svg>
          {%- when 'sun' -%}
            <svg class="hp25-pills__icon" viewBox="0 0 24 24"><path d="M12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9M12,2L14.39,5.42C13.65,5.15 12.84,5 12,5C11.16,5 10.35,5.15 9.61,5.42L12,2M3.34,7L7.5,7.65C7.9,7.08 8.4,6.56 8.97,6.11L5.86,3.34L3.34,7M2,12L5.42,9.61C5.15,10.35 5,11.16 5,12C5,12.84 5.15,13.65 5.42,14.39L2,12M7,20.66L9.61,18.58C10.35,18.85 11.16,19 12,19C12.84,19 13.65,18.85 14.39,18.58L17,20.66L12,22L7,20.66M16.5,16.35C16.1,16.92 15.6,17.44 15.03,17.89L18.14,20.66L20.66,17L16.5,16.35M22,12L18.58,14.39C18.85,13.65 19,12.84 19,12C19,11.16 18.85,10.35 18.58,9.61L22,12Z" fill="currentColor"/></svg>
          {%- else -%}
            <!-- none -->
        {%- endcase -%}
        
        <span class="hp25-pills__text">{{ block.settings.title }}</span>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "HP25 - Retro Pills",
  "class": "section-hp25-category-pills",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Shop by Vibe"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 800,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1200
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 40
    },
    {
      "type": "header",
      "content": "Retro 70s Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#76834F"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text / Border (Dark Brown)",
      "default": "#3E2723"
    },
    {
      "type": "color",
      "id": "accent_orange",
      "label": "Accent (Burnt Orange)",
      "default": "#D15F3C"
    },
    {
      "type": "color",
      "id": "accent_yellow",
      "label": "Accent (Mustard)",
      "default": "#E2B144"
    },
    {
      "type": "color",
      "id": "accent_green",
      "label": "Accent (Avocado Green)",
      "default": "#F5E6D3"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 60
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Category"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "flower", "label": "Flower" },
            { "value": "sun", "label": "Sun" }
          ],
          "default": "flower"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP25 - Retro Pills",
      "blocks": [
        { "type": "category", "settings": { "title": "Denim", "icon": "flower" } },
        { "type": "category", "settings": { "title": "Shirts", "icon": "sparkle" } },
        { "type": "category", "settings": { "title": "Dresses", "icon": "sun" } },
        { "type": "category", "settings": { "title": "Accessories", "icon": "flower" } },
        { "type": "category", "settings": { "title": "Shoes", "icon": "sparkle" } }
      ]
    }
  ]
}
{% endschema %}
