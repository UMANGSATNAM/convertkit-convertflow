{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;1,400&family=Nunito:wght@300;400;600&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    
    --font-heading: 'Lora', serif;
    --font-body: 'Nunito', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    border-top: 1px solid rgba(0,0,0,0.05);
    border-bottom: 1px solid rgba(0,0,0,0.05);
  }

  .hp35-press-wrapper {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
  }

  @media screen and (max-width: 992px) {
    .hp35-press-wrapper {
      flex-direction: column;
      text-align: center;
    }
  }

  .hp35-press__title {
    font-family: var(--font-heading);
    font-size: 24px;
    font-style: italic;
    color: var(--accent-color);
    margin: 0;
    white-space: nowrap;
  }

  .hp35-press__logos {
    display: flex;
    align-items: center;
    justify-content: space-around;
    flex-wrap: wrap;
    gap: 40px;
    flex: 1;
    opacity: 0.6;
    filter: grayscale(100%);
    transition: all 0.3s ease;
  }

  .hp35-press__logos:hover {
    opacity: 1;
    filter: grayscale(0%);
  }

  .hp35-press__logo {
    max-height: 30px;
    width: auto;
  }
  
  .hp35-press__logo-text {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp35-press-wrapper" id="HP35Press-{{ section.id }}">
  <h2 class="hp35-press__title">{{ section.settings.title }}</h2>
  
  <div class="hp35-press__logos">
    {%- for block in section.blocks -%}
      {%- if block.settings.image != blank -%}
        <img height="{{ block.settings.image.height }}" width="{{ block.settings.image.width }}" src="{{ block.settings.image | image_url: height: 60 }}" alt="Press Logo" class="hp35-press__logo" loading="lazy">
      {%- else -%}
        <span class="hp35-press__logo-text">{{ block.settings.text_fallback }}</span>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "HP35 - Organic Press",
  "class": "section-hp35-press-logos",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Recognized in"
    },
    {
      "type": "header",
      "content": "Organic Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#FDFBF7"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2C422F"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#CC7B5E"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 60
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Press Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo Image"
        },
        {
          "type": "text",
          "id": "text_fallback",
          "label": "Text Fallback",
          "default": "VOGUE"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP35 - Organic Press",
      "blocks": [
        { "type": "logo", "settings": { "text_fallback": "VOGUE" } },
        { "type": "logo", "settings": { "text_fallback": "KINFOLK" } },
        { "type": "logo", "settings": { "text_fallback": "CEREAL" } },
        { "type": "logo", "settings": { "text_fallback": "MONOCLE" } }
      ]
    }
  ]
}
{% endschema %}
