<style>
@media screen and (max-width: 768px) {
  .hp44-press-logos {
    padding-left: 16px !important;
    padding-right: 16px !important;
    box-sizing: border-box !important;
  }
  img {
    max-width: 100% !important;
    height: auto !important;
  }
}
</style>
{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp44-press-bg: {{ section.settings.bg_color | default: '#EDF4EE' }};
    --hp44-press-color: {{ section.settings.text_color | default: '#143D2B' }};
    --hp44-press-border: {{ section.settings.border_color | default: '#D8E8DC' }};
    
    background-color: var(--hp44-press-bg);
    padding-top: {{ section.settings.padding_top | default: 35 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 35 }}px;
    border-top: 1px solid var(--hp44-press-border);
    border-bottom: 1px solid var(--hp44-press-border);
  }

  .hp44-press__wrap {
    max-width: {{ section.settings.container_width | default: 1100 }}px;
    margin: 0 auto;
    padding: 0 20px;
    display: flex;
    justify-content: space-around;
    align-items: center;
    flex-wrap: wrap;
    gap: 30px;
    font-family: 'Playfair Display', serif;
    font-size: 20px;
    font-weight: 700;
    color: var(--hp44-press-color);
    opacity: 0.85;
    letter-spacing: 1px;
  }
{%- endstyle -%}

<div class="hp44-press__wrap">
  {%- if section.blocks.size > 0 -%}
    {%- for block in section.blocks -%}
      <span {{ block.shopify_attributes }}>{{ block.settings.title }}</span>
    {%- endfor -%}
  {%- else -%}
    <span>VOGUE SCANDINAVIA</span>
    <span>ELLE DENMARK</span>
    <span>NORDIC BOTANICS</span>
    <span>BAZAAR SWEDEN</span>
    <span>HERBARIUM MAG</span>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "HP44 - Sage Press",
  "class": "section-hp44-press",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#EDF4EE" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#143D2B" },
    { "type": "color", "id": "border_color", "label": "Border Color", "default": "#D8E8DC" },
    { "type": "range", "id": "padding_top", "min": 15, "max": 80, "step": 5, "unit": "px", "label": "Padding Top", "default": 35 },
    { "type": "range", "id": "padding_bottom", "min": 15, "max": 80, "step": 5, "unit": "px", "label": "Padding Bottom", "default": 35 },
    { "type": "range", "id": "container_width", "min": 800, "max": 1400, "step": 20, "unit": "px", "label": "Container Width", "default": 1100 }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Press Mention",
      "settings": [
        { "type": "text", "id": "title", "label": "Publication Name", "default": "VOGUE SCANDINAVIA" }
      ]
    }
  ],
  "presets": [
    { "name": "HP44 - Sage Press" }
  ]
}
{% endschema %}
