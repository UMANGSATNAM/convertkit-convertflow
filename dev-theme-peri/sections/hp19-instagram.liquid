{%- style -%}
  #shopify-section-{{ section.id }} {
    --padding-top: {{ section.settings.padding_top }}px;
    --padding-bottom: {{ section.settings.padding_bottom }}px;
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --grid-gap: {{ section.settings.grid_gap }}px;
    
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
    background-color: var(--bg-color);
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      --padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      --padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
      --grid-gap: {{ section.settings.mobile_grid_gap }}px;
    }
  }

  .hp19-insta-wrapper {
    {% if section.settings.full_width %}
      max-width: 100%;
      padding: 0;
    {% else %}
      max-width: {{ section.settings.max_width }}px;
      margin: 0 auto;
      padding: 0 24px;
    {% endif %}
  }

  .hp19-insta__header {
    text-align: {{ section.settings.header_alignment }};
    margin-bottom: {{ section.settings.header_margin }}px;
    padding: {% if section.settings.full_width %}0 24px{% else %}0{% endif %};
  }

  .hp19-insta__title {
    font-family: 'Baskerville', 'Georgia', serif;
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    color: var(--text-color);
    margin: 0 0 8px;
    font-style: italic;
  }
  
  .hp19-insta__subtitle {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--text-color);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: opacity 0.3s;
  }
  .hp19-insta__subtitle:hover { opacity: 0.7; }

  .hp19-insta__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.desktop_columns }}, 1fr);
    gap: var(--grid-gap);
  }

  @media screen and (max-width: 992px) {
    .hp19-insta__grid {
      grid-template-columns: repeat({{ section.settings.tablet_columns }}, 1fr);
    }
  }

  @media screen and (max-width: 576px) {
    .hp19-insta__grid {
      grid-template-columns: repeat({{ section.settings.mobile_columns }}, 1fr);
    }
  }

  .hp19-insta__item {
    position: relative;
    aspect-ratio: 1/1;
    overflow: hidden;
    background: #000;
    display: block;
    border-radius: {% if section.settings.full_width and section.settings.grid_gap == 0 %}0{% else %}{{ section.settings.image_radius }}px{% endif %};
  }

  .hp19-insta__item img {
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.165, 0.84, 0.44, 1);
  }

  .hp19-insta__overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0,0,0,0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    color: #fff;
    opacity: 0;
    transition: all 0.4s ease;
  }

  .hp19-insta__item:hover img {
    transform: scale(1.08);
  }

  .hp19-insta__item:hover .hp19-insta__overlay {
    opacity: 1;
  }
  
  .hp19-insta__stat {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: 'Inter', sans-serif;
    font-weight: 600;
    font-size: 16px;
    transform: translateY(10px);
    transition: transform 0.4s ease;
  }
  
  .hp19-insta__item:hover .hp19-insta__stat {
    transform: translateY(0);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp19-insta-wrapper" id="HP19Insta-{{ section.id }}">
  <div class="hp19-insta__header">
    {%- if section.settings.title != blank -%}
      <h2 class="hp19-insta__title">{{ section.settings.title | escape }}</h2>
    {%- endif -%}
    
    {%- if section.settings.handle != blank -%}
      <a href="{{ section.settings.link | default: '#' }}" target="_blank" class="hp19-insta__subtitle">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
          <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
        </svg>
        {{ section.settings.handle | escape }}
      </a>
    {%- endif -%}
  </div>

  <div class="hp19-insta__grid">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.link | default: '#' }}" target="_blank" class="hp19-insta__item" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          <img src="{{ block.settings.image | image_url: width: 600 }}" alt="Instagram image" loading="lazy">
        {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
        
        <div class="hp19-insta__overlay">
          <div class="hp19-insta__stat">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
            </svg>
            {{ block.settings.likes | default: '124' }}
          </div>
          <div class="hp19-insta__stat">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
            </svg>
            {{ block.settings.comments | default: '12' }}
          </div>
        </div>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "HP19 - Instagram Pro",
  "class": "section-hp19-instagram",
  "max_blocks": 12,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Join The Community"
    },
    {
      "type": "text",
      "id": "handle",
      "label": "Instagram Handle",
      "default": "@yourbrand"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Instagram Link"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 48
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "header_margin",
      "min": 20,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Spacing Below Header",
      "default": 48
    },
    {
      "type": "header",
      "content": "Grid Layout"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Make grid full width",
      "default": false
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 800,
      "max": 2000,
      "step": 50,
      "unit": "px",
      "label": "Max Width (If not full width)",
      "default": 1400
    },
    {
      "type": "range",
      "id": "desktop_columns",
      "min": 3,
      "max": 8,
      "step": 1,
      "label": "Desktop Columns",
      "default": 5
    },
    {
      "type": "range",
      "id": "tablet_columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Tablet Columns",
      "default": 4
    },
    {
      "type": "range",
      "id": "mobile_columns",
      "min": 1,
      "max": 3,
      "step": 1,
      "label": "Mobile Columns",
      "default": 2
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Grid Gap (Desktop)",
      "default": 16
    },
    {
      "type": "range",
      "id": "mobile_grid_gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Grid Gap (Mobile)",
      "default": 8
    },
    {
      "type": "range",
      "id": "image_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Image Border Radius",
      "default": 0
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#FFFBEB"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#451A03"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 100
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Instagram Post",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Post Image"
        },
        {
          "type": "text",
          "id": "likes",
          "label": "Like Count",
          "default": "245"
        },
        {
          "type": "text",
          "id": "comments",
          "label": "Comment Count",
          "default": "18"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link to Post"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP19 - Instagram Pro",
      "category": "Social",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
