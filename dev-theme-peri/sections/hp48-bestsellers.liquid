{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp48-bs-bg: {{ section.settings.bg_color | default: '#FAF8F5' }};
    --hp48-gold: {{ section.settings.accent_gold | default: '#C59B27' }};
    
    background-color: var(--hp48-bs-bg);
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }

  .hp48-bs__wrap {
    max-width: {{ section.settings.container_width | default: 1280 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp48-bs__header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 50px;
  }

  .hp48-bs__heading {
    font-family: 'Cinzel', serif;
    font-size: clamp(30px, 4vw, 42px);
    font-weight: 700;
    color: #1A1715;
    margin: 0 0 8px;
  }

  .hp48-bs__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: 3 }}, 1fr);
    gap: 24px;
  }

  .hp48-bs__card {
    background: #FFFFFF;
    border: 1px solid rgba(197, 155, 39, 0.3);
    border-radius: 8px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    box-shadow: 0 10px 30px rgba(26, 23, 21, 0.04);
    transition: all 0.3s ease;
  }

  .hp48-bs__card:hover {
    border-color: var(--hp48-gold);
    transform: translateY(-6px);
    box-shadow: 0 20px 50px rgba(197, 155, 39, 0.15);
  }

  .hp48-bs__img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 6px;
    margin-bottom: 20px;
  }

  .hp48-bs__title {
    font-family: 'Cinzel', serif;
    font-size: 18px;
    font-weight: 700;
    color: #1A1715;
    margin: 0 0 8px;
  }

  .hp48-bs__price {
    font-size: 16px;
    font-weight: 700;
    color: var(--hp48-gold);
    margin-bottom: 18px;
  }

  .hp48-bs__btn {
    width: 100%;
    margin-top: auto;
    padding: 13px;
    background: #1A1715;
    color: #FAF8F5;
    border: 1px solid var(--hp48-gold);
    border-radius: 4px;
    font-family: 'Montserrat', sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .hp48-bs__btn:hover { background: var(--hp48-gold); color: #1A1715; }

  @media screen and (max-width: 992px) {
    .hp48-bs__grid { grid-template-columns: 1fr; max-width: 460px; margin: 0 auto; }
  }
{%- endstyle -%}

<div class="hp48-bs__wrap">
  <div class="hp48-bs__header">
    <h2 class="hp48-bs__heading">{{ section.settings.heading | default: 'The Sovereign Bestseller Reserve' }}</h2>
    <p style="font-size:13px; color:#5C554E; letter-spacing:0.5px;">{{ section.settings.subheading | default: 'Coveted by discerning patrons in Geneva, London, and Dubai.' }}</p>
  </div>

  <div class="hp48-bs__grid">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <div class="hp48-bs__card" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 600 }}" class="hp48-bs__img" alt="{{ block.settings.title }}" loading="lazy">
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'hp48-bs__img' }}
          {%- endif -%}
          <h3 class="hp48-bs__title">{{ block.settings.title }}</h3>
          <div class="hp48-bs__price">{{ block.settings.price | default: '$165.00 USD' }}</div>
          <button class="hp48-bs__btn">{{ block.settings.btn_text | default: 'Acquire Ritual' }}</button>
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="hp48-bs__card">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'hp48-bs__img' }}
        <h3 class="hp48-bs__title">Sovereign 24K Gold Cellular Nectar</h3>
        <div class="hp48-bs__price">$165.00 USD</div>
        <button class="hp48-bs__btn">Acquire Ritual</button>
      </div>
      <div class="hp48-bs__card">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'hp48-bs__img' }}
        <h3 class="hp48-bs__title">Champagne Pearl Velvet Crème</h3>
        <div class="hp48-bs__price">$145.00 USD</div>
        <button class="hp48-bs__btn">Acquire Ritual</button>
      </div>
      <div class="hp48-bs__card">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'hp48-bs__img' }}
        <h3 class="hp48-bs__title">Imperial Pearl Illuminating Oil</h3>
        <div class="hp48-bs__price">$130.00 USD</div>
        <button class="hp48-bs__btn">Acquire Ritual</button>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP48 - Royal Best",
  "class": "section-hp48-bestsellers",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#FAF8F5" },
    { "type": "color", "id": "accent_gold", "label": "Gold Accent", "default": "#C59B27" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Sovereign Bestseller Reserve" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Coveted by discerning patrons in Geneva, London, and Dubai." },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "label": "Desktop Columns", "default": 3 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Sovereign 24K Gold Cellular Nectar" },
        { "type": "text", "id": "price", "label": "Price", "default": "$165.00 USD" },
        { "type": "text", "id": "btn_text", "label": "Button Text", "default": "Acquire Ritual" },
        { "type": "url", "id": "url", "label": "Link URL" }
      ]
    }
  ],
  "presets": [
    { "name": "HP48 - Royal Best" }
  ]
}
{% endschema %}
