{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#0A0A0A'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 100px 40px;
    border-bottom: 1px solid rgba(0, 255, 65, 0.3);
  }
  
  .hp17-compare-container-{{ section_id }} {
    max-width: 1000px;
    margin: 0 auto;
  }
  
  .hp17-compare-header-{{ section_id }} {
    text-align: center;
    margin-bottom: 50px;
  }
  
  .hp17-compare-title-{{ section_id }} {
    font-family: 'Arial Black', sans-serif;
    font-size: clamp(2rem, 4vw, 3.5rem);
    text-transform: uppercase;
    color: #FFF;
    margin: 0;
    letter-spacing: 2px;
  }
  
  .hp17-compare-table-{{ section_id }} {
    width: 100%;
    border-collapse: collapse;
    background: #000;
    border: 1px solid rgba(0, 255, 65, 0.5);
  }
  
  .hp17-compare-table-{{ section_id }} th,
  .hp17-compare-table-{{ section_id }} td {
    padding: 20px;
    border: 1px solid rgba(0, 255, 65, 0.2);
    font-family: 'Courier New', Courier, monospace;
    font-size: 1rem;
    text-align: center;
  }
  
  .hp17-compare-table-{{ section_id }} th {
    background: rgba(0, 255, 65, 0.1);
    color: #00FF41;
    font-size: 1.2rem;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 2px;
  }
  
  .hp17-compare-table-{{ section_id }} th:first-child {
    text-align: left;
    background: #000;
    color: rgba(255,255,255,0.5);
  }
  
  .hp17-compare-table-{{ section_id }} td:first-child {
    text-align: left;
    font-weight: bold;
    color: #FFF;
  }
  
  .hp17-compare-table-{{ section_id }} td:nth-child(2) {
    color: #00FF41;
  }
  
  .hp17-compare-table-{{ section_id }} td:nth-child(3) {
    color: rgba(255,0,0,0.7);
    text-decoration: line-through;
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 60px 20px;
    }
    .hp17-compare-table-{{ section_id }} th,
    .hp17-compare-table-{{ section_id }} td {
      padding: 15px 10px;
      font-size: 0.8rem;
    }
  }
</style>

<div class="hp17-compare-container-{{ section_id }}">
  <div class="hp17-compare-header-{{ section_id }}">
    <h2 class="hp17-compare-title-{{ section_id }}">{{ section.settings.title | default: 'US VS THEM' }}</h2>
  </div>
  
  <table class="hp17-compare-table-{{ section_id }}">
    <thead>
      <tr>
        <th>SPECIFICATION</th>
        <th>{{ shop.name | default: 'CYBER_TECH' }}</th>
        <th>CORP GEAR</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>DURABILITY</td>
        <td>MIL-SPEC KEVLAR</td>
        <td>BASIC COTTON</td>
      </tr>
      <tr>
        <td>RFID SHIELDING</td>
        <td>100% BLOCK</td>
        <td>NONE</td>
      </tr>
      <tr>
        <td>AESTHETIC</td>
        <td>NEO-TOKYO</td>
        <td>BASIC</td>
      </tr>
      <tr>
        <td>PRICE TO PERFORMANCE</td>
        <td>OPTIMIZED</td>
        <td>OVERPRICED</td>
      </tr>
    </tbody>
  </table>
</div>

{% schema %}
{
  "name": "HP17 Comparison Table",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#0A0A0A"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "US VS THEM"
    }
  ],
  "presets": [
    {
      "name": "HP17 Comparison Table"
    }
  ]
}
{% endschema %}
