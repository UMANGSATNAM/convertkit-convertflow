{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#ffffff'
  assign text_color = section.settings.text_color | default: '#000000'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 120px 40px;
  }
  
  .hp15-featured-container-{{ section_id }} {
    max-width: 1600px;
    margin: 0 auto;
    display: flex;
    gap: 60px;
    align-items: center;
  }
  
  .hp15-featured-content-{{ section_id }} {
    flex: 1;
  }
  
  .hp15-featured-products-{{ section_id }} {
    flex: 2;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2px;
    background: rgba(0,0,0,0.1);
    border: 1px solid rgba(0,0,0,0.1);
  }
  
  .hp15-featured-subtitle-{{ section_id }} {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 3px;
    margin-bottom: 20px;
    color: {{ text_color }};
  }
  
  .hp15-featured-title-{{ section_id }} {
    font-family: 'Didot', 'Playfair Display', serif;
    font-size: clamp(2.5rem, 4vw, 4rem);
    font-weight: normal;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin: 0 0 30px 0;
    color: {{ text_color }};
    line-height: 1.1;
  }
  
  .hp15-featured-btn-{{ section_id }} {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: {{ text_color }};
    text-decoration: none;
    border-bottom: 1px solid {{ text_color }};
    padding-bottom: 5px;
    display: inline-block;
  }

  .hp15-product-card-{{ section_id }} {
    background: {{ bg_color }};
    position: relative;
    text-decoration: none;
    color: {{ text_color }};
    display: flex;
    flex-direction: column;
  }
  
  .hp15-product-image-wrap-{{ section_id }} {
    position: relative;
    padding-top: 130%;
    overflow: hidden;
  }
  
  .hp15-product-image-{{ section_id }} {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover;
    filter: grayscale(100%);
    transition: filter 0.5s ease;
  }
  
  .hp15-product-card-{{ section_id }}:hover .hp15-product-image-{{ section_id }} {
    filter: grayscale(0%);
  }
  
  .hp15-product-info-{{ section_id }} {
    padding: 20px;
    text-align: center;
  }
  
  .hp15-product-card-title-{{ section_id }} {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    margin: 0 0 10px 0;
  }
  
  .hp15-product-price-{{ section_id }} {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.85rem;
    color: #666;
  }

  @media (max-width: 992px) {
    .hp15-featured-container-{{ section_id }} {
      flex-direction: column;
    }
  }
  
  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 60px 20px;
    }
    .hp15-featured-products-{{ section_id }} {
      grid-template-columns: 1fr;
    }
  }
</style>

<div class="hp15-featured-container-{{ section_id }}">
  <div class="hp15-featured-content-{{ section_id }}">
    <div class="hp15-featured-subtitle-{{ section_id }}">{{ section.settings.subtitle | default: 'EDIT 01' }}</div>
    <h2 class="hp15-featured-title-{{ section_id }}">{{ section.settings.title | default: 'ESSENTIALS' }}</h2>
    <a href="{{ collections[section.settings.collection].url | default: '#' }}" class="hp15-featured-btn-{{ section_id }}">SHOP THE EDIT</a>
  </div>
  
  <div class="hp15-featured-products-{{ section_id }}">
    {% assign collection = collections[section.settings.collection] %}
    {% if collection != blank and collection.products_count > 0 %}
      {% for product in collection.products limit: 2 %}
        <a href="{{ product.url }}" class="hp15-product-card-{{ section_id }}">
          <div class="hp15-product-image-wrap-{{ section_id }}">
            <img src="{{ product.featured_image | image_url: width: 800 }}" class="hp15-product-image-{{ section_id }}" loading="lazy" alt="{{ product.title }}">
          </div>
          <div class="hp15-product-info-{{ section_id }}">
            <h3 class="hp15-product-card-title-{{ section_id }}">{{ product.title }}</h3>
            <div class="hp15-product-price-{{ section_id }}">{{ product.price | money }}</div>
          </div>
        </a>
      {% endfor %}
    {% else %}
      {% for i in (1..2) %}
        <a href="#" class="hp15-product-card-{{ section_id }}">
          <div class="hp15-product-image-wrap-{{ section_id }}">
            <div class="hp15-product-image-{{ section_id }}" style="background: repeating-linear-gradient(45deg, #EFEFEF, #EFEFEF 12px, #E6E6E6 12px, #E6E6E6 24px);"></div>
          </div>
          <div class="hp15-product-info-{{ section_id }}">
            <h3 class="hp15-product-card-title-{{ section_id }}">{{ 'LEATHER TOTE' }}</h3>
            <div class="hp15-product-price-{{ section_id }}">$1,200.00</div>
          </div>
        </a>
      {% endfor %}
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "HP15 Featured Products",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "EDIT 01"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "ESSENTIALS"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    }
  ],
  "presets": [
    {
      "name": "HP15 Featured Products"
    }
  ]
}
{% endschema %}
