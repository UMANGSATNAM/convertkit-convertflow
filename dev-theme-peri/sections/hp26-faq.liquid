{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --font-heading: 'Cormorant Garamond', serif;
    --font-body: 'Inter', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.8 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.8 | round }}px;
    }
  }

  .hp26-faq-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    gap: 80px;
    align-items: flex-start;
  }

  @media screen and (max-width: 992px) {
    .hp26-faq-wrapper {
      flex-direction: column;
      gap: 50px;
    }
  }

  @media screen and (max-width: 768px) {
    .hp26-faq-wrapper {
      padding: 0 20px;
    }
  }

  .hp26-faq__sidebar {
    flex: 0 0 350px;
    position: sticky;
    top: 40px;
  }

  @media screen and (max-width: 992px) {
    .hp26-faq__sidebar {
      flex: none;
      width: 100%;
      position: static;
      text-align: center;
    }
  }

  .hp26-faq__subtitle {
    font-family: var(--font-body);
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-color);
    margin-bottom: 20px;
    opacity: 0.6;
  }

  .hp26-faq__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    font-weight: 400;
    line-height: 1.1;
    color: var(--text-color);
    margin: 0 0 20px;
  }

  .hp26-faq__title em {
    font-style: italic;
    font-weight: 300;
  }

  .hp26-faq__text {
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-color);
    opacity: 0.7;
    margin: 0 0 30px;
  }

  .hp26-faq__link {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-color);
    text-decoration: none;
    position: relative;
    padding-bottom: 4px;
  }

  .hp26-faq__link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 1px;
    background-color: var(--text-color);
    opacity: 0.3;
    transition: opacity 0.3s ease;
  }

  .hp26-faq__link:hover::after {
    opacity: 1;
  }

  .hp26-faq__accordion {
    flex: 1;
    width: 100%;
  }

  .hp26-faq__item {
    border-bottom: 1px solid rgba(44, 42, 40, 0.1);
  }

  .hp26-faq__item:first-child {
    border-top: 1px solid rgba(44, 42, 40, 0.1);
  }

  .hp26-faq__question {
    width: 100%;
    text-align: left;
    background: none;
    border: none;
    padding: 30px 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 400;
    color: var(--text-color);
    transition: opacity 0.3s ease;
  }

  @media screen and (max-width: 768px) {
    .hp26-faq__question {
      padding: 20px 0;
      font-size: 15px;
    }
  }

  .hp26-faq__question:hover {
    opacity: 0.7;
  }

  .hp26-faq__icon {
    position: relative;
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    margin-left: 20px;
  }

  .hp26-faq__icon::before,
  .hp26-faq__icon::after {
    content: '';
    position: absolute;
    background-color: var(--text-color);
    transition: transform 0.4s ease;
  }

  /* Horizontal line */
  .hp26-faq__icon::before {
    top: 50%;
    left: 0;
    width: 100%;
    height: 1px;
    transform: translateY(-50%);
  }

  /* Vertical line */
  .hp26-faq__icon::after {
    top: 0;
    left: 50%;
    width: 1px;
    height: 100%;
    transform: translateX(-50%);
  }

  .hp26-faq__item.is-open .hp26-faq__icon::after {
    transform: translateX(-50%) rotate(90deg);
  }

  .hp26-faq__answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .hp26-faq__answer-inner {
    padding-bottom: 30px;
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.7;
    color: var(--text-color);
    opacity: 0.7;
    max-width: 600px;
  }

  @media screen and (max-width: 768px) {
    .hp26-faq__answer-inner {
      padding-bottom: 20px;
    }
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp26-faq-wrapper" id="HP26FAQ-{{ section.id }}">
  
  <div class="hp26-faq__sidebar">
    {%- if section.settings.subtitle != blank -%}
      <div class="hp26-faq__subtitle">{{ section.settings.subtitle }}</div>
    {%- endif -%}

    {%- if section.settings.title != blank -%}
      <h2 class="hp26-faq__title">{{ section.settings.title }}</h2>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <p class="hp26-faq__text">{{ section.settings.text }}</p>
    {%- endif -%}

    {%- if section.settings.link_text != blank -%}
      <a href="{{ section.settings.link_url | default: '#' }}" class="hp26-faq__link">{{ section.settings.link_text }}</a>
    {%- endif -%}
  </div>

  <div class="hp26-faq__accordion">
    {%- for block in section.blocks -%}
      <div class="hp26-faq__item" {{ block.shopify_attributes }}>
        <button class="hp26-faq__question" aria-expanded="false">
          {{ block.settings.question }}
          <span class="hp26-faq__icon"></span>
        </button>
        <div class="hp26-faq__answer">
          <div class="hp26-faq__answer-inner">
            {{ block.settings.answer }}
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>

</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const faqContainer = document.querySelector('#HP26FAQ-{{ section.id }}');
    if(!faqContainer) return;

    const questions = faqContainer.querySelectorAll('.hp26-faq__question');

    questions.forEach(btn => {
      btn.addEventListener('click', function() {
        const item = this.closest('.hp26-faq__item');
        const answer = item.querySelector('.hp26-faq__answer');
        const isOpen = item.classList.contains('is-open');

        // Close all others
        faqContainer.querySelectorAll('.hp26-faq__item').forEach(otherItem => {
          if(otherItem !== item) {
            otherItem.classList.remove('is-open');
            otherItem.querySelector('.hp26-faq__question').setAttribute('aria-expanded', 'false');
            otherItem.querySelector('.hp26-faq__answer').style.maxHeight = null;
          }
        });

        // Toggle current
        if(isOpen) {
          item.classList.remove('is-open');
          this.setAttribute('aria-expanded', 'false');
          answer.style.maxHeight = null;
        } else {
          item.classList.add('is-open');
          this.setAttribute('aria-expanded', 'true');
          answer.style.maxHeight = answer.scrollHeight + "px";
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "HP26 - Japandi FAQ",
  "class": "section-hp26-faq",
  "settings": [
    {
      "type": "header",
      "content": "Sidebar Content"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "KNOWLEDGE BASE"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Questions, <em>answered</em>."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Find everything you need to know about our products, sourcing, and care instructions."
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link Text",
      "default": "CONTACT CONCIERGE"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 800,
      "max": 1400,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1200
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 32,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 48
    },
    {
      "type": "header",
      "content": "Japandi Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#F5F2EB"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2C2A28"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 100
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How should I care for my ceramics?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Our ceramics are dishwasher and microwave safe, though hand-washing is recommended to preserve their unique finish over time.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP26 - Japandi FAQ",
      "blocks": [
        { "type": "faq" },
        { "type": "faq", "settings": { "question": "Where are your materials sourced?" } },
        { "type": "faq", "settings": { "question": "Do you offer international shipping?" } },
        { "type": "faq", "settings": { "question": "What is your return policy?" } }
      ]
    }
  ]
}
{% endschema %}
