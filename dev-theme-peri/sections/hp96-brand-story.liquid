{%- style -%}#shopify-section-{{ section.id }}{background:{{ section.settings.bg_color | default: '#ECFEFF' }};padding:70px 0}.hp96-story{max-width:1280px;margin:0 auto;padding:0 24px;display:grid;grid-template-columns:.9fr 1.1fr;gap:40px;align-items:center}@media(max-width:768px){.hp96-story{grid-template-columns:1fr}}.hp96-story__img{border-radius:16px;overflow:hidden;height:420px}.hp96-story__img img{width:100%;height:100%;object-fit:cover}{%- endstyle -%}<div class="hp96-story"><div class="hp96-story__img">{% if section.settings.image != blank %}<img src="{{ section.settings.image | image_url: width: 800 }}" alt="story" loading="lazy">{% else %}{{ 'collection-1' | placeholder_svg_tag }} {% endif %}</div><div><p style="font-size:12px;letter-spacing:2px;text-transform:uppercase;color:#06B6D4;font-weight:700;margin:0 0 12px">{{ section.settings.kicker | default: 'Our Story' }}</p><h2 style="font-family:Syne,sans-serif;font-size:32px;font-weight:800;margin:0 0 14px;line-height:1.1">{{ section.settings.heading | default: 'Crafted for activewear' }}</h2><p style="opacity:.7;line-height:1.7">{{ section.settings.text | default: 'Seamless stretch, breathable knit & sweat-wicking tech for every rep.' }}</p><a href="{{ section.settings.url }}" style="display:inline-block;margin-top:18px;padding:12px 22px;background:#06B6D4;color:#fff;border-radius:8px;text-decoration:none;font-weight:700;font-size:13px;letter-spacing:1px;text-transform:uppercase">{{ section.settings.btn | default: 'Learn More' }}</a></div></div>{% schema %}{"name":"HP96 Brand Story","settings":[{"type":"color","id":"bg_color","label":"BG","default":"#ECFEFF"},{"type":"text","id":"kicker","label":"Kicker","default":"Our Story"},{"type":"text","id":"heading","label":"Heading","default":"Crafted for activewear"},{"type":"textarea","id":"text","label":"Text","default":"Seamless stretch, breathable knit & sweat-wicking tech for every rep."},{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"btn","label":"Btn","default":"Learn More"},{"type":"url","id":"url","label":"URL"}],"presets":[{"name":"HP96 Brand Story"}]}{% endschema %}