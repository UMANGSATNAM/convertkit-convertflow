{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@700;900&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --border-color: #000000;
    --font-heading: 'Space Grotesk', sans-serif;
    background-color: var(--bg-color);
    padding: 60px 20px;
    border-bottom: 4px solid var(--border-color);
  }

  .hp41-press-wrapper {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 40px;
  }

  .hp41-press__item {
    background: #FFF;
    border: 4px solid var(--border-color);
    border-radius: 16px;
    padding: 25px 40px;
    box-shadow: 6px 6px 0px var(--border-color);
    transition: all 0.15s ease;
  }

  .hp41-press__item:nth-child(1) { transform: rotate(-3deg); background: #D7FF43; }
  .hp41-press__item:nth-child(2) { transform: rotate(2deg); background: #FFF; }
  .hp41-press__item:nth-child(3) { transform: rotate(-1deg); background: #38C6F4; }
  .hp41-press__item:nth-child(4) { transform: rotate(4deg); background: #F0A8E3; }

  .hp41-press__item:hover {
    transform: rotate(0) translate(-3px, -3px);
    box-shadow: 10px 10px 0px var(--border-color);
    z-index: 2;
  }

  .hp41-press__logo {
    max-height: 35px;
    width: auto;
  }

  .hp41-press__text-fallback {
    font-family: var(--font-heading);
    font-size: 28px;
    font-weight: 900;
    color: var(--border-color);
    text-transform: uppercase;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp41-press-wrapper" id="HP41Press-{{ section.id }}">
  {%- for block in section.blocks -%}
    <div class="hp41-press__item" {{ block.shopify_attributes }}>
      {%- if block.settings.image != blank -%}
        <img height="{{ block.settings.image.height }}" width="{{ block.settings.image.width }}" src="{{ block.settings.image | image_url: height: 70 }}" alt="Press" class="hp41-press__logo" loading="lazy">
      {%- else -%}
        <div class="hp41-press__text-fallback">{{ block.settings.text_fallback }}</div>
      {%- endif -%}
    </div>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "HP41 - Neo Press",
  "class": "section-hp41-press-logos",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FDF0D5" },
    { "type": "html", "id": "custom_css", "label": "Custom CSS" }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Press Logo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Logo Image" },
        { "type": "text", "id": "text_fallback", "label": "Text Fallback", "default": "VICE" }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP41 - Neo Press",
      "blocks": [
        { "type": "logo", "settings": { "text_fallback": "VICE" } },
        { "type": "logo", "settings": { "text_fallback": "HYPEBEAST" } },
        { "type": "logo", "settings": { "text_fallback": "DAZED" } },
        { "type": "logo", "settings": { "text_fallback": "i-D" } }
      ]
    }
  ]
}
{% endschema %}
