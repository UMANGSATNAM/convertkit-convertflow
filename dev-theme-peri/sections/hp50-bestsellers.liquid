{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp50-bs-bg: {{ section.settings.bg_color | default: '#000000' }};
    
    background-color: var(--hp50-bs-bg);
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }

  .hp50-bs__wrap {
    max-width: {{ section.settings.container_width | default: 1280 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp50-bs__header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 50px;
  }

  .hp50-bs__heading {
    font-family: 'Italiana', serif;
    font-size: clamp(34px, 4.5vw, 48px);
    font-weight: 400;
    color: #FFFFFF;
    margin: 0 0 8px;
    letter-spacing: 1px;
  }

  .hp50-bs__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: 3 }}, 1fr);
    gap: 24px;
  }

  .hp50-bs__card {
    background: #111111;
    border: 1px solid rgba(226, 232, 240, 0.2);
    padding: 24px;
    display: flex;
    flex-direction: column;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
    transition: all 0.3s ease;
  }

  .hp50-bs__card:hover {
    border-color: #FFFFFF;
    transform: translateY(-6px);
  }

  .hp50-bs__img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    margin-bottom: 20px;
    filter: grayscale(30%) contrast(1.05);
  }

  .hp50-bs__title {
    font-family: 'Italiana', serif;
    font-size: 20px;
    font-weight: 400;
    color: #FFFFFF;
    margin: 0 0 8px;
    letter-spacing: 0.5px;
  }

  .hp50-bs__price {
    font-size: 16px;
    font-weight: 700;
    color: #E2E8F0;
    margin-bottom: 18px;
  }

  .hp50-bs__btn {
    width: 100%;
    margin-top: auto;
    padding: 13px;
    background: #FFFFFF;
    color: #000000;
    border: 1px solid #FFFFFF;
    font-family: 'Syne', sans-serif;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .hp50-bs__btn:hover { background: transparent; color: #FFFFFF; }

  @media screen and (max-width: 992px) {
    .hp50-bs__grid { grid-template-columns: 1fr; max-width: 460px; margin: 0 auto; }
  }
{%- endstyle -%}

<div class="hp50-bs__wrap">
  <div class="hp50-bs__header">
    <h2 class="hp50-bs__heading">{{ section.settings.heading | default: 'The Runway Iconics Reserve' }}</h2>
    <p style="font-size:13px; color:#94A3B8; letter-spacing:1px; text-transform:uppercase;">{{ section.settings.subheading | default: 'The essential contouring staples chosen by leading makeup artists.' }}</p>
  </div>

  <div class="hp50-bs__grid">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <div class="hp50-bs__card" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img height="{{ block.settings.image.height }}" width="{{ block.settings.image.width }}" src="{{ block.settings.image | image_url: width: 600 }}" class="hp50-bs__img" alt="{{ block.settings.title }}" loading="lazy">
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'hp50-bs__img' }}
          {%- endif -%}
          <h3 class="hp50-bs__title">{{ block.settings.title }}</h3>
          <div class="hp50-bs__price">{{ block.settings.price | default: '$135.00 USD' }}</div>
          <button class="hp50-bs__btn">{{ block.settings.btn_text | default: 'Acquire Formulation' }}</button>
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="hp50-bs__card">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'hp50-bs__img' }}
        <h3 class="hp50-bs__title">Platinum Contour Vector Elixir</h3>
        <div class="hp50-bs__price">$135.00 USD</div>
        <button class="hp50-bs__btn">Acquire Formulation</button>
      </div>
      <div class="hp50-bs__card">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'hp50-bs__img' }}
        <h3 class="hp50-bs__title">Runway Noir Thermal Infusion Crème</h3>
        <div class="hp50-bs__price">$120.00 USD</div>
        <button class="hp50-bs__btn">Acquire Formulation</button>
      </div>
      <div class="hp50-bs__card">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'hp50-bs__img' }}
        <h3 class="hp50-bs__title">Sterling Micro-Mist Matte Finisher</h3>
        <div class="hp50-bs__price">$85.00 USD</div>
        <button class="hp50-bs__btn">Acquire Formulation</button>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP50 - Runway Best",
  "class": "section-hp50-bestsellers",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#000000" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Runway Iconics Reserve" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "The essential contouring staples chosen by leading makeup artists." },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "label": "Desktop Columns", "default": 3 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Platinum Contour Vector Elixir" },
        { "type": "text", "id": "price", "label": "Price", "default": "$135.00 USD" },
        { "type": "text", "id": "btn_text", "label": "Button Text", "default": "Acquire Formulation" },
        { "type": "url", "id": "url", "label": "Link URL" }
      ]
    }
  ],
  "presets": [
    { "name": "HP50 - Runway Best" }
  ]
}
{% endschema %}
