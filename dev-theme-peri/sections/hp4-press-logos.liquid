{%- liquid
  assign bg_color = section.settings.bg_color | default: '#ffffff'
  assign text_color = section.settings.text_color | default: '#2c2c2c'
  
  assign padding_top_desktop = section.settings.padding_top_desktop
  assign padding_bottom_desktop = section.settings.padding_bottom_desktop
  assign padding_top_mobile = section.settings.padding_top_mobile
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile
-%}

<style>
  #shopify-section-{{ section.id }} {
    --hp4-press-bg: {{ bg_color }};
    --hp4-press-text: {{ text_color }};
    
    --hp4-press-pt-desk: {{ padding_top_desktop }}px;
    --hp4-press-pb-desk: {{ padding_bottom_desktop }}px;
    --hp4-press-pt-mob: {{ padding_top_mobile }}px;
    --hp4-press-pb-mob: {{ padding_bottom_mobile }}px;
  }

  .hp4-decor-press-{{ section.id }} {
    padding-top: var(--hp4-press-pt-desk);
    padding-bottom: var(--hp4-press-pb-desk);
    background-color: var(--hp4-press-bg);
    border-top: 1px solid rgba(0,0,0,0.05);
    border-bottom: 1px solid rgba(0,0,0,0.05);
  }

  .hp4-press-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
  }

  .hp4-press-title {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--hp4-press-text);
    margin: 0;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .hp4-press-logos {
    display: flex;
    align-items: center;
    justify-content: space-around;
    flex: 1;
    gap: 30px;
  }

  .hp4-press-logo {
    opacity: 0.4;
    transition: all 0.4s ease;
    filter: grayscale(100%) contrast(150%);
    max-width: 150px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .hp4-press-logo:hover {
    opacity: 1;
    filter: grayscale(0%) contrast(100%);
  }

  .hp4-press-logo img {
    max-width: 100%;
    height: auto;
    max-height: 40px;
    object-fit: contain;
  }

  .hp4-press-logo svg {
    max-width: 100%;
    height: 35px;
    fill: var(--hp4-press-text);
  }

  @media screen and (max-width: 1024px) {
    .hp4-press-inner {
      flex-direction: column;
      gap: 30px;
    }
    .hp4-press-logos {
      width: 100%;
      flex-wrap: wrap;
    }
  }

  @media screen and (max-width: 768px) {
    .hp4-decor-press-{{ section.id }} {
      padding-top: var(--hp4-press-pt-mob);
      padding-bottom: var(--hp4-press-pb-mob);
    }
    .hp4-press-inner {
      padding: 0 20px;
    }
    .hp4-press-logos {
      gap: 20px;
    }
    .hp4-press-logo {
      width: calc(50% - 10px);
      max-width: none;
    }
    .hp4-press-logo img {
      max-height: 30px;
    }
  }
</style>

<section class="hp4-decor-press-{{ section.id }}" aria-label="Press Logos">
  <div class="hp4-press-inner">
    
    {%- if section.settings.heading != blank -%}
      <h3 class="hp4-press-title">{{ section.settings.heading }}</h3>
    {%- endif -%}

    <div class="hp4-press-logos">
      {%- for block in section.blocks -%}
        <div class="hp4-press-logo" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 300 }}" loading="lazy" alt="Press Logo">
          {%- else -%}
            <!-- Placeholder SVG Logo -->
            <svg viewBox="0 0 100 30">
              <text x="50%" y="50%" dominant-baseline="middle" text-anchor="middle" font-family="Playfair Display, serif" font-size="20" font-weight="700">MAGAZINE</text>
            </svg>
          {%- endif -%}
        </div>
      {%- endfor -%}

      {%- if section.blocks.size == 0 -%}
        {%- for i in (1..5) -%}
          <div class="hp4-press-logo">
            <svg viewBox="0 0 100 30">
              <text x="50%" y="50%" dominant-baseline="middle" text-anchor="middle" font-family="Playfair Display, serif" font-size="20" font-weight="700">PUBLICATION</text>
            </svg>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "HP4 Decor Press Logos",
  "tag": "section",
  "class": "section-hp4-press",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "AS FEATURED IN"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2c2c2c"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Top (Desktop)", "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Bottom (Desktop)", "default": 40
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Top (Mobile)", "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Bottom (Mobile)", "default": 30
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo Image (Use PNG/SVG)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP4 Decor Press Logos",
      "category": "Trust",
      "blocks": [
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" }
      ]
    }
  ]
}
{% endschema %}
