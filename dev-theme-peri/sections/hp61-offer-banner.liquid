{%- style -%}
  #shopify-section-{{ section.id }} {
    background: radial-gradient(circle at 20% 50%, #450A0A 0%, #09090B 100%);
    color: #FFFFFF;
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
    border-top: 1px solid rgba(239, 68, 68, 0.25);
    border-bottom: 1px solid rgba(245, 158, 11, 0.25);
  }
  .hp61-offer__container { max-width: {{ section.settings.container_width | default: 1280 }}px; margin: 0 auto; padding: 0 24px; display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; }
  .hp61-offer__eyebrow { font-family: 'Space Grotesk', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: #EF4444; margin: 0 0 16px; }
  .hp61-offer__heading { font-family: 'Syne', sans-serif; font-size: clamp(28px, 4vw, 48px); font-weight: 800; color: #FFFFFF; margin: 0 0 18px; line-height: 1.1; }
  .hp61-offer__desc { font-size: 15px; line-height: 1.7; color: #A1A1AA; margin: 0 0 30px; }
  .hp61-offer__btn {
    display: inline-flex; align-items: center; gap: 10px; padding: 16px 36px;
    background: #EF4444; color: #FFFFFF; font-family: 'Space Grotesk', sans-serif;
    font-size: 13px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase;
    text-decoration: none; border-radius: 4px;
    box-shadow: 0 4px 25px rgba(239, 68, 68, 0.4); transition: all 0.3s ease;
  }
  .hp61-offer__btn:hover { box-shadow: 0 8px 35px rgba(239, 68, 68, 0.7); transform: translateY(-2px); }
  .hp61-offer__img-wrap { border-radius: 8px; overflow: hidden; height: 400px; border: 1px solid rgba(239, 68, 68, 0.3); box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6); }
  .hp61-offer__img { width: 100%; height: 100%; object-fit: cover; }
  @media screen and (max-width: 992px) { .hp61-offer__container { grid-template-columns: 1fr; text-align: center; } .hp61-offer__img-wrap { height: 300px; } }
{%- endstyle -%}
<div class="hp61-offer__container">
  <div>
    <p class="hp61-offer__eyebrow">{{ section.settings.eyebrow | default: '🌋 GEOTHERMAL PROTOCOL' }}</p>
    <h2 class="hp61-offer__heading">{{ section.settings.heading | default: 'The Obsidian Volcanic Trio' }}</h2>
    <p class="hp61-offer__desc">{{ section.settings.description | default: 'Includes our Basalt Pore Masque, Thermal Silica Elixir, and Magma Balm with a genuine handcrafted Icelandic obsidian applicator stone.' }}</p>
    <a href="{{ section.settings.btn_url | default: '/collections/all' }}" class="hp61-offer__btn">{{ section.settings.btn_label | default: 'Claim Volcanic Trio' }} &rarr;</a>
  </div>
  <div class="hp61-offer__img-wrap">
    {%- if section.settings.image != blank -%}<img src="{{ section.settings.image | image_url: width: 800 }}" class="hp61-offer__img" alt="{{ section.settings.heading }}" loading="lazy">
    {%- else -%}{{ 'product-1' | placeholder_svg_tag: 'hp61-offer__img' }}{%- endif -%}
  </div>
</div>
{% schema %}
{
  "name": "HP61 Offer",
  "class": "section-hp61-offer",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "🌋 GEOTHERMAL PROTOCOL" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Obsidian Volcanic Trio" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Includes our Basalt Pore Masque." },
    { "type": "text", "id": "btn_label", "label": "Button Label", "default": "Claim Volcanic Trio" },
    { "type": "url", "id": "btn_url", "label": "Button URL" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 80 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "presets": [{ "name": "HP61 Offer" }]
}
{% endschema %}
