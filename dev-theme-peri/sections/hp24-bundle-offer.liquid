{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Orbitron:wght@400;700;900&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-primary: {{ section.settings.accent_primary }};
    --accent-secondary: {{ section.settings.accent_secondary }};
    --font-heading: 'Orbitron', sans-serif;
    --font-body: 'Share Tech Mono', monospace;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    position: relative;
    overflow: hidden;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }

  .hp24-bundle-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
    position: relative;
    z-index: 1;
  }

  @media screen and (max-width: 768px) {
    .hp24-bundle-wrapper {
      padding: 0 20px;
    }
  }

  /* Cyber frame around the entire bundle */
  .hp24-bundle__container {
    background: rgba(0,0,0,0.6);
    border: 1px solid var(--accent-secondary);
    padding: 60px;
    position: relative;
    box-shadow: 0 0 30px rgba(255, 0, 230, 0.1), inset 0 0 20px rgba(255, 0, 230, 0.05);
    backdrop-filter: blur(10px);
  }

  @media screen and (max-width: 992px) {
    .hp24-bundle__container {
      padding: 40px;
    }
  }

  @media screen and (max-width: 768px) {
    .hp24-bundle__container {
      padding: 30px 20px;
    }
  }

  /* Decorative corners */
  .hp24-bundle__container::before,
  .hp24-bundle__container::after {
    content: '';
    position: absolute;
    width: 40px;
    height: 40px;
    border: 3px solid var(--accent-primary);
  }
  
  .hp24-bundle__container::before {
    top: -5px; left: -5px;
    border-right: none; border-bottom: none;
  }
  
  .hp24-bundle__container::after {
    bottom: -5px; right: -5px;
    border-left: none; border-top: none;
  }

  .hp24-bundle__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  @media screen and (max-width: 992px) {
    .hp24-bundle__grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }

  /* Image Side */
  .hp24-bundle__image-wrapper {
    position: relative;
    width: 100%;
  }

  .hp24-bundle__image {
    width: 100%;
    height: auto;
    object-fit: cover;
    filter: drop-shadow(0 0 20px rgba(0, 243, 255, 0.4));
  }

  .hp24-bundle__hud-elements {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    pointer-events: none;
  }

  .hp24-bundle__crosshair {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 100px;
    height: 100px;
    border: 1px dashed var(--accent-primary);
    border-radius: 50%;
    animation: rotateSlow 10s linear infinite;
  }

  @keyframes rotateSlow {
    100% { transform: translate(-50%, -50%) rotate(360deg); }
  }

  /* Text Side */
  .hp24-bundle__content {
    display: flex;
    flex-direction: column;
  }

  .hp24-bundle__sys-text {
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--accent-secondary);
    margin-bottom: 20px;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .hp24-bundle__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    font-weight: 900;
    color: var(--text-color);
    margin: 0 0 20px;
    text-transform: uppercase;
    line-height: 1.1;
    text-shadow: 2px 2px 0 var(--accent-secondary);
  }

  .hp24-bundle__text {
    font-family: var(--font-body);
    font-size: clamp(16px, 2vw, 18px);
    color: var(--text-color);
    margin: 0 0 30px;
    line-height: 1.6;
    opacity: 0.9;
  }

  /* Bundle Items List */
  .hp24-bundle__items {
    list-style: none;
    padding: 0;
    margin: 0 0 40px;
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  .hp24-bundle__item {
    font-family: var(--font-body);
    font-size: 16px;
    color: var(--text-color);
    display: flex;
    align-items: center;
    gap: 15px;
    padding: 10px;
    background: rgba(255,255,255,0.05);
    border-left: 2px solid var(--accent-primary);
  }

  .hp24-bundle__item svg {
    width: 20px;
    height: 20px;
    fill: var(--accent-primary);
    flex-shrink: 0;
  }

  /* Pricing and Button */
  .hp24-bundle__footer {
    display: flex;
    align-items: center;
    gap: 30px;
    flex-wrap: wrap;
  }
  
  @media screen and (max-width: 600px) {
    .hp24-bundle__footer {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }
  }

  .hp24-bundle__price-box {
    display: flex;
    flex-direction: column;
  }

  .hp24-bundle__price {
    font-family: var(--font-heading);
    font-size: 32px;
    font-weight: 900;
    color: var(--accent-primary);
    line-height: 1;
  }

  .hp24-bundle__price-compare {
    font-family: var(--font-body);
    font-size: 16px;
    color: rgba(255,255,255,0.5);
    text-decoration: line-through;
    margin-top: 5px;
  }

  .hp24-bundle__btn {
    font-family: var(--font-heading);
    display: inline-flex;
    align-items: center;
    padding: 15px 40px;
    background: var(--accent-secondary);
    color: var(--bg-color);
    font-size: 18px;
    font-weight: 900;
    text-transform: uppercase;
    text-decoration: none;
    letter-spacing: 1px;
    transition: all 0.3s ease;
    box-shadow: 0 0 15px var(--accent-secondary);
  }

  .hp24-bundle__btn:hover {
    background: transparent;
    color: var(--accent-secondary);
    border: 1px solid var(--accent-secondary);
    box-shadow: 0 0 25px var(--accent-secondary);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp24-bundle-wrapper" id="HP24Bundle-{{ section.id }}">
  <div class="hp24-bundle__container">
    
    <div class="hp24-bundle__grid">
      
      <div class="hp24-bundle__image-wrapper">
        <div class="hp24-bundle__hud-elements">
          <div class="hp24-bundle__crosshair"></div>
        </div>
        
        {%- if section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.title | strip_html | escape }}" class="hp24-bundle__image" loading="lazy">
        {%- else -%}
          <div style="width:100%;aspect-ratio:1/1;background:rgba(255,255,255,0.05);display:flex;align-items:center;justify-content:center;color:#444;font-family:'Share Tech Mono';">BUNDLE.IMAGE</div>
        {%- endif -%}
      </div>

      <div class="hp24-bundle__content">
        <div class="hp24-bundle__sys-text">PACKAGE COMPILE // COMPLETE</div>
        
        {%- if section.settings.title != blank -%}
          <h2 class="hp24-bundle__title">{{ section.settings.title }}</h2>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="hp24-bundle__text">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ul class="hp24-bundle__items">
            {%- for block in section.blocks -%}
              <li class="hp24-bundle__item" {{ block.shopify_attributes }}>
                <svg viewBox="0 0 24 24"><path d="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z"/></svg>
                {{ block.settings.text | escape }}
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        <div class="hp24-bundle__footer">
          <div class="hp24-bundle__price-box">
            <span class="hp24-bundle__price">{{ section.settings.price }}</span>
            {%- if section.settings.compare_price != blank -%}
              <span class="hp24-bundle__price-compare">VALUE: {{ section.settings.compare_price }}</span>
            {%- endif -%}
          </div>

          {%- if section.settings.btn_text != blank -%}
            <a href="{{ section.settings.btn_link | default: '#' }}" class="hp24-bundle__btn">
              {{ section.settings.btn_text | escape }}
            </a>
          {%- endif -%}
        </div>

      </div>
    </div>
    
  </div>
</div>

{% schema %}
{
  "name": "HP24 - Cyber Bundle",
  "class": "section-hp24-bundle-offer",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "THE ULTIMATE OVERRIDE KIT"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Body Text",
      "default": "<p>Everything you need to bypass normal human limitations. Compiled into one highly efficient package.</p>"
    },
    {
      "type": "text",
      "id": "price",
      "label": "Bundle Price",
      "default": "$149.00"
    },
    {
      "type": "text",
      "id": "compare_price",
      "label": "Compare at Value",
      "default": "$220.00"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "ACQUIRE KIT"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Bundle Image"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1400
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 32,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 56
    },
    {
      "type": "header",
      "content": "Cyberpunk Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#050505"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "accent_primary",
      "label": "Accent Primary (Neon Blue)",
      "default": "#00F3FF"
    },
    {
      "type": "color",
      "id": "accent_secondary",
      "label": "Accent Secondary (Neon Pink)",
      "default": "#FF00E6"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 100
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Bundle Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Item Text",
          "default": "1x Neural Interface Module"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP24 - Cyber Bundle",
      "blocks": [
        { "type": "item", "settings": { "text": "1x Core Processing Unit" } },
        { "type": "item", "settings": { "text": "2x Optical Enhancers" } },
        { "type": "item", "settings": { "text": "1x System Integration Guide" } }
      ]
    }
  ]
}
{% endschema %}
