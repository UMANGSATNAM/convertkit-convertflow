{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#1F0B18' }};
    padding: {{ section.settings.padding_vertical | default: 35 }}px 0;
  }
  .hp55-pills__container { max-width: 1280px; margin: 0 auto; padding: 0 24px; }
  .hp55-pills__scroll { display: flex; gap: 12px; overflow-x: auto; scrollbar-width: none; justify-content: center; flex-wrap: wrap; }
  .hp55-pills__scroll::-webkit-scrollbar { display: none; }
  .hp55-pills__pill {
    display: inline-flex; align-items: center; gap: 8px; padding: 10px 24px;
    background: {{ section.settings.pill_bg | default: '#2A0E22' }};
    border: 1px solid rgba(233, 213, 255, 0.2); border-radius: 50px;
    font-family: 'Plus Jakarta Sans', sans-serif; font-size: 13px; font-weight: 600;
    color: {{ section.settings.pill_text | default: '#FDF4FF' }};
    text-decoration: none; white-space: nowrap; transition: all 0.3s ease;
  }
  .hp55-pills__pill:hover { background: #C084FC; color: #1F0B18; border-color: #C084FC; }
  @media screen and (max-width: 768px) { .hp55-pills__scroll { justify-content: flex-start; flex-wrap: nowrap; } }
{%- endstyle -%}
<div class="hp55-pills__container">
  <div class="hp55-pills__scroll">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.url | default: '#' }}" class="hp55-pills__pill" {{ block.shopify_attributes }}>
        {%- if block.settings.icon != blank -%}<span>{{ block.settings.icon }}</span>{%- endif -%}
        <span>{{ block.settings.label | default: 'Category' }}</span>
      </a>
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "HP55 Categories",
  "class": "section-hp55-pills",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#1F0B18" },
    { "type": "color", "id": "pill_bg", "label": "Pill BG", "default": "#2A0E22" },
    { "type": "color", "id": "pill_text", "label": "Pill Text", "default": "#FDF4FF" },
    { "type": "range", "id": "padding_vertical", "min": 10, "max": 60, "step": 5, "unit": "px", "label": "Padding", "default": 35 }
  ],
  "blocks": [{ "type": "pill", "name": "Category", "settings": [
    { "type": "text", "id": "icon", "label": "Icon", "default": "✦" },
    { "type": "text", "id": "label", "label": "Label", "default": "Pearl Serums" },
    { "type": "url", "id": "url", "label": "URL" }
  ]}],
  "presets": [{ "name": "HP55 Categories", "blocks": [
    { "type": "pill", "settings": { "icon": "🦪", "label": "Pearl Serums" } },
    { "type": "pill", "settings": { "icon": "👑", "label": "Royal Creams" } },
    { "type": "pill", "settings": { "icon": "🌸", "label": "Orchid Masks" } },
    { "type": "pill", "settings": { "icon": "✨", "label": "Rose Gold Oils" } },
    { "type": "pill", "settings": { "icon": "✦", "label": "Eye Nacre" } }
  ]}]
}
{% endschema %}
