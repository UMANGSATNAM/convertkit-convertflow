<style>
@media screen and (max-width: 768px) {
  .hp48-marquee {
    padding-left: 16px !important;
    padding-right: 16px !important;
    box-sizing: border-box !important;
  }
  img {
    max-width: 100% !important;
    height: auto !important;
  }
}
</style>
{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp48-marq-bg: {{ section.settings.bg_color | default: '#1A1715' }};
    --hp48-marq-text: {{ section.settings.text_color | default: '#FAF8F5' }};
    --hp48-gold: {{ section.settings.accent_gold | default: '#C59B27' }};
    
    background: var(--hp48-marq-bg);
    color: var(--hp48-marq-text);
    padding: {{ section.settings.padding_vertical | default: 16 }}px 0;
    overflow: hidden;
    white-space: nowrap;
    border-top: 1px solid rgba(197, 155, 39, 0.3);
    border-bottom: 1px solid rgba(197, 155, 39, 0.3);
  }

  .hp48-marquee__track {
    display: inline-flex;
    gap: 40px;
    animation: hp48-scroll {{ section.settings.speed | default: 24 }}s linear infinite;
    font-family: 'Montserrat', sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .hp48-marquee__item {
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }

  .hp48-marquee__item span:first-child {
    color: var(--hp48-gold);
  }

  @keyframes hp48-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
{%- endstyle -%}

<div class="hp48-marquee__track">
  {%- if section.blocks.size > 0 -%}
    {%- for i in (1..2) -%}
      {%- for block in section.blocks -%}
        <div class="hp48-marquee__item" {{ block.shopify_attributes }}>
          <span>👑</span>
          <span>{{ block.settings.text }}</span>
        </div>
      {%- endfor -%}
    {%- endfor -%}
  {%- else -%}
    {%- for i in (1..2) -%}
      <div class="hp48-marquee__item"><span>👑</span><span>24K MICRONIZED COLLOIDAL GOLD NECTAR</span></div>
      <div class="hp48-marquee__item"><span>✦</span><span>ROYAL IMPERIAL PEARL RADIANCE ACCORD</span></div>
      <div class="hp48-marquee__item"><span>✈️</span><span>COMPLIMENTARY WHITE-GLOVE DDP AIR COURIER</span></div>
      <div class="hp48-marquee__item"><span>🛡️</span><span>SOVEREIGN PURITY GUARANTEE &amp; CERTIFICATION</span></div>
    {%- endfor -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "HP48 - Royal Marquee",
  "class": "section-hp48-marquee",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#1A1715" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#FAF8F5" },
    { "type": "color", "id": "accent_gold", "label": "Gold Accent", "default": "#C59B27" },
    { "type": "range", "id": "speed", "min": 10, "max": 60, "step": 2, "unit": "s", "label": "Scroll Duration", "default": 24 },
    { "type": "range", "id": "padding_vertical", "min": 8, "max": 40, "step": 2, "unit": "px", "label": "Padding Vertical", "default": 16 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Ticker Item",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "24K MICRONIZED COLLOIDAL GOLD NECTAR" }
      ]
    }
  ],
  "presets": [
    { "name": "HP48 - Royal Marquee" }
  ]
}
{% endschema %}
