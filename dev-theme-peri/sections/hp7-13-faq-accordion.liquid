{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#050505'
  assign text_color = section.settings.text_color | default: '#F4F4F0'
  assign padding_top = section.settings.padding_top | default: 120
  assign padding_bottom = section.settings.padding_bottom | default: 120
-%}

<style>
  #shopify-section-{{ section_id }} {
    --bg-color: {{ bg_color }};
    --text-color: {{ text_color }};
    --padding-top: {{ padding_top }}px;
    --padding-bottom: {{ padding_bottom }}px;
    
    background-color: var(--bg-color);
    color: var(--text-color);
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .hp7-faq-{{ section_id }} {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 4vw;
  }
  
  .hp7-faq__title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(3rem, 6vw, 6rem);
    font-weight: 400;
    line-height: 1;
    margin: 0 0 6rem 0;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }
  
  .hp7-faq__title em {
    font-style: italic;
    opacity: 0.7;
  }

  .hp7-faq__list {
    display: flex;
    flex-direction: column;
  }

  .hp7-faq__item {
    border-bottom: 2px solid var(--text-color);
  }
  
  .hp7-faq__item:first-child {
    border-top: 2px solid var(--text-color);
  }

  .hp7-faq__summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 2.5rem 0;
    cursor: pointer;
    list-style: none; /* Remove default triangle */
  }
  
  .hp7-faq__summary::-webkit-details-marker {
    display: none;
  }

  .hp7-faq__question {
    font-family: 'Inter', sans-serif;
    font-size: clamp(18px, 2vw, 24px);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0;
    width: 90%;
  }

  .hp7-faq__icon {
    font-family: 'Inter', monospace;
    font-size: 2rem;
    font-weight: 300;
    line-height: 1;
    transition: transform 0.3s ease;
  }

  .hp7-faq__item[open] .hp7-faq__icon {
    transform: rotate(45deg);
  }

  .hp7-faq__content {
    font-family: 'Inter', sans-serif;
    font-size: clamp(16px, 1.2vw, 18px);
    line-height: 1.6;
    padding-bottom: 2.5rem;
    opacity: 0.8;
    max-width: 800px;
    animation: hp7-fade-in 0.4s ease;
  }

  @keyframes hp7-fade-in {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 0.8; transform: translateY(0); }
  }
</style>

<section class="hp7-faq-{{ section_id }}">
  
  {%- if section.settings.title != blank -%}
    <h2 class="hp7-faq__title">{{ section.settings.title }}</h2>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <div class="hp7-faq__list" itemscope itemtype="https://schema.org/FAQPage">
      {%- for block in section.blocks -%}
        <details class="hp7-faq__item" {{ block.shopify_attributes }} itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
          <summary class="hp7-faq__summary">
            <h3 class="hp7-faq__question" itemprop="name">{{ block.settings.question | escape }}</h3>
            <span class="hp7-faq__icon" aria-hidden="true">+</span>
          </summary>
          <div class="hp7-faq__content" itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <div itemprop="text">
              {{ block.settings.answer }}
            </div>
          </div>
        </details>
      {%- endfor -%}
    </div>
  {%- endif -%}

</section>

{% schema %}
{
  "name": "HP7 Brutalist FAQ",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Aesthetic: Editorial Brutalism",
      "info": "Accessible accordion with thick borders and plus/cross animation."
    },
    {
      "type": "html",
      "id": "title",
      "label": "Section Title",
      "default": "INQUIRIES <em>&</em> LOGISTICS"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#050505"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#F4F4F0"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Padding Top",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 120
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "WHAT IS YOUR APPROACH TO SUSTAINABILITY?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>We source only deadstock and organically grown fibers. Production is strictly limited, eliminating surplus waste.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP7 Brutalist FAQ",
      "blocks": [
        { "type": "faq", "settings": { "question": "SHIPPING & DELIVERY TIMES" } },
        { "type": "faq", "settings": { "question": "RETURN PROTOCOL" } },
        { "type": "faq", "settings": { "question": "MATERIALS & ORIGIN" } }
      ]
    }
  ]
}
{% endschema %}
