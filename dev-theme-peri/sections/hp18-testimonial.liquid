{%- liquid
  assign sec_id = section.id
  assign bg_color = section.settings.bg_color
  assign text_color = section.settings.text_color
  assign card_bg = section.settings.card_bg
  assign accent_color = section.settings.accent_color
  assign border_color = section.settings.border_color
  assign shadow_color = section.settings.shadow_color
  assign border_width = section.settings.border_width
-%}

<style>
  .hp18-testi-{{ sec_id }} {
    background-color: {{ bg_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px 0;
    border-bottom: {{ border_width }}px solid {{ border_color }};
    overflow: hidden;
  }

  .hp18-testi-{{ sec_id }}__container {
    max-width: var(--page-width, 1400px);
    margin: 0 auto;
    padding: 0 40px;
    position: relative;
  }

  .hp18-testi-{{ sec_id }}__header {
    margin-bottom: 60px;
    text-align: center;
  }

  .hp18-testi-{{ sec_id }}__title {
    font-family: 'Arial Black', Impact, sans-serif;
    font-size: clamp(32px, 5vw, 64px);
    color: {{ text_color }};
    text-transform: uppercase;
    margin: 0;
    line-height: 1;
    text-shadow: 4px 4px 0px {{ shadow_color }};
  }

  /* Slider Container */
  .hp18-testi-{{ sec_id }}__slider {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none; /* IE */
    gap: 40px;
    padding: 20px 0 40px 0;
  }
  .hp18-testi-{{ sec_id }}__slider::-webkit-scrollbar {
    display: none; /* Chrome/Safari */
  }

  .hp18-testi-{{ sec_id }}__card {
    flex: 0 0 calc(33.333% - 27px);
    scroll-snap-align: start;
    background-color: {{ card_bg }};
    border: {{ border_width }}px solid {{ border_color }};
    padding: 40px;
    position: relative;
    box-shadow: 10px 10px 0px {{ shadow_color }};
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    display: flex;
    flex-direction: column;
  }

  .hp18-testi-{{ sec_id }}__card:hover {
    transform: translate(-5px, -5px);
    box-shadow: 15px 15px 0px {{ accent_color }};
  }

  /* Brutalist Quotes */
  .hp18-testi-{{ sec_id }}__card::before {
    content: '"';
    position: absolute;
    top: 10px;
    left: 20px;
    font-family: 'Arial Black', sans-serif;
    font-size: 80px;
    line-height: 1;
    color: {{ accent_color }};
    opacity: 0.5;
  }

  .hp18-testi-{{ sec_id }}__stars {
    color: {{ accent_color }};
    font-size: 20px;
    margin-bottom: 20px;
    position: relative;
    z-index: 2;
  }

  .hp18-testi-{{ sec_id }}__quote {
    font-family: 'Courier New', monospace;
    font-size: 16px;
    font-weight: bold;
    color: {{ text_color }};
    line-height: 1.6;
    margin: 0 0 30px 0;
    position: relative;
    z-index: 2;
    flex-grow: 1;
  }

  .hp18-testi-{{ sec_id }}__author-wrap {
    display: flex;
    align-items: center;
    gap: 15px;
    border-top: {{ border_width }}px dashed {{ border_color }};
    padding-top: 20px;
  }

  .hp18-testi-{{ sec_id }}__avatar {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    border: 2px solid {{ border_color }};
    object-fit: cover;
  }

  .hp18-testi-{{ sec_id }}__author-info {
    display: flex;
    flex-direction: column;
  }

  .hp18-testi-{{ sec_id }}__name {
    font-family: 'Arial Black', sans-serif;
    font-size: 16px;
    color: {{ text_color }};
    margin: 0;
    text-transform: uppercase;
  }

  .hp18-testi-{{ sec_id }}__handle {
    font-family: 'Courier New', monospace;
    font-size: 14px;
    color: {{ text_color }};
    margin: 0;
    opacity: 0.7;
  }

  /* Nav Buttons */
  .hp18-testi-{{ sec_id }}__nav {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin-top: 20px;
  }

  .hp18-testi-{{ sec_id }}__btn {
    width: 60px;
    height: 60px;
    background-color: {{ text_color }};
    color: {{ bg_color }};
    border: {{ border_width }}px solid {{ border_color }};
    font-family: 'Arial Black', sans-serif;
    font-size: 24px;
    cursor: pointer;
    box-shadow: 4px 4px 0px {{ shadow_color }};
    transition: all 0.2s;
  }

  .hp18-testi-{{ sec_id }}__btn:hover {
    background-color: {{ accent_color }};
    color: {{ text_color }};
  }

  .hp18-testi-{{ sec_id }}__btn:active {
    transform: translate(2px, 2px);
    box-shadow: 0px 0px 0px {{ shadow_color }};
  }

  @media screen and (max-width: 992px) {
    .hp18-testi-{{ sec_id }}__card { flex: 0 0 calc(50% - 20px); }
  }

  @media screen and (max-width: 768px) {
    .hp18-testi-{{ sec_id }}__container { padding: 0 20px; }
    .hp18-testi-{{ sec_id }}__card { flex: 0 0 calc(100% - 10px); padding: 30px; }
    .hp18-testi-{{ sec_id }}__slider { gap: 20px; }
  }
</style>

<section class="hp18-testi-{{ sec_id }}">
  <div class="hp18-testi-{{ sec_id }}__container">
    
    <div class="hp18-testi-{{ sec_id }}__header">
      <h2 class="hp18-testi-{{ sec_id }}__title">{{ section.settings.title }}</h2>
    </div>

    <div class="hp18-testi-{{ sec_id }}__slider js-testi-slider-{{ sec_id }}">
      {% for block in section.blocks %}
        <div class="hp18-testi-{{ sec_id }}__card" {{ block.shopify_attributes }}>
          <div class="hp18-testi-{{ sec_id }}__stars">
            {% for i in (1..block.settings.stars) %}★{% endfor %}
          </div>
          <p class="hp18-testi-{{ sec_id }}__quote">{{ block.settings.text }}</p>
          
          <div class="hp18-testi-{{ sec_id }}__author-wrap">
            {% if block.settings.image != blank %}
              <img height="{{ block.settings.image.height }}" width="{{ block.settings.image.width }}" src="{{ block.settings.image | image_url: width: 100, height: 100, crop: 'center' }}" alt="{{ block.settings.author }}" class="hp18-testi-{{ sec_id }}__avatar">
            {% else %}
              <div class="hp18-testi-{{ sec_id }}__avatar" style="background: {{ text_color }}; display: flex; align-items:center; justify-content:center; color: {{ bg_color }}; font-weight: bold; font-family: sans-serif;">{{ block.settings.author | slice: 0 }}</div>
            {% endif %}
            
            <div class="hp18-testi-{{ sec_id }}__author-info">
              <h4 class="hp18-testi-{{ sec_id }}__name">{{ block.settings.author }}</h4>
              {% if block.settings.handle != blank %}
                <p class="hp18-testi-{{ sec_id }}__handle">{{ block.settings.handle }}</p>
              {% endif %}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>

    <div class="hp18-testi-{{ sec_id }}__nav">
      <button class="hp18-testi-{{ sec_id }}__btn js-testi-prev-{{ sec_id }}">&larr;</button>
      <button class="hp18-testi-{{ sec_id }}__btn js-testi-next-{{ sec_id }}">&rarr;</button>
    </div>

  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const slider = document.querySelector('.js-testi-slider-{{ sec_id }}');
    const prevBtn = document.querySelector('.js-testi-prev-{{ sec_id }}');
    const nextBtn = document.querySelector('.js-testi-next-{{ sec_id }}');
    
    if(slider && prevBtn && nextBtn) {
      nextBtn.addEventListener('click', () => {
        const scrollAmount = slider.clientWidth > 768 ? slider.clientWidth / 3 : slider.clientWidth;
        slider.scrollBy({ left: scrollAmount, behavior: 'smooth' });
      });
      
      prevBtn.addEventListener('click', () => {
        const scrollAmount = slider.clientWidth > 768 ? slider.clientWidth / 3 : slider.clientWidth;
        slider.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
      });
    }
  });
</script>

{% schema %}
{
  "name": "HP18 Adv Testimonials",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#eeeeee"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#FF3366"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "shadow_color",
      "label": "Shadow Color",
      "default": "#111111"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "NO CAP REVIEWS"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "Border Width",
      "default": 3
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 10,
      "unit": "px",
      "label": "Padding Top",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 10,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 100
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "range",
          "id": "stars",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Star Rating",
          "default": 5
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Review Text",
          "default": "Quality is insane. Heavyweight cotton feels premium and the fit is exactly what I was looking for. Will cop again."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author Name",
          "default": "ALEX M."
        },
        {
          "type": "text",
          "id": "handle",
          "label": "Author Handle (Optional)",
          "default": "@alex_fits"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Author Avatar"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP18 Advanced Testimonials",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" }
      ]
    }
  ]
}
{% endschema %}
