{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=Syne:wght@700;800&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --border-color: #000000;
    --accent-color: {{ section.settings.accent_color }};
    
    --font-heading: 'Syne', sans-serif;
    --font-body: 'Space Mono', monospace;
    
    background-color: var(--bg-color);
    border-bottom: 4px solid var(--border-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    overflow: hidden;
  }

  .hp32-ugc-wrapper {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp32-ugc-wrapper {
      padding: 0 20px;
    }
  }

  .hp32-ugc__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 40px;
  }

  .hp32-ugc__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    line-height: 1;
    color: #000;
    text-transform: uppercase;
    margin: 0;
    letter-spacing: -1px;
  }

  .hp32-ugc__title::before {
    content: '[REC]';
    color: #ff003c; /* Red rec color */
    margin-right: 15px;
    animation: hp32-blink 1s infinite;
  }

  @keyframes hp32-blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  .hp32-ugc__slider {
    display: flex;
    gap: 30px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding-bottom: 20px;
    padding-top: 10px;
    padding-left: 10px;
  }

  .hp32-ugc__slider::-webkit-scrollbar {
    display: none;
  }

  .hp32-ugc__item {
    flex: 0 0 calc(100% / {{ section.settings.columns_desktop }} - 30px + (30px / {{ section.settings.columns_desktop }}));
    scroll-snap-align: start;
    background: #fff;
    border: 4px solid var(--border-color);
    box-shadow: 8px 8px 0 var(--border-color);
    position: relative;
    aspect-ratio: 9/16;
    display: block;
    cursor: pointer;
    transition: transform 0.1s ease, box-shadow 0.1s ease;
  }

  @media screen and (max-width: 992px) {
    .hp32-ugc__item {
      flex: 0 0 calc(33.333% - 20px);
    }
  }

  @media screen and (max-width: 768px) {
    .hp32-ugc__item {
      flex: 0 0 calc(60% - 15px);
    }
  }

  @media screen and (max-width: 480px) {
    .hp32-ugc__item {
      flex: 0 0 calc(85% - 15px);
    }
  }

  .hp32-ugc__item:hover {
    transform: translate(4px, 4px);
    box-shadow: 4px 4px 0 var(--border-color);
  }

  .hp32-ugc__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(80%);
    transition: filter 0.3s ease;
  }

  .hp32-ugc__item:hover .hp32-ugc__video {
    filter: grayscale(0%);
  }

  /* Overlay HUD */
  .hp32-ugc__overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    pointer-events: none;
    border: 2px solid rgba(255,255,255,0.2);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 15px;
  }

  .hp32-ugc__overlay::before,
  .hp32-ugc__overlay::after {
    content: '';
    position: absolute;
    width: 20px; height: 20px;
    border: 2px solid var(--accent-color);
  }

  .hp32-ugc__overlay::before {
    top: 10px; left: 10px;
    border-right: none; border-bottom: none;
  }

  .hp32-ugc__overlay::after {
    bottom: 10px; right: 10px;
    border-left: none; border-top: none;
  }

  .hp32-ugc__cam-label {
    background: #000;
    color: var(--accent-color);
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 700;
    padding: 4px 8px;
    display: inline-block;
    align-self: flex-start;
  }

  .hp32-ugc__handle {
    background: #fff;
    color: #000;
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 700;
    padding: 6px 10px;
    border: 2px solid #000;
    align-self: flex-start;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp32-ugc-wrapper" id="HP32UGC-{{ section.id }}">
  <div class="hp32-ugc__header">
    <h2 class="hp32-ugc__title">{{ section.settings.title }}</h2>
  </div>

  <div class="hp32-ugc__slider">
    {%- for block in section.blocks -%}
      <div class="hp32-ugc__item" {{ block.shopify_attributes }}>
        {%- if block.settings.video_url != blank -%}
          <video class="hp32-ugc__video" autoplay loop muted playsinline>
            <source src="{{ block.settings.video_url }}" type="video/mp4">
          </video>
        {%- else -%}
          {%- assign placeholder = 'collection-' | append: forloop.index -%}
          {%- if forloop.index > 6 -%}{%- assign placeholder = 'collection-1' -%}{%- endif -%}
          {{ placeholder | placeholder_svg_tag: 'hp32-ugc__video' }}
        {%- endif -%}

        <div class="hp32-ugc__overlay">
          <div class="hp32-ugc__cam-label">CAM_0{{ forloop.index }}</div>
          <div class="hp32-ugc__handle">{{ block.settings.handle }}</div>
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "HP32 - Brutalist UGC",
  "class": "section-hp32-ugc-reels",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "NETWORK_ACTIVITY"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 3,
      "max": 6,
      "step": 1,
      "label": "Columns (Desktop)",
      "default": 4
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 48
    },
    {
      "type": "header",
      "content": "Brutalist Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (e.g. Light Grey)",
      "default": "#f4f4f4"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color (e.g. Lime)",
      "default": "#ccff00"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "UGC Video",
      "settings": [
        {
          "type": "text",
          "id": "video_url",
          "label": "MP4 Video URL"
        },
        {
          "type": "text",
          "id": "handle",
          "label": "User Handle",
          "default": "@AGENT_84"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP32 - Brutalist UGC",
      "blocks": [
        { "type": "video" },
        { "type": "video" },
        { "type": "video" },
        { "type": "video" },
        { "type": "video" }
      ]
    }
  ]
}
{% endschema %}
