{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Space+Mono:ital,wght@0,400;0,700;1,400;1,700&family=Inter:wght@400;600;800&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    
    --font-heading: 'Space Mono', monospace;
    --font-body: 'Inter', sans-serif;
    
    background-color: var(--text-color); /* Acts as the border color between grid items */
    border-bottom: 2px solid var(--text-color);
  }

  .hp38-story-wrapper {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px;
  }

  @media screen and (max-width: 992px) {
    .hp38-story-wrapper {
      grid-template-columns: 1fr;
    }
  }

  .hp38-story__image-col {
    background: var(--bg-color);
    position: relative;
    min-height: 500px;
  }

  @media screen and (max-width: 768px) {
    .hp38-story__image-col {
      min-height: 400px;
    }
  }

  .hp38-story__image {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover;
    filter: grayscale(100%) contrast(1.1);
  }

  .hp38-story__meta-overlay {
    position: absolute;
    bottom: 20px;
    left: 20px;
    background: var(--bg-color);
    border: 2px solid var(--text-color);
    padding: 5px 10px;
    font-family: var(--font-heading);
    font-size: 12px;
    color: var(--text-color);
    text-transform: uppercase;
  }

  .hp38-story__content-col {
    background: var(--bg-color);
    padding: 80px 60px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  @media screen and (max-width: 768px) {
    .hp38-story__content-col {
      padding: 50px 30px;
    }
  }

  .hp38-story__header {
    display: flex;
    justify-content: space-between;
    border-bottom: 2px solid var(--text-color);
    padding-bottom: 20px;
    margin-bottom: 40px;
  }

  .hp38-story__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    line-height: 1.1;
    color: var(--text-color);
    text-transform: uppercase;
    margin: 0;
  }

  .hp38-story__tag {
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 700;
    color: var(--accent-color);
    text-transform: uppercase;
  }

  .hp38-story__text {
    font-family: var(--font-body);
    font-size: clamp(16px, 2vw, {{ section.settings.text_size }}px);
    line-height: 1.6;
    color: var(--text-color);
    margin-bottom: 40px;
  }

  .hp38-story__text p {
    margin: 0 0 20px;
  }

  .hp38-story__btn {
    display: inline-block;
    align-self: flex-start;
    padding: 15px 30px;
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    text-decoration: none;
    border: 2px solid var(--text-color);
    background: transparent;
    color: var(--text-color);
    transition: all 0.2s ease;
  }

  .hp38-story__btn:hover {
    background: var(--text-color);
    color: var(--bg-color);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp38-story-wrapper" id="HP38Story-{{ section.id }}">
  {%- if section.settings.image_position == 'left' -%}
    <div class="hp38-story__image-col">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 1000 }}" alt="{{ section.settings.title | escape }}" class="hp38-story__image" loading="lazy">
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'hp38-story__image' }}
      {%- endif -%}
      <div class="hp38-story__meta-overlay">SYS.IMG.01</div>
    </div>
  {%- endif -%}

  <div class="hp38-story__content-col">
    <div class="hp38-story__header">
      <h2 class="hp38-story__title">{{ section.settings.title }}</h2>
      <div class="hp38-story__tag">DOC // {{ section.settings.tag | default: 'INFO' }}</div>
    </div>
    
    <div class="hp38-story__text">
      {{ section.settings.text }}
    </div>
    
    {%- if section.settings.btn_label != blank -%}
      <a href="{{ section.settings.btn_link | default: '#' }}" class="hp38-story__btn">
        {{ section.settings.btn_label }}
      </a>
    {%- endif -%}
  </div>

  {%- if section.settings.image_position == 'right' -%}
    <div class="hp38-story__image-col">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 1000 }}" alt="{{ section.settings.title | escape }}" class="hp38-story__image" loading="lazy">
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'hp38-story__image' }}
      {%- endif -%}
      <div class="hp38-story__meta-overlay">SYS.IMG.01</div>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "HP38 - Brutalist Story",
  "class": "section-hp38-brand-story",
  "settings": [
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "tag",
      "label": "Meta Tag",
      "default": "ABOUT"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "MISSION"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>We engineer tools for everyday survival in urban environments. Function precedes form. Redundancy is eliminated. Only the essential remains.</p>"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "READ DOSSIER"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 48
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 14,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Text Size",
      "default": 18
    },
    {
      "type": "header",
      "content": "Brutalist Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text & Grid Lines",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#0000FF"
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP38 - Brutalist Story"
    }
  ]
}
{% endschema %}
