{%- liquid
  assign sec_id = section.id
-%}

<style>
  #shopify-section-{{ sec_id }} {
    background-color: {{ section.settings.bg_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px 0;
  }
  
  .hp20-custom-{{ sec_id }} {
    width: {% if section.settings.full_width %}100%{% else %}100%{% endif %};
    max-width: {% if section.settings.full_width %}none{% else %}1400px{% endif %};
    margin: 0 auto;
    {% unless section.settings.full_width %}padding: 0 24px;{% endunless %}
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ sec_id }} {
      padding: {{ section.settings.padding_top_mobile }}px 0 {{ section.settings.padding_bottom_mobile }}px 0;
    }
  }
</style>

<section class="hp20-custom-{{ sec_id }}">
  {% if section.settings.custom_liquid != blank %}
    {{ section.settings.custom_liquid }}
  {% else %}
    <div style="padding: 60px; text-align: center; border: 1px dashed #ccc;">
      <p style="font-family: monospace; color: #666; margin: 0;">Add custom Liquid, HTML, CSS, or JavaScript here.</p>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "HP20 Custom Liquid",
  "settings": [
    {
      "type": "liquid",
      "id": "custom_liquid",
      "label": "Custom Liquid",
      "info": "Add app snippets or other liquid code."
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full Width Container",
      "default": false
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "transparent"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0, "max": 160, "step": 10, "unit": "px",
      "label": "Desktop Top Padding", "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0, "max": 160, "step": 10, "unit": "px",
      "label": "Desktop Bottom Padding", "default": 40
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0, "max": 100, "step": 10, "unit": "px",
      "label": "Mobile Top Padding", "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0, "max": 100, "step": 10, "unit": "px",
      "label": "Mobile Bottom Padding", "default": 20
    }
  ],
  "presets": [
    {
      "name": "HP20 Custom Liquid"
    }
  ]
}
{% endschema %}
