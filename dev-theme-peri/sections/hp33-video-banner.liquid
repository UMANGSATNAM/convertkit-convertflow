{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Montserrat:wght@300;400;500&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --gold-color: {{ section.settings.gold_color }};
    
    --font-heading: 'Playfair Display', serif;
    --font-body: 'Montserrat', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    border-bottom: 1px solid rgba(212, 175, 55, 0.2);
  }

  .hp33-video-wrapper {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp33-video-wrapper {
      padding: 0 20px;
    }
  }

  .hp33-video__container {
    position: relative;
    width: 100%;
    aspect-ratio: 21/9;
    background: #000;
    overflow: hidden;
    padding: 20px;
  }

  @media screen and (max-width: 768px) {
    .hp33-video__container {
      aspect-ratio: 16/9;
      padding: 10px;
    }
  }

  /* Ornate frame inside video */
  .hp33-video__container::before {
    content: '';
    position: absolute;
    top: 15px; left: 15px; right: 15px; bottom: 15px;
    border: 1px solid rgba(212, 175, 55, 0.5);
    z-index: 2;
    pointer-events: none;
  }

  .hp33-video__container::after {
    content: '';
    position: absolute;
    top: 20px; left: 20px; right: 20px; bottom: 20px;
    border: 1px solid rgba(212, 175, 55, 0.2);
    z-index: 2;
    pointer-events: none;
  }

  .hp33-video__media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.7) sepia(20%);
    position: relative;
    z-index: 1;
  }

  .hp33-video__overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    z-index: 3;
    background: rgba(0,0,0,0.3);
    transition: background 0.5s ease;
  }

  .hp33-video__container:hover .hp33-video__overlay {
    background: rgba(0,0,0,0.5);
  }

  .hp33-video__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    color: #fff;
    margin: 0 0 30px;
    font-weight: 400;
    text-transform: capitalize;
  }

  .hp33-video__play-btn {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    border: 1px solid var(--gold-color);
    background: transparent;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    position: relative;
    transition: all 0.4s ease;
  }

  .hp33-video__play-btn::before {
    content: '';
    position: absolute;
    top: 4px; left: 4px; right: 4px; bottom: 4px;
    border: 1px solid rgba(212, 175, 55, 0.4);
    border-radius: 50%;
    transition: all 0.4s ease;
  }

  .hp33-video__play-icon {
    width: 0;
    height: 0;
    border-top: 10px solid transparent;
    border-bottom: 10px solid transparent;
    border-left: 15px solid var(--gold-color);
    margin-left: 5px;
    transition: all 0.4s ease;
  }

  .hp33-video__container:hover .hp33-video__play-btn {
    background: rgba(212, 175, 55, 0.2);
    transform: scale(1.05);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp33-video-wrapper" id="HP33Video-{{ section.id }}">
  <div class="hp33-video__container">
    {%- if section.settings.video_url != blank -%}
      {%- if section.settings.video_url.type == 'youtube' -%}
        <iframe class="hp33-video__media" src="https://www.youtube.com/embed/{{ section.settings.video_url.id }}?autoplay=0&controls=0&mute=1&loop=1&playlist={{ section.settings.video_url.id }}" frameborder="0" allow="autoplay; encrypted-media" allowfullscreen></iframe>
      {%- elsif section.settings.video_url.type == 'vimeo' -%}
        <iframe class="hp33-video__media" src="https://player.vimeo.com/video/{{ section.settings.video_url.id }}?background=1" frameborder="0" allow="autoplay; fullscreen" allowfullscreen></iframe>
      {%- endif -%}
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'hp33-video__media' }}
    {%- endif -%}

    <div class="hp33-video__overlay">
      {%- if section.settings.title != blank -%}
        <h2 class="hp33-video__title">{{ section.settings.title }}</h2>
      {%- endif -%}
      <button class="hp33-video__play-btn" aria-label="Play Film">
        <div class="hp33-video__play-icon"></div>
      </button>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "HP33 - Deco Video",
  "class": "section-hp33-video-banner",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "The Making of a Classic"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "accept": ["youtube", "vimeo"],
      "label": "Video URL"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 48
    },
    {
      "type": "header",
      "content": "Deco Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (e.g. Deep Emerald)",
      "default": "#0e1a14"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "gold_color",
      "label": "Gold Accent",
      "default": "#d4af37"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP33 - Deco Video"
    }
  ]
}
{% endschema %}
