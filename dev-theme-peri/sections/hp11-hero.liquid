{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#0000FF'
  assign text_color = section.settings.text_color | default: '#FFFFFF'
  assign button_bg = section.settings.button_bg | default: '#CCFF00'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 20px;
    border-bottom: 3px solid #000;
  }
  
  .hp11-hero-container-{{ section_id }} {
    position: relative;
    width: 100%;
    height: 80vh;
    min-height: 600px;
    border: 4px solid #000;
    box-shadow: 10px 10px 0 #000;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #000;
    overflow: hidden;
  }
  
  .hp11-hero-bg-{{ section_id }} {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover;
    opacity: 0.7;
    filter: contrast(120%) saturate(120%);
  }
  
  .hp11-hero-content-{{ section_id }} {
    position: relative;
    z-index: 3;
    text-align: center;
    color: {{ text_color }};
    max-width: 900px;
    padding: 0 20px;
  }
  
  .hp11-hero-heading-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: clamp(4rem, 10vw, 8rem);
    font-weight: 900;
    text-transform: uppercase;
    line-height: 0.9;
    margin: 0 0 20px 0;
    letter-spacing: -3px;
    color: #FFFFFF;
    -webkit-text-stroke: 2px #000;
    text-shadow: 5px 5px 0 #FF00FF, 10px 10px 0 #000;
  }
  
  .hp11-hero-subheading-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: 1.2rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 2px;
    background: #000;
    color: #FFF;
    display: inline-block;
    padding: 10px 20px;
    margin-bottom: 40px;
    border: 2px solid #FFF;
  }
  
  .hp11-hero-btn-{{ section_id }} {
    display: inline-block;
    background: {{ button_bg }};
    color: #000;
    padding: 18px 50px;
    border: 3px solid #000;
    box-shadow: 6px 6px 0 #000;
    font-family: 'Inter', sans-serif;
    font-size: 1.2rem;
    font-weight: 900;
    text-transform: uppercase;
    text-decoration: none;
    letter-spacing: 1px;
    transition: all 0.1s ease;
  }
  
  .hp11-hero-btn-{{ section_id }}:hover {
    background: #FF00FF;
    color: #FFF;
    transform: translate(-2px, -2px);
    box-shadow: 8px 8px 0 #000;
  }
  
  .hp11-hero-btn-{{ section_id }}:active {
    transform: translate(4px, 4px);
    box-shadow: 2px 2px 0 #000;
  }
  
  .hp11-hero-sticker-{{ section_id }} {
    position: absolute;
    width: 120px;
    height: 120px;
    background: #CCFF00;
    color: #000;
    border: 3px solid #000;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Inter', sans-serif;
    font-weight: 900;
    font-size: 1.5rem;
    text-transform: uppercase;
    text-align: center;
    line-height: 1;
    transform: rotate(-15deg);
    top: 40px;
    right: 40px;
    box-shadow: 5px 5px 0 #000;
    z-index: 4;
    animation: hp11-spin 10s linear infinite;
  }

  @keyframes hp11-spin {
    100% { transform: rotate(345deg); }
  }

  @media (max-width: 768px) {
    .hp11-hero-container-{{ section_id }} {
      border-width: 2px;
      box-shadow: 5px 5px 0 #000;
    }
    .hp11-hero-sticker-{{ section_id }} {
      width: 90px;
      height: 90px;
      font-size: 1.2rem;
      top: 20px;
      right: 20px;
    }
  }
</style>

<div class="hp11-hero-container-{{ section_id }}">
  {% if section.settings.image != blank %}
    <img src="{{ section.settings.image | image_url: width: 2000 }}" alt="Hero" class="hp11-hero-bg-{{ section_id }}">
  {% else %}
    <div class="hp11-hero-bg-{{ section_id }}" style="background: repeating-linear-gradient(45deg, #EFEFEF, #EFEFEF 12px, #E6E6E6 12px, #E6E6E6 24px);"></div>
  {% endif %}
  
  <div class="hp11-hero-sticker-{{ section_id }}">NEW<br>DROP</div>
  
  <div class="hp11-hero-content-{{ section_id }}">
    <div class="hp11-hero-subheading-{{ section_id }}">{{ section.settings.subheading | default: 'SEASON 01 COLLECTION' }}</div>
    <h1 class="hp11-hero-heading-{{ section_id }}">{{ section.settings.heading | default: 'OUT NOW' }}</h1>
    
    {% if section.settings.button_label != blank %}
      <a href="{{ section.settings.button_link | default: '#' }}" class="hp11-hero-btn-{{ section_id }}">
        {{ section.settings.button_label }}
      </a>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "HP11 Hero",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Outer Background Color",
      "default": "#0000FF"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button Color",
      "default": "#CCFF00"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "SEASON 01 COLLECTION"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "OUT NOW"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "SHOP THE DROP"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "HP11 Hero"
    }
  ]
}
{% endschema %}
