{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#0A1628' }};
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }
  .hp54-bs__container { max-width: {{ section.settings.container_width | default: 1280 }}px; margin: 0 auto; padding: 0 24px; }
  .hp54-bs__header { text-align: center; margin-bottom: 50px; }
  .hp54-bs__eyebrow { font-family: 'Inter', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: #60A5FA; margin: 0 0 12px; }
  .hp54-bs__heading { font-family: 'Tenor Sans', serif; font-size: clamp(28px, 3.5vw, 42px); color: #FFFFFF; margin: 0; }
  .hp54-bs__grid { display: grid; grid-template-columns: repeat({{ section.settings.columns | default: 4 }}, 1fr); gap: 20px; }
  .hp54-bs__card { background: #111D33; border: 1px solid rgba(59, 130, 246, 0.15); border-radius: 12px; overflow: hidden; transition: transform 0.3s ease; }
  .hp54-bs__card:hover { transform: translateY(-6px); }
  .hp54-bs__img-wrap { aspect-ratio: 3/4; overflow: hidden; background: #1E3A5F; }
  .hp54-bs__img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
  .hp54-bs__card:hover .hp54-bs__img { transform: scale(1.06); }
  .hp54-bs__info { padding: 16px 14px; }
  .hp54-bs__name { font-family: 'Tenor Sans', serif; font-size: 15px; color: #FFFFFF; margin: 0 0 6px; text-decoration: none; display: block; }
  .hp54-bs__price { font-size: 15px; font-weight: 700; color: #60A5FA; margin: 0; }
  @media screen and (max-width: 992px) { .hp54-bs__grid { grid-template-columns: repeat(2, 1fr); } }
{%- endstyle -%}
<div class="hp54-bs__container">
  <div class="hp54-bs__header">
    {%- if section.settings.eyebrow != blank -%}<p class="hp54-bs__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="hp54-bs__heading">{{ section.settings.heading | default: 'Most Coveted' }}</h2>
  </div>
  {%- assign collection = collections[section.settings.collection] -%}
  <div class="hp54-bs__grid">
    {%- for product in collection.products limit: section.settings.products_to_show -%}
      <div class="hp54-bs__card">
        <a href="{{ product.url }}" class="hp54-bs__img-wrap">{%- if product.featured_image != blank -%}<img src="{{ product.featured_image | image_url: width: 600 }}" class="hp54-bs__img" alt="{{ product.title }}" loading="lazy">{%- endif -%}</a>
        <div class="hp54-bs__info"><a href="{{ product.url }}" class="hp54-bs__name">{{ product.title }}</a><p class="hp54-bs__price">{{ product.price | money }}</p></div>
      </div>
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "HP54 Bestsellers",
  "class": "section-hp54-bs",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#0A1628" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "◆ MOST LOVED" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Most Coveted" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 12, "step": 1, "label": "Products", "default": 4 },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "label": "Columns", "default": 4 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "presets": [{ "name": "HP54 - Sapphire Bestsellers" }]
}
{% endschema %}
