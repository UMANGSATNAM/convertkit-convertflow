{%- liquid
  assign section_id = section.id
  assign layout = section.settings.layout | default: 'full'
  assign desktop_height = section.settings.desktop_height | default: '80vh'
  assign mobile_height = section.settings.mobile_height | default: '60vh'
  assign content_alignment = section.settings.content_alignment | default: 'center'
  
  assign overlay_color = section.settings.overlay_color | default: '#000000'
  assign overlay_opacity = section.settings.overlay_opacity | default: 40 | divided_by: 100.0
  assign text_color = section.settings.text_color | default: '#FFFFFF'
  
  assign padding_top = section.settings.padding_top | default: 0
  assign padding_bottom = section.settings.padding_bottom | default: 0
  assign padding_top_mobile = section.settings.padding_top_mobile | default: 0
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile | default: 0
-%}

<style>
  #shopify-section-{{ section_id }} {
    --text-color: {{ text_color }};
    --padding-top: {{ padding_top }}px;
    --padding-bottom: {{ padding_bottom }}px;
    --padding-top-mobile: {{ padding_top_mobile }}px;
    --padding-bottom-mobile: {{ padding_bottom_mobile }}px;
    --desktop-height: {{ desktop_height }};
    --mobile-height: {{ mobile_height }};
    
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
  }

  .hpv6-video-banner-{{ section_id }} {
    width: 100%;
    margin: 0 auto;
    {%- if layout == 'boxed' -%}
      max-width: var(--page-width, 1440px);
      padding-left: 5vw;
      padding-right: 5vw;
    {%- endif -%}
  }

  .hpv6-video-banner__container {
    position: relative;
    width: 100%;
    height: var(--desktop-height);
    min-height: 400px;
    background-color: #1A202C;
    display: flex;
    overflow: hidden;
    {%- if layout == 'boxed' -%}
      border-radius: 8px;
    {%- endif -%}
    
    {%- if content_alignment == 'left' -%}
      align-items: center; justify-content: flex-start;
    {%- elsif content_alignment == 'right' -%}
      align-items: center; justify-content: flex-end;
    {%- else -%}
      align-items: center; justify-content: center;
    {%- endif -%}
  }

  .hpv6-video-banner__video-wrap {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    z-index: 1;
  }

  .hpv6-video-banner__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hpv6-video-banner__overlay {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background-color: {{ overlay_color }};
    opacity: {{ overlay_opacity }};
    z-index: 2;
  }

  .hpv6-video-banner__content {
    position: relative;
    z-index: 3;
    padding: 3rem 6vw;
    color: var(--text-color);
    max-width: 800px;
    {%- if content_alignment == 'left' -%}
      text-align: left;
    {%- elsif content_alignment == 'right' -%}
      text-align: right;
    {%- else -%}
      text-align: center;
    {%- endif -%}
  }

  .hpv6-video-banner__subtitle {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    letter-spacing: 3px;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
    font-weight: 500;
  }

  .hpv6-video-banner__title {
    font-family: 'Playfair Display', 'Georgia', serif;
    font-size: clamp(3rem, 6vw, 5.5rem);
    line-height: 1.1;
    font-weight: 400;
    margin: 0 0 1.5rem 0;
    color: var(--text-color);
  }

  .hpv6-video-banner__text {
    font-family: 'Inter', sans-serif;
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    line-height: 1.6;
    margin-bottom: 2.5rem;
    opacity: 0.9;
  }

  .hpv6-video-banner__buttons {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    {%- if content_alignment == 'center' -%}
      justify-content: center;
    {%- elsif content_alignment == 'right' -%}
      justify-content: flex-end;
    {%- endif -%}
  }

  .hpv6-video-banner__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 36px;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    letter-spacing: 2px;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.3s ease;
    min-width: 160px;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding-top: var(--padding-top-mobile);
      padding-bottom: var(--padding-bottom-mobile);
    }
    
    .hpv6-video-banner-{{ section_id }} {
      {%- if layout == 'boxed' -%}
        padding-left: 20px;
        padding-right: 20px;
      {%- endif -%}
    }

    .hpv6-video-banner__container {
      height: var(--mobile-height);
      min-height: 300px;
    }
    
    .hpv6-video-banner__content {
      padding: 2rem 5vw;
    }
    
    .hpv6-video-banner__buttons {
      flex-direction: column;
      width: 100%;
    }
    
    .hpv6-video-banner__btn {
      width: 100%;
    }
  }
</style>

<div class="hpv6-video-banner-{{ section_id }}">
  <div class="hpv6-video-banner__container">
    
    <div class="hpv6-video-banner__overlay"></div>
    
    <div class="hpv6-video-banner__video-wrap">
      {%- if section.settings.video != blank -%}
        {{ section.settings.video | video_tag: 
           class: 'hpv6-video-banner__video', 
           autoplay: true, 
           loop: true, 
           muted: true, 
           controls: false, 
           image_size: '1600x' 
        }}
      {%- elsif section.settings.video_url != blank -%}
        <video class="hpv6-video-banner__video" autoplay muted loop playsinline>
          <source src="{{ section.settings.video_url }}" type="video/mp4">
        </video>
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'hpv6-video-banner__video placeholder-svg' }}
      {%- endif -%}
    </div>

    <div class="hpv6-video-banner__content">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'subtitle' -%}
            {%- if block.settings.text != blank -%}
              <div class="hpv6-video-banner__subtitle" {{ block.shopify_attributes }}>
                {{ block.settings.text | escape }}
              </div>
            {%- endif -%}
            
          {%- when 'title' -%}
            {%- if block.settings.text != blank -%}
              <h2 class="hpv6-video-banner__title" {{ block.shopify_attributes }}>
                {{ block.settings.text | newline_to_br }}
              </h2>
            {%- endif -%}
            
          {%- when 'text' -%}
            {%- if block.settings.text != blank -%}
              <div class="hpv6-video-banner__text" {{ block.shopify_attributes }}>
                {{ block.settings.text }}
              </div>
            {%- endif -%}
            
          {%- when 'buttons' -%}
            <div class="hpv6-video-banner__buttons" {{ block.shopify_attributes }}>
              {%- if block.settings.btn_label_1 != blank -%}
                <a href="{{ block.settings.btn_link_1 | default: '#' }}" 
                   class="hpv6-video-banner__btn" 
                   style="background-color: {{ block.settings.btn_bg_1 }}; color: {{ block.settings.btn_text_1 }}; border: 1px solid {{ block.settings.btn_bg_1 }};">
                  {{ block.settings.btn_label_1 | escape }}
                </a>
              {%- endif -%}
              {%- if block.settings.btn_label_2 != blank -%}
                <a href="{{ block.settings.btn_link_2 | default: '#' }}" 
                   class="hpv6-video-banner__btn" 
                   style="background-color: {{ block.settings.btn_bg_2 }}; color: {{ block.settings.btn_text_2 }}; border: 1px solid {{ block.settings.btn_text_2 }};">
                  {{ block.settings.btn_label_2 | escape }}
                </a>
              {%- endif -%}
            </div>
            
        {%- endcase -%}
      {%- endfor -%}
    </div>
    
  </div>
</div>

{% schema %}
{
  "name": "HPV6 Video Banner",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Video Settings"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Shopify Hosted Video",
      "info": "Overrides the external URL below if selected."
    },
    {
      "type": "url",
      "id": "video_url",
      "label": "External MP4 Video URL"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Section Layout",
      "options": [
        { "value": "full", "label": "Full Width" },
        { "value": "boxed", "label": "Boxed" }
      ],
      "default": "full"
    },
    {
      "type": "select",
      "id": "desktop_height",
      "label": "Desktop Height",
      "options": [
        { "value": "60vh", "label": "Small (60vh)" },
        { "value": "80vh", "label": "Medium (80vh)" },
        { "value": "100vh", "label": "Full Screen (100vh)" }
      ],
      "default": "80vh"
    },
    {
      "type": "select",
      "id": "mobile_height",
      "label": "Mobile Height",
      "options": [
        { "value": "50vh", "label": "Small (50vh)" },
        { "value": "70vh", "label": "Medium (70vh)" },
        { "value": "100vh", "label": "Full Screen (100vh)" }
      ],
      "default": "70vh"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Overlay Opacity",
      "default": 40
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Desktop Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Desktop Padding Bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "subtitle",
      "name": "Subtitle",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Watch the campaign" }
      ]
    },
    {
      "type": "title",
      "name": "Title",
      "limit": 1,
      "settings": [
        { "type": "textarea", "id": "text", "label": "Text", "default": "Motion & Stillness" }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "limit": 1,
      "settings": [
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Discover the inspiration behind our latest collection.</p>" }
      ]
    },
    {
      "type": "buttons",
      "name": "Buttons",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "btn_label_1",
          "label": "Primary Button Label",
          "default": "Shop Collection"
        },
        {
          "type": "url",
          "id": "btn_link_1",
          "label": "Primary Button Link"
        },
        {
          "type": "color",
          "id": "btn_bg_1",
          "label": "Primary Background",
          "default": "#FFFFFF"
        },
        {
          "type": "color",
          "id": "btn_text_1",
          "label": "Primary Text",
          "default": "#000000"
        },
        {
          "type": "text",
          "id": "btn_label_2",
          "label": "Secondary Button Label",
          "default": "View Lookbook"
        },
        {
          "type": "url",
          "id": "btn_link_2",
          "label": "Secondary Button Link"
        },
        {
          "type": "color",
          "id": "btn_bg_2",
          "label": "Secondary Background",
          "default": "transparent"
        },
        {
          "type": "color",
          "id": "btn_text_2",
          "label": "Secondary Text",
          "default": "#FFFFFF"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HPV6 Video Banner",
      "blocks": [
        { "type": "subtitle" },
        { "type": "title" },
        { "type": "buttons" }
      ]
    }
  ]
}
{% endschema %}
