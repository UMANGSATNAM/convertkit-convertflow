{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Shrikhand&family=DM+Sans:wght@400;500;700&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --card-bg: {{ section.settings.card_bg }};
    --accent-color: {{ section.settings.accent_color }};
    
    --font-heading: 'Shrikhand', cursive;
    --font-body: 'DM Sans', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .hp37-faq-wrapper {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp37-faq-wrapper {
      padding: 0 20px;
    }
  }

  .hp37-faq__title {
    font-family: var(--font-heading);
    font-size: clamp(40px, 6vw, {{ section.settings.title_size }}px);
    line-height: 1.1;
    color: var(--text-color);
    margin: 0 0 50px;
    text-align: center;
    text-shadow: 2px 2px 0px var(--accent-color);
  }

  .hp37-faq__item {
    margin-bottom: 20px;
    background: var(--card-bg);
    border: 4px solid var(--text-color);
    border-radius: 20px;
    box-shadow: 6px 6px 0px var(--accent-color);
    overflow: hidden;
  }

  .hp37-faq__question {
    width: 100%;
    text-align: left;
    background: none;
    border: none;
    padding: 25px 30px;
    font-family: var(--font-heading);
    font-size: 22px;
    color: var(--text-color);
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: background 0.2s ease, color 0.2s ease;
  }

  @media screen and (max-width: 768px) {
    .hp37-faq__question {
      font-size: 18px;
      padding: 20px;
    }
  }

  .hp37-faq__question:hover {
    background: var(--accent-color);
    color: var(--bg-color);
  }

  .hp37-faq__icon {
    width: 30px; height: 30px;
    border: 2px solid currentColor;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 20px;
    line-height: 1;
    transition: transform 0.3s ease;
  }

  .hp37-faq__item.is-active .hp37-faq__icon {
    transform: rotate(45deg); /* Turn + into x */
  }

  .hp37-faq__answer {
    display: none;
    padding: 0 30px 30px;
    font-family: var(--font-body);
    font-size: 18px;
    line-height: 1.6;
    color: var(--text-color);
    border-top: 2px dashed var(--text-color);
  }

  @media screen and (max-width: 768px) {
    .hp37-faq__answer {
      padding: 0 20px 20px;
      font-size: 16px;
    }
  }

  .hp37-faq__item.is-active .hp37-faq__answer {
    display: block;
    margin-top: 20px;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp37-faq-wrapper" id="HP37Faq-{{ section.id }}">
  <h2 class="hp37-faq__title">{{ section.settings.title }}</h2>
  
  <div class="hp37-faq__accordion">
    {%- for block in section.blocks -%}
      <div class="hp37-faq__item {% if forloop.first %}is-active{% endif %}" {{ block.shopify_attributes }}>
        <button class="hp37-faq__question">
          {{ block.settings.question }}
          <span class="hp37-faq__icon">+</span>
        </button>
        <div class="hp37-faq__answer">
          {{ block.settings.answer }}
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const wrapper = document.getElementById('HP37Faq-{{ section.id }}');
    const items = wrapper.querySelectorAll('.hp37-faq__item');
    
    items.forEach(item => {
      const btn = item.querySelector('.hp37-faq__question');
      btn.addEventListener('click', () => {
        const isActive = item.classList.contains('is-active');
        
        // Close all
        items.forEach(i => i.classList.remove('is-active'));
        
        // Open clicked if it wasn't already open
        if (!isActive) {
          item.classList.add('is-active');
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "HP37 - Retro FAQ",
  "class": "section-hp37-faq",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Got Questions?"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 40,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 80
    },
    {
      "type": "header",
      "content": "Retro Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#F4E3C5"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background",
      "default": "#F9F3EA"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#4A3219"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#798A58"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Do you ship internationally?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Yes we do! International shipping usually takes 7-14 business days depending on the destination.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP37 - Retro FAQ",
      "blocks": [
        { "type": "faq" },
        { "type": "faq", "settings": { "question": "What is your return policy?", "answer": "<p>We accept returns within 30 days of delivery. Items must be unworn and in original condition.</p>" } },
        { "type": "faq", "settings": { "question": "How do your sizes run?", "answer": "<p>Our items fit true to size. If you prefer a baggier, retro fit, we recommend sizing up!</p>" } }
      ]
    }
  ]
}
{% endschema %}
