{%- style -%}
  #shopify-section-{{ section.id }} {
    --padding-top: {{ section.settings.padding_top }}px;
    --padding-bottom: {{ section.settings.padding_bottom }}px;
    --bg-color: {{ section.settings.bg_color }};
    --heading-color: {{ section.settings.heading_color }};
    --grid-gap: {{ section.settings.grid_gap }}px;
    
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
    background-color: var(--bg-color);
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      --padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      --padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
      --grid-gap: {{ section.settings.mobile_grid_gap }}px;
    }
  }

  .hp19-reels-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 24px;
    overflow: hidden; /* contain scrolling */
  }

  .hp19-reels__header {
    text-align: {{ section.settings.header_alignment }};
    margin-bottom: {{ section.settings.header_margin }}px;
  }

  .hp19-reels__title {
    font-family: 'Baskerville', 'Georgia', serif;
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    color: var(--heading-color);
    margin: 0;
    font-style: italic;
  }
  
  .hp19-reels__subtitle {
    font-family: 'Inter', sans-serif;
    font-size: {{ section.settings.subtitle_size }}px;
    color: var(--heading-color);
    opacity: 0.8;
    margin: 12px 0 0;
  }

  /* Horizontal scrolling on mobile */
  .hp19-reels__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.desktop_columns }}, 1fr);
    gap: var(--grid-gap);
  }

  @media screen and (max-width: 992px) {
    .hp19-reels__grid {
      grid-template-columns: repeat({{ section.settings.tablet_columns }}, 1fr);
    }
  }

  @media screen and (max-width: 768px) {
    .hp19-reels__grid {
      display: flex;
      flex-wrap: nowrap;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-bottom: 24px;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none; /* Firefox */
      margin-left: -24px;
      margin-right: -24px;
      padding-left: 24px;
      padding-right: 24px;
    }
    .hp19-reels__grid::-webkit-scrollbar {
      display: none;
    }
    .hp19-reels__item {
      flex: 0 0 {{ section.settings.mobile_card_width }}%;
      scroll-snap-align: center;
    }
  }

  .hp19-reel {
    position: relative;
    border-radius: {{ section.settings.reel_radius }}px;
    overflow: hidden;
    aspect-ratio: 9/16;
    background: #000;
    cursor: pointer;
    box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    transition: transform 0.4s ease;
  }
  
  .hp19-reel:hover {
    transform: translateY(-8px);
  }
  
  .hp19-reel__media {
    width: 100%; height: 100%;
    object-fit: cover;
    opacity: 0.9;
    transition: opacity 0.3s;
  }
  
  .hp19-reel:hover .hp19-reel__media {
    opacity: 1;
  }
  
  .hp19-reel__overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: linear-gradient(to bottom, transparent 50%, rgba(0,0,0,0.7) 100%);
    z-index: 1;
    pointer-events: none;
  }
  
  .hp19-reel__play {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 48px; height: 48px;
    border-radius: 50%;
    background: rgba(255,255,255,0.2);
    backdrop-filter: blur(4px);
    display: flex; align-items: center; justify-content: center;
    color: #fff;
    z-index: 2;
    pointer-events: none;
  }
  .hp19-reel__play svg { width: 24px; height: 24px; margin-left: 3px; }

  .hp19-reel__info {
    position: absolute;
    bottom: 20px;
    left: 20px;
    right: 20px;
    z-index: 3;
    color: #fff;
  }
  
  .hp19-reel__handle {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 4px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  
  .hp19-reel__views {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    opacity: 0.8;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp19-reels-wrapper" id="HP19Reels-{{ section.id }}">
  <div class="hp19-reels__header">
    {%- if section.settings.title != blank -%}
      <h2 class="hp19-reels__title">{{ section.settings.title | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.subtitle != blank -%}
      <p class="hp19-reels__subtitle">{{ section.settings.subtitle | escape }}</p>
    {%- endif -%}
  </div>

  <div class="hp19-reels__grid">
    {%- for block in section.blocks -%}
      <div class="hp19-reels__item" {{ block.shopify_attributes }}>
        <a href="{{ block.settings.link | default: '#' }}" class="hp19-reel" target="_blank">
          {%- if block.settings.image != blank -%}
            <img height="{{ block.settings.image.height }}" width="{{ block.settings.image.width }}" src="{{ block.settings.image | image_url: width: 600 }}" alt="" class="hp19-reel__media" loading="lazy">
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'hp19-reel__media placeholder-svg' }}
          {%- endif -%}
          
          <div class="hp19-reel__overlay"></div>
          
          <div class="hp19-reel__play">
            <svg viewBox="0 0 24 24" fill="currentColor">
              <path d="M8 5v14l11-7z"/>
            </svg>
          </div>
          
          <div class="hp19-reel__info">
            <div class="hp19-reel__handle">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
              </svg>
              {{ block.settings.handle | default: '@username' }}
            </div>
            {%- if block.settings.views != blank -%}
              <div class="hp19-reel__views">▶ {{ block.settings.views }}</div>
            {%- endif -%}
          </div>
        </a>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "HP19 - UGC Reels Pro",
  "class": "section-hp19-ugc-reels",
  "max_blocks": 8,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Spotted On Social"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Tag us @brandname to be featured"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 48
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Subtitle Size",
      "default": 16
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "header_margin",
      "min": 20,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Spacing Below Header",
      "default": 48
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1400
    },
    {
      "type": "range",
      "id": "desktop_columns",
      "min": 3,
      "max": 6,
      "step": 1,
      "label": "Desktop Columns",
      "default": 4
    },
    {
      "type": "range",
      "id": "tablet_columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Tablet Columns",
      "default": 3
    },
    {
      "type": "range",
      "id": "mobile_card_width",
      "min": 40,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Mobile Card Width",
      "info": "Controls the horizontal scroll peek effect",
      "default": 65
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Grid Gap (Desktop)",
      "default": 24
    },
    {
      "type": "range",
      "id": "mobile_grid_gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Grid Gap (Mobile)",
      "default": 16
    },
    {
      "type": "range",
      "id": "reel_radius",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Reel Border Radius",
      "default": 16
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#FEF3C7"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Text Color",
      "default": "#451A03"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 100
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "reel",
      "name": "Social Reel",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Thumbnail Image"
        },
        {
          "type": "text",
          "id": "handle",
          "label": "Social Handle",
          "default": "@customer_name"
        },
        {
          "type": "text",
          "id": "views",
          "label": "Views/Likes Text",
          "default": "12.4K Views"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link to Post"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP19 - UGC Reels Pro",
      "category": "Social",
      "blocks": [
        { "type": "reel" },
        { "type": "reel" },
        { "type": "reel" },
        { "type": "reel" }
      ]
    }
  ]
}
{% endschema %}
