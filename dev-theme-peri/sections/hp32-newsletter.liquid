{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Space+Mono:ital,wght@0,400;0,700;1,400;1,700&family=Syne:wght@700;800&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --border-color: #000000;
    --accent-color: {{ section.settings.accent_color }};
    
    --font-heading: 'Syne', sans-serif;
    --font-body: 'Space Mono', monospace;
    
    background-color: var(--bg-color);
    border-bottom: 4px solid var(--border-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    
    /* Dotted background pattern */
    background-image: radial-gradient(var(--border-color) 2px, transparent 2px);
    background-size: 20px 20px;
  }

  .hp32-news-wrapper {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp32-news-wrapper {
      padding: 0 20px;
    }
  }

  .hp32-news__container {
    background: #fff;
    border: 4px solid var(--border-color);
    padding: 60px;
    text-align: center;
    box-shadow: 16px 16px 0 var(--border-color);
    position: relative;
  }

  @media screen and (max-width: 768px) {
    .hp32-news__container {
      padding: 40px 20px;
      box-shadow: 8px 8px 0 var(--border-color);
    }
  }

  /* Tech decorations */
  .hp32-news__container::before,
  .hp32-news__container::after {
    content: '';
    position: absolute;
    width: 20px;
    height: 4px;
    background: var(--border-color);
  }

  .hp32-news__container::before {
    top: -4px; left: 20px;
  }
  .hp32-news__container::after {
    bottom: -4px; right: 20px;
  }

  .hp32-news__tag {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 700;
    background: #000;
    color: var(--accent-color);
    padding: 4px 12px;
    display: inline-block;
    margin-bottom: 20px;
    text-transform: uppercase;
  }

  .hp32-news__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    line-height: 1;
    color: #000;
    text-transform: uppercase;
    margin: 0 0 20px;
    letter-spacing: -1px;
  }

  .hp32-news__text {
    font-family: var(--font-body);
    font-size: 16px;
    color: #000;
    margin: 0 0 40px;
    font-weight: 700;
  }

  .hp32-news__form {
    display: flex;
    max-width: 600px;
    margin: 0 auto;
    position: relative;
  }

  @media screen and (max-width: 576px) {
    .hp32-news__form {
      flex-direction: column;
      gap: 15px;
    }
  }

  .hp32-news__input {
    flex: 1;
    border: 4px solid var(--border-color);
    padding: 15px 20px;
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 700;
    outline: none;
    background: #f9f9f9;
  }

  .hp32-news__input::placeholder {
    color: #000;
    opacity: 0.5;
    text-transform: uppercase;
  }

  .hp32-news__input:focus {
    background: #fff;
    border-color: var(--accent-color);
  }

  .hp32-news__btn {
    background: var(--border-color);
    color: var(--accent-color);
    border: 4px solid var(--border-color);
    border-left: none;
    padding: 15px 30px;
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 700;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  @media screen and (max-width: 576px) {
    .hp32-news__btn {
      border-left: 4px solid var(--border-color);
      width: 100%;
    }
  }

  .hp32-news__btn:hover,
  .hp32-news__btn:active {
    background: var(--accent-color);
    color: #000;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp32-news-wrapper" id="HP32News-{{ section.id }}">
  <div class="hp32-news__container">
    {%- if section.settings.tagline != blank -%}
      <div class="hp32-news__tag">{{ section.settings.tagline }}</div>
    {%- endif -%}
    
    <h2 class="hp32-news__title">{{ section.settings.title }}</h2>
    
    {%- if section.settings.text != blank -%}
      <p class="hp32-news__text">{{ section.settings.text }}</p>
    {%- endif -%}

    {% form 'customer', class: 'hp32-news__form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      
      {%- if form.posted_successfully? -%}
        <div class="hp32-news__success" style="font-family: var(--font-body); font-weight: 700; background: var(--accent-color); padding: 10px; border: 4px solid #000; position: absolute; top: -50px; left: 0; right: 0;">
          UPLINK ESTABLISHED.
        </div>
      {%- else -%}
        <input 
          type="email" 
          name="contact[email]" 
          class="hp32-news__input" 
          placeholder="ENTER_EMAIL_ADDRESS" 
          required
        >
        <button type="submit" class="hp32-news__btn">
          {{ section.settings.btn_label }}
        </button>
      {%- endif -%}
    {% endform %}
  </div>
</div>

{% schema %}
{
  "name": "HP32 - Brutalist News",
  "class": "section-hp32-newsletter",
  "settings": [
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "SYSTEM_UPLINK"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Heading",
      "default": "ESTABLISH CONNECTION"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "RECEIVE TRANSMISSIONS REGARDING NEW HARDWARE DEPLOYMENTS."
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "CONNECT"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 48
    },
    {
      "type": "header",
      "content": "Brutalist Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (Dot Pattern base)",
      "default": "#e0e0e0"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color (e.g. Lime)",
      "default": "#ccff00"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 100
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP32 - Brutalist News"
    }
  ]
}
{% endschema %}
