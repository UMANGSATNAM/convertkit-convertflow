{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400;1,600&family=Oswald:wght@300;400;500&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --border-color: {{ section.settings.border_color }};
    
    --font-serif: 'Playfair Display', serif;
    --font-sans: 'Oswald', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    border-bottom: 1px solid var(--border-color);
  }

  .hp36-video-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16/9;
    background: #111;
    overflow: hidden;
  }

  @media screen and (max-width: 768px) {
    .hp36-video-wrapper {
      aspect-ratio: 4/5;
    }
  }

  .hp36-video__media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%);
  }

  .hp36-video__overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0,0,0,0.4);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    z-index: 3;
    padding: 40px;
    text-align: center;
  }

  .hp36-video__title {
    font-family: var(--font-sans);
    font-size: clamp(60px, 12vw, {{ section.settings.title_size }}px);
    line-height: 0.9;
    color: #fff;
    margin: 0;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    position: relative;
  }
  
  .hp36-video__title em {
    font-family: var(--font-serif);
    font-style: italic;
    text-transform: lowercase;
  }

  .hp36-video__play-btn {
    position: absolute;
    bottom: 40px;
    font-family: var(--font-sans);
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: #fff;
    background: transparent;
    border: 1px solid #fff;
    padding: 15px 30px;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .hp36-video__play-btn:hover {
    background: #fff;
    color: #000;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp36-video-wrapper" id="HP36Video-{{ section.id }}">
  {%- if section.settings.video_url != blank -%}
    {%- if section.settings.video_url.type == 'youtube' -%}
      <iframe class="hp36-video__media" src="https://www.youtube.com/embed/{{ section.settings.video_url.id }}?autoplay=0&controls=0&mute=1&loop=1&playlist={{ section.settings.video_url.id }}" frameborder="0" allow="autoplay; encrypted-media" allowfullscreen></iframe>
    {%- elsif section.settings.video_url.type == 'vimeo' -%}
      <iframe class="hp36-video__media" src="https://player.vimeo.com/video/{{ section.settings.video_url.id }}?background=1" frameborder="0" allow="autoplay; fullscreen" allowfullscreen></iframe>
    {%- endif -%}
  {%- else -%}
    {{ 'lifestyle-1' | placeholder_svg_tag: 'hp36-video__media' }}
  {%- endif -%}

  <div class="hp36-video__overlay">
    {%- if section.settings.title != blank -%}
      <h2 class="hp36-video__title">{{ section.settings.title | replace: 'Motion', '<em>Motion</em>' }}</h2>
    {%- endif -%}
    <button class="hp36-video__play-btn" aria-label="Play Video">Watch Film</button>
  </div>
</div>

{% schema %}
{
  "name": "HP36 - Editorial Video",
  "class": "section-hp36-video-banner",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "THE CAMPAIGN"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "accept": ["youtube", "vimeo"],
      "label": "Video URL"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 40,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "Heading Size",
      "default": 140
    },
    {
      "type": "header",
      "content": "Editorial Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 0
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP36 - Editorial Video"
    }
  ]
}
{% endschema %}
