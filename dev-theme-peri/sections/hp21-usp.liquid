{%- style -%}
  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --border-color: {{ section.settings.border_color }};
    --font-heading: 'Playfair Display', serif;
    --font-body: 'Jost', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }

  .hp21-usp-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp21-usp-wrapper {
      padding: 0 20px;
    }
  }

  .hp21-usp__header {
    text-align: center;
    margin-bottom: {{ section.settings.header_margin }}px;
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
  }

  .hp21-usp__title {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(28px, 5vw, {{ section.settings.title_size }}px);
    color: var(--text-color);
    line-height: 1.2;
    margin: 0 0 16px;
  }
  
  .hp21-usp__title em {
    font-style: italic;
    color: var(--accent-color);
  }

  .hp21-usp__subtitle {
    font-family: var(--font-body);
    font-size: {{ section.settings.subtitle_size }}px;
    font-weight: 300;
    color: var(--text-color);
    opacity: 0.7;
    margin: 0;
    letter-spacing: 1px;
  }

  .hp21-usp__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.desktop_columns }}, 1fr);
    gap: {{ section.settings.gap }}px;
  }

  @media screen and (max-width: 992px) {
    .hp21-usp__grid {
      grid-template-columns: repeat({{ section.settings.tablet_columns }}, 1fr);
    }
  }

  @media screen and (max-width: 768px) {
    .hp21-usp__grid {
      grid-template-columns: repeat({{ section.settings.mobile_columns }}, 1fr);
      gap: {{ section.settings.mobile_gap }}px;
    }
  }

  .hp21-usp__card {
    text-align: {{ section.settings.text_alignment }};
    padding: {{ section.settings.card_padding }}px;
    background: linear-gradient(145deg, rgba(255,255,255,0.03) 0%, rgba(255,255,255,0) 100%);
    border: 1px solid var(--border-color);
    transition: transform 0.4s ease, border-color 0.4s ease;
    display: flex;
    flex-direction: column;
    align-items: {% if section.settings.text_alignment == 'center' %}center{% elsif section.settings.text_alignment == 'right' %}flex-end{% else %}flex-start{% endif %};
  }

  .hp21-usp__card:hover {
    transform: translateY(-5px);
    border-color: rgba(255,255,255,0.15);
  }

  .hp21-usp__icon {
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;
    margin-bottom: 24px;
    color: var(--accent-color);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }
  
  .hp21-usp__icon::after {
    content: '';
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: calc(100% + 20px);
    height: calc(100% + 20px);
    border: 1px solid var(--border-color);
    border-radius: 50%;
    opacity: 0.5;
    transition: opacity 0.4s, border-color 0.4s;
  }
  
  .hp21-usp__card:hover .hp21-usp__icon::after {
    opacity: 1;
    border-color: var(--accent-color);
  }

  .hp21-usp__icon svg, .hp21-usp__icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .hp21-usp__card-title {
    font-family: var(--font-body);
    font-size: {{ section.settings.card_title_size }}px;
    font-weight: 400;
    color: var(--text-color);
    text-transform: uppercase;
    letter-spacing: 2px;
    margin: 0 0 12px;
  }

  .hp21-usp__card-text {
    font-family: var(--font-body);
    font-size: {{ section.settings.card_text_size }}px;
    font-weight: 300;
    color: var(--text-color);
    opacity: 0.6;
    margin: 0;
    line-height: 1.6;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp21-usp-wrapper" id="HP21USP-{{ section.id }}">
  
  {%- if section.settings.title != blank or section.settings.subtitle != blank -%}
    <div class="hp21-usp__header">
      {%- if section.settings.title != blank -%}
        <h2 class="hp21-usp__title">{{ section.settings.title }}</h2>
      {%- endif -%}
      {%- if section.settings.subtitle != blank -%}
        <p class="hp21-usp__subtitle">{{ section.settings.subtitle | escape }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="hp21-usp__grid">
    {%- for block in section.blocks -%}
      <div class="hp21-usp__card" {{ block.shopify_attributes }}>
        <div class="hp21-usp__icon">
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 150 }}" alt="{{ block.settings.title | escape }}" loading="lazy">
          {%- else -%}
            <!-- Fallback elegant icon -->
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
            </svg>
          {%- endif -%}
        </div>
        <h3 class="hp21-usp__card-title">{{ block.settings.title | escape }}</h3>
        <p class="hp21-usp__card-text">{{ block.settings.text | escape }}</p>
      </div>
    {%- endfor -%}
  </div>

</div>

{% schema %}
{
  "name": "HP21 - Luxury USP",
  "class": "section-hp21-usp",
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Heading",
      "default": "<p>The <em>Standard</em> of Excellence</p>"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Uncompromising quality in every detail"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 40
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Subtitle Size",
      "default": 14
    },
    {
      "type": "range",
      "id": "header_margin",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Margin Below Header",
      "default": 60
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1400
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Card Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "desktop_columns",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Desktop Columns",
      "default": 3
    },
    {
      "type": "range",
      "id": "tablet_columns",
      "min": 1,
      "max": 3,
      "step": 1,
      "label": "Tablet Columns",
      "default": 2
    },
    {
      "type": "range",
      "id": "mobile_columns",
      "min": 1,
      "max": 2,
      "step": 1,
      "label": "Mobile Columns",
      "default": 1
    },
    {
      "type": "range",
      "id": "gap",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Desktop Gap",
      "default": 32
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "min": 10,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Mobile Gap",
      "default": 20
    },
    {
      "type": "range",
      "id": "card_padding",
      "min": 20,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Card Padding",
      "default": 40
    },
    {
      "type": "header",
      "content": "Card Styling"
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Icon Size",
      "default": 40
    },
    {
      "type": "range",
      "id": "card_title_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Card Title Size",
      "default": 16
    },
    {
      "type": "range",
      "id": "card_text_size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Card Text Size",
      "default": 14
    },
    {
      "type": "header",
      "content": "Luxury Styling"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#0A0A0A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color (Icons/Emphasis)",
      "default": "#D4AF37"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "rgba(255, 255, 255, 0.05)"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 100
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "usp",
      "name": "USP Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Icon (Optional)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Bespoke Craftsmanship"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Every piece is carefully curated and inspected to ensure it meets our exacting standards."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP21 - Luxury USP",
      "blocks": [
        { "type": "usp" },
        { "type": "usp" },
        { "type": "usp" }
      ]
    }
  ]
}
{% endschema %}
