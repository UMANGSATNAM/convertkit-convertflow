{%- liquid
  assign sec_id = section.id
-%}

<style>
  #shopify-section-{{ sec_id }} {
    background-color: {{ section.settings.bg_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px 0;
  }

  .hp20-gallery-{{ sec_id }} {
    max-width: {% if section.settings.full_width %}none{% else %}1400px{% endif %};
    margin: 0 auto;
    {% unless section.settings.full_width %}padding: 0 24px;{% endunless %}
  }

  .hp20-gallery-{{ sec_id }}__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: {{ section.settings.gap }}px;
  }

  .hp20-gallery-item {
    position: relative;
    padding-top: {{ section.settings.aspect_ratio }}%;
    background-color: #f0f0f0;
    overflow: hidden;
  }

  .hp20-gallery-item__img {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease, filter 0.6s ease;
  }

  .hp20-gallery-item:hover .hp20-gallery-item__img {
    transform: scale(1.05);
  }

  @media screen and (max-width: 990px) {
    .hp20-gallery-{{ sec_id }}__grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile | default: 2 }}, 1fr);
      gap: {{ section.settings.gap | divided_by: 2 }}px;
    }
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ sec_id }} {
      padding: {{ section.settings.padding_top_mobile }}px 0 {{ section.settings.padding_bottom_mobile }}px 0;
    }
    .hp20-gallery-{{ sec_id }}__grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr);
    }
  }
</style>

<section class="hp20-gallery-{{ sec_id }}">
  <div class="hp20-gallery-{{ sec_id }}__grid">
    {% for block in section.blocks %}
      <div class="hp20-gallery-item" {{ block.shopify_attributes }}>
        {% if block.settings.link != blank %}
          <a href="{{ block.settings.link }}" style="display:block; width:100%; height:100%; position:absolute; top:0; left:0; z-index:2;">
        {% endif %}
        
        {% if block.settings.image != blank %}
          <img src="{{ block.settings.image | image_url: width: 1000 }}" alt="{{ block.settings.image.alt | escape }}" class="hp20-gallery-item__img" loading="lazy">
        {% else %}
          {{ 'image' | placeholder_svg_tag: 'hp20-gallery-item__img' }}
        {% endif %}

        {% if block.settings.link != blank %}
          </a>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "HP20 Editorial Gallery",
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full Width",
      "default": false
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1, "max": 6, "step": 1,
      "label": "Columns on Desktop", "default": 3
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "min": 1, "max": 3, "step": 1,
      "label": "Columns on Mobile", "default": 1
    },
    {
      "type": "range",
      "id": "gap",
      "min": 0, "max": 60, "step": 2, "unit": "px",
      "label": "Grid Gap", "default": 20
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Image Aspect Ratio",
      "options": [
        { "value": "100", "label": "Square (1:1)" },
        { "value": "125", "label": "Portrait (4:5)" },
        { "value": "150", "label": "Tall (2:3)" },
        { "value": "66.66", "label": "Landscape (3:2)" }
      ],
      "default": "125"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0, "max": 160, "step": 10, "unit": "px",
      "label": "Desktop Top Padding", "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0, "max": 160, "step": 10, "unit": "px",
      "label": "Desktop Bottom Padding", "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0, "max": 100, "step": 10, "unit": "px",
      "label": "Mobile Top Padding", "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0, "max": 100, "step": 10, "unit": "px",
      "label": "Mobile Bottom Padding", "default": 40
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (Optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP20 Editorial Gallery",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
