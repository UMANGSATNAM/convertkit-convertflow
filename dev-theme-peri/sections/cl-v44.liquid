{% comment %} CL V44 — Kids / Toys (Bright Colors) {% endcomment %}
{{ 'component-facets.css' | asset_url | stylesheet_tag }}
<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
<style>
  .clv44 { background: {{ section.settings.bg_color | default: '#E0F2FE' }}; color: {{ section.settings.text_color | default: '#0F172A' }}; padding: 40px 20px; font-family: 'Fredoka One', 'Varela Round', sans-serif; }
  .clv44-hero { text-align: center; margin-bottom: 40px; background: #FFF; padding: 40px; border-radius: 40px; border: 4px solid #38BDF8; box-shadow: 0 10px 0 #38BDF8; }
  .clv44-hero h1 { font-size: 46px; color: #F59E0B; margin-bottom: 15px; text-shadow: 2px 2px 0 #FDE68A; }
  .clv44-hero p { font-size: 18px; color: #64748B; font-family: 'Varela Round', sans-serif; font-weight: bold; }
  .clv44-chips { display: flex; gap: 15px; justify-content: center; margin-bottom: 40px; flex-wrap: wrap; }
  .clv44-chips a { padding: 12px 24px; background: #F43F5E; color: #FFF; text-decoration: none; font-size: 16px; border-radius: 30px; border: 3px solid #BE123C; box-shadow: 0 5px 0 #BE123C; transition: transform 0.1s, box-shadow 0.1s; }
  .clv44-chips a:nth-child(2n) { background: #10B981; border-color: #047857; box-shadow: 0 5px 0 #047857; }
  .clv44-chips a:nth-child(3n) { background: #8B5CF6; border-color: #5B21B6; box-shadow: 0 5px 0 #5B21B6; }
  .clv44-chips a:hover, .clv44-chips a.active { transform: translateY(5px); box-shadow: 0 0 0 transparent !important; }
  .clv44-toolbar { background: #FFF; padding: 20px; border-radius: 20px; border: 3px solid #E2E8F0; margin-bottom: 30px; box-shadow: 0 5px 15px rgba(0,0,0,0.05); }
  .clv44-grid { display: grid; grid-template-columns: repeat({{ section.settings.cols_desktop | default: 4 }}, 1fr); gap: 20px; }
  .clv44-promo { grid-column: span 1; background: #FDE047; border-radius: 30px; padding: 30px; text-align: center; border: 4px solid #CA8A04; display: flex; flex-direction: column; justify-content: center; box-shadow: 0 8px 0 #CA8A04; }
  .clv44-promo h3 { font-size: 28px; color: #B45309; margin-bottom: 20px; }
  .clv44-promo a { display: inline-block; padding: 12px 25px; background: #FFF; color: #B45309; text-decoration: none; border-radius: 25px; border: 3px solid #B45309; font-size: 16px; box-shadow: 0 4px 0 #B45309; transition: 0.1s; }
  .clv44-promo a:hover { transform: translateY(4px); box-shadow: 0 0 0 transparent; }
  .clv44-seo { margin-top: 50px; background: #FFF; padding: 40px; border-radius: 30px; text-align: center; border: 3px dashed #38BDF8; }
  @media (max-width: 768px) { .clv44-grid { grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr); gap: 15px; } .clv44-hero h1 { font-size: 34px; } }
</style>
<div class="clv44" style="max-width: 1200px; margin: 0 auto;">
  <div class="clv44-hero">
    <h1>{% if collection.title != blank %}{{ collection.title | escape }}{% else %}Playtime Magic{% endif %}</h1>
    <p>{% if collection.description != blank %}{{ collection.description }}{% else %}Toys that spark imagination and endless fun!{% endif %}</p>
  </div>
  {% if section.settings.sub_collections != blank %}
    <div class="clv44-chips">
      {% for link in section.settings.sub_collections.links %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% endfor %}
    </div>
  {% endif %}
  <div class="clv44-toolbar">
    <facet-filters-form style="width: 100%;">
      <form id="FacetFiltersForm" style="display: flex; justify-content: space-between; align-items: center; width: 100%; flex-wrap: wrap; gap: 20px;">
        <div style="display: flex; gap: 20px;">
          {%- for filter in collection.filters -%}
            <details style="position: relative;">
              <summary style="cursor: pointer; font-size: 18px; color: #38BDF8;">{{ filter.label }} 🎈</summary>
              <div style="position: absolute; background: #FFF; border: 3px solid #38BDF8; padding: 20px; border-radius: 20px; z-index: 10; margin-top: 15px; min-width: 220px; box-shadow: 0 8px 0 #38BDF8;">
                {%- for value in filter.values -%}
                  <label style="display: block; margin-bottom: 12px; cursor: pointer; font-size: 16px; font-family: 'Varela Round', sans-serif;">
                    <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %}>
                    {{ value.label }} ({{ value.count }})
                  </label>
                {%- endfor -%}
              </div>
            </details>
          {%- endfor -%}
        </div>
        <select name="sort_by" onchange="this.form.submit()" style="background: #F8FAFC; border: 2px solid #CBD5E1; color: #475569; padding: 10px 20px; border-radius: 20px; font-size: 16px; font-family: inherit; cursor: pointer; outline: none;">
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>Sort: {{ option.name }}</option>
          {%- endfor -%}
        </select>
      </form>
    </facet-filters-form>
  </div>
  {% assign limit_num = section.settings.products_per_page | default: 16 %}
  {% paginate collection.products by limit_num %}
    <div class="clv44-grid">
      {% for product in collection.products %}
        {% render 'card-v44', product: product %}
        {% if forloop.index == 8 and section.settings.show_promo_tile %}
          <div class="clv44-promo">
            <h3>Puzzle<br>Time</h3>
            <a href="/collections/puzzles">Find Them</a>
          </div>
        {% endif %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v44', product: nil %}
        {% endfor %}
      {% endfor %}
    </div>
    <div style="margin-top: 50px; text-align: center; font-size: 20px; color: #38BDF8;">{{ paginate | default_pagination }}</div>
  {% endpaginate %}
  {% if section.settings.show_seo_block %}
    <div class="clv44-seo">
      <h2 style="font-size: 28px; color: #10B981; margin-bottom: 15px;">{{ section.settings.seo_title | default: 'Learn & Play' }}</h2>
      <p style="font-size: 16px; font-family: 'Varela Round', sans-serif; color: #475569; max-width: 700px; margin: 0 auto; line-height: 1.6;">{{ section.settings.seo_text | default: 'Our toys are carefully selected to encourage cognitive development, motor skills, and most importantly, big smiles.' }}</p>
    </div>
  {% endif %}
</div>
{% schema %}
{
  "name": "CL V44 — Kids", "settings": [
    {"type": "range", "id": "products_per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 16},
    {"type": "range", "id": "cols_desktop", "label": "Desktop Columns", "min": 2, "max": 5, "default": 4},
    {"type": "select", "id": "cols_mobile", "label": "Mobile Columns", "options": [{"value": "1", "label": "1"}, {"value": "2", "label": "2"}], "default": "2"},
    {"type": "link_list", "id": "sub_collections", "label": "Sub-Collection Menu"},
    {"type": "checkbox", "id": "show_promo_tile", "label": "Show Promo Card", "default": true},
    {"type": "checkbox", "id": "show_seo_block", "label": "Show SEO Block", "default": true},
    {"type": "color", "id": "bg_color", "label": "Background Color", "default": "#E0F2FE"},
    {"type": "color", "id": "text_color", "label": "Text Color", "default": "#0F172A"}
  ], "presets": [{"name": "CL V44 — Kids"}]
}
{% endschema %}
