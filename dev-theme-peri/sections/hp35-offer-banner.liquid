{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;1,400&family=Nunito:wght@300;400;600&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --button-bg: {{ section.settings.button_bg }};
    --button-text: {{ section.settings.button_text }};
    
    --font-heading: 'Lora', serif;
    --font-body: 'Nunito', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    position: relative;
    overflow: hidden;
  }

  .hp35-offer-wrapper {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 40px;
    text-align: center;
    position: relative;
    z-index: 2;
  }

  .hp35-offer__subtitle {
    font-family: var(--font-body);
    font-size: 13px;
    color: var(--text-color);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-bottom: 20px;
    opacity: 0.8;
  }

  .hp35-offer__title {
    font-family: var(--font-heading);
    font-size: clamp(40px, 8vw, {{ section.settings.title_size }}px);
    line-height: 1.1;
    color: var(--text-color);
    margin: 0 0 30px;
    font-weight: 400;
  }

  .hp35-offer__title em {
    font-style: italic;
  }

  .hp35-offer__text {
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.8;
    color: var(--text-color);
    margin: 0 auto 40px;
    max-width: 500px;
    opacity: 0.9;
  }

  .hp35-offer__btn {
    font-family: var(--font-body);
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-decoration: none;
    padding: 18px 40px;
    border-radius: 50px;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: var(--button-bg);
    color: var(--button-text);
    transition: all 0.4s ease;
  }

  .hp35-offer__btn:hover {
    transform: translateY(-2px);
    opacity: 0.9;
    box-shadow: 0 10px 20px rgba(0,0,0,0.1);
  }

  /* Organic blob animation */
  .hp35-offer__blob {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 80vw; height: 80vw;
    max-width: 800px; max-height: 800px;
    background: #000;
    opacity: 0.03;
    border-radius: 40% 60% 70% 30% / 40% 50% 60% 50%;
    animation: blob-morph 15s ease-in-out infinite alternate;
    z-index: 1;
    pointer-events: none;
  }

  @keyframes blob-morph {
    0% { border-radius: 40% 60% 70% 30% / 40% 50% 60% 50%; }
    100% { border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%; }
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp35-offer-wrapper" id="HP35Offer-{{ section.id }}">
  <div class="hp35-offer__blob"></div>
  
  {%- if section.settings.subtitle != blank -%}
    <div class="hp35-offer__subtitle">{{ section.settings.subtitle }}</div>
  {%- endif -%}
  
  <h2 class="hp35-offer__title">{{ section.settings.title | replace: 'season', '<em>season</em>' }}</h2>
  
  {%- if section.settings.text != blank -%}
    <p class="hp35-offer__text">{{ section.settings.text }}</p>
  {%- endif -%}
  
  {%- if section.settings.btn_label != blank -%}
    <a href="{{ section.settings.btn_link | default: '#' }}" class="hp35-offer__btn">
      {{ section.settings.btn_label }}
    </a>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "HP35 - Organic Offer",
  "class": "section-hp35-offer-banner",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "A GIFT FROM US"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Heading",
      "default": "Embrace the new season."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Enjoy 15% off your first purchase as a welcome to our community."
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "Shop the Collection"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 40,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 64
    },
    {
      "type": "header",
      "content": "Organic Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (e.g. Forest Green)",
      "default": "#2C422F"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FDFBF7"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button Background",
      "default": "#CC7B5E"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Button Text",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 120
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP35 - Organic Offer"
    }
  ]
}
{% endschema %}
