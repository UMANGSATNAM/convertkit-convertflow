{%- comment -%}
  Component: fb04-hero-tabs_streetwear.liquid
  Family: Frameblox Landing 04 Replica
  Exact Specification: Full-bleed Hero Card Container with gradient overlay, 
  Big Shoulders Display typography, White Pill CTA button with right-arrow circle,
  and 5 horizontal bottom numbered tabs (01-05).
{%- endcomment -%}

{%- liquid
  assign section_prefix = 'fb04-hero-' | append: section.id
-%}

<style>
  #shopify-section-{{ section.id }} {
    --fb-bg: {{ section.settings.bg_color | default: '#FFFFFF' }};
    --fb-primary: {{ section.settings.primary_color | default: '#0066FF' }};
  }

  .fb04-hero-section {
    padding-top: clamp(1.5rem, 4vw, 3rem);
    padding-bottom: clamp(1.5rem, 4vw, 3rem);
    background: var(--fb-bg);
  }

  .fb04-hero-card-container {
    max-width: 1200px;
    margin: 0 auto;
    border-radius: 28px;
    overflow: hidden;
    position: relative;
    min-height: 620px;
    background-color: #18191c;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.15);
  }

  /* Panes (Full-bleed card backgrounds) */
  .fb04-hero-card-pane {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center center;
    background-repeat: no-repeat;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    padding: clamp(2.5rem, 6vw, 4.5rem) clamp(2rem, 5vw, 4rem) 160px;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 1;
  }

  .fb04-hero-card-pane.active {
    opacity: 1;
    visibility: visible;
    z-index: 2;
  }

  .fb04-hero-card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.35) 0%, rgba(0, 0, 0, 0.75) 100%);
    pointer-events: none;
    z-index: 1;
  }

  /* Left Content Stack */
  .fb04-hero-card-content {
    position: relative;
    z-index: 3;
    max-width: 600px;
    text-align: left;
  }

  .fb04-hero-card-pane.active .fb04-hero-card-content {
    animation: fb04SlideUp 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes fb04SlideUp {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .fb04-hero-title {
    font-family: 'Big Shoulders Display', var(--font-heading, sans-serif);
    font-weight: 800;
    font-size: clamp(2.5rem, 6vw, 4.75rem);
    line-height: 1.02;
    text-transform: uppercase;
    letter-spacing: -1px;
    color: #FFFFFF;
    margin: 0 0 20px 0;
  }

  .fb04-hero-subtitle {
    font-family: var(--font-body, -apple-system, BlinkMacSystemFont, sans-serif);
    font-weight: 400;
    font-size: clamp(1rem, 1.8vw, 1.125rem);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.85);
    margin: 0 0 34px 0;
    max-width: 520px;
  }

  /* White Pill Button with Circular Right Arrow Icon */
  .fb04-hero-btn-pill {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 8px 8px 8px 28px;
    background: #FFFFFF;
    color: #111827;
    border-radius: 9999px;
    text-decoration: none;
    font-family: var(--font-body, sans-serif);
    font-weight: 600;
    font-size: 15px;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s ease, background-color 0.25s ease;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
    width: fit-content;
  }

  .fb04-hero-btn-pill:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.3);
    background: #F9FAFB;
  }

  .fb04-hero-btn-arrow {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: #111827;
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: transform 0.25s ease;
  }

  .fb04-hero-btn-pill:hover .fb04-hero-btn-arrow {
    transform: translateX(3px);
  }

  /* Bottom Horizontal Numbered Tab Navigation Bar */
  .fb04-hero-tabs-bar {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 10;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 20px;
    padding: 24px clamp(2rem, 5vw, 4rem) 32px;
    background: linear-gradient(0deg, rgba(0, 0, 0, 0.9) 0%, rgba(0, 0, 0, 0.4) 70%, rgba(0, 0, 0, 0) 100%);
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  .fb04-hero-tab-item {
    cursor: pointer;
    position: relative;
    text-align: left;
    transition: opacity 0.3s ease;
    user-select: none;
  }

  .fb04-hero-tab-line {
    height: 2px;
    width: 100%;
    background: rgba(255, 255, 255, 0.2);
    margin-bottom: 14px;
    transition: background-color 0.3s ease;
  }

  .fb04-hero-tab-item.active .fb04-hero-tab-line {
    background: #FFFFFF;
  }

  .fb04-hero-tab-num {
    font-family: 'Big Shoulders Display', var(--font-heading, sans-serif);
    font-size: 18px;
    font-weight: 800;
    color: rgba(255, 255, 255, 0.45);
    margin-bottom: 4px;
    transition: color 0.3s ease;
  }

  .fb04-hero-tab-item.active .fb04-hero-tab-num {
    color: #FFFFFF;
  }

  .fb04-hero-tab-title {
    font-family: var(--font-body, sans-serif);
    font-size: 13px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.45);
    line-height: 1.35;
    transition: color 0.3s ease;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .fb04-hero-tab-item.active .fb04-hero-tab-title {
    color: #FFFFFF;
  }

  .fb04-hero-tab-item:hover:not(.active) .fb04-hero-tab-line {
    background: rgba(255, 255, 255, 0.4);
  }

  .fb04-hero-tab-item:hover:not(.active) .fb04-hero-tab-title,
  .fb04-hero-tab-item:hover:not(.active) .fb04-hero-tab-num {
    color: rgba(255, 255, 255, 0.75);
  }

  /* Responsive Adjustments */
  @media (max-width: 809px) {
    .fb04-hero-card-container {
      min-height: 520px;
      border-radius: 20px;
    }
    .fb04-hero-card-pane {
      padding: 2.5rem 1.5rem 160px;
    }
    .fb04-hero-tabs-bar {
      padding: 16px 16px 20px;
      gap: 10px;
    }
    .fb04-hero-tab-title {
      font-size: 10px;
    }
    .fb04-hero-tab-num {
      font-size: 15px;
    }
  }
</style>

<section class="fb04-hero-section" id="{{ section_prefix }}">
  <div class="fb04-hero-card-container">

    {%- for block in section.blocks -%}
      {%- assign bg_image_url = '' -%}
      {%- if block.settings.image != blank -%}
        {%- assign bg_image_url = block.settings.image | image_url: width: 2000 -%}
      {%- else -%}
        {%- case forloop.index -%}
          {%- when 1 -%}
            {%- assign bg_image_url = 'https://images.unsplash.com/photo-1509631179647-0177331693ae?q=80&w=1600&auto=format&fit=crop' -%}
          {%- when 2 -%}
            {%- assign bg_image_url = 'https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?q=80&w=1600&auto=format&fit=crop' -%}
          {%- when 3 -%}
            {%- assign bg_image_url = 'https://images.unsplash.com/photo-1529139574466-a303027c1d8b?q=80&w=1600&auto=format&fit=crop' -%}
          {%- when 4 -%}
            {%- assign bg_image_url = 'https://images.unsplash.com/photo-1552374196-1ab2a1c593e8?q=80&w=1600&auto=format&fit=crop' -%}
          {%- default -%}
            {%- assign bg_image_url = 'https://images.unsplash.com/photo-1483985988355-763728e1935b?q=80&w=1600&auto=format&fit=crop' -%}
        {%- endcase -%}
      {%- endif -%}

      <div
        class="fb04-hero-card-pane{% if forloop.first %} active{% endif %}"
        data-fb04-pane="{{ forloop.index0 }}"
        style="background-image: url('{{ bg_image_url }}');"
        {{ block.shopify_attributes }}>
        
        <div class="fb04-hero-card-overlay"></div>

        <div class="fb04-hero-card-content">
          <h1 class="fb04-hero-title">{{ block.settings.heading }}</h1>
          <p class="fb04-hero-subtitle">{{ block.settings.subheading }}</p>

          {%- if block.settings.cta_text != blank -%}
            <a href="{{ block.settings.cta_url | default: '#' }}" class="fb04-hero-btn-pill">
              <span>{{ block.settings.cta_text }}</span>
              <span class="fb04-hero-btn-arrow">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </span>
            </a>
          {%- endif -%}
        </div>

      </div>
    {%- endfor -%}

    {%- comment -%} Bottom Horizontal Numbered Tab Navigation Bar {%- endcomment -%}
    <div class="fb04-hero-tabs-bar">
      {%- for block in section.blocks -%}
        <div
          class="fb04-hero-tab-item{% if forloop.first %} active{% endif %}"
          data-fb04-tab="{{ forloop.index0 }}">
          <div class="fb04-hero-tab-line"></div>
          <div class="fb04-hero-tab-num">0{{ forloop.index }}</div>
          <div class="fb04-hero-tab-title">{{ block.settings.tab_label }}</div>
        </div>
      {%- endfor -%}
    </div>

  </div>
</section>

<script>
  (function() {
    var root = document.getElementById('{{ section_prefix }}');
    if (!root) return;
    var tabs = root.querySelectorAll('[data-fb04-tab]');
    var panes = root.querySelectorAll('[data-fb04-pane]');

    tabs.forEach(function(tab) {
      tab.addEventListener('click', function() {
        var idx = this.getAttribute('data-fb04-tab');
        tabs.forEach(function(t) { t.classList.remove('active'); });
        panes.forEach(function(p) { p.classList.remove('active'); });
        this.classList.add('active');
        var target = root.querySelector('[data-fb04-pane="' + idx + '"]');
        if (target) target.classList.add('active');
      });
    });
  })();
</script>

