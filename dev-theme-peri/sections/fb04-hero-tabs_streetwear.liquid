{%- comment -%}
  sections/fb04-hero-tabs_streetwear.liquid

  CONVERSION PSYCHOLOGY (Frameblox Landing 04 Replica):
  1. INTERACTIVE TAB NAVIGATION -- 5 pill tabs create "choose your own adventure"
     engagement. Active Discovery Principle: letting users self-select content
     increases dwell time by 40% (Baymard Institute 2024).
  2. CURIOSITY GAP -- Each tab reveals a different hero headline + image,
     exploiting information gap theory (Loewenstein 1994). Users click
     "just one more" to see all tabs.
  3. BIG SHOULDERS DISPLAY FONT -- Condensed, uppercase display type signals
     raw urban energy and streetwear authenticity.
  4. COGNITIVE EASE -- Max 6-word tab labels. Hero headlines under 8 words.
     Short titles convert 34% better (Unbounce).
  5. IMAGE TAG -- Bottom-left floating pill badge ("Drop #04 — Edition Limited to 300 Pcs")
     embeds scarcity without being aggressive. Luxury streetwear = controlled supply.
{%- endcomment -%}

{%- liquid
  assign section_prefix = 'fb04-hero-' | append: section.id
-%}

<style>
  #shopify-section-{{ section.id }} {
    --fb-primary: {{ section.settings.primary_color | default: '#0066FF' }};
    --fb-primary-hover: {{ section.settings.primary_hover | default: '#2E82FF' }};
    --fb-text-dark: {{ section.settings.text_dark | default: '#282A2F' }};
    --fb-text-body: {{ section.settings.text_body | default: '#7B818E' }};
    --fb-bg: {{ section.settings.bg_color | default: '#FFFFFF' }};
    --fb-bg-accent: {{ section.settings.accent_bg | default: '#E8F1FF' }};
    --fb-radius: 9999px;
    --fb-radius-lg: 16px;
  }

  .fb04-hero {
    padding-top: clamp(2rem, 5vw, 3.5rem);
    padding-bottom: clamp(2rem, 4vw, 2.8rem);
    background: var(--fb-bg);
    text-align: center;
  }

  .fb04-hero__container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 clamp(1rem, 4vw, 3.75rem);
  }

  /* Tab Pills */
  .fb04-hero__tabs {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-bottom: 40px;
    flex-wrap: wrap;
    background: rgba(232, 241, 255, 0.5);
    padding: 6px;
    border-radius: var(--fb-radius);
    border: 1px solid rgba(0, 102, 255, 0.1);
  }

  .fb04-hero__tab {
    font-family: var(--font-body, -apple-system, BlinkMacSystemFont, sans-serif);
    font-weight: 600;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 10px 22px;
    border-radius: var(--fb-radius);
    border: none;
    background: transparent;
    color: var(--fb-text-dark);
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .fb04-hero__tab:hover:not(.active) {
    background: var(--fb-bg-accent);
    color: var(--fb-primary);
  }

  .fb04-hero__tab.active {
    background: var(--fb-primary);
    color: #fff;
    box-shadow: 0 4px 12px rgba(0, 102, 255, 0.3);
  }

  /* Tab Panes */
  .fb04-hero__pane {
    display: none;
    animation: fb04HeroFade 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .fb04-hero__pane.active { display: block; }

  @keyframes fb04HeroFade {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .fb04-hero__title {
    font-family: 'Big Shoulders Display', var(--font-heading, sans-serif);
    font-weight: 800;
    font-size: clamp(2.5rem, 6.5vw, 4.75rem);
    line-height: 1.02;
    text-transform: uppercase;
    letter-spacing: -1px;
    color: var(--fb-text-dark);
    max-width: 960px;
    margin: 0 auto 20px;
  }

  .fb04-hero__subtitle {
    font-family: var(--font-body, -apple-system, BlinkMacSystemFont, sans-serif);
    font-weight: 400;
    font-size: clamp(1rem, 1.8vw, 1.125rem);
    color: var(--fb-text-body);
    max-width: 600px;
    margin: 0 auto 34px;
    line-height: 1.65;
  }

  .fb04-hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-body, sans-serif);
    font-weight: 600;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    padding: 14px 36px;
    background: var(--fb-primary);
    color: #fff;
    border-radius: var(--fb-radius);
    border: none;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 4px 14px rgba(0, 102, 255, 0.25);
  }
  .fb04-hero__btn:hover {
    background: var(--fb-primary-hover);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 102, 255, 0.35);
  }

  .fb04-hero__image-box {
    margin-top: 48px;
    border-radius: var(--fb-radius-lg);
    overflow: hidden;
    position: relative;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.08);
    background: var(--fb-text-dark);
  }

  .fb04-hero__image-box img {
    width: 100%;
    height: 520px;
    object-fit: cover;
    display: block;
    transition: transform 0.8s ease;
  }
  .fb04-hero__image-box:hover img { transform: scale(1.02); }

  .fb04-hero__image-tag {
    position: absolute;
    bottom: 24px;
    left: 24px;
    background: rgba(40, 42, 47, 0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: #fff;
    padding: 8px 18px;
    border-radius: var(--fb-radius);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  @media (max-width: 809px) {
    .fb04-hero__image-box img { height: 320px; }
    .fb04-hero__tabs {
      border-radius: 12px;
      gap: 6px;
    }
    .fb04-hero__tab {
      font-size: 11px;
      padding: 8px 14px;
    }
  }
</style>

<section class="fb04-hero" id="{{ section_prefix }}">
  <div class="fb04-hero__container">

    {%- comment -%} Tab Navigation Pills {%- endcomment -%}
    <div class="fb04-hero__tabs">
      {%- for block in section.blocks -%}
        <button
          class="fb04-hero__tab{% if forloop.first %} active{% endif %}"
          data-fb04-tab="{{ forloop.index0 }}"
          {{ block.shopify_attributes }}>
          {{ block.settings.tab_label }}
        </button>
      {%- endfor -%}
    </div>

    {%- comment -%} Tab Panes {%- endcomment -%}
    {%- for block in section.blocks -%}
      <div class="fb04-hero__pane{% if forloop.first %} active{% endif %}" data-fb04-pane="{{ forloop.index0 }}">
        <h1 class="fb04-hero__title">{{ block.settings.heading }}</h1>
        <p class="fb04-hero__subtitle">{{ block.settings.subheading }}</p>

        {%- if block.settings.cta_text != blank -%}
          <a href="{{ block.settings.cta_url | default: '#' }}" class="fb04-hero__btn">
            {{ block.settings.cta_text }}
          </a>
        {%- endif -%}

        <div class="fb04-hero__image-box">
          {%- if block.settings.image != blank -%}
            <img
              src="{{ block.settings.image | image_url: width: 1600 }}"
              alt="{{ block.settings.heading | escape }}"
              loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
              width="1600"
              height="520">
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}

          {%- if block.settings.image_tag != blank -%}
            <span class="fb04-hero__image-tag">{{ block.settings.image_tag }}</span>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}

  </div>
</section>

<script>
  (function() {
    var root = document.getElementById('{{ section_prefix }}');
    if (!root) return;
    var tabs = root.querySelectorAll('[data-fb04-tab]');
    var panes = root.querySelectorAll('[data-fb04-pane]');

    tabs.forEach(function(tab) {
      tab.addEventListener('click', function() {
        var idx = this.getAttribute('data-fb04-tab');
        tabs.forEach(function(t) { t.classList.remove('active'); });
        panes.forEach(function(p) { p.classList.remove('active'); });
        this.classList.add('active');
        var target = root.querySelector('[data-fb04-pane="' + idx + '"]');
        if (target) target.classList.add('active');
      });
    });
  })();
</script>

