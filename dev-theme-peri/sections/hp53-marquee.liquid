<style>
@media screen and (max-width: 768px) {
  .hp53-marquee {
    padding-left: 16px !important;
    padding-right: 16px !important;
    box-sizing: border-box !important;
  }
  img {
    max-width: 100% !important;
    height: auto !important;
  }
}
</style>
{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp53-marq-bg: {{ section.settings.bg_color | default: '#5C3D2E' }};
    --hp53-marq-text: {{ section.settings.text_color | default: '#FAF5EF' }};

    background: var(--hp53-marq-bg);
    overflow: hidden;
    padding: {{ section.settings.padding_vertical | default: 10 }}px 0;
  }

  .hp53-marquee__track {
    display: flex;
    gap: 50px;
    animation: hp53MarqueeScroll {{ section.settings.speed | default: 25 }}s linear infinite;
    width: max-content;
  }

  .hp53-marquee__item {
    display: flex;
    align-items: center;
    gap: 50px;
    white-space: nowrap;
    font-family: 'Cormorant Garamond', serif;
    font-size: {{ section.settings.font_size | default: 14 }}px;
    font-weight: 600;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--hp53-marq-text);
  }

  .hp53-marquee__dot {
    width: 6px;
    height: 6px;
    background: {{ section.settings.dot_color | default: '#C2703E' }};
    border-radius: 50%;
    flex-shrink: 0;
  }

  @keyframes hp53MarqueeScroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
{%- endstyle -%}

<div class="hp53-marquee__track">
  {%- for i in (1..12) -%}
    <div class="hp53-marquee__item">
      <span>{{ section.settings.marquee_text | default: '✦ SAHARAN DUNE ✦ TERRACOTTA GLOW ✦ DESERT MINERALS ✦ ARGAN GOLD' }}</span>
      <span class="hp53-marquee__dot"></span>
    </div>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "HP53 - Dune Marquee",
  "class": "section-hp53-marquee",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#5C3D2E" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#FAF5EF" },
    { "type": "color", "id": "dot_color", "label": "Dot Color", "default": "#C2703E" },
    { "type": "text", "id": "marquee_text", "label": "Marquee Text", "default": "✦ SAHARAN DUNE ✦ TERRACOTTA GLOW ✦ DESERT MINERALS ✦ ARGAN GOLD" },
    { "type": "range", "id": "speed", "min": 10, "max": 50, "step": 5, "unit": "s", "label": "Speed", "default": 25 },
    { "type": "range", "id": "font_size", "min": 10, "max": 22, "step": 1, "unit": "px", "label": "Font Size", "default": 14 },
    { "type": "range", "id": "padding_vertical", "min": 4, "max": 24, "step": 2, "unit": "px", "label": "Padding", "default": 10 }
  ],
  "presets": [{ "name": "HP53 - Dune Marquee" }]
}
{% endschema %}
