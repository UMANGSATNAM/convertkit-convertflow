      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Block Text Size",
      "default": 15
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#FEF3C7"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#451A03"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#78350F"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon Color",
      "default": "#D97706"
    },
    {
      "type": "color",
      "id": "icon_bg_color",
