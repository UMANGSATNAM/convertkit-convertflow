          "id": "title",
          "label": "Title",
          "default": "Ethically Sourced"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Every material is traced back to its origins, ensuring fair practices.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP19 - USP (Advanced)",
      "category": "Features",
      "blocks": [
        { "type": "usp_item", "settings": { "icon_text": "❦", "title": "Ethically Sourced" } },
        { "type": "usp_item", "settings": { "icon_text": "✾", "title": "Handcrafted Quality" } },
        { "type": "usp_item", "settings": { "icon_text": "✦", "title": "Built to Last" } }
