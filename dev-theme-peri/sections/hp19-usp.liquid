      "content": "Typography"
    },
    {
      "type": "range",
      "id": "block_title_size",
      "min": 16,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Block Title Size",
      "default": 24
    },
    {
      "type": "range",
      "id": "block_text_size",
