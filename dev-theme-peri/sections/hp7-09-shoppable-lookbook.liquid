{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#050505'
  assign padding_top = section.settings.padding_top | default: 0
  assign padding_bottom = section.settings.padding_bottom | default: 0
-%}

<style>
  #shopify-section-{{ section_id }} {
    --bg-color: {{ bg_color }};
    --padding-top: {{ padding_top }}px;
    --padding-bottom: {{ padding_bottom }}px;
    
    background-color: var(--bg-color);
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
  }

  .hp7-lookbook-{{ section_id }} {
    max-width: 100%;
    margin: 0 auto;
    position: relative;
    overflow: hidden;
    /* Edge to edge */
  }

  .hp7-lookbook__media {
    position: relative;
    width: 100%;
    height: 100vh;
    min-height: 600px;
  }

  .hp7-lookbook__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* Hotspot Styling */
  .hp7-lookbook__hotspot {
    position: absolute;
    width: 24px;
    height: 24px;
    background-color: #F4F4F0;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    cursor: pointer;
    z-index: 10;
    box-shadow: 0 0 0 0 rgba(244, 244, 240, 0.7);
    animation: hp7-pulse 2s infinite;
  }
  
  .hp7-lookbook__hotspot::after {
    content: '+';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    color: #050505;
    font-family: 'Inter', sans-serif;
    font-weight: 600;
    font-size: 14px;
  }

  /* Product Tooltip */
  .hp7-lookbook__tooltip {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translate(-50%, 15px);
    background-color: #F4F4F0;
    color: #050505;
    width: 280px;
    padding: 1.5rem;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    z-index: 11;
    pointer-events: none; /* Let hover pass through until visible */
  }

  .hp7-lookbook__hotspot:hover .hp7-lookbook__tooltip,
  .hp7-lookbook__tooltip:hover {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translate(-50%, 10px);
  }

  .hp7-lookbook__tooltip-img {
    width: 100%;
    height: 180px;
    object-fit: cover;
    margin-bottom: 1rem;
    background: #e0e0e0;
  }

  .hp7-lookbook__tooltip-title {
    font-family: 'Playfair Display', serif;
    font-size: 18px;
    font-weight: 600;
    margin: 0 0 0.5rem 0;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .hp7-lookbook__tooltip-price {
    font-family: 'Inter', monospace;
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .hp7-lookbook__tooltip-btn {
    display: block;
    width: 100%;
    padding: 12px;
    text-align: center;
    background-color: #050505;
    color: #F4F4F0;
    text-decoration: none;
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 600;
  }

  .hp7-lookbook__tooltip-btn:hover {
    background-color: #333;
  }

  @keyframes hp7-pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(244, 244, 240, 0.7);
    }
    70% {
      box-shadow: 0 0 0 15px rgba(244, 244, 240, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(244, 244, 240, 0);
    }
  }

  @media screen and (max-width: 768px) {
    .hp7-lookbook__media {
      height: 80vh;
    }
    .hp7-lookbook__tooltip {
      /* Adjust tooltip on mobile to not overflow screen */
      width: 220px;
    }
  }
</style>

<section class="hp7-lookbook-{{ section_id }}">
  <div class="hp7-lookbook__media">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2000 | image_tag: 
         loading: 'lazy',
         class: 'hp7-lookbook__image',
         alt: 'Lookbook image'
      }}
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'hp7-lookbook__image placeholder-svg' }}
    {%- endif -%}

    {%- for block in section.blocks -%}
      {%- assign product = block.settings.product -%}
      <div class="hp7-lookbook__hotspot" style="top: {{ block.settings.top_position }}%; left: {{ block.settings.left_position }}%;" {{ block.shopify_attributes }}>
        
        <div class="hp7-lookbook__tooltip">
          {%- if product != blank -%}
            {%- if product.featured_image != blank -%}
              {{ product.featured_image | image_url: width: 400 | image_tag: class: 'hp7-lookbook__tooltip-img' }}
            {%- endif -%}
            <h3 class="hp7-lookbook__tooltip-title">{{ product.title }}</h3>
            <div class="hp7-lookbook__tooltip-price">{{ product.price | money }}</div>
            <a href="{{ product.url }}" class="hp7-lookbook__tooltip-btn">View Details</a>
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'hp7-lookbook__tooltip-img placeholder-svg' }}
            <h3 class="hp7-lookbook__tooltip-title">ARCHIVE BLAZER</h3>
            <div class="hp7-lookbook__tooltip-price">$1,850.00</div>
            <a href="#" class="hp7-lookbook__tooltip-btn">View Details</a>
          {%- endif -%}
        </div>

      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "HP7 Shoppable Lookbook",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Aesthetic: Editorial Brutalism"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Lookbook Image"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#050505"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "Product Hotspot",
      "limit": 5,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "range",
          "id": "top_position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Vertical Position",
          "default": 50
        },
        {
          "type": "range",
          "id": "left_position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Horizontal Position",
          "default": 50
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP7 Shoppable Lookbook",
      "blocks": [
        { "type": "hotspot", "settings": { "top_position": 40, "left_position": 30 } },
        { "type": "hotspot", "settings": { "top_position": 60, "left_position": 70 } }
      ]
    }
  ]
}
{% endschema %}
