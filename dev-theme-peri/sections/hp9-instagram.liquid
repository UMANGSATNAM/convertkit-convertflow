{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#050505'
  assign text_color = section.settings.text_color | default: '#ffffff'
  assign accent_color = section.settings.accent_color | default: '#00ff88'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 100px 0; /* Full width edge-to-edge look */
    color: {{ text_color }};
    position: relative;
    overflow: hidden;
  }
  
  .hp9-insta-header-{{ section_id }} {
    text-align: center;
    margin-bottom: 50px;
    padding: 0 20px;
    position: relative;
    z-index: 2;
  }
  
  .hp9-insta-subheading-{{ section_id }} {
    font-family: 'Space Mono', monospace;
    font-size: 0.9rem;
    font-weight: 700;
    color: {{ accent_color }};
    margin: 0 0 10px 0;
    letter-spacing: 2px;
    text-transform: uppercase;
  }
  
  .hp9-insta-heading-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 900;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: -1px;
    display: inline-flex;
    align-items: center;
    gap: 15px;
  }
  
  .hp9-insta-heading-{{ section_id }} svg {
    width: 35px;
    height: 35px;
    fill: currentColor;
  }
  
  .hp9-insta-scroll-{{ section_id }} {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none;  /* IE and Edge */
    gap: 20px;
    padding: 20px;
    margin-top: 20px;
  }
  
  .hp9-insta-scroll-{{ section_id }}::-webkit-scrollbar {
    display: none;
  }
  
  .hp9-insta-card-{{ section_id }} {
    flex: 0 0 auto;
    width: 300px;
    height: 300px;
    scroll-snap-align: center;
    position: relative;
    border: 1px solid rgba(255,255,255,0.1);
    background: #111;
    overflow: hidden;
    transition: all 0.4s ease;
  }
  
  .hp9-insta-card-{{ section_id }}:hover {
    border-color: {{ accent_color }};
    transform: scale(1.05);
    z-index: 3;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.8);
  }
  
  .hp9-insta-img-{{ section_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: sepia(0.3) hue-rotate(180deg) brightness(0.8) contrast(1.2);
    transition: all 0.4s ease;
  }
  
  .hp9-insta-card-{{ section_id }}:hover .hp9-insta-img-{{ section_id }} {
    filter: none;
  }
  
  .hp9-insta-overlay-{{ section_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.7);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
    backdrop-filter: blur(3px);
  }
  
  .hp9-insta-card-{{ section_id }}:hover .hp9-insta-overlay-{{ section_id }} {
    opacity: 1;
  }
  
  .hp9-insta-icon-{{ section_id }} {
    width: 40px;
    height: 40px;
    color: {{ accent_color }};
    margin-bottom: 15px;
  }
  
  .hp9-insta-text-{{ section_id }} {
    font-family: 'Space Mono', monospace;
    font-size: 0.8rem;
    font-weight: 700;
    color: #fff;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 0 20px;
    text-align: center;
  }
  
  /* Cyber corners for images */
  .hp9-insta-card-{{ section_id }}::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 0;
    height: 0;
    border-style: solid;
    border-width: 0 30px 30px 0;
    border-color: transparent {{ bg_color }} transparent transparent;
    z-index: 2;
  }
  
  /* Glitchy marquee text behind slider */
  .hp9-insta-bg-text-{{ section_id }} {
    position: absolute;
    top: 50%;
    left: 0;
    transform: translateY(-50%);
    width: 100%;
    white-space: nowrap;
    font-family: 'Inter', sans-serif;
    font-size: 15vw;
    font-weight: 900;
    color: rgba(255,255,255,0.02);
    z-index: 0;
    pointer-events: none;
    line-height: 1;
  }

  @media (max-width: 768px) {
    .hp9-insta-card-{{ section_id }} {
      width: 250px;
      height: 250px;
    }
    .hp9-insta-heading-{{ section_id }} svg {
      width: 25px;
      height: 25px;
    }
  }
</style>

<div class="hp9-insta-bg-text-{{ section_id }}">NETWORK.SYNC</div>

<div class="hp9-insta-header-{{ section_id }}">
  <p class="hp9-insta-subheading-{{ section_id }}">{{ section.settings.subheading | default: '/// NEURAL_LINK' }}</p>
  <h2 class="hp9-insta-heading-{{ section_id }}">
    <svg viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
    {{ section.settings.heading | default: '@CYBER_TECH' }}
  </h2>
</div>

<div class="hp9-insta-scroll-{{ section_id }}">
  {% for block in section.blocks %}
    <a href="{{ block.settings.link | default: '#' }}" class="hp9-insta-card-{{ section_id }}" {{ block.shopify_attributes }} target="_blank" rel="noopener noreferrer">
      {% if block.settings.image != blank %}
        <img height="{{ block.settings.image.height }}" width="{{ block.settings.image.width }}" src="{{ block.settings.image | image_url: width: 600 }}" alt="Instagram Post" class="hp9-insta-img-{{ section_id }}" loading="lazy">
      {% else %}
        <div class="hp9-insta-img-{{ section_id }}" style="background: #222; display:flex; align-items:center; justify-content:center; color:#444;">IMG_{{ forloop.index }}</div>
      {% endif %}
      
      <div class="hp9-insta-overlay-{{ section_id }}">
        <svg class="hp9-insta-icon-{{ section_id }}" viewBox="0 0 24 24"><path fill="currentColor" d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
        <div class="hp9-insta-text-{{ section_id }}">VIEW_POST</div>
      </div>
    </a>
  {% endfor %}
</div>

{% schema %}
{
  "name": "HP9 Instagram",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#050505"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#00ff88"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "/// NEURAL_LINK"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "@CYBER_TECH"
    }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Instagram Post",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP9 Instagram",
      "blocks": [
        { "type": "post" },
        { "type": "post" },
        { "type": "post" },
        { "type": "post" },
        { "type": "post" },
        { "type": "post" }
      ]
    }
  ]
}
{% endschema %}
