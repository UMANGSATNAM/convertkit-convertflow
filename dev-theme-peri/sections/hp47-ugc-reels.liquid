{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp47-ugc-bg: {{ section.settings.bg_color | default: '#F5F0EB' }};
    
    background-color: var(--hp47-ugc-bg);
    padding-top: {{ section.settings.padding_top | default: 70 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 70 }}px;
  }

  .hp47-ugc__wrap {
    max-width: {{ section.settings.container_width | default: 1240 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp47-ugc__header {
    text-align: center;
    margin-bottom: 40px;
  }

  .hp47-ugc__heading {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(30px, 4vw, 40px);
    font-weight: 600;
    color: #382E2B;
    margin: 0;
  }

  .hp47-ugc__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: 4 }}, 1fr);
    gap: 18px;
  }

  .hp47-ugc__card {
    aspect-ratio: 9/16;
    border-radius: 24px;
    overflow: hidden;
    position: relative;
    border: 1px solid #EAE3DA;
    background: #EAE3DA;
    box-shadow: 0 10px 30px rgba(56, 46, 43, 0.06);
  }

  .hp47-ugc__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .hp47-ugc__card:hover .hp47-ugc__img { transform: scale(1.05); }

  .hp47-ugc__overlay {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    padding: 18px;
    background: linear-gradient(to top, rgba(56, 46, 43, 0.85), transparent);
    color: #FAF7F2;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
  }

  .hp47-ugc__handle {
    font-size: 13px;
    font-weight: 700;
    margin: 0 0 2px;
  }

  .hp47-ugc__tag {
    font-size: 11px;
    color: #D6CCC2;
    margin: 0;
  }

  @media screen and (max-width: 992px) {
    .hp47-ugc__grid { grid-template-columns: repeat(2, 1fr); }
  }
{%- endstyle -%}

<div class="hp47-ugc__wrap">
  <div class="hp47-ugc__header">
    <h2 class="hp47-ugc__heading">{{ section.settings.heading | default: 'Linen & Oat In Daily Life' }}</h2>
  </div>

  <div class="hp47-ugc__grid">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <div class="hp47-ugc__card" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img height="{{ block.settings.image.height }}" width="{{ block.settings.image.width }}" src="{{ block.settings.image | image_url: width: 600 }}" class="hp47-ugc__img" alt="{{ block.settings.handle }}" loading="lazy">
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'hp47-ugc__img' }}
          {%- endif -%}
          <div class="hp47-ugc__overlay">
            <div>
              <p class="hp47-ugc__handle">{{ block.settings.handle | default: '@nordic_linen' }}</p>
              <p class="hp47-ugc__tag">{{ block.settings.tag | default: '#OatLipidCare' }}</p>
            </div>
            <span>▶</span>
          </div>
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="hp47-ugc__card">
        {{ 'lifestyle-2' | placeholder_svg_tag: 'hp47-ugc__img' }}
        <div class="hp47-ugc__overlay">
          <div><p class="hp47-ugc__handle">@maja_nordic</p><p class="hp47-ugc__tag">#OatBalm</p></div>
          <span>▶</span>
        </div>
      </div>
      <div class="hp47-ugc__card">
        {{ 'lifestyle-2' | placeholder_svg_tag: 'hp47-ugc__img' }}
        <div class="hp47-ugc__overlay">
          <div><p class="hp47-ugc__handle">@scandi_glow</p><p class="hp47-ugc__tag">#BirchSap</p></div>
          <span>▶</span>
        </div>
      </div>
      <div class="hp47-ugc__card">
        {{ 'lifestyle-2' | placeholder_svg_tag: 'hp47-ugc__img' }}
        <div class="hp47-ugc__overlay">
          <div><p class="hp47-ugc__handle">@linen_beauty</p><p class="hp47-ugc__tag">#MinimalCare</p></div>
          <span>▶</span>
        </div>
      </div>
      <div class="hp47-ugc__card">
        {{ 'lifestyle-2' | placeholder_svg_tag: 'hp47-ugc__img' }}
        <div class="hp47-ugc__overlay">
          <div><p class="hp47-ugc__handle">@astrid_wellness</p><p class="hp47-ugc__tag">#BarrierCalm</p></div>
          <span>▶</span>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP47 - Taupe UGC",
  "class": "section-hp47-ugc",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#F5F0EB" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Linen & Oat In Daily Life" },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "label": "Desktop Columns", "default": 4 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 70 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 70 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1240 }
  ],
  "blocks": [
    {
      "type": "reel",
      "name": "Reel Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "handle", "label": "Handle", "default": "@nordic_linen" },
        { "type": "text", "id": "tag", "label": "Tag", "default": "#OatLipidCare" }
      ]
    }
  ],
  "presets": [
    { "name": "HP47 - Taupe UGC" }
  ]
}
{% endschema %}
