{%- liquid
  assign sec_id = section.id
  assign bg_color = section.settings.bg_color
  assign text_color = section.settings.text_color
  assign border_color = section.settings.border_color
  assign border_width = section.settings.border_width
  assign shadow_color = section.settings.shadow_color
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
  assign title = section.settings.title
-%}

<style>
  .hp18-collist-{{ sec_id }} {
    background-color: {{ bg_color }};
    padding-top: {{ padding_top }}px;
    padding-bottom: {{ padding_bottom }}px;
    border-bottom: {{ border_width }}px solid {{ border_color }};
  }

  .hp18-collist-{{ sec_id }}__container {
    max-width: var(--page-width, 1440px);
    margin: 0 auto;
    padding: 0 40px;
  }

  .hp18-collist-{{ sec_id }}__header {
    text-align: center;
    margin-bottom: 60px;
  }

  .hp18-collist-{{ sec_id }}__title {
    font-family: 'Arial Black', Impact, sans-serif;
    font-size: clamp(40px, 6vw, 72px);
    color: {{ text_color }};
    text-transform: uppercase;
    margin: 0;
    line-height: 1;
    text-shadow: 4px 4px 0px {{ shadow_color }};
    letter-spacing: -2px;
  }

  .hp18-collist-{{ sec_id }}__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
  }

  .hp18-collist-{{ sec_id }}__item {
    position: relative;
    border: {{ border_width }}px solid {{ border_color }};
    box-shadow: 12px 12px 0px {{ border_color }};
    background-color: #ffffff;
    overflow: hidden;
    aspect-ratio: 4/5;
    display: flex;
    align-items: flex-end;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .hp18-collist-{{ sec_id }}__item:hover {
    transform: translate(-6px, -6px);
  }

  .hp18-collist-{{ sec_id }}__image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
    transition: transform 0.5s ease;
    filter: grayscale(0.3);
  }

  .hp18-collist-{{ sec_id }}__item:hover .hp18-collist-{{ sec_id }}__image {
    transform: scale(1.05);
    filter: grayscale(0);
  }

  .hp18-collist-{{ sec_id }}__content {
    position: relative;
    z-index: 2;
    background-color: var(--card-bg, #CCFF00);
    border-top: {{ border_width }}px solid {{ border_color }};
    border-right: {{ border_width }}px solid {{ border_color }};
    padding: 25px 35px;
    transition: padding 0.2s ease;
  }

  .hp18-collist-{{ sec_id }}__item:hover .hp18-collist-{{ sec_id }}__content {
    padding-right: 50px;
  }

  .hp18-collist-{{ sec_id }}__name {
    font-family: 'Arial Black', sans-serif;
    font-size: 28px;
    color: var(--card-text, {{ text_color }});
    margin: 0;
    text-transform: uppercase;
    line-height: 1.1;
  }

  @media screen and (max-width: 992px) {
    .hp18-collist-{{ sec_id }}__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 768px) {
    .hp18-collist-{{ sec_id }}__container {
      padding: 0 20px;
    }
    .hp18-collist-{{ sec_id }}__grid {
      grid-template-columns: 1fr;
      gap: 30px;
    }
    .hp18-collist-{{ sec_id }}__item {
      aspect-ratio: 1;
      box-shadow: 8px 8px 0px {{ border_color }};
    }
    .hp18-collist-{{ sec_id }}__item:hover {
      transform: translate(-3px, -3px);
    }
  }
</style>

<section class="hp18-collist-{{ sec_id }}">
  <div class="hp18-collist-{{ sec_id }}__container">
    
    {% if title != blank %}
    <div class="hp18-collist-{{ sec_id }}__header">
      <h2 class="hp18-collist-{{ sec_id }}__title">{{ title }}</h2>
    </div>
    {% endif %}

    <div class="hp18-collist-{{ sec_id }}__grid">
      {% for block in section.blocks %}
        <a href="{{ block.settings.collection.url | default: '#' }}" class="hp18-collist-{{ sec_id }}__item" style="--card-bg: {{ block.settings.card_bg_color }}; --card-text: {{ block.settings.card_text_color }};" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title }}" class="hp18-collist-{{ sec_id }}__image" loading="lazy">
          {% elsif block.settings.collection.image %}
            <img src="{{ block.settings.collection.image | image_url: width: 800 }}" alt="{{ block.settings.title }}" class="hp18-collist-{{ sec_id }}__image" loading="lazy">
          {% else %}
            {% capture tmp_class %}hp18-collist-{{ sec_id }}__image{% endcapture %}{{ 'collection-' | append: forloop.index  | placeholder_svg_tag: tmp_class }}
          {% endif %}
          
          <div class="hp18-collist-{{ sec_id }}__content">
            <h3 class="hp18-collist-{{ sec_id }}__name">
              {{ block.settings.title | default: block.settings.collection.title | default: 'Collection' }}
            </h3>
          </div>
        </a>
      {% else %}
        <!-- Demo Placeholders -->
        <a href="#" class="hp18-collist-{{ sec_id }}__item" style="--card-bg: #CCFF00; --card-text: #111111;">
          {% capture tmp_class %}hp18-collist-{{ sec_id }}__image{% endcapture %}{{ 'collection-1'  | placeholder_svg_tag: tmp_class }}
          <div class="hp18-collist-{{ sec_id }}__content">
            <h3 class="hp18-collist-{{ sec_id }}__name">Menswear</h3>
          </div>
        </a>
        <a href="#" class="hp18-collist-{{ sec_id }}__item" style="--card-bg: #FF3366; --card-text: #ffffff;">
          {% capture tmp_class %}hp18-collist-{{ sec_id }}__image{% endcapture %}{{ 'collection-2'  | placeholder_svg_tag: tmp_class }}
          <div class="hp18-collist-{{ sec_id }}__content">
            <h3 class="hp18-collist-{{ sec_id }}__name">Womenswear</h3>
          </div>
        </a>
        <a href="#" class="hp18-collist-{{ sec_id }}__item" style="--card-bg: #ffffff; --card-text: #111111;">
          {% capture tmp_class %}hp18-collist-{{ sec_id }}__image{% endcapture %}{{ 'collection-3'  | placeholder_svg_tag: tmp_class }}
          <div class="hp18-collist-{{ sec_id }}__content">
            <h3 class="hp18-collist-{{ sec_id }}__name">Hardware</h3>
          </div>
        </a>
      {% endfor %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "HP18 Adv Collection List",
  "max_blocks": 6,
  "settings": [
    {
      "type": "header",
      "content": "Color Settings"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f4f4f0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "shadow_color",
      "label": "Title Shadow Color",
      "default": "#CCFF00"
    },
    {
      "type": "header",
      "content": "Layout & Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "CURATED DROPS"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "Border Width",
      "default": 3
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 10,
      "unit": "px",
      "label": "Padding Top",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 10,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 100
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection Block",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Image (Overrides collection image)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom Title (Overrides collection title)"
        },
        {
          "type": "color",
          "id": "card_bg_color",
          "label": "Card Label Background",
          "default": "#CCFF00"
        },
        {
          "type": "color",
          "id": "card_text_color",
          "label": "Card Label Text",
          "default": "#111111"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP18 Advanced Collection List",
      "blocks": [
        { "type": "collection", "settings": { "card_bg_color": "#CCFF00", "title": "Menswear" } },
        { "type": "collection", "settings": { "card_bg_color": "#FF3366", "card_text_color": "#ffffff", "title": "Womenswear" } },
        { "type": "collection", "settings": { "card_bg_color": "#ffffff", "title": "Hardware" } }
      ]
    }
  ]
}
{% endschema %}
