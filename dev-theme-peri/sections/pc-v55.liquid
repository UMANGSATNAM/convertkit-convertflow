{%- comment -%}
  PC V55 — RETRO 90S GRUNGE & STREETWEAR PRODUCT GRID
  Design: Pitch Dark (#121212), Neon Lime (#00FF66) & Punk Red (#FF0033) accents, Syne & Space Grotesk typography
  Card Shape: 0px boxy corners, 2px heavy borders, 90s underground streetwear vibe
{%- endcomment -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@700&family=Syne:wght@700;800&display=swap');

  .pcv55 {
    --bg: {{ section.settings.bg_color | default: '#121212' }};
    --card-bg: {{ section.settings.card_bg | default: '#1A1A1A' }};
    --text: {{ section.settings.text_color | default: '#FFFFFF' }};
    --muted: {{ section.settings.muted_color | default: '#888888' }};
    --accent: {{ section.settings.accent_color | default: '#00FF66' }};
    --accent-hover: {{ section.settings.accent_hover | default: '#00CC52' }};
    --border: {{ section.settings.border_color | default: '#00FF66' }};
    --badge-sale-bg: #FF0033;
    --badge-sale-text: #FFFFFF;
    --f-heading: 'Syne', sans-serif;
    --f-body: 'Space Grotesk', sans-serif;
    --ease: all 0.2s ease;
    background-color: var(--bg);
    color: var(--text);
    font-family: var(--f-body);
    padding: {{ section.settings.padding_top | default: 60 }}px 0 {{ section.settings.padding_bottom | default: 60 }}px 0;
    line-height: 1.4;
    -webkit-font-smoothing: antialiased;
  }

  .pcv55 *, .pcv55 *::before, .pcv55 *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .pcv55 a { color: inherit; text-decoration: none; }
  .pcv55 button { font-family: inherit; cursor: pointer; border: none; background: none; }
  .pcv55 img { max-width: 100%; display: block; }

  .pcv55__wrap { max-width: 1320px; margin: 0 auto; padding: 0 20px; }

  /* HEADER */
  .pcv55__head { display: flex; flex-direction: column; gap: 8px; margin-bottom: 36px; border-bottom: 3px solid var(--accent); padding-bottom: 16px; text-align: {{ section.settings.header_align | default: 'left' }}; }
  @media (min-width: 768px) {
    .pcv55__head { display: flex; flex-direction: row; justify-content: space-between; align-items: flex-end; }
  }
  .pcv55__title { font-family: var(--f-heading); font-size: 32px; font-weight: 800; color: var(--accent); text-transform: uppercase; letter-spacing: -0.02em; }
  @media (min-width: 768px) { .pcv55__title { font-size: 44px; } }
  .pcv55__sub { font-size: 15px; color: var(--muted); }
  .pcv55__viewall { display: inline-flex; align-items: center; gap: 8px; font-weight: 800; font-size: 12px; font-family: var(--f-heading); text-transform: uppercase; letter-spacing: 0.1em; color: #121212; background: var(--accent); padding: 8px 20px; border: 2px solid #FFFFFF; box-shadow: 4px 4px 0px #FF0033; transition: var(--ease); }
  .pcv55__viewall:hover { background: #FF0033; color: #FFFFFF; box-shadow: 6px 6px 0px var(--accent); }

  /* GRID */
  .pcv55__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr);
    gap: 18px;
  }
  @media (min-width: 640px) {
    .pcv55__grid { grid-template-columns: repeat({{ section.settings.cols_tablet | default: 3 }}, 1fr); gap: 24px; }
  }
  @media (min-width: 1024px) {
    .pcv55__grid { grid-template-columns: repeat({{ section.settings.cols_desktop | default: 4 }}, 1fr); gap: 28px; }
  }

  /* CARD */
  .pcv55__card {
    background: var(--card-bg);
    border: 2px solid var(--border);
    border-radius: 0px;
    display: flex;
    flex-direction: column;
    position: relative;
    box-shadow: 4px 4px 0px #000000;
    transition: var(--ease);
  }
  .pcv55__card:hover {
    transform: translate(-3px, -4px);
    border-color: #FF0033;
    box-shadow: 6px 6px 0px #00FF66;
  }

  /* IMAGE CONTAINER */
  .pcv55__img-box {
    position: relative;
    width: 100%;
    aspect-ratio: {{ section.settings.img_ratio | default: '1/1' }};
    background: #080808;
    overflow: hidden;
    border-bottom: 2px solid var(--border);
  }
  .pcv55__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .pcv55__img--sec {
    position: absolute;
    top: 0; left: 0;
    opacity: 0;
  }
  .pcv55__card:hover .pcv55__img--pri {
    {% if section.settings.enable_sec_img %}
      opacity: 0;
    {% else %}
      transform: scale(1.06);
    {% endif %}
  }
  .pcv55__card:hover .pcv55__img--sec { opacity: 1; transform: scale(1.06); }

  /* BADGES */
  .pcv55__badges { position: absolute; top: 10px; left: 10px; display: flex; flex-direction: column; gap: 6px; z-index: 2; pointer-events: none; }
  .pcv55__badge { font-size: 10px; font-weight: 800; text-transform: uppercase; padding: 4px 10px; border: 1.5px solid #121212; letter-spacing: 0.05em; font-family: var(--f-heading); }
  .pcv55__badge--sale { background: var(--badge-sale-bg); color: var(--badge-sale-text); }
  .pcv55__badge--tag { background: #00FF66; color: #121212; }
  .pcv55__badge--sold { background: #333333; color: #888888; border-color: #333333; }

  /* WISHLIST BUTTON */
  .pcv55__wish {
    position: absolute;
    top: 10px; right: 10px;
    width: 36px; height: 36px;
    background: #121212;
    border: 2px solid var(--border);
    display: flex; align-items: center; justify-content: center;
    color: var(--accent);
    z-index: 3;
    transition: var(--ease);
  }
  .pcv55__wish:hover { background: var(--accent); color: #121212; border-color: var(--accent); box-shadow: 0 0 10px #00FF66; }
  .pcv55__wish.active { color: #121212; background: var(--accent); border-color: var(--accent); box-shadow: 0 0 10px #00FF66; }

  /* QUICK ADD HOVER */
  .pcv55__quick-box { padding: 12px; background: var(--card-bg); border-top: 2px solid var(--border); }
  .pcv55__quick-btn {
    width: 100%;
    padding: 10px 14px;
    background: var(--accent);
    color: #121212;
    font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em;
    font-family: var(--f-heading);
    border: 2px solid #121212;
    box-shadow: 2px 3px 0px #121212;
    display: flex; align-items: center; justify-content: center; gap: 8px;
    transition: var(--ease);
  }
  .pcv55__quick-btn:hover { background: #FF0033; color: #FFFFFF; box-shadow: 4px 5px 0px #00FF66; }
  .pcv55__quick-btn:disabled { background: #333333; color: #888888; cursor: not-allowed; box-shadow: none; border-color: #333333; }

  /* CARD CONTENT */
  .pcv55__content { padding: 14px; display: flex; flex-direction: column; gap: 6px; flex-grow: 1; }

  .pcv55__vendor { font-size: 10px; text-transform: uppercase; color: var(--accent); font-weight: 800; letter-spacing: 0.1em; }
  .pcv55__item-title { font-family: var(--f-heading); font-size: 16px; font-weight: 800; color: var(--text); line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; text-transform: uppercase; }

  /* RATING */
  .pcv55__rating { display: flex; align-items: center; gap: 6px; font-size: 12px; color: var(--accent); }
  .pcv55__stars { letter-spacing: 1px; text-shadow: 0 0 6px var(--accent); }
  .pcv55__rev-cnt { color: var(--muted); font-size: 11px; }

  /* PRICE */
  .pcv55__price-row { display: flex; align-items: baseline; gap: 8px; margin-top: auto; padding-top: 4px; }
  .pcv55__price { font-size: 18px; font-weight: 800; color: #FFFFFF; font-family: var(--f-heading); }
  .pcv55__cmp-price { font-size: 13px; color: var(--muted); text-decoration: line-through; }

  /* SWATCHES */
  .pcv55__swatches { display: flex; gap: 6px; align-items: center; margin-top: 4px; }
  .pcv55__swatch { width: 14px; height: 14px; border: 1.5px solid var(--border); cursor: pointer; transition: var(--ease); }
  .pcv55__swatch:hover, .pcv55__swatch.active { border-color: var(--accent); background: var(--accent); box-shadow: 0 0 6px var(--accent); }

  /* URGENCY MICRO */
  .pcv55__urgency { font-size: 11px; color: #FF0033; font-weight: 800; font-family: var(--f-heading); text-transform: uppercase; display: flex; align-items: center; gap: 4px; margin-top: 2px; }

  /* TOAST */
  .pcv55__toast {
    position: fixed; bottom: 20px; right: 20px;
    background: var(--accent); color: #121212;
    border: 2px solid #121212; padding: 12px 20px;
    font-size: 12px; font-weight: 800; text-transform: uppercase; font-family: var(--f-heading);
    box-shadow: 4px 4px 0px #FF0033;
    z-index: 9999;
    transform: translateY(100px); opacity: 0;
    transition: all 0.2s ease;
  }
  .pcv55__toast.show { transform: translateY(0); opacity: 1; }
</style>

<div class="pcv55">
  <div class="pcv55__wrap">
    
    {% if section.settings.title != blank or section.settings.subheading != blank %}
      <div class="pcv55__head">
        <div>
          {% if section.settings.title != blank %}
            <h2 class="pcv55__title">{{ section.settings.title | escape }}</h2>
          {% endif %}
          {% if section.settings.subheading != blank %}
            <p class="pcv55__sub">{{ section.settings.subheading | escape }}</p>
          {% endif %}
        </div>
        {% if section.settings.show_view_all and section.settings.collection != blank %}
          <a href="{{ collections[section.settings.collection].url }}" class="pcv55__viewall">
            {{ section.settings.view_all_label | default: 'Shop 90s Grunge' }} &rarr;
          </a>
        {% endif %}
      </div>
    {% endif %}

    <div class="pcv55__grid">
      {% assign target_coll = collections[section.settings.collection] %}
      {% assign limit_num = section.settings.products_per_page | default: 8 %}

      {% if target_coll != blank and target_coll.products.size > 0 %}
        {% for product in target_coll.products limit: limit_num %}
          {% assign current_variant = product.selected_or_first_available_variant %}
          
          {% render 'card-v55', product: product, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v55', product: nil, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% endif %}
    </div>

  </div>
</div>

<div class="pcv55__toast" id="pcv55-toast">STREETWEAR ADDED</div>

<script>
(function(){
  // Wishlist is handled globally by assets/wishlist.js (shared store: cf_wishlist_items).
  // Buttons are rendered by snippets/wishlist-button.liquid — no per-section storage.


  document.querySelectorAll('[data-pcv55-add]').forEach(function(btn){
    btn.addEventListener('click', function(e){
      e.preventDefault(); e.stopPropagation();
      var id = btn.dataset.pcv55Add, orig = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = 'DROPPING...';

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: id, quantity: 1 })
      })
      .then(function(r){ return r.json(); })
      .then(function(){
        btn.innerHTML = '✓ ADDED';
        showT('STREETWEAR ADDED');
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      })
      .catch(function(){
        btn.innerHTML = 'ERROR';
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      });
    });
  });

  function showT(msg){
    var t = document.getElementById('pcv55-toast');
    if(!t) return;
    t.textContent = msg;
    t.classList.add('show');
    setTimeout(function(){ t.classList.remove('show'); }, 3000);
  }
})();
</script>

