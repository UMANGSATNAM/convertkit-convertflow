{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#ffffff'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 80px 40px;
  }
  
  .hp15-pills-container-{{ section_id }} {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 15px;
  }
  
  .hp15-pill-{{ section_id }} {
    display: inline-flex;
    align-items: center;
    padding: 12px 25px;
    background: transparent;
    border: 1px solid #000;
    color: #000;
    text-decoration: none;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    transition: all 0.3s ease;
  }
  
  .hp15-pill-{{ section_id }}:hover {
    background: #000;
    color: #fff;
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 40px 20px;
    }
    .hp15-pill-{{ section_id }} {
      padding: 10px 20px;
      font-size: 0.7rem;
    }
  }
</style>

<div class="hp15-pills-container-{{ section_id }}">
  {% for block in section.blocks %}
    <a href="{{ block.settings.link | default: '#' }}" class="hp15-pill-{{ section_id }}" {{ block.shopify_attributes }}>
      {{ block.settings.title | default: 'Category' }}
    </a>
  {% endfor %}
</div>

{% schema %}
{
  "name": "HP15 Category Pills",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Category"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP15 Category Pills",
      "blocks": [
        { "type": "category", "settings": { "title": "OUTERWEAR" } },
        { "type": "category", "settings": { "title": "KNITWEAR" } },
        { "type": "category", "settings": { "title": "TAILORING" } },
        { "type": "category", "settings": { "title": "FOOTWEAR" } },
        { "type": "category", "settings": { "title": "LEATHER GOODS" } }
      ]
    }
  ]
}
{% endschema %}
