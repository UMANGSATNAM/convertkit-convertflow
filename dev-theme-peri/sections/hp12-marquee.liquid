{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#FAFAFA'
  assign text_color = section.settings.text_color | default: '#333333'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 40px 0;
    overflow: hidden;
    border-bottom: 1px solid #E5E5E5;
  }
  
  .hp12-marquee-container-{{ section_id }} {
    display: flex;
    white-space: nowrap;
    overflow: hidden;
  }
  
  .hp12-marquee-content-{{ section_id }} {
    display: flex;
    animation: hp12-marquee-scroll-{{ section_id }} 20s linear infinite;
    align-items: center;
  }
  
  .hp12-marquee-item-{{ section_id }} {
    display: inline-flex;
    align-items: center;
    padding: 0 40px;
    font-family: 'Inter', sans-serif;
    font-size: 0.85rem;
    color: {{ text_color }};
    font-weight: 300;
    letter-spacing: 3px;
    text-transform: uppercase;
  }
  
  .hp12-marquee-dot-{{ section_id }} {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background-color: {{ text_color }};
    margin: 0 20px;
    opacity: 0.3;
  }

  @keyframes hp12-marquee-scroll-{{ section_id }} {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

@media screen and (max-width: 768px) {
  .hp12-marquee {
    padding-left: 16px !important;
    padding-right: 16px !important;
    box-sizing: border-box !important;
  }
  img {
    max-width: 100% !important;
    height: auto !important;
  }
}

</style>

<div class="hp12-marquee-container-{{ section_id }}">
  <div class="hp12-marquee-content-{{ section_id }}">
    <!-- First set -->
    {% for i in (1..6) %}
      <div class="hp12-marquee-item-{{ section_id }}">
        {{ section.settings.text | default: 'Essential Objects for Modern Living' }}
      </div>
      <div class="hp12-marquee-dot-{{ section_id }}"></div>
    {% endfor %}
    <!-- Duplicate for seamless loop -->
    {% for i in (1..6) %}
      <div class="hp12-marquee-item-{{ section_id }}">
        {{ section.settings.text | default: 'Essential Objects for Modern Living' }}
      </div>
      <div class="hp12-marquee-dot-{{ section_id }}"></div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "HP12 Marquee",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FAFAFA"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#333333"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Marquee Text",
      "default": "Essential Objects for Modern Living"
    }
  ],
  "presets": [
    {
      "name": "HP12 Marquee"
    }
  ]
}
{% endschema %}
