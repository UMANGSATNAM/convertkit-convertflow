{%- liquid
  assign bg_color = section.settings.bg_color | default: '#ffffff'
  assign border_color = section.settings.border_color | default: '#000000'
  assign grid_gap = section.settings.grid_gap
  assign border_width = section.settings.border_width
  
  assign padding_top_desktop = section.settings.padding_top_desktop
  assign padding_bottom_desktop = section.settings.padding_bottom_desktop
  assign padding_top_mobile = section.settings.padding_top_mobile
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile
-%}

<style>
  #shopify-section-{{ section.id }} {
    --hp2-tiles-bg: {{ bg_color }};
    --hp2-tiles-border: {{ border_color }};
    --hp2-tiles-gap: {{ grid_gap }}px;
    --hp2-tiles-bw: {{ border_width }}px;
    
    --hp2-tiles-pt-desk: {{ padding_top_desktop }}px;
    --hp2-tiles-pb-desk: {{ padding_bottom_desktop }}px;
    --hp2-tiles-pt-mob: {{ padding_top_mobile }}px;
    --hp2-tiles-pb-mob: {{ padding_bottom_mobile }}px;
  }

  .hp2-fashion-categories-{{ section.id }} {
    padding-top: var(--hp2-tiles-pt-desk);
    padding-bottom: var(--hp2-tiles-pb-desk);
    background-color: var(--hp2-tiles-bg);
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
  }

  .hp2-cat-inner {
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .hp2-cat-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: 400px; /* Base height for rows */
    gap: var(--hp2-tiles-gap);
    background-color: var(--hp2-tiles-border);
    border: var(--hp2-tiles-bw) solid var(--hp2-tiles-border);
  }

  .hp2-cat-item {
    position: relative;
    background-color: #fff;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    text-decoration: none;
    color: #fff;
  }

  /* Structural masonry logic */
  /* Block 1: Big Hero Block */
  .hp2-cat-item:nth-child(1) {
    grid-column: span 2;
    grid-row: span 2;
  }
  
  /* Block 2 & 3: Stacked on the right */
  .hp2-cat-item:nth-child(2),
  .hp2-cat-item:nth-child(3) {
    grid-column: span 1;
    grid-row: span 1;
  }
  
  /* Block 4, 5, 6: Row below */
  .hp2-cat-item:nth-child(4),
  .hp2-cat-item:nth-child(5),
  .hp2-cat-item:nth-child(6) {
    grid-column: span 1;
    grid-row: span 1;
  }

  .hp2-cat-img-wrapper {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #e0e0e0;
  }

  .hp2-cat-img-wrapper img, 
  .hp2-cat-img-wrapper svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .hp2-cat-item:hover .hp2-cat-img-wrapper img,
  .hp2-cat-item:focus-visible .hp2-cat-img-wrapper img {
    transform: scale(1.08);
  }

  /* Overlay */
  .hp2-cat-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.2) 50%, rgba(0,0,0,0) 100%);
    pointer-events: none;
    transition: background 0.4s ease;
  }
  .hp2-cat-item:hover .hp2-cat-overlay {
    background: linear-gradient(to top, rgba(0,0,0,0.95) 0%, rgba(0,0,0,0.4) 60%, rgba(0,0,0,0) 100%);
  }

  /* Content */
  .hp2-cat-content {
    position: relative;
    z-index: 2;
    margin-top: auto; /* Push to bottom */
    padding: 40px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-items: flex-start;
  }

  .hp2-cat-title {
    font-size: 28px;
    font-weight: 900;
    text-transform: uppercase;
    margin: 0;
    line-height: 1.1;
    letter-spacing: -0.5px;
    transform: translateY(10px);
    transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .hp2-cat-item:nth-child(1) .hp2-cat-title {
    font-size: clamp(40px, 4vw, 60px); /* Larger on the hero block */
  }

  .hp2-cat-link {
    font-size: 13px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 2px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    position: relative;
  }
  
  .hp2-cat-link::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0%;
    height: 2px;
    background-color: currentColor;
    transition: width 0.3s ease;
  }

  .hp2-cat-item:hover .hp2-cat-title {
    transform: translateY(0);
  }
  .hp2-cat-item:hover .hp2-cat-link {
    opacity: 1;
    transform: translateY(0);
  }
  .hp2-cat-item:hover .hp2-cat-link::after {
    width: 100%;
  }

  /* Responsive Adjustments */
  @media screen and (max-width: 1200px) {
    .hp2-cat-content { padding: 30px; }
  }

  @media screen and (max-width: 991px) {
    .hp2-cat-grid {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 350px;
    }
    .hp2-cat-item:nth-child(1) { grid-column: span 2; grid-row: span 1; }
    .hp2-cat-item:nth-child(2), .hp2-cat-item:nth-child(3), 
    .hp2-cat-item:nth-child(4), .hp2-cat-item:nth-child(5), 
    .hp2-cat-item:nth-child(6) { grid-column: span 1; grid-row: span 1; }
  }

  @media screen and (max-width: 768px) {
    .hp2-fashion-categories-{{ section.id }} {
      padding-top: var(--hp2-tiles-pt-mob);
      padding-bottom: var(--hp2-tiles-pb-mob);
    }
    .hp2-cat-inner { padding: 0 20px; }
    
    .hp2-cat-grid {
      grid-template-columns: 1fr;
      grid-auto-rows: 400px;
    }
    
    .hp2-cat-item:nth-child(1),
    .hp2-cat-item:nth-child(2),
    .hp2-cat-item:nth-child(3),
    .hp2-cat-item:nth-child(4),
    .hp2-cat-item:nth-child(5),
    .hp2-cat-item:nth-child(6) {
      grid-column: span 1;
      grid-row: span 1;
    }
    
    .hp2-cat-content { padding: 20px; }
    
    /* Ensure elements are always visible on mobile since no hover */
    .hp2-cat-title { transform: translateY(0); }
    .hp2-cat-link { opacity: 1; transform: translateY(0); }
  }
</style>

<section class="hp2-fashion-categories-{{ section.id }}" aria-label="Curated Categories">
  <div class="hp2-cat-inner">
    
    <div class="hp2-cat-grid">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link | default: '#' }}" 
           class="hp2-cat-item" 
           aria-label="Shop {{ block.settings.title | escape }}"
           {{ block.shopify_attributes }}>
          
          <div class="hp2-cat-img-wrapper">
            {%- if block.settings.image != blank -%}
              <img height="{{ block.settings.image.height }}" width="{{ block.settings.image.width }}" src="{{ block.settings.image | image_url: width: 800 }}" 
                   srcset="{{ block.settings.image | image_url: width: 600 }} 600w, 
                           {{ block.settings.image | image_url: width: 1200 }} 1200w"
                   sizes="(max-width: 768px) 100vw, (max-width: 991px) 50vw, 33vw"
                   loading="lazy" 
                   alt="{{ block.settings.image.alt | default: block.settings.title | escape }}">
            {%- else -%}
              {%- capture current -%}{% cycle 1, 2, 3, 4, 5, 6 %}{%- endcapture -%}
              {{ 'collection-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
            
            <div class="hp2-cat-overlay"></div>
          </div>
          
          <div class="hp2-cat-content">
            <h3 class="hp2-cat-title">{{ block.settings.title }}</h3>
            <span class="hp2-cat-link">
              {{ block.settings.btn_label | default: 'DISCOVER' }} 
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="M12 5l7 7-7 7"></path></svg>
            </span>
          </div>
          
        </a>
      {%- endfor -%}
      
      {%- if section.blocks.size == 0 -%}
        {%- for i in (1..3) -%}
          <div class="hp2-cat-item">
            <div class="hp2-cat-img-wrapper">
              {{ 'collection-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}
              <div class="hp2-cat-overlay"></div>
            </div>
            <div class="hp2-cat-content">
              <h3 class="hp2-cat-title">Collection Title</h3>
              <span class="hp2-cat-link">DISCOVER <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"></path><path d="M12 5l7 7-7 7"></path></svg></span>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "HP2 Category Tiles",
  "tag": "section",
  "class": "section-hp2-category-tiles",
  "max_blocks": 6,
  "settings": [
    {
      "type": "header",
      "content": "Grid Settings"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 0, "max": 20, "step": 1, "unit": "px",
      "label": "Grid Gap / Spacing",
      "default": 4
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0, "max": 10, "step": 1, "unit": "px",
      "label": "Outer Border Width",
      "default": 4
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Grid Lines / Border Color",
      "default": "#000000",
      "info": "This acts as the background for the grid gap to create 'lines'."
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Top (Desktop)", "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Bottom (Desktop)", "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Top (Mobile)", "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Bottom (Mobile)", "default": 40
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Block",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Block 1 (Large) needs a high-res image."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Category Title",
          "default": "MENSWEAR"
        },
        {
          "type": "text",
          "id": "btn_label",
          "label": "Link Text",
          "default": "DISCOVER"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link Destination"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP2 Category Tiles (Advanced)",
      "blocks": [
        { "type": "category", "settings": { "title": "NEW SEASON" } },
        { "type": "category", "settings": { "title": "ACCESSORIES" } },
        { "type": "category", "settings": { "title": "FOOTWEAR" } }
      ]
    }
  ]
}
{% endschema %}
