{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600&family=Syncopate:wght@400;700&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --font-heading: 'Syncopate', sans-serif;
    --font-body: 'Space Grotesk', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    border-top: 1px solid rgba(226, 226, 226, 0.1);
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.8 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.8 | round }}px;
    }
  }

  .hp27-ugc-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp27-ugc-wrapper {
      padding: 0 20px;
    }
  }

  .hp27-ugc__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 40px;
  }

  @media screen and (max-width: 768px) {
    .hp27-ugc__header {
      flex-direction: column;
      align-items: flex-start;
      gap: 15px;
    }
  }

  .hp27-ugc__title {
    font-family: var(--font-heading);
    font-size: clamp(24px, 3vw, {{ section.settings.title_size }}px);
    font-weight: 700;
    color: var(--text-color);
    margin: 0;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }

  .hp27-ugc__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: 20px;
  }

  @media screen and (max-width: 992px) {
    .hp27-ugc__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media screen and (max-width: 768px) {
    .hp27-ugc__grid {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      -ms-overflow-style: none;
      padding-bottom: 20px;
    }
    .hp27-ugc__grid::-webkit-scrollbar {
      display: none;
    }
  }

  .hp27-ugc__item {
    position: relative;
    aspect-ratio: 9/16;
    background: #111;
    border: 1px solid rgba(226, 226, 226, 0.2);
    cursor: pointer;
    overflow: hidden;
    scroll-snap-align: start;
    flex: 0 0 70%; /* Mobile sizing */
  }

  /* Technical corners on hover */
  .hp27-ugc__item::before,
  .hp27-ugc__item::after {
    content: '';
    position: absolute;
    width: 20px; height: 20px;
    border: 2px solid var(--accent-color);
    opacity: 0;
    transition: all 0.3s ease;
    z-index: 3;
    pointer-events: none;
  }

  .hp27-ugc__item::before {
    top: -5px; left: -5px;
    border-right: none; border-bottom: none;
  }
  .hp27-ugc__item::after {
    bottom: -5px; right: -5px;
    border-left: none; border-top: none;
  }

  .hp27-ugc__item:hover::before {
    top: 5px; left: 5px; opacity: 1;
  }
  .hp27-ugc__item:hover::after {
    bottom: 5px; right: 5px; opacity: 1;
  }

  .hp27-ugc__image,
  .hp27-ugc__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(80%) contrast(1.1);
    transition: filter 0.4s ease;
  }

  .hp27-ugc__item:hover .hp27-ugc__image,
  .hp27-ugc__item:hover .hp27-ugc__video {
    filter: grayscale(0%) contrast(1);
  }

  .hp27-ugc__overlay {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(10, 10, 10, 0.3);
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.3s ease;
  }

  .hp27-ugc__item:hover .hp27-ugc__overlay {
    background: rgba(10, 10, 10, 0.1);
  }

  .hp27-ugc__play {
    width: 48px;
    height: 48px;
    border: 1px solid var(--text-color);
    background: rgba(10, 10, 10, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(4px);
    transition: all 0.3s ease;
  }

  .hp27-ugc__play svg {
    width: 16px;
    height: 16px;
    fill: var(--text-color);
    margin-left: 3px;
  }

  .hp27-ugc__item:hover .hp27-ugc__play {
    background: var(--text-color);
    box-shadow: 0 0 15px rgba(226, 226, 226, 0.4);
  }

  .hp27-ugc__item:hover .hp27-ugc__play svg {
    fill: var(--bg-color);
  }

  .hp27-ugc__handle {
    position: absolute;
    bottom: 15px;
    left: 15px;
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--text-color);
    background: rgba(10, 10, 10, 0.8);
    padding: 4px 8px;
    z-index: 3;
    text-transform: uppercase;
    border: 1px solid rgba(226, 226, 226, 0.2);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp27-ugc-wrapper" id="HP27UGC-{{ section.id }}">
  <div class="hp27-ugc__header">
    {%- if section.settings.title != blank -%}
      <h2 class="hp27-ugc__title">{{ section.settings.title }}</h2>
    {%- endif -%}
  </div>

  <div class="hp27-ugc__grid">
    {%- for block in section.blocks -%}
      <div class="hp27-ugc__item" {{ block.shopify_attributes }}>
        {%- if block.settings.video_url != blank -%}
          <!-- Simulate video for standard URLs -->
          <video class="hp27-ugc__video" src="{{ block.settings.video_url }}" muted loop playsinline></video>
        {%- elsif block.settings.image != blank -%}
          <img height="{{ block.settings.image.height }}" width="{{ block.settings.image.width }}" src="{{ block.settings.image | image_url: width: 600 }}" class="hp27-ugc__image" loading="lazy" alt="UGC">
        {%- else -%}
          {{ 'lifestyle-' | append: forloop.index | placeholder_svg_tag: 'hp27-ugc__image' }}
        {%- endif -%}

        <div class="hp27-ugc__overlay">
          <div class="hp27-ugc__play">
            <svg viewBox="0 0 24 24"><path d="M8 5V19L19 12L8 5Z"/></svg>
          </div>
        </div>

        {%- if block.settings.handle != blank -%}
          <div class="hp27-ugc__handle">{{ block.settings.handle }}</div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</div>

<script>
  // Simple script to play video on hover if it exists
  document.addEventListener('DOMContentLoaded', function() {
    const items = document.querySelectorAll('#HP27UGC-{{ section.id }} .hp27-ugc__item');
    items.forEach(item => {
      const vid = item.querySelector('video');
      if (vid) {
        item.addEventListener('mouseenter', () => vid.play());
        item.addEventListener('mouseleave', () => vid.pause());
      }
    });
  });
</script>

{% schema %}
{
  "name": "HP27 - Eng UGC",
  "class": "section-hp27-ugc-reels",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "FIELD REPORTS"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1400
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 3,
      "max": 6,
      "step": 1,
      "label": "Columns (Desktop)",
      "default": 4
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 40
    },
    {
      "type": "header",
      "content": "Dark Engineered Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#0A0A0A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#E2E2E2"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#FF2A2A"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "reel",
      "name": "Reel",
      "limit": 6,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Thumbnail Image"
        },
        {
          "type": "url",
          "id": "video_url",
          "label": "Video Link (MP4)"
        },
        {
          "type": "text",
          "id": "handle",
          "label": "Handle",
          "default": "USER_ID: 104"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP27 - Eng UGC",
      "blocks": [
        { "type": "reel" },
        { "type": "reel" },
        { "type": "reel" },
        { "type": "reel" }
      ]
    }
  ]
}
{% endschema %}
