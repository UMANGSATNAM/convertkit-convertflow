{%- liquid
  assign section_id = section.id
-%}

<style>
  #shopify-section-{{ section_id }} {
    padding: 0;
    border-bottom: 1px solid rgba(0, 255, 65, 0.3);
  }
  
  .hp17-video-container-{{ section_id }} {
    position: relative;
    width: 100%;
    height: 80vh;
    min-height: 500px;
    background: #000;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .hp17-video-element-{{ section_id }} {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover;
    opacity: 0.5;
    filter: sepia(100%) hue-rotate(80deg) saturate(300%) contrast(150%);
  }
  
  .hp17-video-scanline-{{ section_id }} {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%), linear-gradient(90deg, rgba(255, 0, 0, 0.06), rgba(0, 255, 0, 0.02), rgba(0, 0, 255, 0.06));
    background-size: 100% 4px, 6px 100%;
    z-index: 1;
    pointer-events: none;
  }
  
  .hp17-video-overlay-{{ section_id }} {
    position: relative;
    z-index: 2;
    text-align: center;
  }
  
  .hp17-video-play-{{ section_id }} {
    width: 80px;
    height: 80px;
    background: transparent;
    border: 2px solid #00FF41;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 30px;
    cursor: pointer;
    color: #00FF41;
    transition: all 0.3s ease;
    border-radius: 5px;
  }
  
  .hp17-video-play-{{ section_id }}:hover {
    background: rgba(0, 255, 65, 0.2);
    box-shadow: 0 0 20px rgba(0, 255, 65, 0.5);
    transform: scale(1.1);
  }
  
  .hp17-video-play-{{ section_id }} svg {
    width: 30px;
    height: 30px;
    margin-left: 5px;
  }
  
  .hp17-video-title-{{ section_id }} {
    font-family: 'Courier New', Courier, monospace;
    font-size: 1.5rem;
    font-weight: bold;
    letter-spacing: 5px;
    color: #FFF;
    text-shadow: 0 0 10px rgba(255,255,255,0.5);
    margin: 0;
  }

  @media (max-width: 768px) {
    .hp17-video-container-{{ section_id }} {
      height: 50vh;
    }
  }
</style>

<div class="hp17-video-container-{{ section_id }}">
  {% if section.settings.video_url != blank %}
    <video class="hp17-video-element-{{ section_id }}" autoplay loop muted playsinline>
      <source src="{{ section.settings.video_url }}" type="video/mp4">
    </video>
  {% else %}
    <div class="hp17-video-element-{{ section_id }}" style="background: repeating-linear-gradient(45deg, #EFEFEF, #EFEFEF 12px, #E6E6E6 12px, #E6E6E6 24px);"></div>
  {% endif %}
  <div class="hp17-video-scanline-{{ section_id }}"></div>
  
  <div class="hp17-video-overlay-{{ section_id }}">
    <button class="hp17-video-play-{{ section_id }}">
      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
    </button>
    <h2 class="hp17-video-title-{{ section_id }}">{{ section.settings.title | default: 'STREAM.DATA' }}</h2>
  </div>
</div>

{% schema %}
{
  "name": "HP17 Video",
  "settings": [
    {
      "type": "text",
      "id": "video_url",
      "label": "Video URL (MP4)",
      "info": "Upload video to Settings > Files and paste URL here."
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "STREAM.DATA"
    }
  ],
  "presets": [
    {
      "name": "HP17 Video"
    }
  ]
}
{% endschema %}
