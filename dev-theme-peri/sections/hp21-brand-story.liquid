{%- style -%}
  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --btn-bg: {{ section.settings.btn_bg }};
    --btn-text: {{ section.settings.btn_text_color }};
    --font-heading: 'Playfair Display', serif;
    --font-body: 'Jost', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }

  .hp21-story-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp21-story-wrapper {
      padding: 0 20px;
    }
  }

  .hp21-story__container {
    display: flex;
    align-items: center;
    gap: {{ section.settings.gap }}px;
    flex-direction: {% if section.settings.layout == 'image_right' %}row-reverse{% else %}row{% endif %};
  }

  @media screen and (max-width: 992px) {
    .hp21-story__container {
      flex-direction: column;
      gap: 40px;
    }
  }

  .hp21-story__image-col {
    flex: 1;
    position: relative;
    width: 100%;
  }

  .hp21-story__image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: {{ section.settings.image_ratio }};
    overflow: hidden;
  }
  
  /* Cinematic edge fade */
  .hp21-story__image-wrapper::after {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    box-shadow: inset 0 0 100px rgba(10, 10, 10, 0.8);
    pointer-events: none;
  }

  .hp21-story__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: {% if section.settings.image_grayscale %}grayscale(100%){% else %}none{% endif %};
    transition: transform 10s ease;
  }
  
  .hp21-story__image-wrapper:hover .hp21-story__image {
    transform: scale(1.05);
  }

  /* Decorative line */
  .hp21-story__deco-line {
    position: absolute;
    {% if section.settings.layout == 'image_right' %}
      right: -20px;
    {% else %}
      left: -20px;
    {% endif %}
    top: 10%;
    bottom: 10%;
    width: 1px;
    background: var(--accent-color);
    opacity: 0.5;
  }

  @media screen and (max-width: 992px) {
    .hp21-story__deco-line {
      display: none;
    }
  }

  .hp21-story__text-col {
    flex: 1;
    padding: {% if section.settings.layout == 'image_right' %}0 60px 0 0{% else %}0 0 0 60px{% endif %};
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  @media screen and (max-width: 992px) {
    .hp21-story__text-col {
      padding: 0;
      text-align: center;
      align-items: center;
    }
  }

  .hp21-story__subtitle {
    font-family: var(--font-body);
    font-size: {{ section.settings.subtitle_size }}px;
    font-weight: 300;
    letter-spacing: 4px;
    color: var(--accent-color);
    text-transform: uppercase;
    margin: 0 0 16px;
  }

  .hp21-story__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    font-weight: 400;
    line-height: 1.1;
    color: var(--text-color);
    margin: 0 0 32px;
  }
  
  .hp21-story__title em {
    font-style: italic;
    color: var(--accent-color);
  }

  .hp21-story__text {
    font-family: var(--font-body);
    font-size: {{ section.settings.text_size }}px;
    font-weight: 300;
    line-height: 1.7;
    color: var(--text-color);
    opacity: 0.8;
    margin: 0 0 40px;
  }

  .hp21-story__signature {
    margin-bottom: 40px;
  }
  
  .hp21-story__signature img {
    max-width: 150px;
    filter: invert(1); /* Assuming black signature uploaded, invert for dark mode */
  }

  .hp21-story__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 40px;
    background: var(--btn-bg);
    color: var(--btn-text);
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 14px;
    letter-spacing: 2px;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.4s ease;
    border: 1px solid var(--btn-bg);
  }

  .hp21-story__btn:hover {
    background: transparent;
    color: var(--btn-bg);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp21-story-wrapper" id="HP21BrandStory-{{ section.id }}">
  <div class="hp21-story__container">
    
    <div class="hp21-story__image-col">
      <div class="hp21-story__image-wrapper">
        {%- if section.settings.image != blank -%}
          <img height="{{ section.settings.image.height }}" width="{{ section.settings.image.width }}" src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.title | escape }}" class="hp21-story__image" loading="lazy">
        {%- else -%}
          <div style="width:100%;height:100%;background:#111;display:flex;align-items:center;justify-content:center;color:#333;">STORY IMAGE</div>
        {%- endif -%}
      </div>
      <div class="hp21-story__deco-line"></div>
    </div>

    <div class="hp21-story__text-col">
      {%- if section.settings.subtitle != blank -%}
        <p class="hp21-story__subtitle">{{ section.settings.subtitle | escape }}</p>
      {%- endif -%}
      
      {%- if section.settings.title != blank -%}
        <h2 class="hp21-story__title">{{ section.settings.title }}</h2>
      {%- endif -%}
      
      {%- if section.settings.text != blank -%}
        <div class="hp21-story__text">{{ section.settings.text }}</div>
      {%- endif -%}
      
      {%- if section.settings.signature != blank -%}
        <div class="hp21-story__signature">
          <img height="{{ section.settings.signature.height }}" width="{{ section.settings.signature.width }}" src="{{ section.settings.signature | image_url: width: 300 }}" alt="Signature" loading="lazy">
        </div>
      {%- endif -%}

      {%- if section.settings.btn_text != blank and section.settings.btn_link != blank -%}
        <a href="{{ section.settings.btn_link }}" class="hp21-story__btn">
          {{ section.settings.btn_text | escape }}
        </a>
      {%- endif -%}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "HP21 - Luxury Story",
  "class": "section-hp21-brand-story",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Image Position (Desktop)",
      "options": [
        { "value": "image_left", "label": "Image Left" },
        { "value": "image_right", "label": "Image Right" }
      ],
      "default": "image_left"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1400
    },
    {
      "type": "range",
      "id": "gap",
      "min": 40,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "Gap between columns",
      "default": 80
    },
    {
      "type": "header",
      "content": "Image Settings"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Main Image"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image Aspect Ratio",
      "options": [
        { "value": "1/1", "label": "Square (1:1)" },
        { "value": "3/4", "label": "Portrait (3:4)" },
        { "value": "4/5", "label": "Tall (4:5)" },
        { "value": "16/9", "label": "Landscape (16:9)" }
      ],
      "default": "4/5"
    },
    {
      "type": "checkbox",
      "id": "image_grayscale",
      "label": "Grayscale Image",
      "default": false
    },
    {
      "type": "header",
      "content": "Text Content"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "THE HERITAGE"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Heading",
      "default": "<p>A Legacy of <em>Refined</em> Craftsmanship</p>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Body Text",
      "default": "<p>Every element is carefully considered. From the raw materials to the final stitch, we dedicate ourselves to the pursuit of absolute perfection. This is not just a product, it is a testament to our enduring commitment to excellence.</p>"
    },
    {
      "type": "image_picker",
      "id": "signature",
      "label": "Signature Image (Optional)"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "DISCOVER MORE"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 30,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 48
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Subtitle Size",
      "default": 14
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 14,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Text Size",
      "default": 16
    },
    {
      "type": "header",
      "content": "Luxury Styling"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#0A0A0A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color (Lines/Italics)",
      "default": "#D4AF37"
    },
    {
      "type": "color",
      "id": "btn_bg",
      "label": "Button Background",
      "default": "#D4AF37"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Button Text Color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 100
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP21 - Luxury Story"
    }
  ]
}
{% endschema %}
