{% comment %}
  Urgency Live Proof - Real-Time Buyer Social Proof Ticker
  PageFly-Style Booster Section
{% endcomment %}

<div id="cf-live-proof-{{ section.id }}" class="cf-live-proof-wrap {% if section.settings.position == 'floating' %}cf-floating-toast{% endif %}">
  <div class="cf-proof-card" style="background: {{ section.settings.bg_color | default: '#ffffff' }}; border: 1px solid {{ section.settings.border_color | default: '#e2e8f0' }}; box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1);">
    <div class="cf-proof-media">
      <img class="cf-proof-img" src="https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=120&q=80" alt="Product" width="46" height="46" loading="lazy">
      <span class="cf-proof-dot"></span>
    </div>
    <div class="cf-proof-body">
      <div class="cf-proof-buyer">
        <strong class="cf-proof-name">Aarav S.</strong> from <span class="cf-proof-city">Mumbai</span>
        <span class="cf-proof-verified" title="Verified Order">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="#059669"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
        </span>
      </div>
      <div class="cf-proof-item">Purchased <strong class="cf-proof-title">Premium Wireless Audio</strong></div>
      <div class="cf-proof-time"><span class="cf-proof-ago">3 minutes ago</span> · <span style="color:#059669; font-weight:700;">Verified Purchase</span></div>
    </div>
    <button type="button" class="cf-proof-close" onclick="this.closest('.cf-proof-card').style.display='none';" aria-label="Dismiss">×</button>
  </div>
</div>

<style>
  .cf-live-proof-wrap {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    margin: 12px 0;
  }
  .cf-floating-toast {
    position: fixed;
    bottom: 24px;
    left: 24px;
    z-index: 99999;
    margin: 0;
  }
  .cf-proof-card {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    border-radius: 12px;
    position: relative;
    max-width: 380px;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
  }
  .cf-proof-media {
    position: relative;
    width: 46px;
    height: 46px;
    flex-shrink: 0;
  }
  .cf-proof-img {
    width: 46px;
    height: 46px;
    border-radius: 8px;
    object-fit: cover;
    background: #f1f5f9;
  }
  .cf-proof-dot {
    position: absolute;
    bottom: -2px;
    right: -2px;
    width: 10px;
    height: 10px;
    background: #10b981;
    border: 2px solid #ffffff;
    border-radius: 99px;
  }
  .cf-proof-body {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .cf-proof-buyer {
    font-size: 12px;
    color: #1e293b;
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .cf-proof-verified {
    display: inline-flex;
  }
  .cf-proof-item {
    font-size: 12px;
    color: #475569;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 240px;
  }
  .cf-proof-time {
    font-size: 10px;
    color: #94a3b8;
  }
  .cf-proof-close {
    position: absolute;
    top: 4px;
    right: 8px;
    background: none;
    border: none;
    font-size: 16px;
    color: #94a3b8;
    cursor: pointer;
    line-height: 1;
    padding: 2px;
  }
  .cf-proof-close:hover {
    color: #475569;
  }
  @media (max-width: 640px) {
    .cf-floating-toast {
      bottom: 16px;
      left: 16px;
      right: 16px;
      max-width: calc(100% - 32px);
    }
  }
</style>

<script>
  (function() {
    var wrap = document.getElementById("cf-live-proof-{{ section.id }}");
    if (!wrap) return;
    var card = wrap.querySelector(".cf-proof-card");
    if (!card) return;

    var names = ["Aarav S.", "Riya M.", "Vikram K.", "Ananya P.", "Karan D.", "Sneha R.", "Dev P."];
    var cities = ["Mumbai", "Bengaluru", "Delhi", "Pune", "Hyderabad", "Jaipur", "Ahmedabad"];
    var products = [
      "Premium Matte Case",
      "Over-Ear ANC Headphones",
      "Silk Nightwear Set",
      "Organic Vitamin Serum",
      "Streetwear Heavyweight Tee",
      "Artisanal Coffee Roast"
    ];
    var images = [
      "https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=120&q=80",
      "https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=120&q=80",
      "https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=120&q=80",
      "https://images.unsplash.com/photo-1521572267360-ee0c2909d518?w=120&q=80"
    ];

    var nameEl = card.querySelector(".cf-proof-name");
    var cityEl = card.querySelector(".cf-proof-city");
    var itemEl = card.querySelector(".cf-proof-title");
    var imgEl = card.querySelector(".cf-proof-img");
    var agoEl = card.querySelector(".cf-proof-ago");

    var idx = 0;
    setInterval(function() {
      card.style.opacity = "0";
      card.style.transform = "translateY(8px)";
      setTimeout(function() {
        idx = (idx + 1) % names.length;
        if (nameEl) nameEl.textContent = names[idx];
        if (cityEl) cityEl.textContent = cities[idx % cities.length];
        if (itemEl) itemEl.textContent = products[idx % products.length];
        if (imgEl) imgEl.src = images[idx % images.length];
        if (agoEl) agoEl.textContent = (Math.floor(Math.random() * 8) + 1) + " minutes ago";
        card.style.opacity = "1";
        card.style.transform = "translateY(0)";
      }, 350);
    }, 6000);
  })();
</script>

{% schema %}
{
  "name": "Urgency Live Proof",
  "settings": [
    {
      "type": "select",
      "id": "position",
      "label": "Layout Position",
      "options": [
        { "value": "floating", "label": "Floating Bottom-Left Toast" },
        { "value": "inline", "label": "Inline Section Banner" }
      ],
      "default": "floating"
    },
    { "type": "color", "id": "bg_color", "label": "Card Background", "default": "#ffffff" },
    { "type": "color", "id": "border_color", "label": "Border Color", "default": "#e2e8f0" }
  ],
  "presets": [
    {
      "name": "Urgency Live Proof"
    }
  ]
}
{% endschema %}
