{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp44-trust-bg: {{ section.settings.bg_color | default: '#143D2B' }};
    --hp44-trust-text: {{ section.settings.text_color | default: '#FFFFFF' }};
    
    background-color: var(--hp44-trust-bg);
    color: var(--hp44-trust-text);
    padding-top: {{ section.settings.padding_top | default: 50 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 50 }}px;
  }

  .hp44-trust__grid {
    max-width: {{ section.settings.container_width | default: 1200 }}px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: 4 }}, 1fr);
    gap: 30px;
    text-align: center;
  }

  .hp44-trust__icon {
    font-size: 32px;
    margin-bottom: 12px;
  }

  .hp44-trust__title {
    font-family: 'Playfair Display', serif;
    font-size: 17px;
    font-weight: 700;
    margin: 0 0 6px;
  }

  .hp44-trust__desc {
    font-size: 13px;
    color: #D8E8DC;
    margin: 0;
    line-height: 1.5;
  }

  @media screen and (max-width: 992px) {
    .hp44-trust__grid { grid-template-columns: repeat(2, 1fr); }
  }
{%- endstyle -%}

<div class="hp44-trust__grid">
  {%- if section.blocks.size > 0 -%}
    {%- for block in section.blocks -%}
      <div {{ block.shopify_attributes }}>
        <div class="hp44-trust__icon">{{ block.settings.icon | default: '🛡️' }}</div>
        <h4 class="hp44-trust__title">{{ block.settings.title }}</h4>
        <p class="hp44-trust__desc">{{ block.settings.description }}</p>
      </div>
    {%- endfor -%}
  {%- else -%}
    <div>
      <div class="hp44-trust__icon">🌿</div>
      <h4 class="hp44-trust__title">100% Organic Origin</h4>
      <p class="hp44-trust__desc">Certified Nordic ingredients.</p>
    </div>
    <div>
      <div class="hp44-trust__icon">✈️</div>
      <h4 class="hp44-trust__title">Express Global Delivery</h4>
      <p class="hp44-trust__desc">Pre-paid customs in 180+ countries.</p>
    </div>
    <div>
      <div class="hp44-trust__icon">🛡️</div>
      <h4 class="hp44-trust__title">30-Day Ritual Guarantee</h4>
      <p class="hp44-trust__desc">Risk-free botanical trial.</p>
    </div>
    <div>
      <div class="hp44-trust__icon">🔒</div>
      <h4 class="hp44-trust__title">Encrypted Checkout</h4>
      <p class="hp44-trust__desc">256-Bit SSL payment security.</p>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "HP44 - Sage Badges",
  "class": "section-hp44-badges",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#143D2B" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#FFFFFF" },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "label": "Desktop Columns", "default": 4 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 100, "step": 5, "unit": "px", "label": "Padding Top", "default": 50 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 100, "step": 5, "unit": "px", "label": "Padding Bottom", "default": 50 },
    { "type": "range", "id": "container_width", "min": 800, "max": 1400, "step": 20, "unit": "px", "label": "Container Width", "default": 1200 }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Trust Badge",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon", "default": "🌿" },
        { "type": "text", "id": "title", "label": "Title", "default": "100% Organic Origin" },
        { "type": "text", "id": "description", "label": "Description", "default": "Certified Nordic ingredients." }
      ]
    }
  ],
  "presets": [
    { "name": "HP44 - Sage Badges" }
  ]
}
{% endschema %}
