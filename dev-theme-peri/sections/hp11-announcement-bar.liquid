{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#CCFF00'
  assign text_color = section.settings.text_color | default: '#000000'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    color: {{ text_color }};
    border-bottom: 2px solid #000000;
  }
  
  .hp11-announcement-container-{{ section_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 12px 20px;
    min-height: 44px;
    text-align: center;
  }
  
  .hp11-announcement-text-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    margin: 0;
  }
  
  .hp11-announcement-text-{{ section_id }} a {
    color: {{ text_color }};
    text-decoration: none;
    border-bottom: 2px solid {{ text_color }};
    margin-left: 10px;
  }
  
  .hp11-announcement-text-{{ section_id }} a:hover {
    background: {{ text_color }};
    color: {{ bg_color }};
  }

@media screen and (max-width: 768px) {
  .hp11-announcement-bar {
    padding-left: 16px !important;
    padding-right: 16px !important;
    box-sizing: border-box !important;
  }
  img {
    max-width: 100% !important;
    height: auto !important;
  }
}

</style>

<div class="hp11-announcement-container-{{ section_id }}">
  <p class="hp11-announcement-text-{{ section_id }}">
    {{ section.settings.text | default: 'WORLDWIDE SHIPPING AVAILABLE' }}
    {% if section.settings.link != blank %}
      <a href="{{ section.settings.link }}">COP NOW</a>
    {% endif %}
  </p>
</div>

{% schema %}
{
  "name": "HP11 Announcement Bar",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#CCFF00"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Announcement Text",
      "default": "WORLDWIDE SHIPPING AVAILABLE"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link (Optional)"
    }
  ],
  "presets": [
    {
      "name": "HP11 Announcement Bar"
    }
  ]
}
{% endschema %}
