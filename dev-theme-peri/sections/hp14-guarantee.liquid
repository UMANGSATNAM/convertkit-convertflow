{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#f4f1de'
  assign text_color = section.settings.text_color | default: '#6b705c'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 80px 40px;
    border-bottom: 1px solid rgba(107, 112, 92, 0.1);
  }
  
  .hp14-guarantee-container-{{ section_id }} {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 40px;
  }
  
  .hp14-guarantee-item-{{ section_id }} {
    text-align: center;
    color: {{ text_color }};
  }
  
  .hp14-guarantee-icon-{{ section_id }} {
    margin-bottom: 20px;
    color: #cb997e;
  }
  
  .hp14-guarantee-icon-{{ section_id }} svg {
    width: 40px;
    height: 40px;
  }
  
  .hp14-guarantee-title-{{ section_id }} {
    font-family: 'Georgia', serif;
    font-size: 1.2rem;
    margin: 0 0 10px 0;
  }
  
  .hp14-guarantee-text-{{ section_id }} {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.9rem;
    color: #8a8d7a;
    line-height: 1.5;
    margin: 0;
  }

  @media (max-width: 992px) {
    .hp14-guarantee-container-{{ section_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 60px 20px;
    }
    .hp14-guarantee-container-{{ section_id }} {
      grid-template-columns: 1fr;
    }
  }
</style>

<div class="hp14-guarantee-container-{{ section_id }}">
  {% for block in section.blocks limit: 4 %}
    <div class="hp14-guarantee-item-{{ section_id }}" {{ block.shopify_attributes }}>
      <div class="hp14-guarantee-icon-{{ section_id }}">
        {% if block.settings.icon == 'shipping' %}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        {% elsif block.settings.icon == 'return' %}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
        {% elsif block.settings.icon == 'quality' %}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        {% else %}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/></svg>
        {% endif %}
      </div>
      <h3 class="hp14-guarantee-title-{{ section_id }}">{{ block.settings.title }}</h3>
      <p class="hp14-guarantee-text-{{ section_id }}">{{ block.settings.text }}</p>
    </div>
  {% endfor %}
</div>

{% schema %}
{
  "name": "HP14 Guarantee",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f4f1de"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#6b705c"
    }
  ],
  "blocks": [
    {
      "type": "guarantee",
      "name": "Guarantee Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shipping", "label": "Shipping" },
            { "value": "return", "label": "Return" },
            { "value": "quality", "label": "Quality" },
            { "value": "circle", "label": "Circle" }
          ],
          "default": "shipping"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Free Shipping"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "On all orders over $50."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP14 Guarantee",
      "blocks": [
        { "type": "guarantee", "settings": { "icon": "shipping", "title": "Free Shipping", "text": "On all orders over $50." } },
        { "type": "guarantee", "settings": { "icon": "quality", "title": "100% Organic", "text": "Ethically sourced ingredients." } },
        { "type": "guarantee", "settings": { "icon": "return", "title": "Easy Returns", "text": "30 days money back guarantee." } },
        { "type": "guarantee", "settings": { "icon": "circle", "title": "Secure Checkout", "text": "Your data is always protected." } }
      ]
    }
  ]
}
{% endschema %}
