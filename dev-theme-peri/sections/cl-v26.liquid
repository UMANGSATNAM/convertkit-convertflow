{% comment %} CL V26 — Winter Sports (Ice Blue) {% endcomment %}
{{ 'component-facets.css' | asset_url | stylesheet_tag }}
<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
<style>
  .clv26 { background: {{ section.settings.bg_color | default: '#F0F9FF' }}; color: {{ section.settings.text_color | default: '#0F172A' }}; padding: 60px 20px; font-family: 'Montserrat', sans-serif; }
  .clv26-hero { text-align: center; margin-bottom: 50px; background: #0284C7; color: #FFF; padding: 60px; border-radius: 12px; position: relative; overflow: hidden; }
  .clv26-hero::before { content: ''; position: absolute; top: -50px; left: -50px; width: 200px; height: 200px; background: rgba(255,255,255,0.1); border-radius: 50%; }
  .clv26-hero h1 { font-size: 46px; font-weight: 800; margin-bottom: 15px; text-transform: uppercase; letter-spacing: 1px; position: relative; z-index: 1; }
  .clv26-hero p { font-size: 16px; font-weight: 500; color: #E0F2FE; max-width: 600px; margin: 0 auto; position: relative; z-index: 1; }
  .clv26-chips { display: flex; gap: 12px; justify-content: center; margin-bottom: 40px; flex-wrap: wrap; }
  .clv26-chips a { padding: 10px 22px; background: #FFF; color: #0284C7; text-decoration: none; font-size: 14px; font-weight: 700; border-radius: 30px; box-shadow: 0 4px 6px rgba(2,132,199,0.1); transition: 0.3s; text-transform: uppercase; border: 1px solid transparent; }
  .clv26-chips a:hover, .clv26-chips a.active { background: #0284C7; color: #FFF; box-shadow: 0 6px 12px rgba(2,132,199,0.2); }
  .clv26-toolbar { background: #FFF; border-radius: 12px; padding: 20px; margin-bottom: 40px; box-shadow: 0 4px 15px rgba(2,132,199,0.05); border: 1px solid #E0F2FE; }
  .clv26-grid { display: grid; grid-template-columns: repeat({{ section.settings.cols_desktop | default: 4 }}, 1fr); gap: 24px; }
  .clv26-promo { grid-column: span 1; background: #38BDF8; color: #FFF; border-radius: 12px; padding: 40px; text-align: center; display: flex; flex-direction: column; justify-content: center; box-shadow: 0 10px 20px rgba(56,189,248,0.2); }
  .clv26-promo h3 { font-size: 26px; font-weight: 800; margin-bottom: 20px; text-transform: uppercase; }
  .clv26-promo a { display: inline-block; padding: 12px 24px; background: #FFF; color: #0284C7; font-weight: 700; border-radius: 30px; text-decoration: none; font-size: 14px; text-transform: uppercase; }
  .clv26-seo { margin-top: 60px; background: #FFF; border-radius: 12px; padding: 50px; text-align: center; border: 1px solid #E0F2FE; box-shadow: 0 10px 25px rgba(2,132,199,0.05); }
  @media (max-width: 768px) { .clv26-grid { grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr); gap: 16px; } .clv26-hero h1 { font-size: 36px; } }
</style>
<div class="clv26" style="max-width: 1300px; margin: 0 auto;">
  <div class="clv26-hero">
    <h1>{% if collection.title != blank %}{{ collection.title | escape }}{% else %}ALPINE SERIES{% endif %}</h1>
    <p>{% if collection.description != blank %}{{ collection.description }}{% else %}Conquer the mountain with gear that refuses to freeze.{% endif %}</p>
  </div>
  {% if section.settings.sub_collections != blank %}
    <div class="clv26-chips">
      {% for link in section.settings.sub_collections.links %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% endfor %}
    </div>
  {% endif %}
  <div class="clv26-toolbar">
    <facet-filters-form style="width: 100%;">
      <form id="FacetFiltersForm" style="display: flex; justify-content: space-between; align-items: center; width: 100%; flex-wrap: wrap; gap: 20px;">
        <div style="display: flex; gap: 15px;">
          {%- for filter in collection.filters -%}
            <details style="position: relative;">
              <summary style="cursor: pointer; font-size: 14px; font-weight: 700; color: #0284C7; text-transform: uppercase;">{{ filter.label }} 🏔️</summary>
              <div style="position: absolute; background: #FFF; border: 1px solid #E0F2FE; padding: 20px; border-radius: 8px; z-index: 10; margin-top: 15px; min-width: 220px; box-shadow: 0 10px 30px rgba(2,132,199,0.1);">
                {%- for value in filter.values -%}
                  <label style="display: block; margin-bottom: 12px; cursor: pointer; font-size: 14px; color: #0F172A; font-weight: 500;">
                    <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %}>
                    {{ value.label }} ({{ value.count }})
                  </label>
                {%- endfor -%}
              </div>
            </details>
          {%- endfor -%}
        </div>
        <select name="sort_by" onchange="this.form.submit()" style="background: #F0F9FF; border: 1px solid #BAE6FD; padding: 10px 20px; border-radius: 30px; font-size: 14px; font-weight: 700; color: #0284C7; cursor: pointer; text-transform: uppercase;">
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>Sort: {{ option.name }}</option>
          {%- endfor -%}
        </select>
      </form>
    </facet-filters-form>
  </div>
  {% assign limit_num = section.settings.products_per_page | default: 16 %}
  {% paginate collection.products by limit_num %}
    <div class="clv26-grid">
      {% for product in collection.products %}
        {% render 'card-v26', product: product %}
        {% if forloop.index == 8 and section.settings.show_promo_tile %}
          <div class="clv26-promo">
            <h3>Stay<br>Warm</h3>
            <a href="/collections/baselayers">Shop Layers</a>
          </div>
        {% endif %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v26', product: nil %}
        {% endfor %}
      {% endfor %}
    </div>
    <div style="margin-top: 50px; text-align: center; color: #0284C7; font-weight: 700;">{{ paginate | default_pagination }}</div>
  {% endpaginate %}
  {% if section.settings.show_seo_block %}
    <div class="clv26-seo">
      <h2 style="font-size: 28px; font-weight: 800; color: #0284C7; margin-bottom: 15px; text-transform: uppercase;">{{ section.settings.seo_title | default: 'Defy the Elements' }}</h2>
      <p style="font-size: 15px; color: #475569; max-width: 700px; margin: 0 auto; line-height: 1.7; font-weight: 500;">{{ section.settings.seo_text | default: 'Tested in the harshest conditions to guarantee warmth, mobility, and breathability when you need it most.' }}</p>
    </div>
  {% endif %}
</div>
{% schema %}
{
  "name": "CL V26 — Winter", "settings": [
    {"type": "range", "id": "products_per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 16},
    {"type": "range", "id": "cols_desktop", "label": "Desktop Columns", "min": 2, "max": 5, "default": 4},
    {"type": "select", "id": "cols_mobile", "label": "Mobile Columns", "options": [{"value": "1", "label": "1"}, {"value": "2", "label": "2"}], "default": "2"},
    {"type": "link_list", "id": "sub_collections", "label": "Sub-Collection Menu"},
    {"type": "checkbox", "id": "show_promo_tile", "label": "Show Promo Card", "default": true},
    {"type": "checkbox", "id": "show_seo_block", "label": "Show SEO Block", "default": true},
    {"type": "color", "id": "bg_color", "label": "Background Color", "default": "#F0F9FF"},
    {"type": "color", "id": "text_color", "label": "Text Color", "default": "#0F172A"}
  ], "presets": [{"name": "CL V26 — Winter"}]
}
{% endschema %}
