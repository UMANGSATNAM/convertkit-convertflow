{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#FF00FF'
  assign text_color = section.settings.text_color | default: '#FFFFFF'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    color: {{ text_color }};
    padding: 12px 20px;
    text-align: center;
    position: relative;
    z-index: 100;
    border-bottom: 3px solid #000;
  }
  
  .hp16-announcement-{{ section_id }} {
    font-family: 'Comic Sans MS', 'Chalkboard SE', 'Comic Neue', sans-serif;
    font-size: 1rem;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin: 0;
    text-shadow: 2px 2px 0px #000;
    animation: hp16-blink-{{ section_id }} 2s infinite;
  }
  
  .hp16-announcement-{{ section_id }} a {
    color: {{ text_color }};
    text-decoration: underline;
    text-decoration-style: wavy;
    text-decoration-color: #00FFFF;
  }
  
  .hp16-announcement-{{ section_id }} a:hover {
    color: #00FFFF;
  }
  
  @keyframes hp16-blink-{{ section_id }} {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.8; transform: scale(1.02); }
  }

@media screen and (max-width: 768px) {
  .hp16-announcement-bar {
    padding-left: 16px !important;
    padding-right: 16px !important;
    box-sizing: border-box !important;
  }
  img {
    max-width: 100% !important;
    height: auto !important;
  }
}

</style>

<div class="hp16-announcement-{{ section_id }}">
  <span class="hp16-star">✨</span> {{ section.settings.text | default: 'FREE SHIPPING ON ORDERS $50+ <a href="#">SHOP NOW</a>' }} <span class="hp16-star">✨</span>
</div>

{% schema %}
{
  "name": "HP16 Announcement Bar",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FF00FF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "html",
      "id": "text",
      "label": "Announcement Text",
      "default": "FREE SHIPPING ON ORDERS $50+ <a href=\"#\">SHOP NOW</a>"
    }
  ],
  "presets": [
    {
      "name": "HP16 Announcement Bar"
    }
  ]
}
{% endschema %}
