{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp45-trust-bg: {{ section.settings.bg_color | default: '#0A0A0A' }};
    --hp45-trust-text: {{ section.settings.text_color | default: '#FFFFFF' }};
    
    background-color: var(--hp45-trust-bg);
    color: var(--hp45-trust-text);
    padding: {{ section.settings.padding_vertical | default: 45 }}px 0;
    border-top: 2px solid #0A0A0A;
  }

  .hp45-trust__grid {
    max-width: {{ section.settings.container_width | default: 1300 }}px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: 4 }}, 1fr);
    gap: 24px;
    text-align: center;
  }

  .hp45-trust__box {
    border: 1px solid #333333;
    padding: 24px 18px;
    background: #111111;
  }

  .hp45-trust__title {
    font-size: 15px;
    font-weight: 700;
    text-transform: uppercase;
    margin: 0 0 6px;
  }

  .hp45-trust__desc {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: #888888;
    margin: 0;
  }

  @media screen and (max-width: 992px) {
    .hp45-trust__grid { grid-template-columns: repeat(2, 1fr); }
  }
{%- endstyle -%}

<div class="hp45-trust__grid">
  {%- if section.blocks.size > 0 -%}
    {%- for block in section.blocks -%}
      <div class="hp45-trust__box" {{ block.shopify_attributes }}>
        <h4 class="hp45-trust__title">{{ block.settings.title }}</h4>
        <p class="hp45-trust__desc">{{ block.settings.description }}</p>
      </div>
    {%- endfor -%}
  {%- else -%}
    <div class="hp45-trust__box">
      <h4 class="hp45-trust__title">[PROTOCOL TESTED]</h4>
      <p class="hp45-trust__desc">Zero toxic additives or phthalates.</p>
    </div>
    <div class="hp45-trust__box">
      <h4 class="hp45-trust__title">[AIR DDP PRE-PAID]</h4>
      <p class="hp45-trust__desc">Pre-cleared customs in 180 nations.</p>
    </div>
    <div class="hp45-trust__box">
      <h4 class="hp45-trust__title">[REPLACEMENT ACCORD]</h4>
      <p class="hp45-trust__desc">30-day efficacy trial coverage.</p>
    </div>
    <div class="hp45-trust__box">
      <h4 class="hp45-trust__title">[256-BIT ENCRYPTION]</h4>
      <p class="hp45-trust__desc">Zero-storage payment security.</p>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "HP45 - Brutal Badges",
  "class": "section-hp45-badges",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#0A0A0A" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#FFFFFF" },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "label": "Desktop Columns", "default": 4 },
    { "type": "range", "id": "padding_vertical", "min": 20, "max": 80, "step": 5, "unit": "px", "label": "Vertical Padding", "default": 45 },
    { "type": "range", "id": "container_width", "min": 800, "max": 1400, "step": 20, "unit": "px", "label": "Container Width", "default": 1300 }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "[PROTOCOL TESTED]" },
        { "type": "text", "id": "description", "label": "Description", "default": "Zero toxic additives or phthalates." }
      ]
    }
  ],
  "presets": [
    { "name": "HP45 - Brutal Badges" }
  ]
}
{% endschema %}
