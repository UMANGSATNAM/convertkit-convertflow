{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#f7f4ed'
  assign text_color = section.settings.text_color | default: '#2b302a'
  assign accent_color = section.settings.accent_color | default: '#4a6741'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 100px 20px;
    color: {{ text_color }};
  }
  
  .hp7-bento-container-{{ section_id }} {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-auto-rows: minmax(300px, auto);
    gap: 20px;
  }
  
  .hp7-bento-item-{{ section_id }} {
    position: relative;
    border-radius: 40px; /* Soft eco borders */
    overflow: hidden;
    background-color: #ffffff;
    padding: 40px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    text-decoration: none;
    color: {{ text_color }};
    transition: transform 0.4s ease, box-shadow 0.4s ease;
  }
  
  .hp7-bento-item-{{ section_id }}:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 40px rgba(74, 103, 65, 0.08);
  }
  
  /* Large main tile */
  .hp7-bento-main-{{ section_id }} {
    grid-column: span 8;
    grid-row: span 2;
    padding: 0;
  }
  
  .hp7-bento-main-{{ section_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.5s ease;
  }
  
  .hp7-bento-main-{{ section_id }}:hover img {
    transform: scale(1.03);
  }
  
  .hp7-bento-main-overlay-{{ section_id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    padding: 60px 50px 50px 50px;
    background: linear-gradient(to top, rgba(0,0,0,0.6) 0%, rgba(0,0,0,0) 100%);
    color: #ffffff;
  }
  
  /* Small info tiles */
  .hp7-bento-info-{{ section_id }} {
    grid-column: span 4;
    background-color: {{ accent_color }};
    color: #ffffff;
    align-items: flex-start;
  }
  
  .hp7-bento-info-alt-{{ section_id }} {
    grid-column: span 4;
    background-color: #e8ecd6;
    color: {{ accent_color }};
  }
  
  /* Half tiles */
  .hp7-bento-half-{{ section_id }} {
    grid-column: span 6;
    padding: 0;
  }
  
  .hp7-bento-half-{{ section_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .hp7-bento-half-content-{{ section_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 40px;
    background: rgba(0,0,0,0.2);
    color: #fff;
  }
  
  .hp7-bento-heading-{{ section_id }} {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2rem, 3vw, 2.5rem);
    font-weight: 500;
    margin: 0 0 15px 0;
    line-height: 1.1;
  }
  
  .hp7-bento-subheading-{{ section_id }} {
    font-family: 'DM Sans', sans-serif;
    font-size: 1.1rem;
    margin: 0 0 20px 0;
    opacity: 0.9;
  }
  
  .hp7-bento-btn-{{ section_id }} {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: 'DM Sans', sans-serif;
    font-weight: 700;
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    text-decoration: none;
    color: inherit;
    position: relative;
  }
  
  .hp7-bento-btn-{{ section_id }} svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    transition: transform 0.3s ease;
  }
  
  .hp7-bento-item-{{ section_id }}:hover .hp7-bento-btn-{{ section_id }} svg {
    transform: translateX(5px);
  }

  @media (max-width: 992px) {
    .hp7-bento-main-{{ section_id }} { grid-column: span 12; }
    .hp7-bento-info-{{ section_id }} { grid-column: span 6; }
    .hp7-bento-info-alt-{{ section_id }} { grid-column: span 6; }
  }
  
  @media (max-width: 768px) {
    .hp7-bento-info-{{ section_id }},
    .hp7-bento-info-alt-{{ section_id }},
    .hp7-bento-half-{{ section_id }} {
      grid-column: span 12;
    }
    .hp7-bento-main-overlay-{{ section_id }},
    .hp7-bento-half-content-{{ section_id }} {
      padding: 30px;
    }
  }
</style>

<div class="hp7-bento-container-{{ section_id }}">
  <!-- Block 1: Main Feature -->
  <a href="#" class="hp7-bento-item-{{ section_id }} hp7-bento-main-{{ section_id }}">
    {% if section.settings.image_main != blank %}
      <img src="{{ section.settings.image_main | image_url: width: 1200 }}" alt="Main Feature" loading="lazy" width="800" height="600">
    {% else %}
      <div style="width:100%; height:100%; background: #e0ddd5;"></div>
    {% endif %}
    <div class="hp7-bento-main-overlay-{{ section_id }}">
      <h2 class="hp7-bento-heading-{{ section_id }}">{{ section.settings.main_title | default: 'The Autumn Collection' }}</h2>
      <p class="hp7-bento-subheading-{{ section_id }}">{{ section.settings.main_text | default: 'Made from 100% recycled fibers.' }}</p>
      <span class="hp7-bento-btn-{{ section_id }}">Explore <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
    </div>
  </a>
  
  <!-- Block 2: Info Block 1 -->
  <a href="#" class="hp7-bento-item-{{ section_id }} hp7-bento-info-{{ section_id }}">
    <h3 class="hp7-bento-heading-{{ section_id }}" style="font-size: 2rem;">{{ section.settings.info_title | default: 'Our Impact' }}</h3>
    <p class="hp7-bento-subheading-{{ section_id }}">{{ section.settings.info_text | default: 'We have planted over 10,000 trees this year alone.' }}</p>
    <span class="hp7-bento-btn-{{ section_id }}" style="margin-top: auto;">Learn More <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
  </a>
  
  <!-- Block 3: Info Block 2 -->
  <a href="#" class="hp7-bento-item-{{ section_id }} hp7-bento-info-alt-{{ section_id }}">
    <h3 class="hp7-bento-heading-{{ section_id }}" style="font-size: 2rem;">{{ section.settings.info2_title | default: 'Transparency' }}</h3>
    <p class="hp7-bento-subheading-{{ section_id }}">{{ section.settings.info2_text | default: 'Trace every garment back to its source.' }}</p>
    <span class="hp7-bento-btn-{{ section_id }}" style="margin-top: auto;">Supply Chain <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
  </a>
  
  <!-- Block 4: Half Feature -->
  <a href="#" class="hp7-bento-item-{{ section_id }} hp7-bento-half-{{ section_id }}">
    {% if section.settings.image_half != blank %}
      <img src="{{ section.settings.image_half | image_url: width: 800 }}" alt="Half Feature" loading="lazy" width="600" height="400">
    {% else %}
      <div style="width:100%; height:100%; background: #ccc;"></div>
    {% endif %}
    <div class="hp7-bento-half-content-{{ section_id }}">
      <h3 class="hp7-bento-heading-{{ section_id }}">{{ section.settings.half_title | default: 'New Accessories' }}</h3>
      <span class="hp7-bento-btn-{{ section_id }}">Shop Now <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
    </div>
  </a>
</div>

{% schema %}
{
  "name": "HP7 Bento Grid",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f7f4ed"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2b302a"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#4a6741"
    },
    {
      "type": "image_picker",
      "id": "image_main",
      "label": "Main Feature Image"
    },
    {
      "type": "text",
      "id": "main_title",
      "label": "Main Title",
      "default": "The Autumn Collection"
    },
    {
      "type": "text",
      "id": "main_text",
      "label": "Main Subtext",
      "default": "Made from 100% recycled fibers."
    },
    {
      "type": "text",
      "id": "info_title",
      "label": "Info 1 Title",
      "default": "Our Impact"
    },
    {
      "type": "textarea",
      "id": "info_text",
      "label": "Info 1 Text",
      "default": "We have planted over 10,000 trees this year alone."
    },
    {
      "type": "text",
      "id": "info2_title",
      "label": "Info 2 Title",
      "default": "Transparency"
    },
    {
      "type": "textarea",
      "id": "info2_text",
      "label": "Info 2 Text",
      "default": "Trace every garment back to its source."
    },
    {
      "type": "image_picker",
      "id": "image_half",
      "label": "Secondary Image"
    },
    {
      "type": "text",
      "id": "half_title",
      "label": "Secondary Title",
      "default": "New Accessories"
    }
  ],
  "presets": [
    {
      "name": "HP7 Bento Grid"
    }
  ]
}
{% endschema %}
