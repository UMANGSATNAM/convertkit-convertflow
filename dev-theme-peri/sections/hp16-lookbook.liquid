{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#FFFF00'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 100px 40px;
    border-bottom: 4px solid #000;
  }
  
  .hp16-lookbook-container-{{ section_id }} {
    max-width: 1200px;
    margin: 0 auto;
    position: relative;
    border: 4px solid #000;
    border-radius: 30px;
    overflow: hidden;
    box-shadow: 15px 15px 0 #FF00FF;
    background: #FFF;
  }
  
  .hp16-lookbook-image-{{ section_id }} {
    width: 100%;
    height: auto;
    display: block;
  }
  
  .hp16-lookbook-hotspot-{{ section_id }} {
    position: absolute;
    width: 40px;
    height: 40px;
    background: #00FFFF;
    border: 3px solid #000;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transform: translate(-50%, -50%);
    cursor: pointer;
    box-shadow: 3px 3px 0 #000;
    transition: all 0.2s ease;
    z-index: 2;
  }
  
  .hp16-lookbook-hotspot-{{ section_id }}:hover {
    background: #FFF;
    transform: translate(-50%, -50%) scale(1.1);
  }
  
  .hp16-lookbook-hotspot-{{ section_id }} svg {
    width: 20px;
    height: 20px;
  }
  
  .hp16-lookbook-tooltip-{{ section_id }} {
    position: absolute;
    bottom: calc(100% + 15px);
    left: 50%;
    transform: translateX(-50%);
    background: #FFF;
    border: 3px solid #000;
    border-radius: 10px;
    padding: 10px 15px;
    white-space: nowrap;
    font-family: 'Comic Sans MS', cursive;
    font-size: 0.9rem;
    font-weight: bold;
    color: #000;
    box-shadow: 4px 4px 0 #FF00FF;
    opacity: 0;
    visibility: hidden;
    transition: all 0.2s ease;
    text-transform: uppercase;
  }
  
  .hp16-lookbook-tooltip-{{ section_id }}::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 50%;
    margin-left: -8px;
    border-width: 8px;
    border-style: solid;
    border-color: #000 transparent transparent transparent;
  }
  
  .hp16-lookbook-hotspot-{{ section_id }}:hover .hp16-lookbook-tooltip-{{ section_id }} {
    opacity: 1;
    visibility: visible;
    bottom: calc(100% + 20px);
  }
  
  .hp16-lookbook-title-{{ section_id }} {
    position: absolute;
    top: 30px;
    left: 30px;
    background: #FF00FF;
    color: #FFF;
    border: 3px solid #000;
    padding: 10px 20px;
    font-family: 'Arial Black', sans-serif;
    font-size: 2rem;
    text-transform: uppercase;
    box-shadow: 5px 5px 0 #000;
    transform: rotate(-3deg);
    z-index: 1;
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 60px 20px;
    }
    .hp16-lookbook-title-{{ section_id }} {
      font-size: 1.2rem;
      top: 15px; left: 15px;
    }
    .hp16-lookbook-hotspot-{{ section_id }} {
      width: 30px; height: 30px;
    }
    .hp16-lookbook-hotspot-{{ section_id }} svg {
      width: 15px; height: 15px;
    }
  }
</style>

<div class="hp16-lookbook-container-{{ section_id }}">
  <div class="hp16-lookbook-title-{{ section_id }}">{{ section.settings.title | default: 'SHOP THE LOOK' }}</div>
  
  {% if section.settings.image != blank %}
    <img height="{{ section.settings.image.height }}" width="{{ section.settings.image.width }}" src="{{ section.settings.image | image_url: width: 1200 }}" class="hp16-lookbook-image-{{ section_id }}" loading="lazy" alt="Lookbook">
  {% else %}
    <div class="hp16-lookbook-image-{{ section_id }}" style="background: repeating-linear-gradient(45deg, #EFEFEF, #EFEFEF 12px, #E6E6E6 12px, #E6E6E6 24px); height: 700px;"></div>
  {% endif %}
  
  {% for block in section.blocks %}
    <a href="{{ block.settings.product_url | default: '#' }}" class="hp16-lookbook-hotspot-{{ section_id }}" style="top: {{ block.settings.top }}%; left: {{ block.settings.left }}%;" {{ block.shopify_attributes }}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
      <div class="hp16-lookbook-tooltip-{{ section_id }}">{{ block.settings.product_name | default: 'View Product' }}</div>
    </a>
  {% endfor %}
</div>

{% schema %}
{
  "name": "HP16 Lookbook",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFF00"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "SHOP THE LOOK"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Lookbook Image"
    }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "Hotspot",
      "settings": [
        {
          "type": "range",
          "id": "top",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Top Position",
          "default": 50
        },
        {
          "type": "range",
          "id": "left",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Left Position",
          "default": 50
        },
        {
          "type": "text",
          "id": "product_name",
          "label": "Product Name",
          "default": "Velour Top"
        },
        {
          "type": "url",
          "id": "product_url",
          "label": "Product Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP16 Lookbook",
      "blocks": [
        { "type": "hotspot", "settings": { "top": 30, "left": 40, "product_name": "TINTED SHADES" } },
        { "type": "hotspot", "settings": { "top": 60, "left": 55, "product_name": "MINI SKIRT" } }
      ]
    }
  ]
}
{% endschema %}
