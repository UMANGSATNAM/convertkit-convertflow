{%- liquid
  assign sec_id = section.id
  assign bg_color = section.settings.bg_color
  assign text_color = section.settings.text_color
  assign accent_color = section.settings.accent_color
  assign border_color = section.settings.border_color
  assign border_width = section.settings.border_width
  assign shadow_color = section.settings.shadow_color
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
  assign title = section.settings.title
  assign text = section.settings.text
  assign badge = section.settings.badge
  assign btn_text = section.settings.btn_text
  assign btn_link = section.settings.btn_link
  assign hero_image = section.settings.hero_image
  assign layout_style = section.settings.layout_style
-%}

<style>
  .hp18-hero-{{ sec_id }} {
    background-color: {{ bg_color }};
    padding-top: {{ padding_top }}px;
    padding-bottom: {{ padding_bottom }}px;
    border-bottom: {{ border_width }}px solid {{ border_color }};
    overflow: hidden;
  }

  .hp18-hero-{{ sec_id }}__container {
    max-width: var(--page-width, 1440px);
    margin: 0 auto;
    padding: 0 40px;
    display: grid;
    gap: 40px;
    align-items: center;
    min-height: clamp(600px, 80vh, 900px);
    
    {% if layout_style == 'split_right' %}
      grid-template-columns: 1fr 1fr;
    {% elsif layout_style == 'split_left' %}
      grid-template-columns: 1fr 1fr;
      direction: rtl;
    {% else %}
      grid-template-columns: 1fr;
      text-align: center;
    {% endif %}
  }

  .hp18-hero-{{ sec_id }}__content {
    {% if layout_style == 'split_left' %}
      direction: ltr;
      padding-left: 40px;
    {% elsif layout_style == 'split_right' %}
      padding-right: 40px;
    {% else %}
      display: flex;
      flex-direction: column;
      align-items: center;
      max-width: 900px;
      margin: 0 auto;
    {% endif %}
    z-index: 2;
  }

  .hp18-hero-{{ sec_id }}__badge {
    display: inline-block;
    background-color: {{ accent_color }};
    color: {{ border_color }};
    border: {{ border_width }}px solid {{ border_color }};
    padding: 10px 20px;
    font-family: 'Courier New', monospace;
    font-weight: bold;
    text-transform: uppercase;
    margin-bottom: 30px;
    font-size: 16px;
    box-shadow: 4px 4px 0px {{ shadow_color }};
    transform: rotate(-2deg);
    transition: transform 0.2s ease;
  }

  .hp18-hero-{{ sec_id }}__badge:hover {
    transform: rotate(0deg) scale(1.05);
  }

  .hp18-hero-{{ sec_id }}__title {
    font-family: 'Arial Black', Impact, sans-serif;
    font-size: clamp(48px, 8vw, 120px);
    line-height: 0.9;
    color: {{ text_color }};
    text-transform: uppercase;
    margin: 0 0 30px 0;
    letter-spacing: -2px;
  }

  .hp18-hero-{{ sec_id }}__title strong {
    color: {{ accent_color }};
    text-shadow: 4px 4px 0px {{ shadow_color }};
    -webkit-text-stroke: 1px {{ border_color }};
  }

  .hp18-hero-{{ sec_id }}__text {
    font-family: 'Courier New', monospace;
    font-size: clamp(16px, 2vw, 20px);
    line-height: 1.6;
    color: {{ text_color }};
    margin: 0 0 40px 0;
    font-weight: bold;
    max-width: 600px;
  }

  .hp18-hero-{{ sec_id }}__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: {{ border_color }};
    color: {{ bg_color }};
    border: {{ border_width }}px solid {{ border_color }};
    padding: 20px 48px;
    font-family: 'Arial Black', sans-serif;
    font-size: 20px;
    text-transform: uppercase;
    text-decoration: none;
    box-shadow: 8px 8px 0px {{ accent_color }};
    transition: all 0.1s ease;
    position: relative;
    overflow: hidden;
  }

  .hp18-hero-{{ sec_id }}__btn::before {
    content: '';
    position: absolute;
    top: 0; left: -100%; width: 100%; height: 100%;
    background: {{ text_color }};
    transition: left 0.3s ease;
    z-index: 1;
  }

  .hp18-hero-{{ sec_id }}__btn:hover::before {
    left: 0;
  }

  .hp18-hero-{{ sec_id }}__btn span {
    position: relative;
    z-index: 2;
  }

  .hp18-hero-{{ sec_id }}__btn:active {
    box-shadow: 0px 0px 0px {{ accent_color }};
    transform: translate(8px, 8px);
  }

  .hp18-hero-{{ sec_id }}__image-col {
    {% if layout_style == 'split_left' %}
      direction: ltr;
    {% endif %}
    height: 100%;
    min-height: 600px;
    position: relative;
    z-index: 1;
  }

  .hp18-hero-{{ sec_id }}__image-wrapper {
    position: relative;
    border: {{ border_width | plus: 2 }}px solid {{ border_color }};
    box-shadow: 16px 16px 0px {{ shadow_color }};
    background-color: #ffffff;
    height: 100%;
    width: 100%;
    overflow: hidden;
    {% if layout_style == 'center' %}
      max-width: 1000px;
      margin: 0 auto;
      height: 600px;
    {% endif %}
  }

  .hp18-hero-{{ sec_id }}__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: contrast(1.1) grayscale(0.2);
    transition: transform 0.5s ease;
  }

  .hp18-hero-{{ sec_id }}__image-wrapper:hover .hp18-hero-{{ sec_id }}__image {
    transform: scale(1.05);
  }

  .hp18-hero-{{ sec_id }}__floating-elements {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    pointer-events: none;
    z-index: 3;
  }

  .hp18-hero-{{ sec_id }}__sticker {
    position: absolute;
    background: {{ text_color }};
    color: {{ bg_color }};
    font-family: 'Arial Black', sans-serif;
    padding: 10px 15px;
    border: 3px solid {{ border_color }};
    text-transform: uppercase;
    font-size: 14px;
    box-shadow: 4px 4px 0px {{ accent_color }};
    animation: hp18-float 6s ease-in-out infinite;
  }

  @keyframes hp18-float {
    0%, 100% { transform: translateY(0) rotate(-5deg); }
    50% { transform: translateY(-15px) rotate(5deg); }
  }

  @media (max-width: 992px) {
    .hp18-hero-{{ sec_id }}__container {
      grid-template-columns: 1fr;
      padding: 0 20px;
      direction: ltr;
      text-align: center;
      gap: 30px;
    }
    .hp18-hero-{{ sec_id }}__content { 
      padding: 0; 
      align-items: center;
    }
    .hp18-hero-{{ sec_id }}__image-col,
    .hp18-hero-{{ sec_id }}__image-wrapper { 
      min-height: 400px; 
      height: 400px;
    }
    .hp18-hero-{{ sec_id }}__btn {
      width: 100%;
    }
    .hp18-hero-{{ sec_id }}__sticker { display: none; }
  }
</style>

<section class="hp18-hero-{{ sec_id }}">
  <div class="hp18-hero-{{ sec_id }}__container">
    
    <div class="hp18-hero-{{ sec_id }}__content">
      {% if badge != blank %}
        <div class="hp18-hero-{{ sec_id }}__badge">{{ badge }}</div>
      {% endif %}
      
      <h1 class="hp18-hero-{{ sec_id }}__title">
        {{ title }}
      </h1>
      
      {% if text != blank %}
        <p class="hp18-hero-{{ sec_id }}__text">
          {{ text | newline_to_br }}
        </p>
      {% endif %}
      
      {% if btn_text != blank and btn_link != blank %}
        <a href="{{ btn_link }}" class="hp18-hero-{{ sec_id }}__btn">
          <span>{{ btn_text }}</span>
        </a>
      {% endif %}
    </div>

    <div class="hp18-hero-{{ sec_id }}__image-col">
      <div class="hp18-hero-{{ sec_id }}__image-wrapper">
        {% if hero_image != blank %}
          {% capture tmp_class %}hp18-hero-{{ sec_id }}__image{% endcapture %}{{ hero_image | image_url: width: 2000  | image_tag: class: tmp_class, loading: 'eager', sizes: '100vw'  }}
        {% else %}
          {% capture tmp_class %}hp18-hero-{{ sec_id }}__image{% endcapture %}{{ 'lifestyle-2'  | placeholder_svg_tag: tmp_class }}
        {% endif %}
        
        <!-- Interactive Stickers configured via blocks -->
        <div class="hp18-hero-{{ sec_id }}__floating-elements">
          {% for block in section.blocks %}
            {% if block.type == 'sticker' %}
              <div class="hp18-hero-{{ sec_id }}__sticker" style="top: {{ block.settings.pos_y }}%; left: {{ block.settings.pos_x }}%; animation-delay: {{ forloop.index | times: 0.5 }}s;">
                {{ block.settings.text }}
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "HP18 Advanced Hero",
  "settings": [
    {
      "type": "header",
      "content": "Color Settings"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f4f4f0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#CCFF00"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "shadow_color",
      "label": "Shadow Color",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layout Style",
      "options": [
        { "value": "split_right", "label": "Image Right" },
        { "value": "split_left", "label": "Image Left" },
        { "value": "center", "label": "Stacked Center" }
      ],
      "default": "split_right"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "Border Width",
      "default": 3
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 10,
      "unit": "px",
      "label": "Padding Top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 10,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 80
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge Text",
      "default": "SEASON 04"
    },
    {
      "type": "html",
      "id": "title",
      "label": "Title",
      "info": "Wrap words in <strong> tags to apply accent color.",
      "default": "RULE THE <strong>STREETS</strong>"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Subtitle Text",
      "default": "LOUD DESIGNS. UNCOMPROMISING QUALITY.\nWEAR YOUR REBELLION."
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "SHOP THE DROP"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image"
    }
  ],
  "blocks": [
    {
      "type": "sticker",
      "name": "Floating Sticker",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Sticker Text",
          "default": "NEW DROP"
        },
        {
          "type": "range",
          "id": "pos_x",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Position X (Left)",
          "default": 10
        },
        {
          "type": "range",
          "id": "pos_y",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Position Y (Top)",
          "default": 20
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP18 Advanced Hero",
      "blocks": [
        {
          "type": "sticker",
          "settings": {
            "text": "LIMITED",
            "pos_x": 10,
            "pos_y": 15
          }
        },
        {
          "type": "sticker",
          "settings": {
            "text": "🔥 HOT",
            "pos_x": 80,
            "pos_y": 70
          }
        }
      ]
    }
  ]
}
{% endschema %}
