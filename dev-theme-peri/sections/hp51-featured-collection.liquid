{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp51-fc-bg: {{ section.settings.bg_color | default: '#F2EFE9' }};
    --hp51-fc-card: {{ section.settings.card_bg | default: '#FAF8F5' }};
    --hp51-fc-title: {{ section.settings.title_color | default: '#1E3A2B' }};
    --hp51-matcha: {{ section.settings.accent_matcha | default: '#2D5A3D' }};
    
    background-color: var(--hp51-fc-bg);
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }

  .hp51-fc__wrapper {
    max-width: {{ section.settings.container_width | default: 1280 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp51-fc__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 45px;
  }

  .hp51-fc__heading {
    font-family: 'Noto Serif JP', serif;
    font-size: clamp(32px, 4.5vw, 44px);
    font-weight: 700;
    color: var(--hp51-fc-title);
    margin: 0;
  }

  .hp51-fc__view-all {
    color: var(--hp51-matcha);
    font-family: 'DM Sans', sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .hp51-fc__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: 4 }}, 1fr);
    gap: 24px;
  }

  .hp51-card {
    background: var(--hp51-fc-card);
    border: 1px solid rgba(30, 58, 43, 0.12);
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 10px 30px rgba(30, 58, 43, 0.04);
    transition: all 0.3s ease;
  }

  .hp51-card:hover {
    border-color: var(--hp51-matcha);
    transform: translateY(-6px);
    box-shadow: 0 18px 45px rgba(30, 58, 43, 0.1);
  }

  .hp51-card__media {
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    position: relative;
    background: #E3DDD3;
  }

  .hp51-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .hp51-card:hover .hp51-card__img { transform: scale(1.04); }

  .hp51-card__badge {
    position: absolute;
    top: 12px; left: 12px;
    background: #1E3A2B;
    color: #FAF8F5;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 4px 12px;
    border-radius: 50px;
  }

  .hp51-card__body {
    padding: 22px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .hp51-card__tag {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--hp51-matcha);
    text-transform: uppercase;
    margin: 0 0 6px;
  }

  .hp51-card__title {
    font-family: 'Noto Serif JP', serif;
    font-size: 17px;
    font-weight: 700;
    color: var(--hp51-fc-title);
    margin: 0 0 8px;
  }

  .hp51-card__price {
    font-size: 16px;
    font-weight: 700;
    color: var(--hp51-matcha);
    margin-bottom: 16px;
  }

  .hp51-card__btn {
    width: 100%;
    margin-top: auto;
    padding: 13px;
    background: #1E3A2B;
    color: #FAF8F5;
    border: none;
    border-radius: 50px;
    font-family: 'DM Sans', sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .hp51-card__btn:hover { background: var(--hp51-matcha); }

  @media screen and (max-width: 992px) {
    .hp51-fc__grid { grid-template-columns: repeat(2, 1fr); gap: 16px; }
  }
{%- endstyle -%}

<div class="hp51-fc__wrapper">
  <div class="hp51-fc__header">
    <h2 class="hp51-fc__heading">{{ section.settings.heading | default: 'The Kyoto Matcha & Bamboo Collection' }}</h2>
    <a href="{{ section.settings.view_all_url | default: '/collections/all' }}" class="hp51-fc__view-all">
      {{ section.settings.view_all_text | default: 'View All Formulations →' }}
    </a>
  </div>

  <div class="hp51-fc__grid">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <div class="hp51-card" {{ block.shopify_attributes }}>
          <div class="hp51-card__media">
            {%- if block.settings.badge != blank -%}
              <span class="hp51-card__badge">{{ block.settings.badge }}</span>
            {%- endif -%}
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 600 }}" class="hp51-card__img" alt="{{ block.settings.title }}" loading="lazy">
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'hp51-card__img' }}
            {%- endif -%}
          </div>
          <div class="hp51-card__body">
            <span class="hp51-card__tag">{{ block.settings.tag | default: 'CEREMONIAL ACTIVE' }}</span>
            <h3 class="hp51-card__title">{{ block.settings.title }}</h3>
            <div class="hp51-card__price">{{ block.settings.price | default: '$56.00 USD' }}</div>
            <button class="hp51-card__btn">{{ block.settings.btn_text | default: 'Add to Bag' }}</button>
          </div>
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="hp51-card">
        <div class="hp51-card__media">
          <span class="hp51-card__badge">Ceremonial Grade</span>
          {{ 'product-1' | placeholder_svg_tag: 'hp51-card__img' }}
        </div>
        <div class="hp51-card__body">
          <span class="hp51-card__tag">UJI MATCHA EGCG</span>
          <h3 class="hp51-card__title">Ceremonial Matcha Antioxidant Serum</h3>
          <div class="hp51-card__price">$62.00 USD</div>
          <button class="hp51-card__btn">Add to Bag</button>
        </div>
      </div>
      <div class="hp51-card">
        <div class="hp51-card__media">
          <span class="hp51-card__badge">Bamboo Harvest</span>
          {{ 'product-1' | placeholder_svg_tag: 'hp51-card__img' }}
        </div>
        <div class="hp51-card__body">
          <span class="hp51-card__tag">BAMBOO SILICA SAP</span>
          <h3 class="hp51-card__title">Kyoto Bamboo Sap Essence</h3>
          <div class="hp51-card__price">$48.00 USD</div>
          <button class="hp51-card__btn">Add to Bag</button>
        </div>
      </div>
      <div class="hp51-card">
        <div class="hp51-card__media">
          {{ 'product-1' | placeholder_svg_tag: 'hp51-card__img' }}
        </div>
        <div class="hp51-card__body">
          <span class="hp51-card__tag">BARRIER RESTORE</span>
          <h3 class="hp51-card__title">Zen Matcha Silk Moisture Crème</h3>
          <div class="hp51-card__price">$68.00 USD</div>
          <button class="hp51-card__btn">Add to Bag</button>
        </div>
      </div>
      <div class="hp51-card">
        <div class="hp51-card__media">
          <span class="hp51-card__badge">Clay Ritual</span>
          {{ 'product-1' | placeholder_svg_tag: 'hp51-card__img' }}
        </div>
        <div class="hp51-card__body">
          <span class="hp51-card__tag">PURIFYING CLAY</span>
          <h3 class="hp51-card__title">Kyoto Ceremonial Matcha Clay Mask</h3>
          <div class="hp51-card__price">$52.00 USD</div>
          <button class="hp51-card__btn">Add to Bag</button>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP51 - Zen Grid",
  "class": "section-hp51-grid",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#F2EFE9" },
    { "type": "color", "id": "card_bg", "label": "Card Background", "default": "#FAF8F5" },
    { "type": "color", "id": "title_color", "label": "Title Color", "default": "#1E3A2B" },
    { "type": "color", "id": "accent_matcha", "label": "Matcha Accent", "default": "#2D5A3D" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Kyoto Matcha & Bamboo Collection" },
    { "type": "text", "id": "view_all_text", "label": "View All Text", "default": "View All Formulations →" },
    { "type": "url", "id": "view_all_url", "label": "View All URL" },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "label": "Desktop Columns", "default": 4 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "badge", "label": "Badge", "default": "Ceremonial Grade" },
        { "type": "text", "id": "tag", "label": "Tag", "default": "UJI MATCHA EGCG" },
        { "type": "text", "id": "title", "label": "Title", "default": "Ceremonial Matcha Antioxidant Serum" },
        { "type": "text", "id": "price", "label": "Price", "default": "$62.00 USD" },
        { "type": "text", "id": "btn_text", "label": "Button Label", "default": "Add to Bag" },
        { "type": "url", "id": "url", "label": "Product Link" }
      ]
    }
  ],
  "presets": [
    { "name": "HP51 - Zen Grid" }
  ]
}
{% endschema %}
