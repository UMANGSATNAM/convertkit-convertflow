{%- style -%}
  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --border-color: #000000;
    --border-width: 3px;
    --shadow-offset: 8px;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    border-bottom: var(--border-width) solid var(--border-color);
    font-family: 'Space Grotesk', 'Outfit', sans-serif;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }

  .hp23-founder-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
  }

  @media screen and (max-width: 768px) {
    .hp23-founder-wrapper {
      padding: 0 20px;
    }
  }

  .hp23-founder__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: center;
  }

  @media screen and (max-width: 992px) {
    .hp23-founder__grid {
      grid-template-columns: 1fr;
    }
  }

  /* Make image block */
  .hp23-founder__image-block {
    position: relative;
    border: var(--border-width) solid var(--border-color);
    background: #ffffff;
    box-shadow: var(--shadow-offset) var(--shadow-offset) 0 var(--border-color);
    padding: 20px;
    border-radius: {{ section.settings.border_radius }}px;
    transform: rotate(-2deg);
  }

  @media screen and (max-width: 992px) {
    .hp23-founder__image-block {
      max-width: 400px;
      margin: 0 auto;
    }
  }

  .hp23-founder__image {
    width: 100%;
    aspect-ratio: 4/5;
    object-fit: cover;
    display: block;
    border: var(--border-width) solid var(--border-color);
    filter: contrast(1.1) grayscale(0.2); /* raw look */
  }

  .hp23-founder__sticker {
    position: absolute;
    bottom: -20px;
    right: -20px;
    background: var(--accent-color);
    border: 3px solid #000;
    box-shadow: 4px 4px 0 #000;
    padding: 15px;
    border-radius: 50%;
    width: 100px;
    height: 100px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 900;
    font-size: 16px;
    text-transform: uppercase;
    text-align: center;
    transform: rotate(15deg);
    z-index: 2;
  }

  .hp23-founder__content {
    padding: 40px 0;
  }

  @media screen and (max-width: 992px) {
    .hp23-founder__content {
      padding: 20px 0 0;
    }
  }

  .hp23-founder__label {
    display: inline-block;
    background: var(--text-color);
    color: var(--bg-color);
    padding: 6px 12px;
    font-weight: 800;
    font-size: 14px;
    text-transform: uppercase;
    margin-bottom: 24px;
    border: 2px solid var(--border-color);
  }

  .hp23-founder__title {
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    font-weight: 900;
    color: var(--text-color);
    line-height: 1.1;
    margin: 0 0 30px;
    text-transform: uppercase;
    letter-spacing: -1px;
  }

  .hp23-founder__text {
    font-family: var(--font-body);
    font-size: {{ section.settings.text_size }}px;
    font-weight: 500;
    color: var(--text-color);
    line-height: 1.5;
    margin: 0 0 30px;
  }
  
  .hp23-founder__text em {
    font-style: normal;
    background: var(--text-color);
    color: var(--bg-color);
    padding: 2px 6px;
    display: inline-block;
    /* Redacted style highlight */
  }

  .hp23-founder__signature-wrap {
    margin-top: 30px;
    border-top: var(--border-width) solid var(--border-color);
    padding-top: 20px;
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .hp23-founder__signature {
    max-width: 150px;
    height: auto;
  }
  
  .hp23-founder__name {
    font-weight: 900;
    font-size: 18px;
    text-transform: uppercase;
    display: flex;
    flex-direction: column;
  }
  
  .hp23-founder__title-role {
    font-size: 12px;
    opacity: 0.6;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp23-founder-wrapper" id="HP23Founder-{{ section.id }}">
  <div class="hp23-founder__grid">
    
    <div class="hp23-founder__image-block">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.title | strip_html | escape }}" class="hp23-founder__image" loading="lazy">
      {%- else -%}
        <div style="width:100%;aspect-ratio:4/5;background:#e0e0e0;display:flex;align-items:center;justify-content:center;font-weight:bold;border:var(--border-width) solid var(--border-color);">IMAGE</div>
      {%- endif -%}
      
      <div class="hp23-founder__sticker">NO BS</div>
    </div>

    <div class="hp23-founder__content">
      <div class="hp23-founder__label">FROM THE FOUNDER</div>

      {%- if section.settings.title != blank -%}
        <h2 class="hp23-founder__title">{{ section.settings.title }}</h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="hp23-founder__text">{{ section.settings.text }}</div>
      {%- endif -%}

      <div class="hp23-founder__signature-wrap">
        {%- if section.settings.signature != blank -%}
          <img src="{{ section.settings.signature | image_url: width: 300 }}" alt="Signature" class="hp23-founder__signature" loading="lazy">
        {%- endif -%}
        
        <div class="hp23-founder__name">
          {{ section.settings.founder_name | escape }}
          <span class="hp23-founder__title-role">{{ section.settings.founder_role | escape }}</span>
        </div>
      </div>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "HP23 - Brutalist Founder",
  "class": "section-hp23-founder-note",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1200
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Box Border Radius",
      "default": 12
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "WE BROKE THE RULES ON PURPOSE."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Body Text",
      "default": "<p>The industry wanted us to play nice. They wanted us to use cheap fillers, cute packaging, and fake promises. <em>We said no.</em> We built this brand because we were tired of being lied to. We use raw, effective ingredients and we don't care if it upsets the establishment.</p>",
      "info": "Use italic for redacted/highlighted text block"
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Founder Photo"
    },
    {
      "type": "image_picker",
      "id": "signature",
      "label": "Signature Image (Transparent)"
    },
    {
      "type": "text",
      "id": "founder_name",
      "label": "Founder Name",
      "default": "ALEX MERCER"
    },
    {
      "type": "text",
      "id": "founder_role",
      "label": "Founder Role",
      "default": "FOUNDER & CEO"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 32,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 56
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Text Size",
      "default": 18
    },
    {
      "type": "header",
      "content": "Brutalist Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#F4F4F0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color (Sticker)",
      "default": "#39FF14"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 100
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP23 - Brutalist Founder"
    }
  ]
}
{% endschema %}
