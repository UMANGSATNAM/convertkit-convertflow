{%- style -%}
  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --border-color: {{ section.settings.border_color }};
    --border-thickness: {{ section.settings.border_thickness }}px;
    --shadow-color: {{ section.settings.shadow_color }};
    --shadow-offset: {{ section.settings.shadow_offset }}px;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    border-top: var(--border-thickness) solid var(--border-color);
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }

  .hp20-insta-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 24px;
    position: relative;
  }

  .hp20-insta__header {
    text-align: center;
    margin-bottom: {{ section.settings.header_margin }}px;
    position: relative;
    z-index: 2;
  }

  .hp20-insta__handle {
    display: inline-block;
    background: {{ section.settings.accent_color }};
    border: var(--border-thickness) solid var(--border-color);
    padding: 12px 32px;
    font-family: 'Inter', sans-serif;
    font-weight: 900;
    font-size: clamp(32px, 6vw, {{ section.settings.title_size }}px);
    color: var(--text-color);
    text-transform: uppercase;
    text-decoration: none;
    letter-spacing: 2px;
    box-shadow: var(--shadow-offset) var(--shadow-offset) 0px var(--shadow-color);
    transform: rotate(-2deg);
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .hp20-insta__handle:hover {
    transform: rotate(0deg) translate(-2px, -2px);
    box-shadow: calc(var(--shadow-offset)*1.5) calc(var(--shadow-offset)*1.5) 0px var(--shadow-color);
  }

  .hp20-insta__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.desktop_columns }}, 1fr);
    gap: {{ section.settings.grid_gap }}px;
  }

  @media screen and (max-width: 992px) {
    .hp20-insta__grid {
      grid-template-columns: repeat({{ section.settings.tablet_columns }}, 1fr);
    }
  }

  @media screen and (max-width: 768px) {
    .hp20-insta__grid {
      grid-template-columns: repeat({{ section.settings.mobile_columns }}, 1fr);
      gap: {{ section.settings.mobile_grid_gap }}px;
    }
  }

  .hp20-insta__item {
    aspect-ratio: 1/1;
    border: var(--border-thickness) solid var(--border-color);
    background: #000;
    position: relative;
    overflow: hidden;
    box-shadow: calc(var(--shadow-offset)/2) calc(var(--shadow-offset)/2) 0px var(--shadow-color);
    transition: transform 0.2s;
  }

  .hp20-insta__item:hover {
    transform: translate(-4px, -4px);
    box-shadow: var(--shadow-offset) var(--shadow-offset) 0px var(--shadow-color);
  }

  .hp20-insta__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: {% if section.settings.image_grayscale %}grayscale(100%) contrast(120%){% else %}none{% endif %};
    transition: filter 0.3s;
  }

  .hp20-insta__item:hover .hp20-insta__image {
    filter: none;
  }

  .hp20-insta__icon {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 48px; height: 48px;
    background: var(--text-color);
    color: var(--bg-color); /* assuming contrast */
    border: var(--border-thickness) solid var(--border-color);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.2s;
  }
  
  .hp20-insta__icon svg {
    width: 24px; height: 24px;
  }

  .hp20-insta__item:hover .hp20-insta__icon {
    opacity: 1;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp20-insta-wrapper" id="HP20Instagram-{{ section.id }}">
  
  <div class="hp20-insta__header">
    {%- if section.settings.handle != blank -%}
      <a href="{{ section.settings.link | default: '#' }}" class="hp20-insta__handle" target="_blank" rel="noopener">
        {{ section.settings.handle | escape }}
      </a>
    {%- endif -%}
  </div>

  <div class="hp20-insta__grid">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.link | default: '#' }}" class="hp20-insta__item" {{ block.shopify_attributes }} target="_blank" rel="noopener">
        {%- if block.settings.image != blank -%}
          <img src="{{ block.settings.image | image_url: width: 600 }}" alt="Instagram image" class="hp20-insta__image" loading="lazy">
        {%- else -%}
          {{ 'product-' | append: forloop.index | placeholder_svg_tag: 'placeholder-svg hp20-insta__image' }}
        {%- endif -%}
        
        <div class="hp20-insta__icon">
          <!-- Brutalist IG icon simplified -->
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
          </svg>
        </div>
      </a>
    {%- endfor -%}
  </div>

</div>

{% schema %}
{
  "name": "HP20 - Brutalist IG",
  "class": "section-hp20-instagram",
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "handle",
      "label": "Instagram Handle",
      "default": "@YOURBRAND"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Profile Link"
    },
    {
      "type": "range",
      "id": "header_margin",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Margin Below Handle",
      "default": 40
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1400
    },
    {
      "type": "range",
      "id": "desktop_columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Desktop Columns",
      "default": 4
    },
    {
      "type": "range",
      "id": "tablet_columns",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Tablet Columns",
      "default": 2
    },
    {
      "type": "range",
      "id": "mobile_columns",
      "min": 1,
      "max": 3,
      "step": 1,
      "label": "Mobile Columns",
      "default": 2
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Grid Gap (Desktop)",
      "default": 24
    },
    {
      "type": "range",
      "id": "mobile_grid_gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Grid Gap (Mobile)",
      "default": 16
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 30,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Handle Text Size",
      "default": 64
    },
    {
      "type": "header",
      "content": "Image Styling"
    },
    {
      "type": "checkbox",
      "id": "image_grayscale",
      "label": "Enable High-Contrast Grayscale (Hover reveals color)",
      "default": true
    },
    {
      "type": "header",
      "content": "Brutalist Styling"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Outer Background",
      "default": "#F4F4F0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color (Badge)",
      "default": "#E2FF00"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "border_thickness",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "Border Thickness",
      "default": 3
    },
    {
      "type": "color",
      "id": "shadow_color",
      "label": "Hard Shadow Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "shadow_offset",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Shadow Offset",
      "default": 12
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "IG Post",
      "limit": 12,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Post Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP20 - Brutalist IG",
      "blocks": [
        { "type": "post" },
        { "type": "post" },
        { "type": "post" },
        { "type": "post" }
      ]
    }
  ]
}
{% endschema %}
