{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#050505'
  assign text_color = section.settings.text_color | default: '#00FFA3'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 80px 40px;
    border-bottom: 1px solid #333;
  }
  
  .hp13-fp-container-{{ section_id }} {
    max-width: 1400px;
    margin: 0 auto;
  }
  
  .hp13-fp-header-{{ section_id }} {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 40px;
    border-bottom: 1px solid #333;
    padding-bottom: 20px;
  }
  
  .hp13-fp-heading-{{ section_id }} {
    font-family: 'Arial Black', Impact, sans-serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 900;
    margin: 0;
    text-transform: uppercase;
    color: #FFF;
    letter-spacing: 2px;
  }
  
  .hp13-fp-heading-{{ section_id }} span {
    color: {{ text_color }};
  }
  
  .hp13-fp-view-all-{{ section_id }} {
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.85rem;
    font-weight: bold;
    color: {{ text_color }};
    text-decoration: none;
    text-transform: uppercase;
  }
  
  .hp13-fp-view-all-{{ section_id }}:hover {
    text-decoration: underline;
  }
  
  .hp13-fp-scroll-{{ section_id }} {
    display: flex;
    overflow-x: auto;
    gap: 30px;
    padding-bottom: 20px;
    -ms-overflow-style: none;
    scrollbar-width: none;
    scroll-snap-type: x mandatory;
  }
  
  .hp13-fp-scroll-{{ section_id }}::-webkit-scrollbar {
    display: none;
  }
  
  .hp13-fp-card-{{ section_id }} {
    flex: 0 0 350px;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    background: #111;
    border: 1px solid #333;
    scroll-snap-align: start;
    transition: all 0.2s ease;
  }
  
  .hp13-fp-card-{{ section_id }}:hover {
    border-color: {{ text_color }};
    box-shadow: 0 0 15px rgba(0,255,163,0.2);
  }
  
  .hp13-fp-image-wrap-{{ section_id }} {
    position: relative;
    padding-top: 100%;
    background: #000;
    border-bottom: 1px solid #333;
    overflow: hidden;
  }
  
  .hp13-fp-image-{{ section_id }} {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover;
    filter: grayscale(100%);
    transition: filter 0.3s ease;
  }
  
  .hp13-fp-card-{{ section_id }}:hover .hp13-fp-image-{{ section_id }} {
    filter: grayscale(0%);
  }
  
  .hp13-fp-badge-{{ section_id }} {
    position: absolute;
    top: 10px; right: 10px;
    background: #FF003C;
    color: #FFF;
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.7rem;
    font-weight: bold;
    padding: 3px 8px;
    text-transform: uppercase;
  }
  
  .hp13-fp-info-{{ section_id }} {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  
  .hp13-fp-title-{{ section_id }} {
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.9rem;
    font-weight: bold;
    color: #FFF;
    margin: 0;
    text-transform: uppercase;
  }
  
  .hp13-fp-price-{{ section_id }} {
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.9rem;
    font-weight: bold;
    color: {{ text_color }};
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 60px 20px;
    }
    .hp13-fp-header-{{ section_id }} {
      flex-direction: column;
      align-items: flex-start;
      gap: 15px;
    }
    .hp13-fp-card-{{ section_id }} {
      flex: 0 0 280px;
    }
  }
</style>

<div class="hp13-fp-container-{{ section_id }}">
  <div class="hp13-fp-header-{{ section_id }}">
    <h2 class="hp13-fp-heading-{{ section_id }}">LATEST <span>DROPS</span></h2>
    {% if section.settings.show_view_all %}
      <a href="{{ collections[section.settings.collection].url | default: '#' }}" class="hp13-fp-view-all-{{ section_id }}">[VIEW_ALL_DATA]</a>
    {% endif %}
  </div>
  
  <div class="hp13-fp-scroll-{{ section_id }}">
    {% assign collection = collections[section.settings.collection] %}
    {% if collection != blank %}
      {% for product in collection.products limit: 6 %}
        <a href="{{ product.url }}" class="hp13-fp-card-{{ section_id }}">
          <div class="hp13-fp-image-wrap-{{ section_id }}">
            <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" width="600" height="600" class="hp13-fp-image-{{ section_id }}" loading="lazy">
            {% if product.tags contains 'new' or forloop.first %}
              <div class="hp13-fp-badge-{{ section_id }}">SYS.NEW</div>
            {% endif %}
          </div>
          <div class="hp13-fp-info-{{ section_id }}">
            <h3 class="hp13-fp-title-{{ section_id }}">{{ product.title }}</h3>
            <div class="hp13-fp-price-{{ section_id }}">{{ product.price | money }}</div>
          </div>
        </a>
      {% endfor %}
    {% else %}
      {% for i in (1..6) %}
        <a href="#" class="hp13-fp-card-{{ section_id }}">
          <div class="hp13-fp-image-wrap-{{ section_id }}">
            <div class="hp13-fp-image-{{ section_id }}" style="background: #222;"></div>
            {% if i == 1 %}
              <div class="hp13-fp-badge-{{ section_id }}">SYS.NEW</div>
            {% endif %}
          </div>
          <div class="hp13-fp-info-{{ section_id }}">
            <h3 class="hp13-fp-title-{{ section_id }}">CYBER_GEAR {{ i }}</h3>
            <div class="hp13-fp-price-{{ section_id }}">$180.00</div>
          </div>
        </a>
      {% endfor %}
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "HP13 Featured Products",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#050505"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Highlight Color",
      "default": "#00FFA3"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show View All Link",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "HP13 Featured Products"
    }
  ]
}
{% endschema %}
