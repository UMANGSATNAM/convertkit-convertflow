{%- style -%}
  #shopify-section-{{ section.id }} {
    --padding-top: {{ section.settings.padding_top }}px;
    --padding-bottom: {{ section.settings.padding_bottom }}px;
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --btn-bg: {{ section.settings.btn_bg_color }};
    --btn-text: {{ section.settings.btn_text_color }};
    --btn-bg-hover: {{ section.settings.btn_bg_hover }};
    --btn-text-hover: {{ section.settings.btn_text_hover }};
    --timer-bg: {{ section.settings.timer_bg }};
    --timer-text: {{ section.settings.timer_text }};
    
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
    background-color: var(--bg-color);
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      --padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      --padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }

  .hp19-offer-wrapper {
    position: relative;
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 24px;
    text-align: {{ section.settings.text_alignment }};
    display: flex;
    flex-direction: column;
    align-items: {% if section.settings.text_alignment == 'center' %}center{% elsif section.settings.text_alignment == 'left' %}flex-start{% else %}flex-end{% endif %};
    z-index: 2;
  }
  
  {% if section.settings.background_image != blank %}
  .hp19-offer-background {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    z-index: 1;
    overflow: hidden;
  }
  .hp19-offer-background img {
    width: 100%; height: 100%;
    object-fit: cover;
    {% if section.settings.enable_parallax %}
    background-attachment: fixed;
    transform: scale(1.1);
    {% endif %}
  }
  .hp19-offer-background::after {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: {{ section.settings.overlay_color | color_modify: 'alpha', section.settings.overlay_opacity | divided_by: 100.0 }};
  }
  {% endif %}

  .hp19-offer__title {
    font-family: 'Baskerville', 'Georgia', serif;
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    color: var(--text-color);
    margin: 0 0 16px;
    font-style: italic;
    line-height: 1.1;
  }

  .hp19-offer__text {
    font-family: 'Inter', sans-serif;
    font-size: {{ section.settings.text_size }}px;
    color: var(--text-color);
    margin: 0 0 32px;
    text-transform: uppercase;
    letter-spacing: 3px;
    font-weight: 500;
  }
  
  .hp19-offer__timer {
    display: flex;
    gap: 16px;
    margin-bottom: 40px;
    justify-content: {% if section.settings.text_alignment == 'center' %}center{% elsif section.settings.text_alignment == 'left' %}flex-start{% else %}flex-end{% endif %};
  }
  
  .hp19-offer__timer-block {
    background: var(--timer-bg);
    color: var(--timer-text);
    padding: 16px 20px;
    border-radius: {{ section.settings.timer_radius }}px;
    min-width: 80px;
    text-align: center;
    box-shadow: 0 4px 15px rgba(0,0,0,0.1);
  }
  
  .hp19-offer__timer-num {
    display: block;
    font-family: 'Inter', sans-serif;
    font-size: 32px;
    font-weight: 700;
    line-height: 1;
    margin-bottom: 4px;
  }
  
  .hp19-offer__timer-label {
    display: block;
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
    opacity: 0.8;
  }

  .hp19-offer__btn {
    display: inline-block;
    background-color: var(--btn-bg);
    color: var(--btn-text);
    padding: 16px 40px;
    font-family: 'Inter', sans-serif;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
    text-decoration: none;
    border: 1px solid var(--btn-bg);
    border-radius: {{ section.settings.btn_radius }}px;
    transition: all 0.3s ease;
  }

  .hp19-offer__btn:hover {
    background-color: var(--btn-bg-hover);
    color: var(--btn-text-hover);
    border-color: var(--btn-bg-hover);
    transform: translateY(-2px);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div style="position:relative;" id="HP19Offer-{{ section.id }}">
  {% if section.settings.background_image != blank %}
  <div class="hp19-offer-background">
    <img src="{{ section.settings.background_image | image_url: width: 2000 }}" alt="" loading="lazy">
  </div>
  {% endif %}
  
  <div class="hp19-offer-wrapper">
    {%- if section.settings.title != blank -%}
      <h2 class="hp19-offer__title">{{ section.settings.title | escape }}</h2>
    {%- endif -%}
    
    {%- if section.settings.text != blank -%}
      <p class="hp19-offer__text">{{ section.settings.text | escape }}</p>
    {%- endif -%}
    
    {%- if section.settings.enable_timer and section.settings.end_date != blank -%}
      <div class="hp19-offer__timer" data-end-date="{{ section.settings.end_date }}">
        <div class="hp19-offer__timer-block">
          <span class="hp19-offer__timer-num" id="days-{{ section.id }}">00</span>
          <span class="hp19-offer__timer-label">Days</span>
        </div>
        <div class="hp19-offer__timer-block">
          <span class="hp19-offer__timer-num" id="hours-{{ section.id }}">00</span>
          <span class="hp19-offer__timer-label">Hours</span>
        </div>
        <div class="hp19-offer__timer-block">
          <span class="hp19-offer__timer-num" id="mins-{{ section.id }}">00</span>
          <span class="hp19-offer__timer-label">Mins</span>
        </div>
        <div class="hp19-offer__timer-block">
          <span class="hp19-offer__timer-num" id="secs-{{ section.id }}">00</span>
          <span class="hp19-offer__timer-label">Secs</span>
        </div>
      </div>
      
      <script>
        document.addEventListener('DOMContentLoaded', function() {
          const timerEl = document.querySelector('#HP19Offer-{{ section.id }} .hp19-offer__timer');
          if (!timerEl) return;
          
          const endDateStr = timerEl.getAttribute('data-end-date');
          const countDownDate = new Date(endDateStr).getTime();
          
          if (isNaN(countDownDate)) return;

          const x = setInterval(function() {
            const now = new Date().getTime();
            const distance = countDownDate - now;

            if (distance < 0) {
              clearInterval(x);
              timerEl.style.display = "none";
              return;
            }

            const days = Math.floor(distance / (1000 * 60 * 60 * 24));
            const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
            const seconds = Math.floor((distance % (1000 * 60)) / 1000);

            document.getElementById("days-{{ section.id }}").innerHTML = days < 10 ? '0' + days : days;
            document.getElementById("hours-{{ section.id }}").innerHTML = hours < 10 ? '0' + hours : hours;
            document.getElementById("mins-{{ section.id }}").innerHTML = minutes < 10 ? '0' + minutes : minutes;
            document.getElementById("secs-{{ section.id }}").innerHTML = seconds < 10 ? '0' + seconds : seconds;
          }, 1000);
        });
      </script>
    {%- endif -%}
    
    {%- if section.settings.btn_text != blank and section.settings.btn_link != blank -%}
      <a href="{{ section.settings.btn_link }}" class="hp19-offer__btn">
        {{ section.settings.btn_text | escape }}
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP19 - Offer Banner Pro",
  "class": "section-hp19-offer-banner",
  "settings": [
    {
      "type": "header",
      "content": "Content"
