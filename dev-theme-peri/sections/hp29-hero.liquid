{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@300;400;500&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --secondary-color: {{ section.settings.secondary_color }};
    
    --font-heading: 'Lora', serif;
    --font-body: 'Inter', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    position: relative;
    overflow: hidden;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.7 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.7 | round }}px;
    }
  }

  .hp29-hero-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    align-items: center;
    gap: 80px;
    position: relative;
    z-index: 2;
    min-height: 80vh;
  }

  @media screen and (max-width: 1024px) {
    .hp29-hero-wrapper {
      flex-direction: column;
      gap: 50px;
      padding: 60px 30px;
    }
  }

  @media screen and (max-width: 768px) {
    .hp29-hero-wrapper {
      padding: 40px 20px;
    }
  }

  /* Abstract Organic Blobs in BG */
  .hp29-hero__blob {
    position: absolute;
    filter: blur(60px);
    opacity: 0.4;
    border-radius: 50%;
    z-index: 1;
    animation: hp29Float 20s ease-in-out infinite alternate;
  }

  .hp29-hero__blob--1 {
    top: -10%; left: -5%;
    width: 40vw; height: 40vw;
    background: var(--accent-color);
    animation-delay: 0s;
  }

  .hp29-hero__blob--2 {
    bottom: -15%; right: -10%;
    width: 50vw; height: 50vw;
    background: var(--secondary-color);
    animation-delay: -5s;
  }

  @keyframes hp29Float {
    0% { transform: translate(0, 0) scale(1); }
    100% { transform: translate(5%, 5%) scale(1.1); }
  }

  .hp29-hero__content {
    flex: 1;
    max-width: 600px;
    position: relative;
    z-index: 2;
    animation: hp29FadeUp 1.2s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
    opacity: 0;
  }

  .hp29-hero__badge {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-color);
    margin-bottom: 25px;
    border-bottom: 1px solid var(--accent-color);
    padding-bottom: 4px;
  }

  .hp29-hero__title {
    font-family: var(--font-heading);
    font-size: clamp(36px, 5vw, {{ section.settings.title_size }}px);
    font-weight: 400;
    line-height: 1.1;
    color: var(--text-color);
    margin: 0 0 30px;
    letter-spacing: -0.02em;
  }
  
  .hp29-hero__title em {
    font-style: italic;
    color: var(--accent-color);
  }

  .hp29-hero__text {
    font-family: var(--font-body);
    font-size: clamp(16px, 2vw, 18px);
    font-weight: 300;
    line-height: 1.6;
    color: var(--text-color);
    opacity: 0.8;
    margin: 0 0 45px;
    max-width: 500px;
  }

  .hp29-hero__buttons {
    display: flex;
    gap: 20px;
    align-items: center;
    flex-wrap: wrap;
  }

  .hp29-hero__btn {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    padding: 16px 36px;
    border-radius: 30px;
    transition: all 0.4s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .hp29-hero__btn--primary {
    background: var(--text-color);
    color: var(--bg-color);
    border: 1px solid var(--text-color);
  }

  .hp29-hero__btn--primary:hover {
    background: transparent;
    color: var(--text-color);
  }

  .hp29-hero__btn--secondary {
    background: transparent;
    color: var(--text-color);
    border: 1px solid rgba(61, 64, 91, 0.2);
  }

  .hp29-hero__btn--secondary:hover {
    border-color: var(--text-color);
    background: rgba(255, 255, 255, 0.1);
  }

  .hp29-hero__image-col {
    flex: 1.2;
    position: relative;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    animation: hp29FadeIn 1.5s cubic-bezier(0.2, 0.8, 0.2, 1) 0.3s forwards;
    opacity: 0;
  }

  .hp29-hero__image-wrapper {
    position: relative;
    width: 100%;
    max-width: 550px;
  }

  /* Arch shape image */
  .hp29-hero__image-arch {
    width: 100%;
    aspect-ratio: 3/4;
    border-radius: 200px 200px 20px 20px;
    overflow: hidden;
    position: relative;
    z-index: 2;
    box-shadow: 0 30px 60px rgba(0,0,0,0.08);
  }

  .hp29-hero__image-arch img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s ease;
  }

  .hp29-hero__image-wrapper:hover .hp29-hero__image-arch img {
    transform: scale(1.03);
  }

  /* Decorative accent image (circle) */
  .hp29-hero__image-circle {
    position: absolute;
    bottom: -10%;
    left: -15%;
    width: 40%;
    aspect-ratio: 1/1;
    border-radius: 50%;
    overflow: hidden;
    z-index: 3;
    border: 8px solid var(--bg-color);
    box-shadow: 0 15px 30px rgba(0,0,0,0.1);
  }
  
  @media screen and (max-width: 768px) {
    .hp29-hero__image-circle {
      bottom: -5%;
      left: -5%;
      width: 45%;
      border-width: 4px;
    }
  }

  .hp29-hero__image-circle img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @keyframes hp29FadeUp {
    from { opacity: 0; transform: translateY(40px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes hp29FadeIn {
    from { opacity: 0; transform: scale(0.95); }
    to { opacity: 1; transform: scale(1); }
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp29-hero-wrapper" id="HP29Hero-{{ section.id }}">
  <div class="hp29-hero__blob hp29-hero__blob--1"></div>
  <div class="hp29-hero__blob hp29-hero__blob--2"></div>

  <div class="hp29-hero__content">
    {%- if section.settings.badge != blank -%}
      <div class="hp29-hero__badge">{{ section.settings.badge }}</div>
    {%- endif -%}

    {%- if section.settings.title != blank -%}
      <h1 class="hp29-hero__title">{{ section.settings.title }}</h1>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="hp29-hero__text">{{ section.settings.text }}</div>
    {%- endif -%}

    <div class="hp29-hero__buttons">
      {%- if section.settings.btn1_text != blank -%}
        <a href="{{ section.settings.btn1_link | default: '#' }}" class="hp29-hero__btn hp29-hero__btn--primary">
          {{ section.settings.btn1_text }}
        </a>
      {%- endif -%}
      {%- if section.settings.btn2_text != blank -%}
        <a href="{{ section.settings.btn2_link | default: '#' }}" class="hp29-hero__btn hp29-hero__btn--secondary">
          {{ section.settings.btn2_text }}
        </a>
      {%- endif -%}
    </div>
  </div>

  <div class="hp29-hero__image-col">
    <div class="hp29-hero__image-wrapper">
      <div class="hp29-hero__image-arch">
        {%- if section.settings.image_main != blank -%}
          <img height="{{ section.settings.image_main.height }}" width="{{ section.settings.image_main.width }}" src="{{ section.settings.image_main | image_url: width: 1000 }}" alt="{{ section.settings.title | escape }}" loading="lazy">
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag }}
        {%- endif -%}
      </div>
      
      <div class="hp29-hero__image-circle">
        {%- if section.settings.image_secondary != blank -%}
          <img height="{{ section.settings.image_secondary.height }}" width="{{ section.settings.image_secondary.width }}" src="{{ section.settings.image_secondary | image_url: width: 400 }}" alt="Secondary accent" loading="lazy">
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag }}
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "HP29 - Boho Hero",
  "class": "section-hp29-hero",
  "settings": [
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "image_main",
      "label": "Main Image (Arch)"
    },
    {
      "type": "image_picker",
      "id": "image_secondary",
      "label": "Secondary Image (Circle)"
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "default": "NEW COLLECTION"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Heading",
      "default": "Find balance in the <em>everyday</em> moments."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Body Text",
      "default": "<p>Embrace a softer pace with organically sourced materials and timeless silhouettes designed for modern living.</p>"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "btn1_text",
      "label": "Primary Button Text",
      "default": "Shop the Collection"
    },
    {
      "type": "url",
      "id": "btn1_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "btn2_text",
      "label": "Secondary Button Text",
      "default": "Discover Our Story"
    },
    {
      "type": "url",
      "id": "btn2_link",
      "label": "Secondary Button Link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1400
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 40,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 72
    },
    {
      "type": "header",
      "content": "Earthy Boho Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (Beige/Sand)",
      "default": "#F4F1DE"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text (Charcoal)",
      "default": "#3D405B"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent (Terracotta)",
      "default": "#E07A5F"
    },
    {
      "type": "color",
      "id": "secondary_color",
      "label": "Secondary (Sage Green)",
      "default": "#81B29A"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP29 - Boho Hero"
    }
  ]
}
{% endschema %}
