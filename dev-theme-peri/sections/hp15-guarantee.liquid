{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#ffffff'
  assign text_color = section.settings.text_color | default: '#000000'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 80px 40px;
    border-top: 1px solid rgba(0,0,0,0.1);
  }
  
  .hp15-guarantee-container-{{ section_id }} {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 40px;
  }
  
  .hp15-guarantee-item-{{ section_id }} {
    text-align: center;
    color: {{ text_color }};
  }
  
  .hp15-guarantee-icon-{{ section_id }} {
    margin-bottom: 20px;
  }
  
  .hp15-guarantee-icon-{{ section_id }} svg {
    width: 32px;
    height: 32px;
    stroke-width: 1;
  }
  
  .hp15-guarantee-title-{{ section_id }} {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin: 0 0 10px 0;
  }
  
  .hp15-guarantee-text-{{ section_id }} {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.85rem;
    color: #666;
    line-height: 1.5;
    margin: 0;
  }

  @media (max-width: 992px) {
    .hp15-guarantee-container-{{ section_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 60px 20px;
    }
    .hp15-guarantee-container-{{ section_id }} {
      grid-template-columns: 1fr;
    }
  }
</style>

<div class="hp15-guarantee-container-{{ section_id }}">
  {% for block in section.blocks limit: 4 %}
    <div class="hp15-guarantee-item-{{ section_id }}" {{ block.shopify_attributes }}>
      <div class="hp15-guarantee-icon-{{ section_id }}">
        {% if block.settings.icon == 'shipping' %}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><line x1="22" y1="12" x2="2" y2="12"></line><polyline points="15 5 22 12 15 19"></polyline></svg>
        {% elsif block.settings.icon == 'return' %}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="1 4 1 10 7 10"></polyline><polyline points="23 20 23 14 17 14"></polyline><path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15"></path></svg>
        {% elsif block.settings.icon == 'quality' %}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
        {% else %}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="12" r="10"></circle></svg>
        {% endif %}
      </div>
      <h3 class="hp15-guarantee-title-{{ section_id }}">{{ block.settings.title }}</h3>
      <p class="hp15-guarantee-text-{{ section_id }}">{{ block.settings.text }}</p>
    </div>
  {% endfor %}
</div>

{% schema %}
{
  "name": "HP15 Guarantee",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    }
  ],
  "blocks": [
    {
      "type": "guarantee",
      "name": "Guarantee Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shipping", "label": "Shipping" },
            { "value": "return", "label": "Return" },
            { "value": "quality", "label": "Quality" },
            { "value": "circle", "label": "Circle" }
          ],
          "default": "shipping"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "GLOBAL SHIPPING"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Complimentary on orders over $200."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP15 Guarantee",
      "blocks": [
        { "type": "guarantee", "settings": { "icon": "shipping", "title": "GLOBAL SHIPPING", "text": "Complimentary on orders over $200." } },
        { "type": "guarantee", "settings": { "icon": "quality", "title": "ATELIER CRAFTED", "text": "Meticulously made in our Parisian studio." } },
        { "type": "guarantee", "settings": { "icon": "return", "title": "COMPLIMENTARY RETURNS", "text": "Within 14 days of delivery." } },
        { "type": "guarantee", "settings": { "icon": "circle", "title": "PRIVATE CLIENT", "text": "Dedicated concierge service available." } }
      ]
    }
  ]
}
{% endschema %}
