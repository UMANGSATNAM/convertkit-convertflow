{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#140510' }};
    padding-top: {{ section.settings.padding_top | default: 50 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 50 }}px;
    border-top: 1px solid rgba(233, 213, 255, 0.1);
  }
  .hp55-trust__container { max-width: {{ section.settings.container_width | default: 1280 }}px; margin: 0 auto; padding: 0 24px; }
  .hp55-trust__grid { display: flex; justify-content: center; gap: 50px; flex-wrap: wrap; }
  .hp55-trust__item { display: flex; align-items: center; gap: 14px; }
  .hp55-trust__icon {
    width: 46px; height: 46px; background: linear-gradient(135deg, #3B1230, #C084FC);
    border-radius: 50%; display: flex; align-items: center; justify-content: center;
    font-size: 18px; color: #FFFFFF; flex-shrink: 0;
    border: 1px solid rgba(233, 213, 255, 0.3);
  }
  .hp55-trust__label { font-family: 'Playfair Display', serif; font-size: 14px; font-weight: 700; color: #FFFFFF; margin: 0; }
  .hp55-trust__sub { font-size: 11px; color: {{ section.settings.accent_color | default: '#C084FC' }}; margin: 2px 0 0; }
  @media screen and (max-width: 768px) { .hp55-trust__grid { gap: 24px; } }
  @media screen and (max-width: 480px) {
    .hp55-trust__grid { flex-direction: column; align-items: center; text-align: center; }
    .hp55-trust__item { flex-direction: column; }
  }
{%- endstyle -%}
<div class="hp55-trust__container">
  <div class="hp55-trust__grid">
    {%- for block in section.blocks -%}
      <div class="hp55-trust__item" {{ block.shopify_attributes }}>
        <div class="hp55-trust__icon">{{ block.settings.icon | default: '✦' }}</div>
        <div>
          <p class="hp55-trust__label">{{ block.settings.title | default: 'Royal Courier Delivery' }}</p>
          <p class="hp55-trust__sub">{{ block.settings.subtitle | default: 'Complimentary over $75' }}</p>
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "HP55 Trust",
  "class": "section-hp55-trust",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#140510" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#C084FC" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 100, "step": 10, "unit": "px", "label": "Padding Top", "default": 50 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 100, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 50 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "blocks": [{
    "type": "badge", "name": "Badge",
    "settings": [
      { "type": "text", "id": "icon", "label": "Icon", "default": "✦" },
      { "type": "text", "id": "title", "label": "Title", "default": "Royal Courier Delivery" },
      { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Complimentary over $75" }
    ]
  }],
  "presets": [{
    "name": "HP55 Trust",
    "blocks": [
      { "type": "badge", "settings": { "icon": "👑", "title": "Royal Courier Delivery", "subtitle": "Complimentary over $75" } },
      { "type": "badge", "settings": { "icon": "🦪", "title": "Certified Nacre Purity", "subtitle": "100% genuine South Sea pearl" } },
      { "type": "badge", "settings": { "icon": "✨", "title": "Imperial Guarantee", "subtitle": "90-day sovereign satisfaction" } },
      { "type": "badge", "settings": { "icon": "🔒", "title": "Vault Security", "subtitle": "256-bit encrypted transactions" } }
    ]
  }]
}
{% endschema %}
