{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=Inter:wght@300;400&display=swap');

  #shopify-section-{{ section.id }} {
    --bg: {{ section.settings.bg_color }};
    --text: {{ section.settings.text_color }};
    --gold: {{ section.settings.accent_color }};
    --serif: 'Playfair Display', serif;
    --sans: 'Inter', sans-serif;
    background: var(--bg);
  }

  .hp42-story {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 80vh;
  }

  @media (max-width: 992px) { .hp42-story { grid-template-columns: 1fr; } }

  .hp42-story__img {
    overflow: hidden;
    background: #111;
  }

  .hp42-story__img img, .hp42-story__img svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.6) sepia(0.3);
  }

  .hp42-story__content {
    padding: 100px 80px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    border-left: 1px solid rgba(201,169,110,0.15);
  }

  @media (max-width: 992px) {
    .hp42-story__content { padding: 60px 30px; border-left: none; border-top: 1px solid rgba(201,169,110,0.15); }
  }

  .hp42-story__eyebrow {
    font-family: var(--sans);
    font-size: 12px;
    font-weight: 300;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 30px;
  }

  .hp42-story__title {
    font-family: var(--serif);
    font-size: clamp(36px, 5vw, {{ section.settings.title_size }}px);
    font-weight: 900;
    font-style: italic;
    line-height: 1.1;
    color: var(--text);
    margin: 0 0 30px;
  }

  .hp42-story__text {
    font-family: var(--sans);
    font-size: 17px;
    font-weight: 300;
    line-height: 1.8;
    color: var(--text);
    opacity: 0.6;
    margin: 0 0 50px;
    max-width: 450px;
  }

  .hp42-story__btn {
    align-self: flex-start;
    font-family: var(--sans);
    font-size: 13px;
    font-weight: 300;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--gold);
    text-decoration: none;
    border-bottom: 1px solid var(--gold);
    padding-bottom: 4px;
    transition: opacity 0.3s;
  }
  .hp42-story__btn:hover { opacity: 0.6; }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp42-story" id="HP42Story-{{ section.id }}">
  <div class="hp42-story__img">
    {%- if section.settings.image != blank -%}
      <img height="{{ section.settings.image.height }}" width="{{ section.settings.image.width }}" src="{{ section.settings.image | image_url: width: 1000 }}" alt="Brand Story" loading="lazy">
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag }}
    {%- endif -%}
  </div>

  <div class="hp42-story__content">
    <div class="hp42-story__eyebrow">{{ section.settings.eyebrow }}</div>
    <h2 class="hp42-story__title">{{ section.settings.title }}</h2>
    {%- if section.settings.text != blank -%}
      <div class="hp42-story__text">{{ section.settings.text }}</div>
    {%- endif -%}
    {%- if section.settings.btn_label != blank -%}
      <a href="{{ section.settings.btn_link | default: '#' }}" class="hp42-story__btn">{{ section.settings.btn_label }}</a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP42 - Noir Story",
  "class": "section-hp42-brand-story",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our Heritage" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Born in Shadow, Forged in Light." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>A tradition of quiet luxury spanning three decades. We believe the finest things never need to announce themselves.</p>" },
    { "type": "text", "id": "btn_label", "label": "Button", "default": "Read Our Story" },
    { "type": "url", "id": "btn_link", "label": "Link" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "range", "id": "title_size", "min": 36, "max": 100, "step": 4, "unit": "px", "label": "Title Size", "default": 56 },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#0A0A0A" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#F5F0EB" },
    { "type": "color", "id": "accent_color", "label": "Gold", "default": "#C9A96E" },
    { "type": "html", "id": "custom_css", "label": "Custom CSS" }
  ],
  "presets": [{ "name": "HP42 - Noir Story" }]
}
{% endschema %}
