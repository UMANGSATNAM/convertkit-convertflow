{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Chakra+Petch:ital,wght@0,300;0,400;0,600;0,700;1,400&family=Press+Start+2P&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --cyan: {{ section.settings.cyan_color }};
    --magenta: {{ section.settings.magenta_color }};
    --win-bg: #c0c0c0; /* Classic Win95 gray */
    --win-dark: #000000;
    --win-light: #ffffff;
    --win-border-light: #dfdfdf;
    --win-border-dark: #808080;
    --win-title-bg: #000080;
    --win-title-text: #ffffff;
    
    --font-heading: 'Press Start 2P', cursive;
    --font-body: 'Chakra Petch', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    position: relative;
    /* Optional grid */
    background-image: 
      linear-gradient(rgba(0, 255, 255, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 255, 255, 0.05) 1px, transparent 1px);
    background-size: 20px 20px;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.8 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.8 | round }}px;
    }
  }

  .hp28-usp-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: 40px;
  }

  @media screen and (max-width: 992px) {
    .hp28-usp-wrapper {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 768px) {
    .hp28-usp-wrapper {
      grid-template-columns: 1fr;
      padding: 0 20px;
      gap: 30px;
    }
  }

  /* Win95 Dialog Box Style */
  .hp28-usp__item {
    background: var(--win-bg);
    border-top: 2px solid var(--win-light);
    border-left: 2px solid var(--win-light);
    border-right: 2px solid var(--win-dark);
    border-bottom: 2px solid var(--win-dark);
    padding: 2px;
    box-shadow: inset 1px 1px 0 var(--win-border-light), inset -1px -1px 0 var(--win-border-dark);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .hp28-usp__item:hover {
    transform: translateY(-5px);
    box-shadow: 
      inset 1px 1px 0 var(--win-border-light), 
      inset -1px -1px 0 var(--win-border-dark),
      5px 5px 0 var(--magenta);
  }

  /* Title Bar */
  .hp28-usp__title-bar {
    background: var(--win-title-bg);
    color: var(--win-title-text);
    padding: 4px 6px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .hp28-usp__title-text {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .hp28-usp__title-text::before {
    content: '';
    display: inline-block;
    width: 12px; height: 12px;
    background: var(--win-light);
    border-top: 1px solid var(--win-border-dark);
    border-left: 1px solid var(--win-border-dark);
    border-right: 1px solid var(--win-dark);
    border-bottom: 1px solid var(--win-dark);
  }

  .hp28-usp__close-btn {
    width: 16px;
    height: 16px;
    background: var(--win-bg);
    border-top: 1px solid var(--win-light);
    border-left: 1px solid var(--win-light);
    border-right: 1px solid var(--win-dark);
    border-bottom: 1px solid var(--win-dark);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #000;
    font-family: Arial, sans-serif;
    font-size: 10px;
    font-weight: bold;
    cursor: default;
    line-height: 1;
  }

  /* Content Area */
  .hp28-usp__content {
    padding: 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hp28-usp__icon {
    width: 48px;
    height: 48px;
    margin-bottom: 20px;
    /* Pixelated look for images if provided */
    image-rendering: pixelated;
  }

  .hp28-usp__icon svg {
    width: 100%;
    height: 100%;
    fill: var(--magenta);
    filter: drop-shadow(2px 2px 0 var(--cyan));
  }

  .hp28-usp__heading {
    font-family: var(--font-heading);
    font-size: clamp(14px, 2vw, {{ section.settings.title_size }}px);
    color: #000;
    line-height: 1.4;
    margin: 0 0 10px;
  }

  .hp28-usp__text {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 500;
    color: #333;
    line-height: 1.5;
    margin: 0;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp28-usp-wrapper" id="HP28USP-{{ section.id }}">
  {%- for block in section.blocks -%}
    <div class="hp28-usp__item" {{ block.shopify_attributes }}>
      
      <div class="hp28-usp__title-bar">
        <div class="hp28-usp__title-text">C:\SYS\{{ block.settings.title | split: ' ' | first | upcase | slice: 0, 8 }}.EXE</div>
        <div class="hp28-usp__close-btn">x</div>
      </div>

      <div class="hp28-usp__content">
        {%- if block.settings.image != blank -%}
          <img src="{{ block.settings.image | image_url: width: 100 }}" alt="{{ block.settings.title | escape }}" class="hp28-usp__icon" loading="lazy">
        {%- elsif block.settings.icon_svg != blank -%}
          <div class="hp28-usp__icon">
            {{ block.settings.icon_svg }}
          </div>
        {%- else -%}
          <div class="hp28-usp__icon">
            <!-- Default pixel icon (diskette) -->
            <svg viewBox="0 0 24 24"><path d="M4 2h12l4 4v16H4V2zm2 2v4h8V4H6zm10 2V4h-2v2h2zM6 12v8h12v-8H6zm2 2h8v4H8v-4z"/></svg>
          </div>
        {%- endif -%}

        {%- if block.settings.title != blank -%}
          <h3 class="hp28-usp__heading">{{ block.settings.title }}</h3>
        {%- endif -%}

        {%- if block.settings.text != blank -%}
          <p class="hp28-usp__text">{{ block.settings.text }}</p>
        {%- endif -%}
      </div>

    </div>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "HP28 - Y2K USP",
  "class": "section-hp28-usp",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1400
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Columns (Desktop)",
      "default": 4
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Heading Size",
      "default": 16
    },
    {
      "type": "header",
      "content": "Y2K Cyber Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (Deep Purple)",
      "default": "#1C0B2B"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Base Text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "cyan_color",
      "label": "Cyan Accent",
      "default": "#00FFFF"
    },
    {
      "type": "color",
      "id": "magenta_color",
      "label": "Magenta Accent",
      "default": "#FF00FF"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "limit": 5,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Pixel Art Image"
        },
        {
          "type": "html",
          "id": "icon_svg",
          "label": "Or SVG Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "FAST LOAD"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Data transfers completed in sub-millisecond speeds."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP28 - Y2K USP",
      "blocks": [
        { "type": "benefit", "settings": { "title": "SECURE LINE" } },
        { "type": "benefit", "settings": { "title": "FAST LOAD" } },
        { "type": "benefit", "settings": { "title": "DATA BACKUP" } },
        { "type": "benefit", "settings": { "title": "LIFETIME" } }
      ]
    }
  ]
}
{% endschema %}
