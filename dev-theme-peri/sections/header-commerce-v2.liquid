<div class="header-commerce-v2">
  <div class="header-tier-b">
    <div class="page-width">
      <div class="tier-b-inner">
        <div class="header-logo">
          <a href="/" class="logo-link">
            <svg class="logo-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"></path><path d="M2 17l10 5 10-5"></path><path d="M2 12l10 5 10-5"></path></svg>
            <div class="logo-text-group">
              <span class="logo-title">peri beauty</span>
              <span class="logo-tagline">TASTE OF TRADITION</span>
            </div>
          </a>
        </div>
        <form class="header-search" action="{{ routes.search_url }}" method="get" role="search">
          <input
            type="search"
            name="q"
            value="{{ search.terms | escape }}"
            placeholder="{{ section.settings.search_placeholder | default: 'Search for products, brands, or categories...' }}"
            class="search-input"
            data-predictive-search
            data-predictive-limit="6"
            aria-label="Search products">
          <button type="submit" class="search-btn-solid">
             Search
          </button>
        </form>
        <div class="header-icons">
          {% render 'wishlist-icon', class: 'icon-link', size: 24, label: 'Wishlist' %}
          <a href="/cart" data-cart-open class="icon-link cart-link">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
            <span class="icon-text">Cart</span>
            <span class="cart-badge">2</span>
          </a>
        </div>
      </div>
    </div>
  </div>
  
  <div class="header-tier-c">
    <div class="page-width">
      <div class="tier-c-inner">
        <div class="browse-categories">
          <button class="browse-btn">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
            Browse Categories
          </button>
        </div>
        <nav class="header-nav">
          <a href="/">Home</a>
          <a href="/collections/all">Shop</a>
          <a href="/collections/bestsellers">Bestsellers</a>
          <a href="/pages/about">Our Story</a>
        </nav>
        <div class="header-contact">
           Need help? <strong>{{ section.settings.help_phone | default: '1800-123-456' }}</strong>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
.header-commerce-v2 {
  background-color: var(--surface);
  font-family: var(--font-family);
  box-shadow: var(--shadow-sm);
  position: relative;
  z-index: 100;
}
.tier-b-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 72px;
  gap: var(--space-32);
}
.header-logo .logo-link {
  display: flex;
  align-items: center;
  gap: var(--space-12);
  text-decoration: none;
}
.logo-icon {
  color: var(--primary);
}
.logo-text-group {
  display: flex;
  flex-direction: column;
}
.logo-title {
  font-size: var(--text-24);
  font-weight: 700;
  color: var(--primary);
  letter-spacing: -0.5px;
  line-height: 1;
}
.logo-tagline {
  font-size: 9px;
  font-weight: 600;
  color: var(--text-muted);
  letter-spacing: 1.5px;
  text-transform: uppercase;
  margin-top: 2px;
}
.header-search {
  flex: 1;
  max-width: 600px;
  display: flex;
  position: relative;
  align-items: center;
}
.search-input {
  width: 100%;
  padding: 10px 100px 10px 20px;
  border: 1.5px solid var(--border);
  border-radius: var(--radius-pill);
  font-size: var(--text-14);
  background-color: var(--surface);
  outline: none;
  transition: all 0.2s ease;
  font-family: var(--font-family);
  height: 44px;
}
.search-input:focus {
  border-color: var(--primary);
  background-color: var(--surface);
}
.search-btn-solid {
  position: absolute;
  right: 4px;
  top: 50%;
  transform: translateY(-50%);
  background-color: var(--primary);
  color: var(--surface);
  border: none;
  border-radius: var(--radius-pill);
  padding: 6px 16px;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  height: 36px;
  display: flex;
  align-items: center;
  transition: background-color 0.2s;
}
.search-btn-solid:hover {
  background-color: var(--primary-hover);
}
.header-icons {
  display: flex;
  align-items: center;
  gap: var(--space-24);
}
.icon-link {
  font-size: var(--text-14);
  color: var(--text-main);
  text-decoration: none;
  font-weight: 500;
  display: flex;
  align-items: center;
  gap: 8px;
  transition: color 0.2s;
}
.icon-link:hover {
  color: var(--primary);
}
.cart-link {
  position: relative;
}
.cart-badge {
  background-color: var(--sale-red, #D32F2F);
  color: var(--surface);
  font-size: 10px;
  width: 18px;
  height: 18px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-pill);
  font-weight: 700;
  position: absolute;
  top: -8px;
  left: 14px;
  border: 2px solid var(--surface);
}
.header-tier-c {
  border-top: 1px solid var(--border);
  background-color: var(--bg-base);
}
.tier-c-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 52px;
}
.browse-categories {
  display: flex;
  align-items: center;
}
.browse-btn {
  background-color: var(--primary);
  color: var(--surface);
  border: none;
  padding: 8px 16px;
  border-radius: var(--radius-pill);
  font-size: var(--text-14);
  font-weight: 600;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 8px;
  transition: background-color 0.2s;
  font-family: var(--font-family);
}
.browse-btn:hover {
  background-color: var(--primary-hover);
}
.header-nav {
  display: flex;
  gap: var(--space-32);
  align-items: center;
}
.header-nav a {
  color: var(--text-main);
  text-decoration: none;
  font-size: var(--text-14);
  font-weight: 500;
  padding: 14px 0;
  position: relative;
}
.header-nav a::after {
  content: '';
  position: absolute;
  bottom: -1px;
  left: 0;
  width: 0%;
  height: 2px;
  background-color: var(--primary);
  transition: width 0.2s ease;
}
.header-nav a:hover::after {
  width: 100%;
}
.header-contact {
  font-size: var(--text-14);
  color: var(--text-muted);
}
.header-contact strong {
  color: var(--text-main);
  font-weight: 600;
}
@media (max-width: 990px) {
  .header-tier-c {
    display: none;
  }
  .header-search {
    display: none;
  }
  .icon-text {
    display: none;
  }
}
</style>

{% schema %}
{
  "name": "Header Commerce V2",
  "settings": [
    {
      "type": "url",
      "id": "logo_url",
      "label": "Logo URL"
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search Placeholder"
    },
    {
      "type": "text",
      "id": "help_phone",
      "label": "Help Phone Number"
    }
  ],
  "presets": [
    {
      "name": "Header Commerce V2"
    }
  ]
}
{% endschema %}
