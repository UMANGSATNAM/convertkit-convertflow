{%- liquid
  assign section_id = section.id
-%}

<style>
  #shopify-section-{{ section_id }} {
    padding: 0;
    background: repeating-linear-gradient(45deg, #FF00FF, #FF00FF 20px, #00FFFF 20px, #00FFFF 40px);
    border-bottom: 4px solid #000;
  }
  
  .hp16-hero-container-{{ section_id }} {
    position: relative;
    width: 100%;
    height: 85vh;
    min-height: 600px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px;
  }
  
  .hp16-hero-card-{{ section_id }} {
    background: #FFFF00;
    border: 4px solid #000;
    border-radius: 30px;
    padding: 60px 40px;
    text-align: center;
    box-shadow: 15px 15px 0 #FF00FF, 15px 15px 0 4px #000;
    max-width: 800px;
    position: relative;
    z-index: 2;
    transform: rotate(-2deg);
  }
  
  .hp16-hero-sticker-1-{{ section_id }} {
    position: absolute;
    top: -30px; left: -30px;
    background: #00FFFF;
    border: 3px solid #000;
    border-radius: 50%;
    width: 100px; height: 100px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Arial Black', sans-serif;
    font-size: 1.5rem;
    transform: rotate(-15deg);
    box-shadow: 5px 5px 0 #000;
  }
  
  .hp16-hero-sticker-2-{{ section_id }} {
    position: absolute;
    bottom: -20px; right: -20px;
    background: #FF00FF;
    color: #FFF;
    border: 3px solid #000;
    padding: 10px 20px;
    font-family: 'Comic Sans MS', cursive;
    font-weight: bold;
    transform: rotate(15deg);
    box-shadow: 5px 5px 0 #000;
    border-radius: 10px;
  }
  
  .hp16-hero-subtitle-{{ section_id }} {
    font-family: 'Courier New', Courier, monospace;
    font-weight: bold;
    font-size: 1.5rem;
    color: #FF00FF;
    text-shadow: 2px 2px 0 #000;
    margin-bottom: 20px;
  }
  
  .hp16-hero-title-{{ section_id }} {
    font-family: 'Arial Black', Impact, sans-serif;
    font-size: clamp(3rem, 7vw, 6rem);
    text-transform: uppercase;
    color: #FFF;
    -webkit-text-stroke: 3px #000;
    text-shadow: 6px 6px 0 #00FFFF;
    margin: 0 0 30px 0;
    line-height: 1;
  }
  
  .hp16-hero-btn-{{ section_id }} {
    font-family: 'Arial Black', sans-serif;
    font-size: 1.5rem;
    text-transform: uppercase;
    color: #000;
    background: #00FFFF;
    text-decoration: none;
    padding: 15px 40px;
    border: 4px solid #000;
    border-radius: 50px;
    display: inline-block;
    box-shadow: 6px 6px 0 #FF00FF;
    transition: all 0.2s ease;
  }
  
  .hp16-hero-btn-{{ section_id }}:hover {
    transform: translate(3px, 3px);
    box-shadow: 3px 3px 0 #FF00FF;
    background: #FFF;
  }
  
  @media (max-width: 768px) {
    .hp16-hero-container-{{ section_id }} {
      padding: 20px;
    }
    .hp16-hero-card-{{ section_id }} {
      padding: 40px 20px;
      box-shadow: 8px 8px 0 #FF00FF, 8px 8px 0 3px #000;
    }
    .hp16-hero-sticker-1-{{ section_id }} {
      width: 70px; height: 70px; font-size: 1rem;
    }
  }
</style>

<div class="hp16-hero-container-{{ section_id }}">
  <div class="hp16-hero-card-{{ section_id }}">
    <div class="hp16-hero-sticker-1-{{ section_id }}">OMG!</div>
    <div class="hp16-hero-sticker-2-{{ section_id }}">SO CUTE &lt;3</div>
    
    {% if section.settings.subtitle != blank %}
      <div class="hp16-hero-subtitle-{{ section_id }}">{{ section.settings.subtitle }}</div>
    {% endif %}
    {% if section.settings.title != blank %}
      <h1 class="hp16-hero-title-{{ section_id }}">{{ section.settings.title }}</h1>
    {% endif %}
    {% if section.settings.btn_text != blank %}
      <a href="{{ section.settings.btn_link | default: '#' }}" class="hp16-hero-btn-{{ section_id }}">{{ section.settings.btn_text }}</a>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "HP16 Hero",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "NEW DROP IS HERE"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Y2K BABE"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "GIMME GIMME"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "HP16 Hero"
    }
  ]
}
{% endschema %}
