{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#030712' }};
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }
  .hp64-feat__container { max-width: {{ section.settings.container_width | default: 1280 }}px; margin: 0 auto; padding: 0 24px; }
  .hp64-feat__header { text-align: center; margin-bottom: 50px; }
  .hp64-feat__eyebrow { font-family: 'Space Grotesk', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: {{ section.settings.accent_color | default: '#06B6D4' }}; margin: 0 0 12px; }
  .hp64-feat__heading { font-family: 'Syne', sans-serif; font-size: clamp(28px, 3.5vw, 42px); font-weight: 800; color: #FFFFFF; margin: 0; }
  .hp64-feat__grid { display: grid; grid-template-columns: repeat({{ section.settings.columns | default: 3 }}, 1fr); gap: 24px; }
  .hp64-feat__card {
    background: {{ section.settings.card_bg | default: '#090D16' }};
    border: 1px solid rgba(6, 182, 212, 0.25); border-radius: 6px; padding: 28px 24px;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .hp64-feat__card:hover { transform: translateY(-4px); border-color: #06B6D4; box-shadow: 0 0 30px rgba(6, 182, 212, 0.3); }
  .hp64-feat__card-icon {
    width: 48px; height: 48px; background: linear-gradient(135deg, #083344, #06B6D4);
    border-radius: 4px; display: flex; align-items: center; justify-content: center;
    font-size: 20px; color: #FFFFFF; margin-bottom: 18px;
    border: 1px solid rgba(6, 182, 212, 0.4);
  }
  .hp64-feat__card-title { font-family: 'Syne', sans-serif; font-size: 17px; font-weight: 700; color: #FFFFFF; margin: 0 0 8px; }
  .hp64-feat__card-desc { font-size: 13px; line-height: 1.6; color: #94A3B8; margin: 0; font-family: 'Space Grotesk', sans-serif; }
  @media screen and (max-width: 992px) { .hp64-feat__grid { grid-template-columns: repeat(2, 1fr); } }
  @media screen and (max-width: 480px) { .hp64-feat__grid { grid-template-columns: 1fr; } }
{%- endstyle -%}
<div class="hp64-feat__container">
  <div class="hp64-feat__header">
    {%- if section.settings.eyebrow != blank -%}<p class="hp64-feat__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="hp64-feat__heading">{{ section.settings.heading | default: 'The Abyssal Biotech Matrix' }}</h2>
  </div>
  <div class="hp64-feat__grid">
    {%- for block in section.blocks -%}
      <div class="hp64-feat__card" {{ block.shopify_attributes }}>
        <div class="hp64-feat__card-icon">{{ block.settings.icon | default: '🧬' }}</div>
        <h3 class="hp64-feat__card-title">{{ block.settings.title | default: 'Luciferin' }}</h3>
        <p class="hp64-feat__card-desc">{{ block.settings.description | default: 'Bio-luminescent enzymes.' }}</p>
      </div>
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "HP64 Features",
  "class": "section-hp64-feat",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#030712" },
    { "type": "color", "id": "card_bg", "label": "Card BG", "default": "#090D16" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#06B6D4" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "🧬 BIOTECH MATRIX" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Abyssal Biotech Matrix" },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "label": "Columns", "default": 3 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "blocks": [{
    "type": "feature", "name": "Feature",
    "settings": [
      { "type": "text", "id": "icon", "label": "Icon", "default": "🧬" },
      { "type": "text", "id": "title", "label": "Title", "default": "Luciferin" },
      { "type": "textarea", "id": "description", "label": "Description", "default": "Bio-luminescent enzymes." }
    ]
  }],
  "presets": [{
    "name": "HP64 Features",
    "blocks": [
      { "type": "feature", "settings": { "icon": "🧬", "title": "Luciferin Photoprotein", "description": "Activates natural mitochondrial bioluminescence for inner light refraction and transparency." } },
      { "type": "feature", "settings": { "icon": "🌊", "title": "Benthic Vent Peptides", "description": "High-pressure thermal proteins repairing fragmented collagen scaffolding within 14 days." } },
      { "type": "feature", "settings": { "icon": "💎", "title": "Micro-Algae Astaxanthin", "description": "6,000x stronger than Vitamin C at neutralizing singlet oxygen free radical cascades." } },
      { "type": "feature", "settings": { "icon": "⚡", "title": "Mitochondrial Bio-Fuel", "description": "Increases intracellular ATP reserves to accelerate post-inflammatory cellular renewal." } },
      { "type": "feature", "settings": { "icon": "🛡️", "title": "HEV Blue Light Filter", "description": "Forms a microscopic protective photon shield against digital screens and device glare." } },
      { "type": "feature", "settings": { "icon": "🧪", "title": "Closed-Loop Bioreactor", "description": "Zero marine harvesting impact, cultured with absolute pharmaceutical purity." } }
    ]
  }]
}
{% endschema %}
