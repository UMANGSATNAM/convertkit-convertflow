{%- liquid
  assign bg_color = section.settings.bg_color | default: '#000000'
  assign text_color = section.settings.text_color | default: '#ffffff'
  assign overlay_color = section.settings.overlay_color | default: '#000000'
  assign overlay_opacity = section.settings.overlay_opacity | divided_by: 100.0
  
  assign padding_top_desktop = section.settings.padding_top_desktop
  assign padding_bottom_desktop = section.settings.padding_bottom_desktop
  assign padding_top_mobile = section.settings.padding_top_mobile
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile
  
  assign heading_size_desktop = section.settings.heading_size_desktop
  assign heading_size_mobile = section.settings.heading_size_mobile
  assign subheading_size = section.settings.subheading_size
  
  assign text_alignment = section.settings.text_alignment
  assign button_style = section.settings.button_style
  
  assign hero_height = section.settings.hero_height
-%}

<style>
  #shopify-section-{{ section.id }} {
    --hp2-bg-color: {{ bg_color }};
    --hp2-text-color: {{ text_color }};
    --hp2-overlay-bg: rgba({{ overlay_color | color_to_rgb | remove: 'rgb(' | remove: ')' }}, {{ overlay_opacity }});
    --hp2-padding-top-desk: {{ padding_top_desktop }}px;
    --hp2-padding-bottom-desk: {{ padding_bottom_desktop }}px;
    --hp2-padding-top-mob: {{ padding_top_mobile }}px;
    --hp2-padding-bottom-mob: {{ padding_bottom_mobile }}px;
    --hp2-heading-size-desk: {{ heading_size_desktop }}px;
    --hp2-heading-size-mob: {{ heading_size_mobile }}px;
    --hp2-subheading-size: {{ subheading_size }}px;
  }

  .hp2-fashion-hero-{{ section.id }} {
    position: relative;
    width: 100%;
    height: {{ hero_height }}vh;
    min-height: 600px;
    display: flex;
    align-items: center;
    background-color: var(--hp2-bg-color);
    color: var(--hp2-text-color);
    overflow: hidden;
    padding-top: var(--hp2-padding-top-desk);
    padding-bottom: var(--hp2-padding-bottom-desk);
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
  }

  /* Alignment Logic */
  .hp2-fashion-hero-{{ section.id }}.align-left { justify-content: flex-start; text-align: left; }
  .hp2-fashion-hero-{{ section.id }}.align-center { justify-content: center; text-align: center; }
  .hp2-fashion-hero-{{ section.id }}.align-right { justify-content: flex-end; text-align: right; }

  .hp2-hero-media-wrapper {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    z-index: 1;
    overflow: hidden;
  }

  .hp2-hero-media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: scale(1.05);
    animation: hp2HeroZoom 15s ease-out forwards;
  }

  @keyframes hp2HeroZoom {
    0% { transform: scale(1.05); }
    100% { transform: scale(1); }
  }

  .hp2-hero-overlay {
    position: absolute;
    inset: 0;
    background: var(--hp2-overlay-bg);
    z-index: 2;
    transition: background-color 0.3s ease;
  }

  .hp2-hero-content {
    position: relative;
    z-index: 3;
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .hp2-hero-subheading {
    font-size: var(--hp2-subheading-size);
    text-transform: uppercase;
    letter-spacing: 4px;
    font-weight: 700;
    margin: 0;
    opacity: 0;
    transform: translateY(20px);
    animation: hp2FadeUp 0.8s 0.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .hp2-hero-title {
    font-size: var(--hp2-heading-size-desk);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -2px;
    margin: 0;
    line-height: 0.9;
    opacity: 0;
    transform: translateY(20px);
    animation: hp2FadeUp 0.8s 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .hp2-hero-buttons {
    display: flex;
    gap: 15px;
    margin-top: 20px;
    opacity: 0;
    transform: translateY(20px);
    animation: hp2FadeUp 0.8s 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .hp2-fashion-hero-{{ section.id }}.align-center .hp2-hero-buttons {
    justify-content: center;
  }
  .hp2-fashion-hero-{{ section.id }}.align-right .hp2-hero-buttons {
    justify-content: flex-end;
  }

  /* Button Styles */
  .hp2-hero-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 18px 40px;
    text-decoration: none;
    text-transform: uppercase;
    font-weight: 800;
    letter-spacing: 1px;
    font-size: 14px;
    transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    min-width: 200px;
  }

  .hp2-hero-btn.btn-solid {
    background: var(--hp2-text-color);
    color: var(--hp2-bg-color);
    border: 2px solid var(--hp2-text-color);
  }
  .hp2-hero-btn.btn-solid:hover {
    background: transparent;
    color: var(--hp2-text-color);
  }

  .hp2-hero-btn.btn-outline {
    background: transparent;
    color: var(--hp2-text-color);
    border: 2px solid var(--hp2-text-color);
  }
  .hp2-hero-btn.btn-outline:hover {
    background: var(--hp2-text-color);
    color: var(--hp2-bg-color);
  }

  @keyframes hp2FadeUp {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Mobile Responsive */
  @media screen and (max-width: 768px) {
    .hp2-fashion-hero-{{ section.id }} {
      height: {{ section.settings.hero_height_mobile }}vh;
      min-height: 500px;
      padding-top: var(--hp2-padding-top-mob);
      padding-bottom: var(--hp2-padding-bottom-mob);
    }
    .hp2-hero-content {
      padding: 0 20px;
    }
    .hp2-hero-title {
      font-size: var(--hp2-heading-size-mob);
      letter-spacing: -1px;
    }
    .hp2-hero-subheading {
      font-size: 12px;
      letter-spacing: 2px;
    }
    .hp2-hero-buttons {
      flex-direction: column;
      width: 100%;
    }
    .hp2-hero-btn {
      width: 100%;
    }
  }

  /* Accessibility Preferences */
  @media (prefers-reduced-motion: reduce) {
    .hp2-hero-media { animation: none; transform: none; }
    .hp2-hero-subheading, .hp2-hero-title, .hp2-hero-buttons {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>

<section class="hp2-fashion-hero-{{ section.id }} align-{{ text_alignment }}" aria-label="{{ section.settings.heading | escape }}">
  
  <div class="hp2-hero-media-wrapper">
    {%- if section.settings.video_url != blank -%}
      <video autoplay loop muted playsinline class="hp2-hero-media" aria-hidden="true" disablepictureinpicture controlslist="nodownload">
        <source src="{{ section.settings.video_url }}" type="video/mp4">
      </video>
    {%- elsif section.settings.image_desktop != blank -%}
      <picture>
        {%- if section.settings.image_mobile != blank -%}
          <source media="(max-width: 768px)" srcset="{{ section.settings.image_mobile | image_url: width: 800 }}, {{ section.settings.image_mobile | image_url: width: 1200 }} 2x">
        {%- endif -%}
        <source media="(min-width: 769px)" srcset="{{ section.settings.image_desktop | image_url: width: 1400 }}, {{ section.settings.image_desktop | image_url: width: 2800 }} 2x">
        <img src="{{ section.settings.image_desktop | image_url: width: 1400 }}" class="hp2-hero-media" loading="eager" fetchpriority="high" alt="{{ section.settings.image_desktop.alt | escape }}">
      </picture>
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'hp2-hero-media placeholder-svg' }}
    {%- endif -%}
    
    <div class="hp2-hero-overlay"></div>
  </div>

  <div class="hp2-hero-content">
    {%- if section.settings.subheading != blank -%}
      <p class="hp2-hero-subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}
    
    {%- if section.settings.heading != blank -%}
      <h1 class="hp2-hero-title">{{ section.settings.heading }}</h1>
    {%- endif -%}
    
    <div class="hp2-hero-buttons">
      {%- if section.settings.btn_1_label != blank and section.settings.btn_1_link != blank -%}
        <a href="{{ section.settings.btn_1_link }}" class="hp2-hero-btn btn-solid" aria-label="{{ section.settings.btn_1_label | escape }}">
          {{ section.settings.btn_1_label }}
        </a>
      {%- endif -%}
      
      {%- if section.settings.btn_2_label != blank and section.settings.btn_2_link != blank -%}
        <a href="{{ section.settings.btn_2_link }}" class="hp2-hero-btn btn-outline" aria-label="{{ section.settings.btn_2_label | escape }}">
          {{ section.settings.btn_2_label }}
        </a>
      {%- endif -%}
    </div>
  </div>

</section>

{% schema %}
{
  "name": "HP2 Hero (Advanced)",
  "tag": "section",
  "class": "section-hp2-hero",
  "settings": [
    {
      "type": "header",
      "content": "Media Settings"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Desktop Background Image",
      "info": "Recommended size: 2800x1600px"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile Background Image (Optional)",
      "info": "Recommended size: 1200x1600px"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Direct Video URL (.mp4)",
      "info": "Overrides images if provided. Use a fast CDN link."
    },
    {
      "type": "header",
      "content": "Content Settings"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "FW26 COLLECTION"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "NEW ARRIVALS"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "btn_1_label",
      "label": "Primary Button Label",
      "default": "SHOP WOMENS"
    },
    {
      "type": "url",
      "id": "btn_1_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "btn_2_label",
      "label": "Secondary Button Label",
      "default": "SHOP MENS"
    },
    {
      "type": "url",
      "id": "btn_2_link",
      "label": "Secondary Button Link"
    },
    {
      "type": "header",
      "content": "Design & Layout"
    },
    {
      "type": "range",
      "id": "hero_height",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Desktop Height",
      "default": 100
    },
    {
      "type": "range",
      "id": "hero_height_mobile",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Mobile Height",
      "default": 80
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "min": 40,
      "max": 150,
      "step": 2,
      "unit": "px",
      "label": "Desktop Heading Size",
      "default": 100
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 30,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Mobile Heading Size",
      "default": 50
    },
    {
      "type": "range",
      "id": "subheading_size",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Subheading Size",
      "default": 14
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color (Fallback)",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Overlay Opacity",
      "default": 30
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Top (Desktop)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom (Desktop)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Top (Mobile)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom (Mobile)",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "HP2 Hero (Advanced)",
      "category": "Hero"
    }
  ]
}
{% endschema %}
