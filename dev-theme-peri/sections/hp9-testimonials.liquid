{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#0a0a0a'
  assign text_color = section.settings.text_color | default: '#ffffff'
  assign accent_color = section.settings.accent_color | default: '#00ff88'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 100px 20px;
    color: {{ text_color }};
    overflow: hidden;
    position: relative;
    border-top: 1px solid rgba(255,255,255,0.05);
    border-bottom: 1px solid rgba(255,255,255,0.05);
  }
  
  .hp9-testimonials-container-{{ section_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }
  
  .hp9-testimonials-header-{{ section_id }} {
    text-align: center;
    margin-bottom: 60px;
  }
  
  .hp9-testimonials-subheading-{{ section_id }} {
    font-family: 'Space Mono', monospace;
    font-size: 0.9rem;
    font-weight: 700;
    color: {{ accent_color }};
    margin: 0 0 10px 0;
    letter-spacing: 2px;
    text-transform: uppercase;
  }
  
  .hp9-testimonials-heading-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 900;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: -1px;
  }
  
  .hp9-testimonials-grid-{{ section_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
  }
  
  .hp9-testimonial-card-{{ section_id }} {
    background: #050505;
    border: 1px solid rgba(0, 255, 136, 0.2);
    padding: 40px 30px;
    position: relative;
    transition: all 0.3s ease;
  }
  
  .hp9-testimonial-card-{{ section_id }}:hover {
    border-color: {{ accent_color }};
    transform: translateY(-5px);
    box-shadow: 0 5px 20px rgba(0, 255, 136, 0.1);
  }
  
  /* Cyber corner cuts */
  .hp9-testimonial-card-{{ section_id }}::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 30px;
    height: 30px;
    background: {{ bg_color }};
    border-bottom-left-radius: 4px;
    border-left: 1px solid rgba(0, 255, 136, 0.2);
    border-bottom: 1px solid rgba(0, 255, 136, 0.2);
    transition: all 0.3s ease;
  }
  
  .hp9-testimonial-card-{{ section_id }}:hover::before {
    border-left-color: {{ accent_color }};
    border-bottom-color: {{ accent_color }};
  }
  
  .hp9-testimonial-stars-{{ section_id }} {
    color: {{ accent_color }};
    font-size: 1.2rem;
    margin-bottom: 20px;
    display: flex;
    gap: 5px;
  }
  
  .hp9-testimonial-text-{{ section_id }} {
    font-family: 'Space Mono', monospace;
    font-size: 0.95rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.8);
    margin: 0 0 30px 0;
    font-style: italic;
  }
  
  .hp9-testimonial-author-wrap-{{ section_id }} {
    display: flex;
    align-items: center;
    gap: 15px;
    border-top: 1px dashed rgba(255, 255, 255, 0.1);
    padding-top: 20px;
  }
  
  .hp9-testimonial-author-img-{{ section_id }} {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    object-fit: cover;
    filter: grayscale(100%);
    border: 1px solid {{ accent_color }};
  }
  
  .hp9-testimonial-author-info-{{ section_id }} {
    display: flex;
    flex-direction: column;
  }
  
  .hp9-testimonial-author-name-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-weight: 700;
    font-size: 1rem;
    color: #fff;
    margin: 0 0 2px 0;
  }
  
  .hp9-testimonial-author-role-{{ section_id }} {
    font-family: 'Space Mono', monospace;
    font-size: 0.75rem;
    color: {{ accent_color }};
    margin: 0;
    text-transform: uppercase;
  }

  @media (max-width: 992px) {
    .hp9-testimonials-grid-{{ section_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  @media (max-width: 768px) {
    .hp9-testimonials-grid-{{ section_id }} {
      grid-template-columns: 1fr;
    }
    .hp9-testimonial-card-{{ section_id }} {
      padding: 30px 20px;
    }
  }
</style>

<div class="hp9-testimonials-container-{{ section_id }}">
  <div class="hp9-testimonials-header-{{ section_id }}">
    <p class="hp9-testimonials-subheading-{{ section_id }}">{{ section.settings.subheading | default: '/// USER_LOGS' }}</p>
    <h2 class="hp9-testimonials-heading-{{ section_id }}">{{ section.settings.heading | default: 'FIELD REPORTS' }}</h2>
  </div>
  
  <div class="hp9-testimonials-grid-{{ section_id }}">
    {% for block in section.blocks limit: 3 %}
      <div class="hp9-testimonial-card-{{ section_id }}" {{ block.shopify_attributes }}>
        <div class="hp9-testimonial-stars-{{ section_id }}">
          {% for i in (1..5) %}
            {% if i <= block.settings.rating %}
              <span>★</span>
            {% else %}
              <span style="color: rgba(255,255,255,0.2)">★</span>
            {% endif %}
          {% endfor %}
        </div>
        
        <p class="hp9-testimonial-text-{{ section_id }}">"{{ block.settings.text | default: 'The integration was seamless. Latency dropped to near zero, giving me the edge I needed in the field. Highly recommended for any serious operative.' }}"</p>
        
        <div class="hp9-testimonial-author-wrap-{{ section_id }}">
          {% if block.settings.image != blank %}
            <img src="{{ block.settings.image | image_url: width: 100, height: 100, crop: 'center' }}" alt="{{ block.settings.author_name }}" class="hp9-testimonial-author-img-{{ section_id }}" loading="lazy">
          {% else %}
            <div class="hp9-testimonial-author-img-{{ section_id }}" style="background: #222; display:flex; align-items:center; justify-content:center; color:#555; font-size:10px;">ID</div>
          {% endif %}
          
          <div class="hp9-testimonial-author-info-{{ section_id }}">
            <h4 class="hp9-testimonial-author-name-{{ section_id }}">{{ block.settings.author_name | default: 'User 8942' }}</h4>
            <p class="hp9-testimonial-author-role-{{ section_id }}">{{ block.settings.author_role | default: 'Netrunner Elite' }}</p>
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "HP9 Testimonials",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#0a0a0a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#00ff88"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "/// USER_LOGS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FIELD REPORTS"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Rating",
          "default": 5
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Testimonial Text",
          "default": "The integration was seamless. Latency dropped to near zero, giving me the edge I needed in the field. Highly recommended for any serious operative."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Author Image"
        },
        {
          "type": "text",
          "id": "author_name",
          "label": "Author Name",
          "default": "User 8942"
        },
        {
          "type": "text",
          "id": "author_role",
          "label": "Author Role",
          "default": "Netrunner Elite"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP9 Testimonials",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" }
      ]
    }
  ]
}
{% endschema %}
