{%- style -%}
  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --font-heading: 'Lora', serif;
    --font-body: 'Outfit', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    position: relative;
    overflow: hidden;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }

  /* Organic grain texture overlay */
  {% if section.settings.show_grain %}
  #shopify-section-{{ section.id }}::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    opacity: 0.04;
    pointer-events: none;
    z-index: 1;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
  }
  {% endif %}

  .hp22-cat-tiles-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
    position: relative;
    z-index: 2;
  }

  @media screen and (max-width: 768px) {
    .hp22-cat-tiles-wrapper {
      padding: 0 20px;
    }
  }

  .hp22-cat-tiles__header {
    text-align: center;
    margin-bottom: {{ section.settings.header_margin }}px;
  }

  .hp22-cat-tiles__subtitle {
    font-family: var(--font-body);
    font-size: {{ section.settings.subtitle_size }}px;
    font-weight: 400;
    letter-spacing: 2px;
    color: var(--accent-color);
    text-transform: uppercase;
    margin: 0 0 16px;
  }

  .hp22-cat-tiles__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    font-weight: 400;
    color: var(--text-color);
    margin: 0;
    line-height: 1.2;
  }
  
  .hp22-cat-tiles__title em {
    font-style: italic;
    color: var(--accent-color);
  }

  /* Asymmetrical Grid */
  .hp22-cat-tiles__grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-auto-rows: 250px;
    gap: {{ section.settings.gap }}px;
  }

  @media screen and (max-width: 992px) {
    .hp22-cat-tiles__grid {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: minmax(200px, auto);
      gap: 20px;
    }
  }

  @media screen and (max-width: 480px) {
    .hp22-cat-tiles__grid {
      grid-template-columns: 1fr;
    }
  }

  .hp22-cat-tiles__item {
    position: relative;
    text-decoration: none;
    overflow: hidden;
    background: #EAE3D9;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.5s ease;
  }

  .hp22-cat-tiles__item:hover {
    transform: translateY(-5px);
  }

  /* Specific Grid Placements & Organic Shapes */
  .hp22-cat-tiles__item:nth-child(1) {
    grid-column: span 5;
    grid-row: span 2;
    border-radius: 200px 200px 20px 20px; /* Arch shape */
  }

  .hp22-cat-tiles__item:nth-child(2) {
    grid-column: span 7;
    grid-row: span 1;
    border-radius: 20px;
  }

  .hp22-cat-tiles__item:nth-child(3) {
    grid-column: span 3;
    grid-row: span 1;
    border-radius: 200px; /* Pill */
  }

  .hp22-cat-tiles__item:nth-child(4) {
    grid-column: span 4;
    grid-row: span 1;
    border-radius: 20px 200px 200px 20px; /* Sideways arch */
  }

  @media screen and (max-width: 992px) {
    .hp22-cat-tiles__item:nth-child(1),
    .hp22-cat-tiles__item:nth-child(2),
    .hp22-cat-tiles__item:nth-child(3),
    .hp22-cat-tiles__item:nth-child(4) {
      grid-column: span 1;
      grid-row: span 1;
      border-radius: 24px; /* Simplify shapes on mobile */
      aspect-ratio: 1/1;
    }
    
    .hp22-cat-tiles__item:nth-child(1) {
      grid-column: span 2;
      border-radius: 100px 100px 20px 20px;
    }
  }

  @media screen and (max-width: 480px) {
    .hp22-cat-tiles__item:nth-child(1),
    .hp22-cat-tiles__item:nth-child(2),
    .hp22-cat-tiles__item:nth-child(3),
    .hp22-cat-tiles__item:nth-child(4) {
      grid-column: span 1;
      border-radius: 24px;
      aspect-ratio: auto;
      height: 250px;
    }
  }

  .hp22-cat-tiles__image {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 3s ease;
  }

  .hp22-cat-tiles__item:hover .hp22-cat-tiles__image {
    transform: scale(1.05);
  }

  .hp22-cat-tiles__overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0,0,0, {{ section.settings.overlay_opacity }});
    transition: background 0.5s ease;
  }

  .hp22-cat-tiles__item:hover .hp22-cat-tiles__overlay {
    background: rgba(0,0,0, {{ section.settings.overlay_opacity_hover }});
  }

  .hp22-cat-tiles__content {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 20px;
  }

  .hp22-cat-tiles__label {
    font-family: var(--font-heading);
    font-size: {{ section.settings.label_size }}px;
    font-weight: 400;
    color: #ffffff;
    margin: 0;
    letter-spacing: 1px;
    transition: transform 0.4s ease;
  }
  
  .hp22-cat-tiles__item:hover .hp22-cat-tiles__label {
    transform: translateY(-5px);
  }

  .hp22-cat-tiles__link-text {
    font-family: var(--font-body);
    font-size: 13px;
    color: #ffffff;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-top: 10px;
    opacity: 0;
    transform: translateY(10px);
    transition: all 0.4s ease;
    display: block;
  }

  .hp22-cat-tiles__item:hover .hp22-cat-tiles__link-text {
    opacity: 1;
    transform: translateY(0);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp22-cat-tiles-wrapper" id="HP22CatTiles-{{ section.id }}">
  
  {%- if section.settings.title != blank or section.settings.subtitle != blank -%}
    <div class="hp22-cat-tiles__header">
      {%- if section.settings.subtitle != blank -%}
        <p class="hp22-cat-tiles__subtitle">{{ section.settings.subtitle | escape }}</p>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 class="hp22-cat-tiles__title">{{ section.settings.title }}</h2>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="hp22-cat-tiles__grid">
    {%- for block in section.blocks limit: 4 -%}
      <a href="{{ block.settings.link | default: '#' }}" class="hp22-cat-tiles__item" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          <img height="{{ block.settings.image.height }}" width="{{ block.settings.image.width }}" src="{{ block.settings.image | image_url: width: 1000 }}" alt="{{ block.settings.title | escape }}" class="hp22-cat-tiles__image" loading="lazy">
        {%- endif -%}
        
        <div class="hp22-cat-tiles__overlay"></div>
        
        <div class="hp22-cat-tiles__content">
          <h3 class="hp22-cat-tiles__label">{{ block.settings.title | escape }}</h3>
          <span class="hp22-cat-tiles__link-text">Shop Now</span>
        </div>
      </a>
    {%- endfor -%}
    
    {%- if section.blocks.size == 0 -%}
      {%- for i in (1..4) -%}
        <div class="hp22-cat-tiles__item">
          <div class="hp22-cat-tiles__overlay"></div>
          <div class="hp22-cat-tiles__content">
            <h3 class="hp22-cat-tiles__label">Category {{ i }}</h3>
            <span class="hp22-cat-tiles__link-text">Shop Now</span>
          </div>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>

</div>

{% schema %}
{
  "name": "HP22 - Organic Tiles",
  "class": "section-hp22-category-tiles",
  "max_blocks": 4,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "BY INGREDIENT"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Heading",
      "default": "<p>Discover Your <em>Element</em></p>"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1400
    },
    {
      "type": "range",
      "id": "header_margin",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Margin Below Header",
      "default": 50
    },
    {
      "type": "range",
      "id": "gap",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Grid Gap",
      "default": 30
    },
    {
      "type": "header",
      "content": "Overlay & Styling"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 0.9,
      "step": 0.1,
      "label": "Overlay Opacity (Normal)",
      "default": 0.3
    },
    {
      "type": "range",
      "id": "overlay_opacity_hover",
      "min": 0,
      "max": 0.9,
      "step": 0.1,
      "label": "Overlay Opacity (Hover)",
      "default": 0.5
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Section Heading Size",
      "default": 42
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Section Subtitle Size",
      "default": 14
    },
    {
      "type": "range",
      "id": "label_size",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Tile Label Size",
      "default": 32
    },
    {
      "type": "header",
      "content": "Organic Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#F9F6F0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#3A3A3A"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#8A9A86"
    },
    {
      "type": "checkbox",
      "id": "show_grain",
      "label": "Show subtle paper grain texture",
      "default": true
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Tile",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Category"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP22 - Organic Tiles",
      "blocks": [
        { "type": "category", "settings": { "title": "Botanical Oils" } },
        { "type": "category", "settings": { "title": "Clay Masks" } },
        { "type": "category", "settings": { "title": "Floral Waters" } },
        { "type": "category", "settings": { "title": "Apothecary" } }
      ]
    }
  ]
}
{% endschema %}
