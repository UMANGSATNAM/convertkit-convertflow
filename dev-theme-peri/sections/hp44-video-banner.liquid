{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp44-vid-bg: {{ section.settings.bg_color | default: '#EDF4EE' }};
    
    background-color: var(--hp44-vid-bg);
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
  }

  .hp44-video__box {
    max-width: {{ section.settings.container_width | default: 1240 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp44-video__media {
    width: 100%;
    height: {{ section.settings.video_height | default: 480 }}px;
    background: #143D2B;
    border-radius: 28px;
    border: 1px solid #D8E8DC;
    overflow: hidden;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 20px 50px rgba(20, 61, 43, 0.08);
  }

  .hp44-video__poster {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hp44-video__play-btn {
    position: absolute;
    width: 84px;
    height: 84px;
    background: #143D2B;
    border: 2px solid #FFFFFF;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #FFFFFF;
    font-size: 28px;
    cursor: pointer;
    box-shadow: 0 10px 30px rgba(0,0,0,0.3);
    transition: all 0.3s ease;
  }

  .hp44-video__play-btn:hover {
    transform: scale(1.1);
    background: #2D6A4F;
  }

  @media screen and (max-width: 768px) {
    .hp44-video__media {
      height: 320px;
    }
  }
{%- endstyle -%}

<div class="hp44-video__box">
  <div class="hp44-video__media">
    {%- if section.settings.poster_image != blank -%}
      <img src="{{ section.settings.poster_image | image_url: width: 1400 }}" class="hp44-video__poster" alt="{{ section.settings.title | default: 'Video' }}" loading="lazy">
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'hp44-video__poster' }}
    {%- endif -%}
    <div class="hp44-video__play-btn" onclick="alert('Playing Sage Extraction Documentary');">▶</div>
  </div>
</div>

{% schema %}
{
  "name": "HP44 - Sage Video",
  "class": "section-hp44-video",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#EDF4EE" },
    { "type": "image_picker", "id": "poster_image", "label": "Poster Image" },
    { "type": "text", "id": "video_url", "label": "Video URL" },
    { "type": "range", "id": "video_height", "min": 300, "max": 700, "step": 20, "unit": "px", "label": "Video Height", "default": 480 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 80 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1240 }
  ],
  "presets": [
    { "name": "HP44 - Sage Video" }
  ]
}
{% endschema %}
