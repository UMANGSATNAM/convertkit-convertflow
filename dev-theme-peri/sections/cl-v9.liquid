{% comment %} CL V9 — Vibrant Pop Art / Youth {% endcomment %}
{{ 'component-facets.css' | asset_url | stylesheet_tag }}
<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
<style>
  .clv9 { background: {{ section.settings.bg_color | default: '#E0E7FF' }}; color: {{ section.settings.text_color | default: '#312E81' }}; padding: 50px 20px; font-family: 'Comic Sans MS', 'Chalkboard SE', sans-serif; }
  .clv9-hero { text-align: center; margin-bottom: 40px; background: #6366F1; color: #FFF; padding: 40px; border-radius: 24px; box-shadow: 8px 8px 0px #312E81; border: 4px solid #312E81; }
  .clv9-hero h1 { font-size: 42px; font-weight: 900; margin-bottom: 10px; text-transform: uppercase; letter-spacing: 2px; }
  .clv9-chips { display: flex; gap: 15px; justify-content: center; margin-bottom: 40px; flex-wrap: wrap; }
  .clv9-chips a { padding: 12px 20px; background: #FFF; color: #312E81; text-decoration: none; border-radius: 12px; font-weight: bold; border: 3px solid #312E81; box-shadow: 4px 4px 0px #312E81; transition: 0.1s; }
  .clv9-chips a:hover, .clv9-chips a:active { transform: translate(4px, 4px); box-shadow: 0px 0px 0px #312E81; background: #FDE047; }
  .clv9-toolbar { background: #FFF; border: 4px solid #312E81; border-radius: 16px; padding: 20px; margin-bottom: 40px; box-shadow: 6px 6px 0px #312E81; }
  .clv9-grid { display: grid; grid-template-columns: repeat({{ section.settings.cols_desktop | default: 4 }}, 1fr); gap: 30px; }
  .clv9-promo { grid-column: span 1; background: #F43F5E; border: 4px solid #312E81; border-radius: 20px; padding: 30px; text-align: center; display: flex; flex-direction: column; justify-content: center; color: #FFF; box-shadow: 8px 8px 0px #312E81; }
  .clv9-promo h3 { font-size: 28px; font-weight: 900; margin-bottom: 15px; text-transform: uppercase; }
  .clv9-promo a { display: inline-block; padding: 12px 24px; background: #FDE047; color: #312E81; text-decoration: none; font-weight: bold; font-size: 16px; border: 3px solid #312E81; border-radius: 10px; box-shadow: 4px 4px 0px #312E81; }
  .clv9-seo { margin-top: 60px; padding: 40px; background: #FFF; border: 4px solid #312E81; border-radius: 24px; text-align: center; box-shadow: 8px 8px 0px #312E81; }
  @media (max-width: 768px) { .clv9-grid { grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr); gap: 20px; } .clv9-hero h1 { font-size: 32px; } }
</style>
<div class="clv9" style="max-width: 1400px; margin: 0 auto;">
  <div class="clv9-hero">
    <h1>{% if collection.title != blank %}{{ collection.title | escape }}{% else %}POP COLLECTION{% endif %}</h1>
    <p style="font-weight: bold; font-size: 18px;">{% if collection.description != blank %}{{ collection.description }}{% else %}Colors that POP. Styles that DROP.{% endif %}</p>
  </div>
  {% if section.settings.sub_collections != blank %}
    <div class="clv9-chips">
      {% for link in section.settings.sub_collections.links %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% endfor %}
    </div>
  {% endif %}
  <div class="clv9-toolbar">
    <facet-filters-form style="width: 100%;">
      <form id="FacetFiltersForm" style="display: flex; justify-content: space-between; align-items: center; width: 100%; flex-wrap: wrap; gap: 20px;">
        <div style="display: flex; gap: 20px;">
          {%- for filter in collection.filters -%}
            <details style="position: relative;">
              <summary style="cursor: pointer; font-size: 16px; font-weight: bold;">{{ filter.label }} ⬇️</summary>
              <div style="position: absolute; background: #FFF; border: 3px solid #312E81; padding: 20px; border-radius: 12px; z-index: 10; margin-top: 10px; min-width: 220px; box-shadow: 4px 4px 0px #312E81;">
                {%- for value in filter.values -%}
                  <label style="display: block; margin-bottom: 12px; cursor: pointer; font-size: 15px; font-weight: bold;">
                    <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %}>
                    {{ value.label }} ({{ value.count }})
                  </label>
                {%- endfor -%}
              </div>
            </details>
          {%- endfor -%}
        </div>
        <select name="sort_by" onchange="this.form.submit()" style="background: #FFF; border: 3px solid #312E81; color: #312E81; padding: 10px 15px; border-radius: 12px; font-size: 15px; font-weight: bold; cursor: pointer; box-shadow: 3px 3px 0px #312E81;">
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>
          {%- endfor -%}
        </select>
      </form>
    </facet-filters-form>
  </div>
  {% assign limit_num = section.settings.products_per_page | default: 16 %}
  {% paginate collection.products by limit_num %}
    <div class="clv9-grid">
      {% for product in collection.products %}
        {% render 'card-v9', product: product %}
        {% if forloop.index == 8 and section.settings.show_promo_tile %}
          <div class="clv9-promo">
            <h3>⚡ SUPER FLASH SALE ⚡</h3>
            <a href="/discount/FLASH">GRAB IT NOW!</a>
          </div>
        {% endif %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v9', product: nil %}
        {% endfor %}
      {% endfor %}
    </div>
    <div style="margin-top: 60px; text-align: center; font-weight: bold; font-size: 18px;">{{ paginate | default_pagination }}</div>
  {% endpaginate %}
  {% if section.settings.show_seo_block %}
    <div class="clv9-seo">
      <h2 style="font-size: 26px; font-weight: 900; margin-bottom: 15px; text-transform: uppercase;">{{ section.settings.seo_title | default: 'LOUD AND PROUD' }}</h2>
      <p style="font-size: 16px; font-weight: bold; max-width: 800px; margin: 0 auto; line-height: 1.6;">{{ section.settings.seo_text | default: 'We don’t do boring. Stand out with our vibrant, high-energy designs made to break the rules.' }}</p>
    </div>
  {% endif %}
</div>
{% schema %}
{
  "name": "CL V9 — Pop Art", "settings": [
    {"type": "range", "id": "products_per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 16},
    {"type": "range", "id": "cols_desktop", "label": "Desktop Columns", "min": 2, "max": 5, "default": 4},
    {"type": "select", "id": "cols_mobile", "label": "Mobile Columns", "options": [{"value": "1", "label": "1"}, {"value": "2", "label": "2"}], "default": "2"},
    {"type": "link_list", "id": "sub_collections", "label": "Sub-Collection Menu"},
    {"type": "checkbox", "id": "show_promo_tile", "label": "Show Promo Card", "default": true},
    {"type": "checkbox", "id": "show_seo_block", "label": "Show SEO Block", "default": true},
    {"type": "color", "id": "bg_color", "label": "Background Color", "default": "#E0E7FF"},
    {"type": "color", "id": "text_color", "label": "Text Color", "default": "#312E81"}
  ], "presets": [{"name": "CL V9 — Pop Art"}]
}
{% endschema %}
