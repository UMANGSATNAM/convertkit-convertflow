{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp48-story-bg: {{ section.settings.bg_color | default: '#FAF8F5' }};
    --hp48-gold: {{ section.settings.accent_gold | default: '#C59B27' }};
    
    background-color: var(--hp48-story-bg);
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }

  .hp48-story__container {
    max-width: {{ section.settings.container_width | default: 1240 }}px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 70px;
    align-items: center;
  }

  .hp48-story__media-frame {
    border-radius: 8px;
    overflow: hidden;
    height: 480px;
    background: #EAE6DF;
    border: 1px solid rgba(197, 155, 39, 0.4);
    box-shadow: 0 20px 50px rgba(26, 23, 21, 0.1);
  }

  .hp48-story__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hp48-story__subhead {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--hp48-gold);
    margin: 0 0 12px;
  }

  .hp48-story__title {
    font-family: 'Cinzel', serif;
    font-size: clamp(30px, 4vw, 44px);
    font-weight: 700;
    line-height: 1.2;
    color: #1A1715;
    margin: 0 0 20px;
  }

  .hp48-story__desc {
    font-size: 15px;
    line-height: 1.8;
    color: #5C554E;
    margin: 0 0 32px;
  }

  .hp48-story__stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    border-top: 1px solid rgba(197, 155, 39, 0.3);
    padding-top: 24px;
    margin-bottom: 36px;
  }

  .hp48-story__val {
    font-family: 'Cinzel', serif;
    font-size: 30px;
    font-weight: 700;
    color: var(--hp48-gold);
    margin: 0 0 4px;
  }

  .hp48-story__lbl {
    font-size: 10px;
    letter-spacing: 1px;
    font-weight: 700;
    color: #1A1715;
    margin: 0;
  }

  .hp48-story__btn {
    display: inline-flex;
    padding: 16px 36px;
    background: #1A1715;
    color: var(--hp48-gold);
    border: 1px solid var(--hp48-gold);
    font-family: 'Montserrat', sans-serif;
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    border-radius: 4px;
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .hp48-story__btn:hover {
    background: var(--hp48-gold);
    color: #1A1715;
    transform: translateY(-2px);
  }

  @media screen and (max-width: 992px) {
    .hp48-story__container { grid-template-columns: 1fr; text-align: center; }
    .hp48-story__media-frame { height: 340px; }
  }
{%- endstyle -%}

<div class="hp48-story__container">
  <div class="hp48-story__media-frame">
    {%- if section.settings.image != blank -%}
      <img height="{{ section.settings.image.height }}" width="{{ section.settings.image.width }}" src="{{ section.settings.image | image_url: width: 1000 }}" class="hp48-story__img" alt="Royal Atelier" loading="lazy">
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'hp48-story__img' }}
    {%- endif -%}
  </div>

  <div>
    <p class="hp48-story__subhead">IMPERIAL ATELIER</p>
    <h2 class="hp48-story__title">{{ section.settings.heading | default: 'Pure 24K Sovereign Alchemy & Haute Radiance' }}</h2>
    <p class="hp48-story__desc">
      {{ section.settings.description | default: 'Hand-blended in our Swiss alpine laboratory using ethically sourced 24-karat gold leaves and Piedmont white truffles. A luxurious sensory ritual designed for eternal vitality.' }}
    </p>

    <div class="hp48-story__stats">
      <div>
        <p class="hp48-story__val">24K</p>
        <p class="hp48-story__lbl">PURE COLLOIDAL GOLD</p>
      </div>
      <div>
        <p class="hp48-story__val">99.8%</p>
        <p class="hp48-story__lbl">SWISS FORMULATION</p>
      </div>
      <div>
        <p class="hp48-story__val">100%</p>
        <p class="hp48-story__lbl">WHITE-GLOVE DDP</p>
      </div>
    </div>

    <a href="{{ section.settings.btn_url | default: '/pages/about' }}" class="hp48-story__btn">
      {{ section.settings.btn_text | default: 'Discover Imperial Archive &rarr;' }}
    </a>
  </div>
</div>

{% schema %}
{
  "name": "HP48 - Royal Story",
  "class": "section-hp48-story",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#FAF8F5" },
    { "type": "color", "id": "accent_gold", "label": "Gold Accent", "default": "#C59B27" },
    { "type": "image_picker", "id": "image", "label": "Story Image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pure 24K Sovereign Alchemy & Haute Radiance" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Hand-blended in our Swiss alpine laboratory using ethically sourced 24-karat gold leaves." },
    { "type": "text", "id": "btn_text", "label": "Button Text", "default": "Discover Imperial Archive →" },
    { "type": "url", "id": "btn_url", "label": "Button URL" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1240 }
  ],
  "presets": [
    { "name": "HP48 - Royal Story" }
  ]
}
{% endschema %}
