{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp46-faq-bg: {{ section.settings.bg_color | default: '#0B0F19' }};
    
    background-color: var(--hp46-faq-bg);
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
  }

  .hp46-faq__wrap {
    max-width: {{ section.settings.container_width | default: 860 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp46-faq__header {
    text-align: center;
    margin-bottom: 45px;
  }

  .hp46-faq__heading {
    font-family: 'Syne', sans-serif;
    font-size: clamp(28px, 4vw, 40px);
    font-weight: 800;
    color: #FFFFFF;
    margin: 0 0 8px;
  }

  .hp46-faq__heading span {
    background: linear-gradient(135deg, #38BDF8, #F472B6);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hp46-faq__item {
    background: rgba(15, 23, 42, 0.65);
    backdrop-filter: blur(14px);
    border: 1px solid rgba(56, 189, 248, 0.2);
    border-radius: 20px;
    padding: 24px 28px;
    margin-bottom: 16px;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .hp46-faq__item:hover {
    border-color: #F472B6;
  }

  .hp46-faq__q {
    font-family: 'Syne', sans-serif;
    font-size: 16px;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .hp46-faq__a {
    font-size: 14px;
    line-height: 1.7;
    color: #94A3B8;
    margin: 14px 0 0;
    padding-top: 14px;
    border-top: 1px solid rgba(56, 189, 248, 0.15);
  }
{%- endstyle -%}

<div class="hp46-faq__wrap">
  <div class="hp46-faq__header">
    <h2 class="hp46-faq__heading">CYBER <span>KNOWLEDGE BASE</span></h2>
    <p style="font-size:14px; color:#94A3B8;">{{ section.settings.subheading | default: 'Instant answers on cellular bio-luminescence, packaging, and shipping.' }}</p>
  </div>

  {%- if section.blocks.size > 0 -%}
    {%- for block in section.blocks -%}
      <div class="hp46-faq__item" {{ block.shopify_attributes }}>
        <h3 class="hp46-faq__q">
          <span>{{ block.settings.question }}</span>
          <span style="color:#38BDF8;">+</span>
        </h3>
        <p class="hp46-faq__a">{{ block.settings.answer }}</p>
      </div>
    {%- endfor -%}
  {%- else -%}
    <div class="hp46-faq__item">
      <h3 class="hp46-faq__q"><span>How does holographic bio-luminescence work on skin?</span><span style="color:#38BDF8;">+</span></h3>
      <p class="hp46-faq__a">Phytoplankton enzymes interact with natural skin lipids to refract light across the visible spectrum, creating a radiant prismatic reflection without synthetic glitter.</p>
    </div>
    <div class="hp46-faq__item">
      <h3 class="hp46-faq__q"><span>Are international customs duties included?</span><span style="color:#38BDF8;">+</span></h3>
      <p class="hp46-faq__a">Yes, all international tariffs and customs taxes are 100% pre-paid at checkout, ensuring swift door delivery to 180+ countries worldwide.</p>
    </div>
    <div class="hp46-faq__item">
      <h3 class="hp46-faq__q"><span>Is the formula suitable for sensitive skin?</span><span style="color:#38BDF8;">+</span></h3>
      <p class="hp46-faq__a">Yes, all formulas are hypoallergenic, non-comedogenic, cruelty-free, and independently tested by certified dermatologists.</p>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "HP46 - Cyber FAQ",
  "class": "section-hp46-faq",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#0B0F19" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Instant answers on cellular bio-luminescence, packaging, and shipping." },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 80 },
    { "type": "range", "id": "container_width", "min": 600, "max": 1200, "step": 20, "unit": "px", "label": "Container Width", "default": 860 }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How does holographic bio-luminescence work?" },
        { "type": "textarea", "id": "answer", "label": "Answer", "default": "Phytoplankton enzymes interact with natural skin lipids." }
      ]
    }
  ],
  "presets": [
    { "name": "HP46 - Cyber FAQ" }
  ]
}
{% endschema %}
