{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#050505'
  assign text_color = section.settings.text_color | default: '#00FFA3'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 100px 40px;
    border-bottom: 1px solid #333;
    text-align: center;
    color: #FFF;
  }
  
  .hp13-newsletter-container-{{ section_id }} {
    max-width: 600px;
    margin: 0 auto;
    border: 1px solid {{ text_color }};
    padding: 60px 40px;
    background: #111;
    position: relative;
  }
  
  .hp13-newsletter-container-{{ section_id }}::before {
    content: '[SECURE_COMMS]';
    position: absolute;
    top: -10px; left: 20px;
    background: {{ bg_color }};
    padding: 0 10px;
    color: {{ text_color }};
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.8rem;
    font-weight: bold;
  }
  
  .hp13-newsletter-heading-{{ section_id }} {
    font-family: 'Arial Black', Impact, sans-serif;
    font-size: clamp(2rem, 4vw, 2.5rem);
    font-weight: 900;
    margin: 0 0 20px 0;
    text-transform: uppercase;
    letter-spacing: 2px;
  }
  
  .hp13-newsletter-text-{{ section_id }} {
    font-family: 'Courier New', Courier, monospace;
    font-size: 1rem;
    line-height: 1.6;
    margin: 0 0 40px 0;
    color: #CCC;
  }
  
  .hp13-newsletter-form-{{ section_id }} {
    display: flex;
    flex-direction: column;
    gap: 15px;
  }
  
  .hp13-newsletter-input-{{ section_id }} {
    width: 100%;
    padding: 15px;
    background: #000;
    border: 1px solid #333;
    color: #FFF;
    font-family: 'Courier New', Courier, monospace;
    font-size: 1rem;
    outline: none;
    transition: border-color 0.3s ease;
  }
  
  .hp13-newsletter-input-{{ section_id }}:focus {
    border-color: {{ text_color }};
  }
  
  .hp13-newsletter-btn-{{ section_id }} {
    background: {{ text_color }};
    color: {{ bg_color }};
    border: none;
    font-family: 'Courier New', Courier, monospace;
    font-size: 1rem;
    font-weight: bold;
    text-transform: uppercase;
    padding: 15px;
    cursor: pointer;
    box-shadow: 4px 4px 0 rgba(255,255,255,0.2);
    transition: all 0.2s ease;
  }
  
  .hp13-newsletter-btn-{{ section_id }}:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 rgba(255,255,255,0.2);
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 60px 20px;
    }
    .hp13-newsletter-container-{{ section_id }} {
      padding: 40px 20px;
    }
  }
</style>

<div class="hp13-newsletter-container-{{ section_id }}">
  <h2 class="hp13-newsletter-heading-{{ section_id }}">{{ section.settings.heading | default: 'INIT_TRANSMISSION' }}</h2>
  <div class="hp13-newsletter-text-{{ section_id }}">
    {{ section.settings.text | default: 'Establish a direct link to the mainframe. Receive intel on new gear, restricted drops, and grid coordinates.' }}
  </div>
  
  {% form 'customer', class: 'hp13-newsletter-form-' | append: section_id %}
    <input type="hidden" name="contact[tags]" value="newsletter">
    <input type="email" name="contact[email]" class="hp13-newsletter-input-{{ section_id }}" placeholder="ENTER_ID@DOMAIN.COM" required>
    <button type="submit" class="hp13-newsletter-btn-{{ section_id }}">ESTABLISH_LINK</button>
  {% endform %}
</div>

{% schema %}
{
  "name": "HP13 Newsletter",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#050505"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Highlight Color",
      "default": "#00FFA3"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "INIT_TRANSMISSION"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Establish a direct link to the mainframe. Receive intel on new gear, restricted drops, and grid coordinates."
    }
  ],
  "presets": [
    {
      "name": "HP13 Newsletter"
    }
  ]
}
{% endschema %}
