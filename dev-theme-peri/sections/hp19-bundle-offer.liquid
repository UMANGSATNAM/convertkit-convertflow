{%- style -%}
  #shopify-section-{{ section.id }} {
    --padding-top: {{ section.settings.padding_top }}px;
    --padding-bottom: {{ section.settings.padding_bottom }}px;
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --card-bg: {{ section.settings.card_bg }};
    --btn-bg: {{ section.settings.btn_bg_color }};
    --btn-text: {{ section.settings.btn_text_color }};
    
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
    background-color: var(--bg-color);
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      --padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      --padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }

  .hp19-bundle-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 24px;
  }
  
  .hp19-bundle__header {
    text-align: center;
    margin-bottom: {{ section.settings.header_margin }}px;
  }

  .hp19-bundle__title {
    font-family: 'Baskerville', 'Georgia', serif;
    font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
    color: var(--text-color);
    margin: 0 0 16px;
    font-style: italic;
  }
  
  .hp19-bundle__subtitle {
    font-family: 'Inter', sans-serif;
    font-size: {{ section.settings.subtitle_size }}px;
    color: var(--text-color);
    opacity: 0.8;
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .hp19-bundle__container {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--card-bg);
    border-radius: {{ section.settings.card_radius }}px;
    padding: {{ section.settings.card_padding }}px;
    box-shadow: 0 20px 40px rgba(0,0,0,0.05);
    border: 1px solid rgba(0,0,0,0.05);
  }
  
  @media screen and (max-width: 992px) {
    .hp19-bundle__container {
      flex-direction: column;
    }
  }

  .hp19-bundle__products {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: space-around;
    width: 100%;
    position: relative;
  }
  
  @media screen and (max-width: 768px) {
    .hp19-bundle__products {
      flex-direction: column;
      gap: 32px;
    }
  }
  
  .hp19-bundle__product-item {
    text-align: center;
    width: 100%;
    max-width: 250px;
  }
  
  .hp19-bundle__img-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 1/1;
    border-radius: {{ section.settings.image_radius }}px;
    overflow: hidden;
    margin-bottom: 24px;
    background: #f9f9f9;
  }
  
  .hp19-bundle__img-wrapper img {
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  
  .hp19-bundle__img-wrapper:hover img {
    transform: scale(1.05);
  }
  
  .hp19-bundle__plus {
    font-size: 32px;
    color: var(--accent-color);
    font-weight: 300;
  }
  
  @media screen and (max-width: 768px) {
    .hp19-bundle__plus {
      transform: rotate(90deg);
    }
  }

  .hp19-bundle__product-title {
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    font-weight: 600;
    color: var(--text-color);
    margin: 0 0 8px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }
  
  .hp19-bundle__product-price {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    color: var(--text-color);
    opacity: 0.7;
  }

  .hp19-bundle__summary {
    width: 320px;
    padding-left: 48px;
    border-left: 1px solid rgba(0,0,0,0.1);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  
  @media screen and (max-width: 992px) {
    .hp19-bundle__summary {
      width: 100%;
      padding-left: 0;
      padding-top: 48px;
      margin-top: 48px;
      border-left: none;
      border-top: 1px solid rgba(0,0,0,0.1);
      align-items: center;
      text-align: center;
    }
  }
  
  .hp19-bundle__price-block {
    margin-bottom: 32px;
  }
  
  .hp19-bundle__price-label {
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--text-color);
    opacity: 0.6;
    margin-bottom: 8px;
  }
  
  .hp19-bundle__total-price {
    font-family: 'Baskerville', 'Georgia', serif;
    font-size: 40px;
    color: var(--text-color);
    line-height: 1;
    margin-bottom: 8px;
  }
  
  .hp19-bundle__compare-price {
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    color: var(--text-color);
    opacity: 0.5;
    text-decoration: line-through;
  }
  
  .hp19-bundle__save-badge {
    display: inline-block;
    background: var(--accent-color);
    color: var(--bg-color);
    padding: 4px 12px;
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    border-radius: 20px;
    margin-left: 12px;
    vertical-align: middle;
  }

  .hp19-bundle__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: var(--btn-bg);
    color: var(--btn-text);
    padding: 16px 32px;
    font-family: 'Inter', sans-serif;
    font-weight: 600;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 2px;
    text-decoration: none;
    border-radius: {{ section.settings.btn_radius }}px;
    transition: all 0.3s ease;
    width: 100%;
    cursor: pointer;
    border: none;
  }

  .hp19-bundle__btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgba(0,0,0,0.1);
    opacity: 0.9;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp19-bundle-wrapper" id="HP19Bundle-{{ section.id }}">
  <div class="hp19-bundle__header">
    {%- if section.settings.title != blank -%}
      <h2 class="hp19-bundle__title">{{ section.settings.title | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.subtitle != blank -%}
      <p class="hp19-bundle__subtitle">{{ section.settings.subtitle | escape }}</p>
    {%- endif -%}
  </div>

  <div class="hp19-bundle__container">
    <div class="hp19-bundle__products">
      {%- assign total_price = 0 -%}
      {%- assign compare_price = 0 -%}
      {%- assign product_count = 0 -%}
      
      {%- for block in section.blocks -%}
        {%- if block.type == 'product' -%}
          {%- assign prod = all_products[block.settings.product] -%}
          
          <div class="hp19-bundle__product-item" {{ block.shopify_attributes }}>
            <div class="hp19-bundle__img-wrapper">
              {%- if prod != blank and prod.featured_image != blank -%}
                <img src="{{ prod.featured_image | image_url: width: 400 }}" alt="{{ prod.title | escape }}" loading="lazy">
              {%- else -%}
                {{ 'product-' | append: forloop.index | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            
            <h3 class="hp19-bundle__product-title">
              {%- if prod != blank -%}{{ prod.title }}{%- else -%}Select a product{%- endif -%}
            </h3>
            
            <div class="hp19-bundle__product-price">
              {%- if prod != blank -%}
                {{ prod.price | money }}
                {%- assign total_price = total_price | plus: prod.price -%}
                {%- assign current_compare = prod.compare_at_price | default: prod.price -%}
                {%- assign compare_price = compare_price | plus: current_compare -%}
              {%- else -%}
                $35.00
                {%- assign total_price = total_price | plus: 3500 -%}
                {%- assign compare_price = compare_price | plus: 4500 -%}
              {%- endif -%}
            </div>
          </div>
          
          {%- assign product_count = product_count | plus: 1 -%}
          {%- if product_count < section.blocks.size -%}
            <div class="hp19-bundle__plus">+</div>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
    
    <div class="hp19-bundle__summary">
      <div class="hp19-bundle__price-block">
        <div class="hp19-bundle__price-label">Bundle Price</div>
        
        {%- if section.settings.discount_type == 'percentage' -%}
          {%- assign discount_multiplier = 100 | minus: section.settings.discount_value | divided_by: 100.0 -%}
          {%- assign final_price = total_price | times: discount_multiplier | round -%}
        {%- else -%}
          {%- assign discount_cents = section.settings.discount_value | times: 100 -%}
          {%- assign final_price = total_price | minus: discount_cents | at_least: 0 -%}
        {%- endif -%}
        
        <div class="hp19-bundle__total-price">
          {{ final_price | money }}
        </div>
        
        <div class="hp19-bundle__compare-price">
          {{ total_price | money }}
          <span class="hp19-bundle__save-badge">Save {{ total_price | minus: final_price | money }}</span>
        </div>
      </div>
      
      <button type="button" class="hp19-bundle__btn">
        {{ section.settings.btn_text | escape }}
      </button>
      
      {% if section.settings.show_disclaimer %}
      <div style="font-family:'Inter',sans-serif;font-size:11px;opacity:0.6;margin-top:16px;text-align:center;">
        *Includes free shipping on this bundle.
      </div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "HP19 - Bundle Offer Pro",
  "class": "section-hp19-bundle-offer",
  "max_blocks": 3,
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "The Morning Ritual Bundle"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Everything you need for the perfect start to your day. Curated perfectly to compliment each other."
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 48
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Subtitle Size",
      "default": 16
    },
    {
      "type": "range",
      "id": "header_margin",
      "min": 20,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Spacing Below Header",
      "default": 48
    },
    {
      "type": "header",
      "content": "Bundle Logic"
    },
    {
      "type": "select",
      "id": "discount_type",
      "label": "Discount Type",
      "options": [
        { "value": "percentage", "label": "Percentage (%)" },
        { "value": "fixed", "label": "Fixed Amount ($)" }
      ],
      "default": "percentage"
    },
    {
      "type": "number",
      "id": "discount_value",
      "label": "Discount Value",
      "default": 15,
      "info": "Enter 15 for 15% or 15 for $15"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "Add Bundle to Cart"
    },
    {
      "type": "checkbox",
      "id": "show_disclaimer",
      "label": "Show Disclaimer Text",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 800,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1200
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Container Border Radius",
      "default": 20
    },
    {
      "type": "range",
      "id": "card_padding",
      "min": 20,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Container Padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "image_radius",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Product Image Radius",
      "default": 12
    },
    {
      "type": "range",
      "id": "btn_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Button Border Radius",
      "default": 0
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#FFFBEB"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#451A03"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Container Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color (Plus & Badge)",
      "default": "#D97706"
    },
    {
      "type": "color",
      "id": "btn_bg_color",
      "label": "Button Background",
      "default": "#451A03"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Button Text Color",
      "default": "#FFFBEB"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 100
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP19 - Bundle Offer Pro",
      "category": "Product",
      "blocks": [
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
