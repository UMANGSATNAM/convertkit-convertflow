{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Lato:wght@300;400;700&family=Playfair+Display:ital,wght@0,400;0,500;1,400&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --btn-bg: {{ section.settings.btn_bg }};
    --btn-text: {{ section.settings.btn_text }};
    
    --font-heading: 'Playfair Display', serif;
    --font-body: 'Lato', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .hp31-bundle-wrapper {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    align-items: center;
    gap: 80px;
  }

  @media screen and (max-width: 992px) {
    .hp31-bundle-wrapper {
      flex-direction: column;
      gap: 40px;
      padding: 0 20px;
    }
  }

  .hp31-bundle__content-col {
    flex: 1;
    max-width: 500px;
  }

  @media screen and (max-width: 992px) {
    .hp31-bundle__content-col {
      order: 2;
      text-align: center;
      margin: 0 auto;
    }
  }

  .hp31-bundle__tagline {
    font-family: var(--font-body);
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-color);
    margin-bottom: 20px;
    display: block;
    opacity: 0.6;
  }

  .hp31-bundle__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 4vw, {{ section.settings.title_size }}px);
    line-height: 1.2;
    color: var(--text-color);
    margin: 0 0 16px;
    font-weight: 400;
  }

  .hp31-bundle__title em {
    font-style: italic;
  }

  .hp31-bundle__price-wrap {
    display: flex;
    align-items: baseline;
    gap: 15px;
    margin-bottom: 30px;
  }

  @media screen and (max-width: 992px) {
    .hp31-bundle__price-wrap {
      justify-content: center;
    }
  }

  .hp31-bundle__price {
    font-family: var(--font-heading);
    font-size: 28px;
    color: var(--text-color);
  }

  .hp31-bundle__price-old {
    font-family: var(--font-body);
    font-size: 16px;
    color: var(--text-color);
    text-decoration: line-through;
    opacity: 0.5;
  }

  .hp31-bundle__text {
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.8;
    color: var(--text-color);
    opacity: 0.7;
    margin: 0 0 40px;
    font-weight: 300;
  }

  .hp31-bundle__list {
    list-style: none;
    padding: 0;
    margin: 0 0 40px;
    border-top: 1px solid rgba(0,0,0,0.1);
  }

  .hp31-bundle__list li {
    padding: 16px 0;
    border-bottom: 1px solid rgba(0,0,0,0.1);
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--text-color);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .hp31-bundle__list li span {
    opacity: 0.5;
  }

  .hp31-bundle__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 36px;
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    background: var(--btn-bg);
    color: var(--btn-text);
    border-radius: 50px;
    border: 1px solid var(--btn-bg);
    transition: all 0.4s ease;
  }

  .hp31-bundle__btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgba(0,0,0,0.05);
    background: transparent;
    color: var(--text-color);
    border-color: var(--text-color);
  }

  .hp31-bundle__image-col {
    flex: 1.2;
    position: relative;
  }

  @media screen and (max-width: 992px) {
    .hp31-bundle__image-col {
      order: 1;
      width: 100%;
    }
  }

  .hp31-bundle__image-wrap {
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    background: #E8E2D6;
    aspect-ratio: 4/5;
  }

  .hp31-bundle__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Hotspots */
  .hp31-bundle__hotspot {
    position: absolute;
    width: 24px;
    height: 24px;
    background: rgba(255,255,255,0.9);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    cursor: pointer;
    box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
  }

  .hp31-bundle__hotspot::after {
    content: '';
    width: 8px;
    height: 8px;
    background: var(--text-color);
    border-radius: 50%;
  }

  .hp31-bundle__hotspot:hover {
    transform: translate(-50%, -50%) scale(1.1);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp31-bundle-wrapper" id="HP31Bundle-{{ section.id }}">
  <div class="hp31-bundle__content-col">
    {%- if section.settings.tagline != blank -%}
      <span class="hp31-bundle__tagline">{{ section.settings.tagline }}</span>
    {%- endif -%}
    
    <h2 class="hp31-bundle__title">{{ section.settings.title }}</h2>
    
    <div class="hp31-bundle__price-wrap">
      <span class="hp31-bundle__price">{{ section.settings.price }}</span>
      {%- if section.settings.compare_price != blank -%}
        <span class="hp31-bundle__price-old">{{ section.settings.compare_price }}</span>
      {%- endif -%}
    </div>
    
    <p class="hp31-bundle__text">{{ section.settings.text }}</p>
    
    <ul class="hp31-bundle__list">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}>
          {{ block.settings.item_name }} 
          <span>{{ block.settings.item_detail }}</span>
        </li>
      {%- endfor -%}
    </ul>
    
    {%- if section.settings.btn_label != blank -%}
      <a href="{{ section.settings.btn_link | default: '#' }}" class="hp31-bundle__btn">
        {{ section.settings.btn_label }}
      </a>
    {%- endif -%}
  </div>

  <div class="hp31-bundle__image-col">
    <div class="hp31-bundle__image-wrap">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 1000 }}" alt="{{ section.settings.title | escape }}" class="hp31-bundle__image" loading="lazy">
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'hp31-bundle__image' }}
      {%- endif -%}

      <!-- Demo hotspots -->
      <div class="hp31-bundle__hotspot" style="top: 30%; left: 40%;" title="Hotspot 1"></div>
      <div class="hp31-bundle__hotspot" style="top: 60%; left: 60%;" title="Hotspot 2"></div>
      <div class="hp31-bundle__hotspot" style="top: 75%; left: 35%;" title="Hotspot 3"></div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "HP31 - Zen Bundle",
  "class": "section-hp31-bundle-offer",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Bundle Image"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "The Essentials Set"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Heading",
      "default": "Curated for <em>harmony</em>."
    },
    {
      "type": "text",
      "id": "price",
      "label": "Price",
      "default": "$145"
    },
    {
      "type": "text",
      "id": "compare_price",
      "label": "Compare Price",
      "default": "$180"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "A mindful collection of our core pieces, designed to complement each other and bring balance to your space."
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "Shop The Set"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 48
    },
    {
      "type": "header",
      "content": "Zen Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (Beige)",
      "default": "#F9F6F0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text (Charcoal)",
      "default": "#2C2C2C"
    },
    {
      "type": "color",
      "id": "btn_bg",
      "label": "Button Background",
      "default": "#2C2C2C"
    },
    {
      "type": "color",
      "id": "btn_text",
      "label": "Button Text",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 100
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Bundle Item",
      "settings": [
        {
          "type": "text",
          "id": "item_name",
          "label": "Item Name",
          "default": "Ceramic Pour Over"
        },
        {
          "type": "text",
          "id": "item_detail",
          "label": "Detail/Size",
          "default": "Matte White"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP31 - Zen Bundle",
      "blocks": [
        { "type": "item" },
        { "type": "item", "settings": { "item_name": "Glass Carafe", "item_detail": "500ml" } },
        { "type": "item", "settings": { "item_name": "Oak Tray", "item_detail": "Small" } }
      ]
    }
  ]
}
{% endschema %}
