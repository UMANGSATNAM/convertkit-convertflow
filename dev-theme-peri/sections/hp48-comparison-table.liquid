{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp48-comp-bg: {{ section.settings.bg_color | default: '#FAF8F5' }};
    --hp48-gold: {{ section.settings.accent_gold | default: '#C59B27' }};
    
    background-color: var(--hp48-comp-bg);
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }

  .hp48-comp__wrap {
    max-width: {{ section.settings.container_width | default: 980 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp48-comp__header {
    text-align: center;
    margin-bottom: 45px;
  }

  .hp48-comp__heading {
    font-family: 'Cinzel', serif;
    font-size: clamp(30px, 4vw, 42px);
    font-weight: 700;
    color: #1A1715;
    margin: 0 0 8px;
  }

  .hp48-comp__card {
    background: #FFFFFF;
    border: 1px solid rgba(197, 155, 39, 0.35);
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 15px 40px rgba(197, 155, 39, 0.08);
  }

  .hp48-comp__table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }

  .hp48-comp__table th, .hp48-comp__table td {
    padding: 18px 24px;
    text-align: center;
    border-bottom: 1px solid rgba(197, 155, 39, 0.2);
    color: #1A1715;
  }

  .hp48-comp__table th {
    font-family: 'Cinzel', serif;
    font-weight: 700;
    letter-spacing: 1px;
    background: #FAF8F5;
  }

  .hp48-comp__highlight {
    background: rgba(197, 155, 39, 0.08);
    font-weight: 700;
    color: var(--hp48-gold) !important;
  }

  @media screen and (max-width: 600px) {
    .hp48-comp__table th, .hp48-comp__table td { padding: 12px 10px; font-size: 12px; }
  }
{%- endstyle -%}

<div class="hp48-comp__wrap">
  <div class="hp48-comp__header">
    <h2 class="hp48-comp__heading">The Sovereign Gold Standard</h2>
    <p style="font-size:13px; color:#5C554E;">{{ section.settings.subheading | default: 'Pure 24K colloidal gold & white truffle vs synthetic diluted skincare.' }}</p>
  </div>

  <div class="hp48-comp__card">
    <table class="hp48-comp__table">
      <thead>
        <tr>
          <th style="text-align:left;">Precious Parameter</th>
          <th class="hp48-comp__highlight">Peri Royal v48</th>
          <th>Conventional Luxury</th>
        </tr>
      </thead>
      <tbody>
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <td style="text-align:left; font-weight:600;">{{ block.settings.feature }}</td>
              <td class="hp48-comp__highlight">{{ block.settings.brand_val }}</td>
              <td>{{ block.settings.other_val }}</td>
            </tr>
          {%- endfor -%}
        {%- else -%}
          <tr>
            <td style="text-align:left; font-weight:600;">Gold Infusion Purity</td>
            <td class="hp48-comp__highlight">24K Micronized Colloidal Gold</td>
            <td>Synthetic Mica Gold Pigment</td>
          </tr>
          <tr>
            <td style="text-align:left; font-weight:600;">Rare Botanical Source</td>
            <td class="hp48-comp__highlight">Wild Piedmont White Truffle Nectar</td>
            <td>Standard Synthetic Lab Fragrance</td>
          </tr>
          <tr>
            <td style="text-align:left; font-weight:600;">Vessel Finishing</td>
            <td class="hp48-comp__highlight">Heavyweight Glass &amp; 24K Gold Plating</td>
            <td>Lightweight Electroplated Plastic</td>
          </tr>
          <tr>
            <td style="text-align:left; font-weight:600;">Global DDP Air Diplomatic</td>
            <td class="hp48-comp__highlight">100% Pre-Paid Border Tariffs</td>
            <td>Standard Post Office Duties</td>
          </tr>
        {%- endif -%}
      </tbody>
    </table>
  </div>
</div>

{% schema %}
{
  "name": "HP48 - Royal Matrix",
  "class": "section-hp48-matrix",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#FAF8F5" },
    { "type": "color", "id": "accent_gold", "label": "Gold Accent", "default": "#C59B27" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 700, "max": 1200, "step": 20, "unit": "px", "label": "Container Width", "default": 980 }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Matrix Row",
      "settings": [
        { "type": "text", "id": "feature", "label": "Feature", "default": "Gold Infusion Purity" },
        { "type": "text", "id": "brand_val", "label": "Our Value", "default": "24K Micronized Colloidal Gold" },
        { "type": "text", "id": "other_val", "label": "Conventional Value", "default": "Synthetic Mica Gold Pigment" }
      ]
    }
  ],
  "presets": [
    { "name": "HP48 - Royal Matrix" }
  ]
}
{% endschema %}
