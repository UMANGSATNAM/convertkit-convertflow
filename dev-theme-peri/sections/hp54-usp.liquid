{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#0A1628' }};
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
  }
  .hp54-usp__container { max-width: {{ section.settings.container_width | default: 1280 }}px; margin: 0 auto; padding: 0 24px; }
  .hp54-usp__grid { display: grid; grid-template-columns: repeat({{ section.settings.columns | default: 4 }}, 1fr); gap: 20px; }
  .hp54-usp__card {
    background: {{ section.settings.card_bg | default: '#111D33' }};
    border: 1px solid rgba(59, 130, 246, 0.15);
    border-radius: 12px; padding: 30px 22px; text-align: center;
    transition: transform 0.3s ease, border-color 0.3s ease;
  }
  .hp54-usp__card:hover { transform: translateY(-4px); border-color: rgba(59, 130, 246, 0.4); }
  .hp54-usp__icon {
    width: 50px; height: 50px;
    background: linear-gradient(135deg, #1E3A5F, #3B82F6);
    border-radius: 12px; display: flex; align-items: center; justify-content: center;
    margin: 0 auto 16px; font-size: 22px; color: #FFFFFF;
  }
  .hp54-usp__title {
    font-family: 'Tenor Sans', serif; font-size: 17px; color: #FFFFFF; margin: 0 0 8px;
  }
  .hp54-usp__desc { font-size: 13px; line-height: 1.6; color: #94A3B8; margin: 0; }
  @media screen and (max-width: 992px) { .hp54-usp__grid { grid-template-columns: repeat(2, 1fr); } }
  @media screen and (max-width: 480px) { .hp54-usp__grid { grid-template-columns: 1fr; } }
{%- endstyle -%}
<div class="hp54-usp__container">
  <div class="hp54-usp__grid">
    {%- for block in section.blocks -%}
      <div class="hp54-usp__card" {{ block.shopify_attributes }}>
        <div class="hp54-usp__icon">{{ block.settings.icon | default: '◆' }}</div>
        <h3 class="hp54-usp__title">{{ block.settings.title | default: 'Deep Sea Formula' }}</h3>
        <p class="hp54-usp__desc">{{ block.settings.description | default: 'Marine-grade ingredients for skin renewal.' }}</p>
      </div>
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "HP54 - Sapphire Pillars",
  "class": "section-hp54-usp",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#0A1628" },
    { "type": "color", "id": "card_bg", "label": "Card BG", "default": "#111D33" },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "label": "Columns", "default": 4 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 80 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "blocks": [{ "type": "pillar", "name": "Pillar", "settings": [
    { "type": "text", "id": "icon", "label": "Icon", "default": "◆" },
    { "type": "text", "id": "title", "label": "Title", "default": "Deep Sea Formula" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Marine-grade ingredients." }
  ]}],
  "presets": [{ "name": "HP54 - Sapphire Pillars", "blocks": [
    { "type": "pillar", "settings": { "icon": "🌊", "title": "Marine Peptides", "description": "Deep-ocean bio-actives for cellular renewal." } },
    { "type": "pillar", "settings": { "icon": "💎", "title": "Sapphire Infusion", "description": "Blue gemstone mineral enrichment." } },
    { "type": "pillar", "settings": { "icon": "🌙", "title": "Lunar Complex", "description": "Night-activated repair system." } },
    { "type": "pillar", "settings": { "icon": "❄️", "title": "Cryo Therapy", "description": "Cold-fusion pore tightening." } }
  ]}]
}
{% endschema %}
