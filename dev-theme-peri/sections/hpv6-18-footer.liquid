{%- liquid
  assign section_id = section.id
  
  assign bg_color = section.settings.bg_color | default: '#F7FAFC'
  assign text_color = section.settings.text_color | default: '#2D3748'
  assign border_color = section.settings.border_color | default: 'rgba(45, 55, 72, 0.1)'
  assign link_hover = section.settings.link_hover | default: 'rgba(45, 55, 72, 0.6)'
  
  assign padding_top = section.settings.padding_top | default: 80
  assign padding_bottom = section.settings.padding_bottom | default: 80
  assign padding_top_mobile = section.settings.padding_top_mobile | default: 60
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile | default: 60
-%}

<style>
  #shopify-section-{{ section_id }} {
    --bg-color: {{ bg_color }};
    --text-color: {{ text_color }};
    --border-color: {{ border_color }};
    --link-hover: {{ link_hover }};
    --padding-top: {{ padding_top }}px;
    --padding-bottom: {{ padding_bottom }}px;
    --padding-top-mobile: {{ padding_top_mobile }}px;
    --padding-bottom-mobile: {{ padding_bottom_mobile }}px;
    
    background-color: var(--bg-color);
    color: var(--text-color);
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
    border-top: 1px solid var(--border-color);
  }

  .hpv6-footer-{{ section_id }} {
    max-width: var(--page-width, 1440px);
    margin: 0 auto;
    padding: 0 5vw;
  }

  /* Grid Layout for Blocks */
  .hpv6-footer__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 4rem;
    margin-bottom: 4rem;
  }

  /* Block Styles */
  .hpv6-footer__block-heading {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    letter-spacing: 2px;
    text-transform: uppercase;
    font-weight: 600;
    margin: 0 0 1.5rem 0;
  }

  /* Text Block */
  .hpv6-footer__brand-title {
    font-family: 'Playfair Display', 'Georgia', serif;
    font-size: 2rem;
    font-weight: 400;
    margin: 0 0 1rem 0;
  }

  .hpv6-footer__brand-logo {
    max-width: 150px;
    height: auto;
    margin-bottom: 1rem;
    display: block;
  }

  .hpv6-footer__text {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    line-height: 1.6;
    opacity: 0.8;
  }

  .hpv6-footer__text p {
    margin: 0 0 1rem 0;
  }

  /* Menu Block */
  .hpv6-footer__menu-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .hpv6-footer__menu-list li {
    margin-bottom: 1rem;
  }

  .hpv6-footer__menu-list a {
    color: var(--text-color);
    text-decoration: none;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    opacity: 0.8;
    transition: opacity 0.3s ease;
  }

  .hpv6-footer__menu-list a:hover {
    opacity: 1;
    color: var(--link-hover);
  }

  /* Newsletter Block */
  .hpv6-footer__form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1rem;
  }

  .hpv6-footer__input {
    width: 100%;
    padding: 12px 0;
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--border-color);
    color: var(--text-color);
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    outline: none;
    transition: border-color 0.3s ease;
  }

  .hpv6-footer__input::placeholder {
    color: var(--text-color);
    opacity: 0.5;
  }

  .hpv6-footer__input:focus {
    border-bottom-color: var(--text-color);
  }

  .hpv6-footer__btn {
    align-self: flex-start;
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--text-color);
    color: var(--text-color);
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    letter-spacing: 1px;
    text-transform: uppercase;
    font-weight: 600;
    padding: 8px 0;
    cursor: pointer;
    transition: opacity 0.3s ease;
  }

  .hpv6-footer__btn:hover {
    opacity: 0.6;
  }

  /* Bottom Bar */
  .hpv6-footer__bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 2rem;
    border-top: 1px solid var(--border-color);
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    opacity: 0.7;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .hpv6-footer__copyright {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  
  .hpv6-footer__copyright a {
    color: inherit;
    text-decoration: none;
  }
  .hpv6-footer__copyright a:hover {
    text-decoration: underline;
  }

  .hpv6-footer__payment-icons {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .hpv6-footer__payment-icon svg {
    width: 38px;
    height: 24px;
  }

  /* Social Icons */
  .hpv6-footer__social {
    display: flex;
    gap: 16px;
    margin-top: 1.5rem;
  }

  .hpv6-footer__social a {
    color: var(--text-color);
    opacity: 0.7;
    transition: opacity 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hpv6-footer__social a:hover {
    opacity: 1;
  }

  .hpv6-footer__social svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding-top: var(--padding-top-mobile);
      padding-bottom: var(--padding-bottom-mobile);
    }
    
    .hpv6-footer__grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .hpv6-footer__bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.5rem;
    }
  }
</style>

<footer class="hpv6-footer-{{ section_id }}">
  
  <div class="hpv6-footer__grid">
    {%- for block in section.blocks -%}
      <div class="hpv6-footer__block hpv6-footer__block--{{ block.type }}" {{ block.shopify_attributes }}>
        
        {%- case block.type -%}
          {%- when 'text' -%}
            {%- if block.settings.logo != blank -%}
              {{ block.settings.logo | image_url: width: 300 | image_tag: 
                 loading: 'lazy',
                 class: 'hpv6-footer__brand-logo',
                 alt: block.settings.logo.alt | default: shop.name
              }}
            {%- elsif block.settings.title != blank -%}
              <h4 class="hpv6-footer__brand-title">{{ block.settings.title | escape }}</h4>
            {%- else -%}
              <h4 class="hpv6-footer__brand-title">{{ shop.name }}</h4>
            {%- endif -%}

            {%- if block.settings.text != blank -%}
              <div class="hpv6-footer__text">{{ block.settings.text }}</div>
            {%- endif -%}

            {%- if block.settings.show_social -%}
              <div class="hpv6-footer__social">
                {%- if settings.social_instagram_link != blank -%}
                  <a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener" aria-label="Instagram">
                    <svg viewBox="0 0 24 24"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.22.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.05.41 2.22.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.22-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.05.36-2.22.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.22-.41-.56-.22-.96-.48-1.38-.9-.42-.42-.68-.82-.9-1.38-.16-.42-.36-1.05-.41-2.22C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.22.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.05-.36 2.22-.41 1.27-.06 1.65-.07 4.85-.07M12 0C8.74 0 8.33.01 7.05.07c-1.27.06-2.13.26-2.89.56-.78.3-1.44.73-2.1 1.39-.66.66-1.09 1.32-1.39 2.1-.3.76-.5 1.62-.56 2.89C.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.06 1.27.26 2.13.56 2.89.3.78.73 1.44 1.39 2.1.66.66 1.32 1.09 2.1 1.39.76.3 1.62.5 2.89.56 1.28.06 1.69.07 4.95.07s3.67-.01 4.95-.07c1.27-.06 2.13-.26 2.89-.56.78-.3 1.44-.73 2.1-1.39.66-.66 1.09-1.32 1.39-2.1.3-.76.5-1.62.56-2.89.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.06-1.27-.26-2.13-.56-2.89-.3-.78-.73-1.44-1.39-2.1-.66-.66-1.32-1.09-2.1-1.39-.76-.3-1.62-.5-2.89-.56C15.67.01 15.26 0 12 0zm0 5.84A6.16 6.16 0 1018.16 12 6.16 6.16 0 0012 5.84zm0 10.16A4 4 0 1116 12a4 4 0 01-4 4zm6.4-9.44a1.44 1.44 0 11-2.88 0 1.44 1.44 0 012.88 0z"/></svg>
                  </a>
                {%- endif -%}
                {%- if settings.social_facebook_link != blank -%}
                  <a href="{{ settings.social_facebook_link }}" target="_blank" rel="noopener" aria-label="Facebook">
                    <svg viewBox="0 0 24 24"><path d="M22.67 0H1.33C.6 0 0 .6 0 1.33v21.34C0 23.4.6 24 1.33 24h11.49v-9.28H9.7v-3.62h3.12V8.41c0-3.1 1.89-4.78 4.66-4.78 1.32 0 2.46.1 2.79.14v3.24l-1.92.01c-1.5 0-1.79.71-1.79 1.76v2.31h3.59l-.47 3.62h-3.12V24h6.11c.73 0 1.33-.6 1.33-1.33V1.33C24 .6 23.4 0 22.67 0z"/></svg>
                  </a>
                {%- endif -%}
                {%- if settings.social_twitter_link != blank -%}
                  <a href="{{ settings.social_twitter_link }}" target="_blank" rel="noopener" aria-label="Twitter">
                    <svg viewBox="0 0 24 24"><path d="M23.95 4.57a10 10 0 01-2.82.77 4.96 4.96 0 002.16-2.72c-.95.55-2.02.95-3.12 1.17a4.92 4.92 0 00-8.38 4.48A13.9 13.9 0 011.67 3.15 4.92 4.92 0 003.2 9.72a4.9 4.9 0 01-2.23-.62v.06a4.92 4.92 0 003.95 4.83 4.86 4.86 0 01-2.22.08 4.93 4.93 0 004.6 3.42A9.87 9.87 0 010 19.54a13.94 13.94 0 007.55 2.21c9.06 0 14-7.5 14-14v-.64a10.02 10.02 0 002.4-2.54z"/></svg>
                  </a>
                {%- endif -%}
              </div>
            {%- endif -%}

          {%- when 'menu' -%}
            {%- if block.settings.title != blank -%}
              <h5 class="hpv6-footer__block-heading">{{ block.settings.title | escape }}</h5>
            {%- endif -%}
            <ul class="hpv6-footer__menu-list">
              {%- assign footer_menu = linklists[block.settings.menu] -%}
              {%- if footer_menu.links.size > 0 -%}
                {%- for link in footer_menu.links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              {%- else -%}
                {%- assign cf_menu = section.settings.menu | default: linklists['footer'] -%}

                {%- if cf_menu == blank -%}{%- assign cf_menu = linklists['main-menu'] -%}{%- endif -%}

                {%- for link in cf_menu.links -%}

                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>

                {%- endfor -%}
              {%- endif -%}
            </ul>

          {%- when 'newsletter' -%}
            {%- if block.settings.title != blank -%}
              <h5 class="hpv6-footer__block-heading">{{ block.settings.title | escape }}</h5>
            {%- endif -%}
            
            {%- if block.settings.text != blank -%}
              <div class="hpv6-footer__text">{{ block.settings.text }}</div>
            {%- endif -%}

            {%- form 'customer', class: 'hpv6-footer__form' -%}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <label for="FooterEmail-{{ block.id }}" class="visually-hidden">Email</label>
              <input type="email"
                     id="FooterEmail-{{ block.id }}"
                     name="contact[email]"
                     class="hpv6-footer__input"
                     placeholder="Your email address"
                     required>
              <button type="submit" class="hpv6-footer__btn">Subscribe</button>
            {%- endform -%}

        {%- endcase -%}
        
      </div>
    {%- endfor -%}
  </div>
  
  <div class="hpv6-footer__bottom">
    <div class="hpv6-footer__copyright">
      <span>&copy; {{ 'now' | date: "%Y" }} {{ shop.name }}. All rights reserved.</span>
      {%- if section.settings.show_powered_by -%}
        <span class="hpv6-footer__powered">{{ powered_by_link }}</span>
      {%- endif -%}
    </div>

    {%- if section.settings.show_payment_icons and shop.enabled_payment_types != empty -%}
      <div class="hpv6-footer__payment-icons">
        {%- for type in shop.enabled_payment_types -%}
          <span class="hpv6-footer__payment-icon">
            {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
          </span>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</footer>

{% schema %}
{
  "name": "HPV6 Footer",
  "settings": [
    {
      "type": "header",
      "content": "Bottom Bar"
    },
    {
      "type": "checkbox",
      "id": "show_powered_by",
      "label": "Show 'Powered by Shopify'",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show Payment Icons",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F7FAFC"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2D3748"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "rgba(45, 55, 72, 0.1)"
    },
    {
      "type": "color",
      "id": "link_hover",
      "label": "Link Hover Color",
      "default": "#1A202C"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Desktop Padding Top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Desktop Padding Bottom",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 60
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Footer menu",
      "info": "Leave empty to use the store's main menu.",
      "default": "footer"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "padding_mobile",
      "label": "Mobile padding",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Footer logo"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show social links",
      "default": true
    },
    {
      "type": "text",
      "id": "copyright_note",
      "label": "Copyright line",
      "info": "The year and store name are added automatically.",
      "default": "All rights reserved."
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Brand Info (Text/Logo)",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo Image",
          "info": "Overrides text heading if set."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Your Brand",
          "info": "Shown if no logo is selected."
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Crafting spaces of intentional simplicity with high-quality, sustainable materials.</p>"
        },
        {
          "type": "checkbox",
          "id": "show_social",
          "label": "Show Social Media Icons",
          "default": true,
          "info": "Requires social links to be populated in Theme Settings."
        }
      ]
    },
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Explore"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Join Us"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Sign up to receive news and updates.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HPV6 Footer",
      "blocks": [
        {
          "type": "text"
        },
        {
          "type": "menu",
          "settings": {
            "title": "Shop"
          }
        },
        {
          "type": "menu",
          "settings": {
            "title": "About"
          }
        },
        {
          "type": "newsletter"
        }
      ]
    }
  ]
}
{% endschema %}
