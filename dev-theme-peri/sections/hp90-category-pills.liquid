{%- style -%}#shopify-section-{{ section.id }}{background:{{ section.settings.bg_color | default: '#fff' }};padding:24px 0}.hp90-pills{max-width:1280px;margin:0 auto;padding:0 24px;display:flex;gap:12px;overflow-x:auto;scrollbar-width:none}.hp90-pills::-webkit-scrollbar{display:none}.hp90-pill{flex:0 0 auto;padding:10px 18px;border-radius:999px;background:#fff;border:1px solid rgba(0,0,0,.1);font-size:13px;font-weight:600;text-decoration:none;color:inherit;white-space:nowrap} .hp90-pill--active{background:#16A34A;color:#fff;border-color:#16A34A}{%- endstyle -%}<div class="hp90-pills">{% for block in section.blocks %}<a href="{{ block.settings.url }}" class="hp90-pill">{{ block.settings.label }}</a>{% else %}{% for cat in collections limit:6 %}<a href="{{ cat.url }}" class="hp90-pill">{{ cat.title }}</a>{% endfor %}{% endfor %}</div>{% schema %}{"name":"HP90 Pills","settings":[{"type":"color","id":"bg_color","label":"BG","default":"#ffffff"}],"blocks":[{"type":"pill","name":"Pill","settings":[{"type":"text","id":"label","label":"Label","default":"All"},{"type":"url","id":"url","label":"URL"}]}]}{% endschema %}