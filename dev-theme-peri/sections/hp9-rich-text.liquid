{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#050505'
  assign text_color = section.settings.text_color | default: '#ffffff'
  assign accent_color = section.settings.accent_color | default: '#00ff88'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 150px 20px;
    color: {{ text_color }};
    text-align: center;
    position: relative;
    border-top: 1px solid rgba(255,255,255,0.05);
  }
  
  .hp9-rt-container-{{ section_id }} {
    max-width: 900px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }
  
  .hp9-rt-heading-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 900;
    line-height: 1.1;
    margin: 0 0 30px 0;
    text-transform: uppercase;
    letter-spacing: -1px;
  }
  
  .hp9-rt-heading-{{ section_id }} span {
    color: {{ accent_color }};
  }
  
  .hp9-rt-text-{{ section_id }} {
    font-family: 'Space Mono', monospace;
    font-size: 1.1rem;
    line-height: 1.8;
    color: rgba(255,255,255,0.6);
    margin: 0 0 40px 0;
  }
  
  .hp9-rt-btn-{{ section_id }} {
    display: inline-block;
    padding: 15px 40px;
    background-color: {{ text_color }};
    color: {{ bg_color }};
    text-decoration: none;
    font-family: 'Space Mono', monospace;
    font-size: 0.9rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: all 0.3s ease;
    border: 1px solid transparent;
  }
  
  .hp9-rt-btn-{{ section_id }}:hover {
    background-color: transparent;
    color: {{ text_color }};
    border-color: {{ text_color }};
  }

  /* Decorative brackets */
  .hp9-rt-bracket-{{ section_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    font-family: 'Inter', sans-serif;
    font-size: 15rem;
    font-weight: 100;
    color: rgba(0, 255, 136, 0.05);
    z-index: 1;
    pointer-events: none;
    line-height: 1;
  }
  
  .hp9-rt-bracket-left-{{ section_id }} {
    left: 10%;
  }
  
  .hp9-rt-bracket-right-{{ section_id }} {
    right: 10%;
  }

  @media (max-width: 992px) {
    .hp9-rt-bracket-{{ section_id }} {
      display: none;
    }
  }
</style>

<div class="hp9-rt-bracket-{{ section_id }} hp9-rt-bracket-left-{{ section_id }}">{</div>
<div class="hp9-rt-bracket-{{ section_id }} hp9-rt-bracket-right-{{ section_id }}">}</div>

<div class="hp9-rt-container-{{ section_id }}">
  <h2 class="hp9-rt-heading-{{ section_id }}">{{ section.settings.heading | default: 'THE ARCHITECTURE OF <span>TOMORROW</span>' }}</h2>
  <div class="hp9-rt-text-{{ section_id }}">
    {{ section.settings.text | default: "We don't just build hardware; we engineer paradigms. Our components are designed for those who refuse to be bound by the limitations of conventional technology." }}
  </div>
  {% if section.settings.button_text != blank %}
    <a href="{{ section.settings.button_link | default: '#' }}" class="hp9-rt-btn-{{ section_id }}">{{ section.settings.button_text }}</a>
  {% endif %}
</div>

{% schema %}
{
  "name": "HP9 Rich Text",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#050505"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#00ff88"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "THE ARCHITECTURE OF <span>TOMORROW</span>"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "We don't just build hardware; we engineer paradigms. Our components are designed for those who refuse to be bound by the limitations of conventional technology."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "READ THE MANIFESTO"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "HP9 Rich Text"
    }
  ]
}
{% endschema %}
