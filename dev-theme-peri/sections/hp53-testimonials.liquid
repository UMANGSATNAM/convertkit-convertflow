{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#F5EDE3' }};
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }

  .hp53-test__container {
    max-width: {{ section.settings.container_width | default: 1280 }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hp53-test__header {
    text-align: center;
    margin-bottom: 50px;
  }

  .hp53-test__eyebrow {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: {{ section.settings.accent_color | default: '#C2703E' }};
    margin: 0 0 12px;
  }

  .hp53-test__heading {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(28px, 3.5vw, 42px);
    font-weight: 700;
    color: {{ section.settings.title_color | default: '#5C3D2E' }};
    margin: 0;
  }

  .hp53-test__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns | default: 3 }}, 1fr);
    gap: 24px;
  }

  .hp53-test__card {
    background: {{ section.settings.card_bg | default: '#FFFFFF' }};
    border: 1px solid {{ section.settings.border_color | default: '#E8D5C0' }};
    border-radius: 10px;
    padding: 32px 24px;
  }

  .hp53-test__stars {
    color: {{ section.settings.star_color | default: '#C2703E' }};
    font-size: 16px;
    margin-bottom: 16px;
    letter-spacing: 2px;
  }

  .hp53-test__quote {
    font-family: 'Cormorant Garamond', serif;
    font-size: 17px;
    font-style: italic;
    line-height: 1.6;
    color: {{ section.settings.quote_color | default: '#5C3D2E' }};
    margin: 0 0 20px;
  }

  .hp53-test__author {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 13px;
    font-weight: 700;
    color: {{ section.settings.title_color | default: '#5C3D2E' }};
    margin: 0;
  }

  .hp53-test__role {
    font-size: 11px;
    color: {{ section.settings.accent_color | default: '#C2703E' }};
    margin: 4px 0 0;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  @media screen and (max-width: 992px) {
    .hp53-test__grid { grid-template-columns: 1fr; max-width: 600px; margin: 0 auto; }
  }
{%- endstyle -%}

<div class="hp53-test__container">
  <div class="hp53-test__header">
    {%- if section.settings.eyebrow != blank -%}
      <p class="hp53-test__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h2 class="hp53-test__heading">{{ section.settings.heading | default: 'Desert Voices' }}</h2>
  </div>

  <div class="hp53-test__grid">
    {%- for block in section.blocks -%}
      <div class="hp53-test__card" {{ block.shopify_attributes }}>
        <div class="hp53-test__stars">{{ block.settings.stars | default: '★★★★★' }}</div>
        <p class="hp53-test__quote">"{{ block.settings.quote | default: 'The argan serum transformed my skin in just two weeks.' }}"</p>
        <p class="hp53-test__author">{{ block.settings.author | default: 'Amina S.' }}</p>
        <p class="hp53-test__role">{{ block.settings.role | default: 'Verified Buyer' }}</p>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "HP53 - Dune Reviews",
  "class": "section-hp53-test",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#F5EDE3" },
    { "type": "color", "id": "card_bg", "label": "Card BG", "default": "#FFFFFF" },
    { "type": "color", "id": "border_color", "label": "Border", "default": "#E8D5C0" },
    { "type": "color", "id": "title_color", "label": "Title Color", "default": "#5C3D2E" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#C2703E" },
    { "type": "color", "id": "star_color", "label": "Star Color", "default": "#C2703E" },
    { "type": "color", "id": "quote_color", "label": "Quote Color", "default": "#5C3D2E" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "◈ TESTIMONIALS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Desert Voices" },
    { "type": "range", "id": "columns", "min": 1, "max": 3, "step": 1, "label": "Columns", "default": 3 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Review",
      "settings": [
        { "type": "text", "id": "stars", "label": "Stars", "default": "★★★★★" },
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "The argan serum transformed my skin in just two weeks." },
        { "type": "text", "id": "author", "label": "Author", "default": "Amina S." },
        { "type": "text", "id": "role", "label": "Role", "default": "Verified Buyer" }
      ]
    }
  ],
  "presets": [{
    "name": "HP53 - Dune Reviews",
    "blocks": [
      { "type": "testimonial" },
      { "type": "testimonial", "settings": { "quote": "My skin has never felt so hydrated and radiant.", "author": "Fatima K." } },
      { "type": "testimonial", "settings": { "quote": "Finally a brand that understands desert-proof skincare.", "author": "Layla M." } }
    ]
  }]
}
{% endschema %}
