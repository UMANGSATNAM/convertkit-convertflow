{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#050505'
  assign text_color = section.settings.text_color | default: '#00FFA3'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 100px 40px;
    border-bottom: 1px solid #333;
  }
  
  .hp13-collections-container-{{ section_id }} {
    max-width: 1400px;
    margin: 0 auto;
  }
  
  .hp13-collections-header-{{ section_id }} {
    margin-bottom: 40px;
    border-bottom: 1px solid #333;
    padding-bottom: 20px;
  }
  
  .hp13-collections-heading-{{ section_id }} {
    font-family: 'Arial Black', Impact, sans-serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 900;
    margin: 0;
    text-transform: uppercase;
    color: #FFF;
    letter-spacing: 2px;
  }
  
  .hp13-collections-heading-{{ section_id }} span {
    color: {{ text_color }};
  }
  
  .hp13-collections-grid-{{ section_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
  }
  
  .hp13-collection-card-{{ section_id }} {
    position: relative;
    display: block;
    text-decoration: none;
    background: #111;
    border: 1px solid #333;
    overflow: hidden;
    transition: all 0.2s ease;
  }
  
  .hp13-collection-card-{{ section_id }}::before {
    content: '';
    display: block;
    padding-top: 100%;
  }
  
  .hp13-collection-card-{{ section_id }}:hover {
    border-color: {{ text_color }};
    box-shadow: 0 0 15px rgba(0,255,163,0.2);
  }
  
  .hp13-collection-image-{{ section_id }} {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover;
    filter: grayscale(100%) contrast(120%);
    opacity: 0.5;
    transition: all 0.3s ease;
  }
  
  .hp13-collection-card-{{ section_id }}:hover .hp13-collection-image-{{ section_id }} {
    filter: grayscale(0%) contrast(120%);
    opacity: 0.8;
  }
  
  .hp13-collection-info-{{ section_id }} {
    position: absolute;
    bottom: 0; left: 0; width: 100%;
    padding: 30px;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  .hp13-collection-title-{{ section_id }} {
    font-family: 'Courier New', Courier, monospace;
    font-size: 1.2rem;
    font-weight: bold;
    color: #FFF;
    margin: 0;
    text-transform: uppercase;
    background: #050505;
    padding: 5px 10px;
    border: 1px solid {{ text_color }};
  }
  
  .hp13-collection-icon-{{ section_id }} {
    color: {{ text_color }};
    font-family: 'Courier New', Courier, monospace;
    font-size: 1.2rem;
    font-weight: bold;
  }

  @media (max-width: 992px) {
    .hp13-collections-grid-{{ section_id }} {
      grid-template-columns: 1fr;
      gap: 30px;
    }
  }
  
  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 60px 20px;
    }
  }
</style>

<div class="hp13-collections-container-{{ section_id }}">
  <div class="hp13-collections-header-{{ section_id }}">
    <h2 class="hp13-collections-heading-{{ section_id }}">LOAD_<span>MODULES</span></h2>
  </div>
  
  <div class="hp13-collections-grid-{{ section_id }}">
    {% for block in section.blocks limit: 3 %}
      <a href="{{ block.settings.link | default: '#' }}" class="hp13-collection-card-{{ section_id }}" {{ block.shopify_attributes }}>
        {% if block.settings.image != blank %}
          <img src="{{ block.settings.image | image_url: width: 800 }}" class="hp13-collection-image-{{ section_id }}" alt="Collection">
        {% else %}
          <div class="hp13-collection-image-{{ section_id }}" style="background: repeating-linear-gradient(45deg, #EFEFEF, #EFEFEF 12px, #E6E6E6 12px, #E6E6E6 24px);"></div>
        {% endif %}
        <div class="hp13-collection-info-{{ section_id }}">
          <h3 class="hp13-collection-title-{{ section_id }}">{{ block.settings.title | default: 'SYS.COLL' }}</h3>
          <div class="hp13-collection-icon-{{ section_id }}">[+]</div>
        </div>
      </a>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "HP13 Collection List",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#050505"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Highlight Color",
      "default": "#00FFA3"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "SYS.COLL"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP13 Collection List",
      "blocks": [
        { "type": "collection", "settings": { "title": "OUTERWEAR" } },
        { "type": "collection", "settings": { "title": "FOOTWEAR" } },
        { "type": "collection", "settings": { "title": "HARDWARE" } }
      ]
    }
  ]
}
{% endschema %}
