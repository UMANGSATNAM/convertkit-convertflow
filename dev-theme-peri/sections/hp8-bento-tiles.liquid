{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#111111'
  assign text_color = section.settings.text_color | default: '#ffffff'
  assign heading = section.settings.heading | default: 'THE EDITORIAL'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    color: {{ text_color }};
    padding: 120px 20px;
  }
  
  .hp8-bento-container-{{ section_id }} {
    max-width: 1600px;
    margin: 0 auto;
  }
  
  .hp8-bento-header-{{ section_id }} {
    text-align: left;
    margin-bottom: 60px;
  }
  
  .hp8-bento-header-{{ section_id }} h2 {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 4px;
    text-transform: uppercase;
    margin: 0;
    color: {{ text_color | color_modify: 'alpha', 0.6 }};
  }
  
  .hp8-bento-grid-{{ section_id }} {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-auto-rows: 400px;
    gap: 10px;
  }
  
  .hp8-bento-item-{{ section_id }} {
    position: relative;
    overflow: hidden;
    background-color: #222;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 40px;
    text-decoration: none;
    color: {{ text_color }};
  }
  
  /* Grid positioning for high-fashion asymmetric look */
  .hp8-bento-item-{{ section_id }}:nth-child(1) { grid-column: span 8; grid-row: span 2; } /* Large hero */
  .hp8-bento-item-{{ section_id }}:nth-child(2) { grid-column: span 4; grid-row: span 1; } /* Top right */
  .hp8-bento-item-{{ section_id }}:nth-child(3) { grid-column: span 4; grid-row: span 1; } /* Bottom right */
  .hp8-bento-item-{{ section_id }}:nth-child(4) { grid-column: span 4; grid-row: span 1; } /* Bottom left */
  .hp8-bento-item-{{ section_id }}:nth-child(5) { grid-column: span 8; grid-row: span 1; } /* Bottom wide */
  
  .hp8-bento-image-{{ section_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
    transition: transform 0.8s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  
  .hp8-bento-item-{{ section_id }}:hover .hp8-bento-image-{{ section_id }} {
    transform: scale(1.05);
  }
  
  .hp8-bento-overlay-{{ section_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to top, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0) 60%);
    z-index: 2;
    pointer-events: none;
  }
  
  .hp8-bento-content-{{ section_id }} {
    position: relative;
    z-index: 3;
    max-width: 80%;
  }
  
  .hp8-bento-title-{{ section_id }} {
    font-family: 'Bodoni MT', 'Didot', 'Playfair Display', serif;
    font-size: clamp(2rem, 3vw, 3.5rem);
    font-weight: 400;
    margin: 0 0 15px 0;
    line-height: 1.1;
  }
  
  .hp8-bento-desc-{{ section_id }} {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 1rem;
    font-weight: 300;
    margin: 0 0 20px 0;
    opacity: 0.8;
  }
  
  .hp8-bento-btn-{{ section_id }} {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 2px;
    text-transform: uppercase;
    position: relative;
    display: inline-block;
  }
  
  .hp8-bento-btn-{{ section_id }}::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 100%;
    height: 1px;
    background-color: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.3s ease;
  }
  
  .hp8-bento-item-{{ section_id }}:hover .hp8-bento-btn-{{ section_id }}::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  /* Specific styling for text-only block (usually 2nd or 3rd) */
  .hp8-bento-item-{{ section_id }}.is-text-only {
    background-color: #1a1a1a;
    justify-content: center;
    align-items: center;
    text-align: center;
  }
  
  .hp8-bento-item-{{ section_id }}.is-text-only .hp8-bento-content-{{ section_id }} {
    max-width: 90%;
  }

  @media (max-width: 992px) {
    .hp8-bento-grid-{{ section_id }} {
      grid-template-columns: 1fr;
      grid-auto-rows: 400px;
    }
    .hp8-bento-item-{{ section_id }}:nth-child(n) { 
      grid-column: span 1; 
      grid-row: span 1; 
    }
    .hp8-bento-item-{{ section_id }}:nth-child(1) { 
      grid-row: span 2; 
    }
  }
</style>

<div class="hp8-bento-container-{{ section_id }}">
  {% if heading != blank %}
    <div class="hp8-bento-header-{{ section_id }}">
      <h2>{{ heading }}</h2>
    </div>
  {% endif %}
  
  <div class="hp8-bento-grid-{{ section_id }}">
    {% for block in section.blocks limit: 5 %}
      <a href="{{ block.settings.link | default: '#' }}" class="hp8-bento-item-{{ section_id }} {% if block.settings.image == blank %}is-text-only{% endif %}" {{ block.shopify_attributes }}>
        {% if block.settings.image != blank %}
          <img src="{{ block.settings.image | image_url: width: 1200 }}" alt="{{ block.settings.title }}" class="hp8-bento-image-{{ section_id }}" loading="lazy" width="800" height="800">
          <div class="hp8-bento-overlay-{{ section_id }}"></div>
        {% endif %}
        
        <div class="hp8-bento-content-{{ section_id }}">
          <h3 class="hp8-bento-title-{{ section_id }}">{{ block.settings.title }}</h3>
          {% if block.settings.description != blank %}
            <p class="hp8-bento-desc-{{ section_id }}">{{ block.settings.description }}</p>
          {% endif %}
          <span class="hp8-bento-btn-{{ section_id }}">{{ block.settings.btn_text | default: 'EXPLORE' }}</span>
        </div>
      </a>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "HP8 Editorial Bento",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "THE EDITORIAL"
    }
  ],
  "blocks": [
    {
      "type": "editorial_block",
      "name": "Editorial Block",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Background Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "THE NEW SILHOUETTE"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "text",
          "id": "btn_text",
          "label": "Button Text",
          "default": "DISCOVER"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP8 Editorial Bento",
      "blocks": [
        { "type": "editorial_block", "settings": { "title": "THE NEW SILHOUETTE", "description": "Defining modern luxury with structural perfection." } },
        { "type": "editorial_block", "settings": { "title": "DETAILS" } },
        { "type": "editorial_block", "settings": { "title": "LEATHER GOODS", "description": "Crafted in Italy." } },
        { "type": "editorial_block", "settings": { "title": "ACCESSORIES" } },
        { "type": "editorial_block", "settings": { "title": "THE WINTER CAMPAIGN", "description": "Shot on location in the Swiss Alps." } }
      ]
    }
  ]
}
{% endschema %}
