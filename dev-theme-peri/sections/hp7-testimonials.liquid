{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#f7f4ed'
  assign card_bg = section.settings.card_bg | default: '#ffffff'
  assign text_color = section.settings.text_color | default: '#2b302a'
  assign accent_color = section.settings.accent_color | default: '#4a6741'
  assign heading = section.settings.heading | default: 'Community Voices'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 100px 20px;
    color: {{ text_color }};
    overflow: hidden;
  }
  
  .hp7-test-container-{{ section_id }} {
    max-width: 1400px;
    margin: 0 auto;
  }
  
  .hp7-test-header-{{ section_id }} {
    text-align: center;
    margin-bottom: 60px;
  }
  
  .hp7-test-header-{{ section_id }} h2 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    font-weight: 500;
    margin: 0;
  }
  
  .hp7-test-slider-{{ section_id }} {
    display: flex;
    gap: 30px;
    overflow-x: auto;
    padding: 20px 0 40px 0;
    scrollbar-width: none;
    -ms-overflow-style: none;
    scroll-snap-type: x mandatory;
  }
  
  .hp7-test-slider-{{ section_id }}::-webkit-scrollbar {
    display: none;
  }
  
  .hp7-test-card-{{ section_id }} {
    flex: 0 0 400px;
    background-color: {{ card_bg }};
    border-radius: 40px 100px 40px 40px; /* Asymmetric organic shape */
    padding: 50px 40px;
    scroll-snap-align: center;
    box-shadow: 0 15px 35px rgba(0,0,0,0.03);
    border: 1px solid rgba(43, 48, 42, 0.05);
    transition: transform 0.4s ease;
  }
  
  .hp7-test-card-{{ section_id }}:hover {
    transform: translateY(-10px);
  }
  
  .hp7-test-stars-{{ section_id }} {
    color: {{ accent_color }};
    margin-bottom: 25px;
  }
  
  .hp7-test-stars-{{ section_id }} svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }
  
  .hp7-test-quote-{{ section_id }} {
    font-family: 'Playfair Display', serif;
    font-size: 1.25rem;
    font-style: italic;
    line-height: 1.6;
    margin: 0 0 30px 0;
    color: {{ text_color }};
  }
  
  .hp7-test-author-row-{{ section_id }} {
    display: flex;
    align-items: center;
    gap: 15px;
  }
  
  .hp7-test-avatar-{{ section_id }} {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background-color: #eaeaea;
    overflow: hidden;
  }
  
  .hp7-test-avatar-{{ section_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .hp7-test-author-info-{{ section_id }} {
    display: flex;
    flex-direction: column;
  }
  
  .hp7-test-name-{{ section_id }} {
    font-family: 'DM Sans', sans-serif;
    font-weight: 700;
    font-size: 1rem;
    color: {{ text_color }};
  }
  
  .hp7-test-verified-{{ section_id }} {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.8rem;
    color: rgba({{ text_color | color_to_rgb | remove: 'rgb(' | remove: ')' }}, {{ 0.6 }});
    display: flex;
    align-items: center;
    gap: 4px;
  }
  
  .hp7-test-verified-{{ section_id }} svg {
    width: 12px;
    height: 12px;
    fill: {{ accent_color }};
  }

  @media (max-width: 768px) {
    .hp7-test-card-{{ section_id }} {
      flex: 0 0 300px;
      padding: 40px 30px;
    }
    .hp7-test-quote-{{ section_id }} {
      font-size: 1.1rem;
    }
  }
</style>

<div class="hp7-test-container-{{ section_id }}">
  {% if heading != blank %}
    <div class="hp7-test-header-{{ section_id }}">
      <h2>{{ heading }}</h2>
    </div>
  {% endif %}
  
  <div class="hp7-test-slider-{{ section_id }}">
    {% for block in section.blocks %}
      <div class="hp7-test-card-{{ section_id }}" {{ block.shopify_attributes }}>
        <div class="hp7-test-stars-{{ section_id }}">
          {% for i in (1..5) %}
            <svg viewBox="0 0 24 24"><path d="M12,17.27L18.18,21L16.54,13.97L22,9.24L14.81,8.62L12,2L9.19,8.62L2,9.24L7.45,13.97L5.82,21L12,17.27Z"/></svg>
          {% endfor %}
        </div>
        <p class="hp7-test-quote-{{ section_id }}">"{{ block.settings.quote }}"</p>
        <div class="hp7-test-author-row-{{ section_id }}">
          <div class="hp7-test-avatar-{{ section_id }}">
            {% if block.settings.avatar != blank %}
              <img src="{{ block.settings.avatar | image_url: width: 100, height: 100, crop: 'center' }}" alt="{{ block.settings.author }}" loading="lazy" width="50" height="50">
            {% else %}
              <svg viewBox="0 0 24 24" style="width: 100%; height: 100%; fill: #ccc;"><path d="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z"/></svg>
            {% endif %}
          </div>
          <div class="hp7-test-author-info-{{ section_id }}">
            <span class="hp7-test-name-{{ section_id }}">{{ block.settings.author }}</span>
            <span class="hp7-test-verified-{{ section_id }}">
              <svg viewBox="0 0 24 24"><path d="M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M11,16.5L18,9.5L16.59,8.09L11,13.67L7.91,10.59L6.5,12L11,16.5Z"/></svg>
              Verified Buyer
            </span>
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "HP7 Testimonials",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f7f4ed"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2b302a"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#4a6741"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Community Voices"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "I absolutely love the quality and feel of this clothing. Knowing it's sustainably made makes it even better."
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Avatar Image"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author Name",
          "default": "Sarah M."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP7 Testimonials",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" }
      ]
    }
  ]
}
{% endschema %}
