{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#1A202C'
  assign text_color = section.settings.text_color | default: '#F7FAFC'
  assign link_color = section.settings.link_color | default: '#FFFFFF'
  assign padding_top = section.settings.padding_top | default: 12
  assign padding_bottom = section.settings.padding_bottom | default: 12
  assign font_size = section.settings.font_size | default: 12
  assign letter_spacing = section.settings.letter_spacing | default: 2
  assign show_close = section.settings.show_close
  assign show_social = section.settings.show_social
-%}

<style>
  #shopify-section-{{ section_id }} {
    --bg-color: {{ bg_color }};
    --text-color: {{ text_color }};
    --link-color: {{ link_color }};
    --padding-top: {{ padding_top }}px;
    --padding-bottom: {{ padding_bottom }}px;
    --font-size: {{ font_size }}px;
    --letter-spacing: {{ letter_spacing }}px;
    background-color: var(--bg-color);
    color: var(--text-color);
    position: relative;
    z-index: 1000;
  }

  .hpv6-announcement-{{ section_id }} {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
    padding-left: 24px;
    padding-right: 24px;
    font-family: 'Inter', sans-serif;
    font-size: var(--font-size);
    letter-spacing: var(--letter-spacing);
    text-transform: uppercase;
    min-height: 40px;
    max-width: var(--page-width, 1440px);
    margin: 0 auto;
  }

  .hpv6-announcement__social {
    display: flex;
    gap: 16px;
    align-items: center;
    flex: 1;
  }

  .hpv6-announcement__social-link {
    color: var(--text-color);
    text-decoration: none;
    display: flex;
    align-items: center;
    transition: opacity 0.3s ease;
  }

  .hpv6-announcement__social-link:hover {
    opacity: 0.7;
  }

  .hpv6-announcement__social-link svg {
    width: 16px;
    height: 16px;
    fill: currentColor;
  }

  .hpv6-announcement__content-wrapper {
    flex: 2;
    text-align: center;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
    position: relative;
  }

  .hpv6-announcement__message {
    margin: 0;
    line-height: 1.5;
  }

  .hpv6-announcement__message a {
    color: var(--link-color);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: opacity 0.3s ease;
  }

  .hpv6-announcement__message a:hover {
    opacity: 0.8;
  }

  .hpv6-announcement__close {
    flex: 1;
    display: flex;
    justify-content: flex-end;
  }

  .hpv6-announcement__close-btn {
    background: none;
    border: none;
    color: var(--text-color);
    cursor: pointer;
    padding: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.3s ease;
  }

  .hpv6-announcement__close-btn:hover {
    opacity: 0.7;
  }

  .hpv6-announcement__close-btn svg {
    width: 14px;
    height: 14px;
    stroke: currentColor;
    stroke-width: 2;
  }

  /* Slider specific */
  .hpv6-announcement__slider {
    display: flex;
    transition: transform 0.5s ease-in-out;
    width: 100%;
  }

  .hpv6-announcement__slide {
    min-width: 100%;
    box-sizing: border-box;
  }

  .visually-hidden {
    position: absolute !important;
    overflow: hidden;
    clip: rect(0 0 0 0);
    height: 1px;
    width: 1px;
    margin: -1px;
    padding: 0;
    border: 0;
  }

  @media screen and (max-width: 768px) {
    .hpv6-announcement-{{ section_id }} {
      padding-left: 16px;
      padding-right: 16px;
      font-size: max(10px, calc(var(--font-size) - 2px));
    }
    .hpv6-announcement__social {
      display: none;
    }
    .hpv6-announcement__close {
      flex: 0;
      position: absolute;
      right: 16px;
      top: 50%;
      transform: translateY(-50%);
    }
  }
</style>

<div class="hpv6-announcement-{{ section_id }}" role="region" aria-label="Announcement">
  
  {%- if show_social -%}
    <div class="hpv6-announcement__social">
      {%- if settings.social_instagram_link != blank -%}
        <a href="{{ settings.social_instagram_link }}" class="hpv6-announcement__social-link" target="_blank" rel="noopener" aria-label="Instagram">
          <svg viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
        </a>
      {%- endif -%}
      {%- if settings.social_facebook_link != blank -%}
        <a href="{{ settings.social_facebook_link }}" class="hpv6-announcement__social-link" target="_blank" rel="noopener" aria-label="Facebook">
          <svg viewBox="0 0 24 24"><path d="M22.675 0h-21.35c-.732 0-1.325.593-1.325 1.325v21.351c0 .731.593 1.324 1.325 1.324h11.495v-9.294h-3.128v-3.622h3.128v-2.671c0-3.1 1.893-4.788 4.659-4.788 1.325 0 2.463.099 2.795.143v3.24l-1.918.001c-1.504 0-1.795.715-1.795 1.763v2.313h3.587l-.467 3.622h-3.12v9.293h6.116c.73 0 1.323-.593 1.323-1.325v-21.35c0-.732-.593-1.325-1.325-1.325z"/></svg>
        </a>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="hpv6-announcement__content-wrapper">
    {%- if section.blocks.size > 1 -%}
      <div class="hpv6-announcement__slider" id="AnnouncementSlider-{{ section.id }}">
        {%- for block in section.blocks -%}
          <div class="hpv6-announcement__slide" {{ block.shopify_attributes }}>
            <p class="hpv6-announcement__message">
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
              {%- else -%}
                {{ block.settings.text }}
              {%- endif -%}
            </p>
          </div>
        {%- endfor -%}
      </div>
      <script>
        document.addEventListener('DOMContentLoaded', function() {
          const slider = document.getElementById('AnnouncementSlider-{{ section.id }}');
          if (!slider) return;
          const slideCount = {{ section.blocks.size }};
          let currentIndex = 0;
          setInterval(() => {
            currentIndex = (currentIndex + 1) % slideCount;
            slider.style.transform = `translateX(-${currentIndex * 100}%)`;
          }, 4000);
        });
      </script>
    {%- elsif section.blocks.size == 1 -%}
      {%- for block in section.blocks -%}
        <div class="hpv6-announcement__slide" {{ block.shopify_attributes }}>
          <p class="hpv6-announcement__message">
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
            {%- else -%}
              {{ block.settings.text }}
            {%- endif -%}
          </p>
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="hpv6-announcement__slide">
        <p class="hpv6-announcement__message">Welcome to our store</p>
      </div>
    {%- endif -%}
  </div>

  {%- if show_close -%}
    <div class="hpv6-announcement__close">
      <button type="button" class="hpv6-announcement__close-btn" aria-label="Close announcement" onclick="this.closest('#shopify-section-{{ section_id }}').style.display='none'">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  {%- else -%}
    <div class="hpv6-announcement__close" style="visibility:hidden; pointer-events:none;">
       <!-- empty placeholder to keep flexbox balanced if social is shown -->
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "HPV6 Announcement",
  "class": "shopify-section-announcement-bar",
  "settings": [
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#1A202C"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#F7FAFC"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link Color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Font Size",
      "default": 12
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "min": 0,
      "max": 5,
      "step": 1,
      "unit": "px",
      "label": "Letter Spacing",
      "default": 2
    },
    {
      "type": "header",
      "content": "Layout Options"
    },
    {
      "type": "checkbox",
      "id": "show_close",
      "label": "Show Close Button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show Social Icons",
      "default": false,
      "info": "To display icons, ensure your social links are set in Theme Settings."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 12
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free shipping on orders over $150."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HPV6 Announcement",
      "blocks": [
        {
          "type": "announcement"
        }
      ]
    }
  ]
}
{% endschema %}
