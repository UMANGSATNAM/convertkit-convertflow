{%- comment -%}
  PC V32 — HIGH-END AUDIO SOUND TECH PRODUCT GRID
  Design: Obsidian Night (#0E1117), Electric Aqua (#00E5FF) & Neon Pink (#FF0055) accents, Space Grotesk typography
  Card Shape: 8px tech corners, audio waveform badges, cyber sound aesthetic
{%- endcomment -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@600;700;800&display=swap');

  .pcv32 {
    --bg: {{ section.settings.bg_color | default: '#0E1117' }};
    --card-bg: {{ section.settings.card_bg | default: '#161B22' }};
    --text: {{ section.settings.text_color | default: '#F0F6FC' }};
    --muted: {{ section.settings.muted_color | default: '#8B949E' }};
    --accent: {{ section.settings.accent_color | default: '#00E5FF' }};
    --accent-hover: {{ section.settings.accent_hover | default: '#00B8D4' }};
    --border: {{ section.settings.border_color | default: '#30363D' }};
    --badge-sale-bg: #FF0055;
    --badge-sale-text: #FFFFFF;
    --f-heading: 'Space Grotesk', sans-serif;
    --f-body: 'Inter', sans-serif;
    --r-card: 8px;
    --ease: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    background-color: var(--bg);
    color: var(--text);
    font-family: var(--f-body);
    padding: {{ section.settings.padding_top | default: 56 }}px 0 {{ section.settings.padding_bottom | default: 56 }}px 0;
    line-height: 1.4;
    -webkit-font-smoothing: antialiased;
  }

  .pcv32 *, .pcv32 *::before, .pcv32 *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .pcv32 a { color: inherit; text-decoration: none; }
  .pcv32 button { font-family: inherit; cursor: pointer; border: none; background: none; }
  .pcv32 img { max-width: 100%; display: block; }

  .pcv32__wrap { max-width: 1320px; margin: 0 auto; padding: 0 20px; }

  /* HEADER */
  .pcv32__head { display: flex; flex-direction: column; gap: 8px; margin-bottom: 36px; text-align: {{ section.settings.header_align | default: 'left' }}; }
  @media (min-width: 768px) {
    .pcv32__head { display: flex; flex-direction: row; justify-content: space-between; align-items: flex-end; }
  }
  .pcv32__title { font-family: var(--f-heading); font-size: 30px; font-weight: 800; color: #FFFFFF; letter-spacing: -0.02em; text-transform: uppercase; }
  @media (min-width: 768px) { .pcv32__title { font-size: 40px; } }
  .pcv32__sub { font-size: 15px; color: var(--muted); }
  .pcv32__viewall { display: inline-flex; align-items: center; gap: 8px; font-weight: 700; font-size: 12px; font-family: var(--f-heading); text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent); border: 1px solid var(--accent); padding: 8px 18px; border-radius: 4px; transition: var(--ease); }
  .pcv32__viewall:hover { background: var(--accent); color: #0E1117; box-shadow: 0 0 15px rgba(0, 225, 255, 0.4); }

  /* GRID */
  .pcv32__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr);
    gap: 18px;
  }
  @media (min-width: 640px) {
    .pcv32__grid { grid-template-columns: repeat({{ section.settings.cols_tablet | default: 3 }}, 1fr); gap: 24px; }
  }
  @media (min-width: 1024px) {
    .pcv32__grid { grid-template-columns: repeat({{ section.settings.cols_desktop | default: 4 }}, 1fr); gap: 28px; }
  }

  /* CARD */
  .pcv32__card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--r-card);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    position: relative;
    transition: var(--ease);
  }
  .pcv32__card:hover {
    transform: translateY(-4px);
    border-color: var(--accent);
    box-shadow: 0 10px 25px -5px rgba(0, 229, 255, 0.2);
  }

  /* IMAGE CONTAINER */
  .pcv32__img-box {
    position: relative;
    width: 100%;
    aspect-ratio: {{ section.settings.img_ratio | default: '1/1' }};
    background: #090C10;
    overflow: hidden;
  }
  .pcv32__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .pcv32__img--sec {
    position: absolute;
    top: 0; left: 0;
    opacity: 0;
  }
  .pcv32__card:hover .pcv32__img--pri {
    {% if section.settings.enable_sec_img %}
      opacity: 0;
    {% else %}
      transform: scale(1.05);
    {% endif %}
  }
  .pcv32__card:hover .pcv32__img--sec { opacity: 1; transform: scale(1.05); }

  /* BADGES */
  .pcv32__badges { position: absolute; top: 12px; left: 12px; display: flex; flex-direction: column; gap: 6px; z-index: 2; pointer-events: none; }
  .pcv32__badge { font-size: 10px; font-weight: 800; text-transform: uppercase; padding: 4px 10px; border-radius: 4px; letter-spacing: 0.05em; font-family: var(--f-heading); }
  .pcv32__badge--sale { background: var(--badge-sale-bg); color: var(--badge-sale-text); }
  .pcv32__badge--tag { background: #00E5FF; color: #0E1117; }
  .pcv32__badge--sold { background: #30363D; color: #8B949E; }

  /* WISHLIST BUTTON */
  .pcv32__wish {
    position: absolute;
    top: 12px; right: 12px;
    width: 36px; height: 36px;
    border-radius: 4px;
    background: rgba(14, 17, 23, 0.8);
    border: 1px solid var(--border);
    backdrop-filter: blur(8px);
    display: flex; align-items: center; justify-content: center;
    color: var(--muted);
    z-index: 3;
    transition: var(--ease);
  }
  .pcv32__wish:hover { background: var(--accent); color: #0E1117; border-color: var(--accent); }
  .pcv32__wish.active { color: #0E1117; background: var(--accent); border-color: var(--accent); }

  /* QUICK ADD HOVER */
  .pcv32__quick-box {
    position: absolute;
    bottom: 12px; left: 12px; right: 12px;
    z-index: 3;
    transform: translateY(100%);
    opacity: 0;
    transition: var(--ease);
  }
  .pcv32__card:hover .pcv32__quick-box { transform: translateY(0); opacity: 1; }
  @media (max-width: 767px) {
    .pcv32__quick-box { transform: translateY(0); opacity: 1; position: relative; bottom: auto; left: auto; right: auto; padding: 0 14px 14px; }
  }

  .pcv32__quick-btn {
    width: 100%;
    padding: 11px 16px;
    background: var(--accent);
    color: #0E1117;
    font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em;
    font-family: var(--f-heading);
    border-radius: 4px;
    border: none;
    display: flex; align-items: center; justify-content: center; gap: 8px;
    transition: var(--ease);
    box-shadow: 0 0 15px rgba(0, 229, 255, 0.4);
  }
  .pcv32__quick-btn:hover { background: var(--accent-hover); box-shadow: 0 0 20px rgba(0, 229, 255, 0.6); }
  .pcv32__quick-btn:disabled { background: #30363D; color: #8B949E; cursor: not-allowed; box-shadow: none; }

  /* CARD CONTENT */
  .pcv32__content { padding: 16px; display: flex; flex-direction: column; gap: 6px; flex-grow: 1; }

  .pcv32__vendor { font-size: 10px; text-transform: uppercase; color: var(--accent); font-weight: 800; font-family: var(--f-heading); letter-spacing: 0.1em; }
  .pcv32__item-title { font-size: 15px; font-weight: 600; color: var(--text); line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  /* RATING */
  .pcv32__rating { display: flex; align-items: center; gap: 6px; font-size: 12px; color: var(--accent); font-weight: 700; }
  .pcv32__stars { letter-spacing: 1px; text-shadow: 0 0 6px var(--accent); }
  .pcv32__rev-cnt { color: var(--muted); font-size: 11px; font-weight: 400; }

  /* PRICE */
  .pcv32__price-row { display: flex; align-items: baseline; gap: 8px; margin-top: auto; padding-top: 4px; }
  .pcv32__price { font-size: 17px; font-weight: 700; color: #FFFFFF; font-family: var(--f-heading); }
  .pcv32__cmp-price { font-size: 13px; color: var(--muted); text-decoration: line-through; }

  /* SWATCHES */
  .pcv32__swatches { display: flex; gap: 6px; align-items: center; margin-top: 4px; }
  .pcv32__swatch { width: 13px; height: 13px; border-radius: 50%; border: 1px solid var(--border); cursor: pointer; transition: var(--ease); }
  .pcv32__swatch:hover, .pcv32__swatch.active { transform: scale(1.2); border-color: var(--accent); box-shadow: 0 0 6px var(--accent); }

  /* URGENCY MICRO */
  .pcv32__urgency { font-size: 11px; color: var(--accent); font-weight: 800; font-family: var(--f-heading); text-transform: uppercase; display: flex; align-items: center; gap: 4px; margin-top: 2px; }

  /* TOAST */
  .pcv32__toast {
    position: fixed; bottom: 20px; right: 20px;
    background: var(--accent); color: #0E1117;
    padding: 12px 22px; border-radius: 4px;
    font-size: 12px; font-weight: 800; font-family: var(--f-heading); text-transform: uppercase;
    z-index: 9999;
    transform: translateY(100px); opacity: 0;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 0 20px rgba(0, 229, 255, 0.4);
  }
  .pcv32__toast.show { transform: translateY(0); opacity: 1; }
</style>

<div class="pcv32">
  <div class="pcv32__wrap">
    
    {% if section.settings.title != blank or section.settings.subheading != blank %}
      <div class="pcv32__head">
        <div>
          {% if section.settings.title != blank %}
            <h2 class="pcv32__title">{{ section.settings.title | escape }}</h2>
          {% endif %}
          {% if section.settings.subheading != blank %}
            <p class="pcv32__sub">{{ section.settings.subheading | escape }}</p>
          {% endif %}
        </div>
        {% if section.settings.show_view_all and section.settings.collection != blank %}
          <a href="{{ collections[section.settings.collection].url }}" class="pcv32__viewall">
            {{ section.settings.view_all_label | default: 'Explore Sound Range' }} &rarr;
          </a>
        {% endif %}
      </div>
    {% endif %}

    <div class="pcv32__grid">
      {% assign target_coll = collections[section.settings.collection] %}
      {% assign limit_num = section.settings.products_per_page | default: 8 %}

      {% if target_coll != blank and target_coll.products.size > 0 %}
        {% for product in target_coll.products limit: limit_num %}
          {% assign current_variant = product.selected_or_first_available_variant %}
          
          {% render 'card-v32', product: product, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v32', product: nil, show_rating: section.settings.show_rating, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {% endfor %}
      {% endif %}
    </div>

  </div>
</div>

<div class="pcv32__toast" id="pcv32-toast">AUDIO ITEM ADDED</div>

<script>
(function(){
  // Wishlist is handled globally by assets/wishlist.js (shared store: cf_wishlist_items).
  // Buttons are rendered by snippets/wishlist-button.liquid — no per-section storage.


  document.querySelectorAll('[data-pcv32-add]').forEach(function(btn){
    btn.addEventListener('click', function(e){
      e.preventDefault(); e.stopPropagation();
      var id = btn.dataset.pcv32Add, orig = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = 'SYNCING...';

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: id, quantity: 1 })
      })
      .then(function(r){ return r.json(); })
      .then(function(){
        btn.innerHTML = '✓ SYNCED';
        showT('AUDIO ITEM ADDED');
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      })
      .catch(function(){
        btn.innerHTML = 'ERROR';
        setTimeout(function(){ btn.disabled = false; btn.innerHTML = orig; }, 2000);
      });
    });
  });

  function showT(msg){
    var t = document.getElementById('pcv32-toast');
    if(!t) return;
    t.textContent = msg;
    t.classList.add('show');
    setTimeout(function(){ t.classList.remove('show'); }, 3000);
  }
})();
</script>

