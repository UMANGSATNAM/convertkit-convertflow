{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=Syne:wght@700;800&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --border-color: #000000;
    --accent-color: {{ section.settings.accent_color }};
    
    --font-heading: 'Syne', sans-serif;
    --font-body: 'Space Mono', monospace;
    
    background-color: var(--bg-color);
    border-bottom: 4px solid var(--border-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    overflow: hidden;
  }

  .hp32-bundle-wrapper {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    gap: 60px;
    align-items: center;
  }

  @media screen and (max-width: 992px) {
    .hp32-bundle-wrapper {
      flex-direction: column;
      padding: 0 20px;
      gap: 40px;
    }
  }

  .hp32-bundle__image-col {
    flex: 1.2;
    position: relative;
  }

  @media screen and (max-width: 992px) {
    .hp32-bundle__image-col {
      width: 100%;
    }
  }

  .hp32-bundle__image-wrap {
    border: 4px solid var(--border-color);
    background: #fff;
    box-shadow: 12px 12px 0 var(--border-color);
    aspect-ratio: 4/5;
    position: relative;
    padding: 20px;
  }

  .hp32-bundle__image-inner {
    border: 2px dashed var(--border-color);
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
  }

  .hp32-bundle__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%);
    transition: filter 0.3s ease;
  }

  .hp32-bundle__image-wrap:hover .hp32-bundle__image {
    filter: grayscale(0%);
  }

  /* Target crosshairs */
  .hp32-bundle__crosshair {
    position: absolute;
    width: 30px;
    height: 30px;
    border: 2px solid var(--accent-color);
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .hp32-bundle__crosshair::before,
  .hp32-bundle__crosshair::after {
    content: '';
    position: absolute;
    background: var(--accent-color);
  }

  .hp32-bundle__crosshair::before { width: 10px; height: 2px; }
  .hp32-bundle__crosshair::after { width: 2px; height: 10px; }

  .hp32-bundle__content-col {
    flex: 1;
    background: #ffffff;
    border: 4px solid var(--border-color);
    box-shadow: 8px 8px 0 var(--border-color);
    padding: 40px;
  }

  @media screen and (max-width: 768px) {
    .hp32-bundle__content-col {
      padding: 20px;
    }
  }

  .hp32-bundle__tagline {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 700;
    color: var(--accent-color);
    background: #000;
    padding: 4px 12px;
    display: inline-block;
    margin-bottom: 20px;
    text-transform: uppercase;
  }

  .hp32-bundle__title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 4vw, {{ section.settings.title_size }}px);
    line-height: 1;
    color: #000;
    text-transform: uppercase;
    margin: 0 0 10px;
    letter-spacing: -1px;
  }

  .hp32-bundle__price-wrap {
    font-family: var(--font-body);
    font-size: 24px;
    font-weight: 700;
    color: #000;
    margin-bottom: 24px;
    display: flex;
    align-items: center;
    gap: 15px;
  }

  .hp32-bundle__price-old {
    text-decoration: line-through;
    opacity: 0.5;
    font-size: 16px;
  }

  .hp32-bundle__text {
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.5;
    color: #000;
    margin: 0 0 30px;
    font-weight: 700;
  }

  .hp32-bundle__list {
    list-style: none;
    padding: 0;
    margin: 0 0 30px;
    border-top: 4px solid var(--border-color);
  }

  .hp32-bundle__list li {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 700;
    color: #000;
    padding: 15px 0;
    border-bottom: 2px dashed var(--border-color);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .hp32-bundle__list li::before {
    content: '[OK]';
    color: var(--accent-color);
    background: #000;
    padding: 2px 6px;
    margin-right: 15px;
    font-size: 12px;
  }

  .hp32-bundle__btn {
    display: block;
    width: 100%;
    text-align: center;
    background: var(--accent-color);
    color: #000;
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 700;
    text-transform: uppercase;
    text-decoration: none;
    padding: 20px;
    border: 4px solid var(--border-color);
    box-shadow: 4px 4px 0 var(--border-color);
    transition: all 0.1s ease;
  }

  .hp32-bundle__btn:hover,
  .hp32-bundle__btn:active {
    transform: translate(4px, 4px);
    box-shadow: 0 0 0 var(--border-color);
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp32-bundle-wrapper" id="HP32Bundle-{{ section.id }}">
  <div class="hp32-bundle__image-col">
    <div class="hp32-bundle__image-wrap">
      <div class="hp32-bundle__image-inner">
        {%- if section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.title | escape }}" class="hp32-bundle__image" loading="lazy">
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'hp32-bundle__image' }}
        {%- endif -%}

        <div class="hp32-bundle__crosshair" style="top: 20%; left: 30%;"></div>
        <div class="hp32-bundle__crosshair" style="top: 70%; left: 60%;"></div>
      </div>
    </div>
  </div>

  <div class="hp32-bundle__content-col">
    {%- if section.settings.tagline != blank -%}
      <div class="hp32-bundle__tagline">{{ section.settings.tagline }}</div>
    {%- endif -%}
    
    <h2 class="hp32-bundle__title">{{ section.settings.title }}</h2>
    
    <div class="hp32-bundle__price-wrap">
      <span>{{ section.settings.price }}</span>
      {%- if section.settings.compare_price != blank -%}
        <span class="hp32-bundle__price-old">{{ section.settings.compare_price }}</span>
      {%- endif -%}
    </div>
    
    <p class="hp32-bundle__text">{{ section.settings.text }}</p>
    
    <ul class="hp32-bundle__list">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}>
          {{ block.settings.item_name }}
          <span style="opacity: 0.5;">{{ block.settings.item_detail }}</span>
        </li>
      {%- endfor -%}
    </ul>
    
    {%- if section.settings.btn_label != blank -%}
      <a href="{{ section.settings.btn_link | default: '#' }}" class="hp32-bundle__btn">
        {{ section.settings.btn_label }}
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HP32 - Brutalist Bundle",
  "class": "section-hp32-bundle-offer",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Bundle Image"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "SYSTEM_BUNDLE"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Heading",
      "default": "THE CORE PROTOCOL"
    },
    {
      "type": "text",
      "id": "price",
      "label": "Price",
      "default": "$320"
    },
    {
      "type": "text",
      "id": "compare_price",
      "label": "Compare Price",
      "default": "$400"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "DEPLOY THE FULL SETUP IN ONE TRANSACTION. MAXIMUM EFFICIENCY."
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "INITIATE PURCHASE"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 48
    },
    {
      "type": "header",
      "content": "Brutalist Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background (e.g. Light Grey)",
      "default": "#f4f4f4"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color (e.g. Lime)",
      "default": "#ccff00"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 100
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Bundle Item",
      "settings": [
        {
          "type": "text",
          "id": "item_name",
          "label": "Item Name",
          "default": "UNIT-01 JACKET"
        },
        {
          "type": "text",
          "id": "item_detail",
          "label": "Detail",
          "default": "BLK"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP32 - Brutalist Bundle",
      "blocks": [
        { "type": "item" },
        { "type": "item", "settings": { "item_name": "CARGO V2", "item_detail": "BLK" } },
        { "type": "item", "settings": { "item_name": "TACTICAL BELT", "item_detail": "SLV" } }
      ]
    }
  ]
}
{% endschema %}
