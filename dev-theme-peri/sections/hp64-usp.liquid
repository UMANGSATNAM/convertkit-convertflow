{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#030712' }};
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
  }
  .hp64-usp__container { max-width: {{ section.settings.container_width | default: 1280 }}px; margin: 0 auto; padding: 0 24px; }
  .hp64-usp__grid { display: grid; grid-template-columns: repeat({{ section.settings.columns | default: 4 }}, 1fr); gap: 20px; }
  .hp64-usp__card {
    background: {{ section.settings.card_bg | default: '#090D16' }};
    border: 1px solid rgba(6, 182, 212, 0.25);
    border-radius: 6px; padding: 32px 22px; text-align: center;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .hp64-usp__card:hover {
    transform: translateY(-4px);
    border-color: #06B6D4;
    box-shadow: 0 0 30px rgba(6, 182, 212, 0.3);
  }
  .hp64-usp__icon {
    width: 52px; height: 52px;
    background: linear-gradient(135deg, #083344, #06B6D4);
    border-radius: 4px; display: flex; align-items: center; justify-content: center;
    margin: 0 auto 16px; font-size: 22px; color: #FFFFFF;
    border: 1px solid rgba(6, 182, 212, 0.4);
    box-shadow: 0 0 15px rgba(6, 182, 212, 0.35);
  }
  .hp64-usp__title {
    font-family: 'Syne', sans-serif; font-size: 16px; font-weight: 700; color: #FFFFFF; margin: 0 0 8px;
  }
  .hp64-usp__desc { font-size: 13px; line-height: 1.6; color: #94A3B8; margin: 0; font-family: 'Space Grotesk', sans-serif; }
  @media screen and (max-width: 992px) { .hp64-usp__grid { grid-template-columns: repeat(2, 1fr); } }
  @media screen and (max-width: 480px) { .hp64-usp__grid { grid-template-columns: 1fr; } }
{%- endstyle -%}
<div class="hp64-usp__container">
  <div class="hp64-usp__grid">
    {%- for block in section.blocks -%}
      <div class="hp64-usp__card" {{ block.shopify_attributes }}>
        <div class="hp64-usp__icon">{{ block.settings.icon | default: '🧬' }}</div>
        <h3 class="hp64-usp__title">{{ block.settings.title | default: 'Bio-Luminescent' }}</h3>
        <p class="hp64-usp__desc">{{ block.settings.description | default: 'Mitochondrial glow bio-actives.' }}</p>
      </div>
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "HP64 Pillars",
  "class": "section-hp64-usp",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#030712" },
    { "type": "color", "id": "card_bg", "label": "Card BG", "default": "#090D16" },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "label": "Columns", "default": 4 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 80 },
    { "type": "range", "id": "container_width", "min": 1000, "max": 1440, "step": 20, "unit": "px", "label": "Container Width", "default": 1280 }
  ],
  "blocks": [{ "type": "pillar", "name": "Pillar", "settings": [
    { "type": "text", "id": "icon", "label": "Icon", "default": "🧬" },
    { "type": "text", "id": "title", "label": "Title", "default": "Bio-Luminescent" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Mitochondrial glow bio-actives." }
  ]}],
  "presets": [{ "name": "HP64 Pillars", "blocks": [
    { "type": "pillar", "settings": { "icon": "🧬", "title": "Luciferin Luciferase Complex", "description": "Enzyme system activating native cellular bio-luminescence and photon emission." } },
    { "type": "pillar", "settings": { "icon": "🌊", "title": "Abyssal Hydrothermal Peptides", "description": "Extracted from 4,000m deep thermal vents with extreme pressure stability." } },
    { "type": "pillar", "settings": { "icon": "💎", "title": "Photoprotective Micro-Algae", "description": "Astaxanthin and spirulina carotenoids absorbing high-energy visible blue light." } },
    { "type": "pillar", "settings": { "icon": "⚡", "title": "Mitochondrial ATP Energy", "description": "Fuels cellular renewal velocity and accelerates collagen peptide synthesis." } }
  ]}]
}
{% endschema %}
