{%- liquid
  assign bg_color = section.settings.bg_color | default: '#0066cc'
  assign text_color = section.settings.text_color | default: '#ffffff'
  
  assign padding_top_desktop = section.settings.padding_top_desktop
  assign padding_bottom_desktop = section.settings.padding_bottom_desktop
  assign padding_top_mobile = section.settings.padding_top_mobile
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile
-%}

<style>
  #shopify-section-{{ section.id }} {
    --hp5-nl-bg: {{ bg_color }};
    --hp5-nl-text: {{ text_color }};
    
    --hp5-nl-pt-desk: {{ padding_top_desktop }}px;
    --hp5-nl-pb-desk: {{ padding_bottom_desktop }}px;
    --hp5-nl-pt-mob: {{ padding_top_mobile }}px;
    --hp5-nl-pb-mob: {{ padding_bottom_mobile }}px;
  }

  .hp5-health-nl-{{ section.id }} {
    padding-top: var(--hp5-nl-pt-desk);
    padding-bottom: var(--hp5-nl-pb-desk);
    background-color: var(--hp5-nl-bg);
    color: var(--hp5-nl-text);
    font-family: 'Inter', sans-serif;
  }

  .hp5-nl-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    align-items: center;
    gap: 80px;
  }
  .hp5-nl-inner.layout-right {
    flex-direction: row-reverse;
  }

  .hp5-nl-media {
    flex: 1;
    position: relative;
    max-width: 500px;
  }
  .hp5-nl-img-wrap {
    width: 100%;
    aspect-ratio: 1/1;
    border-radius: 24px;
    overflow: hidden;
  }
  .hp5-nl-img {
    width: 100%; height: 100%; object-fit: cover;
  }

  .hp5-nl-content {
    flex: 1;
    max-width: 600px;
  }

  .hp5-nl-label {
    display: inline-block;
    background: rgba(255,255,255,0.15);
    padding: 6px 12px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 20px;
  }

  .hp5-nl-title {
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 700;
    line-height: 1.1;
    margin: 0 0 15px 0;
    letter-spacing: -1px;
  }

  .hp5-nl-desc {
    font-size: 16px;
    line-height: 1.6;
    color: rgba(255,255,255,0.8);
    margin: 0 0 35px 0;
  }

  /* Form */
  .hp5-nl-form {
    display: flex;
    gap: 15px;
    width: 100%;
    max-width: 450px;
  }

  .hp5-nl-input {
    flex: 1;
    background: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 0 20px;
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    color: #1a2a3a;
    outline: none;
  }

  .hp5-nl-submit {
    background: #1a2a3a;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 16px 30px;
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.3s ease;
  }
  .hp5-nl-submit:hover {
    background: #0d151c;
  }

  @media screen and (max-width: 1024px) {
    .hp5-nl-inner, .hp5-nl-inner.layout-right {
      flex-direction: column;
      text-align: center;
      gap: 50px;
    }
    .hp5-nl-content {
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .hp5-nl-form {
      flex-direction: column;
    }
    .hp5-nl-input {
      padding: 16px 20px;
    }
  }

  @media screen and (max-width: 768px) {
    .hp5-health-nl-{{ section.id }} {
      padding-top: var(--hp5-nl-pt-mob);
      padding-bottom: var(--hp5-nl-pb-mob);
    }
    .hp5-nl-inner {
      padding: 0 20px;
    }
    .hp5-nl-title {
      font-size: 28px;
    }
  }
</style>

<section class="hp5-health-nl-{{ section.id }}" aria-label="Newsletter">
  <div class="hp5-nl-inner layout-{{ section.settings.layout }}">
    
    <div class="hp5-nl-media">
      <div class="hp5-nl-img-wrap">
        {%- if section.settings.image != blank -%}
          <img height="{{ section.settings.image.height }}" width="{{ section.settings.image.width }}" src="{{ section.settings.image | image_url: width: 800 }}" class="hp5-nl-img" loading="lazy" alt="Newsletter">
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'hp5-nl-img placeholder-svg' }}
        {%- endif -%}
      </div>
    </div>

    <div class="hp5-nl-content">
      <span class="hp5-nl-label">{{ section.settings.label | default: 'Free Health Guide' }}</span>
      <h2 class="hp5-nl-title">{{ section.settings.heading | default: 'Optimize your daily routine.' }}</h2>
      <p class="hp5-nl-desc">{{ section.settings.description | default: 'Sign up to receive expert wellness tips, early access to new clinical formulas, and 10% off your first order.' }}</p>
      
      {%- form 'customer', class: 'hp5-nl-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input type="email"
               name="contact[email]"
               class="hp5-nl-input"
               value="{{ form.email }}"
               placeholder="Enter your email"
               required>
        <button type="submit" class="hp5-nl-submit">Subscribe</button>
        {%- if form.posted_successfully? -%}
          <div style="width:100%; color: #4CAF50; font-size: 14px; margin-top: 10px;">Check your inbox for your guide!</div>
        {%- endif -%}
        {%- if form.errors -%}
          <div style="width:100%; color: #FF4B4B; font-size: 14px; margin-top: 10px;">{{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}</div>
        {%- endif -%}
      {%- endform -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "HP5 Health Newsletter",
  "tag": "section",
  "class": "section-hp5-newsletter",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Small Label",
      "default": "FREE HEALTH GUIDE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Optimize your daily routine."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Sign up to receive expert wellness tips, early access to new clinical formulas, and 10% off your first order."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Image Position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#0066cc"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Top (Desktop)", "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding Bottom (Desktop)", "default": 100
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Top (Mobile)", "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0, "max": 100, "step": 5, "unit": "px",
      "label": "Padding Bottom (Mobile)", "default": 60
    }
  ],
  "presets": [
    {
      "name": "HP5 Health Newsletter",
      "category": "Promotional"
    }
  ]
}
{% endschema %}
