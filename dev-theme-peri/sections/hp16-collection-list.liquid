{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#FFFF00'
  assign text_color = section.settings.text_color | default: '#000000'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 100px 40px;
    border-bottom: 4px solid #000;
  }
  
  .hp16-cl-container-{{ section_id }} {
    max-width: 1400px;
    margin: 0 auto;
  }
  
  .hp16-cl-grid-{{ section_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
  }
  
  .hp16-cl-card-{{ section_id }} {
    position: relative;
    text-decoration: none;
    display: block;
    background: #FFF;
    border: 4px solid #000;
    border-radius: 20px;
    padding: 15px;
    box-shadow: 10px 10px 0 #FF00FF;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  
  .hp16-cl-card-{{ section_id }}:nth-child(2) {
    box-shadow: 10px 10px 0 #00FFFF;
  }
  
  .hp16-cl-card-{{ section_id }}:hover {
    transform: translate(-5px, -5px);
    box-shadow: 15px 15px 0 #FF00FF;
  }
  
  .hp16-cl-card-{{ section_id }}:nth-child(2):hover {
    box-shadow: 15px 15px 0 #00FFFF;
  }
  
  .hp16-cl-image-wrap-{{ section_id }} {
    position: relative;
    padding-top: 100%;
    border-radius: 10px;
    overflow: hidden;
    border: 3px solid #000;
  }
  
  .hp16-cl-image-{{ section_id }} {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  
  .hp16-cl-card-{{ section_id }}:hover .hp16-cl-image-{{ section_id }} {
    transform: scale(1.1);
  }
  
  .hp16-cl-content-{{ section_id }} {
    padding: 20px 0 10px;
    text-align: center;
  }
  
  .hp16-cl-title-{{ section_id }} {
    font-family: 'Arial Black', Impact, sans-serif;
    font-size: 2rem;
    text-transform: uppercase;
    color: #FFF;
    -webkit-text-stroke: 1.5px #000;
    text-shadow: 3px 3px 0 #000;
    margin: 0;
  }

  @media (max-width: 992px) {
    .hp16-cl-grid-{{ section_id }} {
      grid-template-columns: 1fr;
    }
  }
  
  @media (max-width: 768px) {
    #shopify-section-{{ section_id }} {
      padding: 60px 20px;
    }
  }
</style>

<div class="hp16-cl-container-{{ section_id }}">
  <div class="hp16-cl-grid-{{ section_id }}">
    {% for block in section.blocks limit: 3 %}
      {% assign collection = collections[block.settings.collection] %}
      <a href="{{ collection.url | default: '#' }}" class="hp16-cl-card-{{ section_id }}" {{ block.shopify_attributes }}>
        <div class="hp16-cl-image-wrap-{{ section_id }}">
          {% if block.settings.image != blank %}
            <img src="{{ block.settings.image | image_url: width: 800 }}" class="hp16-cl-image-{{ section_id }}" loading="lazy" alt="Collection">
          {% elsif collection.image != blank %}
            <img src="{{ collection.image | image_url: width: 800 }}" class="hp16-cl-image-{{ section_id }}" loading="lazy" alt="{{ collection.title }}">
          {% else %}
            <div class="hp16-cl-image-{{ section_id }}" style="background: repeating-linear-gradient(45deg, #EFEFEF, #EFEFEF 12px, #E6E6E6 12px, #E6E6E6 24px);"></div>
          {% endif %}
        </div>
        <div class="hp16-cl-content-{{ section_id }}">
          <h3 class="hp16-cl-title-{{ section_id }}">{{ block.settings.title | default: collection.title | default: 'COLLECTION' }}</h3>
        </div>
      </a>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "HP16 Collection List",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFF00"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Image (optional)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom Title (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP16 Collection List",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
