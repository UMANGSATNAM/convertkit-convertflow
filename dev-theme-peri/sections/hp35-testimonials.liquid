{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;1,400&family=Nunito:wght@300;400;600&display=swap');

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    
    --font-heading: 'Lora', serif;
    --font-body: 'Nunito', sans-serif;
    
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    position: relative;
    overflow: hidden;
  }

  .hp35-testi-wrapper {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
    text-align: center;
    position: relative;
    z-index: 2;
  }

  .hp35-testi__icon {
    font-size: 60px;
    line-height: 1;
    color: var(--accent-color);
    margin-bottom: 30px;
    font-family: var(--font-heading);
    opacity: 0.3;
  }

  .hp35-testi__quote {
    font-family: var(--font-heading);
    font-size: clamp(28px, 4vw, {{ section.settings.quote_size }}px);
    line-height: 1.4;
    color: var(--text-color);
    margin: 0 auto 40px;
    max-width: 900px;
    font-weight: 400;
  }
  
  .hp35-testi__quote em {
    font-style: italic;
    color: var(--accent-color);
  }

  .hp35-testi__author {
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--text-color);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-weight: 600;
  }

  .hp35-testi__detail {
    font-size: 12px;
    color: var(--text-color);
    opacity: 0.6;
    margin-top: 5px;
    letter-spacing: 0.05em;
  }

  /* Decorative soft blur background */
  .hp35-testi__blur {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 600px; height: 600px;
    background: radial-gradient(circle, var(--accent-color) 0%, transparent 70%);
    opacity: 0.05;
    z-index: 1;
    pointer-events: none;
  }

  {{ section.settings.custom_css }}
{%- endstyle -%}

<div class="hp35-testi-wrapper" id="HP35Testimonials-{{ section.id }}">
  <div class="hp35-testi__blur"></div>
  
  <div class="hp35-testi__icon">“</div>
  
  <h2 class="hp35-testi__quote">
    {{ section.settings.quote | replace: 'beautiful', '<em>beautiful</em>' }}
  </h2>
  
  <div class="hp35-testi__author">{{ section.settings.author }}</div>
  {%- if section.settings.author_detail != blank -%}
    <div class="hp35-testi__detail">{{ section.settings.author_detail }}</div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "HP35 - Organic Quote",
  "class": "section-hp35-testimonials",
  "settings": [
    {
      "type": "textarea",
      "id": "quote",
      "label": "Quote",
      "default": "These are not just objects; they are beautiful moments captured in time. Every piece tells a story."
    },
    {
      "type": "text",
      "id": "author",
      "label": "Author",
      "default": "CLAIRE M."
    },
    {
      "type": "text",
      "id": "author_detail",
      "label": "Author Detail",
      "default": "Verified Buyer"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "quote_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Quote Size",
      "default": 42
    },
    {
      "type": "header",
      "content": "Organic Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#FDFBF7"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2C422F"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#CC7B5E"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 120
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "presets": [
    {
      "name": "HP35 - Organic Quote"
    }
  ]
}
{% endschema %}
