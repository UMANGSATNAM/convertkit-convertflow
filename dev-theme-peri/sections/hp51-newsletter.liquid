{%- style -%}
  #shopify-section-{{ section.id }} {
    --hp51-news-bg: {{ section.settings.bg_color | default: '#F2EFE9' }};
    --hp51-matcha: {{ section.settings.accent_matcha | default: '#2D5A3D' }};
    
    background-color: var(--hp51-news-bg);
    padding-top: {{ section.settings.padding_top | default: 90 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
  }

  .hp51-news__box {
    max-width: {{ section.settings.container_width | default: 760 }}px;
    margin: 0 auto;
    padding: 50px 40px;
    background: #FAF8F5;
    border: 1px solid rgba(30, 58, 43, 0.12);
    border-radius: 24px;
    text-align: center;
    box-shadow: 0 15px 40px rgba(30, 58, 43, 0.05);
  }

  .hp51-news__title {
    font-family: 'Noto Serif JP', serif;
    font-size: clamp(30px, 4.5vw, 40px);
    font-weight: 700;
    color: #1E3A2B;
    margin: 0 0 12px;
  }

  .hp51-news__desc {
    font-size: 15px;
    line-height: 1.8;
    color: #4A5B50;
    margin: 0 0 32px;
  }

  .hp51-news__form {
    display: flex;
    gap: 12px;
    max-width: 500px;
    margin: 0 auto;
  }

  .hp51-news__input {
    flex: 1;
    padding: 15px 24px;
    background: #F2EFE9;
    border: 1px solid rgba(30, 58, 43, 0.15);
    border-radius: 50px;
    color: #1E3A2B;
    font-size: 14px;
    outline: none;
    font-family: 'DM Sans', sans-serif;
  }

  .hp51-news__input:focus { border-color: var(--hp51-matcha); }

  .hp51-news__btn {
    padding: 15px 32px;
    background: #1E3A2B;
    color: #FAF8F5;
    border: none;
    border-radius: 50px;
    font-family: 'DM Sans', sans-serif;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 1px;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .hp51-news__btn:hover { background: var(--hp51-matcha); }

  @media screen and (max-width: 600px) {
    .hp51-news__box { padding: 36px 20px; }
    .hp51-news__form { flex-direction: column; }
  }
{%- endstyle -%}

<div class="hp51-news__box">
  <h2 class="hp51-news__title">{{ section.settings.heading | default: 'The Kyoto Tea Sanctuary' }}</h2>
  <p class="hp51-news__desc">{{ section.settings.description | default: 'Join our inner circle to receive seasonal harvest bulletins and an instant 15% welcome blessing.' }}</p>
  <form class="hp51-news__form" onsubmit="event.preventDefault(); alert('Subscribed to Kyoto Tea Sanctuary.');">
    <input type="email" class="hp51-news__input" placeholder="{{ section.settings.placeholder | default: 'Enter your email address' }}" required>
    <button type="submit" class="hp51-news__btn">{{ section.settings.btn_text | default: 'Subscribe' }}</button>
  </form>
</div>

{% schema %}
{
  "name": "HP51 - Zen News",
  "class": "section-hp51-news",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#F2EFE9" },
    { "type": "color", "id": "accent_matcha", "label": "Matcha Accent", "default": "#2D5A3D" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Kyoto Tea Sanctuary" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Join our inner circle to receive seasonal harvest bulletins." },
    { "type": "text", "id": "placeholder", "label": "Placeholder", "default": "Enter your email address" },
    { "type": "text", "id": "btn_text", "label": "Button Text", "default": "Subscribe" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Top", "default": 90 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 140, "step": 10, "unit": "px", "label": "Padding Bottom", "default": 90 },
    { "type": "range", "id": "container_width", "min": 500, "max": 1000, "step": 20, "unit": "px", "label": "Container Width", "default": 760 }
  ],
  "presets": [
    { "name": "HP51 - Zen News" }
  ]
}
{% endschema %}
