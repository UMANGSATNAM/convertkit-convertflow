{%- comment -%}
  sections/fb04-newsletter_streetwear.liquid

  CONVERSION PSYCHOLOGY (Frameblox Landing 04 Replica):
  1. VALUE EXCHANGE -- "Get secret drop passwords, early access notifications, and exclusive rebel discounts."
  2. FOCUS GLOW -- Input field features electric blue glow outline on focus.
  3. SUBTEXT ASSURANCE -- "Weekly drop newsletter. Unsubscribe anytime." eliminates spam fear.
{%- endcomment -%}

{%- liquid
  assign section_id = 'fb04-news-' | append: section.id
-%}

<style>
  #shopify-section-{{ section.id }} {
    --nl-bg: {{ section.settings.bg_color | default: '#FFFFFF' }};
    --nl-text-dark: {{ section.settings.text_dark | default: '#282A2F' }};
    --nl-text-body: {{ section.settings.text_body | default: '#7B818E' }};
    --nl-primary: {{ section.settings.primary_color | default: '#0066FF' }};
    --nl-primary-hover: {{ section.settings.primary_hover | default: '#2E82FF' }};
    --nl-border: {{ section.settings.border_color | default: '#DBDDE0' }};
  }

  .fb04-newsletter {
    background: var(--nl-bg);
    text-align: center;
    padding: clamp(3.5rem, 7vw, 5.6rem) 0;
  }

  .fb04-newsletter__container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 clamp(1rem, 4vw, 3.75rem);
  }

  .fb04-newsletter__inner {
    max-width: 540px;
    margin: 0 auto;
  }

  .fb04-newsletter__title {
    font-family: 'Big Shoulders Display', var(--font-heading, sans-serif);
    font-weight: 800;
    font-size: clamp(1.875rem, 3.8vw, 2.5rem);
    text-transform: uppercase;
    color: var(--nl-text-dark);
    margin-bottom: 12px;
    letter-spacing: -0.5px;
  }

  .fb04-newsletter__desc {
    font-family: var(--font-body, sans-serif);
    font-weight: 400;
    font-size: 15px;
    color: var(--nl-text-body);
    line-height: 1.6;
    margin-bottom: 30px;
  }

  .fb04-newsletter__form {
    display: flex;
    gap: 10px;
    margin-bottom: 14px;
  }

  .fb04-newsletter__input {
    flex: 1;
    font-family: var(--font-body, sans-serif);
    font-size: 15px;
    padding: 14px 20px;
    border: 1px solid var(--nl-border);
    border-radius: 8px;
    outline: none;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    background: #fff;
    color: var(--nl-text-dark);
  }

  .fb04-newsletter__input:focus {
    border-color: var(--nl-primary);
    box-shadow: 0 0 0 4px rgba(0, 102, 255, 0.12);
  }

  .fb04-newsletter__submit {
    font-family: var(--font-body, sans-serif);
    font-weight: 600;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    padding: 14px 30px;
    background: var(--nl-primary);
    color: #fff;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    white-space: nowrap;
  }

  .fb04-newsletter__submit:hover {
    background: var(--nl-primary-hover);
  }

  .fb04-newsletter__subtext {
    font-family: var(--font-body, sans-serif);
    font-size: 12px;
    color: var(--nl-text-body);
  }

  @media (max-width: 600px) {
    .fb04-newsletter__form {
      flex-direction: column;
    }
    .fb04-newsletter__submit {
      width: 100%;
    }
  }
</style>

<section class="fb04-newsletter" id="{{ section_id }}">
  <div class="fb04-newsletter__container">
    <div class="fb04-newsletter__inner">
      {%- if section.settings.heading != blank -%}
        <h2 class="fb04-newsletter__title">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <p class="fb04-newsletter__desc">{{ section.settings.description }}</p>
      {%- endif -%}

      {%- form 'customer', class: 'fb04-newsletter__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input
          type="email"
          name="contact[email]"
          class="fb04-newsletter__input"
          placeholder="{{ section.settings.placeholder | default: 'Enter your email' }}"
          required
          aria-label="Email address">
        <button type="submit" class="fb04-newsletter__submit">
          {{ section.settings.btn_text | default: 'Subscribe' }}
        </button>
      {%- endform -%}

      {%- if section.settings.subtext != blank -%}
        <p class="fb04-newsletter__subtext">{{ section.settings.subtext }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FB04 Newsletter",
  "tag": "section",
  "class": "section-fb04-newsletter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Subscribe to our newsletter now!"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Get secret drop passwords, early access notifications, and exclusive rebel discounts delivered straight to your inbox."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input Placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "Weekly drop newsletter. Unsubscribe anytime."
    },
    {
      "type": "header",
      "content": "Design"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "primary_color",
      "label": "Primary Color",
      "default": "#0066FF"
    },
    {
      "type": "color",
      "id": "primary_hover",
      "label": "Primary Hover",
      "default": "#2E82FF"
    },
    {
      "type": "color",
      "id": "text_dark",
      "label": "Heading Color",
      "default": "#282A2F"
    },
    {
      "type": "color",
      "id": "text_body",
      "label": "Body Color",
      "default": "#7B818E"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#DBDDE0"
    }
  ],
  "presets": [
    {
      "name": "FB04 Newsletter",
      "settings": {
        "heading": "Subscribe to our newsletter now!",
        "description": "Get secret drop passwords, early access notifications, and exclusive rebel discounts delivered straight to your inbox.",
        "btn_text": "Subscribe",
        "subtext": "Weekly drop newsletter. Unsubscribe anytime."
      }
    }
  ]
}
{% endschema %}
