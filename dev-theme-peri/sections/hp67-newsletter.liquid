{%- style -%}#shopify-section-{{ section.id }}{background:#FFF1F2;padding:60px 24px;text-align:center}.hp67-nl{max-width:560px;margin:0 auto}.hp67-nl h2{font-family:Syne,sans-serif;font-size:28px;font-weight:800;margin:0}.hp67-nl p{opacity:.6;margin:10px 0 20px}.hp67-nl form{display:flex;gap:10px;max-width:420px;margin:0 auto}@media(max-width:480px){.hp67-nl form{flex-direction:column}}.hp67-nl input{flex:1;padding:14px 16px;border:1px solid rgba(0,0,0,.12);border-radius:8px}.hp67-nl button{padding:14px 22px;background:#EC4899;color:#fff;border:none;border-radius:8px;font-weight:700;cursor:pointer}{%- endstyle -%}<div class="hp67-nl"><h2>{{ section.settings.heading | default: 'Join the BEAUTY RITUAL' }}</h2><p>{{ section.settings.sub | default: 'Get 10% off + early drop alerts.' }}</p><form method="post" action="/contact#contact_form" accept-charset="UTF-8"><input type="email" name="contact[email]" placeholder="you@email.com" required><button type="submit">{{ section.settings.btn | default: 'Subscribe' }}</button></form></div>{% schema %}{"name":"HP67 Newsletter","settings":[{"type":"text","id":"heading","label":"Heading","default":"Join the BEAUTY RITUAL"},{"type":"text","id":"sub","label":"Sub","default":"Get 10% off + early drop alerts."},{"type":"text","id":"btn","label":"Btn","default":"Subscribe"}],"presets":[{"name":"HP67 Newsletter"}]}{% endschema %}