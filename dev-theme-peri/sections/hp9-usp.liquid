{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#0f0f13'
  assign text_color = section.settings.text_color | default: '#ffffff'
  assign accent_color = section.settings.accent_color | default: '#00ff88'
-%}

<style>
  #shopify-section-{{ section_id }} {
    background-color: {{ bg_color }};
    padding: 100px 20px;
    color: {{ text_color }};
    border-bottom: 1px solid rgba(255,255,255,0.05);
  }
  
  .hp9-usp-container-{{ section_id }} {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
  }
  
  .hp9-usp-item-{{ section_id }} {
    background: #15151a;
    border: 1px solid rgba(255,255,255,0.05);
    border-radius: 8px;
    padding: 40px;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }
  
  .hp9-usp-item-{{ section_id }}::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 2px;
    height: 100%;
    background-color: {{ accent_color }};
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 0.4s ease;
  }
  
  .hp9-usp-item-{{ section_id }}:hover {
    background: #1a1a24;
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(0,0,0,0.5);
  }
  
  .hp9-usp-item-{{ section_id }}:hover::before {
    transform: scaleY(1);
    transform-origin: top;
  }
  
  .hp9-usp-icon-{{ section_id }} {
    margin-bottom: 25px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 50px;
    height: 50px;
    background: rgba(0, 255, 136, 0.1);
    border-radius: 8px;
    color: {{ accent_color }};
  }
  
  .hp9-usp-icon-{{ section_id }} svg {
    width: 24px;
    height: 24px;
    fill: currentColor;
  }
  
  .hp9-usp-title-{{ section_id }} {
    font-family: 'Space Mono', monospace;
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin: 0 0 15px 0;
    color: #fff;
  }
  
  .hp9-usp-desc-{{ section_id }} {
    font-family: 'Inter', sans-serif;
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
    color: rgba(255,255,255,0.6);
  }

  @media (max-width: 992px) {
    .hp9-usp-container-{{ section_id }} {
      grid-template-columns: 1fr;
    }
  }
</style>

<div class="hp9-usp-container-{{ section_id }}">
  {% for block in section.blocks limit: 3 %}
    <div class="hp9-usp-item-{{ section_id }}" {{ block.shopify_attributes }}>
      <div class="hp9-usp-icon-{{ section_id }}">
        {% if block.settings.icon_svg != blank %}
          {{ block.settings.icon_svg }}
        {% else %}
          <svg viewBox="0 0 24 24"><path d="M12,2L1,21H23M12,6L19.53,19H4.47M11,10V14H13V10M11,16V18H13V16"/></svg>
        {% endif %}
      </div>
      <h3 class="hp9-usp-title-{{ section_id }}">{{ block.settings.title }}</h3>
      <p class="hp9-usp-desc-{{ section_id }}">{{ block.settings.description }}</p>
    </div>
  {% endfor %}
</div>

{% schema %}
{
  "name": "HP9 USPs",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#0f0f13"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#00ff88"
    }
  ],
  "blocks": [
    {
      "type": "usp",
      "name": "USP",
      "settings": [
        {
          "type": "html",
          "id": "icon_svg",
          "label": "Icon SVG"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "SYSTEM SECURE"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "End-to-end encryption on all transactions."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP9 USPs",
      "blocks": [
        { "type": "usp", "settings": { "title": "24/7 SUPPORT_LOG" } },
        { "type": "usp", "settings": { "title": "GLOBAL_DELIVERY" } },
        { "type": "usp", "settings": { "title": "SECURE_PROTOCOL" } }
      ]
    }
  ]
}
{% endschema %}
