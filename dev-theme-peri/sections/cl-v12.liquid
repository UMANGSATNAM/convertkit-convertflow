{% comment %} CL V12 — Elegant Bridal / Soft {% endcomment %}
{{ 'component-facets.css' | asset_url | stylesheet_tag }}
<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
<style>
  .clv12 { background: {{ section.settings.bg_color | default: '#FAFAFA' }}; color: {{ section.settings.text_color | default: '#4A4A4A' }}; padding: 80px 20px; font-family: 'Didot', serif; }
  .clv12-hero { text-align: center; margin-bottom: 70px; }
  .clv12-hero h1 { font-size: 52px; font-weight: normal; margin-bottom: 20px; color: #2C2C2C; letter-spacing: 2px; }
  .clv12-hero p { font-size: 16px; font-family: 'Helvetica', sans-serif; color: #7F7F7F; max-width: 600px; margin: 0 auto; font-style: italic; letter-spacing: 1px; }
  .clv12-chips { display: flex; gap: 30px; justify-content: center; margin-bottom: 50px; flex-wrap: wrap; }
  .clv12-chips a { padding: 0 0 5px 0; color: #9A9A9A; text-decoration: none; font-family: 'Helvetica', sans-serif; font-size: 12px; text-transform: uppercase; letter-spacing: 3px; border-bottom: 1px solid transparent; transition: 0.4s; }
  .clv12-chips a:hover, .clv12-chips a.active { color: #2C2C2C; border-color: #2C2C2C; }
  .clv12-toolbar { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #E5E5E5; padding-bottom: 25px; margin-bottom: 50px; font-family: 'Helvetica', sans-serif; }
  .clv12-grid { display: grid; grid-template-columns: repeat({{ section.settings.cols_desktop | default: 3 }}, 1fr); gap: 40px; }
  .clv12-promo { grid-column: span 1; background: #FFFFFF; border: 1px solid #E5E5E5; padding: 50px; text-align: center; display: flex; flex-direction: column; justify-content: center; }
  .clv12-promo h3 { font-size: 28px; font-weight: normal; margin-bottom: 20px; color: #2C2C2C; letter-spacing: 1px; }
  .clv12-promo a { display: inline-block; padding: 15px 35px; background: transparent; color: #2C2C2C; text-decoration: none; font-family: 'Helvetica', sans-serif; font-size: 11px; text-transform: uppercase; letter-spacing: 2px; border: 1px solid #2C2C2C; transition: 0.3s; }
  .clv12-promo a:hover { background: #2C2C2C; color: #FFF; }
  .clv12-seo { margin-top: 80px; text-align: center; padding: 60px 0; border-top: 1px solid #E5E5E5; }
  @media (max-width: 768px) { .clv12-grid { grid-template-columns: repeat({{ section.settings.cols_mobile | default: 2 }}, 1fr); gap: 20px; } .clv12-hero h1 { font-size: 38px; } }
</style>
<div class="clv12" style="max-width: 1100px; margin: 0 auto;">
  <div class="clv12-hero">
    <h1>{% if collection.title != blank %}{{ collection.title | escape }}{% else %}Bridal Collection{% endif %}</h1>
    <p>{% if collection.description != blank %}{{ collection.description }}{% else %}Grace. Elegance. Perfection.{% endif %}</p>
  </div>
  {% if section.settings.sub_collections != blank %}
    <div class="clv12-chips">
      {% for link in section.settings.sub_collections.links %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% endfor %}
    </div>
  {% endif %}
  <div class="clv12-toolbar">
    <facet-filters-form style="width: 100%;">
      <form id="FacetFiltersForm" style="display: flex; justify-content: space-between; align-items: center; width: 100%; flex-wrap: wrap; gap: 20px;">
        <div style="display: flex; gap: 30px;">
          {%- for filter in collection.filters -%}
            <details style="position: relative;">
              <summary style="cursor: pointer; font-size: 11px; text-transform: uppercase; letter-spacing: 2px; color: #7F7F7F;">{{ filter.label }} +</summary>
              <div style="position: absolute; top: 100%; left: 0; background: #FFF; border: 1px solid #E5E5E5; padding: 30px; box-shadow: 0 10px 40px rgba(0,0,0,0.03); z-index: 10; min-width: 250px; margin-top: 20px;">
                {%- for value in filter.values -%}
                  <label style="display: block; margin-bottom: 15px; cursor: pointer; font-size: 12px; color: #4A4A4A; letter-spacing: 1px;">
                    <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %}>
                    {{ value.label }} <span style="color:#A0A0A0;font-size:10px;">({{ value.count }})</span>
                  </label>
                {%- endfor -%}
              </div>
            </details>
          {%- endfor -%}
        </div>
        <select name="sort_by" onchange="this.form.submit()" style="background: transparent; border: none; font-size: 11px; text-transform: uppercase; letter-spacing: 2px; color: #7F7F7F; cursor: pointer;">
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>Sort: {{ option.name }}</option>
          {%- endfor -%}
        </select>
      </form>
    </facet-filters-form>
  </div>
  {% assign limit_num = section.settings.products_per_page | default: 12 %}
  {% paginate collection.products by limit_num %}
    <div class="clv12-grid">
      {% for product in collection.products %}
        {% render 'card-v12', product: product %}
        {% if forloop.index == 8 and section.settings.show_promo_tile %}
          <div class="clv12-promo">
            <span style="font-family: 'Helvetica', sans-serif; font-size: 10px; letter-spacing: 3px; color: #9A9A9A; margin-bottom: 15px; text-transform: uppercase;">Atelier Service</span>
            <h3>Bespoke Alterations</h3>
            <a href="/pages/alterations">Book Appointment</a>
          </div>
        {% endif %}
      {% else %}
        {% for i in (1..limit_num) %}
          {% render 'card-v12', product: nil %}
        {% endfor %}
      {% endfor %}
    </div>
    <div style="margin-top: 70px; text-align: center; font-family: 'Helvetica', sans-serif; font-size: 12px; letter-spacing: 2px;">{{ paginate | default_pagination }}</div>
  {% endpaginate %}
  {% if section.settings.show_seo_block %}
    <div class="clv12-seo">
      <h2 style="font-size: 32px; font-weight: normal; margin-bottom: 20px; color: #2C2C2C; letter-spacing: 1px;">{{ section.settings.seo_title | default: 'A Day to Remember' }}</h2>
      <p style="font-family: 'Helvetica', sans-serif; color: #7F7F7F; line-height: 2; max-width: 600px; margin: 0 auto; font-size: 13px; letter-spacing: 1px;">{{ section.settings.seo_text | default: 'From delicate lace to flowing silks, every gown is crafted with love and attention to the finest details.' }}</p>
    </div>
  {% endif %}
</div>
{% schema %}
{
  "name": "CL V12 — Bridal", "settings": [
    {"type": "range", "id": "products_per_page", "label": "Products per page", "min": 6, "max": 36, "step": 3, "default": 12},
    {"type": "range", "id": "cols_desktop", "label": "Desktop Columns", "min": 2, "max": 4, "default": 3},
    {"type": "select", "id": "cols_mobile", "label": "Mobile Columns", "options": [{"value": "1", "label": "1"}, {"value": "2", "label": "2"}], "default": "2"},
    {"type": "link_list", "id": "sub_collections", "label": "Sub-Collection Menu"},
    {"type": "checkbox", "id": "show_promo_tile", "label": "Show Promo Card", "default": true},
    {"type": "checkbox", "id": "show_seo_block", "label": "Show SEO Block", "default": true},
    {"type": "color", "id": "bg_color", "label": "Background Color", "default": "#FAFAFA"},
    {"type": "color", "id": "text_color", "label": "Text Color", "default": "#4A4A4A"}
  ], "presets": [{"name": "CL V12 — Bridal"}]
}
{% endschema %}
