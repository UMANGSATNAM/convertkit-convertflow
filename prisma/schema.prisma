// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Session (required by @shopify/shopify-app-session-storage-prisma)
model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String    @db.Text
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?   @db.Text
  refreshTokenExpires DateTime?
}

model Merchant {
  id                    String   @id @default(uuid())
  shopDomain            String   @unique @map("shop_domain")
  accessToken           String   @db.Text @map("access_token")
  plan                  String   @default("free")
  activeThemeId         String?  @map("active_theme_id")
  whatsappPhoneNumberId String?  @map("whatsapp_phone_number_id")
  whatsappAccessToken   String?  @db.Text @map("whatsapp_access_token")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  backups             ThemeBackup[]
  injectedPages       InjectedPage[]
  abandonedCarts      AbandonedCart[]
  whatsappMessages    WhatsappMessage[]
  profitSnapshots     ProfitSnapshot[]

  @@map("merchants")
}

model ThemeBackup {
  id               String   @id @default(uuid())
  merchantId       String   @map("merchant_id")
  shopifyThemeId   String   @map("shopify_theme_id")
  backupName       String   @map("backup_name")
  isRestored       Boolean  @default(false) @map("is_restored")
  createdAt        DateTime @default(now()) @map("created_at")
  
  merchant         Merchant @relation(fields:[merchantId], references:[id])

  @@map("theme_backups")
}

model PageTemplate {
  id              String   @id @default(uuid())
  niche           String
  pageType        String   @map("page_type")
  templateName    String   @map("template_name")
  description     String   @db.Text
  previewImageUrl String?  @map("preview_image_url") @db.Text
  sectionsConfig  Json     @map("sections_config")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  injectedPages   InjectedPage[]

  @@map("page_templates")
}

model InjectedPage {
  id                  String   @id @default(uuid())
  merchantId          String   @map("merchant_id")
  templateId          String   @map("template_id")
  shopifyPageId       BigInt?  @map("shopify_page_id")
  shopifyPageHandle   String   @map("shopify_page_handle")
  shopifyTemplateFile String   @map("shopify_template_file")
  pageTitle           String   @map("page_title")
  status              String   @default("published")
  injectedAt          DateTime @default(now()) @map("injected_at")
  createdAt           DateTime @default(now()) @map("created_at")

  merchant            Merchant     @relation(fields:[merchantId], references:[id])
  template            PageTemplate @relation(fields:[templateId], references:[id])

  @@map("injected_pages")
}

model AbandonedCart {
  id                   String    @id @default(uuid())
  merchantId           String    @map("merchant_id")
  customerEmail        String?   @map("customer_email")
  customerPhone        String?   @map("customer_phone")
  cartTotal            Float     @map("cart_total")
  shopifyCheckoutToken String?   @map("shopify_checkout_token")
  recovered            Boolean   @default(false)
  recoveryStage        Int       @default(0) @map("recovery_stage")
  lastMessageSentAt    DateTime? @map("last_message_sent_at")
  abandonedAt          DateTime  @default(now()) @map("abandoned_at")

  merchant             Merchant  @relation(fields:[merchantId], references:[id])

  @@map("abandoned_carts")
}

model WhatsappMessage {
  id                String    @id @default(uuid())
  merchantId        String    @map("merchant_id")
  messageType       String    @map("message_type")
  toPhone           String    @map("to_phone")
  templateName      String    @map("template_name")
  templateVariables String?   @db.Text @map("template_variables")
  status            String
  metaMessageId     String?   @map("meta_message_id")
  sentAt            DateTime? @map("sent_at")
  relatedOrderId    BigInt?   @map("related_order_id")
  createdAt         DateTime  @default(now()) @map("created_at")

  merchant          Merchant  @relation(fields:[merchantId], references:[id])

  @@map("whatsapp_messages")
}

model Order {
  id        String   @id @default(uuid())
  shop      String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("orders")
}

model ProfitSnapshot {
  id                String   @id @default(uuid())
  merchantId        String   @map("merchant_id")
  shopifyOrderId    BigInt   @map("shopify_order_id")
  sellingPrice      Float    @map("selling_price")
  cogs              Float
  shippingCost      Float    @map("shipping_cost")
  pgFee             Float    @map("pg_fee")
  adSpendAttributed Float    @map("ad_spend_attributed")
  packagingCost     Float    @map("packaging_cost")
  rtoBuffer         Float    @map("rto_buffer")
  netProfit         Float    @map("net_profit")
  netMarginPct      Float    @map("net_margin_pct")
  roas              Float
  createdAt         DateTime @default(now()) @map("created_at")

  merchant          Merchant @relation(fields:[merchantId], references:[id])

  @@map("profit_snapshots")
}
