// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Session (required by @shopify/shopify-app-session-storage-prisma)
model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String    @db.Text
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?   @db.Text
  refreshTokenExpires DateTime?
}

model Shop {
  id              String   @id @default(cuid())
  shopDomain      String   @unique
  accessToken     String   @db.Text // encrypted
  email           String?
  plan            Plan     @default(FREE)
  planActivatedAt DateTime?
  trialEndsAt     DateTime?
  nicheId         String?
  brandConfig     Json?    // {storeName, logoUrl, colors:{primary,secondary,accent}, fontPair, whatsapp, city, state, gstin?}
  language        String   @default("en") // assistant + email language: en | hi | hinglish
  onboardedAt     DateTime?
  uninstalledAt   DateTime? // retained 30 days then purged (shop/redact)
  createdAt       DateTime @default(now())

  generations       StoreGeneration[]
  installedSections InstalledSection[]
  toolkitConfigs    ToolkitFeature[]
  campaigns         CampaignPage[]
  healthReports     HealthReport[]
  snapshots         ThemeSnapshot[]
  aiActions         AiActionLog[]
  usage             UsageCounter[]
}

model StoreGeneration {
  id          String    @id @default(cuid())
  shopId      String
  shop        Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  nicheId     String
  catalogMode CatalogMode // DEMO | CSV | EMPTY
  status      GenStatus
  currentStep String?
  themeId     String?
  log         Json      // [{ts, step, status, detail}]
  error       Json?
  createdAt   DateTime  @default(now())
  completedAt DateTime?
}

model Niche {
  id            String   @id
  name          String
  nameHi        String
  themeZipUrl   String
  themeVersion  String
  previewImages Json     // String[] doesn't work well in all MySQL versions, using Json for arrays
  demoCatalogUrl String  // R2 JSON manifest
  pagesPreset   Json
  menusPreset   Json
  settingsBase  Json
  palettePresets Json    // [{name, primary, secondary, accent}]
  fontPairs     Json     // [{name, heading, body}]
  campaignFit   Json     // which campaign templates suit this niche
}

model InstalledSection {
  id         String   @id @default(cuid())
  shopId     String
  shop       Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  sectionKey String   // catalog key e.g. "hero-festive-banner"
  themeId    String
  addedVia   String   // GALLERY | AI | GENERATOR
  createdAt  DateTime @default(now())
}

model ToolkitFeature {
  id       String  @id @default(cuid())
  shopId   String
  shop     Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  feature  Feature // STICKY_ATC, COUNTDOWN, ANNOUNCEMENT, etc
  enabled  Boolean @default(false)
  config   Json

  @@unique([shopId, feature])
}

model PincodeZone {
  id      String @id @default(cuid())
  shopId  String
  pincode String
  cod     Boolean
  etaDays Int?

  @@unique([shopId, pincode])
  @@index([shopId])
}

model CampaignPage {
  id          String   @id @default(cuid())
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  templateKey String   // diwali | eoss | new-launch | wedding | rakhi | valentines | national-sale
  title       String
  handle      String
  pageId      String?
  themeTemplate String? // templates/page.campaign-xxx.json
  productIds  Json     // String[] 
  offer       Json     // {headline, sub, endsAt, discountCode?}
  status      String   // DRAFT | PUBLISHED | ARCHIVED
  autoArchive Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model HealthReport {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  score     Int
  issues    Json     // [{key, severity, target, detail, autoFixable, fixedAt?}]
  trigger   String   // CRON | MANUAL | POST_FIX
  createdAt DateTime @default(now())
}

model ThemeSnapshot {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  themeId   String
  kind      String   // SETTINGS | TEMPLATE | ASSET
  path      String
  r2Key     String   // snapshot content in R2
  reason    String   // DESIGN_STUDIO | AI | HEALTH_FIX | CAMPAIGN
  createdAt DateTime @default(now())
}

model AiActionLog {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  prompt    String   @db.Text
  tools     Json     // tool calls proposed
  applied   Boolean
  result    Json?
  tokensIn  Int
  tokensOut Int
  createdAt DateTime @default(now())
}

model UsageCounter {
  id      String @id @default(cuid())
  shopId  String
  shop    Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  metric  String // AI_ACTIONS, GENERATIONS, CAMPAIGNS_LIVE
  period  String // YYYY-MM
  count   Int    @default(0)

  @@unique([shopId, metric, period])
}

enum Plan { 
  FREE 
  GROWTH 
  PRO 
}
enum GenStatus { 
  QUEUED 
  INSTALLING_THEME 
  IMPORTING_PRODUCTS 
  CREATING_COLLECTIONS 
  CREATING_PAGES 
  CREATING_MENUS 
  PATCHING_SETTINGS 
  PUBLISHING 
  DONE 
  FAILED 
}
enum CatalogMode { 
  DEMO 
  CSV 
  EMPTY 
}
enum Feature { 
  STICKY_ATC 
  COUNTDOWN 
  ANNOUNCEMENT 
  SIZE_CHART 
  PINCODE 
  WHATSAPP 
  BUNDLES 
  TRUST_BADGES 
}
