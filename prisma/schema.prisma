// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Session (required by @shopify/shopify-app-session-storage-prisma)
model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String    @db.Text
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?   @db.Text
  refreshTokenExpires DateTime?
}

model Shop {
  id              String   @id @default(cuid())
  shopDomain      String   @unique
  accessToken     String   @db.Text // encrypted
  email           String?
  plan            Plan     @default(FREE)
  planActivatedAt DateTime?
  trialEndsAt     DateTime?
  nicheId         String?
  brandConfig     Json?    
  language        String   @default("en") 
  onboardedAt     DateTime?
  uninstalledAt   DateTime? 
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  installedSections InstalledSection[]
  toolkitFeatures   ToolkitFeature[]
  snapshots         ThemeSnapshot[]
  usage             UsageCounter[]
  integrations      Integration[]
  storeBlueprints   StoreBlueprint[]
}

}

model Niche {
  id            String   @id
  name          String
  nameHi        String
  themeZipUrl   String
  themeVersion  String
  previewImages Json     
  demoStoreUrl  String
  demoCatalogUrl String  
  pagesPreset   Json
  menusPreset   Json
  settingsBase  Json
  palettePresets Json    
  fontPairs     Json     
  campaignFit   Json     
  active        Boolean  @default(true)
}

model SectionCatalog {
  key        String   @id        
  name       String
  nameHi     String
  category   Category
  goalTags   Json     
  nicheTags  Json     
  planMin    Plan     @default(FREE)
  thumbUrl   String
  previewUrl String
  blockHandle String  
  version    String
  active     Boolean  @default(true)
}

model InstalledSection {
  id         String   @id @default(cuid())
  shopId     String
  shop       Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  sectionKey String   
  themeId    String
  addedVia   AddedVia
  createdAt  DateTime @default(now())

  @@index([shopId])
}

model ToolkitFeature {
  id       String  @id @default(cuid())
  shopId   String
  shop     Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  feature  Feature 
  enabled  Boolean @default(false)
  config   Json    @default("{}")

  @@unique([shopId, feature])
}

model ThemeSnapshot {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  themeId   String
  kind      SnapKind   
  path      String
  r2Key     String   
  checksum  String   @default("")
  reason    SnapReason   
  actor     Actor    @default(SYSTEM)
  createdAt DateTime @default(now())

  @@index([shopId, createdAt])
}




model UsageCounter {
  shopId  String
  metric  String 
  period  String 
  count   Int    @default(0)
  shop    Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@id([shopId, metric, period])
}

model Integration {
  id      String  @id @default(cuid())
  shopId  String
  shop    Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  kind    String  
  config  Json    
  status  String  
  pixelId String? 

  @@unique([shopId, kind])
}

model WebhookEvent {
  id        String   @id        
  topic     String
  shop      String
  createdAt DateTime @default(now())
}

enum Plan { 
  FREE 
  GROWTH 
  PRO 
}
enum GenStatus { 
  QUEUED 
  INSTALLING_THEME 
  IMPORTING_PRODUCTS 
  CREATING_COLLECTIONS 
  CREATING_PAGES 
  CREATING_MENUS 
  PATCHING_SETTINGS 
  PUBLISHING 
  DONE 
  FAILED 
  CANCELLED
}
enum CatalogMode { 
  DEMO 
  CSV 
  EMPTY 
}
enum Feature { 
  STICKY_ATC 
  COUNTDOWN 
  ANNOUNCEMENT 
  SIZE_CHART 
  PINCODE 
  WHATSAPP 
  BUNDLES 
  TRUST_BADGES 
}
enum Category { 
  HERO 
  PRODUCT 
  TRUST 
  CONTENT 
  CONVERSION 
  UTILITY 
  INDIA 
}
enum AddedVia { 
  GALLERY 
  AI 
  GENERATOR 
}
enum CampaignStatus { 
  DRAFT 
  PUBLISHED 
  ARCHIVED 
}
enum ScanTrigger { 
  CRON 
  MANUAL 
  POST_FIX 
}
enum SnapKind { 
  SETTINGS 
  TEMPLATE 
  ASSET 
}
enum SnapReason { 
  DESIGN_STUDIO 
  AI 
  HEALTH_FIX 
  CAMPAIGN 
  GENERATOR 
  MANUAL 
}
enum Actor { 
  MERCHANT 
  AI 
  SYSTEM 
}

model ComponentRegistry {
  id                String   @id @default(cuid())
  componentId       String   @unique   // e.g. "hero-editorial-beauty-v1"
  category          String             // slot type: hero, header, footer, etc.
  niche             String   @default("core")
  sectionType       String   @default("")
  filePath          String   @default("")
  liquidPath        String   @default("")    // path in components/ dir
  metaPath          String   @default("")    // path to .meta.json sidecar
  // v2.0 classification fields
  family            String   @default("")    // "Beauty", "Luxury", "Tech", "Home", etc.
  archetypes        Json     @default("[]") // ["organic","premium"]
  visualStyle       String   @default("")   // "editorial","luxury","bold","tech","natural"
  compatibleSlots   Json     @default("[]") // ["header-minimal-beauty-v1"]
  industryTags      Json
  styleTags         Json
  searchKeywords    Json?
  croScore          Float    @default(0.0)
  mobileScore       Float    @default(0.0)
  version           String   @default("1")     // "1", "2" etc — String for backward compat
  status            String   @default("PUBLISHED")  // "PUBLISHED" | "DRAFT" | "DEPRECATED"
  isUniversal       Boolean  @default(false)
  performanceScore  Float?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// v2.0: Store Blueprint Snapshot — mandatory before every compose run
model StoreBlueprint {
  id          String   @id @default(cuid())
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  generationId String? // link to StoreGeneration if applicable

  // Classification
  niche       String   // "beauty", "jewellery", "streetwear" etc.
  family      String   // "Beauty", "Luxury", "Lifestyle", "Tech", "Home"
  archetype   String   // "organic", "luxury", "bold", "tech", "minimal"

  // Assembly
  tokensFile  String   // "niche-tokens/beauty/organic.css"
  components  Json     // { "header": "header-minimal-beauty-v1", "hero": "hero-editorial-beauty-v1", ... }
  pdpFeatures Json     // { "beforeAfter": true, "skinQuiz": false, ... }

  // State
  status      String   @default("preview")  // "preview" | "published" | "archived"
  healthScore Float?
  themeId     String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([shopId, createdAt])
}

model RegistryMeta {
  id           String   @id @default("singleton")
  registryHash String
  seededAt     DateTime @default(now())
}



